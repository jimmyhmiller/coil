(module mt_drops_target)
(import "mt_drops" :use *)

(defstruct Res [(n i64)])
(impl Drop Res (drop [(self (mut Res))] (-> void) (do)))
(defstruct Two [(a Res) (b Res)])

(defn mk [] (-> Res) (Res :n 1))
; the parameter, at the end
(defn eat [(r Res)] (-> i64) (.n r))
; a generic's T, abstract; one that drops none
(defn toss [T] [(x T)] (-> i64) 0)
(defn keep [T] [(x T)] (-> T) x)
; given by value to a trait method through its bound: dropped by the caller only
; when the impl borrows it
(deftrait Counts [Self] (count-it [(x Self)] (-> i64)))
(defn hand [(T Counts)] [(x T)] (-> i64) (Counts::count-it x))
; what is left of a value one part of which was moved out
(defn part [(t Two)] (-> i64) (let [a (.a t)] (eat a)))
; moved on one way only
(defn some [(c bool)] (-> i64)
  (let [r (mk)]
    (if c (eat r) 0)))
; a value no one uses, one assigned over, and the binding's at its scope's end
(defn main [] (-> i64)
  (let [(mut r) (mk)]
    (mk)
    (set! r (mk))
    (.n r)))
