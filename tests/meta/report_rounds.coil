(module mt_report_rounds)
(import "coil.primitive" :as primitive)
(import "coil.phase" :as phase)

; A transform that needs a second round, because the first rewrites each
; `(marked)` to `1`, and that reports every definition named `flagged` in each
; round. What it reports is printed once, for the program the last round read,
; and also when that program does not check.

(defn unmark [(f Code)] (-> Code)
  (cond (and (primitive/code-list? f) (= (len f) 1) (primitive/code-sym? (primitive/code-nth f 0))
             (= (primitive/code-str (primitive/code-nth f 0)) "marked"))
          `1
        (primitive/code-list? f)
          (let [(mut kids) (primitive/code-list-new)]
            (for k (iter f) (push! (mut kids) (unmark k)))
            (primitive/code-list-like f `(~@kids)))
        :else f))

(defn report-flagged [(modules Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m (iter modules)
      (for f (iter (primitive/code-rest m))
        (when (and (primitive/code-list? f) (> (len f) 1)
                   (primitive/code-eq (primitive/code-nth f 0) `defn*)
                   (= (primitive/code-str (primitive/code-nth f 1)) "flagged"))
          (primitive/report f "report-rounds: flagged is reported")))
      (push! (mut out) (unmark m)))
    `(~@out)))

(transform report-flagged :modules (phase/OwnModules))
