(module mt_source_output_test)
(import "coil.primitive" :as p)
(import "coil.compiler.parser" :as parser)
(import "coil.compiler.ast" :as ast)
(import "coil.compiler.ast_map" :as am)
(import "coil.compiler.check" :as check)
(import "coil.scratch" :as scratch)
(import "coil.reader" :as reader)
(import "coil.alloc" :use [Allocator malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])

(deftest emitted-source-preserves-every-string-byte
  (let [a (malloc-allocator)
        (mut bytes) (ArrayList::new [u8] a)]
    (for i (range 0 256) (push! (mut bytes) (cast u8 i)))
    (let [value (slice (load bytes))]
      (for variant (range 0 2)
        (let [c-string? (= variant 1)
              literal
                (reader/mk-sexp (if c-string?
                                    (reader/KCStr value)
                                    (reader/KStr value))
                                -1
                                -1)
              source (parser/sexp-source a literal)]
          (match (reader/read-all a source 0)
            (Ok [forms]
                (do
                  (assert-eq 1 (len (load forms)))
                  (let [actual (get (load forms) 0)]
                    (assert-eq (if c-string? 5 4) (parser/sx-tag actual))
                    (assert-eq value (parser/sx-sval actual)))))
            (Err [_] (assert false))))))))

(defn edge-leaf [(n i64)] (-> ast/Expr)
  (ast/mk-expr (ast/EInt n) n n 0 0))

(defn edge-trace [(root (ptr ast/Expr))] (-> i64)
  (let [(mut trace) 0]
    (am/visit-expr-children [child root]
                            (set! trace (+ (* trace 10) (.lo child))))
    trace))

(defn edge-fail-at-two [(root (ptr ast/Expr)) (visited (ptr i64))]
  (-> (Result i64 i64))
  (try (do
         (am/visit-expr-children [child root]
                                 (store! visited (+ (load visited) 1))
                                 (when (= (.lo child) 2)
                                   (try! (Err [i64 i64] 2))))
         (Ok [i64 i64] 0))))

; Ownership elaboration inserts each cleanup at its own expression place. Every
; syntax child must be distinct, while source and semantic identity are retained.
(defn check-cloned-edges [(a (dyn Allocator)) (root (ptr ast/Expr))] (-> i64)
  (let [copy (check/ownership-clone a root)
        (mut original) (ArrayList::new [i64] a)
        (mut i) 0]
    (assert (!= (cast i64 copy) (cast i64 root)))
    (assert-eq (.lo copy) (.lo root))
    (assert-eq (.hi copy) (.hi root))
    (assert-eq (.source copy) (.source root))
    (assert-eq (.ctxt copy) (.ctxt root))
    (assert-eq (.node-id copy) (.node-id root))
    (assert-eq (edge-trace copy) (edge-trace root))
    (match (.kind root)
      (ast/ELet [binds _]
                (match (.kind copy)
                  (ast/ELet [copies _]
                            (assert (!= (cast i64 copies) (cast i64 binds)))
                            (for [j 0 (len (load binds))]
                              (assert-eq (.name (elem copies j))
                                         (.name (elem binds j)))
                              (assert-eq (.mutable (elem copies j))
                                         (.mutable (elem binds j)))
                              (assert-eq (.bid (elem copies j))
                                         (.bid (elem binds j)))
                              (assert-eq (cast i64
                                               (.owned_type (elem copies j)))
                                         (cast i64 (.owned_type (elem binds j))))))
                  (_ (assert false))))
      (ast/EDynDispatch [dc]
                        (match (.kind copy)
                          (ast/EDynDispatch [cloned]
                                            (assert (!= (cast i64 cloned)
                                                        (cast i64 dc)))
                                            (assert-eq (.dyn_struct cloned)
                                                       (.dyn_struct dc))
                                            (assert-eq (.vtable_struct cloned)
                                                       (.vtable_struct dc))
                                            (assert-eq (.method_index cloned)
                                                       (.method_index dc))
                                            (assert-eq (.cc cloned) (.cc dc))
                                            (assert-eq (cast i64
                                                             (.params cloned))
                                                       (cast i64 (.params dc))))
                          (_ (assert false))))
      (_ 0))
    (am/visit-expr-children [child root]
                            (push! (mut original) (cast i64 child)))
    (am/visit-expr-children [child copy]
                            (assert (< (load i) (len original)))
                            (assert (!= (cast i64 child)
                                        (get original (load i))))
                            (set! (.hi child) 999)
                            (set! i (+ (load i) 1)))
    (assert-eq (load i) (len original))
    (am/visit-expr-children [child root] (assert (!= (.hi child) 999)))
    (free! (mut original))
    0))

(deftest expression-edges-preserve-order-borrowing-and-control-flow
  (let [storage (p/alloc-stack scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity storage
                                                    (malloc-allocator)
                                                    4096)
        a (allocator storage)
        (mut binds) (ArrayList::new [ast/Bind] a)
        (mut body) (ArrayList::new [ast/Expr] a)
        (mut arms) (ArrayList::new [ast/Arm] a)
        strings (parser/box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
        types (parser/box-al [ast/Type] a (ArrayList::new [ast/Type] a))]
    (for [i 1 3]
      (push! (mut binds)
             (ast/Bind
               :name "value"
               :mutable false
               :value (edge-leaf i)
               :bid i
               :owned_type (box! a ast/Type (ast/TVoid)))))
    (for [i 3 5] (push! (mut body) (edge-leaf i)))
    (for [i 6 8]
      (push! (mut arms)
             (ast/Arm
               :variant "_"
               :binds strings
               :body (edge-leaf i))))
    (let [bindings (parser/box-al [ast/Bind] a binds)
          expressions (parser/box-al [ast/Expr] a body)
          branches (parser/box-al [ast/Arm] a arms)
          leaf (box! a ast/Expr (edge-leaf 5))
          root (p/alloc-stack ast/Expr)
          visited (p/alloc-stack i64)
          (mut trace) 0]
      (store! root
              (ast/mk-expr-node-id (ast/ELet bindings expressions)
                                   10
                                   20
                                   17
                                   9
                                   314))
      (am/visit-expr-children [child root]
                              (set! trace (+ (* trace 10) (.lo child)))
                              (set! (.hi child) (+ 100 (.lo child))))
      (assert-eq trace 1234)
      (check-cloned-edges a root)
      (assert-eq (.hi (field (elem bindings 0) value)) 101)
      (assert-eq (.hi (elem expressions 0)) 103)
      (store! visited 0)
      (match (edge-fail-at-two root visited)
        (Err [n] (assert-eq n 2))
        (Ok [_] (assert false)))
      (assert-eq (load visited) 2)
      (store! visited 0)
      (assert (block :found
                (am/visit-expr-children [child root]
                                        (store! visited (+ (load visited) 1))
                                        (break :found true))
                false))
      (assert-eq (load visited) 1)
      (store! visited 0)
      (am/visit-expr-children [child root :except [ELet]]
                              (store! visited (+ (load visited) 1)))
      (assert-eq (load visited) 0)
      (am/visit-expr-children [child root :only [ELet]]
                              (store! visited (+ (load visited) 1)))
      (assert-eq (load visited) 4)
      (set! (.kind root)
            (ast/EAlloc
              :storage 0
              :ty (ast/TVoid)
              :init (zeroed (ptr ast/Expr))
              :symbol (None)))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 0)
      (set! (.kind root) (ast/EBreak (None) (Some leaf)))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 5)
      (set! (.kind root) (ast/EBreak (None) (None)))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 0)
      (set! (.kind root) (ast/EMatch leaf branches))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 567)
      (set! (.kind root)
            (ast/EBracketCall
              :func "target"
              :type_args types
              :args expressions
              :vector leaf))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 345)
      (set! (.kind root)
            (ast/EDynDispatch (box! a
                                    ast/DynCall
                                    (ast/DynCall
                                      :dyn_struct "dyn"
                                      :vtable_struct "vtable"
                                      :method_index 0
                                      :cc ""
                                      :params types
                                      :ret (ast/TVoid)
                                      :recv leaf
                                      :args expressions))))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 534)
      ; Quasiquote owns its own staging policy, rather than becoming an ordinary edge.
      (set! (.kind root) (ast/EQuasi (ast/QUnquote leaf)))
      (check-cloned-edges a root)
      (assert-eq (edge-trace root) 0)
      (match (.kind (check/ownership-clone a root))
        (ast/EQuasi [q]
                    (match q
                      (ast/QUnquote [inner]
                                    (assert (!= (cast i64 inner)
                                                (cast i64 leaf)))
                                    (assert-eq (.lo inner) (.lo leaf)))
                      (_ (assert false))))
        (_ (assert false))))
    (close! storage)))

(deftest source-span-captures-location-without-semantic-node-identity
  (let [root (p/alloc-stack ast/Expr)]
    (store! root (ast/mk-expr-node-id (ast/EInt 5) 10 20 7 9 314))
    (let [span (ast/expr-span root)]
      (set! (.lo root) 100)
      (set! (.hi root) 200)
      (set! (.source root) 77)
      (set! (.ctxt root) 99)
      (let [(mut expression) (ast/expr-from-span (ast/EInt 8) span)]
        (assert-eq (.lo expression) 10)
        (assert-eq (.hi expression) 20)
        (assert-eq (.source expression) 7)
        (assert-eq (.ctxt expression) 9)
        (assert-eq (.node-id expression) -1))
      (assert-eq (.node-id root) 314))))

(deftest source-span-preserves-diagnostic-stamping-policy
  (let [span
          (ast/SourceSpan
            :lo 10
            :hi 20
            :source 7
            :ctxt 9)
        (mut ranged) (parser/derr-at-span span "located")
        (mut unlocated) (parser/dwspan-at (parser/derr "unlocated") span)
        (mut precise) (parser/dwspan-at (parser/derr-at 11 12 "precise") span)
        (mut attributed)
          (parser/dwspan-at (parser/derr-at-src 88 -1 -1 "attributed") span)]
    (assert-eq (.lo ranged) 10)
    (assert-eq (.hi ranged) 20)
    (assert-eq (.source ranged) 7)
    (assert-eq (.ctxt ranged) 0)
    (assert-eq (.lo unlocated) 10)
    (assert-eq (.hi unlocated) 20)
    (assert-eq (.source unlocated) 7)
    (assert-eq (.ctxt unlocated) 9)
    (assert-eq (.lo precise) 11)
    (assert-eq (.hi precise) 12)
    (assert-eq (.source precise) 7)
    (assert-eq (.ctxt precise) 0)
    (assert-eq (.lo attributed) 10)
    (assert-eq (.hi attributed) 20)
    (assert-eq (.source attributed) 88)
    (assert-eq (.ctxt attributed) 9)))
