(module mt_source_output_test)
(import "coil.primitive" :as p)
(import "coil.compiler.parser" :as parser)
(import "coil.compiler.ast" :as ast)
(import "coil.compiler.ast_map" :as am)
(import "coil.scratch" :as scratch)
(import "coil.reader" :as reader)
(import "coil.alloc" :use [malloc-allocator box!])
(import "coil.arraylist" :use [ArrayList])

(deftest emitted-source-preserves-every-string-byte
  (let [a (malloc-allocator)
        (mut bytes) (ArrayList::new [u8] a)]
    (for i (range 0 256) (push! (mut bytes) (cast u8 i)))
    (let [value (slice (load bytes))]
      (for variant (range 0 2)
        (let [c-string? (= variant 1)
              literal
                (reader/mk-sexp (if c-string?
                                    (reader/KCStr value)
                                    (reader/KStr value))
                                -1
                                -1)
              source (parser/sexp-source a literal)]
          (match (reader/read-all a source 0)
            (Ok [forms]
                (do
                  (assert-eq 1 (len (load forms)))
                  (let [actual (get (load forms) 0)]
                    (assert-eq (if c-string? 5 4) (parser/sx-tag actual))
                    (assert-eq value (parser/sx-sval actual)))))
            (Err [_] (assert false))))))))

(defn edge-leaf [(n i64)] (-> ast/Expr)
  (ast/mk-expr (ast/EInt n) n n 0 0))

(defn edge-trace [(root (ptr ast/Expr))] (-> i64)
  (let [(mut trace) 0]
    (am/visit-expr-children [child root]
                            (set! trace (+ (* trace 10) (.lo child))))
    trace))

(defn edge-fail-at-two [(root (ptr ast/Expr)) (visited (ptr i64))]
  (-> (Result i64 i64))
  (try (do
         (am/visit-expr-children [child root]
                                 (store! visited (+ (load visited) 1))
                                 (when (= (.lo child) 2)
                                   (try! (Err [i64 i64] 2))))
         (Ok [i64 i64] 0))))

(deftest expression-edges-preserve-order-borrowing-and-control-flow
  (let [storage (p/alloc-stack scratch/ScratchArena)
        _init
          (scratch/ScratchArena::init-with-capacity storage
                                                    (malloc-allocator)
                                                    4096)
        a (allocator storage)
        (mut binds) (ArrayList::new [ast/Bind] a)
        (mut body) (ArrayList::new [ast/Expr] a)
        (mut arms) (ArrayList::new [ast/Arm] a)
        strings (parser/box-al [(slice u8)] a (ArrayList::new [(slice u8)] a))
        types (parser/box-al [ast/Type] a (ArrayList::new [ast/Type] a))]
    (for [i 1 3]
      (push! (mut binds)
             (ast/Bind
               :name "value"
               :mutable false
               :value (edge-leaf i)
               :bid i
               :owned_type (zeroed (ptr ast/Type)))))
    (for [i 3 5] (push! (mut body) (edge-leaf i)))
    (for [i 6 8]
      (push! (mut arms)
             (ast/Arm
               :variant "_"
               :binds strings
               :body (edge-leaf i))))
    (let [bindings (parser/box-al [ast/Bind] a binds)
          expressions (parser/box-al [ast/Expr] a body)
          branches (parser/box-al [ast/Arm] a arms)
          leaf (box! a ast/Expr (edge-leaf 5))
          root (p/alloc-stack ast/Expr)
          visited (p/alloc-stack i64)
          (mut trace) 0]
      (store! root (ast/mk-expr (ast/ELet bindings expressions) 0 0 0 0))
      (am/visit-expr-children [child root]
                              (set! trace (+ (* trace 10) (.lo child)))
                              (set! (.hi child) (+ 100 (.lo child))))
      (assert-eq trace 1234)
      (assert-eq (.hi (field (elem bindings 0) value)) 101)
      (assert-eq (.hi (elem expressions 0)) 103)
      (store! visited 0)
      (match (edge-fail-at-two root visited)
        (Err [n] (assert-eq n 2))
        (Ok [_] (assert false)))
      (assert-eq (load visited) 2)
      (store! visited 0)
      (assert (block :found
                (am/visit-expr-children [child root]
                                        (store! visited (+ (load visited) 1))
                                        (break :found true))
                false))
      (assert-eq (load visited) 1)
      (store! visited 0)
      (am/visit-expr-children [child root :except [ELet]]
                              (store! visited (+ (load visited) 1)))
      (assert-eq (load visited) 0)
      (am/visit-expr-children [child root :only [ELet]]
                              (store! visited (+ (load visited) 1)))
      (assert-eq (load visited) 4)
      (set! (.kind root)
            (ast/EAlloc
              :storage 0
              :ty (ast/TVoid)
              :init (zeroed (ptr ast/Expr))
              :symbol (None)))
      (assert-eq (edge-trace root) 0)
      (set! (.kind root) (ast/EBreak (None) (Some leaf)))
      (assert-eq (edge-trace root) 5)
      (set! (.kind root) (ast/EBreak (None) (None)))
      (assert-eq (edge-trace root) 0)
      (set! (.kind root) (ast/EMatch leaf branches))
      (assert-eq (edge-trace root) 567)
      (set! (.kind root)
            (ast/EBracketCall
              :func "target"
              :type_args types
              :args expressions
              :vector leaf))
      (assert-eq (edge-trace root) 345)
      (set! (.kind root)
            (ast/EDynDispatch (box! a
                                    ast/DynCall
                                    (ast/DynCall
                                      :dyn_struct "dyn"
                                      :vtable_struct "vtable"
                                      :method_index 0
                                      :cc ""
                                      :params types
                                      :ret (ast/TVoid)
                                      :recv leaf
                                      :args expressions))))
      (assert-eq (edge-trace root) 534)
      ; Quasiquote owns its own staging policy, rather than becoming an ordinary edge.
      (set! (.kind root) (ast/EQuasi (ast/QUnquote leaf)))
      (assert-eq (edge-trace root) 0))
    (close! storage)))
