(module mt.hygiene-alias-provider)
(import "coil.str" :as st)

;;; An ALIAS-QUALIFIED name in a template. An alias is a file-local nickname, so
;;; this can only mean anything if it resolves through THIS module's alias table.
(defn aliased-cmp [(s Code)] (-> Code)
  `(st/cmp ~s ""))

;;; A struct a caller reaches with `:use`; the decoy declares one of the same name.
(defstruct Trio [(a i64) (b i64) (c i64)])
