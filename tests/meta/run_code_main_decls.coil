;; A Code -> Code program over a loaded, checked code base: what `code-decl`
;; answers for each method call in the target module, as (MODULE QUALIFIED-NAME).
;; A method's record names the module that declares its type, also when the type
;; is generic: an impl on `(ArrayList T)` belongs to `coil.arraylist`.
(module mt_runcodemaindecls)
(import "coil.primitive" :as primitive)

(defn method-records [(f Code) (out (mut CodeBuilder))] (-> void)
  (when (and (primitive/code-list? f) (> (len f) 0))
    (match (primitive/code-decl f)
      (primitive/Declared [module kind name _]
        (match kind
          (primitive/MethodDecl [] (do (push! (mut out) `(~module ~name)) 0))
          (_ 0)))
      (_ 0))
    (for child f (method-records child (mut out)))))

(defn main [(prog Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m prog
      (when (= (get m 0) `mt_runcmmethods)
        (for form (primitive/code-rest m) (method-records form (mut out)))))
    `(~@out)))
