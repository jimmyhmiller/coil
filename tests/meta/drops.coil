(module mt_drops)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

; What `code-drops-in` answers, one line per function of the program: each value
; elaboration drops implicitly, as its type's head and, after `-`, how many of its
; parts were moved out before, and `-given` when it was given by value to a trait
; method through a bound. Asked with the defining form, and once by name.

(defn head-text [(t Code)] (-> (slice u8))
  (if (primitive/code-sym? t) (primitive/code-str t) (head-text (primitive/code-nth t 0))))

(defn show-drops [(name (slice u8)) (answer primitive/DropsAnswer)] (-> i64)
  (match answer
    (primitive/DropsAre [ds]
      (print "{}:" name)
      (for d (iter ds)
        (print " {}-{}{}" (head-text (primitive/code-nth d 0)) (len (primitive/code-nth d 2))
               (if (= (primitive/code-str (primitive/code-nth d 3)) "given") "-given" "")))
      (println "")
      0)
    (primitive/DropsUnknown [why] (println "{}: unknown" name) 0)))

(defn drops-check [(modules Code)] (-> Code)
  (for m (iter modules)
    (when (primitive/code-eq (primitive/code-nth m 0) `mt_drops_target)
      (for form (iter (primitive/code-rest m))
        (when (and (primitive/code-from-user? form) (primitive/code-list? form) (> (len form) 1)
                   (primitive/code-eq (primitive/code-nth form 0) `defn*))
          (show-drops (primitive/code-str (primitive/code-nth form 1)) (meta/drops-in form))))))
  (show-drops "by-name" (meta/drops-in `mt_drops_target.part))
  (show-drops "nowhere" (meta/drops-in `mt_drops_target.nowhere))
  `0)

(checker drops-check)
