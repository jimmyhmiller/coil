(module mt.concurrent-edit-rule)
(import "coil.primitive" :as primitive)

;;; A checker that is also a concurrent editor. It runs inside `coil lint --fix`'s
;;; analysis, after the file was read and before the fix it suggests is written,
;;; and appends a line to `concurrent_edit_target.coil` in the working directory
;;; then, once (`concurrent_edit.done` says it has). That is an editor saving the
;;; file while lint runs, at the one moment that matters, every time: lint must
;;; leave the edit in place, and say so, rather than write over it or "restore"
;;; the file.
(extern fopen :cc c [(ptr i8) (ptr i8)] (-> (ptr i8)))
(extern fputs :cc c [(ptr i8) (ptr i8)] (-> i32))
(extern fclose :cc c [(ptr i8)] (-> i32))

(defn edit! [] (-> i64)
  ; "x": creating the marker fails when it exists
  (let [once (fopen c"concurrent_edit.done" c"wx")]
    (when (!= (cast i64 once) 0)
      (fclose once)
      (let [f (fopen c"concurrent_edit_target.coil" c"ab")]
        (fputs c"; edited meanwhile\n" f)
        (fclose f))
      0)
    0))

(defn identity-factor? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (= (len f) 3)
       (= (get f 0) `primitive/imul)
       (= (get f 2) `1)))

(defn walk [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (primitive/code-from-user? f) (identity-factor? f))
          (do
            (edit!)
            (primitive/suggest f "drop the identity factor" (get f 1)))
          (do (for child (iter f) (walk child)) `0))
      `0))

(defn edit-and-suggest [(modules Code)] (-> Code)
  (do (for m (iter modules) (walk m)) `0))

(checker edit-and-suggest)
