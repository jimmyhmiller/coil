(module mt.hygiene-alias-decoy)

(export cmp Eq same? Trio)

;;; Bound to the alias `st` at the CALL site, and exporting the same name the
;;; provider's template reaches for.
(defn cmp [(a (slice u8)) (b (slice u8))] (-> i64)
  999)

;;; A trait of this module's own that shares core's name, with a deriver of its
;;; own: `st/Eq` at the call site is this trait, and `Eq` there is still core's.
(deftrait Eq [Self] (same? [(a Self) (b Self)] (-> i64)))

(defderive Eq
  (struct [T] `(impl Eq ~T (same? [(a ~T) (b ~T)] (-> i64) 30))))

;;; Named like the provider's `Trio`, which the caller imports with `:use`.
(defstruct Trio [(a i64) (b i64) (c i64) (d i64) (e i64)])
