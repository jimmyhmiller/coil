;; Spelling target: a trait a macro declares, called through a bound. It is
;; named `Get`, as coil.core's collection trait is: the bound names this one.
(module mt_runcmspelled)

(defn declare-trait [(name Code)] (-> Code)
  `(deftrait ~name [Self] (weigh [(self (ptr Self))] (-> i64))))

(declare-trait Get)

(defstruct Crate [(kg i64)])

(impl Get Crate (weigh [(self (ptr Crate))] (-> i64) (load (field self kg))))

(defn weight [(W Get)] [(w (mut W))] (-> i64) (Get::weigh (mut w)))

(defn main [] (-> i64)
  (let [(mut c) (Crate :kg 3)]
    (weight (mut c))))
