(module mt.hygiene-identity)
(import "coil.primitive" :as primitive)
(import "mt.hygiene-alias-provider" :use [aliased-cmp aliased-eof?])
;; The caller binds `st` to a DIFFERENT module that exports `cmp` too.
(import "mt.hygiene-alias-decoy" :as st)

;;; Macro hygiene, the half where names must connect. Each check yields 42 only
;;; when every identifier means what its author meant, and a capture in either
;;; direction changes the number rather than merely failing to compile. `main`
;;; exits 42 when all of them hold, or names the check that broke.

; 1. `quote`: one quoted identifier object, reused for a binder and its
;    reference, binds to itself and leaves the caller's `tmp` alone:
;    1042 - 1000 = 42. Binding by spelling would capture the caller's and give 0.
(defn wrap [(e Code)] (-> Code)
  (let [id 'tmp]
    `(let [~id 1000]
       (primitive/isub ~e ~id))))

(defn quote-check [] (-> i64)
  (let [tmp 1042]
    (wrap tmp)))

; 2. Two templates connect a binder and a reference through ONE identifier
;    object made by `fresh-identifier`: 41 + 1 = 42.
(defn operation [(state Code)] (-> Code)
  `(primitive/iadd ~state 1))

; hygiene: the generated check is named so that `main` can call it.
(defn generate [] (-> Code)
  (let [state (primitive/fresh-identifier "state")
        name (primitive/syntax->datum (primitive/fresh-identifier "explicit-check"))]
    `(defn ~name [] (-> i64)
       (let [~state 41]
         ~(operation state)))))

(meta (generate))

; 3. An alias-qualified name in a template resolves where the template was
;    WRITTEN: the provider's `st/cmp` is coil.str's ("hello" against "" is 5), this
;    module's is the decoy's (999): 5 + (999 - 962) = 42. Resolving at the call site
;    gives 1036.
(defn alias-check [] (-> i64)
  (primitive/iadd (aliased-cmp "hello")
                  (primitive/isub (st/cmp "x" "") 962)))

; 4. A semantic transform re-reads its own output on every fixpoint round. The
;    `tmp` it introduces stays its own, and the `tmp` it transports out of the
;    user's `(sem-marker …)` stays the user's: 1042 - 1000 = 42.
(defn marker-head? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (> (len f) 0)
       (= (get f 0) `sem-marker)))

(defn has-marker? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (or (marker-head? f) (any? (fn [child] (has-marker? child)) f))))

; Untouched subtrees are returned as they are; only the marked region is rebuilt.
(defn rewrite [(f Code)] (-> Code)
  (cond (marker-head? f)
          `(let* [tmp 1000]
             (primitive/isub ~(rewrite (get f 1)) tmp))
        (has-marker? f)
          (let [(mut kids) (primitive/code-list-new)]
            (for child f (push! (mut kids) (rewrite child)))
            (primitive/code-list-like f `(~@kids)))
        :else f))

(defn surface-pass [(modules Code)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for m modules (push! (mut out) (rewrite m)))
    `(~@out)))

(transform surface-pass)

(defn transform-check [] (-> i64)
  (let [tmp 1042]
    (sem-marker tmp)))

; 5. The provider's pattern `cio/Eof` names coil.io's variant through ITS alias,
;    which this module does not have: 40 + 2 = 42.
(defn pattern-check [] (-> i64)
  (primitive/iadd (aliased-eof? (coil.io.Eof)) 2))

(defn main [] (-> i64)
  (cond (!= (quote-check) 42) 1
        (!= (explicit-check) 42) 2
        (!= (alias-check) 42) 3
        (!= (transform-check) 42) 4
        (!= (pattern-check) 42) 5
        :else 42))
