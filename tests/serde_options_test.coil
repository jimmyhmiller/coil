; Derive-option tests: rename / rename-all / default / skip / with / boxed /
; deny-unknown, across backends where the behavior is observable.
(module serde-options-tests)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.json" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.msgpack" :use *)

(defn de-code [(e DeError)] (-> i64)
  (let [c (primitive/alloc-stack DeError)]
    (set! c e)
    (load c)
    (.code c)))

; ---- rename / rename-all ----------------------------------------------------
(defstruct Cfg [(host-name (slice u8)) (max-retries i64) (port i64)])
(derive (Serialize (rename-all :camelCase) (field port (rename "listenPort")))
        (Deserialize (rename-all :camelCase) (field port (rename "listenPort")))
        Cfg)

(deftest rename-and-rename-all
         (let [a (malloc-allocator)
               (mut c) (primitive/zeroed Cfg)]
           (store! (field c host-name) "h")
           (store! (field c max-retries) 3)
           (store! (field c port) 80)
           (match (to-json-str a (load c))
             (Err [_] (assert false))
             (Ok [s]
                 (do
                   (assert (= s "{\"hostName\":\"h\",\"maxRetries\":3,\"listenPort\":80}"))
                   (match (from-json [Cfg] a s)
                     (Err [_] (assert false))
                     (Ok [c2v]
                         (let [c2 (primitive/alloc-stack Cfg)]
                           (store! c2 c2v)
                           (assert-eq (load (field c2 max-retries)) 3)
                           (assert-eq (load (field c2 port)) 80)))))))))

(defstruct Snek [(max-retries i64)])
(derive (Serialize (rename-all :snake_case)) (Deserialize (rename-all :snake_case)) Snek)
(deftest rename-all-snake
         (let [a (malloc-allocator)
               (mut v) (primitive/zeroed Snek)]
           (store! (field v max-retries) 9)
           (match (to-json-str a (load v))
             (Err [_] (assert false))
             (Ok [s] (assert (= s "{\"max_retries\":9}"))))))

; ---- default / skip ---------------------------------------------------------
(defstruct Opts
  [(port i64)
   (level i64)
   (secret (slice u8))
   (cache i64)])
(derive (Serialize (field port (default 8080))
                   (field level (default -1))
                   (field secret (skip) (default "unset"))
                   (field cache (skip-serializing)))
        (Deserialize (field port (default 8080))
                     (field level (default -1))
                     (field secret (skip) (default "unset"))
                     (field cache (skip-serializing)))
        Opts)

(deftest default-and-skip
         (let [a (malloc-allocator)
               (mut o) (primitive/zeroed Opts)]
           (store! (field o port) 9000)
           (store! (field o level) 5)
           (store! (field o secret) "hunter2")
           (store! (field o cache) 7)
           ; skip + skip-serializing fields never serialize
           (match (to-json-str a (load o))
             (Err [_] (assert false))
             (Ok [s] (assert (= s "{\"port\":9000,\"level\":5}"))))
           ; absent fields take their defaults; skipped-with-default gets the default;
           ; skip-serializing (no skip-deserializing) still READS when present
           (match (from-json [Opts] a "{\"cache\": 42}")
             (Err [_] (assert false))
             (Ok [o2v]
                 (let [o2 (primitive/alloc-stack Opts)]
                   (store! o2 o2v)
                   (assert-eq (load (field o2 port)) 8080)
                   (assert-eq (load (field o2 level)) -1)
                   (assert (= (load (field o2 secret)) "unset"))
                   (assert-eq (load (field o2 cache)) 42))))))

; ---- with (custom hooks) ----------------------------------------------------
(defstruct Stamp [(secs i64) (nanos i64)])
(defn stamp-ser [(x Stamp) (s (dyn Serializer))] (-> (Result i64 SerError))
  (ser-i64 s (.secs x)))  ; wire = epoch seconds only
(defn stamp-de [(out (ptr Stamp)) (d (dyn Deserializer))] (-> (Result i64 DeError))
  (match (de-i64 d)
    (Err [e] (Err e))
    (Ok [v]
        (do
          (set! (.secs out) v)
          (set! (.nanos out) 0)
          (Ok 0)))))

(defstruct Event [(kind (slice u8)) (at Stamp)])
(derive (Serialize (field at (with stamp-ser stamp-de)))
        (Deserialize (field at (with stamp-ser stamp-de)))
        Event)

(deftest with-hooks
         (let [a (malloc-allocator)
               (mut e) (primitive/zeroed Event)]
           (store! (field e kind) "login")
           (store! (field (field e at) secs) 1754265600)
           (store! (field (field e at) nanos) 999)
           (match (to-json-str a (load e))
             (Err [_] (assert false))
             (Ok [s]
                 (do
                   (assert (= s "{\"kind\":\"login\",\"at\":1754265600}"))
                   (match (from-json [Event] a s)
                     (Err [_] (assert false))
                     (Ok [e2v]
                         (let [e2 (primitive/alloc-stack Event)]
                           (store! e2 e2v)
                           (assert-eq (load (field (field e2 at) secs)) 1754265600)
                           (assert-eq (load (field (field e2 at) nanos)) 0)))))))))

; ---- deny-unknown -----------------------------------------------------------
(defstruct Strict [(x i64) (y i64)])
(derive (Serialize (deny-unknown)) (Deserialize (deny-unknown)) Strict)
(defstruct Lax [(x i64) (y i64)])
(derive Serialize Deserialize Lax)

(deftest deny-unknown-opt-in
         (let [a (malloc-allocator)]
           ; strict: unknown key -> DE-E-UNKNOWN-FIELD (19), in every format
           (match (from-json [Strict] a "{\"x\":1,\"zzz\":9,\"y\":2}")
             (Err [e] (assert-eq (de-code e) 19))
             (Ok [_] (assert false)))
           (match (from-sexp [Strict] a "(Strict x 1 zzz 9 y 2)")
             (Err [e] (assert-eq (de-code e) 19))
             (Ok [_] (assert false)))
           ; known keys in any order still fine
           (match (from-json [Strict] a "{\"y\":2,\"x\":1}")
             (Err [_] (assert false))
             (Ok [v]
                 (let [vp (primitive/alloc-stack Strict)]
                   (store! vp v)
                   (assert-eq (load (field vp x)) 1))))
           ; the DEFAULT stays skip-unknown
           (match (from-json [Lax] a "{\"x\":1,\"zzz\":9,\"y\":2}")
             (Err [_] (assert false))
             (Ok [v]
                 (let [vp (primitive/alloc-stack Lax)]
                   (store! vp v)
                   (assert-eq (load (field vp y)) 2))))))

; ---- boxed (recursion) ------------------------------------------------------
; a cons list: recursion terminates through the End variant, so every (ptr Link)
; is a real boxed child — the canonical (boxed) shape
(defsum-serde Link
              (End)
              (Node [(value i64) (next (ptr Link))])
              (field next (boxed)))

(defn link-sum [(l (ptr Link))] (-> i64)
  (match (load l)
    (End [] 0)
    (Node [v nx] (primitive/iadd v (link-sum nx)))))

(deftest boxed-recursion
         (let [a (malloc-allocator)
               end (box! a Link (zeroed Link))
               n2 (box! a Link (zeroed Link))
               n1 (primitive/alloc-stack Link)]
           (store! end (End))
           (store! n2 (Node 20 end))
           (store! n1 (Node 10 n2))
           (match (to-json-str a (load n1))
             (Err [_] (assert false))
             (Ok [s]
                 (do
                   (assert (= s "{\"Node\":{\"value\":10,\"next\":{\"Node\":{\"value\":20,\"next\":\"End\"}}}}"))
                   (match (from-json [Link] a s)
                     (Err [_] (assert false))
                     (Ok [l2v]
                         (let [l2 (primitive/alloc-stack Link)]
                           (store! l2 l2v)
                           (assert-eq (link-sum l2) 30)))))))
           ; and through the binary format
           (match (to-msgpack-bytes a (load n1))
             (Err [_] (assert false))
             (Ok [b]
                 (match (from-msgpack [Link] a b)
                   (Err [_] (assert false))
                   (Ok [l3v]
                       (let [l3 (primitive/alloc-stack Link)]
                         (store! l3 l3v)
                         (assert-eq (link-sum l3) 30))))))))

; ---- options on sums --------------------------------------------------------
(defsum-serde Msg
              (Ping)
              (Say [(text (slice u8)) (volume i64)])
              (rename-all :camelCase)
              (field text (rename "t"))
              (field volume (default 5)))

(deftest sum-options
         (let [a (malloc-allocator)]
           (match (to-json-str a (Say "hey" 11))
             (Err [_] (assert false))
             (Ok [s]
                 (do
                   (assert (= s "{\"Say\":{\"t\":\"hey\",\"volume\":11}}"))
                   0)))
           ; absent volume -> default
           (match (from-json [Msg] a "{\"Say\":{\"t\":\"yo\"}}")
             (Err [_] (assert false))
             (Ok [m]
                 (match m
                   (Ping [] (assert false))
                   (Say [t v]
                        (do
                          (assert (= t "yo"))
                          (assert-eq v 5))))))))
