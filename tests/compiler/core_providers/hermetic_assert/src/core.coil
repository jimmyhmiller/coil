(module board.core)
(import "coil.primitive" :as primitive)

; The motivating override: an embedded target that records a fault to a cell
; instead of executing the trap instruction coil.assert.hermetic emits.
(defn fault-cell [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn assert-eq [(x Code) (y Code)] (-> Code)
  `(if (= ~x ~y) 0 (do (store! (fault-cell) 1) 0)))

(provide-core [assert-eq])
