(module binding.policy)
(import "coil.primitive" :as primitive)

(defn check-binding-node [(form Code)] (-> i64)
  (if (primitive/code-list? form)
      (let [n (primitive/code-count form)]
        (when (> n 0)
          (let [head (primitive/code-nth form 0)]
            (when (and (primitive/code-sym? head)
                       (primitive/code-eq head `target/answer))
              (let [decl (primitive/code-decl form)]
                (unless (and (primitive/code-list? decl)
                             (and (>= (primitive/code-count decl) 4)
                                  (primitive/code-eq (primitive/code-nth decl 3)
                                                     `binding.target.answer)))
                  (primitive/report form "code-decl lost the exact canonical function identity")
                  0))
              0))
          0)
        (check-binding-kids form 0 n))
      0))

(defn check-binding-kids [(form Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (do
        (check-binding-node (primitive/code-nth form i))
        (check-binding-kids form (+ i 1) n))))

(defn check-binding-modules [(modules Code) (i i64) (n i64)] (-> i64)
  (if (>= i n)
      0
      (let [m (primitive/code-nth modules i)]
        (do
          (check-binding-kids m 1 (primitive/code-count m))
          (check-binding-modules modules (+ i 1) n)))))

(defn check-binding-identity [(modules Code)] (-> Code)
  (do
    (check-binding-modules modules 0 (primitive/code-count modules))
    `0))
