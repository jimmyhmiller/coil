(module unprovided.core)

; This module has no literal `(export ...)`, which is the case that used to leak:
; the reexport edge activating a provider was filtered by the export table, and a
; provide-core list never reached that table, so EVERY definition here went ambient.
(defn provided [] (-> i64)
  1)

(defn secret [] (-> i64)
  42)

(provide-core [provided])
