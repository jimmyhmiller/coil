(module tests.compiler.jit-leaf-resolution-test)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new push!])
(import "coil.assert" :use *)
(import "coil.compiler.jit" :use [JitSym jit-syms-lookup-unique-leaf])

(deftest retained-session-symbol-wins-over-imported-and-carried-leaves
  (let [a (malloc-allocator) (mut symbols) (al-new [JitSym] a)]
    ; Newest generations appear first. The carried import and dependency make
    ; generic leaf lookup ambiguous before the older session owner is visited.
    (push! [JitSym] (mut symbols)
      (JitSym :name "_lighting"
              :addr (primitive/cast (ptr i8) 11)
              :owner (primitive/cast (ptr i8) 0)))
    (push! [JitSym] (mut symbols)
      (JitSym :name "_paper.lighting.lighting"
              :addr (primitive/cast (ptr i8) 22)
              :owner (primitive/cast (ptr i8) 0)))
    (push! [JitSym] (mut symbols)
      (JitSym :name "_repl_static.replsession.lighting"
              :addr (primitive/cast (ptr i8) 33)
              :owner (primitive/cast (ptr i8) 0)))
    (push! [JitSym] (mut symbols)
      (JitSym :name "_replsession.lighting"
              :addr (primitive/cast (ptr i8) 44)
              :owner (primitive/cast (ptr i8) 0)))
    (assert-eq 44
      (primitive/cast i64
        (jit-syms-lookup-unique-leaf (mut symbols) "_lighting")))))
