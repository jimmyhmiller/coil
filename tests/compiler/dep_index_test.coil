(module compiler.tests.dep-index)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.dbgalloc" :use *)
(import "coil.compiler.sem_base" :use *)
(import "coil.compiler.dep_index" :use *)

; Record that `reader` reads `first` and (when non-empty) `second`, from names built
; in memory that is destroyed before anything is read back.
(defn record! [(base (ptr DepBase))
               (a (dyn Allocator))
               (reader (slice u8))
               (first (slice u8))
               (second (slice u8))] (-> i64)
  (let [throwaway (debug-allocator-init (malloc-allocator))
        ta (debug-allocator-view throwaway)
        owner (sem-owner-new a)
        (mut names) (al-new [(slice u8)] ta)]
    (push! (mut names) (sem-own-bytes ta first))
    (when (> (len second) 0) (push! (mut names) (sem-own-bytes ta second)) 0)
    (dep-base-set-reads! base owner (sem-own-bytes ta reader) (mut names))
    (sem-owner-done! owner)
    (debug-allocator-deinit! throwaway)
    0))

(defn reads? [(base (ptr DepBase)) (name (slice u8)) (reader (slice u8))] (-> bool)
  (let [(mut out) (al-new [(slice u8)] (malloc-allocator))
        (mut found) false]
    (dep-base-readers! base name (mut out))
    (for [i 0 (len out)] (when (= (get out i) reader) (set! found true) 0))
    (al-free! (mut out))
    (load found)))

(defn reader-count [(base (ptr DepBase)) (name (slice u8))] (-> i64)
  (let [(mut out) (al-new [(slice u8)] (malloc-allocator))]
    (dep-base-readers! base name (mut out))
    (let [n (len out)] (al-free! (mut out)) n)))

(deftest edges-are-kept-both-ways-and-own-their-names
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [base (dep-base-new a)]
             (record! base a "shapes.unit" "shapes.area" "")
             (record! base a "shapes.volume" "shapes.area" "shapes.Box")
             (assert (reads? base "shapes.area" "shapes.unit"))
             (assert (reads? base "shapes.area" "shapes.volume"))
             (assert (reads? base "shapes.Box" "shapes.volume"))
             (assert (not (reads? base "shapes.Box" "shapes.unit")))
             (assert-eq (reader-count base "shapes.area") 2)
             (assert-eq (reader-count base "shapes.nothing") 0)
             (dep-base-release! base))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest replacing-a-reader-replaces-its-edges
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [base (dep-base-new a)]
             (record! base a "shapes.unit" "shapes.area" "shapes.Box")
             (record! base a "shapes.other" "shapes.area" "")
             ; unit is redefined and no longer mentions area; the first reader of area is
             ; the one whose storage named the entry, and it is the one that leaves.
             (record! base a "shapes.unit" "shapes.Box" "")
             (assert (not (reads? base "shapes.area" "shapes.unit")))
             (assert (reads? base "shapes.area" "shapes.other"))
             (assert (reads? base "shapes.Box" "shapes.unit"))
             (dep-base-forget! base "shapes.other")
             (assert-eq (reader-count base "shapes.area") 0)
             (dep-base-forget! base "shapes.unit")
             (assert-eq (dep-base-reader-count base) 0)
             (dep-base-release! base))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest a-derived-base-shares-and-the-old-one-is-undisturbed
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [old (dep-base-new a)]
             (for [i 0 300]
               (record! old a (if (= (% i 2) 0) "m.even" "m.odd") "m.shared" ""))
             (record! old a "m.unit" "m.area" "")
             (let [before (.live-allocations debug)
                   next (dep-base-derive a old)]
               (record! next a "m.unit" "m.perimeter" "")
               (assert (< (- (.live-allocations debug) before) 200))
               (assert (reads? old "m.area" "m.unit"))
               (assert (not (reads? old "m.perimeter" "m.unit")))
               (assert (not (reads? next "m.area" "m.unit")))
               (assert (reads? next "m.perimeter" "m.unit"))
               (assert (reads? next "m.shared" "m.even"))
               (dep-base-release! old)
               (assert (reads? next "m.shared" "m.odd"))
               (assert (reads? next "m.perimeter" "m.unit"))
               (dep-base-release! next)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest storage-plateaus-across-many-replacements
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [base (dep-base-new a)]
             (record! base a "m.keep" "m.area" "")
             (record! base a "m.edited" "m.area" "m.first")
             (let [settled (.live-allocations debug)]
               (for [i 0 200]
                 (record! base
                          a
                          "m.edited"
                          "m.area"
                          (if (= (% i 2) 0) "m.a" "m.b")))
               (assert (< (- (.live-allocations debug) settled) 40))
               (assert (reads? base "m.area" "m.edited"))
               (assert (reads? base "m.area" "m.keep")))
             (dep-base-release! base))
           (assert-eq (debug-allocator-deinit! debug) 0)))
