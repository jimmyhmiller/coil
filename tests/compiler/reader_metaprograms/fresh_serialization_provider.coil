(module reader.fixture.fresh-serialization)
(import "coil.primitive" :as primitive)

(reader-provider "reader.fixture.fresh-serialization" read-source)

;; Two fresh definitions intentionally share a display spelling. The direct
;; reader entry must serialize their hidden identities into distinct ordinary
;; Coil names, without colliding with the explicitly authored `helper__1`.
(defn read-source [(context Code)] (-> Code)
  (let [first (primitive/fresh-identifier "helper")
        second (primitive/fresh-identifier "helper")]
    `(do
       (module reader.fixture.fresh-serialization-output)
       (defn helper__1 [] (-> i64)
         99)
       (defn ~first [] (-> i64)
         20)
       (defn ~second [] (-> i64)
         22)
       (defn main [] (-> i64)
         (+ (~first) (~second))))))
