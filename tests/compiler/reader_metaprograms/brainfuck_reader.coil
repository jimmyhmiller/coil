(module reader.fixture.brainfuck.reader)

(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len slice-get])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.alloc" :as alloc)
(import "coil.mem" :use [mem-zero])
(import "coil.control" :use [scope return-from])
(import "coil.str" :as str)

;;; `cells-id` and `dp-id` are the exact syntax objects bound by the generated
;;; main function. Equal display spelling is never used as a linkage protocol.
(defn bf-command [(op i64) (cells-id Code) (dp-id Code)
                  (putchar-id Code) (getchar-id Code)] (-> Code)
  (cond (= op #\>)
          `(if (= (load ~dp-id) 29999)
             (coil.control.return-from :program 2)
             (store! ~dp-id (+ (load ~dp-id) 1)))
        (= op #\<)
          `(if (= (load ~dp-id) 0)
             (coil.control.return-from :program 3)
             (store! ~dp-id (- (load ~dp-id) 1)))
        (= op #\+)
          `(let [cell (primitive/index ~cells-id (load ~dp-id))]
             (store! cell (primitive/cast u8 (+ (primitive/cast i64 (load cell)) 1))))
        (= op #\-)
          `(let [cell (primitive/index ~cells-id (load ~dp-id))]
             (store! cell (primitive/cast u8 (- (primitive/cast i64 (load cell)) 1))))
        (= op #\.)
          `(~putchar-id (primitive/cast i32 (load (primitive/index ~cells-id (load ~dp-id)))))
        (= op #\,)
          `(let [c (~getchar-id)]
             (store! (primitive/index ~cells-id (load ~dp-id))
                     (if (< c 0) (primitive/cast u8 0) (primitive/cast u8 c))))
        :else `0))

(defn bf-error-message [(context Code) (at i64) (problem (slice u8))] (-> (slice u8))
  (let [(mut message) (str/sb-new (malloc-allocator))]
    (str/sb-push-str! (mut message) "brainfuck reader: ")
    (str/sb-push-str! (mut message) problem)
    (str/sb-push-str! (mut message) " in ")
    (str/sb-push-str! (mut message)
                      (primitive/code-str (primitive/code-nth context 1)))
    (str/sb-push-str! (mut message) " at byte ")
    (str/sb-push-i64! (mut message) at)
    (str/sb-finish! (mut message))))

;;; Parse one balanced sequence. A growable Code list makes flat input linear:
;;; each command is pushed once instead of repeatedly suffix-splicing an array.
;;; Recursion is only for native loop nesting and is capped for a useful failure.
(defn bf-compile-seq [(context Code) (source (slice u8)) (start i64)
                      (nested bool) (depth i64) (cells-id Code) (dp-id Code)
                      (putchar-id Code) (getchar-id Code)] (-> Code)
  (if (> depth 1024)
      (primitive/error
        (bf-error-message context start "loop nesting exceeds 1024"))
      (let [forms (primitive/code-list-new)
            (mut i) start
            (mut done) false]
        (loop
          (if (or (load done) (>= (load i) (slice-len source)))
              (break)
              (let [op (primitive/cast i64 (slice-get source (load i)))]
                (cond (= op #\])
                        (if nested
                            (do (store! i (+ (load i) 1)) (store! done true) 0)
                            (primitive/error
                              (bf-error-message context (load i) "unmatched ']'")))
                      (= op #\[)
                        (let [body-result (bf-compile-seq context source (+ (load i) 1)
                                                          true (+ depth 1) cells-id dp-id
                                                          putchar-id getchar-id)
                              body (primitive/code-nth body-result 0)
                              next (primitive/code-int (primitive/code-nth body-result 1))]
                          (primitive/code-list-push!
                            forms
                            `(loop
                               (when (= (load (primitive/index ~cells-id (load ~dp-id)))
                                        (primitive/cast u8 0))
                                 (break)
                                 0)
                               ~@body))
                          (store! i next))
                      (or (= op #\>) (= op #\<) (= op #\+) (= op #\-)
                          (= op #\.) (= op #\,))
                        (do (primitive/code-list-push! forms
                              (bf-command op cells-id dp-id putchar-id getchar-id))
                            (store! i (+ (load i) 1))
                            0)
                      :else (do (store! i (+ (load i) 1)) 0)))))
        (if (and nested (not (load done)))
            (primitive/error
              (bf-error-message context start "unmatched '['"))
            `(~forms ~(load i))))))

;;; Read raw Brainfuck at compile time and emit a complete ordinary Coil module.
;;; The result has direct operations and native loops: no opcode stream, program
;;; counter, dispatch loop, evaluator, or runtime Brainfuck dependency.
(defn read-brainfuck [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        cells-id (primitive/fresh-identifier "cells")
        dp-id (primitive/fresh-identifier "dp")
        ; hygiene: reader-emitted externs and entry declarations intentionally
        ; belong to the generated target module's declaration context.
        putchar-id (primitive/datum->syntax context "putchar")
        getchar-id (primitive/datum->syntax context "getchar")
        main-name (primitive/datum->syntax context "main")
        result (bf-compile-seq context source 0 false 0 cells-id dp-id putchar-id getchar-id)
        forms (primitive/code-nth result 0)]
    `(do
       (module brainfuck-program)
       (import "coil.primitive" :as primitive)
       (import "coil.alloc" :as alloc)
       (import "coil.mem" :use [mem-zero])
       (import "coil.control" :use [scope return-from])
       (extern ~putchar-id :cc c [i32] (-> i32))
       (extern ~getchar-id :cc c [] (-> i32))
       (defn ~main-name [] (-> i64)
         (let [tape (primitive/alloc-stack (array u8 30000))
               ~cells-id (primitive/cast (ptr u8) tape)
               _zero (coil.mem.mem-zero [u8] ~cells-id 30000)
               (mut ~dp-id) 0]
           (coil.control.scope :program
             ~@forms
             0))))))
