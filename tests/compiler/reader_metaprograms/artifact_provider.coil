(module reader.fixture.artifact)
(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-len])

; Exercise an effectful ordinary helper closure while compiling.  None of the
; filesystem/provider machinery is authority granted to the emitted program.
(defn read-input [(path (slice u8))] (-> (slice u8))
  (let [a (alloc/malloc-allocator)]
    (match (fs/read-file a path)
      (Ok [source] source)
      (Err [_] (primitive/error "artifact reader: read failed")))))

(defn read-source [(context Code)] (-> Code)
  (let [path (primitive/code-str (primitive/code-nth context 1))
        source (read-input path)
        ; hygiene: a reader owns the generated source module and intentionally gives its entry the module's use-site context.
        main-name (primitive/datum->syntax context "main")]
    (if (> (slice-len [u8] source) 0)
        `(defn ~main-name [] (-> i64)
           42)
        (primitive/error "artifact reader: empty input"))))

(reader-provider "reader.fixture.artifact" read-source)
