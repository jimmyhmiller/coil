(module reader.fixture.ownership-named-constructor.reader)
(import "coil.primitive" :as primitive)

(defstruct Owner [(value i64)])

; A reader expansion assigns the generated forms to the invocation's source
; location. Owning named constructors must remain valid across that boundary.
(defn read-source [(context Code)] (-> Code)
  (let [wrapper-name (primitive/datum->syntax context "Wrapper")
        make-name (primitive/datum->syntax context "make-wrapper")
        main-name (primitive/datum->syntax context "main")]
    `(do
       (impl Clone Owner
         (clone [(self (ref Owner))] (-> Owner)
           (Owner :value (.value self))))
       (impl Drop Owner
         (drop [(self (mut Owner))] (-> void)
           (do)))
       (defstruct ~wrapper-name [(owner Owner)])
       (defn ~make-name [(value i64)] (-> ~wrapper-name)
         (~wrapper-name :owner
           (manually-drop-into-inner
             (manually-drop (Owner :value value)))))
       (defn ~main-name [] (-> i64)
         (let [wrapper (~make-name 42)]
           0)))))
