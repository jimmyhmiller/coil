(module reader.fixture.computed)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)

(reader-provider "reader.fixture.computed" read-source)

(defn read-source [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        inputs (primitive/code-nth context 4)
        args (primitive/code-nth context 5)
        a (alloc/malloc-allocator)
        (mut out) (str/sb-new a)]
    (str/sb-push-str! (mut out) "(defn main [] (-> i64) ")
    (str/sb-push-str! (mut out)
                      (if (= source "42")
                          source
                          (primitive/int->str
                            (+ (* (- (primitive/code-count inputs) 1) 10)
                               (- (primitive/code-count args) 1)))))
    (str/sb-push-str! (mut out) ")")
    (primitive/code-read (str/sb-str (load (mut out))) `(reader-config))))
