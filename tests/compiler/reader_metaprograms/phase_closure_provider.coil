(module reader.fixture.phase-closure)
(import "coil.primitive" :as primitive)

; An ordinary-signature helper can still belong exclusively to the comptime
; reader closure. Post-check lowering must not send its Code-only error operation
; to runtime monomorphization.
(defn reader-error [(message (slice u8))] (-> i64)
  (primitive/error message))

(defn read-source [(context Code)] (-> Code)
  (if (= (primitive/code-str (get context 2)) "ok")
      `(do
         (module phase-closure-result)
         (defn main [] (-> i64)
           0))
      (do
        (reader-error "phase closure reader rejected its input")
        `())))

(reader-provider "reader.fixture.phase-closure" read-source)
