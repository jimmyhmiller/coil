(module reader.fixture.json)
(import "coil.primitive" :as primitive)

(reader-provider "reader.fixture.json" read-json)

(defn read-json [(context Code)] (-> Code)
  (let [source (primitive/code-nth context 2)]
    (cond (primitive/code-eq source `"{\"answer\": 42, \"name\": \"Coil\"}\n")
            (primitive/code-read "(const answer 42)" `(reader-config))
          (primitive/code-eq source `"{\"offset\": 1}\n") (primitive/code-read "(const offset 1)" `(reader-config))
          (primitive/code-eq source `"// coil-module: json-import.header\nheader-value\n")
            (primitive/code-read "(const value 2)" `(reader-config))
          :else
          ; The manifest also loads this provider before reading the ordinary
          ; Coil entry. Delegate those bytes to the standard reader.
          (primitive/code-read source `(reader-config)))))
