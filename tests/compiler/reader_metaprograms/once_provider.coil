(module reader.fixture.once)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.str" :as str)

(reader-provider "reader.fixture.once" read-source)

(defn read-source [(context Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        args (primitive/code-nth context 5)
        counter (primitive/code-str (primitive/code-nth args 1))
        (mut text) (str/sb-new a)]
    (match (fs/read-file a counter)
      (Ok [old] (str/sb-push-str! (mut text) old))
      (Err [_] 0))
    (str/sb-push-str! (mut text) "x")
    (match (fs/write-file a counter (str/sb-str (load (mut text))))
      (Ok [_]
          `(defn main [] (-> i64)
             42))
      (Err [_] (primitive/error "reader fixture: counter write failed")))))
