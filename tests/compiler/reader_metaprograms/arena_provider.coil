(module reader.fixture.arena)
(import "coil.primitive" :as primitive)
(import "coil.meta" :use [expansion-allocator])
(import "coil.str" :as str)

(reader-provider "reader.fixture.arena" read-source)

(defn read-source [(context Code)] (-> Code)
  (let [a (expansion-allocator)
        (mut out) (str/sb-new a)
        (mut i) 0]
    ; Exercise repeated growth/remap through the borrowed allocator. Only the
    ; returned Code crosses the invocation boundary.
    (str/sb-push-str! (mut out) "(defn main [] (-> i64) ")
    (loop (if (>= (load i) 4096)
              (break)
              (do
                (str/sb-push-str! (mut out) " ")
                (set! i (+ (load i) 1)))))
    (str/sb-push-str! (mut out) "42)")
    (primitive/code-read (str/sb-str (load (mut out))) `(reader-config))))
