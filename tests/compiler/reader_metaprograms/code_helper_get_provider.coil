(module reader.fixture.code-helper-get.reader)
(import "coil.primitive" :as primitive)

; A reader context remains invocation-time Code when it crosses a typed helper.
; Definition-time staging used to call this helper with the syntax symbol `context`,
; so code-nth rejected it as a scalar before the provider ever ran.
(defn context-source [(context Code)] (-> Code)
  (primitive/code-nth context 2))

(defn read-source [(context Code)] (-> Code)
  (let [source (primitive/code-str (context-source context))
        main-name (primitive/datum->syntax context "main")]
    `(do
       (defn ~main-name [] (-> i64)
         (if (= ~source "answer = forty-two\n") 42 1)))))
