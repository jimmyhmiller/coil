(module reader.fixture.bf-collide-live)

;; Liveness check for `bf_collide.coil`: the probe really does inject `cells`,
;; `dp` and `cell` into the target module, so the Brainfuck program surviving it
;; is evidence rather than a no-op. 111 + 222 + 333 - 624 = 42.
(defn main [] (-> i64)
  (- (+ cells (+ dp cell)) 624))
