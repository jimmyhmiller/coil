(module reader.fixture.bf-collide)

(import "coil.primitive" :as primitive)

;; The Brainfuck acceptance probe (docs/design/FULL_HYGIENE_MIGRATION.md): inject
;; declarations that PRINT exactly like the reader's machine state into the very
;; module the reader emitted. `cells`, `dp` and `cell` are the reader's own
;; identifiers; if any of them were bare names, these consts would collide with
;; them and the generated program would change meaning or stop compiling.
;;
;; A before-expand transform, so the consts are present before the reader output
;; is expanded and resolved.
; hygiene: the probe deliberately publishes colliding spellings into the target module.
(defn collide-forms [(m Code)] (-> Code)
  `((const ~(primitive/datum->syntax (primitive/code-nth m 0) "cells") 111)
    (const ~(primitive/datum->syntax (primitive/code-nth m 0) "dp") 222)
    (const ~(primitive/datum->syntax (primitive/code-nth m 0) "cell") 333)))

;; A before-expand transform runs to a fixpoint, so injection has to be
;; idempotent or it never converges. The marker value is the probe's own 111.
(defn already? [(m Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      false
    (let [f (primitive/code-nth m i)]
      (if (and (primitive/code-list? f)
               (and (= (primitive/code-count f) (cast i64 3))
                    (and (primitive/code-eq (primitive/code-nth f 0) `const)
                         (primitive/code-eq (primitive/code-nth f 2) `111))))
          true
        (already? m (primitive/iadd i 1) n)))))

(defn rewrite-module [(m Code)] (-> Code)
  (if (and (primitive/code-from-user? (primitive/code-nth m 1))
           (not (already? m 1 (primitive/code-count m))))
      `(~(primitive/code-nth m 0)
        ~@(collide-forms m)
        ~@(primitive/code-rest m))
    m))

(defn rewrite-modules [(ms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
    `(~(rewrite-module (primitive/code-nth ms i))
      ~@(rewrite-modules ms (primitive/iadd i 1) n))))

(defn inject-collisions [(modules Code)] (-> Code)
  `(do ~@(rewrite-modules modules 0 (primitive/code-count modules))))

(transform inject-collisions :phase before-expand)
