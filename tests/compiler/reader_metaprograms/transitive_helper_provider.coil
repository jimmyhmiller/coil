(module reader.fixture.transitive-helper)
(import "coil.primitive" :as primitive)
(import "reader.fixture.transitive-helper-impl" :as impl)

(reader-provider "reader.fixture.transitive-helper" read-source)

(defn read-source [(context Code)] (-> Code)
  (let [source (primitive/code-str (primitive/code-nth context 2))
        main-name (primitive/datum->syntax context "main")]
    (if (= source "answer = forty-two\n")
        (let [answer (impl/read-through-library)]
          `(do
             (defn ~main-name [] (-> i64)
               ~answer)))
        (primitive/error "transitive reader fixture got unexpected source"))))
