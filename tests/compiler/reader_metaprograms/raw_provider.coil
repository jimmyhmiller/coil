(module reader.fixture.raw)
(import "coil.primitive" :as primitive)

(reader-provider "reader.fixture.raw" read-source)

(defn read-source [(context Code)] (-> Code)
  (if (primitive/code-eq (primitive/code-nth context 2) `"answer = forty-two\n")
      `(do (defn main [] (-> i64) 42))
      (primitive/error "raw reader fixture did not receive the target source")))
