(module reader_config_hygiene_binder)
(import "coil.primitive" :as primitive)

;; The `x` introduced by this template must not capture the source `x` passed
;; through the configurable-reader use site.
(defn wrap [(body Code)] (-> Code)
  `(let [x 1] ,body))

(defn main [] (-> i64)
  (let [x 42]
    (wrap x)))
