(module reader.fixture.fs)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.fs" :as fs)
(import "coil.os" :as os)
(import "coil.str" :as str)

(reader-provider "reader.fixture.fs" read-source)

(defn read-source [(context Code)] (-> Code)
  (let [a (alloc/malloc-allocator)
        path (primitive/code-str (primitive/code-nth context 1))]
    (match (fs/read-file a path)
      (Ok [source]
          ; the gate names the output file, inside its own temporary directory
          (match (fs/write-file a (str/cstr->str (os/getenv c"COIL_READER_FS_OUT")) source)
            (Ok [_]
                `(defn main [] (-> i64)
                   42))
            (Err [_] (primitive/error "reader fixture: write failed"))))
      (Err [_] (primitive/error "reader fixture: read failed")))))
