(module reader.fixture.code-helper-return.reader)
(import "coil.primitive" :as primitive)

; Helper-returned Code is a runtime metaprogram value. It must not be spliced into
; the provider body's let expression by the definition-time expansion tower.
(defn make-rules [] (-> Code)
  `(defn rules [] (-> i64)
     0))

(defn read-source [(context Code)] (-> Code)
  (let [rules (make-rules)
        main-name (primitive/datum->syntax context "main")]
    (if (= (primitive/code-count rules) 0)
        (primitive/error "missing helper-returned Code")
        `(do
           (defn ~main-name [] (-> i64)
             42)))))
