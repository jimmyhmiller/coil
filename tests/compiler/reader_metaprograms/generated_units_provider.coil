(module reader.fixture.generated-units)
(import "coil.meta" :as meta)
(import "coil.primitive" :as primitive)

(defn read-source [(context Code)] (-> Code)
  (do
    (meta/generated-unit! "generated.answer"
                          "(module generated.answer)\n(extern generated_answer :cc c [] (-> i64))\n(export generated_answer)\n"
                          "(module generated.answer)\n(defn generated_answer [] (-> i64) 21)\n")
    (meta/generated-unit! "generated.twice"
                          "(module generated.twice)\n(extern generated_twice :cc c [] (-> i64))\n(export generated_twice)\n"
                          "(module generated.twice)\n(import \"generated.answer\" :as answer)\n(defn generated_twice [] (-> i64) (* (answer/generated_answer) 2))\n")
    (primitive/code-read "(module generated.facade)\n(import \"generated.twice\" :as twice)\n(defn main [] (-> i64) (twice/generated_twice))\n"
                         context)))

(reader-provider "reader.fixture.generated-units" read-source)
