(module binding-ownership)
(import "coil.primitive" :as primitive)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (drops) (+ (load (drops)) 1))))

(defn inspect [] (-> i64)
  (let [(as owner (Owner :value value)) (Owner :value 42)] value))

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [value (inspect)]
    (if (= value 42) (- (load (drops)) 1) 2)))
