(module binding-anonymous)
(import "coil.primitive" :as primitive)

(defstruct Point [(x i64) (y i64)])

(defn main [] (-> i64)
  (let [sum (: (fn [[x y]] (+ x y)) (fnptr c [(slice i64)] i64))
        product (: (fn [(Point :x x :y y)] (* x y)) (fnptr c [(ptr Point)] i64))
        pair [10 20]
        p (primitive/alloc-stack Point)]
    (primitive/store! p (Point :x 3 :y 4))
    (- (+ (sum pair) (product p)) 42)))
