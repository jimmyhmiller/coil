(defstruct Point [(x i64) (y i64)])

(defstruct Rect [(origin Point) (dimensions (array i64 3))])

(defstruct Pair [A B] [(first A) (second B)])

(defn shifted [((as point (Point :x x :y y)) Point)
               ([dx dy :as delta] (slice i64))] (-> i64)
  (+ (+ x dx) (+ y dy)))

(defn main [] (-> i64)
  (let [rect
          (Rect
            :origin (Point :x 10 :y 20)
            :dimensions [3 4 5])
        (Rect
          :origin (Point :x x :y y)
          :dimensions [w h & tail])
          rect
        pair (Pair [i64 bool] :first 7 :second true)
        ((Pair i64 bool) :first n :second enabled) pair
        answer (shifted :delta [1 2] :point (.origin rect))]
    (if enabled (- (+ (+ (+ x y) (+ w h)) (+ (get tail 0) n)) 49) 1)))
