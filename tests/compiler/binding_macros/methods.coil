(module binding-methods)

(defstruct Point [(x i64) (y i64)])

(deftrait Sum [Self]
  (sum [(self Self)] (-> i64)))

(impl Sum Point
  (sum [((Point :x x :y y) Point)] (-> i64) (+ x y)))

(impl Point (offset [(point Point) ([dx dy] (slice i64))]
                    (-> i64)
                    (+ (sum point) (+ dx dy))))

(defn main [] (-> i64)
  (let [p (Point :x 10 :y 20)
        delta [5 7]]
    (- (Point::offset p delta) 42)))
