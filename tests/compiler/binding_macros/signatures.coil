(module binding-signatures)
(import "coil.primitive" :as p)

(defn first [(T Copy)] [([x & _] (slice T))] (-> T)
  x)

(defn annotated :inline (Always) [([x y] (slice i64))] (-> i64)
  (+ x y))

(defn ignored [(_ i64) (value i64)] (-> i64)
  value)

(defn code-pair [([left right] Code)] (-> Code)
  `(+ ~left ~right))

(defn main [] (-> i64)
  (let [pair [19 23]]
    (- (+ (first pair) (ignored 1 (annotated pair))) (code-pair [30 31]))))
