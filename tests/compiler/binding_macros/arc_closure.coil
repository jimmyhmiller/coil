(module binding-arc-closure)
(import "coil.closure" :use [defclosure])
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defclosure adder
            [(cell Cell)]
            [([x y] (slice i64))]
            i64
            (+ (.value cell) (+ x y)))

(defn invoke [] (-> i64)
  (let [cell (Cell :value 10)
        f (adder-new cell)
        pair [12 20]]
    (f pair)))

(defn main [] (-> i64)
  (let [answer (invoke)]
    (if (= answer 42) (auto/auto-object-live-count) 1)))
