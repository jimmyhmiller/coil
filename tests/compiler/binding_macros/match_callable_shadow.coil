(module binding-match-callable-shadow)
(import "coil.primitive" :as primitive)

(defsum Callable (Wrap [(f (fnptr c [i64 i64] i64))]))

(defn add [(a i64) (b i64)] (-> i64)
  (+ a b))

(defn invoke [(value Callable)] (-> i64)
  (match value (Wrap [when] (when 20 22))))

(defn introduced [] (-> Code)
  `(let [when (primitive/fnptr-of add)] (when 20 22)))

(defn main [] (-> i64)
  (if (and (= (invoke (Wrap (primitive/fnptr-of add))) 42)
           (= (introduced) 42))
      0
      1))
