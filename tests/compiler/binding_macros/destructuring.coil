(defstruct Point [(x i64) (y i64)])

(defn add-point [((Point :x x :y y) Point)] (-> i64)
  (+ x y))

(defn add-pair [([x y] (slice i64))] (-> i64)
  (+ x y))

(defn main [] (-> i64)
  (let [p (Point :x 19 :y 23)
        (Point :x x :y y) p
        pair [19 23]
        [a b] pair]
    (- (+ (add-point p) (add-pair pair)) (+ (+ x y) 42))))
