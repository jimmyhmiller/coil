(module binding-match-patterns)

(defstruct Point [(x i64) (y i64)])

(defstruct Packet [(point Point) (values (array i64 4))])

(defsum Event
  (Pair [(values (slice i64))])
  (Located [(point Point)])
  (PacketEvent [(packet Packet)])
  (Empty))

(defn score [(event Event)] (-> i64)
  (match event
    (Pair [[left right :as pair]]
          (+ (+ left right) (len pair)))
    (Located [(Point :y vertical :x horizontal)]
             (+ horizontal vertical))
    (PacketEvent [(as packet
                      (Packet
                        :values [first _ & rest]
                        :point (Point :x x :y y)))]
                 (+ (+ (+ first (len rest)) x) (+ y (len (.values packet)))))
    (Empty [] 0)))

(defn main [] (-> i64)
  (let [pair [19 21]
        point (Point :x 20 :y 22)
        values [10 99 7 8]
        packet
          (Packet
            :point (Point :x 9 :y 11)
            :values values)]
    (- (+ (+ (score (Pair pair)) (score (Located point)))
          (score (PacketEvent packet)))
       120)))
