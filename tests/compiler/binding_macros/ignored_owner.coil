(module binding-ignored-owner)
(import "coil.primitive" :as primitive)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (drops) (+ (load (drops)) 1))))

(defstruct Box [(owner Owner) (value i64)])

(defn inspect [] (-> i64)
  (let [(Box :owner _ :value value)
          (Box
            :owner (Owner :value 1)
            :value 42)]
    value))

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [answer (inspect)] (if (= answer 42) (- (load (drops)) 1) 2)))
