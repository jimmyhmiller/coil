; `(mut name)` in a pattern binds a mutable cell holding a copy of its part.
(defstruct Point [(x i64) (y i64)])

(defn shift [((Point :x (mut x) :y y) Point)] (-> i64)
  (set! x (+ x 1))
  (+ x y))

(defn main [] (-> i64)
  (let [pair [19 23]
        [(mut a) b] pair
        p (Point :x 1 :y 2)]
    (set! a (+ a 1))
    ; 20 + 23 + 4, and neither the pair nor the point changed
    (+ (- (+ (+ a b) (shift p)) 47)
       (+ (- (get pair 0) 19) (- (.x p) 1)))))
