(module binding-declaration-bundle)
(import "coil.primitive" :as p)

(defn definitions [(macro-name Code) (helper-name Code)] (-> Code)
  `(do
     (defn ~macro-name [(x Code)] (-> Code)
       (~helper-name x))
     (do
       (defn ~helper-name [(x Code)] (-> Code)
         x))))

(definitions increment increment-code)

(defn main [] (-> i64)
  (- (increment 42) 42))
