(module binding.reload)
(import "coil.jit.reload")
(import "coil.slice" :use [slice-len])

(reloadable-module)

(defstruct Point [(x i64) (y i64)])

(defn sum-point [((Point :x x :y y) Point)] (-> i64)
  (+ x y))

(defn sum-prefix [([a b & rest] (slice i64))] (-> i64)
  (+ (+ a b) (slice-len rest)))

(defn* primitive [(:positional value i64)] (-> i64)
  (+ value 1))

(defn main [] (-> i64)
  (let [point (Point :x 20 :y 22)
        values [20 21 0]]
    (if (and (= (sum-point point) 42)
             (= (sum-prefix values) 42)
             (= (primitive 41) 42))
        0
        1)))
