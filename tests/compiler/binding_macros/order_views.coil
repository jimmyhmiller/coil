(module binding-order-views)
(import "coil.primitive" :as primitive)

(defstruct Point [(x i64) (as i64)])

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn source [] (-> (array i64 3))
  (store! (counter) (+ (load (counter)) 1))
  [10 20 30])

(defn main [] (-> i64)
  (store! (counter) 0)
  (let [[x y & tail :as whole] (source)
        [z & empty] tail
        [] empty
        (Point :as field :x px) (Point :x 2 :as 3)
        x (+ x 1)]
    (if (and (= (load (counter)) 1)
             (and (= (len empty) 0)
                  (and (= (len whole) 3) (= (+ (+ x y) (+ z (+ field px))) 66))))
        0
        1)))
