(module hyglib6)
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)
; A macro that GENERATES an impl. The `=` inside is a BINDER — it names the method
; being defined, not a call — which is the case referential hygiene cannot see,
; because it is handed a head symbol with no enclosing form.
(defstruct P6 [(v i64)])
(derive-eq P6)
