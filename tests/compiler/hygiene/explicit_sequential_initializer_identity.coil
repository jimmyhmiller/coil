(module hygiene.explicit-sequential-initializer-identity)
(import "coil.primitive" :as primitive)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [value (primitive/fresh-identifier "value")
        result (primitive/fresh-identifier "result")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [~value 42
             ~result ~value]
         ~result))))

(meta (generate))
