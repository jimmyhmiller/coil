(module hygiene.definition-site-trait-method)
(import "coil.primitive" :as primitive)

;; The `+` in this template must retain coil.core's trait-method binding even
;; when a use module has unrelated names and the expression crosses a helper.
(defn add-one [(x Code)] (-> Code) `(+ ~x 1))
; hygiene: the fixture's generated main intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64) ~(add-one `41))))
(meta (generate))
