(module hyglib7)
(import "coil.primitive" :as primitive)

; The method form is built by a HELPER template and spliced with ~@ into the impl.
; Its `=` head qualified when the HELPER's list closed — a different template from
; the impl that receives it — so no template-local rule can know it is a binder.
; Only the assembled form at the expansion boundary shows it. The body is the
; control in the other direction: `(seven)` and the inner `=` are REFERENCES
; inside a repaired impl and must STAY the macro module's — the binder strip may
; touch only the method head, not the body.
(defn seven [] (-> i64)
  7)

(defn eq-methods [(tname Code)] (-> Code)
  `((= [(a ~tname) (b ~tname)] (-> bool) (= (seven) 7))))

(defn make-eq-impl [(tname Code)] (-> Code)
  `(impl Eq ~tname ~@(eq-methods tname)))
