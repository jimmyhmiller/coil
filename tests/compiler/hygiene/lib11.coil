(module hyglib11)
(import "coil.primitive" :as primitive)

; A defn sharing a VARIANT's name. Hygiene qualifies the template's pattern head
; (`Ready` resolves to the defn, so it becomes `hyglib11.Ready`) — and that must
; be harmless: the checker strips qualifiers when matching variant names, and
; variant selection is driven by the matched value's TYPE, exactly like impl
; selection. This pins that tolerance down; if pattern matching ever starts
; honoring the module prefix, this repro will say so before a user's macro does.
(defsum Status11 (Ready) (Waiting [(n i64)]))

(defn Ready [] (-> i64)
  1)

(defn check-status [(x Code)] (-> Code)
  `(match ~x
     (Ready [] 111)
     (Waiting [n] n)))
