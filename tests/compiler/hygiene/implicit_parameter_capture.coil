(module hygiene.implicit-parameter-capture)
(import "coil.primitive" :as primitive)

;;; MUST FAIL: `value` in the helper is not the parameter identifier created by
;;; the generator's independently evaluated template.
(defn body [] (-> Code) `value)

; hygiene: only the fixture entry declaration intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
  `(do
     (defn generated [(value i64)] (-> i64) ~(body))
     (defn ~main-name [] (-> i64) (generated 42)))))

(meta (generate))
