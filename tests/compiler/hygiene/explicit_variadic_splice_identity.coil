(module hygiene.explicit-variadic-splice-identity)

(import "coil.primitive" :as primitive)

;; A variadic macro binds a fresh accumulator and folds it together with every
;; caller-supplied form.  The caller binds its own `acc` with the same spelling.
;; Only full hygiene in BOTH directions produces 42:
;;   * the template's `acc` must keep its seed (40), not the caller's 0;
;;   * the caller's spliced `acc` must keep its own 0, not the template's 40.
(defn fold-forms [(acc Code) (forms Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      acc
    `(primitive/iadd ~(fold-forms acc forms (primitive/iadd i 1) n)
                     ~(primitive/code-nth forms i))))

(defn sum-with-acc [(seed Code) & (forms Code)] (-> Code)
  (let [acc (primitive/fresh-identifier "acc")]
    `(let [~acc ~seed]
       ~(fold-forms acc forms 0 (primitive/code-count forms)))))

(defn main [] (-> i64)
  (let [acc 0]
    (sum-with-acc 40 acc 2)))
