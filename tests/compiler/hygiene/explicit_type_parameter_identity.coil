(module hygiene.explicit-type-parameter-identity)
(import "coil.primitive" :as primitive)

(defn helper-type [(T Code)] (-> Code)
  T)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [T (primitive/fresh-identifier "T")
        generated (primitive/fresh-identifier "generated")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(do
       (defn ~generated [~T] [(x ~(helper-type T))] (-> ~(helper-type T))
         x)
       (defn ~main-name [] (-> i64)
         (~generated [i64] 42)))))

(meta (generate))
