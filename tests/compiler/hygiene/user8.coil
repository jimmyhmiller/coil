(module hyguser8)
(import "coil.primitive" :as primitive)
(import "hyglib8" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)
(defstruct P8 [(v i64)])
(make-area-impl P8 42)
; a competing local trait with the same method name — the macro's reference must
; still mean hyglib8's trait, so this prints 42, not 999 or an ambiguity error
(deftrait Area8b [Self] (area8 [(s Self)] (-> i64)))
(impl Area8b i64 (area8 [(s i64)] (-> i64) 999))
(defn main [] (-> i64)
  (let [p (primitive/alloc-stack P8)]
    (print-int (stdout) (use-area (load p))))
  (print-str (stdout) "\n")
  0)
