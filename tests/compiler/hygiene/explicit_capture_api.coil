(module hygiene.explicit-capture-api)
(import "coil.primitive" :as primitive)

;; The conspicuous escape hatch imports the caller identifier's context. Merely
;; constructing another symbol with display spelling "target" must not do this.
; hygiene: this fixture deliberately imports the prototype's binding context.
(defn capture-target [(prototype Code)] (-> Code)
  (primitive/datum->syntax prototype "target"))

(defn main [] (-> i64)
  (let [target 42]
    (capture-target target)))
