(module hyguser12)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)
; The ARITY-DIRECTED FALLBACK. `:use *` of coil.io puts the 3-arg POSIX extern
; `read` in bare scope, so the resolver qualifies this module's `(read c)` to
; `coil.io.read` — which cannot take one argument. Instead of the old hard
; error, the call falls back to the in-scope trait method, because the method's
; arity fits where the function's cannot. The function still wins whenever its
; arity fits (coil.io's own 3-arg `read` calls are untouched), so only calls
; that were errors gained a meaning. When NEITHER arity fits, the error names
; both candidates and suggests the explicit `Read::read` spelling.
(deftrait Read [Self] (read [(self (ptr Self))] (-> i64)))
(defstruct Cell12 [(v i64)])
(impl Read Cell12 (read [(self (ptr Cell12))] (-> i64) (load (field self v))))
(defn main [] (-> i64)
  (let [c (alloc/stack Cell12)]
    (store! (field c v) 5)
    (print-int (stdout) (read c))
    (print-str (stdout) "\n")
    0))
