(module hyglib9)
(import "coil.primitive" :as primitive)

; `size9` is an ORDINARY defn here, so template hygiene qualified that head even
; BEFORE trait methods joined the table — a generated trait declaring the same
; name was broken all along. In the generated deftrait and impl the name is a
; BINDER: this pair discriminates the boundary repair for GENERATED TRAITS.
(defn size9 [(x i64)] (-> i64)
  x)

(defn make-sized [(tname Code) (n Code)] (-> Code)
  `(do
     (deftrait Sized9 [Self] (size9 [(s Self)] (-> i64)))
     (impl Sized9 ~tname (size9 [(s ~tname)] (-> i64) ~n))))
