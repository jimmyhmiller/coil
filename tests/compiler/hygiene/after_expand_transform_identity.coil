(module hygiene.after-expand-transform-identity)
(import "coil.primitive" :as primitive)

;; The macro call is gone before the transform runs. Its expansion deliberately
;; leaves syntax that ordinary resolution cannot accept; the after-expand phase
;; rewrites that syntax once, before semantic checking, without a second macro
;; expansion pass.
(defn emit-post-marker [(value Code)] (-> Code)
  `(post-marker ~value))

(defn marker-head? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (primitive/icmp-gt (primitive/code-count form) 0)
            (primitive/code-eq (primitive/code-nth form 0) `post-marker))))

(defn has-marker? [(form Code)] (-> bool)
  (if (primitive/code-list? form)
      (if (marker-head? form) true (has-marker-kids? form 0 (primitive/code-count form)))
      false))

(defn has-marker-kids? [(form Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      false
      (if (has-marker? (primitive/code-nth form i))
          true
          (has-marker-kids? form (primitive/iadd i 1) n))))

(defn rewrite [(form Code)] (-> Code)
  (if (primitive/code-list? form)
      (if (marker-head? form)
          `(primitive/isub ~(primitive/code-nth form 1) 1000)
          (if (has-marker? form)
              `(~@(rewrite-kids form 0 (primitive/code-count form)))
              form))
      form))

(defn rewrite-kids [(form Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
      `(~(rewrite (primitive/code-nth form i)) ~@(rewrite-kids form (primitive/iadd i 1) n))))

(defn post-pass [(modules Code)] (-> Code)
  `(do ~@(rewrite-kids modules 0 (primitive/code-count modules))))

(transform post-pass :phase after-expand)

(defn main [] (-> i64)
  (let [value 1042]
    (emit-post-marker value)))
