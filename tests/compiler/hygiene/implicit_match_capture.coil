(module hygiene.implicit-match-capture)
(import "coil.primitive" :as primitive)

(defn arm-body [] (-> Code) `value)

; hygiene: only the fixture entry declaration intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (match (Some 42)
         (Some [value] ~(arm-body))
         (None [] 0)))))

(meta (generate))
