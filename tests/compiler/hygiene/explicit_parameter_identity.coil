(module hygiene.explicit-parameter-identity)
(import "coil.primitive" :as primitive)

(defn body [(value Code)] (-> Code)
  value)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [value (primitive/fresh-identifier "value")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(do
       (defn generated [(~value i64)] (-> i64)
         ~(body value))
       (defn ~main-name [] (-> i64)
         (generated 42)))))

(meta (generate))
