(module hyguser11)
(import "hyglib11" :use *)
(import "coil.io" :use *)
(import "coil.primitive" :as primitive)
; `zeroed` builds the first variant (Ready) without naming it — the bare name
; `Ready` in this module is ambiguous between the imported defn and the variant,
; which is the collision under test, not the thing being tested.
(defn main [] (-> i64)
  (let [s (Waiting 7)
        r (primitive/zeroed Status11)]
    (print-int (stdout) (check-status s))
    (print-str (stdout) " ")
    (print-int (stdout) (check-status r))
    (print-str (stdout) "\n")
    0))
