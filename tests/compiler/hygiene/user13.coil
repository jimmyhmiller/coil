(module hyguser13)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)

; MUST NOT COMPILE. The arity-directed fallback applies only to spellings the
; RESOLVER qualified (recorded per call node in resolve's implicit-qualification
; map): here the module qualification is hand-written, so the user named the
; extern explicitly and the wrong arity stays a hard error —
;   "'coil.io.read' expects 3 args, got 1; trait 'hyguser13.Read' also
;    declares 'read' — write Read::read to call it"
; The same holds for the alias spelling `(io/read c)` under an `:as io` import.
; Compare user12, where the SAME call written bare falls back to the method.
(deftrait Read [Self] (read [(self (ptr Self))] (-> i64)))

(defstruct Cell13 [(v i64)])

(impl Read Cell13 (read [(self (ptr Cell13))] (-> i64) (load (field self v))))

(defn main [] (-> i64)
  (let [c (primitive/alloc-stack Cell13)]
    (store! (field c v) 5)
    (print-int (stdout) (coil.io.read c))
    (print-str (stdout) "\n")
    0))
