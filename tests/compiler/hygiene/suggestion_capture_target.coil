(module hygiene.suggestion-capture-target)
(import "coil.primitive" :as primitive)

;;; 41 * 1 + 1 = 42, before AND after `coil lint --fix` applies the suggestion in
;;; `suggestion_capture_rule.coil`.  A rewrite that let the rule's `tmp` capture
;;; this one returns 2.
(defn main [] (-> i64)
  (let [tmp 41]
    (primitive/iadd (primitive/imul tmp 1) 1)))
