(module hyguser7)
(import "hyglib7" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)
(defstruct P7 [(v i64)])
; capture bait for the method BODY's `(seven)` reference
(defn seven [] (-> i64) 999)
(make-eq-impl P7)
; Must compile (the spliced `=` binder is re-bared) AND print 1 (the body's
; `seven` stays hyglib7's — capture would compare 999 to 7 and print 0).
(defn main [] (-> i64)
  (let [a (alloc/stack P7)
        b (alloc/stack P7)]
    (print-int (stdout) (if (= (load a) (load b)) 1 0)))
  (print-str (stdout) "\n")
  0)
