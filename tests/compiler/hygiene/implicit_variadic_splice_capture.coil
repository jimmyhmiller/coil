(module hygiene.implicit-variadic-splice-capture)

(import "coil.primitive" :as primitive)

;; This fixture MUST FAIL.  The variadic macro binds a fresh `acc`; the caller
;; splices a form that merely spells `acc` and never binds it.  Splicing must
;; transport the caller's syntax unchanged, so the template binder cannot
;; capture it.
(defn sum-with-acc [(seed Code) & (forms Code)] (-> Code)
  (let [acc (primitive/fresh-identifier "acc")]
    `(let [~acc ~seed]
       (primitive/iadd ~acc ~(primitive/code-nth forms 0)))))

(defn main [] (-> i64)
  (sum-with-acc 40 acc))
