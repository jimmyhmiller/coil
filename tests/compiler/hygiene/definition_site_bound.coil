(module hygiene.definition-site-bound)

(import "hygiene.definition-site-bound-provider" :as h)

;; This module cannot see `Marker` at all -- it is not exported, and nothing here
;; imports it. The generated bound still resolves; exits 42.
(h/mkbound use-marker)

(defn main [] (-> i64)
  (use-marker (h/P :n 0)))
