(module hygiene.definition-site-type-provider)

(import "coil.alloc" :as alloc :use *)
(import "hygiene.definition-site-type-tag" :as tg)

(export Box mk-box)

(defstruct Box [(n i64)])

;; Two of the four spellings a template can use for a type: `Box` bare, and
;; `tg/Tag` through this module's own alias. Both have to resolve where the
;; template was WRITTEN, exactly as a bare function name already did.
(defn mk-box [(name Code)] (-> Code)
  `(defn ~name [] (-> Box)
     (let [t (alloc/stack tg/Tag)
           b (alloc/stack Box)]
       (set! (.v t) 42)
       (set! (.n b) (.v t))
       (load b))))
