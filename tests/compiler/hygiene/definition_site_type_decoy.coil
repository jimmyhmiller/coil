(module hygiene.definition-site-type-decoy)

(export Box Tag)

;;; Both spellings the provider's template uses, in the caller's scope: `Box` bare
;;; and `Tag` under the same alias the provider uses. Neither has the field the
;;; template writes, so resolving to either of these cannot compile -- "it
;;; happened to work" and "it resolved correctly" give different answers.
(defstruct Box [(other i64)])

(defstruct Tag [(other i64)])
