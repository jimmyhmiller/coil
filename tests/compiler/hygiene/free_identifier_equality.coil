(module hygiene.free-identifier-equality)
(import "coil.primitive" :as primitive)

; Separate template evaluations allocate different introduction scopes, but a
; free identifier with the same spelling and definition module denotes the same
; global binding. Bound identity remains exact.
(defn left [] (-> Code)
  `helper-global)

(defn right [] (-> Code)
  `helper-global)

; hygiene: this API fixture explicitly derives context and exposes its generated main.
(defn generate [] (-> Code)
  (let [a (left)
        b (right)
        x (primitive/fresh-identifier "local")
        x-again (primitive/datum->syntax x "local")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    (if (and (primitive/free-identifier=? a b)
             (and (not (primitive/bound-identifier=? a b))
                  (and (primitive/free-identifier=? x x-again)
                       (primitive/bound-identifier=? x x-again))))
        `(defn ~main-name [] (-> i64)
           42)
        (primitive/error "free/bound identifier equality invariant failed"))))

(meta (generate))
