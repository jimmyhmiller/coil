(module hygiene.code-symbol-is-not-identifier)

(import "coil.primitive" :as primitive)

; `code-symbol` constructs unscoped name data. Reusing the object must not make
; it a binder/reference protocol; choose fresh-identifier or an explicit context
; conversion instead.
; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [x (primitive/code-symbol "temporary")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [~x 42] ~x))))

(meta (generate))
