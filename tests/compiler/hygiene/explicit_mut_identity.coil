(module hygiene.explicit-mut-identity)
(import "coil.primitive" :as primitive)

(defn caller-reference [(state Code)] (-> Code)
  state)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [state (primitive/fresh-identifier "state")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [(mut ~state) 41]
         (do (store! ~state 42) ~(caller-reference state))))))

(meta (generate))
