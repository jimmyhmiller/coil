(module hygiene.definition-site-bound-provider)

;; `Marker` is deliberately NOT exported. A template naming it in a generic BOUND
;; has to resolve where the template was written, the same way a bare function
;; name already did -- this was the last spelling that still resolved at the call
;; site, where the caller has never heard of it.
(export P mkbound)

(deftrait Marker [Self] (mark [(s Self)] (-> i64)))

(defstruct P [(n i64)])

(impl Marker P (mark [(s P)] (-> i64) 42))

(defn mkbound [(name Code)] (-> Code)
  `(defn ~name [(T Marker)] [(x T)] (-> i64)
     (mark x)))
