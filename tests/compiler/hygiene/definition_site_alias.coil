(module hygiene.definition-site-alias)
(import "coil.primitive" :as primitive)
(import "hygiene.definition-site-alias-provider" :use [aliased-len])

;; The caller binds `st` to a DIFFERENT module that exports `str-len` too. The
;; template's `st/str-len` must still mean `coil.str`'s: 5 + 37 = 42.
;; Resolving against this call site would give 999.
(import "hygiene.definition-site-alias-decoy" :as st)

;;; One value encodes both halves. The template's `st/str-len` must be
;;; `coil.str`'s (5) and this module's `st/str-len` must be the decoy's (999):
;;; 5 + (999 - 962) = 42. Resolving the template at the call site gives 1036, and
;;; a decoy that stopped being in scope does not compile -- so the fixture cannot
;;; pass for the wrong reason.
(defn main [] (-> i64)
  (primitive/iadd (aliased-len "hello")
                  (primitive/isub (st/str-len "x") 962)))
