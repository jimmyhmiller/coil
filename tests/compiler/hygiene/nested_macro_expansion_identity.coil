(module hygiene.nested-macro-expansion-identity)
(import "coil.primitive" :as primitive)

;;; Nested expansion: `outer`'s template binds `tmp` AND calls `inner`, whose own
;;; template binds `tmp` again, while the caller has a third `tmp`.  `inner` is a
;;; definition-site free reference inside `outer`'s template, so the nested
;;; expansion happens in this module's scope, not the caller's.
;;;
;;; caller tmp = 1035, outer tmp = 7, inner tmp = 1000
;;;   (1035 + 7) - 1000 = 42
;;; Any of the three capturing another changes the answer.
(defn inner [(e Code)] (-> Code)
  `(let [tmp 1000]
     (primitive/isub ~e tmp)))

(defn outer [(e Code)] (-> Code)
  `(let [tmp 7]
     (inner (primitive/iadd ~e tmp))))

(defn main [] (-> i64)
  (let [tmp 1035]
    (outer tmp)))
