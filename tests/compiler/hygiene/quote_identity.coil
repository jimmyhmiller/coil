(module hygiene.quote-identity)

(import "coil.primitive" :as primitive)

;;; Plain `quote` is metaprogram-authored syntax exactly as a quasiquote literal
;;; is, and carries the same lexical identity. One quoted identifier, created once
;;; and reused for a binder and its reference, binds to itself — and leaves the
;;; caller's equally spelled `tmp` alone: 1042 - 1000 = 42.
;;;
;;; Before this rule, `'name` aliased the registry node in the SOURCE scope and
;;; bound by spelling, so this program returned 0: the template's binder had
;;; captured the caller's `tmp`.
(defn wrap [(e Code)] (-> Code)
  (let [id 'tmp]
    `(let [~id 1000]
       (primitive/isub ~e ~id))))

(defn main [] (-> i64)
  (let [tmp 1042]
    (wrap tmp)))
