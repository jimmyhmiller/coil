(module hygiene.identity-transport)

(import "coil.primitive" :as primitive)

;; One syntax object must retain its identifier identity through every ordinary
;; Code container operation.  The generated program has one binder and eight
;; references transported by distinct paths; it returns 42 only if all eight
;; still resolve to that binder.
(defn helper [(x Code)] (-> Code) x)

(defn nested-helper [(x Code)] (-> Code)
  (helper (helper x)))

(defn generate [] (-> Code)
  (let [x (primitive/fresh-identifier "transported")
        direct (helper x)
        nested (nested-helper x)
        singleton `(~x)
        spliced (primitive/code-nth `(~@singleton) 0)
        builder (primitive/code-list-new)
        ignored (primitive/code-list-push! builder x)
        built (primitive/code-list-done builder)
        from-builder (primitive/code-nth built 0)
        viewed (primitive/code-nth (primitive/code-slice singleton 0 1) 0)
        copied (primitive/code-copy x)
        concatenated (primitive/code-nth (primitive/code-concat `() singleton) 0)
        (mut iterator) (iter singleton)
        iterated (match (next (mut iterator))
                   (Some [item] item)
                   (None [] (primitive/error "Code iterator ended early")))
        ; hygiene: the generated fixture deliberately publishes the executable entry name.
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [~x 5]
         (primitive/iadd 2
           (primitive/iadd
             (primitive/iadd ~direct ~nested)
             (primitive/iadd
               (primitive/iadd ~spliced ~from-builder)
               (primitive/iadd ~viewed
                 (primitive/iadd ~copied
                   (primitive/iadd ~concatenated ~iterated))))))))))

(meta (generate))
