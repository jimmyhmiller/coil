(module hyguser9)
(import "coil.primitive" :as primitive)
(import "hyglib9" :as h9)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)
(defstruct P9 [(v i64)])
(h9/make-sized P9 21)
; The generated trait must declare `size9`, not `hyglib9.size9` — the aliased
; import keeps hyglib9's defn out of bare scope, so this call can only mean the
; generated trait's method.
(defn main [] (-> i64)
  (let [p (primitive/alloc-stack P9)]
    (print-int (stdout) (size9 (load p))))
  (print-str (stdout) "\n")
  0)
