(module hygiene.semantic-transform-identity)

(import "coil.primitive" :as primitive)

;;; A semantic `(transform …)` runs after expansion and re-runs to a fixpoint, so
;;; its templates are re-read by the resolver on every round.  The `tmp` it
;;; introduces stays its own across all of them, and the `tmp` it transports out
;;; of the user's `(sem-marker …)` stays the user's.  1042 - 1000 = 42.
(defn marker-head? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (primitive/icmp-gt (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) `sem-marker))))

(defn has-marker? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (marker-head? f) true (has-marker-kids? f 0 (primitive/code-count f)))
    false))

(defn has-marker-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (primitive/icmp-ge i n)
      false
    (if (has-marker? (primitive/code-nth f i))
        true
      (has-marker-kids? f (primitive/iadd i 1) n))))

;;; Untouched subtrees are returned by identity, so only the rewritten region is
;;; rebuilt — the same discipline `tests/metaprogramming/safe_dialect.coil` uses.
(defn rewrite [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (marker-head? f)
          `(let [tmp 1000]
             (primitive/isub ~(rewrite (primitive/code-nth f 1)) tmp))
        (if (has-marker? f)
            `(~@(rewrite-kids f 0 (primitive/code-count f)))
          f))
    f))

(defn rewrite-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (primitive/icmp-ge i n)
      `()
    `(~(rewrite (primitive/code-nth f i))
      ~@(rewrite-kids f (primitive/iadd i 1) n))))

(defn surface-pass [(modules Code)] (-> Code)
  `(do ~@(rewrite-kids modules 0 (primitive/code-count modules))))

(transform surface-pass)

(defn main [] (-> i64)
  (let [tmp 1042]
    (sem-marker tmp)))
