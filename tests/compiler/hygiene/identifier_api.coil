(module hygiene.identifier-api)

(import "coil.primitive" :as primitive)

; hygiene: this API fixture explicitly derives/removes context and exposes its generated main.
(defn generate [] (-> Code)
  (let [x (primitive/fresh-identifier "value")
        y (primitive/fresh-identifier "value")
        same (primitive/datum->syntax x "value")
        bare (primitive/syntax->datum x)
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    (if (and (primitive/bound-identifier=? x same)
             (and (not (primitive/bound-identifier=? x y))
                  (not (primitive/bound-identifier=? x bare))))
        `(defn ~main-name [] (-> i64) (let [~x 42] ~same))
        (primitive/error "identifier API equality invariant failed"))))

(meta (generate))
