(module hyglib8)
(import "coil.primitive" :as primitive)

; A LIBRARY trait (not coil.core's): the template's `area8` is a BINDER in the
; generated impl and a REFERENCE in use-area. Trait methods sit in this module's
; hygiene table, so both spellings qualify at expansion — the binder must come
; back bare, the reference must not.
(deftrait Area8 [Self] (area8 [(s Self)] (-> i64)))

(defn make-area-impl [(tname Code) (n Code)] (-> Code)
  `(impl Area8 ~tname (area8 [(s ~tname)] (-> i64) ~n)))

(defn use-area [(x Code)] (-> Code)
  `(area8 ~x))
