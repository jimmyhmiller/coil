(module hyguser10)
(import "coil.primitive" :as primitive)
(import "coil.io" :as io)
(import "coil.alloc" :as alloc :use *)
; A user trait may reuse the NAME of a stdlib extern. coil.io's own call to the
; POSIX `read` (resolver-qualified to `coil.io.read`) must remain a FUNCTION
; call: a dotted head that names a real defn/extern is a resolver-qualified
; reference, and only a dotted head that names nothing can be a
; hygiene-qualified trait method. The first attempt's check change skipped that
; guard, hijacked `coil.io.read` into this trait, and every program linking
; coil.io stopped compiling with "'read' expects 1 args, got 3".
; (coil.io is imported :as io so the extern stays out of bare scope — a bare
; `read` next to a `:use *` io import meaning the extern is pre-existing
; behavior this repro does not test.)
(deftrait Read [Self] (read [(self (ptr Self))] (-> i64)))
(defstruct Cell10 [(v i64)])
(impl Read Cell10 (read [(self (ptr Cell10))] (-> i64) (load (field self v))))
(defn main [] (-> i64)
  (let [c (primitive/alloc-stack Cell10)]
    (set! (.v c) 5)
    (io/print-int (io/stdout) (read c))
    (io/print-str (io/stdout) "\n")
    0))
