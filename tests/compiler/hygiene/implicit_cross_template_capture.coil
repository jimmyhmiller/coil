(module hygiene.implicit-cross-template-capture)

(import "coil.primitive" :as primitive)

;;; This fixture MUST FAIL under full hygiene. The `state` reference was created
;;; by a different template from the binder and the two syntax objects were never
;;; explicitly connected. Equal display spelling must not establish identity.
(defn operation [] (-> Code)
  `(primitive/iadd state 1))

; hygiene: only the fixture entry declaration intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [state 41]
         ~(operation)))))

(meta (generate))
