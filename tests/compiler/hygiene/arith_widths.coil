(module arith-widths)
(import "coil.io" :use *)

;;; BASELINE probe for the slot2 x slot3 interaction:
;;; slot 3 adds ~80 same-named trait impls (Add/Sub/... for all 8 int widths
;;; + f32); slot 2 adds an arity-directed fallback for fn/trait-method name
;;; collisions. Unconstrained integer literals must keep defaulting to i64
;;; rather than going ambiguous -- at a CALL SITE and inside a MACRO TEMPLATE,
;;; which is where hygiene resolves in a different namespace.
(defn plus-in-template [] (-> Code)
  `(+ 1 2))

(defn cmp-in-template [] (-> Code)
  `(if (< 1 2) 10 20))

(defn main [] (-> i64)
  (print-int (stdout) (+ 1 2))
  (print-str (stdout) " ")
  (print-int (stdout) (plus-in-template))
  (print-str (stdout) " ")
  (print-int (stdout) (cmp-in-template))
  (print-str (stdout) "\n")
  0)
