(module hygiene.quote-capture)

(import "coil.primitive" :as primitive)

;;; MUST FAIL. Two INDEPENDENT evaluations of `'hidden` are two introductions, not
;;; one identifier — equal display spelling is not a binding relationship, and
;;; `quote` gets no exemption from that just because it is cheaper than a
;;; quasiquote. Reuse one object (see `quote_identity.coil`) to connect them.
(defn binder [] (-> Code) 'hidden)
(defn reference [] (-> Code) 'hidden)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [~(binder) 42] ~(reference)))))

(meta (generate))
