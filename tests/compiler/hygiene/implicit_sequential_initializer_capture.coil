(module hygiene.implicit-sequential-initializer-capture)
(import "coil.primitive" :as primitive)

;;; MUST FAIL: even though the second initializer is textually after the first
;;; binder, transported syntax with equal spelling does not acquire its scope.
(defn caller-reference [] (-> Code)
  `value)

; hygiene: only the fixture entry declaration intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [value 42
             result ~(caller-reference)]
         result))))

(meta (generate))
