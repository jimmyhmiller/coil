(module hygiene.suggestion-capture-rule)

(import "coil.primitive" :as primitive)

;; A checker suggestion is the one metaprogram boundary whose output becomes
;; SOURCE TEXT, and source text carries no lexical scope.  This rule proposes a
;; replacement that binds its own identifier around a node transported out of the
;; author's program — the exact shape that captures if the two identities are
;; flattened to one spelling.  The template binder is written literally, without
;; `fresh-identifier`, because the renderer must be correct for the naive rule
;; too, not only for the careful one.
(defn identity-factor? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (= (primitive/code-count f) (cast i64 3))
          (and (primitive/code-eq (primitive/code-nth f 0) `primitive/imul)
               (primitive/code-eq (primitive/code-nth f 2) `1))
        false)
    false))

(defn walk [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (and (primitive/code-from-user? f) (identity-factor? f))
          (primitive/suggest f "name the identity factor"
                             `(let [tmp 1]
                                (primitive/imul ~(primitive/code-nth f 1) tmp)))
        (walk-kids f 0 (primitive/code-count f)))
    `0))

(defn walk-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `0
    (do (walk (primitive/code-nth f i))
        (walk-kids f (primitive/iadd i 1) n))))

(defn name-identity-factors [(modules Code)] (-> Code)
  (walk-kids modules 0 (primitive/code-count modules)))

(checker name-identity-factors)
