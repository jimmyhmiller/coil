(module hyglib5)
(import "coil.primitive" :as primitive)
; A trait declared in the SAME module as the macro. If hygiene now sees trait
; methods, this template's `mine` must qualify to hyglib5.mine.
(deftrait Mine [Self] (mine [(a Self)] (-> i64)))
(impl Mine i64 (mine [(a i64)] (-> i64) 7))
(defn use-mine [(x Code)] (-> Code) `(mine ~x))
