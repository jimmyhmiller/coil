(module hygiene.definition-site-type)
(import "coil.primitive" :as primitive)
(import "hygiene.definition-site-type-provider" :as h)
(import "coil.alloc" :as alloc :use *)

;; A competing `Box` in bare scope, and the provider's own alias `tg` rebound to
;; a module whose `Tag` has no `v` field.
(import "hygiene.definition-site-type-decoy" :use [Box])
(import "hygiene.definition-site-type-decoy" :as tg)

(h/mk-box make-box)

(defn main [] (-> i64)
  ;; Liveness first: in THIS module bare `Box` and `tg/Tag` really are the
  ;; decoys, which have `other` rather than `n`/`v`. These two lines compile only
  ;; while that is true -- without them a decoy that quietly stopped being in
  ;; scope would leave the real check below testing nothing.
  (let [d (primitive/alloc-stack Box)
        dt (primitive/alloc-stack tg/Tag)]
    (set! (.other d) 1)
    (set! (.other dt) 1))
  (let [b (primitive/alloc-stack h/Box)]
    (set! b (make-box))
    (.n b)))
