(module hygiene.implicit-mut-capture)
(import "coil.primitive" :as primitive)

;; MUST FAIL: a caller-provided `state` cannot resolve to the independently
;; introduced mutable binder with the same display spelling.
(defn caller-reference [] (-> Code) `state)
; hygiene: only the fixture entry declaration intentionally enters the executable namespace.
(defn generate [] (-> Code)
  (let [main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [(mut state) 41]
         (do (store! state 42) ~(caller-reference))))))
(meta (generate))
