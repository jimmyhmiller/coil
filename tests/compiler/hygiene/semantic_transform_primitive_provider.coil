(module hygiene.semantic-transform-primitive-provider)

(import "coil.primitive" :as primitive)

(defn primitive-marker-head? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) `primitive-hygiene-marker))))

(defn primitive-marker-present? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (primitive-marker-head? f)
          true
          (primitive-marker-present-kids? f 0 (primitive/code-count f)))
      false))

(defn primitive-marker-present-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (primitive-marker-present? (primitive/code-nth f i))
          true
          (primitive-marker-present-kids? f (+ i 1) n))))

(defn rewrite-primitive-marker [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (primitive-marker-head? f)
          ; These free primitive identifiers belong to THIS provider. The target
          ; deliberately does not bind the `primitive` alias.
          `(primitive/cast i64
             (primitive/iadd (primitive/cast i32 40) (primitive/cast i32 2)))
          (if (primitive-marker-present? f)
              `(~@(rewrite-primitive-marker-kids f 0 (primitive/code-count f)))
              f))
      f))

(defn rewrite-primitive-marker-kids [(f Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(rewrite-primitive-marker (primitive/code-nth f i))
        ~@(rewrite-primitive-marker-kids f (+ i 1) n))))

(defn primitive-hygiene-pass [(modules Code)] (-> Code)
  `(do ~@(rewrite-primitive-marker-kids modules 0 (primitive/code-count modules))))

(transform primitive-hygiene-pass)
