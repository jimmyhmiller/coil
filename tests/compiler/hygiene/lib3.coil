(module hyglib3)
(import "coil.primitive" :as primitive)

; The same macro, but the template writes the PRIMITIVE rather than the trait
; method. A primitive is not a trait method, so use-site resolution cannot
; capture it.
(defn eq-check3 [(x Code) (y Code)] (-> Code)
  `(if (primitive/icmp-eq ~x ~y) 1 0))
