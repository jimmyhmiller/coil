(module hygiene.explicit-match-identity)

(import "coil.primitive" :as primitive)

(defn arm-body [(value Code)] (-> Code) value)

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [value (primitive/fresh-identifier "value")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (match (Some 42)
         (Some [~value] ~(arm-body value))
         (None [] 0)))))

(meta (generate))
