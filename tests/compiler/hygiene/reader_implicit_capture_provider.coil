(module hygiene.reader-implicit-capture-provider)
(import "coil.primitive" :as primitive)

;;; A read-phase version of implicit_cross_template_capture. Reader-provider
;;; output must not receive weaker hygiene than ordinary macro/meta output.
(defn operation [] (-> Code)
  `(primitive/iadd state 1))

; hygiene: a reader provider deliberately derives the entry declaration from its context.
(defn read-source [(context Code)] (-> Code)
  (let [main-name (primitive/datum->syntax context "main")]
    `(do
       (module hygiene.reader-implicit-capture-user)
       (import "coil.primitive" :as primitive)
       (defn ~main-name [] (-> i64)
         (let [state 41]
           ~(operation))))))
