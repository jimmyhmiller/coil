(module hygiene.explicit-cross-template-identity)

(import "coil.primitive" :as primitive)

;; This fixture MUST compile and return 42 under full hygiene. The binding and
;; separately constructed reference reuse one identifier object explicitly.
(defn operation [(state Code)] (-> Code)
  `(primitive/iadd ~state 1))

; hygiene: the fixture's generated main intentionally enters the executable entry namespace.
(defn generate [] (-> Code)
  (let [state (primitive/fresh-identifier "state")
        main-name (primitive/syntax->datum (primitive/fresh-identifier "main"))]
    `(defn ~main-name [] (-> i64)
       (let [~state 41]
         ~(operation state)))))

(meta (generate))
