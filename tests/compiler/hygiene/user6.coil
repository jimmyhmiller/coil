(module hyguser6)
(import "hyglib6" :use *)
(import "coil.io" :use *)
(import "coil.alloc" :as alloc :use *)
; Must compile. Under the reverted fix it failed with
;   "impl coil.core.Eq for hyglib6.P6: missing method '='"
; because the generated impl declared `coil.core.=` while the trait declares `=`.
(defn main [] (-> i64)
  (let [a (alloc/stack P6) b (alloc/stack P6)]
    (print-int (stdout) (if (P6-eq a b) 1 0)))
  0)
