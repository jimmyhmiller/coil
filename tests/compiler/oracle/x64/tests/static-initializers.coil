; tests/compiler/oracle/x64/tests/static-initializers.coil — initialized static
; storage on the direct x86-64 backend. Array literals lower to an initialized
; alloc-static, so every one of these used to stop the backend with
; "initialized alloc-static is not supported".
;
; Exit 0 on success, else the first failing check number.
(module x64-static-initializers)
(import "coil.primitive" :as primitive)

(defstruct P [(x i32) (y i32)])
(defsum Shape (Circle [(r i64)]) (Dot))

(defn radius [(s Shape)] (-> i64) (match s (Circle [r] r) (Dot [] 0)))
(defn seven [] (-> i64) 7)

(defn main [] (-> i64)
  (let [ints [1 2 3]
        bytes [(: 250 u8) 251 252]
        halves [(: 1 i16) -2 3]
        floats [1.5 2.25]
        singles [(: 0.5 f32) 1.5]
        strings ["a" "bcd"]
        shapes [(Circle 5) (Dot)]
        points [(P :x 1 :y 2) (P :x 3 :y 4)]
        fns [(fnptr-of seven)]
        named (primitive/alloc-static i64 41 :as "x64_static_named")]
    (cond (!= (+ (get ints 0) (get ints 2)) 4) 1
          (!= (cast i64 (get bytes 2)) 252) 2
          (!= (cast i64 (get halves 1)) -2) 3
          (not (primitive/fcmp-eq (get floats 1) 2.25)) 4
          (not (primitive/fcmp-eq (cast f64 (get singles 1)) 1.5)) 5
          (!= (len (get strings 1)) 3) 6
          (!= (+ (radius (get shapes 0)) (radius (get shapes 1))) 5) 7
          (!= (cast i64 (.y (get points 1))) 4) 8
          (!= (call-ptr (get fns 0)) 7) 9
          (!= (load named) 41) 10
          :else (do (println "static-initializers: all checks passed") 0))))
