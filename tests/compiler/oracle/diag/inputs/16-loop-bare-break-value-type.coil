(module oracle.16-loop-bare-break-value-type)

; A loop in bool value position cannot exit through a bare break: bare break
; carries Coil's canonical i64 unit value. This used to pass checking and make
; the LLVM backend emit `ret i64` from a function declared to return `i1`.
(defn invalid-loop-result [] (-> bool)
  (loop (if true (break) false)
    true))
