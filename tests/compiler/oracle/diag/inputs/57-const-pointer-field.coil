;; A constant whose value holds a pointer cannot be materialized; the error names
;; the field and type that hold it, at the value.
(module diag57)
(import "coil.primitive" :as primitive)
(defstruct Cell [(n i64) (next (ptr i64))])
(const CELLS [(Cell :n 1 :next (primitive/cast (ptr i64) 0))])
(defn main [] (-> i64) (len CELLS))
