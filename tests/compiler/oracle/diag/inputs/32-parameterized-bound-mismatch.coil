(module negative.parameterized-bound-item-mismatch)

(defstruct BoolIter [(value bool)])

(impl Iterator BoolIter
  (next [(it (mut BoolIter))] (-> (Option bool)) (Some (.value it))))

(defn require-i64 [(I (Iterator i64))] [(source I)] (-> i64)
  (let [(mut it) source]
    (match (next (mut it)) (Some [value] value) (None [] 0))))

(defn main [] (-> i64)
  (require-i64 (BoolIter :value true)))
