;; Two declarations of the same C symbol that disagree in register class. Integer
;; widths may differ between declarations (each call is built against its own
;; module's prototype), but no callee can take `fd` in both an integer and a float
;; register, so this is rejected at declaration.
;;
;; The prelude declares `read` as ssize_t read(int fd=i32, void*, size_t); this one
;; passes fd as a float.
(extern read :cc c [f64 (ptr i8) i64] (-> i64))

(defn go [(fd f64) (buf (ptr i8))] (-> i64)
  (read fd buf 8))

(defn main [] (-> i64)
  0)
