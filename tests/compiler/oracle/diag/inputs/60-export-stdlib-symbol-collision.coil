(module export-stdlib-symbol-collision)

;; `coil.fs` links against libc's mkdir, and an export-c of that symbol defines it
;; for the whole program, so every extern of it (the standard library's included)
;; binds to the definition. That is only sound when the definition is something the
;; extern's own declaration could have called; this one takes its mode as a float.
(import "coil.fs" :use [make-dir])

(defn my-mkdir [(path (ptr i8)) (mode f64)] (-> i32)
  0)

(export-c [my-mkdir :as "mkdir"])

(defn main [] (-> i64)
  (cast i64 (make-dir c"/tmp/x" 493)))
