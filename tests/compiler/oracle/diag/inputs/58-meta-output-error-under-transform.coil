;; A (meta …) whose output does not expand, in a program with a semantic
;; transform: the provisional model check that fails must not leave its
;; half-elaborated forms behind, so the error is the expansion's own, located at
;; the (meta …) form.
(module diag57)
(import "coil.primitive" :as p)
(defn gen [] (-> Code) `(do (defn ~(p/syntax->datum `bad) [] (-> i64) (let [x] 1))))
(meta (gen))
(defn ident [(modules Code)] (-> Code) `(do ~@modules))
(transform ident)
(defn main [] (-> i64) 0)
