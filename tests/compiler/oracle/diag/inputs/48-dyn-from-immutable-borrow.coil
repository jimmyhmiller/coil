(module dyn-from-immutable-borrow)
(deftrait Speak [Self] (speak [(self (ptr Self))] (-> i64)))
(defstruct Dog [(age i64)])
(impl Speak Dog (speak [(self (ptr Dog))] (-> i64) (.age self)))
(defn hear [(s (dyn Speak))] (-> i64) (speak s))
(defn relay [(d Dog)] (-> i64) (hear d))
(defn main [] (-> i64) (relay (Dog :age 1)))
