(module m)

(defstruct R [(w i64)])

; `(mut c) r` would copy r; asking for `(mut r)` asks to alias a parameter that
; arrived as an immutable reference, which the caller never allowed.
(defn widen [(r R)] (-> i64)
  (let [(mut c) (mut r)]
    (set! (.w c) 99)
    (.w c)))

(defn main [] (-> i64)
  (widen (R :w 1)))
