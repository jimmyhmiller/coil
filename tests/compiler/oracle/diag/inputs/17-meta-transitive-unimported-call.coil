(module oracle.17-meta-transitive-unimported-call)
(import "coil.primitive" :as primitive)
(import "oracle.transitive-middle" :use *)

(defn generate-id [] (-> Code)
  `(defn generated-id [(n i64)] (-> i64)
     n))

(meta (generate-id))

; The leaf is loaded transitively through transitive-middle, but is not in scope.
; Meta elaboration used to discard this resolver diagnostic, omit main, and let a
; caller reach codegen's misleading `unknown callable` abort.
(defn main [] (-> i64)
  (leaf-helper))
