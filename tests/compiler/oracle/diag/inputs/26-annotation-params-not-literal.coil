(module annotation-params-not-literal)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])

(defn sub [(a i64) (b i64)] (-> i64) (- a b))

(def names [:a :b])

; The compiler reads :params from its literal form, like :inline.
(def sub-var :params names
  (var-static (fnptr c [i64 i64] i64) (primitive/fnptr-of sub)))

(defn main [] (-> i64)
  (sub-var :a 2 :b 1))
