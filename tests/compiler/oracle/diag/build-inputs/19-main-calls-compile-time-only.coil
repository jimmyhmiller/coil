(module oracle.diag.main-calls-compile-time-only)
(import "coil.primitive" :as primitive)

; primitive/error makes `checked` compile-time code, and so `twice` and `main`,
; which call it. `main` used to vanish silently and the link failed on _main.
(defn checked [(v i64)] (-> i64)
  (if (= v 0) (primitive/error "zero") v))

(defn twice [(v i64)] (-> i64) (+ (checked v) (checked v)))

(defn main [] (-> i32)
  (println "{}" (twice 5))
  0)
