(module oracle.float_math)
(import "coil.primitive" :as primitive)
(import "coil.math" :as math)

; coil.math on every backend. The native backends lower the scalar math
; intrinsics themselves (src/compiler/float_math.coil), so each operation is
; checked here against the LLVM reference. Exact operations print their bit
; patterns; the transcendentals come from the platform libm, which may differ
; in the last place, so they print rounded to four decimals. NaN results print
; as "nan" because a hardware default NaN's sign bit is target-specific.

(def half-f32 (: 0.5 f32))
(def neg-f64 -1.25)

(defn bits32 [(x f32)] (-> u64)
  (cast u64 (primitive/llvm-ir u32 [x] "%r = bitcast float $0 to i32\nret i32 %r")))

(defn bits64 [(x f64)] (-> u64)
  (primitive/llvm-ir u64 [x] "%r = bitcast double $0 to i64\nret i64 %r"))

(defn from-bits32 [(x u32)] (-> f32)
  (primitive/llvm-ir f32 [x] "%r = bitcast i32 $0 to float\nret float %r"))

(defn from-bits64 [(x u64)] (-> f64)
  (primitive/llvm-ir f64 [x] "%r = bitcast i64 $0 to double\nret double %r"))

(defn exact32 [(name (slice u8)) (x f32)] (-> i64)
  (if (primitive/fcmp-eq x x)
      (println "  {} {:x}" name (bits32 x))
      (println "  {} nan" name))
  0)

(defn exact64 [(name (slice u8)) (x f64)] (-> i64)
  (if (primitive/fcmp-eq x x)
      (println "  {} {:x}" name (bits64 x))
      (println "  {} nan" name))
  0)

(defn approx32 [(name (slice u8)) (x f32)] (-> i64)
  (approx64 name (cast f64 x)))

;;; The value to four places, as an integer. An infinity is named: converting one to
;;; an integer has no defined result.
(defn approx64 [(name (slice u8)) (x f64)] (-> i64)
  (cond (not (primitive/fcmp-eq x x)) (println "  {} nan" name)
        (not (primitive/fcmp-eq (- x x) 0.0)) (println "  {} {}" name (if (< x 0.0) "-inf" "inf"))
        :else (println "  {} {}" name (cast i64 (math/round (* x 10000.0)))))
  0)

(defn unary32 [(x f32)] (-> i64)
  (println "f32 {:x}" (bits32 x))
  (exact32 "sqrt" (math/sqrt x))
  (exact32 "abs" (math/abs x))
  (exact32 "floor" (math/floor x))
  (exact32 "ceil" (math/ceil x))
  (exact32 "trunc" (math/trunc x))
  (exact32 "round" (math/round x))
  (exact32 "round-even" (math/round-even x))
  (approx32 "sin" (math/sin x))
  (approx32 "cos" (math/cos x))
  (approx32 "tan" (math/tan x))
  (approx32 "asin" (math/asin x))
  (approx32 "acos" (math/acos x))
  (approx32 "atan" (math/atan x))
  (approx32 "sinh" (math/sinh x))
  (approx32 "cosh" (math/cosh x))
  (approx32 "tanh" (math/tanh x))
  (approx32 "exp" (math/exp x))
  (approx32 "exp2" (math/exp2 x))
  (approx32 "log" (math/log x))
  (approx32 "log2" (math/log2 x))
  (approx32 "log10" (math/log10 x)))

(defn unary64 [(x f64)] (-> i64)
  (println "f64 {:x}" (bits64 x))
  (exact64 "sqrt" (math/sqrt x))
  (exact64 "abs" (math/abs x))
  (exact64 "floor" (math/floor x))
  (exact64 "ceil" (math/ceil x))
  (exact64 "trunc" (math/trunc x))
  (exact64 "round" (math/round x))
  (exact64 "round-even" (math/round-even x))
  (approx64 "sin" (math/sin x))
  (approx64 "cos" (math/cos x))
  (approx64 "tan" (math/tan x))
  (approx64 "asin" (math/asin x))
  (approx64 "acos" (math/acos x))
  (approx64 "atan" (math/atan x))
  (approx64 "sinh" (math/sinh x))
  (approx64 "cosh" (math/cosh x))
  (approx64 "tanh" (math/tanh x))
  (approx64 "exp" (math/exp x))
  (approx64 "exp2" (math/exp2 x))
  (approx64 "log" (math/log x))
  (approx64 "log2" (math/log2 x))
  (approx64 "log10" (math/log10 x)))

(defn binary32 [(x f32) (y f32)] (-> i64)
  (println "f32 {:x} {:x}" (bits32 x) (bits32 y))
  (exact32 "min" (math/min x y))
  (exact32 "max" (math/max x y))
  (exact32 "copysign" (math/copysign x y))
  (exact32 "mul-add" (math/mul-add x y (: 0.1 f32)))
  (approx32 "atan2" (math/atan2 x y))
  (approx32 "pow" (math/pow x y)))

(defn binary64 [(x f64) (y f64)] (-> i64)
  (println "f64 {:x} {:x}" (bits64 x) (bits64 y))
  (exact64 "min" (math/min x y))
  (exact64 "max" (math/max x y))
  (exact64 "copysign" (math/copysign x y))
  (exact64 "mul-add" (math/mul-add x y 0.1))
  (approx64 "atan2" (math/atan2 x y))
  (approx64 "pow" (math/pow x y)))

(defn main [] (-> i64)
  (let [nan32 (from-bits32 (: 0x7fc00000 u32))
        negzero32 (from-bits32 (: 0x80000000 u32))
        nan64 (from-bits64 (: 0x7ff8000000000000 u64))
        negzero64 (from-bits64 (: 0x8000000000000000 u64))]
    (for x [(: 2.5 f32) (: -2.5 f32) (: 0.5 f32) (: 3.5 f32) (: -0.3 f32) negzero32 nan32]
      (unary32 x))
    (for x [2.5 -2.5 0.5 3.5 -0.3 negzero64 nan64]
      (unary64 x))
    (binary32 (: 1.5 f32) (: -2.0 f32))
    (binary32 (: 0.0 f32) negzero32)
    (binary32 negzero32 (: 0.0 f32))
    (binary32 nan32 (: 1.0 f32))
    (binary32 (: 1.0 f32) nan32)
    (binary32 (: 2.0 f32) (: 0.5 f32))
    (binary64 1.5 -2.0)
    (binary64 0.0 negzero64)
    (binary64 negzero64 0.0)
    (binary64 nan64 1.0)
    (binary64 1.0 nan64)
    (binary64 2.0 0.5)
    ; float `def` globals, both widths, including the library's constants
    (println "defs {:x} {:x} {:x} {:x} {:x}" (bits32 half-f32) (bits64 neg-f64)
             (bits64 math/pi) (bits64 math/tau) (bits64 math/e))
    0))
