; Big-aggregate paths: >64B and >256B copies (unrolled vs loop code paths),
; array-of-structs by value, sret of large structs, sums with big payloads.
(module t)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use [slice-data slice-new])
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defstruct Big [(arr (array i64 40)) (tag i64)])       ; 328 bytes -> loop copy
(defstruct Mid [(arr (array i32 20)) (tag i64)])       ; 88 bytes  -> unrolled
(defsum Carrier
  (CEmpty [])
  (CMid   [(m Mid)])
  (CPair  [(a i64) (b i64)]))

(defn fill-big [(k i64)] (-> Big)
  (let [p (primitive/alloc-stack Big) (mut i) 0]
    (loop (if (>= (load i) (primitive/cast i64 40)) (break)
      (do (set! (primitive/index (primitive/cast (ptr i64) (field p arr)) (load i)) (primitive/imul (load i) k))
          (set! i (primitive/iadd (load i) 1)))))
    (set! (.tag p) k)
    (load p)))

(defn sum-big [(b Big)] (-> i64)
  (let [p (primitive/alloc-stack Big)]
    (set! p b)
    (let [(mut tot) (.tag p) (mut i) 0]
      (loop (if (>= (load i) (primitive/cast i64 40)) (break)
        (do (set! tot
                  (primitive/iadd (load tot) (load (primitive/index (primitive/cast (ptr i64) (field p
                                                                                                               arr)) (load i)))))
            (set! i (primitive/iadd (load i) 1)))))
      (load tot))))

(defn fill-mid [(k i64)] (-> Mid)
  (let [p (primitive/alloc-stack Mid) (mut i) 0]
    (loop (if (>= (load i) (primitive/cast i64 20)) (break)
      (do (set! (primitive/index (primitive/cast (ptr i32) (field p arr)) (load i))
                (primitive/cast i32 (primitive/iadd (load i) k)))
          (set! i (primitive/iadd (load i) 1)))))
    (set! (.tag p) (primitive/imul k 1000))
    (load p)))

(defn sum-mid [(m Mid)] (-> i64)
  (let [p (primitive/alloc-stack Mid)]
    (set! p m)
    (let [(mut tot) (.tag p) (mut i) 0]
      (loop (if (>= (load i) (primitive/cast i64 20)) (break)
        (do (set! tot
                  (primitive/iadd (load tot) (primitive/cast i64 (load (primitive/index (primitive/cast (ptr i32) (field p
                                                                                                                                   arr)) (load i))))))
            (set! i (primitive/iadd (load i) 1)))))
      (load tot))))

(defn carrier-val [(c Carrier)] (-> i64)
  (match c
    (CEmpty [] -1)
    (CMid [m] (sum-mid m))
    (CPair [a b] (primitive/imul a b))))

(defn main [] (-> i64)
  (let [w (stdout)]
    ; big struct: build in one call, copy by value TWICE, sum in another
    (let [b (fill-big 3)
          b2 b]                       ; whole-struct binding copy
      (out w "big" (sum-big b2))
      (out w "bigtag" (let [p (primitive/alloc-stack Big)] (set! p b2) (.tag p))))
    (out w "mid" (sum-mid (fill-mid 5)))
    ; sums carrying aggregates through match
    (out w "cmid" (carrier-val (CMid (fill-mid 2))))
    (out w "cpair" (carrier-val (CPair 6 7)))
    (out w "cempty" (carrier-val (CEmpty)))
    ; array of structs on the heap
    (let [a (malloc-allocator)
          arr (slice-data
                (match (alloc [Mid] a 5)
                  (None [] (do (oom-at c"aggregate array" (primitive/imul 5 (primitive/sizeof Mid)))
                               (slice-new [Mid] (primitive/cast (ptr Mid) 0) 0)))
                  (Some [memory] memory)))
          (mut i) 0]
      (loop (if (>= (load i) (primitive/cast i64 5)) (break)
        (do (set! (primitive/index arr (load i)) (fill-mid (load i)))
            (set! i (primitive/iadd (load i) 1)))))
      (out w "arr3" (sum-mid (load (primitive/index arr 3))))
      (out w "arr0" (sum-mid (load (primitive/index arr 0)))))
    0))
