; Coverage for the llvm-ir escape hatch's expanded op subset (bitcast, icmp
; incl. i128, fcmp, select, sext/zext/trunc, float<->int conversions,
; bitwise/shift/div/rem, plain non-atomic load/store, getelementptr,
; llvm.masked.gather, llvm.sqrt), plus the inline vector-constant-literal and
; general (non-splat) shufflevector support those ops depend on. Every op
; here mirrors an actual shape from lib/paper/src/vector.coil (the paper-test
; project's SIMD raytracer, the original source of this expansion).
(module t)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defn outi [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l)
  (print-str w "=")
  (print-i w v)
  (print-nl w)
  0)

(defn outb [(w (ptr Writer)) (l (slice u8)) (v bool)] (-> i64)
  (print-str w l)
  (print-str w "=")
  (print-bool w v)
  (print-nl w)
  0)

(defn milli [(x f64)] (-> i64) (p/cast i64 (p/fmul x 1000.0)))

; ---- vector construction helpers (insertelement/shufflevector, already
; supported before this change, used here to build test inputs) ----
(defn mkvecf [(a f64) (b f64) (c f64) (d f64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [(p/cast f32 a)
              (p/cast f32 b)
              (p/cast f32 c)
              (p/cast f32 d)]
             "%v0 = insertelement <4 x float> poison, float $0, i32 0
%v1 = insertelement <4 x float> %v0, float $1, i32 1
%v2 = insertelement <4 x float> %v1, float $2, i32 2
%v3 = insertelement <4 x float> %v2, float $3, i32 3
ret $ret %v3"))

(defn mkveci [(a i32) (b i32) (c i32) (d i32)] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4)
             [a b c d]
             "%v0 = insertelement <4 x i32> poison, i32 $0, i32 0
%v1 = insertelement <4 x i32> %v0, i32 $1, i32 1
%v2 = insertelement <4 x i32> %v1, i32 $2, i32 2
%v3 = insertelement <4 x i32> %v2, i32 $3, i32 3
ret $ret %v3"))

(defn lanef [(v (vec f32 4)) (k i64)] (-> f64)
  (let [slot (p/alloc-stack (vec f32 4))]
    (store! slot v)
    (p/cast f64
                    (load (p/cast (ptr f32)
                                          (p/index (p/cast (ptr i8) slot)
                                                   (p/imul k 4)))))))

(defn lanei [(v (vec i32 4)) (k i64)] (-> i64)
  (let [slot (p/alloc-stack (vec i32 4))]
    (store! slot v)
    (p/cast i64
                    (load (p/cast (ptr i32)
                                          (p/index (p/cast (ptr i8) slot)
                                                   (p/imul k 4)))))))

; ---- bitcast + icmp, incl. i128 (`any`, the function that started this) ----
(defn any4 [(a (vec i32 4))] (-> bool)
  (p/llvm-ir bool [a] "%bits = bitcast $t0 $0 to i128
%r = icmp ne i128 %bits, 0
ret i1 %r"))

; ---- fcmp + select (`minimum`), sext (`greater`), and (`both`) ----
(defn vminimum [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [a b]
             "%c = fcmp olt $ret $0, $1
%r = select <4 x i1> %c, $ret $0, $ret $1
ret $ret %r"))

(defn vgreater [(a (vec f32 4)) (b (vec f32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4) [a b] "%c = fcmp ogt $t0 $0, $1
%r = sext <4 x i1> %c to $ret
ret $ret %r"))

(defn vboth [(a (vec i32 4)) (b (vec i32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4) [a b] "%r = and $ret $0, $1
ret $ret %r"))

; ---- inline vector-constant literals (icmp/select/shl/or), general
; shufflevector (byte-gather, not just splat) ----
(defn clamp255 [(v (vec i32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4)
             [v]
             "%c = icmp ugt $t0 $0, <i32 255, i32 255, i32 255, i32 255>
%r = select <4 x i1> %c, <4 x i32> <i32 255, i32 255, i32 255, i32 255>, <4 x i32> $0
ret $ret %r"))

(defn shift8 [(v (vec i32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4) [v] "%r = shl $ret $0, <i32 8, i32 8, i32 8, i32 8>
ret $ret %r"))

(defn orneg [(v (vec i32 4))] (-> (vec i32 4))
  (p/llvm-ir (vec i32 4)
             [v]
             "%r = or $ret $0, <i32 -16777216, i32 -16777216, i32 -16777216, i32 -16777216>
ret $ret %r"))

(defn coordinates [(x f64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [(mkvecf x x x x)]
             "%r = fadd $ret $0, <float 0.0, float 1.0, float 2.0, float 3.0>
ret $ret %r"))

(defn everyfourth [(v16 (vec i32 4))] (-> (vec u8 4))
  (p/llvm-ir (vec u8 4)
             [v16]
             "%bytes = bitcast $t0 $0 to <16 x i8>
%r = shufflevector <16 x i8> %bytes, <16 x i8> poison, <4 x i32> <i32 0, i32 4, i32 8, i32 12>
ret $ret %r"))

(defn laneb [(v (vec u8 4)) (k i64)] (-> i64)
  (let [slot (p/alloc-stack (vec u8 4))]
    (store! slot v)
    (p/cast i64 (load (p/index (p/cast (ptr u8) slot) k)))))

; ---- scalar div/rem, plain load/store, getelementptr + masked.gather + sqrt
; (`div`, `read-texture`/`write-colors`, `heights`, `root`) ----
(defn sdiv-t [(a i64) (b i64)] (-> i64)
  (p/llvm-ir i64 [a b] "%r = sdiv i64 $0, $1
ret $ret %r"))

(defn udiv-t [(a i64) (b i64)] (-> i64)
  (p/llvm-ir i64 [a b] "%r = udiv i64 $0, $1
ret $ret %r"))

(defn vdiv [(a (vec f32 4)) (b (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4) [a b] "%r = fdiv $ret $0, $1
ret $ret %r"))

(defn root [(a (vec f32 4))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [a]
             "declare <4 x float> @llvm.sqrt.v4f32(<4 x float>)
%r = call $ret @llvm.sqrt.v4f32($ret $0)
ret $ret %r"))

(defn read16 [(data (ptr u8))] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [data]
             "%v = load <16 x i8>, ptr $0, align 1
%r = bitcast <16 x i8> %v to $ret
ret $ret %r"))

(defn write16 [(out (ptr u8)) (v (vec f32 4))] (-> i64)
  (p/llvm-ir i64 [out v] "store $t1 $1, ptr $0, align 1
ret i64 0"))

(defn heights [(data (ptr u8)) (x (vec f32 4)) (y (vec f32 4)) (w i64) (h i64)] (-> (vec f32 4))
  (p/llvm-ir (vec f32 4)
             [data x y w h]
             "declare <4 x i8> @llvm.masked.gather.v4i8.v4p0(<4 x ptr>, i32 immarg, <4 x i1>, <4 x i8>)
%xi = fptosi $t1 $1 to <4 x i32>
%yi = fptosi $t2 $2 to <4 x i32>
%wi = trunc i64 $3 to i32
%w0 = insertelement <4 x i32> poison, i32 %wi, i32 0
%ws = shufflevector <4 x i32> %w0, <4 x i32> poison, <4 x i32> zeroinitializer
%hi = trunc i64 $4 to i32
%h0 = insertelement <4 x i32> poison, i32 %hi, i32 0
%hs = shufflevector <4 x i32> %h0, <4 x i32> poison, <4 x i32> zeroinitializer
%xp = icmp sge <4 x i32> %xi, zeroinitializer
%yp = icmp sge <4 x i32> %yi, zeroinitializer
%xq = icmp slt <4 x i32> %xi, %ws
%yq = icmp slt <4 x i32> %yi, %hs
%xy = and <4 x i1> %xp, %yp
%wh = and <4 x i1> %xq, %yq
%ok = and <4 x i1> %xy, %wh
%row = mul <4 x i32> %yi, %ws
%index = add <4 x i32> %row, %xi
%safe = select <4 x i1> %ok, <4 x i32> %index, <4 x i32> zeroinitializer
%ptrs = getelementptr i8, ptr $0, <4 x i32> %safe
%bytes = call <4 x i8> @llvm.masked.gather.v4i8.v4p0(<4 x ptr> %ptrs, i32 1, <4 x i1> <i1 true, i1 true, i1 true, i1 true>, <4 x i8> zeroinitializer)
%bounded = select <4 x i1> %ok, <4 x i8> %bytes, <4 x i8> zeroinitializer
%r = uitofp <4 x i8> %bounded to $ret
ret $ret %r"))

(defn main [] (-> i64)
  (let [w (stdout)
        zero (mkveci 0 0 0 0)
        nonzero (mkveci 0 0 5 0)]
    ; bitcast + icmp i128
    (outb w "any-zero" (any4 zero))
    (outb w "any-nonzero" (any4 nonzero))
    ; fcmp + select
    (let [a (mkvecf 1.0 5.0 3.0 -2.0)
          b (mkvecf 4.0 2.0 3.0 7.0)
          mn (vminimum a b)]
      (outi w "min0" (milli (lanef mn 0)))
      (outi w "min3" (milli (lanef mn 3))))
    ; fcmp + sext (0/-1 mask idiom)
    (let [gt (vgreater (mkvecf 1.0 5.0 3.0 -2.0) (mkvecf 4.0 2.0 3.0 7.0))]
      (outi w "gt0" (lanei gt 0))
      (outi w "gt1" (lanei gt 1)))
    ; and
    (let [both (vboth (mkveci 6 0 -1 12) (mkveci 3 5 -1 8))]
      (outi w "and0" (lanei both 0)))
    ; inline vector literals: icmp/select/shl/or
    (let [v (mkveci 100 300 -1 255)]
      (let [cl (clamp255 v)]
        (outi w "clamp0" (lanei cl 0))
        (outi w "clamp1" (lanei cl 1))
        (outi w "clamp2" (lanei cl 2)))
      (let [sh (shift8 v)]
        (outi w "shl0" (lanei sh 0)))
      (let [og (orneg v)]
        (outi w "or0" (lanei og 0))))
    ; inline vector literal on fadd (coordinates)
    (outi w "coord0" (milli (lanef (coordinates 10.0) 0)))
    ; general (non-splat) shufflevector byte-gather
    (let [e (everyfourth (mkveci 5 6 7 8))]
      (outi w "shuf0" (laneb e 0))
      (outi w "shuf3" (laneb e 3)))
    ; scalar div/rem
    (outi w "sdiv" (sdiv-t -7 2))
    (outi w "udiv" (udiv-t 7 2))
    ; fdiv
    (outi w "fdiv0" (milli (lanef (vdiv (mkvecf 1.0 1.0 1.0 1.0) (mkvecf 4.0 4.0 4.0 4.0)) 0)))
    ; sqrt intrinsic
    (outi w "sqrt2" (milli (lanef (root (mkvecf 4.0 9.0 2.0 100.0)) 2)))
    ; plain (non-atomic) load/store of a 16-byte aggregate
    (let [buf (p/alloc-stack (array u8 16))
          p8 (p/cast (ptr u8) buf)
          buf2 (p/alloc-stack (array u8 16))
          p8b (p/cast (ptr u8) buf2)]
      (store! (p/index p8 0) (p/cast u8 200))
      (store! (p/index p8 1) (p/cast u8 10))
      (let [v (read16 p8)]
        (write16 p8b v)
        (outi w "mem0" (p/cast i64 (load (p/index p8b 0))))
        (outi w "mem1" (p/cast i64 (load (p/index p8b 1))))))
    ; getelementptr (vector index) + llvm.masked.gather + bounds clamping
    (let [buf (p/alloc-stack (array u8 16))
          p8 (p/cast (ptr u8) buf)]
      (store! (p/index p8 0) (p/cast u8 10))
      (store! (p/index p8 5) (p/cast u8 20))
      (store! (p/index p8 10) (p/cast u8 30))
      (let [xs (mkvecf 0.0 1.0 2.0 3.0)
            ys (mkvecf 0.0 1.0 2.0 4.0)  ; last lane is out of bounds for a 4x4 grid
            r (heights p8 xs ys 4 4)]
        (outi w "h0" (milli (lanef r 0)))
        (outi w "h1" (milli (lanef r 1)))
        (outi w "h2" (milli (lanef r 2)))
        (outi w "h3" (milli (lanef r 3)))))
    0))
