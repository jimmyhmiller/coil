(module oracle.fixed-list)
(import "coil.fixedlist" :use *)
(import "coil.slice" :use [subslice])

; coil.fixedlist on every backend, and the array-field borrow it depends on.
; Reading a field is a value, so a slice of `(.items h)` views a copy that dies
; with the frame; `(field h items)` is the field's address, and a slice of it
; views the field itself — that is what a function returning the slice needs.

(defstruct Light [(x f32) (radius f32)])

(defstruct Renderer [(lights (InlineList Light 4)) (frame i64)])

(defstruct Holder [(items (array i64 4)) (n i64)])

(defn front [(h Holder)] (-> (slice i64))
  (subslice (field h items) 0 2))

(defn add-light! [(r (ptr Renderer)) (x f32)] (-> i64)
  (push! (mut (.lights r)) (Light :x x :radius 2.0)))

(defn main [] (-> i64)
  (let [h (Holder :items [7 8 9 10] :n 2)
        s (front h)]
    (println "field slice {} {}" (get s 0) (get s 1)))
  (let [(mut backing) [0 0 0 0 0]
        (mut xs) (fixed-list (: (mut backing) (slice i64)))]
    (push! (mut xs) 10)
    (push! (mut xs) 20)
    (push! (mut xs) 30)
    (set! (mut xs) 1 25)
    (println "fixed len={} cap={} full={} [1]={}" (len xs) (capacity xs) (full? xs) (get xs 1))
    (let [(mut total) 0]
      (for v (iter xs) (set! total (+ total v)))
      (println "fixed sum={}" total))
    (match (pop! (mut xs))
      (Some [v] (println "popped {}" v))
      (None [] (println "empty")))
    (clear! (mut xs))
    (println "cleared len={} storage[0]={}" (len xs) (get backing 0)))
  (let [(mut local) (inline-list [i64 3])]
    (push! (mut local) 5)
    (push! (mut local) 6)
    (push! (mut local) 7)
    (print "inline")
    (for v (iter local) (print " {}" v))
    (println " full={}" (full? local)))
  (let [(mut r) (Renderer :lights (inline-list [Light 4]) :frame 0)]
    (add-light! (mut r) 1.5)
    (add-light! (mut r) 2.5)
    (let [(mut sum) 0.0]
      (for l (iter (.lights r)) (set! sum (+ sum (cast f64 (.x l)))))
      (println "field list len={} cap={} x-sum={}" (len (.lights r)) (capacity (.lights r)) sum)))
  0)
