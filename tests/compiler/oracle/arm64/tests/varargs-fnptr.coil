; Variadic externs with many/mixed args (Apple: variadic -> stack), qsort
; with a Coil comparator called back from C, fnptr tables.
(module t)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.slice" :use [slice-data])
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.control" :use *)

(extern snprintf :cc c [(ptr i8) i64 (ptr i8) ...] (-> i32))
(extern qsort :cc c [(ptr i8) i64 i64 (fnptr c [(ptr i8) (ptr i8)] i32)] (-> void))
(extern strlen :cc c [(ptr i8)] (-> i64))

(defn must-bytes [(a (dyn Allocator)) (n i64) (align i64)] (-> (ptr i8))
  (match (alloc-bytes a n align)
    (None [] (do (oom-at c"ABI fixture" n) (primitive/cast (ptr i8) 0)))
    (Some [memory] (primitive/cast (ptr i8) (slice-data memory)))))

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defn cmp-i64 [(pa (ptr i8)) (pb (ptr i8))] (-> i32)
  (let [a (load (primitive/cast (ptr i64) pa)) b (load (primitive/cast (ptr i64) pb))]
    (if (< a b) (primitive/cast i32 -1) (if (> a b) (primitive/cast i32 1) (primitive/cast i32 0)))))

(defn dub [(x i64)] (-> i64) (primitive/imul x 2))
(defn sqr [(x i64)] (-> i64) (primitive/imul x x))
(defn neg [(x i64)] (-> i64) (primitive/isub 0 x))

(defn main [] (-> i64)
  (let [w (stdout) a (malloc-allocator)
        buf (must-bytes a 256 8)]
    ; variadic with 6 anonymous args (all on the stack on Apple arm64)
    (let [n (snprintf buf 256 c"%lld|%s|%lld|%lld|%lld|%lld" 42 c"mid" -7 1000000007 5 6)]
      (out w "len" (primitive/cast i64 n))
      (print-str w "str=") (print-cstr w buf) (print-nl w))
    ; qsort calls our fnptr from C land
    (let [arr (primitive/cast (ptr i64) (must-bytes a 64 8))]
      (store! (primitive/index arr 0) 42) (store! (primitive/index arr 1) -3)
      (store! (primitive/index arr 2) 17) (store! (primitive/index arr 3) 0)
      (store! (primitive/index arr 4) -100) (store! (primitive/index arr 5) 8)
      (store! (primitive/index arr 6) 99) (store! (primitive/index arr 7) 1)
      (qsort (primitive/cast (ptr i8) arr) 8 8 (primitive/fnptr-of cmp-i64))
      (let [(mut i) 0]
        (loop (if (>= (load i) (primitive/cast i64 8)) (break)
          (do (print-i w (load (primitive/index arr (load i))) )
              (write-byte w (primitive/cast u8 44))
              (store! i (primitive/iadd (load i) 1))))))
      (print-nl w))
    ; a table of function pointers dispatched in a loop
    (let [tbl (primitive/cast (ptr (fnptr c [i64] i64)) (must-bytes a 24 8))]
      (store! (primitive/index tbl 0) (primitive/fnptr-of dub))
      (store! (primitive/index tbl 1) (primitive/fnptr-of sqr))
      (store! (primitive/index tbl 2) (primitive/fnptr-of neg))
      (let [(mut i) 0 (mut acc) 0]
        (loop (if (>= (load i) (primitive/cast i64 3)) (break)
          (do (store! acc (primitive/iadd (load acc) (primitive/call-ptr (load (primitive/index tbl (load i))) 7)))
              (store! i (primitive/iadd (load i) 1)))))
        (out w "tbl" (load acc))))
    0))
