; Control-flow edges: labeled break/continue across nesting, break carrying
; aggregate values, divergent match arms, if with one/both diverging branches.
(module t)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(import "coil.control" :use *)
(import "coil.result" :use *)

(defn out [(w (ptr Writer)) (l (slice u8)) (v i64)] (-> i64)
  (print-str w l) (print-str w "=") (print-i w v) (print-nl w) 0)

(defstruct Pair [(x i64) (y i64)])

; labeled break out of a nested loop with a value
(defn find-pair [(target i64)] (-> Pair)
  (let [(mut i) 0]
    (loop :outer
      (if (>= (load i) (primitive/cast i64 20)) (break :outer (let [p (alloc/stack Pair)]
                                                (set! (.x p) -1) (set! (.y p) -1) (load p)))
        (do (let [(mut j) 0]
              (loop (if (>= (load j) (primitive/cast i64 20)) (break)
                (do (if (= (primitive/iadd (primitive/imul (load i) 10) (load j)) target)
                        (break :outer (let [p (alloc/stack Pair)]
                                        (set! (.x p) (load i)) (set! (.y p) (load j)) (load p)))
                      0)
                    (set! j (primitive/iadd (load j) 1))))))
            (set! i (primitive/iadd (load i) 1)))))))

; continue skips odd numbers
(defn sum-evens [(n i64)] (-> i64)
  (let [(mut i) 0 (mut tot) 0]
    (loop
      (if (>= (load i) n) (break)
        (do (set! i (primitive/iadd (load i) 1))
            (if (= (primitive/irem (load i) 2) (primitive/cast i64 1)) (continue) 0)
            (set! tot (primitive/iadd (load tot) (load i))))))
    (load tot)))

; a diverging match arm (break out of the enclosing loop from inside a match)
(defn until-err [(n i64)] (-> i64)
  (let [(mut i) 0 (mut acc) 0]
    (loop
      (do (let [r (if (> (load i) n) (Err [i64 i64] (load acc)) (Ok [i64 i64] (load i)))]
            (match r
              (Err [v] (break v))
              (Ok [v] (set! acc (primitive/iadd (load acc) v)))))
          (set! i (primitive/iadd (load i) 1))))))

(defn main [] (-> i64)
  (let [w (stdout)]
    (let [p (find-pair 137) pp (alloc/stack Pair)]
      (set! pp p)
      (out w "fx" (.x pp))
      (out w "fy" (.y pp)))
    (let [p (find-pair 999) pp (alloc/stack Pair)]
      (set! pp p)
      (out w "nx" (.x pp)))
    (out w "evens" (sum-evens 10))
    (out w "untilerr" (until-err 6))
    ; if with a diverging then-branch inside a loop
    (let [(mut k) 0 (mut steps) 0]
      (loop
        (if (> (load k) (primitive/cast i64 100))
            (break)
          (do (set! k (primitive/iadd (primitive/imul (load k) 2) 1))
              (set! steps (primitive/iadd (load steps) 1)))))
      (out w "steps" (load steps))
      (out w "k" (load k)))
    0))
