; An empty body is legal SYNTAX (it has type void), so this is no longer a parse

; error — it is a return-type mismatch. `(defn f [] (-> void))` with an empty body
; is legitimate; declaring a non-void return and supplying no body is not.
(module errtest)

(defn f [(n i64)] (-> i64))

(defn main [] (-> i64)
  (f 1))
