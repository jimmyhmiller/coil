(module abi)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.slice" :use [slice-len])

(defstruct Small [(a i32) (b i32)])

(defstruct Big [(a i64) (b i64) (c i64)])

(defstruct SlicePair [(bytes (slice u8))])

(defn take-small [(s Small)] (-> i64)
  (primitive/iadd (primitive/cast i64 (.a s)) (primitive/cast i64 (.b s))))

(defn take-big [(b Big)] (-> i64)
  (primitive/iadd (.a b) (primitive/iadd (.b b) (.c b))))

(defn make-small [(a i32) (b i32)] (-> Small)
  (let [p (primitive/alloc-stack Small)] (set! (.a p) a) (set! (.b p) b) (load p)))

(defn take-slice-pair [(s SlicePair)] (-> i64)
  (slice-len (.bytes s)))

(defn main [] (-> i64)
  (primitive/iadd (take-small (make-small 3 4))
                  (primitive/iadd (take-big (let [(mut g) (primitive/zeroed Big)] (set! (.a (mut g)) 1) (load g)))
                                  (take-slice-pair (SlicePair :bytes "abc")))))
