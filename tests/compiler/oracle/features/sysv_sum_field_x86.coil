(module sysv-sum-field-abi)

; A C-ABI struct small enough to be classified field by field (<= 16 bytes)
; whose field is a sum. Its words classify INTEGER on SysV x86-64.
(defsum Mode (Fast) (Slow [(steps i64)]))
(defstruct Options [(mode Mode)])

(defn steps [(options Options)] (-> i64)
  (match (.mode options)
    (Fast [] 0)
    (Slow [n] n)))

(export-c [steps :as "coil_sysv_sum_field_steps"])

(defn main [] (-> i64)
  (let [f (fnptr-of steps)]
    (f (Options :mode (Slow 42)))))
