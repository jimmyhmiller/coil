(module c-aggregate-callback-export)
(import "coil.primitive" :as primitive)

(defstruct S4 [(a u8) (b u8) (c u8) (d u8)])

(defstruct S8 [(a i32) (b i32)])

(defstruct Target [(tag i64) (value i64)])

(defstruct S32 [(a f64) (b f64) (c f64) (d f64)])

(extern invoke_callbacks
        :cc
        c
        [(fnptr c [S4] i64)
         (fnptr c [S8] i64)
         (fnptr c [Target] i64)
         (fnptr c [S32] i64)]
        (-> i64))

(defn inspect-s4 [(value S4)] (-> i64)
  (+ (+ (* (primitive/cast i64 (.a value)) 1000)
        (* (primitive/cast i64 (.b value)) 100))
     (+ (* (primitive/cast i64 (.c value)) 10)
        (primitive/cast i64 (.d value)))))

(defn inspect-s8 [(value S8)] (-> i64)
  (+ (* (primitive/cast i64 (.a value)) 100)
     (primitive/cast i64 (.b value))))

(defn inspect-target [(target Target)] (-> i64)
  (+ (* (.tag target) 100) (.value target)))

(defn inspect-s32 [(value S32)] (-> i64)
  (primitive/cast i64 (+ (+ (.a value) (.b value)) (+ (.c value) (.d value)))))

; Marks `inspect-target` as a C entry. fnptr-of must select this public ABI
; wrapper because C invokes the callback with Target by value.
(export-c [inspect-s4 :as "inspect_s4"]
          [inspect-s8 :as "inspect_s8"]
          [inspect-target :as "inspect_target"]
          [inspect-s32 :as "inspect_s32"])

(defn main [] (-> i64)
  (if (= (invoke_callbacks (primitive/fnptr-of inspect-s4)
                           (primitive/fnptr-of inspect-s8)
                           (primitive/fnptr-of inspect-target)
                           (primitive/fnptr-of inspect-s32))
         3108)
      0
      1))
