(module frame-records)
(import "coil.io" :use *)
(import "coil.primitive" :as primitive)

; gate-cli runs this and reads its backtrace: every level must appear, so each
; Coil function has to keep a frame record (or, on x86_64 Linux, CFI) that the
; unwinder can follow. The levels are not inlined so there is a chain to walk.

(extern backtrace :cc c [(ptr (ptr i8)) i32] (-> i32))
(extern backtrace_symbols_fd :cc c [(ptr (ptr i8)) i32 i32] (-> void))

(defn trace :inline (Never) [(k i64)] (-> i64)
  (let [frames (primitive/alloc-stack (array (ptr i8) 64))
        n (backtrace (primitive/cast (ptr (ptr i8)) frames) 64)]
    (backtrace_symbols_fd (primitive/cast (ptr (ptr i8)) frames) n 1)
    (+ k (primitive/cast i64 n))))
(defn level3 :inline (Never) [(k i64)] (-> i64) (* 3 (trace (+ k 1))))
(defn level2 :inline (Never) [(k i64)] (-> i64) (* 5 (level3 (+ k 2))))
(defn level1 :inline (Never) [(k i64)] (-> i64) (* 7 (level2 (+ k 3))))

(defn main [] (-> i64)
  (print-int (stdout) (level1 0))
  0)
