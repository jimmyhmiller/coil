(module ambient-core-ops)
(import "coil.assert" :use [assert])

(defstruct Pair [(x i64) (y i64)])
(defn plus-one [(x i64)] (-> i64) (+ x 1))

(defn main [] (-> i64)
  (let [p (stack Pair)
        g (static i64)
        fp (fnptr-of plus-one)]
    (store! (field p x) 40)
    (store! (field p y) 2)
    (store! g (+ (load (field p x)) (load (field p y))))
    (assert (= (load g) 42))
    (assert (= (ior 40 2) 42))
    (assert (= (urem 85 43) 42))
    (assert (fcmp-eq 1.5 1.5))
    (assert (> (alignof Pair) 0))
    (assert (= (offsetof Pair y) 8))
    (assert (= (call-ptr fp 41) 42))
    0))
