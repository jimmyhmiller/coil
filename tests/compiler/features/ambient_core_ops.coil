(module ambient-core-ops)
(import "coil.assert" :use [assert])
(import "coil.primitive" :as primitive)

(defstruct Pair [(x i64) (y i64)])
(defn plus-one [(x i64)] (-> i64) (+ x 1))

(defn main [] (-> i64)
  (assert (and))
  (assert (and true))
  (assert (and true true true))
  (assert (not (or)))
  (assert (not (or false)))
  (assert (not (or false false false)))
  (let [p (primitive/alloc-stack Pair)
        g (primitive/alloc-static i64)
        fp (fnptr-of plus-one)]
    (set! (.x p) 40)
    (set! (.y p) 2)
    (set! g (+ (.x p) (.y p)))
    (assert (= (load g) 42))
    (assert (= (primitive/ior 40 2) 42))
    (assert (= (primitive/urem 85 43) 42))
    (assert (primitive/fcmp-eq 1.5 1.5))
    (assert (> (alignof Pair) 0))
    (assert (= (offsetof Pair y) 8))
    (assert (= (call-ptr fp 41) 42))
    0))
