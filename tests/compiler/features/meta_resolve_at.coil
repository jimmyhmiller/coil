(module meta_resolve_at)
(import "coil.primitive" :as p)
(import "coil.meta" :use [user-forms])
(import "coil.slice" :use [slice-len])

;;; `primitive/resolve-at` answers what a spelling would name as a call head at a
;;; node: `:local` under a local of that name, otherwise the declaration a call
;;; there reaches. The probes below are calls whose node the checker asks about.

(defn probe-a [(s (slice u8))] (-> i64) (slice-len s))
(defn probe-b [(s (slice u8))] (-> i64) (slice-len s))
(defn probe-c [(s (slice u8))] (-> i64) (slice-len s))

;; this module's own `empty?` wins over coil.core's here
(defn empty? [(x i64)] (-> bool) (= x 0))

(defn under-a-local [(s (slice u8))] (-> i64)
  (let [len 10]
    (+ (probe-a s) len)))

(defn plain [(s (slice u8))] (-> i64)
  (probe-b s))

(defn under-a-parameter [(len i64) (s (slice u8))] (-> i64)
  (+ (probe-c s) len))

(defn probe? [(f Code) (name (slice u8))] (-> bool)
  (and (p/code-list? f)
       (and (not (p/code-vector? f))
            (and (> (len f) 0)
                 (and (p/code-sym? (get f 0)) (= (p/code-sym (get f 0)) name))))))

(defn expect [(got Code) (want Code) (what (slice u8))] (-> i64)
  (unless (= got want) (p/error what) 0)
  0)

(defn verify-at [(f Code)] (-> i64)
  (when (probe? f "probe-a")
    (expect (p/resolve-at f `len) `:local "a local named len is :local")
    (expect (p/resolve-at f `Len::len) `coil.core.len "Len::len reaches the trait method under the local")
    (expect (p/resolve-at f `coil.core.len) `coil.core.len "coil.core.len reaches the trait method")
    (expect (p/resolve-at f `s) `:local "a parameter is :local")
    (expect (p/resolve-at f `probe-a) `meta_resolve_at.probe-a "a module function")
    (expect (p/resolve-at f `slice-len) `coil.slice.slice-len "an imported function")
    (expect (p/resolve-at f `no-such-name) `:unresolved "nothing has that name")
    0)
  (when (probe? f "probe-b")
    (expect (p/resolve-at f `len) `coil.core.len "len is the trait method outside the local")
    (expect (p/resolve-at f `empty?) `meta_resolve_at.empty? "the module's own definition wins")
    0)
  (when (probe? f "probe-c")
    (expect (p/resolve-at f `len) `:local "a parameter named len is :local")
    0)
  (when (p/code-list? f)
    (for child f (verify-at child)))
  0)

(defn verify [(modules Code)] (-> Code)
  (for form (user-forms modules) (verify-at form))
  ; each call opens a new transaction
  (let [first (p/suggest-transaction)
        second (p/suggest-transaction)]
    (unless (> second first) (p/error "suggest-transaction does not open a new transaction") 0))
  `0)
(checker verify)

(defn main [] (-> i64)
  (+ (under-a-local "abc") (+ (plain "ab") (under-a-parameter 1 "a"))))
