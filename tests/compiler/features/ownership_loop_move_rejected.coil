(module ownership_loop_move_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (set! (.value self) 0)))

(defn consume [(owner Owner)] (-> void))

; The initial ownership implementation rejects loop-carried owner state instead
; of guessing whether a later iteration can execute.
(defn main [] (-> i64)
  (let [owner (Owner :value 42)]
    (loop
      (consume owner)
      (break))
    0))
