; `(import "coil.core" :use [])` — no core at all. Special forms plus coil.primitive is

; a usable freestanding dialect; public binding macros are deliberately unavailable here.
(module refer-no-core)
(import "coil.core" :use [])
(import "coil.primitive" :as primitive)

(defn* main [] (-> i64)
  (if (primitive/icmp-lt 1 2) 0 1))
