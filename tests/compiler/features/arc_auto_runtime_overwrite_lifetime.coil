(module arc_auto_runtime_overwrite_lifetime)
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defn main [] (-> i64)
  (do
    (let [(mut current) (Cell :value 1)]
      (set! current (Cell :value 42))
      (.value current))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
