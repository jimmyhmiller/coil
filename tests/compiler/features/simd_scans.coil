(module test.simd-scans)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [values (v/viota [i32 16])
        sum (v/vscan-add values 7)
        maximum (v/vscan-max (v/vneg values) -99)
        parity (v/vscan-xor values 3)]
    (let [(mut running) (cast i32 7) (mut xor-value) (cast i32 3)]
      (for [i 0 16]
        (set! running (+ (load running) (cast i32 i)))
        (set! xor-value (p/ixor (load xor-value) (cast i32 i)))
        (assert-eq (v/vextract (.values sum) i) (load running))
        (assert-eq (v/vextract (.values parity) i) (load xor-value))
        (assert-eq (v/vextract (.values maximum) i) (cast i32 0))))
    (assert-eq (.carry sum) (cast i32 127))
    (let [active (v/bits->mask [16] 0xaaaa)
          fill (v/vsplat [i32 16] -99)
          packed (v/vcompress values active fill)
          expanded (v/vexpand packed active fill)
          buffer (p/alloc-stack (array i32 16))
          base (cast (ptr i32) buffer)]
      (assert-eq (v/mask-count active) 8)
      (assert (v/mask-any? active))
      (assert (not (v/mask-all? active)))
      (assert-eq (match (v/mask-first active) (Some [i] i) (None [] -1)) 1)
      (assert-eq (match (v/mask-last active) (Some [i] i) (None [] -1)) 15)
      (for [i 0 16]
        (assert-eq (v/vextract packed i) (if (< i 8) (cast i32 (+ (* i 2) 1)) (cast i32 -99)))
        (assert-eq (v/vextract expanded i) (if (= (p/iand i 1) 1) (cast i32 i) (cast i32 -99))))
      (for [i 0 16] (store! (p/index base i) (cast i32 -99)))
      (assert-eq (v/vcompress-store base active values) 8)
      (for [i 0 16]
        (assert-eq (load (p/index base i)) (v/vextract packed i)))
      (assert (v/mask-all? (v/v= (v/vexpand-load base active fill) expanded)))
      (let [before (v/mask-preceding-any (v/bits->mask [16] 8) false)]
        (assert-eq (v/mask->bits (.values before)) (cast u64 0xfff0))
        (assert (.carry before))))
    0))
