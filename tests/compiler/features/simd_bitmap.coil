(module test.simd-bitmap)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.result" :use [Some None])

(defn main [] (-> i64)
  (let [input (cast u64 0xa5f0318729c64ebd)]
    (for [width 0 65]
      (let [mask (v/bits-low width) value (p/iand input mask)]
        (for [distance 0 (+ width 1)]
          (let [left (v/bits-shift-left input width distance (cast u64 0))
                right (v/bits-shift-right (.bits left) width distance (.carry left))
                r (v/bits-shift-right input width distance (cast u64 0))
                l (v/bits-shift-left (.bits r) width distance (.carry r))]
            (assert-eq (.bits right) value)
            (assert-eq (.bits l) value)))
        (for [initial 0 2]
          (let [result (v/bits-prefix-xor input width (= initial 1))
                (mut parity) (= initial 1) (mut expected) (cast u64 0)]
            (for [i 0 width]
              (set! parity (!= (load parity)
                (!= (p/iand (p/ishr input (cast u64 i)) (cast u64 1)) (cast u64 0))))
              (when (load parity)
                (set! expected (p/ior (load expected) (p/ishl (cast u64 1) (cast u64 i))))))
            (assert-eq (.bits result) (load expected))
            (assert-eq (.carry result) (load parity))))
        (let [(mut remaining) value (mut previous) -1 (mut count) 0]
          (loop
            (match (v/bits-pop-first (load remaining))
              (None [] (break))
              (Some [step]
                (let [item step]
                  (assert (> (.index item) (load previous)))
                  (set! previous (.index item))
                  (set! remaining (.remaining item))
                  (set! count (+ (load count) 1))))))
          (assert-eq (load count) (v/bits-rank input width)))))
    (assert-eq (v/bits-range 3 7) (cast u64 120))
    (assert-eq (v/bits-range 7 3) (cast u64 0))
    (for [base 0 16]
      (let [bytes (v/vadd (v/viota [u8 16]) (v/vsplat [u8 16] (cast u8 (* base 16))))
            digits (v/ascii-digit? bytes) alpha (v/ascii-alpha? bytes)
            hex (v/ascii-hex-digit? bytes) space (v/ascii-whitespace? bytes)
            continuation (v/utf8-continuation? bytes)]
        (for [i 0 16]
          (let [x (+ (* base 16) i)
                digit (and (>= x 48) (<= x 57))
                letter (or (and (>= x 65) (<= x 90)) (and (>= x 97) (<= x 122)))]
            (assert-eq (v/vextract digits i) digit)
            (assert-eq (v/vextract alpha i) letter)
            (assert-eq (v/vextract hex i)
              (or digit (or (and (>= x 65) (<= x 70)) (and (>= x 97) (<= x 102)))))
            (assert-eq (v/vextract space i) (or (= x 32) (and (>= x 9) (<= x 13))))
            (assert-eq (v/vextract continuation i) (and (>= x 128) (< x 192)))))))
    0))
