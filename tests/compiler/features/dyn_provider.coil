(module dyn_provider)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)

(export ModelProvider Provider)

(deftrait ModelProvider [Self]
  (run [(self (ptr Self))] (-> i64))
  (run-allocated [(self (ptr Self)) (a (dyn Allocator))] (-> i64)))

(defstruct Provider [(value i64)])

(impl ModelProvider Provider
  (run [(self (ptr Provider))]
       (-> i64)
       (load (field self value)))
  (run-allocated [(self (ptr Provider)) (a (dyn Allocator))]
                 (-> i64)
                 (load (box! a i64 (load (field self value))))))
