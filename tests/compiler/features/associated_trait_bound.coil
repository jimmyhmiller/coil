(module associated_trait_bound)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :use *)

(deftrait Container [Self Elem]
  (head [(c Self)] (-> (Option Elem))))

; Associated types may occur beneath ptr/ref/mut in an object-shaped method.
; Such a parameterized trait still dispatches statically.  `(dyn Trait)` cannot
; erase it until the language has syntax that binds its associated types.
(deftrait ConvertInto [Self Source]
  (convert-into [(out (ptr Self)) (source (ref Source))] (-> i64)))

(defstruct Box [(value i64)])

(impl Container Box
  (head [(c Box)] (-> (Option i64)) (Some (.value c))))

(impl ConvertInto Box
  (convert-into [(out (ptr Box)) (source (ref i64))] (-> i64)
    (store! (field out value) (load source))
    0))

(defn convert-via [Source (Target (ConvertInto Source))]
  [(out (mut Target)) (source (ref Source))] (-> i64)
  (convert-into (mut out) source))

; A caller's generic bound discharges the identical bound on a generic callee,
; including its associated type argument.
(defn forward-convert [Source (Target (ConvertInto Source))]
  [(out (mut Target)) (source (ref Source))] (-> i64)
  (convert-via [Source Target] (mut out) source))

(defn has-value [(C Container)] [(c C)] (-> i64)
  (match (head c) (Some [value] 42) (None [] 0)))

(defn drain-count [(C Pop)] [(xs (mut C))] (-> i64)
  (let [(mut count) 0]
    (loop (match (pop! (mut xs))
            (None [] (break))
            (Some [value] (store! count (+ (load count) 1)))))
    (load count)))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut xs) (al-new [i64] a)
        source 42
        converted (primitive/alloc-stack Box)]
    (store! converted (Box :value 0))
    (al-push! (mut xs) 1)
    (al-push! (mut xs) 2)
    (forward-convert [i64 Box] (mut converted) source)
    (+ (.value converted)
       (- (has-value (Box :value 42)) (drain-count (mut xs))))))
