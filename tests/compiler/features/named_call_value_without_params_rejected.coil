(module named-call-value-without-params-rejected)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])

(defn combine [(a i64) (b i64)] (-> i64)
  (+ (* a 10) b))

; No :params annotation, so there are no names to order the arguments by.
(def combine-var
  (var-static (fnptr c [i64 i64] i64) (primitive/fnptr-of combine)))

(defn main [] (-> i64)
  (combine-var :a 1 :b 2))
