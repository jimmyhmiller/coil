(module ownership_forget_take)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defn forget-owner [] (-> void)
  (forget (Owner :value 7)))

(defn take-and-reinitialize [] (-> void)
  (let [(mut owner) (Owner :value 3)
        taken (take! (mut owner))]
    (store! owner (Owner :value 4))))

(defn main [] (-> i64)
  (store! (counter) 0)
  (forget-owner)
  ; `forget` suppresses 7. `taken` was initialized after `owner`, so reverse
  ; lexical cleanup drops 3 and then the reinitialized owner drops 4.
  (take-and-reinitialize)
  (load (counter)))
