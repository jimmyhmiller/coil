(module compiler.features.jit-repl-arity-versions)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Each arity owns a cell: old callers and global/heap pointers survive edits,
;; abort and reclamation. Body edits update only the newest cell.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (scope :session
           (defer (jit/jit-session-free! (mut session)))
           (cond (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(module arity)
(import \"coil.repl\")
(import \"coil.primitive\" :as p)
(import \"coil.alloc\" :as a)
(import \"coil.var\" :use [var-static])
(defn f [(x i64)] (-> i64) (+ x 1))
(defn old [] (-> i64) (f 4))
(def saved (var-static (fnptr c [i64] i64) (p/fnptr-of f)))
(defstruct Holder [(fun (fnptr c [i64] i64))])
(def box (var-static (ptr Holder) (p/cast (ptr Holder) 0)))
(defn setup [] (-> i64) (set box (a/box! (a/malloc-allocator) Holder (Holder :fun (p/fnptr-of f)))) 0)
(defn pointers [] (-> i64) (+ (saved 4) (let [fun (.fun (get box))] (fun 4))))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 1: {}" (jit/jit-diagnostic (mut session)))
                     1)
                 (!= (jit/jit-compile-with-entry! (mut session) "" "(setup)") 0)
                   (do
                     (println "step 2: {}" (jit/jit-diagnostic (mut session)))
                     2)
                 (!= (jit/jit-prepare-with-entry! (mut session)
                                                  "(defn f [(x i64) (y i64)] (-> i64) (+ x y))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 3: {}" (jit/jit-diagnostic (mut session)))
                     3)
                 (!= (jit/jit-abort-prepared! (mut session)) 0)
                   (do
                     (println "step 4: {}" (jit/jit-diagnostic (mut session)))
                     4)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(if (and (= (old) 5) (= (pointers) 10)) 0 90)")
                     0)
                   (do
                     (println "step 5: {}" (jit/jit-diagnostic (mut session)))
                     5)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn f [(x i64) (y i64)] (-> i64) (+ x y)) (defn coupled [] (-> i64) (f 10 20)) (def current-pointer (fnptr c [i64 i64] i64) (p/fnptr-of f))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 6: {}" (jit/jit-diagnostic (mut session)))
                     6)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(if (and (= (old) 5) (and (= (pointers) 10) (and (= (coupled) 30) (= (current-pointer 10 20) 30)))) 0 91)")
                     0)
                   (do
                     (println "step 7: {}" (jit/jit-diagnostic (mut session)))
                     7)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn f [(x i64) (y i64)] (-> i64) (+ 100 (+ x y)))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 8: {}" (jit/jit-diagnostic (mut session)))
                     8)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(if (and (= (old) 5) (and (= (pointers) 10) (and (= (coupled) 130) (= (current-pointer 10 20) 130)))) 0 92)")
                     0)
                   (do
                     (println "step 9: {}" (jit/jit-diagnostic (mut session)))
                     9)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn f [] (-> i64) 77) (defn zero [] (-> i64) (f))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 10: {}" (jit/jit-diagnostic (mut session)))
                     10)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn f [(x i64)] (-> i64) (+ x 200)) (defn latest [] (-> i64) (f 4))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "step 11: {}" (jit/jit-diagnostic (mut session)))
                     11)
                 (< (jit/jit-reclaim-retired! (mut session)) 0)
                   (do
                     (println "step 12: {}" (jit/jit-diagnostic (mut session)))
                     12)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(do (println \"values: {} {} {} {} {}\" (old) (pointers) (coupled) (zero) (latest)) (if (and (= (old) 5) (and (= (pointers) 10) (and (and (= (coupled) 130) (= (current-pointer 10 20) 130)) (and (= (zero) 77) (= (latest) 204))))) 0 93))")
                     0)
                   (do
                     (println "step 13: {}" (jit/jit-diagnostic (mut session)))
                     13)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(a/destroy [Holder] (a/malloc-allocator) (get box))")
                     0)
                   (do
                     (println "step 14: {}" (jit/jit-diagnostic (mut session)))
                     14)
                 :else 0))))
