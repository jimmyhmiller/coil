(module ownership_derive_clone_copy)
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Resource [(value i64)])

(impl Clone Resource
  (clone [(self (ref Resource))]
         (-> Resource)
         (Resource :value (.value self))))

(impl Drop Resource
  (drop [(self (mut Resource))]
        (-> void)
        (store! (drops) (+ (load (drops)) 1))))

(defstruct OwnedPair [(resource Resource) (tag i64)])

(derive Clone OwnedPair)

(defstruct PlainPair [(left i64) (right i64)])

(derive Copy PlainPair)

(defsum OwnedChoice
  (Absent)
  (Present [(resource Resource) (tag i64)]))

(derive Clone OwnedChoice)

(defsum PlainChoice
  (Nothing)
  (Number [(value i64)]))

(derive Copy PlainChoice)

(defstruct GenericOwned [T] [(value T)])

(derive Clone (GenericOwned T))

(defstruct GenericPlain [T] [(value T)])

(derive Copy (GenericPlain T))

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [original
          (OwnedPair
            :resource (Resource :value 40)
            :tag 2)
        duplicate (clone original)
        plain (PlainPair :left 20 :right 22)
        copied plain
        choice (Present (Resource :value 7) 35)
        choice-copy (clone choice)
        plain-choice (Number 42)
        plain-choice-copy plain-choice
        generic (GenericOwned [Resource] :value (Resource :value 42))
        generic-copy (clone generic)
        generic-plain (GenericPlain [i64] :value 42)
        generic-plain-copy generic-plain
        owned-choice-ok
          (match choice-copy
            (Absent [] false)
            (Present [resource tag]
                     (= (+ (.value resource) tag) 42)))
        plain-choice-ok
          (match plain-choice-copy
            (Nothing [] false)
            (Number [value] (= value 42)))]
    (if (and (= (.value (.resource duplicate)) 40)
             (and (= (+ (.left copied) (.right copied)) 42)
                  (and (= (.tag original) 2)
                       (and owned-choice-ok
                            (and plain-choice-ok
                                 (and (= (.value (.value generic-copy)) 42)
                                      (= (.value generic-plain-copy) 42)))))))
        42
        1)))
