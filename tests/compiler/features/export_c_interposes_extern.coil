(module export-c-interposes-extern)

;; `(export-c [f :as "mkdir"])` defines the C symbol `mkdir`; every extern of that
;; symbol in the program binds to the definition, as when C objects are linked and
;; one defines what another declares. That includes the standard library's own
;; (`coil.fs` `make-dir`), and an extern that widens the mode differently: each
;; call runs `fake-mkdir`, never libc.
(import "coil.fs" :use [make-dir])

(extern mkdir-wide :as "mkdir" :cc c [(ptr i8) i64] (-> i32))

(defn fake-mkdir [(path (ptr i8)) (mode u16)] (-> i32)
  (cast i32 (+ 40 (cast i64 mode))))

(export-c [fake-mkdir :as "mkdir"])

(defn main [] (-> i64)
  (let [a (make-dir c"/nonexistent-coil-dir/never-created" 2)
        b (mkdir-wide c"/nonexistent-coil-dir/never-created" 3)]
    (if (and (= a 42) (= b 43)) 0 1)))
