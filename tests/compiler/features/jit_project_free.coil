(module compiler.features.jit-project-free)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.dbgalloc" :use [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.jit" :as jit)

;; Run in a project directory. The manifest a session loads is the session's, and
;; freeing the session releases it with everything else.
(defn main [] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))
        (mut session) (jit/jit-session-new (debug-allocator-view debug))]
    (cond
      (!= (jit/jit-session-load-project! (mut session)) 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module project-free.m) (import \"project-dependency.values\" :as v)
             (defn answer [] (-> i64) (v/answer))"
            "(if (= (project-free.m.answer) 42) 0 1)") 0) 2
      (!= (jit/jit-session-free! (mut session)) 0) 3
      (!= (debug-allocator-deinit! debug) 0) 4
      :else 0)))
