(module compiler.features.generated-impl-same-origin)
(import "coil.primitive" :as p)

(deftrait Score [Self]
  (score [(value Self)] (-> i64)))

(defstruct First [(value i64)])

(defstruct Second [(value i64)])

; Both implementations come from one template, so their methods carry the same
; source span. Their distinct target types must keep both implementations.
(defn score-impl [(target Code)] (-> Code)
  `(impl Score ~target
     (score [(value ~target)]
            (-> i64)
            (.value value))))

(defn generate [] (-> Code)
  `(do ~(score-impl `First) ~(score-impl `Second)))

(generate)

(defn main [] (-> i64)
  (let [first (First :value 20)
        second (Second :value 22)]
    (if (= (+ (score first) (score second)) 42) 0 1)))
