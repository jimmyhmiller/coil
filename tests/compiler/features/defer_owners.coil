(module defer-owners)
; Defer cleanups and drops share every exit, in reverse order of where they
; began: an owner bound before a defer is dropped after its cleanup, one bound
; after it before. Generic bodies, anonymous functions and macros are elaborated
; on their own paths and must place cleanups the same way.
(import "coil.primitive" :as primitive)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void) (println "drop {}" (.value self))))

(defn order [(early bool)] (-> i64)
  (block :s
    (let [a (Owner :value 1)]
      (defer* (println "cleanup sees {}" (.value a)))
      (let [b (Owner :value 2)]
        (when early (return-from :s 7))
        (println "body {}" (.value b))
        0))))

(defn per-iteration [] (-> i64)
  (let [(mut i) 0]
    (while (< i 3)
      (let [o (Owner :value (+ 10 i))]
        (defer* (set! i (+ i 1)))
        (when (= i 1) (continue))
        (println "iteration {}" (.value o))))
    i))

(defn generic-defer [T] [(x T) (n i64)] (-> i64)
  (block :s
    (defer* (println "generic cleanup {}" n))
    (when (> n 0) (return-from :s n))
    0))

(defn generic-owner [T] [(x T)] (-> i64)
  (let [o (Owner :value 9)]
    (block :s
      (defer* (println "generic owner cleanup {}" (.value o)))
      (return-from :s 1))))

(defn apply [(f (fnptr c [i64] i64)) (x i64)] (-> i64) (f x))

(defn doubled [(x Code)] (-> Code)
  (block :m
    (defer* (primitive/code-count `(a b)))
    `(+ ~x ~x)))

(defn main [] (-> i64)
  (let [v (order true)] (println "early {}" v))
  (let [v (order false)] (println "late {}" v))
  (let [v (per-iteration)] (println "per-iteration {}" v))
  (let [a (generic-defer 1 5) b (generic-defer true 0)] (println "generic {} {}" a b))
  (let [v (generic-owner 3)] (println "generic owner {}" v))
  (let [v (apply (fn [x] (block :a (defer* (println "anonymous cleanup {}" x)) (return-from :a (* x 2))))
                 21)]
    (println "anonymous {}" v))
  (println "macro {}" (doubled 21))
  0)
