; What `coil.lint.names/ln-is?` answers: whether a call head's spelling reaches a
; rule's fully-qualified name through the module's imports. Every lint rule asks it
; of every call head, so it rejects on the spelling's last bytes before it reads
; the import environment; each case below is one way a spelling can or cannot
; reach the name, including the two the cheap reject must not get wrong — a
; `:rename`d spelling, which shares no text with the name, and a name whose own
; part contains a `/`.
(module lint-names-resolution)
(import "coil.primitive" :as primitive)
(import "coil.lint.names" :use [ln-env ln-is?])

;;; "1" when SPELLING, in a module whose import forms are the items of IMPORTS,
;;; names QNAME; "0" when it does not.
(defn reaches [(imports Code) (spelling Code) (qname Code)] (-> Code)
  (if (ln-is? (primitive/code-str spelling) (ln-env `() imports) (primitive/code-str qname))
      `"1"
      `"0"))

(defn main [] (-> i64)
  (let [verdicts
          [(reaches (do (import "coil.arraylist" :as al)) al/al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :as al)) al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :as al)) al/al-get-or "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :as al)) al/xal-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :as other)) al/al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :use [al-get])) al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :use *)) al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :use * :exclude [al-get])) al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.str" :use *)) al-get "coil.arraylist/al-get")
           (reaches (do) coil.arraylist.al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :use [al-get] :rename [[al-get fetch]])) fetch "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :use [al-get] :rename [[al-get fetch]])) al-get "coil.arraylist/al-get")
           (reaches (do (import "coil.arraylist" :as al)) al/x/y "coil.arraylist/x/y")
           (reaches (do (import "coil.arraylist" :as al)) zx/y "coil.arraylist/x/y")]]
    (println "{}{}{}{}{}{}{}{}{}{}{}{}{}{}"
             (get verdicts 0) (get verdicts 1) (get verdicts 2) (get verdicts 3)
             (get verdicts 4) (get verdicts 5) (get verdicts 6) (get verdicts 7)
             (get verdicts 8) (get verdicts 9) (get verdicts 10) (get verdicts 11)
             (get verdicts 12) (get verdicts 13))
    0))
