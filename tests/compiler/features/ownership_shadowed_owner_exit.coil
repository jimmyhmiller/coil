(module ownership-shadowed-owner-exit)
; A break leaving two owners named `x` drops each once. The drop of the outer
; one is placed at the break, inside the inner one's scope; it used to name the
; inner `x` there, dropping it twice and the outer one never.

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void) (println "drop {}" (.value self))))

(defn shadowed-let [] (-> i64)
  (loop
    (let [x (Owner :value 1)]
      (let [x (Owner :value 2)]
        (println "inner {}" (.value x))
        (break 0)))))

(defn shadowed-in-one-let [] (-> i64)
  (loop
    (let [x (Owner :value 3)
          x (Owner :value 4)]
      (break (.value x)))))

(defn shadowed-arm [] (-> i64)
  (loop
    (let [x (Owner :value 5)]
      (match (Some 6)
        (Some [x] (break x))
        (None [] (break 0))))))

(defn main [] (-> i64)
  (let [v (shadowed-let)] (println "shadowed-let {}" v))
  (let [v (shadowed-in-one-let)] (println "shadowed-in-one-let {}" v))
  (let [v (shadowed-arm)] (println "shadowed-arm {}" v))
  0)
