(module arm64_got_addresses)
(import "coil.primitive" :as primitive)

(extern strlen :cc c [(ptr i8)] (-> i64))

(defn stable-cell [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn main [] (-> i64)
  (let [external (primitive/fnptr-of strlen)
        stable (stable-cell)]
    (if (and (primitive/icmp-ne (primitive/cast i64 (primitive/cast (ptr i8) external)) 0)
             (primitive/icmp-ne (primitive/cast i64 stable) 0))
        42
        1)))
