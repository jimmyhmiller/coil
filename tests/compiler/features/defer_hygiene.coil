(module defer-hygiene)
; A cleanup is placed at every exit, and the name it uses must still mean the
; binding it meant where it was written -- not one a nested `let` or match arm
; introduced between the defer and the exit.

(defsum E (Bad))

(defn fail [] (-> (Result i64 E)) (Err (Bad)))

(defn close [(f i64)] (-> i64)
  (println "close {}" f)
  0)

(defn shadowed-let [] (-> (Result i64 E))
  (let [f 10]
    (try
      (block :s
        (defer* (close f))
        (let [f 3]
          (println "inner f {}" f)
          (try! (fail))
          (Ok f))))))

(defn shadowed-mut [] (-> i64)
  (let [(mut n) 1]
    (loop
      (defer* (println "cleanup n {}" n))
      (let [(mut n) 5]
        (set! n 6)
        (break n)))))

(defn shadowed-arm [] (-> i64)
  (let [v 7]
    (loop
      (defer* (println "cleanup v {}" v))
      (match (Some 8)
        (Some [v] (break v))
        (None [] (break 0))))))

(defn shadowed-callee [] (-> i64)
  (block :s
    (defer* (close 1))
    (let [close 2]
      (return-from :s close))))

(defn main [] (-> i64)
  (match (shadowed-let) (Ok [_] (println "ok")) (Err [_] (println "err")))
  (let [v (shadowed-mut)] (println "shadowed-mut {}" v))
  (let [v (shadowed-arm)] (println "shadowed-arm {}" v))
  (let [v (shadowed-callee)] (println "shadowed-callee {}" v))
  0)
