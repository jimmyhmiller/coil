(module compiler.features.host-environment-embed)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)

;;; Build-time tooling for host_environment.coil, which registers `embed-environment`
;;; as a transform: describe the application module to a JIT session, export what
;;; the description declares, and add to the host module a function returning the
;;; description (all of it), and one returning a one-function subset.

;;; Does module record M already define `environment`? Transforms run until the
;;; program stops changing, so the embedding happens once. (The host calls
;;; `(environment)`: a call to a function a transform has yet to add is fine in
;;; the rounds before; an unbound variable would not be.)
(defn embedded? [(m Code)] (-> bool)
  (let [(mut found) false]
    (for f (iter m)
      (when (and (primitive/code-list? f)
                 (and (> (len f) 1)
                      (and (primitive/code-sym? (get f 1)) (= (primitive/code-str (get f 1)) "environment"))))
        (set! found true)))
    found))

;;; A function named NAME in module record M's own context, returning TEXT. A
;;; transform on the expanded program emits core forms.
(defn text-function [(m Code) (name (slice u8)) (text (slice u8))] (-> Code)
  `(defn* ~(primitive/datum->syntax (get m 0) name) [] (-> (slice u8)) ~text))

(defn embed-environment [(modules Code)] (-> Code)
  (let [app `compiler.features.host-environment-app
        (mut out) (primitive/code-list-new)]
    ; A transform returns `(do record…)`.
    (push! (mut out) `do)
    (for m (iter modules)
      (if (and (= (primitive/code-str (get m 0)) "compiler.features.host-environment") (not (embedded? m)))
          (let [whole (meta/describe-source (meta/describe-modules `(~app)))
                subset (meta/describe-source (meta/describe `(compiler.features.host-environment-app.helper)))
                (mut forms) (primitive/code-list-new)]
            (for n (iter (meta/definitions app)) (when (meta/linkable? n) (meta/link-export! n)))
            (for f (iter m) (push! (mut forms) f))
            (push! (mut forms) (text-function m "environment" whole))
            (push! (mut forms) (text-function m "helper-only" subset))
            (push! (mut out) (primitive/code-list-done (load forms))))
          (push! (mut out) m)))
    (primitive/code-list-done (load out))))
