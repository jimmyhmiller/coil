(module compiler.features.host-environment-embed)
(import "coil.meta" :as meta)

;;; Build-time tooling for host_environment.coil, which registers `embed-environment`
;;; as a transform: embed in the host module a description of the application
;;; module (`(environment)`, exporting everything it declares) and one of just
;;; `helper` (`(helper-only)`).
(defn embed-environment [(modules Code)] (-> Code)
  (let [host `compiler.features.host-environment]
    (meta/transform-result
      (meta/embed-text
        (meta/embed-description modules host "environment" `(compiler.features.host-environment-app))
        host "helper-only"
        (meta/describe-source (meta/describe `(compiler.features.host-environment-app.helper)))))))
