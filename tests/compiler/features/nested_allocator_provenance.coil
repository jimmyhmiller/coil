(module nested_allocator_provenance)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.rc" :as rc)
(import "coil.arc" :as arc)

(defstruct Counts
  [(allocations i64)
   (deallocations i64)
   (releases i64)])

(impl alloc/Allocator Counts
  (allocate [(self (ptr Counts)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
    (store! (field self allocations) (+ (load (field self allocations)) 1))
    (alloc/malloc-allocate (load request)))
  (resize [(self (ptr Counts))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))] (-> bool)
    false)
  (remap [(self (ptr Counts))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))] (-> (Option (ptr i8)))
    (None))
  (deallocate [(self (ptr Counts))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))] (-> i64)
    (store! (field self deallocations) (+ (load (field self deallocations)) 1))
    (primitive/free memory)))

(defn lease-retain [(state (ptr i8))] (-> i64) 0)

(defn lease-release [(state (ptr i8))] (-> i64)
  (let [counts (primitive/cast (ptr Counts) state)]
    (store! (field counts releases) (+ (load (field counts releases)) 1))))

(defn counted-lease [(counts (ptr Counts))] (-> alloc/AllocatorLease)
  (alloc/unsafe-allocator-lease-new
    (primitive/make-dyn alloc/Allocator counts)
    (primitive/cast (ptr i8) counts)
    (primitive/fnptr-of lease-retain)
    (primitive/fnptr-of lease-release)))

(defstruct Leaf [(drops (ptr i64))])

(impl Drop Leaf
  (drop [(self (mut Leaf))] (-> void)
    (let [drops (.drops self)]
      (store! drops (+ (load drops) 1)))))

; The outer Arc control block and the nested Rc control block deliberately come
; from different allocator leases. Structural drop glue for Payload must release
; the inner owner before the outer control block returns to its own allocator.
(defstruct Payload [(inner (rc/Rc Leaf))])

(defn exercise [(outer-counts (ptr Counts))
                (inner-counts (ptr Counts))
                (drops (ptr i64))] (-> i64)
  (match (rc/rc-new-in (counted-lease inner-counts) (Leaf :drops drops))
    (None [] 100)
    (Some [inner]
      (match (arc/arc-new-in (counted-lease outer-counts) (Payload :inner inner))
        (None [] 101)
        (Some [outer] 0)))))

(defn main [] (-> i64)
  (let [outer-counts (primitive/alloc-static Counts)
        inner-counts (primitive/alloc-static Counts)
        drops (primitive/alloc-static i64)]
    (store! outer-counts (primitive/zeroed Counts))
    (store! inner-counts (primitive/zeroed Counts))
    (store! drops 0)
    (let [result (exercise outer-counts inner-counts drops)]
      (cond (!= result 0) result
            (!= (load (field outer-counts allocations)) 1) 11
            (!= (load (field outer-counts deallocations)) 1) 12
            (!= (load (field outer-counts releases)) 1) 13
            (!= (load (field inner-counts allocations)) 1) 21
            (!= (load (field inner-counts deallocations)) 1) 22
            (!= (load (field inner-counts releases)) 1) 23
            (!= (load drops) 1) 31
            :else 42))))
