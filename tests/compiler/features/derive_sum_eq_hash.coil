;; derive Eq and Hash on sums, and on a struct holding a sum; a float payload
;; compares with fcmp-eq.
(module derive-sum-eq-hash)
(defsum Shape (Circle [(r i64)]) (Square [(side i64) (filled bool)]) (Dot) (Blob [(w f64)]))
(derive Debug Eq Shape)
(defsum Key (K1 [(a i64)]) (K2))
(derive Eq Hash Key)
(defstruct H [(label i64) (shape Shape)])
(derive Eq Debug H)
(defn main [] (-> i64)
  (println "{} {} {} {}" (= (Circle 2) (Circle 2)) (= (Circle 2) (Circle 3)) (= (Dot) (Dot)) (= (Dot) (Circle 1)))
  (println "{} {}" (= (Blob 1.5) (Blob 1.5)) (= (Square 1 true) (Square 1 false)))
  (println "{} {}" (= (hash (K1 4)) (hash (K1 4))) (= (hash (K1 4)) (hash (K2))))
  (println "{} {}" (= (H :label 1 :shape (Dot)) (H :label 1 :shape (Dot))) (= (H :label 1 :shape (Dot)) (H :label 1 :shape (Circle 1))))
  0)
