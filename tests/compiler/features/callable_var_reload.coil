(module callable-var-reload)

(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.var" :use [Var var-new var-set!])

(defn add1 [(x i64)] (-> i64) (+ x 1))
(defn times3 [(x i64)] (-> i64) (* x 3))
(defn sum2 [(x i64) (y i64)] (-> i64) (+ x y))
(defn weighted [(x i64) (y i64)] (-> i64) (+ (* x 10) y))
(defn forty-two [] (-> i64) 42)

(defn main [] (-> i64)
  (let [one (alloc/stack (Var (fnptr c [i64] i64)))
        two (alloc/stack (Var (fnptr c [i64 i64] i64)))
        zero (var-new (primitive/fnptr-of forty-two))]
    (store! one (var-new (primitive/fnptr-of add1)))
    (store! two (var-new (primitive/fnptr-of sum2)))
    (let [one-before (load one)
          two-before (load two)
          before1 (one-before 4)
          before2 (two-before 5 6)]
      (var-set! one (primitive/fnptr-of times3))
      (var-set! two (primitive/fnptr-of weighted))
      (let [one-after (load one)
            two-after (load two)]
        (+ (+ (- before1 5) (- before2 11))
           (+ (- (one-after 7) 21)
              (+ (- (two-after 3 4) 34)
                 (- (zero) 42))))))))
