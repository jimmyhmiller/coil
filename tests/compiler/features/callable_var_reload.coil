(module callable-var-reload)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.var" :use [Var var-static])

(defn add1 [(x i64)] (-> i64)
  (+ x 1))

(defn times3 [(x i64)] (-> i64)
  (* x 3))

(defn sum2 [(x i64) (y i64)] (-> i64)
  (+ x y))

(defn weighted [(x i64) (y i64)] (-> i64)
  (+ (* x 10) y))

(defn forty-two [] (-> i64)
  42)

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        one (Var::new a (primitive/fnptr-of add1))
        two (Var::new a (primitive/fnptr-of sum2))
        zero (var-static (fnptr c [] i64) (primitive/fnptr-of forty-two))]
    (let [one-alias one
          two-alias two
          one-before one
          two-before two
          before1 (one-before 4)
          before2 (two-before 5 6)]
      (set one (primitive/fnptr-of times3))
      (set two (primitive/fnptr-of weighted))
      (let [result
              (+ (+ (- before1 5) (- before2 11))
                 (+ (- (one-alias 7) 21)
                    (+ (- (two-alias 3 4) 34)
                       (- (zero) 42))))]
        (destroy one a)
        (destroy two a)
        result))))
