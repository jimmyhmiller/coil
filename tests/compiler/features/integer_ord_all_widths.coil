(module integer-ord-all-widths)
(import "coil.assert" :use [assert])
(import "coil.primitive" :as primitive)

(defn main [] (-> i64)
  (assert (< (primitive/cast i8 -2) (primitive/cast i8 1)))
  (assert (<= (primitive/cast i16 -2) (primitive/cast i16 -2)))
  (assert (> (primitive/cast i32 2) (primitive/cast i32 -1)))
  (assert (>= (primitive/cast i64 2) (primitive/cast i64 2)))
  (assert (< (primitive/cast u8 1) (primitive/cast u8 255)))
  (assert (<= (primitive/cast u16 65535) (primitive/cast u16 65535)))
  (assert (> (primitive/cast u32 0xffffffff) (primitive/cast u32 1)))
  (assert (>= (primitive/cast u64 -1) (primitive/cast u64 0)))
  (assert (= (primitive/cast i8 -1) (primitive/cast i8 -1)))
  (assert (!= (primitive/cast u32 1) (primitive/cast u32 2)))
  0)
