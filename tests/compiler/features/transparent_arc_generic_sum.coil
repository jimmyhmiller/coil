(module transparent_arc_generic_sum)

(defstruct Cell [(value i64)])

(defsum Optional [T]
  (Absent)
  (Present [(value T)]))

(defn main [] (-> i64)
  (let [first (Present [Cell] (Cell :value 10))
        second first]
    (match second
      (Absent [] 0)
      (Present [held]
               (let [(mut target) held]
                 (set! (.value target) 42)
                 (match first
                   (Absent [] 0)
                   (Present [original]
                            (let [source original] (.value source)))))))))
