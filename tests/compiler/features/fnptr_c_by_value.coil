;; `c` function pointers that take structs BY VALUE: an anonymous function or a
;; `fnptr-of` ascribed a by-value C signature is reached through a by-value C
;; entry; export-c's entry is typed the same way; 4-byte structs survive the C ABI.
(module fnptr-c-by-value)
(import "coil.primitive" :as primitive)

(defstruct S4 [(a i32)])
(defstruct Point [(x i64) (y i64)])

(defn take [(s S4)] (-> i64) (primitive/cast i64 (.a s)))
(defn px [(p Point)] (-> i64) (.y p))
(defn two [(p S4) (q S4)] (-> i32) (+ (.a p) (.a q)))
(export-c two)

(const TAKE (fnptr c [S4] i64) (fnptr-of take))

(defn main [] (-> i64)
  (let [f (: (fn [p] (+ (.x p) (* 10 (.y p)))) (fnptr c [Point] i64))
        g (: (fn [p q] (+ (.a p) (.a q))) (fnptr c [S4 S4] i32))
        cb (: (fnptr-of take) (fnptr c [S4] i64))
        cp (: (fnptr-of px) (fnptr c [Point] i64))
        t2 (: (fnptr-of two) (fnptr c [S4 S4] i32))]
    (println "anon {} {}" (f (Point :x 1 :y 2)) (g (S4 :a 3) (S4 :a 4)))
    (println "fnptr-of {} {}" (cb (S4 :a 7)) (cp (Point :x 1 :y 2)))
    (println "export {}" (t2 (S4 :a 3) (S4 :a 4)))
    (println "call-ptr {}" (primitive/call-ptr cb (S4 :a 8)))
    (println "const {}" (TAKE (S4 :a 100)))
    0))
