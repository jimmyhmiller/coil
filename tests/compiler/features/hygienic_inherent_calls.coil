(module compiler.features.hygienic-inherent-calls)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [Var var-static])

(defn initial [] (-> i64)
  7)

(defn slot [] (-> (Var (fnptr c [] i64)))
  (var-static (fnptr c [] i64) (primitive/fnptr-of initial)))

(defn invoke [] (-> i64)
  (let [f (slot)] (f)))

(defn version [(installer Code) (value Code)] (-> Code)
  (let [implementation (primitive/gensym)]
    `(do
       (defn ~implementation [] (-> i64)
         ~value)
       (defn ~installer [] (-> i64)
         (set (slot) (primitive/fnptr-of ~implementation))))))

(export-c [initial :as "frozen"])

(version install-one 10)

(defn decoy [(value i64)] (-> i64)
  (+ value 100))

(defn template-local [] (-> Code)
  `(let [set (primitive/fnptr-of decoy)] (set 5)))

(defn update-cell [(cell Code)] (-> Code)
  `(set ~cell (primitive/fnptr-of initial)))

(defn main [] (-> i64)
  (install-one)
  (let [before (invoke)
        set (primitive/fnptr-of decoy)]
    (update-cell (slot))
    (if (and (= before 10)
             (and (= (invoke) 7)
                  (and (= (template-local) 105) (= (set 6) 106))))
        0
        91)))
