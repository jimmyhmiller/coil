(module ownership_manually_drop)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (counter) (+ (load (counter)) (.value self)))))

(defn suppress [] (-> void)
  (let [held (manually-drop (Owner :value 7))]
    (do)))

(defn extract [] (-> void)
  (let [held (manually-drop (Owner :value 8))
        owner (manually-drop-into-inner held)]
    (do)))

(defn main [] (-> i64)
  (store! (counter) 0)
  (suppress)
  ; The wrapper suppresses 7. Consuming extraction transfers 8 to an ordinary
  ; owner, which is dropped exactly once.
  (extract)
  (load (counter)))
