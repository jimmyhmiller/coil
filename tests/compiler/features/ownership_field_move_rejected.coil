(module ownership_field_move_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)))

(defstruct Pair [(a Owner) (b Owner)])

(defn consume [(o Owner)] (-> i64) (.value o))

; `p`'s drop glue would destroy `a` a second time.
(defn main [] (-> i64)
  (let [p (Pair :a (Owner :value 1) :b (Owner :value 2))]
    (consume (.a p))))
