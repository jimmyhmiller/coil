(module extern-symbol-scoped-signatures)

;; One C symbol, three declarations that disagree only in integer width. Each
;; declaration is the module's own claim about the callee, so each call is built
;; against the declaration it names: `coil.fs` declares mkdir's mode as the
;; target's `mode_t`, and the two below widen it differently.
(import "coil.fs" :use [make-dir])

(extern mkdir-wide :as "mkdir" :cc c [(ptr i8) i64] (-> i32))
(extern mkdir-narrow :as "mkdir" :cc c [(ptr i8) i32] (-> i32))
(extern rmdir :cc c [(ptr i8)] (-> i32))

(defn main [] (-> i64)
  (let [via-stdlib c"/tmp/coil-extern-scoped-stdlib"
        via-wide c"/tmp/coil-extern-scoped-wide"
        via-narrow c"/tmp/coil-extern-scoped-narrow"]
    (rmdir via-stdlib)
    (rmdir via-wide)
    (rmdir via-narrow)
    (let [a (make-dir via-stdlib 493)
          b (mkdir-wide via-wide 493)
          c (mkdir-narrow via-narrow 493)]
      (rmdir via-stdlib)
      (rmdir via-wide)
      (rmdir via-narrow)
      (if (and (= a 0) (and (= b 0) (= c 0))) 0 1))))
