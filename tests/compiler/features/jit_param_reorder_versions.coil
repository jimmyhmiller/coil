(module compiler.features.jit-param-reorder-versions)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Interface generations retain separate cells even when their ABI types agree.
; Body edits update only the current generation; aborted and rejected edits
; must not change the interface registry, aliases, or runtime cells.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        result
          (cond
            (!= (jit/jit-compile-with-entry! (mut session)
              "(import \"coil.repl\")
               (defn f [(a i64) (b i64)] (-> i64) (+ (* a 100) b))
               (defn old [] (-> i64) (f :b 3 :a 7))
               (def saved (fnptr-of f))"
              "(coil.repl/publish)") 0) 1
            (!= (jit/jit-prepare-with-entry! (mut session)
              "(defn f [(b i64) (a i64)] (-> i64) 999)"
              "(coil.repl/publish)") 0) 2
            (!= (jit/jit-abort-prepared! (mut session)) 0) 3
            (!= (jit/jit-compile-with-entry! (mut session) ""
              "(if (= (f 7 3) 703) 0 1)") 0) 4
            (!= (jit/jit-compile-with-entry! (mut session)
              "(defn f [(b i64) (a i64)] (-> i64) (+ 1000 (+ (* a 100) b)))
               (defn middle [] (-> i64) (f :a 7 :b 3))
               (def middle-saved (fnptr-of f))"
              "(coil.repl/publish)") 0) 5
            (!= (jit/jit-compile-with-entry! (mut session)
              "(defn f [(b i64) (a i64)] (-> i64) (+ 2000 (+ (* a 100) b)))"
              "(coil.repl/publish)") 0) 6
            (= (jit/jit-compile-with-entry! (mut session)
              "(defn f [(a i64) (b f32)] (-> i64) 999)"
              "(coil.repl/publish)") 0) 7
            (< (jit/jit-reclaim-retired! (mut session)) 0) 11
            (!= (jit/jit-compile-with-entry! (mut session) ""
              "(if (and (= (old) 703) (= (saved 7 3) 703)
                        (= (middle) 2703) (= (middle-saved 3 7) 2703)
                        (= (f :a 7 :b 3) 2703)) 0 1)") 0) 8
            (!= (jit/jit-compile-with-entry! (mut session)
              "(defn f [(a i64) (b i64)] (-> i64) (+ 3000 (+ (* a 100) b)))"
              "(coil.repl/publish)") 0) 9
            (< (jit/jit-reclaim-retired! (mut session)) 0) 11
            (!= (jit/jit-compile-with-entry! (mut session) ""
              "(if (and (= (old) 703) (= (saved 7 3) 703)
                        (= (middle) 2703) (= (middle-saved 3 7) 2703)
                        (= (f 7 3) 3703)) 0 1)") 0) 10
            :else 0)]
    (jit/jit-session-free! (mut session))
    result))
