(module rc_arc_lifecycle)
(import "coil.primitive" :as primitive)
(import "coil.rc" :as rc)
(import "coil.arc" :as arc)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Payload [(answer i64)])

(impl Drop Payload
  (drop [(self (mut Payload))] (-> void)
    (store! (drops) (+ (load (drops)) 1))))

(defn rc-lifecycle [] (-> i64)
  (store! (drops) 0)
  (let [result
          (block :rc
            (let [weak
                    (match (rc/rc-new (Payload :answer 20))
                      (None [] (break :rc 100))
                      (Some [owner]
                        (let [other (clone owner)]
                          (when (!= (rc/rc-strong-count owner) 2) (break :rc 101))
                          (match (rc/rc-try-unwrap owner)
                            (Ok [_] (break :rc 102))
                            (Err [returned]
                              (let [released returned] 0)))
                          (when (!= (rc/rc-strong-count other) 1) (break :rc 103))
                          (rc/rc-downgrade other))))]
              (when (!= (load (drops)) 1) (break :rc 104))
              (match (rc/weak-rc-upgrade weak)
                (Some [_] (break :rc 105))
                (None [] 20))))]
    (+ result (load (drops)))))

(defn arc-lifecycle [] (-> i64)
  (store! (drops) 0)
  (let [result
          (block :arc
            (let [weak
                    (match (arc/arc-new (Payload :answer 20))
                      (None [] (break :arc 100))
                      (Some [owner]
                        (let [other (clone owner)]
                          (when (!= (arc/arc-strong-count owner) 2) (break :arc 101))
                          (match (arc/arc-try-unwrap owner)
                            (Ok [_] (break :arc 102))
                            (Err [returned]
                              (let [released returned] 0)))
                          (when (!= (arc/arc-strong-count other) 1) (break :arc 103))
                          (arc/arc-downgrade other))))]
              (when (!= (load (drops)) 1) (break :arc 104))
              (match (arc/weak-upgrade weak)
                (Some [_] (break :arc 105))
                (None [] 20))))]
    (+ result (load (drops)))))

(defn main [] (-> i64)
  (+ (rc-lifecycle) (arc-lifecycle)))
