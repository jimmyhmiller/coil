(module test.simd-clmul)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn main [] (-> i64)
  ; Every pair of monomials checks every output bit, including the lane boundary.
  (for [i 0 64]
    (for [j 0 64]
      (let [a (v/vsplat [u64 2] (p/ishl (cast u64 1) (cast u64 i)))
            b (v/vsplat [u64 2] (p/ishl (cast u64 1) (cast u64 j)))
            product (v/vclmul64 a b) bit (+ i j)]
        (assert-eq (v/vextract (.low product) 0)
          (if (< bit 64) (p/ishl (cast u64 1) (cast u64 bit)) (cast u64 0)))
        (assert-eq (v/vextract (.high product) 1)
          (if (>= bit 64) (p/ishl (cast u64 1) (cast u64 (- bit 64))) (cast u64 0))))))
  (let [ones (v/vsplat [u64 3] (cast u64 -1)) product (v/vclmul64 ones ones)]
    (assert-eq (v/vextract (.low product) 2) (cast u64 0x5555555555555555))
    (assert-eq (v/vextract (.high product) 2) (cast u64 0x5555555555555555)))
  0)
