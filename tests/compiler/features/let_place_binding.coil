; A `let` initializer that is already a place binds a VALUE unless the alias is
; written `(mut …)` — the same rule a call argument follows. Struct and array
; places are the exception: binding one is a view, never an implicit deep copy.
(module let_place_binding)

(defstruct P [(x i64) (y i64)])

(defn bump [(p (mut P))] (-> i64)
  ; re-borrowing a reference parameter, spelled out
  (let [(mut q) (mut p)]
    (store! (field (mut q) x) 42)
    0))

(defn main [] (-> i64)
  ; a bare name reads the cell: b is a fresh cell, a is untouched
  (let [(mut a) 10]
    (let [(mut b) (load a)]
      (store! (mut b) 99)
      (println "copy: a={d} b={d}" a b))
    ; the explicit borrow still aliases, so the store lands in a
    (let [(mut c) (mut a)]
      (store! (mut c) 77)
      (println "alias: a={d} c={d}" a c)))

  ; an immutable binding of a scalar place snapshots it
  (let [(mut d) 1]
    (let [e d]
      (store! (mut d) 2)
      (println "snapshot: d={d} e={d}" d e)))

  ; struct places stay references through both a binding and a call
  (let [(mut s) (zeroed P)]
    (store! (field (mut s) x) 1)
    (bump (mut s))
    (println "reborrowed param: s.x={d}" (load (field s x)))
    (let [view s]
      (store! (field (mut s) x) 7)
      (println "struct: s.x={d} view.x={d}" (load (field s x)) (load (field view x)))))
  0)
