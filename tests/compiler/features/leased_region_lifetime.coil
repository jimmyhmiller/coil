(module leased_region_lifetime_test)
(import "coil.alloc" :as alloc)
(import "coil.leased-region" :as leased)

(defn retain-one [] (-> alloc/AllocatorLease)
  (match (leased/leased-region-new (alloc/malloc-allocator-lease))
    (None [] (do (alloc/oom) (alloc/malloc-allocator-lease)))
    (Some [owner]
          (let [survivor (clone owner)] survivor))))

(defn main [] (-> i64)
  (let [lease (retain-one)
        request
          (alloc/AllocRequest
            :type-id 0
            :count 8
            :bytes 8
            :align 8)]
    (match (alloc/lease-raw-alloc lease request)
      (None [] 1)
      (Some [memory]
            (do
              (alloc/lease-raw-free lease memory request)
              42)))))
