(module test.const-generic-arrays)
(import "coil.primitive" :as p)
(import "coil.simd" :as v)

;; Array lengths as value parameters: in structs, signatures, borrows and impls.
(defstruct Buf [T (const N i64)] [(used i64) (items (array T N))])

(defn total [(const N i64)] [(xs (array i64 N))] (-> i64)
  (let [view (: xs (slice i64))
        (mut sum) 0]
    (for [i 0 (len view)]
      (set! sum (+ (load sum) (get view i))))
    (load sum)))

(defn buf-total [(const N i64)] [(b (Buf i64 N))] (-> i64)
  (total (.items b)))

(deftrait Size [Self]
  (size [(x Self)] (-> i64)))

(impl [T (const N i64)] Size (array T N)
  (size [(x (array T N))] (-> i64) (len (: x (slice T)))))

(impl [T] Size (array T 4)
  (size [(x (array T 4))] (-> i64) 400))

;; An impl whose only mention of a value parameter is a vector width.
(impl [T (const N i64)] Size (vec T N)
  (size [(x (vec T N))] (-> i64) (v/vlanes x)))

(defn main [] (-> i64)
  (let [three [1 2 3]
        four [(cast u8 1) (cast u8 2) (cast u8 3) (cast u8 4)]
        five [10 20 30 40 50]
        b (Buf [i64 3] :used 3 :items [4 5 6])]
    (assert-eq (total three) 6)
    (assert-eq (total five) 150)
    (assert-eq (buf-total b) 15)
    (assert-eq (size three) 3)
    (assert-eq (size four) 400)
    (assert-eq (size five) 5)
    (assert-eq (size (v/vzero [u8 16])) 16)
    (assert-eq (p/sizeof (Buf i64 3)) 32)
    (assert-eq (p/sizeof (Buf u8 16)) 24)
    0))
