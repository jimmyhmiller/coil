(module lint-param-rule)

(import "coil.primitive" :as primitive)

(defn check-lint-param [(modules Code)] (-> Code)
  (if (= (primitive/lint-param "test.message" "default") "configured")
      (do (primitive/warn modules "lint parameter reached checker") 0)
      0)
  `0)

(checker check-lint-param :phase before-expand)
