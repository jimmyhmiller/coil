(module compiler.features.jit-env-stale-complete)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.slice" :use [subslice])

; A session never replaces a definition: writing one again is an error. A client
; that wants a name to mean something new gives the new definition its own
; identity and points the name at it (`defalias`), or retires what the name meant.
; Every such edit reports exactly the accepted definitions that depend on what it
; changed: no more, no fewer. Each edit is checked against the same base state, so
; the rows are independent.

(def BASE "(module p)
(defstruct P1 [(x i64) (y i64)])
(defalias P P1)
(defsum S1 (A [(a i64)]) (B))
(defalias S S1)
(defstruct Q [(p P)])
(const K--1 3)
(defalias K K--1)
(const K2 (+ K 1))
(def G--1 1)
(defalias G G--1)
(defn twice--1 [(c Code)] (-> Code) `(* 2 ~c))
(defalias twice twice--1)
(deftrait Area [Self] (area [(self Self)] (-> i64)))
(impl Area P1 (area [(self P1)] (-> i64) (* (.x self) (.y self))))
(defn id--1 [T] [(v T)] (-> T) v)
(defalias id id--1)
(defn helper--1 [(n i64)] (-> i64) (+ n 1))
(defalias helper helper--1)
(defn calls-helper [] (-> i64) (helper 1))
(defn calls-calls-helper [] (-> i64) (calls-helper))
(defn reads-x [(p P)] (-> i64) (.x p))
(defn makes-p [] (-> P) (P :x 1 :y 2))
(defn mentions-p [(p (ptr P))] (-> i64) 0)
(defn reads-q [(q Q)] (-> i64) (.x (.p q)))
(defn reads-made-p [] (-> i64) (.x (makes-p)))
(defn matches-s [(s S)] (-> i64) (match s (A [a] a) (B [] 0)))
(defn uses-k [] (-> i64) K)
(defn uses-k2 [] (-> i64) K2)
(defn uses-g [] (-> i64) G)
(defn uses-macro [] (-> i64) (twice 5))
(defn uses-area [(p P1)] (-> i64) (area p))
(defn uses-id [] (-> i64) (id 4))
(defn uses-core-len [(s (slice u8))] (-> i64) (len s))
(defn uses-local-len [(len i64)] (-> i64) len)")

(defn stale? [(s (ptr jit/JitSession)) (e jit/JitEnv) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (jit/jit-env-stale-count s e)]
      (when (= (jit/jit-env-stale-name s e i) name) (set! found true) 0))
    found))

(defn listed? [(want (slice (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for w (iter want) (when (= w name) (set! found true) 0))
    found))

;;; Check SRC against BASE and compare its stale set with WANT; the mismatches.
(defn row [(s (ptr jit/JitSession)) (base jit/JitEnv) (label (slice u8))
           (src (slice u8)) (want (slice (slice u8)))] (-> i64)
  (let [e (jit/jit-env-check s base src)]
    (if (not (jit/jit-env-valid? e))
        (do (println "{s}: REJECTED: {s}" label (jit/jit-diagnostic s)) 1)
        (let [(mut bad) 0]
          (for w (iter want)
            (unless (stale? s e w)
              (println "{s}: missing {s}" label w)
              (set! bad (+ bad 1))
              0))
          (for [i 0 (jit/jit-env-stale-count s e)]
            (let [got (jit/jit-env-stale-name s e i)]
              (unless (listed? want got)
                (println "{s}: unexpected {s}" label got)
                (set! bad (+ bad 1))
                0)))
          (jit/jit-env-release! s e)
          bad))))

;;; SRC writes again a definition BASE accepted: the check must refuse it.
(defn refused [(s (ptr jit/JitSession)) (base jit/JitEnv) (label (slice u8)) (src (slice u8))] (-> i64)
  (let [e (jit/jit-env-check s base src)]
    (if (jit/jit-env-valid? e)
        (do (println "{s}: ACCEPTED a redefinition" label) (jit/jit-env-release! s e) 1)
        0)))

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-checked-session-new (a/malloc-allocator))
        base (jit/jit-env-check (mut s) (jit/jit-env-empty) BASE)
        none (subslice ["-"] 0 0)
        (mut bad) 0]
    (assert (jit/jit-env-valid? base))
    (assert (= (jit/jit-env-stale-count (mut s) base) 0))
    ; Nothing is replaced.
    (set! bad (+ bad (refused (mut s) base "defn" "(module p) (defn calls-helper [] (-> i64) 3)")))
    (set! bad (+ bad (refused (mut s) base "defstruct" "(module p) (defstruct P1 [(x i64)])")))
    (set! bad (+ bad (refused (mut s) base "defsum" "(module p) (defsum S1 (A [(a i64)]))")))
    (set! bad (+ bad (refused (mut s) base "const" "(module p) (const K2 9)")))
    (set! bad (+ bad (refused (mut s) base "def" "(module p) (def G--1 2)")))
    (set! bad (+ bad (refused (mut s) base "macro" "(module p) (defn twice--1 [(c Code)] (-> Code) c)")))
    ; A name pointed at a new definition: who reads the name depends on it.
    (set! bad (+ bad (row (mut s) base "function, new signature"
                       "(module p) (defn helper--2 [(n i64) (m i64)] (-> i64) (+ n m)) (defalias helper helper--2)"
                       ["p.calls-helper"])))
    (set! bad (+ bad (row (mut s) base "function, same signature"
                       "(module p) (defn helper--2 [(n i64)] (-> i64) (+ n 2)) (defalias helper helper--2)"
                       ["p.calls-helper"])))
    ; Only what spells `P` depends on what it names. `Q` holds `P1`, the definition
    ; `P` named when `Q` was checked, and still does; `reads-made-p` reads what
    ; `makes-p` returns, which is still a `P1`.
    (set! bad (+ bad (row (mut s) base "struct"
                       "(module p) (defstruct P2 [(y i64) (x i64)]) (defalias P P2)"
                       ["p.reads-x" "p.makes-p" "p.mentions-p"])))
    (set! bad (+ bad (row (mut s) base "sum"
                       "(module p) (defsum S2 (A2 [(a i64)]) (B2) (C2)) (defalias S S2)"
                       ["p.matches-s"])))
    (set! bad (+ bad (row (mut s) base "constant"
                       "(module p) (const K--2 4) (defalias K K--2)"
                       ["p.K2" "p.uses-k" "p.uses-k2"])))
    (set! bad (+ bad (row (mut s) base "global"
                       "(module p) (def G--2 2) (defalias G G--2)"
                       ["p.uses-g"])))
    (set! bad (+ bad (row (mut s) base "macro"
                       "(module p) (defn twice--2 [(c Code)] (-> Code) `(* 3 ~c)) (defalias twice twice--2)"
                       ["p.uses-macro"])))
    (set! bad (+ bad (row (mut s) base "generic"
                       "(module p) (defn id--2 [T] [(v T)] (-> T) (let [w v] w)) (defalias id id--2)"
                       ["p.uses-id"])))
    ; Retiring is how a client gets rid of something.
    (set! bad (+ bad (row (mut s) base "retire-alias"
                       "(module p) (retire-alias helper)" ["p.calls-helper"])))
    (set! bad (+ bad (row (mut s) base "retire-trait"
                       "(module p) (retire-trait Area)" ["p.uses-area"])))
    (set! bad (+ bad (row (mut s) base "retire-impl, then a new impl with the same signature"
                       "(module p) (retire-impl [] Area P1) (impl Area P1 (area [(self P1)] (-> i64) (+ (.x self) (.y self))))"
                       none)))
    (set! bad (+ bad (row (mut s) base "retire-trait, then a new trait with a new signature"
                       "(module p) (retire-trait Area) (deftrait Area [Self] (area [(self Self) (n i64)] (-> i64))) (impl Area P1 (area [(self P1) (n i64)] (-> i64) n))"
                       ["p.uses-area"])))
    ; Retiring a definition removes it: what read it depends on that. Defining
    ; the name again in the same submission is a new definition of that name.
    (set! bad (+ bad (row (mut s) base "retire-defn"
                       "(module p) (retire-defn calls-helper)" ["p.calls-calls-helper"])))
    (set! bad (+ bad (row (mut s) base "retire-defn, then a new definition of the name"
                       "(module p) (retire-defn calls-helper) (defn calls-helper [(n i64)] (-> i64) n)"
                       ["p.calls-calls-helper"])))
    (set! bad (+ bad (row (mut s) base "retire-defn through an alias"
                       "(module p) (retire-defn helper--1) (defn helper--1 [(n i64) (m i64)] (-> i64) (+ n m))"
                       ["p.calls-helper"])))
    (set! bad (+ bad (row (mut s) base "retire-struct"
                       "(module p) (retire-struct Q) (defstruct Q [(p P) (n i64)])" ["p.reads-q"])))
    (set! bad (+ bad (row (mut s) base "retire-sum"
                       "(module p) (retire-sum S1) (defsum S1 (A [(a i64)]) (B) (C))" ["p.matches-s"])))
    (set! bad (+ bad (row (mut s) base "retire-const"
                       "(module p) (retire-const K2) (const K2 9)" ["p.uses-k2"])))
    (set! bad (+ bad (row (mut s) base "retire-def"
                       "(module p) (retire-def G--1) (def G--1 2)" ["p.uses-g"])))
    (set! bad (+ bad (row (mut s) base "retire-defn of a macro"
                       "(module p) (retire-defn twice--1) (defn twice--1 [(c Code)] (-> Code) `(* 3 ~c))"
                       ["p.uses-macro"])))
    ; A new definition captures a name that readers reached through coil.core. A
    ; local of that name was never a lookup at all.
    (set! bad (+ bad (row (mut s) base "new definition shadows coil.core"
                       "(module p) (defn len [(x (slice u8))] (-> i64) 0)" ["p.uses-core-len"])))
    (jit/jit-env-release! (mut s) base)
    (jit/jit-reset! (mut s))
    (println "mismatches: {}" bad)
    bad))
