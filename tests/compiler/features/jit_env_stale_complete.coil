(module compiler.features.jit-env-stale-complete)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.slice" :use [subslice])

; Every kind of edit reports exactly the accepted definitions whose compiled form
; it changes or breaks: no more, no fewer. Each edit is checked against the same
; base state, so the rows are independent.

(def BASE "(module p)
(defstruct P [(x i64) (y i64)])
(defsum S (A [(a i64)]) (B))
(defstruct Q [(p P)])
(defstruct R [(p (ptr P))])
(defstruct Q2 [(q Q)])
(const K 3)
(const K2 (+ K 1))
(def G 1)
(def GP P (P :x 1 :y 1))
(defn twice [(c Code)] (-> Code) `(* 2 ~c))
(deftrait Area [Self] (area [(self Self)] (-> i64)))
(impl Area P (area [(self P)] (-> i64) (* (.x self) (.y self))))
(defalias PA P)
(defn id [T] [(v T)] (-> T) v)
(defn helper [(n i64)] (-> i64) (+ n 1))
(defn helper2 [(n i64)] (-> i64) (+ n 2))
(defalias h helper)
(defn calls-helper [] (-> i64) (helper 1))
(defn calls-calls-helper [] (-> i64) (calls-helper))
(defn reads-x [(p P)] (-> i64) (.x p))
(defn makes-p [] (-> P) (P :x 1 :y 2))
(defn mentions-p [(p (ptr P))] (-> i64) 0)
(defn reads-q [(q Q)] (-> i64) (.x (.p q)))
(defn reads-r [(r R)] (-> i64) 0)
(defn reads-made-p [] (-> i64) (.x (makes-p)))
(defn matches-s [(s S)] (-> i64) (match s (A [a] a) (B [] 0)))
(defn uses-k [] (-> i64) K)
(defn uses-k2 [] (-> i64) K2)
(defn uses-g [] (-> i64) G)
(defn uses-macro [] (-> i64) (twice 5))
(defn uses-area [(p P)] (-> i64) (area p))
(defn uses-alias [(p PA)] (-> i64) (.x p))
(defn uses-h [] (-> i64) (h 1))
(defn uses-id [] (-> i64) (id 4))
(defn gen [T] [(v T)] (-> i64) (helper 1))
(defn uses-gen [] (-> i64) (gen 4))
(defn reads-q2 [(q Q2)] (-> i64) (.x (.p (.q q))))
(defn uses-gp [] (-> i64) (.x GP))
(defn uses-core-len [(s (slice u8))] (-> i64) (len s))
(defn uses-local-len [(len i64)] (-> i64) len)")

(defn stale? [(s (ptr jit/JitSession)) (e jit/JitEnv) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (jit/jit-env-stale-count s e)]
      (when (= (jit/jit-env-stale-name s e i) name) (set! found true) 0))
    found))

(defn listed? [(want (slice (slice u8))) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for w (iter want) (when (= w name) (set! found true) 0))
    found))

;;; Check SRC against BASE and compare its stale set with WANT; the mismatches.
(defn row [(s (ptr jit/JitSession)) (base jit/JitEnv) (label (slice u8))
           (src (slice u8)) (want (slice (slice u8)))] (-> i64)
  (let [e (jit/jit-env-check s base src)]
    (if (not (jit/jit-env-valid? e))
        (do (println "{s}: REJECTED: {s}" label (jit/jit-diagnostic s)) 1)
        (let [(mut bad) 0]
          (for w (iter want)
            (unless (stale? s e w)
              (println "{s}: missing {s}" label w)
              (set! bad (+ bad 1))
              0))
          (for [i 0 (jit/jit-env-stale-count s e)]
            (let [got (jit/jit-env-stale-name s e i)]
              (unless (listed? want got)
                (println "{s}: unexpected {s}" label got)
                (set! bad (+ bad 1))
                0)))
          (jit/jit-env-release! s e)
          bad))))

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-checked-session-new (a/malloc-allocator))
        base (jit/jit-env-check (mut s) (jit/jit-env-empty) BASE)
        none (subslice ["-"] 0 0)
        (mut bad) 0]
    (assert (jit/jit-env-valid? base))
    (assert (= (jit/jit-env-stale-count (mut s) base) 0))
    (let [p-readers ["p.Area$p.P$area" "p.makes-p" "p.reads-x" "p.uses-area" "p.mentions-p"
                     "p.uses-alias" "p.reads-q" "p.reads-made-p" "p.reads-q2" "p.GP" "p.uses-gp"]]
      (set! bad (+ bad (row (mut s) base "fn body"
                         "(module p) (defn helper [(n i64)] (-> i64) (+ n 3))" none)))
      (set! bad (+ bad (row (mut s) base "fn signature"
                         "(module p) (defn helper [(n i64) (m i64)] (-> i64) (+ n m))"
                         ["p.calls-helper" "p.uses-h" "p.gen" "p.uses-gen"])))
      (set! bad (+ bad (row (mut s) base "fn return type"
                         "(module p) (defn helper [(n i64)] (-> i32) 1)"
                         ["p.calls-helper" "p.uses-h" "p.gen" "p.uses-gen"])))
      (set! bad (+ bad (row (mut s) base "struct add field"
                         "(module p) (defstruct P [(x i64) (y i64) (z i64)])" p-readers)))
      (set! bad (+ bad (row (mut s) base "struct retype field"
                         "(module p) (defstruct P [(x i32) (y i64)])" p-readers)))
      (set! bad (+ bad (row (mut s) base "struct reorder"
                         "(module p) (defstruct P [(y i64) (x i64)])" p-readers))))
    (set! bad (+ bad (row (mut s) base "sum add variant"
                       "(module p) (defsum S (A [(a i64)]) (B) (C))" ["p.matches-s"])))
    (set! bad (+ bad (row (mut s) base "const value"
                       "(module p) (const K 4)" ["p.K2" "p.uses-k" "p.uses-k2"])))
    (set! bad (+ bad (row (mut s) base "global redefinition"
                       "(module p) (def G 2)" ["p.uses-g"])))
    (set! bad (+ bad (row (mut s) base "macro body"
                       "(module p) (defn twice [(c Code)] (-> Code) `(* 3 ~c))" ["p.uses-macro"])))
    (set! bad (+ bad (row (mut s) base "generic body"
                       "(module p) (defn id [T] [(v T)] (-> T) (let [w v] w))" ["p.uses-id"])))
    (set! bad (+ bad (row (mut s) base "impl replaced, same signature"
                       "(module p) (retire-impl [] Area P) (impl Area P (area [(self P)] (-> i64) (+ (.x self) (.y self))))"
                       none)))
    (set! bad (+ bad (row (mut s) base "type alias retarget"
                       "(module p) (defstruct P2 [(x i64)]) (defalias PA P2)" ["p.uses-alias"])))
    (set! bad (+ bad (row (mut s) base "function alias retarget"
                       "(module p) (defalias h helper2)" ["p.uses-h"])))
    (set! bad (+ bad (row (mut s) base "retire-alias"
                       "(module p) (retire-alias PA)" ["p.uses-alias"])))
    (set! bad (+ bad (row (mut s) base "retire-trait"
                       "(module p) (retire-trait Area)" ["p.uses-area"])))
    (set! bad (+ bad (row (mut s) base "trait method signature"
                       "(module p) (retire-trait Area) (deftrait Area [Self] (area [(self Self) (n i64)] (-> i64))) (impl Area P (area [(self P) (n i64)] (-> i64) n))"
                       ["p.uses-area"])))
    ; A new definition captures a name that readers reached through coil.core.
    ; A local of that name was never a lookup at all.
    (set! bad (+ bad (row (mut s) base "new definition shadows coil.core"
                       "(module p) (defn len [(x (slice u8))] (-> i64) 0)" ["p.uses-core-len"])))
    (jit/jit-env-release! (mut s) base)
    (jit/jit-reset! (mut s))
    (println "mismatches: {}" bad)
    bad))
