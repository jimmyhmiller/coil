(module field-reflection-preserves-type-arguments)
(import "coil.primitive" :as p)

(defstruct Wrapped [(items (slice i64))])
(defsum Generic [T] (Item [(value T)]))

(defn verify [(T Code)] (-> Code)
  (unless (p/code-eq (p/code-field-type T 0) `(slice i64))
    (p/report T "field reflection discarded type arguments") 0)
  `(defn* reflected [] (-> i64) 0))

(defn verify-sum [(T Code)] (-> Code)
  (unless (p/code-eq (p/code-variant-field-type T 0 0) `i64)
    (p/report T "sum reflection did not substitute type arguments") 0)
  `(defn* reflected-sum [] (-> i64) 0))

(verify Wrapped)
(verify-sum (Generic i64))

(defn main [] (-> i64) 0)
