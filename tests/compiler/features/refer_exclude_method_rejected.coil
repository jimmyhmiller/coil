; SURFACE 3 (checker): an excluded core TRAIT METHOD is gone. This is the surface that
; makes the feature honest — hiding the name while leaving the operator callable would
; be worse than no feature at all.
(module refer-exclude-method-rejected)
(import "coil.core" :use * :exclude [<])
(defn main [] (-> i64) (if (< 1 2) 0 1))
