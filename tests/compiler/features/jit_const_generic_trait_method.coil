(module compiler.features.jit-const-generic-trait-method)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A constant whose initializer reaches a generic function that calls a trait
;; method on its type parameter materializes in a retained session: in the
;; submission that defines it, in a later one, and under the publish policy.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cg.m)
         (defn double [(T Add)] [(x T)] (-> T) (let [y x] (+ y y)))
         (defn build [] (-> i64) (double 20))
         (const TABLE (build))"
        "(if (= cg.m.TABLE 40) 0 1)") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cg.m)"
        "(if (= cg.m.TABLE 40) 0 1)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cg.p)
         (import \"coil.repl\")
         (defn double [(T Add)] [(x T)] (-> T) (let [y x] (+ y y)))
         (defn build [] (-> i64) (double 21))
         (const TABLE (build))"
        "(coil.repl/publish)") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cg.p)"
        "(if (and (= cg.p.TABLE 42) (= (cg.p.build) 42)) 0 1)") 0) 4
      :else (jit/jit-reset! (mut session)))))
