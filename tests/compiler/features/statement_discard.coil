(module statement-discard)
; Statement forms whose value is discarded: branches need not agree, loops may end
; with a bare (break), and a void function needs no `0` padding.
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free!])
(import "coil.iter" :use [Indexed])

(defstruct Noisy [(id i64)])
(impl Drop Noisy (drop [(self (mut Noisy))] (-> void) (println "drop {}" (.id self))))
(defn make [(id i64)] (-> Noisy) (Noisy :id id))

(defn statements [(n i64) (flag bool)] (-> void)
  (when (> n 0) (println "when"))
  (unless flag (println "unless"))
  (if flag (println "if") 0)
  (match (Some n) (Some [v] (println "match {}" v)) (None [] 0))
  (if flag (make 1) (make 2))
  (while (< n 0) (println "never"))
  (for i (range 0 n) (println "for {}" i)))

(defn tail-loop [(n i64)] (-> void)
  (for i (range 0 n) (println "tail {}" i)))

(defn touch [T] [(p (ptr T))] (-> i64) 7)
(defn tail-generic [(p (ptr i64))] (-> void) (touch p))

(defn mut-condition [] (-> i64)
  (let [(mut ok) true (mut count) 0]
    (while ok (set! count (+ count 1)) (when (= count 3) (set! ok false)))
    (if ok 100 count)))

(defn when-value [(n i64)] (-> i64) (+ 1 (when (> n 0) 41)))

(defn main [] (-> i64)
  (statements 2 true)
  (tail-loop 1)
  (let [(mut x) 5] (tail-generic (index (mut x) 0)))
  (println "mut-condition {}" (mut-condition))
  (println "when-value {}" (when-value 1))
  (let [(mut xs) (al-new [i64] (malloc-allocator))]
    (push! (mut xs) 10)
    (push! (mut xs) 20)
    (for x xs (println "iterable {}" x))
    (for e (enumerate xs) (let [p e] (println "enum {} {}" (.index p) (.value p))))
    (for (Indexed :index i :value v) (enumerate xs) (println "pattern {} {}" i v))
    (let [first [1 2]
          second [3 4]
          rows [(: first (slice i64)) (: second (slice i64))]]
      (for [a b] rows (println "pair {} {}" a b)))
    (al-free! (mut xs)))
  0)
