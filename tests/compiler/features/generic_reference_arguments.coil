(module generic-reference-arguments)

; A numeric literal lent to a `(ref T)` parameter is a weak constraint on T and
; takes the type its peer gives T; a `(mut x)` borrow passed to a `(ptr T)`
; parameter binds T to the place's type.

(defn same? [(T Eq)] [(a (ref T)) (b (ref T))] (-> bool) (= a b))

(defn width [T] [(p (ptr T))] (-> i64) (cast i64 (sizeof T)))

(defn main [] (-> i64)
  (let [x (: 7 u64)
        y (: 2.5 f32)
        (mut n) 5
        (mut b) (: 1 u8)]
    (println "{} {} {}" (same? x 7) (same? 0 x) (same? y 2.5))
    (println "{} {}" (width (mut n)) (width (mut b)))
    0))
