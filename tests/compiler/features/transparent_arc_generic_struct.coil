(module transparent_arc_generic_struct)

(defstruct Box [T] [(value T)])

(defn set-box [T] [(box (mut (Box T))) (value T)] (-> void)
  (set! (.value box) value))

(defn main [] (-> i64)
  (let [first (Box [i64] :value 10)
        (mut second) first]
    (set-box (mut second) 42)
    (.value first)))
