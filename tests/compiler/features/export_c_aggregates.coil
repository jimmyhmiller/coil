; export-c functions that take structs by value, called from C: 8-byte,
; 16-byte, 12-byte, HFA and 32-byte (by-reference) aggregates. The direct
; backends reach them through a C-ABI thunk. Past the argument registers,
; stack arguments in both directions (pack_callee, tri_callee, call_pack).
(module export-c-aggregates)
(defstruct Pair [(a i64) (b i64)])
(defstruct Small [(x i32) (y i32)])
(defstruct Big [(a i64) (b i64) (c i64) (d i64)])
(defstruct Vec3 [(x f64) (y f64) (z f64)])
(defstruct Odd [(a i32) (b i32) (c i32)])
(defstruct Tri [(x f32) (y f32) (z f32)])
(defn advance_pair [(p Pair) (n i64)] (-> i64) (+ (.a p) (.b p) n))
(defn small_sum [(s Small)] (-> i64) (+ (cast i64 (.x s)) (cast i64 (.y s))))
(defn big_sum [(b Big) (k i64)] (-> i64) (+ (.a b) (.b b) (.c b) (.d b) k))
(defn vec_len2 [(v Vec3)] (-> f64) (+ (* (.x v) (.x v)) (* (.y v) (.y v)) (* (.z v) (.z v))))
(defn odd_sum [(o Odd) (s Small)] (-> i64) (+ (cast i64 (.c o)) (cast i64 (.y s))))
(defn pack_callee [(a i32) (b i32) (c i32) (d i32) (e i32) (f i32) (g i32) (h i32)
                   (i i8) (j i16) (k i32) (l i64)] (-> i64)
  (+ (cast i64 i) (* (cast i64 j) 10) (* (cast i64 k) 100) (* l 1000)))
(defn tri_callee [(a f64) (b f64) (c f64) (d f64) (e f64) (f f64) (g f64) (h f64) (t Tri) (k i32)] (-> i64)
  (+ (cast i64 (+ (.x t) (* (.y t) (: 10.0 f32)) (* (.z t) (: 100.0 f32)))) (* (cast i64 k) 1000)))
(extern pack_c :cc c [i32 i32 i32 i32 i32 i32 i32 i32 i8 i16 i32 i64] (-> i64))
(defn call_pack [] (-> i64)
  (pack_c 0 0 0 0 0 0 0 0 (: 1 i8) (: 2 i16) 3 4))
(export-c advance_pair small_sum big_sum vec_len2 odd_sum pack_callee tri_callee call_pack)
