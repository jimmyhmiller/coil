(module generic-fnptr)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.primitive" :as primitive)
(import "coil.hashmap" :use [KeyOps hm-new hm-put! hm-get hm-free!])

; `(fnptr-of f [T…])` is a pointer to an instance of a generic function. Inside a
; generic function the type arguments may be its own type parameters, and an
; anonymous function there may use them too.

(defstruct Point [(x i64) (y i64) (z i64)])
(derive Eq Hash Point)

(defn scaled [(K Hash)] [(k K)] (-> i64) (* 2 (hash k)))

(defn apply [T R] [(f (fnptr c [T] R)) (x T)] (-> R) (f x))

;; A HashMap key table built from a trait bound: every operation is an instance.
(defn trait-key-hash [(K Hash)] [(p (ptr i8)) (n i64)] (-> i64) (hash (load (cast (ptr K) p))))
(defn trait-key-eq [(K Eq)] [(a (ptr i8)) (b (ptr i8)) (n i64)] (-> bool)
  (= (load (cast (ptr K) a)) (load (cast (ptr K) b))))
(defn trait-keyops [(K Hash Eq)] [] (-> (ptr KeyOps))
  (let [o (primitive/alloc-static KeyOps)]
    (store! (field o hash) (fnptr-of trait-key-hash [K]))
    (store! (field o eq) (fnptr-of trait-key-eq [K]))
    (store! (field o size) (sizeof K))
    o))

(defn hasher-of [(K Hash)] [] (-> (fnptr c [K] i64)) (fnptr-of scaled [K]))

;; An anonymous function inside a generic one, using its type parameter.
(defn twice-hash [(K Hash)] [(k K)] (-> i64)
  (let [f (: (fn [x] (hash x)) (fnptr c [K] i64))]
    (+ (f k) (call-ptr f k))))

(defn main [] (-> i64)
  (let [p (Point :x 1 :y 2 :z 3)
        explicit (fnptr-of scaled [i64])
        inferred (: (fnptr-of scaled) (fnptr c [Point] i64))]
    (println "{} {}" (= (explicit 5) (scaled 5)) (= (inferred p) (scaled p)))
    (println "{} {}" (= (apply (hasher-of [i64]) 7) (scaled 7)) (= (apply (hasher-of [Point]) p) (scaled p)))
    (println "{} {}" (= (twice-hash 9) (* 2 (hash 9))) (= (twice-hash p) (* 2 (hash p))))
    (let [(mut m) (hm-new [Point i64] (malloc-allocator) (trait-keyops [Point]))]
      (hm-put! (mut m) p 10)
      (hm-put! (mut m) (Point :x 4 :y 5 :z 6) 20)
      (println "{:?} {:?}" (hm-get (mut m) (Point :x 1 :y 2 :z 3)) (hm-get (mut m) (Point :x 9 :y 9 :z 9)))
      (hm-free! (mut m))))
  0)
