(module blanket-impl)

; `(impl [(T Hash Eq)] Key T)` implements Key for every type with Hash and Eq.
; An impl for a specific type or constructor is more specific, so it wins.

(deftrait Key [Self] (key-code [(k Self)] (-> i64)))

(impl [(T Hash Eq)] Key T
  (key-code [(k T)] (-> i64) (% (hash k) 1000)))

(defstruct Badge [(id i64)])
(impl Key Badge (key-code [(b Badge)] (-> i64) (.id b)))

(defstruct Box [A] [(v A)])
(impl [A] Key (Box A) (key-code [(b (Box A))] (-> i64) -1))

(deftrait Shape [Self] (area [(s Self)] (-> i64)))
(defstruct Square [(side i64)])
(impl Shape Square (area [(s Square)] (-> i64) (* (.side s) (.side s))))

; A blanket impl of a library trait: every Shape displays as its area.
(impl [(T Shape)] Display T
  (display-fmt [(s T) (f (ptr Formatter))] (-> i64)
    (fmt (formatter-writer f) "area {}" (area s))
    0))

; Through a bound on Key, or through the bounds the blanket impl requires.
(defn code-of [(K Key)] [(k K)] (-> i64) (key-code k))
(defn code-via-hash [(K Hash Eq)] [(k K)] (-> i64) (key-code k))

(defn main [] (-> i64)
  (println "{} {} {}" (= (key-code 5) (% (hash 5) 1000)) (key-code (Badge :id 7)) (key-code (Box :v true)))
  (println "{} {} {}" (code-of (Badge :id 8)) (code-of (Box :v 1)) (= (code-of 9) (% (hash 9) 1000)))
  (println "{}" (= (code-via-hash 11) (% (hash 11) 1000)))
  (println "{} {}" (Square :side 3) 12)
  0)
