(module compiler.features.host-environment-app)
(import "coil.var" :use [var-static Var])
(import "coil.jit.environment")

;;; The application a JIT session is given as its environment, by
;;; host_environment.coil: a record, a sum, a `def` holding a Var, a plain `def`, a
;;; constant, functions, a generic, a macro and an alias. The functions and defs
;;; marked `:jit/expose` are the ones a session can reach; the types, generic and
;;; macro come along as written.

(defstruct Point [(x i64) (y i64)])
(defsum Shape (Dot) (Box [(w i64) (h i64)]))
(def counter :jit/expose true (var-static i64 41))
(def limit :jit/expose true 100)
(const K 7)
(defn helper :jit/expose true [(n i64)] (-> i64) (+ n K))
(defn area :jit/expose true [(p Point)] (-> i64) (* (.x p) (.y p)))
(defn shift :jit/expose true [(p Point) (dx i64)] (-> Point) (Point :x (+ (.x p) dx) :y (.y p)))
(defn id [T] [(v T)] (-> T) v)
(defn twice [(c Code)] (-> Code) `(* 2 ~c))
(defalias assist helper)
(defn bump! :jit/expose true [] (-> i64) (set counter (+ (get counter) 1)) (get counter))
