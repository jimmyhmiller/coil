(module compiler.features.jit-live-checker)
(import "coil.alloc" :as a :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf sb-new sb-push-str! sb-push-i64! sb-finish!])
(import "coil.jit" :as jit)

; A live checker, written only against the public API: keep a compiler running,
; submit each edit, and always know which definitions are broken. The compiler
; never replaces a definition, so this client names its own versions: function
; NAME is defined as NAME--N, marked `:jit/retain false` so a version nothing
; uses is released, and NAME is an alias for the current version. Everything that
; makes it a *policy* lives here, not in the compiler -- what to do with an edit
; that does not check (keep the old state), what to do with the definitions an
; edit's dependency report names (check a new version of each, now), and what
; "broken" means (that check failed).

;;; One function as this client knows it: its name, its parameters, return type
;;; and body as written, and the qualified name of its current version.
(defstruct Version [(name (slice u8)) (rest (slice u8)) (impl (slice u8))])

(defstruct Checker
  [(allocator (dyn Allocator))
   (session jit/JitSession)
   (env jit/JitEnv)
   (versions (ArrayList Version))
   (next i64)
   ; Names whose newest version failed to check.
   (broken (ArrayList (slice u8)))])

(defn broken? [(c (ptr Checker)) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (len (.broken c))] (when (= (get (.broken c) i) name) (set! found true) 0))
    found))

(defn mark-broken! [(c (ptr Checker)) (name (slice u8))] (-> i64)
  (unless (broken? c name) (push! (mut (.broken c)) name) 0)
  0)

(defn mark-fixed! [(c (ptr Checker)) (name (slice u8))] (-> i64)
  (let [(mut kept) (al-new [(slice u8)] (.allocator c))]
    (for [i 0 (len (.broken c))]
      (unless (= (get (.broken c) i) name) (push! (mut kept) (get (.broken c) i)) 0))
    (al-free! (mut (.broken c)))
    (set! (.broken c) kept))
  0)

;;; The function whose current version is IMPL, or -1.
(defn version-of [(c (ptr Checker)) (impl (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (len (.versions c))]
      (when (= (.impl (get (.versions c) i)) impl) (set! found i) 0))
    found))

(defn named [(c (ptr Checker)) (name (slice u8))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (len (.versions c))]
      (when (= (.name (get (.versions c) i)) name) (set! found i) 0))
    found))

(defn adopt! [(c (ptr Checker)) (next jit/JitEnv)] (-> i64)
  (jit/jit-env-release! (mut (.session c)) (.env c))
  (set! (.env c) next)
  0)

;;; Check a new version of NAME, written as REST, against the current state. On
;;; success the state is the new one and NAME's version is recorded; on failure
;;; nothing changes. Returns whether it checked.
(defn check-version! [(c (ptr Checker)) (name (slice u8)) (rest (slice u8))] (-> bool)
  (let [n (.next c)
        (mut impl) (sb-new (.allocator c))
        (mut qualified) (sb-new (.allocator c))
        (mut source) (sb-new (.allocator c))]
    (set! (.next c) (+ n 1))
    (sb-push-str! (mut impl) name)
    (sb-push-str! (mut impl) "--")
    (sb-push-i64! (mut impl) n)
    (let [impl-name (sb-finish! (mut impl))]
      (sb-push-str! (mut qualified) "shapes.")
      (sb-push-str! (mut qualified) impl-name)
      (sb-push-str! (mut source) "(module shapes) (defn ")
      (sb-push-str! (mut source) impl-name)
      (sb-push-str! (mut source) " :jit/retain false ")
      (sb-push-str! (mut source) rest)
      (sb-push-str! (mut source) ") (defalias ")
      (sb-push-str! (mut source) name)
      (sb-push-str! (mut source) " ")
      (sb-push-str! (mut source) impl-name)
      (sb-push-str! (mut source) ")")
      (let [next (jit/jit-env-check (mut (.session c)) (.env c) (sb-finish! (mut source)))]
        (if (not (jit/jit-env-valid? next))
            false
            (let [record (Version :name name :rest rest :impl (sb-finish! (mut qualified)))
                  at (named c name)]
              (adopt! c next)
              (if (< at 0)
                  (push! (mut (.versions c)) record)
                  (set! (mut (.versions c)) at record))
              true))))))

;;; Check a new version of every definition the current state's dependency report
;;; names, and of whatever those make dependents in turn. One that does not check
;;; keeps its current version and is recorded as broken. Returns how many were
;;; checked.
(defn settle! [(c (ptr Checker))] (-> i64)
  (let [(mut pending) (al-new [i64] (.allocator c))
        (mut rechecked) 0]
    (for [i 0 (jit/jit-env-stale-count (mut (.session c)) (.env c))]
      (let [v (version-of c (jit/jit-env-stale-name (mut (.session c)) (.env c) i))]
        (unless (< v 0) (push! (mut pending) v) 0)))
    (loop
      (when (= (len pending) 0) (break))
      (let [v (match (pop! (mut pending)) (Some [n] n) (None [] -1))
            version (get (.versions c) v)]
        (set! rechecked (+ rechecked 1))
        (if (check-version! c (.name version) (.rest version))
            (do
              (mark-fixed! c (.name version))
              (for [i 0 (jit/jit-env-stale-count (mut (.session c)) (.env c))]
                (let [w (version-of c (jit/jit-env-stale-name (mut (.session c)) (.env c) i))]
                  (unless (< w 0) (push! (mut pending) w) 0)))
              0)
            (do (mark-broken! c (.name version)) 0))))
    (al-free! (mut pending))
    rechecked))

;;; Define NAME as REST. Returns how many definitions had to be checked again, or
;;; -1 if the edit itself does not check (the state is then unchanged).
(defn define! [(c (ptr Checker)) (name (slice u8)) (rest (slice u8))] (-> i64)
  (if (not (check-version! c name rest))
      -1
      (do (mark-fixed! c name) (settle! c))))

(defn main [] (-> i64)
  (let [allocator (a/malloc-allocator)
        (mut session) (jit/jit-checked-session-new allocator)
        start (jit/jit-env-check (mut session) (jit/jit-env-empty)
                "(module shapes) (import \"coil.jit.lifetime\")")
        (mut c) (Checker :allocator allocator :session session :env start
                         :versions (al-new [Version] allocator) :next 1
                         :broken (al-new [(slice u8)] allocator))]
    (assert (jit/jit-env-valid? start))
    (assert (= (define! (mut c) "area" "[(w i64) (h i64)] (-> i64) (* w h)") 0))
    (assert (= (define! (mut c) "unit" "[] (-> i64) (area 1 1)") 0))
    (assert (= (define! (mut c) "double-unit" "[] (-> i64) (* 2 (unit))") 0))
    (assert (= (define! (mut c) "square" "[(n i64)] (-> i64) (area n n)") 0))
    (assert (= (len (.broken c)) 0))

    ; An edit that does not check changes nothing.
    (assert (= (define! (mut c) "oops" "[] (-> i64) (area)") -1))
    (assert (< (named (mut c) "oops") 0))

    ; A new version of `area` with the same signature: its readers depend on it.
    ; Each checks, and its new version makes `double-unit` a dependent in turn.
    (assert (= (define! (mut c) "area" "[(w i64) (h i64)] (-> i64) (+ 0 (* w h))") 3))
    (assert (= (len (.broken c)) 0))

    ; A signature change: its two readers are checked again, and both are broken.
    ; They keep their versions, so `double-unit` depends on nothing that changed.
    (assert (= (define! (mut c) "area" "[(w i64)] (-> i64) (* w w)") 2))
    (assert (= (len (.broken c)) 2))
    (assert (broken? (mut c) "unit"))
    (assert (broken? (mut c) "square"))
    (assert (not (broken? (mut c) "double-unit")))

    ; Fixing one of them.
    (assert (= (define! (mut c) "square" "[(n i64)] (-> i64) (area n)") 0))
    (assert (= (len (.broken c)) 1))

    ; Putting the old signature back: `unit` checks again (and `double-unit` with
    ; it), and the `square` written for the narrow signature is now the broken one.
    (assert (= (define! (mut c) "area" "[(w i64) (h i64)] (-> i64) (* w h)") 3))
    (assert (not (broken? (mut c) "unit")))
    (assert (broken? (mut c) "square"))
    (assert (= (len (.broken c)) 1))

    (jit/jit-env-release! (mut (.session c)) (.env c))
    (assert (= (jit/jit-reset! (mut (.session c))) 0))
    0))
