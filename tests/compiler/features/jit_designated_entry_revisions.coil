(module compiler.features.jit-designated-entry-revisions)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
; A source provider that supplies each submission's own entry and replaces a
; function by rebinding its alias: many accepted revisions in a row, each one
; freeing the source of the version it replaced.
(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))
        (mut failed) 0]
    (when (!= (jit/jit-session-set-source-provider! (mut s) "entry.provider2" "read-source" "" "") 0) (set! failed 99))
    (for i (range 0 6)
      (when (and (= failed 0) (!= (jit/jit-compile! (mut s) "(defn pigment [] (-> i64) 7)") 0))
        (set! failed (+ i 1))))
    (jit/jit-reset! (mut s))
    failed))
