(module compiler.features.meta-suffix-changed-prefix)
(import "coil.primitive" :as p)

(defn generate [] (-> Code)
  `(defn ~(p/syntax->datum `generated) [] (-> i64)
     (let [value 42] value)))

; A semantic transform changes the prefix after definition-time expansion and
; introduces a meta invocation. The old macro environment must not be reused
; merely because the generated suffix contains ordinary declarations.
(defn extend-module [(forms Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (len forms)]
      (let [form (get forms i)]
        (p/code-list-push! out
          (if (and (p/code-list? form)
                   (and (> (len form) 1)
                        (and (= (get form 0) `defn*) (= (get form 1) `main))))
              `(defn* ~(get form 1) [] (-> i64)
                 (p/isub (generated) 42))
              form))))
    (when (= (get forms 0) `compiler.features.meta-suffix-changed-prefix)
      (p/code-list-push! out `(meta (generate)))
      0)
    (p/code-list-done out)))

(defn introduce [(modules Code)] (-> Code)
  (let [out (p/code-list-new)]
    (for [i 0 (len modules)]
      (p/code-list-push! out (extend-module (get modules i))))
    `(do ~@(p/code-list-done out))))
(transform-once introduce)

(defn main [] (-> i64)
  (p/isub (generated) 41))
