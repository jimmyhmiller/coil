(module compiler.features.jit-param-remove-retained)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Signature generations preserve old callers and captured function pointers.
(defn submit [(session (ptr jit/JitSession)) (source (slice u8)) (entry (slice u8))] (-> i64)
  (let [status (jit/jit-compile-with-entry! session source entry)]
    (when (!= status 0) (println "{}" (jit/jit-diagnostic session)) 0)
    status))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (submit (mut session)
        "(import \"coil.repl\")
         (defn damage [(t i64) (amount i64)] (-> i64) (+ t amount))
         (defn old [] (-> i64) (damage 10 20))
         (def saved (fnptr-of damage))"
        "(coil.repl/publish)") 0) 1
      (!= (submit (mut session)
        "(defn damage [(t i64)] (-> i64) (+ t 1))
         (defn coupled [] (-> i64) (damage 10))
         (def saved-one (fnptr-of damage))"
        "(coil.repl/publish)") 0) 2
      (!= (submit (mut session) ""
        "(if (and (= (old) 30) (and (= (call-ptr saved 10 20) 30)
              (and (= (coupled) 11) (= (call-ptr saved-one 10) 11)))) 0 1)") 0) 3
      (!= (submit (mut session)
        "(defn damage [(t i64)] (-> i64) (+ t 2))"
        "(coil.repl/publish)") 0) 4
      (!= (submit (mut session) ""
        "(if (and (= (coupled) 12) (= (call-ptr saved-one 10) 12)) 0 1)") 0) 5
      (!= (submit (mut session)
        "(defn damage [(t i64) (amount i64)] (-> i64) (* t amount))"
        "(coil.repl/publish)") 0) 6
      ; Reclaim superseded implementations before calling retained signatures.
      (< (jit/jit-reclaim-retired! (mut session)) 0) 12
      (!= (submit (mut session) ""
        "(if (and (= (damage 10 20) 200) (and (= (old) 30)
              (and (= (call-ptr saved 10 20) 30) (= (coupled) 12)))) 0 1)") 0) 7
      ; A rejected arity edit must leave the alias and identity registry intact.
      (= (jit/jit-compile-with-entry! (mut session)
        "(defn damage [] (-> i64) missing-value)" "(coil.repl/publish)") 0) 8
      (!= (submit (mut session) "" "(if (= (damage 10 20) 200) 0 1)") 0) 9
      (!= (submit (mut session) "(defn damage [] (-> i64) 99)"
        "(coil.repl/publish)") 0) 10
      (!= (submit (mut session) ""
        "(if (and (= (damage) 99) (and (= (old) 30) (= (coupled) 12))) 0 1)") 0) 11
      :else (jit/jit-session-free! (mut session)))))
