(module ownership_transform_phase_test)
(import "coil.primitive" :as primitive)
(import "coil.rc" :as rc)

(defn managed-use-head? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (primitive/code-eq (primitive/code-nth form 0) `managed-use))))

(defn clone-call? [(form Code)] (-> bool)
  (and (primitive/code-list? form)
       (and (= (primitive/code-count form) 2)
            (primitive/code-eq (primitive/code-nth form 0) `clone))))

(defn ownership-marker-present? [(form Code)] (-> bool)
  (if (managed-use-head? form)
      true
      (if (primitive/code-list? form)
          (ownership-marker-present-kids? form 0 (primitive/code-count form))
          false)))

(defn ownership-marker-present-kids? [(form Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (ownership-marker-present? (primitive/code-nth form i))
          true
          (ownership-marker-present-kids? form (+ i 1) n))))

(defn ownership-rewrite [(form Code)] (-> Code)
  (if (managed-use-head? form)
      (let [owner (primitive/code-nth form 1)]
        (if (clone-call? owner)
            form
            (do
              ; These are the phase contract: the provisional synthesis model
              ; must expose both inferred types and canonical binding identity.
              (if (primitive/code-eq (primitive/type-of owner) `:unknown)
                  (do (primitive/report owner "ownership transform saw no inferred type") 0)
                  0)
              (if (<= (primitive/binding-of owner) 0)
                  (do (primitive/report owner "ownership transform saw no binding identity") 0)
                  0)
              `(managed-use (clone ~owner)))))
      (if (and (primitive/code-list? form) (ownership-marker-present? form))
          `(~@(ownership-rewrite-kids form 0 (primitive/code-count form)))
          form)))

(defn ownership-rewrite-kids [(form Code) (i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      `(~(ownership-rewrite (primitive/code-nth form i)) ~@(ownership-rewrite-kids form (+ i 1) n))))

(defn ownership-pass [(modules Code)] (-> Code)
  `(do ~@(ownership-rewrite-kids modules 0 (primitive/code-count modules))))

(transform ownership-pass :phase ownership)

(defstruct Payload [(answer i64)])

(defn managed-use [(owner (rc/Rc Payload))] (-> i64)
  (.answer (rc/rc-borrow owner)))

(defn main [] (-> i64)
  (match (rc/rc-new (Payload :answer 40))
    (None [] 1)
    (Some [owner]
          (do
            (managed-use owner)
            (+ (managed-use owner) 2)))))
