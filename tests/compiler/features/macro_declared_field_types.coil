(module macro-declared-field-types)
(import "coil.primitive" :as primitive)
(import "coil.assert" :use [assert])
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)

;;; A struct or sum produced by a top-level macro call is an ordinary declaration:
;;; other declarations may name it as a field type, before or after the call, just
;;; as they may forward-reference a hand-written type. The metaprogram closure is
;;; built from a context resolved BEFORE those calls expand, so the context leaves
;;; out the declarations that name a type it does not have yet; kept, they failed
;;; the closure's check as "unknown type" before the macro could run.
(defn mk-struct [(name Code)] (-> Code)
  `(defstruct ~name [(x i64)]))

(defn mk-sum [(name Code) (empty Code) (full Code)] (-> Code)
  `(defsum ~name (~empty) (~full [(x i64)])))

(defn mk-pair [(a Code) (b Code)] (-> Code)
  `(do
     (defstruct ~a [(v i64)])
     (defstruct ~b [(w ~a)])))

;; Named before the macro call that declares it, and through another struct.
(defstruct Outer [(h Holder) (pair (array Holder 2))])

(defstruct Holder [(a Inner) (s (ptr Slot))])

(mk-struct Inner)

(mk-sum Slot Empty Full)

(mk-pair Left Right)

;; Named after the call, through a generic argument and a sum payload.
(defstruct Box [T] [(v T)])

(defstruct Boxed [(b (Box Inner)) (r Right)])

(defsum Either (Has [(o Outer)]) (Lacks))

;; The same through a library macro: defsum-serde declares the sum and derives
;; its impls in one form.
(defstruct Scene [(shape Shape) (n i64)])

(defsum-serde Shape (Point) (Rect [(w i64) (h i64)]))

(defn main [] (-> i64)
  (let [slot (primitive/alloc-stack Slot)
        _ (store! slot (Full :x 5))
        h
          (Holder
            :a (Inner :x 3)
            :s slot)
        o (Outer :h h :pair [h h])
        b
          (Boxed
            :b
              (Box
                :v (Inner :x 4))
            :r
              (Right
                :w (Left :v 6)))
        second (get (.pair o) 1)
        e (Has :o o)
        sc
          (Scene
            :shape (Rect :w 2 :h 5)
            :n 1)]
    (assert (= (.x (.a (.h o))) 3))
    (assert (= (.x (.a second)) 3))
    (assert (match (load (.s h)) (Full [x] (= x 5)) (Empty [] false)))
    (assert (= (.x (.v (.b b))) 4))
    (assert (= (.v (.w (.r b))) 6))
    (assert (match e
              (Has [inner]
                   (let [io inner
                         ih (.h io)]
                     (= (.x (.a ih)) 3)))
              (Lacks [] false)))
    (assert (match (.shape sc) (Rect [w h] (= (+ w h) 7)) (Point [] false)))
    0))
