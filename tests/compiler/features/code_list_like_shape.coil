; `code-list-like` keeps its prototype's shape: rebuilding a vector from a plain
; list of children yields a vector, and a list stays a list.
(module code-list-like-shape)
(import "coil.primitive" :as primitive)

(defn rebuilt [(form Code)] (-> Code)
  (let [(mut kids) (primitive/code-list-new)]
    (for child (iter form) (push! (mut kids) child))
    (primitive/code-list-like form (primitive/code-list-done (load kids)))))

(defn rebuilt-vector? [(form Code)] (-> Code)
  (if (primitive/code-vector? (rebuilt form)) `true `false))

(defn main [] (-> i64)
  (println "{} {}" (rebuilt-vector? [1 2 3]) (rebuilt-vector? (1 2 3)))
  (let [xs (rebuilt [4 5 6])] (println "{}" (len xs)))
  0)
