(module compiler.features.jit-repl-const-eval)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Under the `coil.repl` publish policy a function is a `Var`, a cell that only
;; exists once the program runs, and compile-time code cannot call it. A const
;; initializer or `(comptime …)` form evaluates the submission's own source
;; instead: each published function such a form reaches, transitively, has a plain
;; twin. Macros in those bodies (`let`, `cond`, `when`), a generic callee, and a
;; constant used by a later submission all work; a later redefinition changes what
;; the program runs and leaves the constant as it was folded.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cc.m)
         (import \"coil.repl\")
         (defn ident [T] [(x T)] (-> T) (let [y x] y))
         (defn hook [] (-> i64) 1)
         (defn step [(n i64)] (-> i64)
           (cond (> n 0) (+ (hook) (ident n)) :else 0))
         (defn build [] (-> i64)
           (let [p 40]
             (when (> p 0) (+ (step p) 8))))
         (const TABLE (build))
         (defn viacomptime [] (-> i64) (comptime (build)))"
        "(coil.repl/publish)") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cc.m)"
        "(if (and (= cc.m.TABLE 49) (= (cc.m.viacomptime) 49) (= (cc.m.build) 49)) 0 1)") 0) 2
      ; Redefine a function the constant reached. The runtime follows the Var, the
      ; constant keeps the value it was folded to.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cc.m)
         (defn hook [] (-> i64) 2)"
        "(coil.repl/publish)") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cc.m)"
        "(if (and (= cc.m.TABLE 49) (= (cc.m.build) 50)) 0 1)") 0) 4
      :else (jit/jit-reset! (mut session)))))
