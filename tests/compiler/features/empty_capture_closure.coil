(module empty-capture-closure)
(import "coil.primitive" :as primitive)
(import "coil.closure" :use *)

; An empty environment must support the same lifetime as a captured one.
(defclosure callback [] [] void (do))

; With parameters, an empty closure is called directly, through Callable, and
; after its code is replaced, exactly as a capturing closure is.
(defclosure doubler [] [(x i64)] i64 (* 2 x))

; A replacement has the same checked signature, environment argument included.
(defn tripler [(env (ptr doubler-env)) (x i64)] (-> i64)
  (* 3 x))

(defn main [] (-> i64)
  (let [f (callback-new)]
    (callback-call f)
    (callback-free f))
  (let [a (doubler-new)
        b (doubler-new)]
    (assert (= (doubler-call a 5) 10))
    (assert (= (a 6) 12))
    (doubler-set-code! b (primitive/fnptr-of tripler))
    (assert (= (b 5) 15))
    ; Replacing one instance's code leaves the other alone.
    (assert (= (a 5) 10))
    (doubler-free a)
    (doubler-free b))
  0)
