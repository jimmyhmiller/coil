(module compiler.features.jit-single-form-proof)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.primitive" :as primitive)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (if (!= (jit/jit-compile! (mut session)
                              "(module proof.sdk)
        (import \"coil.primitive\" :as primitive)
        (defn once [] (-> Code)
          (if (= (primitive/code-int (primitive/code-session-state `0)) 0)
              (do (primitive/code-session-stage! `1) `42)
              (primitive/error \"an accepted macro invocation was replayed\")))
        (defn original [] (-> i64) (once))
        (export-c [original :as \"proof_original\"])")
            0)
        1
        (let [before (jit/jit-symbol-address (mut session) "proof_original")]
          (cond (= (primitive/cast i64 before) 0) 2
                (!= (jit/jit-compile-with-entry! (mut session)
                                                 "(defn later [] (-> i64) (+ (original) 1))"
                                                 "(if (= (later) 43) 0 90)")
                    0)
                  3
                (!= (primitive/cast i64 before)
                    (primitive/cast i64
                                    (jit/jit-symbol-address (mut session)
                                                            "proof_original")))
                  4
                (!= (primitive/call-ptr (primitive/cast (fnptr c [] i64) before))
                    42)
                  5
                :else (jit/jit-reset! (mut session)))))))
