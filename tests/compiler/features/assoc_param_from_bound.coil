;; An impl parameter the receiver does not determine (`From`, reachable only
;; through the associated `Old`) is fixed by the associated type a bounded
;; generic caller states (coil-bugs c45ks3w56ug).
(module assoc-param-from-bound)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new al-free!])

(deftrait Migration [Self Old]
  (migrate-value [(next (mut Self)) (old (ref Old))] (-> i64)))

(defstruct OldRecord [(v i64)])
(defstruct NewRecord [(v i64)])

(impl [From New] Migration (ArrayList New)
  (migrate-value [(next (mut (ArrayList New))) (old (ref (ArrayList From)))] (-> i64)
    (+ (* 10 (len next)) (len old))))

(defn migrate! [Old (New (Migration Old))] [(next (mut New)) (old (ref Old))] (-> i64)
  (migrate-value (mut next) old))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut old) (al-new [OldRecord] a)
        (mut new) (al-new [NewRecord] a)]
    (push! (mut old) (OldRecord :v 1))
    (push! (mut old) (OldRecord :v 2))
    (push! (mut new) (NewRecord :v 3))
    (println "direct {}" (migrate-value (mut new) old))
    (println "bounded {}" (migrate! [(ArrayList OldRecord) (ArrayList NewRecord)] (mut new) old))
    (al-free! (mut old))
    (al-free! (mut new))
    0))
