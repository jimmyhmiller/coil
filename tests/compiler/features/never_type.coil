(module never-type)

; `never` is the return type of a function that does not return. A call of one
; has every type, so it stands where a value of any type is wanted.

(extern abort :cc c [] (-> never))

(defn die [(why (slice u8))] (-> never)
  (println "dying: {}" why)
  (abort))

(defn checked-div [(a i64) (b i64)] (-> i64)
  (if (= b 0) (die "division by zero") (/ a b)))

(defsum Shape (Circle [(r i64)]) (Square [(s i64)]) (Line))

(defn area [(s Shape)] (-> i64)
  (match s
    (Circle [r] (* 3 (* r r)))
    (Square [s] (* s s))
    (Line [] (die "a line has no area"))))

(defn name-of [(n i64)] (-> (slice u8))
  (cond (= n 0) "zero" (= n 1) "one" :else (die "too big")))

; A function pointer to a function that does not return; calling it is never.
(defn guarded [(fail (fnptr c [(slice u8)] never)) (ok bool) (v i64)] (-> i64)
  (if ok v (fail "guard")))

(deftrait Explode [Self] (explode [(x Self)] (-> never)))
(defstruct Bomb [(fuse i64)])
(impl Explode Bomb (explode [(b Bomb)] (-> never) (die "bomb")))

(defn first-even [(xs (slice i64))] (-> i64)
  (block :found
    (for x xs (when (= (% x 2) 0) (return-from :found x)))
    (die "no even number")))

(defn main [(argc i32)] (-> i64)
  (println "{} {} {} {}" (checked-div 9 3) (area (Circle :r 2)) (area (Square :s 3)) (name-of 1))
  (println "{} {}" (guarded (fnptr-of die) true 7) (first-even [3 5 8 9]))
  (let [b (if (> argc 0) 1 (explode (Bomb :fuse 1)))]
    (println "{}" b))
  0)
