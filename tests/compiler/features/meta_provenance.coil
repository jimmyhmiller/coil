(module meta_provenance)
(import "coil.primitive" :as p)
(import "coil.meta" :use [user-forms])

;;; `primitive/code-alias-of` names the `defalias` a reference goes through, and
;;; `primitive/code-macro-of` the macro whose expansion produced a node. The
;;; probes below are calls the checker asks about.

(defn area-v1 [(w i64) (h i64)] (-> i64) (* w h))
(defalias area area-v1)
(const K-1 3)
(defalias K K-1)

(defn probe-m [(n i64)] (-> i64) n)
(defn wrap [(c Code)] (-> Code) `(probe-m ~c))

(defn through-alias [] (-> i64) (area 2 3))
(defn direct [] (-> i64) (area-v1 2 3))
(defn constant-through-alias [] (-> i64) (+ K 0))
(defn under-a-local [] (-> i64) (let [area 1] (+ area 0)))
(defn expanded [] (-> i64) (wrap (direct)))

(defn head? [(f Code) (name (slice u8))] (-> bool)
  (and (p/code-list? f)
       (and (not (p/code-vector? f))
            (and (> (len f) 0)
                 (and (p/code-sym? (get f 0)) (= (p/code-sym (get f 0)) name))))))

(defn expect [(got Code) (want Code) (what (slice u8))] (-> i64)
  (unless (= got want) (p/error what) 0)
  0)

(defn verify-at [(f Code) (seen (ptr i64))] (-> i64)
  (when (head? f "area")
    (expect (p/code-alias-of f) `meta_provenance.area "a call through an alias names the alias")
    (expect (get (p/code-decl f) 3) `meta_provenance.area-v1 "code-decl answers the declaration it leads to")
    (expect (p/code-alias-of (get f 0)) `:unknown "a call head is asked about through its call")
    (expect (p/code-macro-of f) `:none "hand-written")
    (set! seen (+ (load seen) 1))
    0)
  (when (head? f "area-v1")
    (expect (p/code-alias-of f) `:none "a direct call goes through no alias")
    (set! seen (+ (load seen) 1))
    0)
  (when (and (head? f "+") (and (p/code-sym? (get f 1)) (= (p/code-sym (get f 1)) "K")))
    (expect (p/code-alias-of (get f 1)) `meta_provenance.K "a constant through an alias")
    (set! seen (+ (load seen) 1))
    0)
  (when (and (head? f "+") (and (p/code-sym? (get f 1)) (= (p/code-sym (get f 1)) "area")))
    (expect (p/code-alias-of (get f 1)) `:none "a local of the alias's name is not the alias")
    (set! seen (+ (load seen) 1))
    0)
  ; `wrap`'s own template is written by hand; the call its expansion produced is not.
  (when (and (head? f "probe-m") (not (head? (get f 1) "unquote")))
    (expect (p/code-macro-of f) `meta_provenance.wrap "the macro that produced the call")
    (expect (p/code-macro-of (get f 1)) `:none "its argument was written by hand")
    (set! seen (+ (load seen) 1))
    0)
  (when (p/code-list? f)
    (for child f (verify-at child seen)))
  0)

(defn verify [(modules Code)] (-> Code)
  (let [(mut seen) 0]
    (for form (user-forms modules) (verify-at form (mut seen)))
    (unless (= seen 5) (p/error "a probe was not found") 0))
  `0)
(checker verify)

(defn main [] (-> i64)
  (+ (through-alias) (+ (direct) (+ (constant-through-alias) (+ (under-a-local) (expanded))))))
