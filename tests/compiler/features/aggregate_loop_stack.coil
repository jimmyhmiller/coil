(module tests.compiler.features.aggregate_loop_stack)

(import "coil.alloc" :use *)

(defstruct AggregateLoopDescriptor
  [(inputs i64)
   (outputs i64)
   (temporaries i64)
   (clobbers i64)
   (effects i64)
   (pinned bool)
   (memory bool)
   (encodable bool)])

(defn aggregate-loop-descriptor-new [(value i64)] (-> AggregateLoopDescriptor)
  (let [descriptor (stack AggregateLoopDescriptor)]
    (store! (field descriptor inputs) value)
    (store! (field descriptor outputs) 1)
    (store! (field descriptor temporaries) 0)
    (store! (field descriptor clobbers) 0)
    (store! (field descriptor effects) 0)
    (store! (field descriptor pinned) false)
    (store! (field descriptor memory) false)
    (store! (field descriptor encodable) true)
    (load descriptor)))

(defn aggregate-loop-descriptor [(opcode i64)] (-> AggregateLoopDescriptor)
  (case opcode 0
        (aggregate-loop-descriptor-new 0) 1
        (aggregate-loop-descriptor-new 2) 2
        (aggregate-loop-descriptor-new 1) (aggregate-loop-descriptor-new -1)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) 1000000)
              (break)
              (let [value (aggregate-loop-descriptor 0)]
                (if (!= (load (field value inputs)) 0)
                    (break)
                    0)
                (store! index (+ (load index) 1)))))
    (if (= (load index) 1000000) 0 1)))
