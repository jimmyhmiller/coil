(module tests.compiler.features.aggregate_loop_stack)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(import "coil.alloc" :use *)

(defstruct AggregateLoopDescriptor
  [(inputs i64)
   (outputs i64)
   (temporaries i64)
   (clobbers i64)
   (effects i64)
   (pinned bool)
   (memory bool)
   (encodable bool)])

(defn aggregate-loop-descriptor-new [(value i64)] (-> AggregateLoopDescriptor)
  (let [descriptor (primitive/alloc-stack AggregateLoopDescriptor)]
    (set! (.inputs descriptor) value)
    (set! (.outputs descriptor) 1)
    (set! (.temporaries descriptor) 0)
    (set! (.clobbers descriptor) 0)
    (set! (.effects descriptor) 0)
    (set! (.pinned descriptor) false)
    (set! (.memory descriptor) false)
    (set! (.encodable descriptor) true)
    (load descriptor)))

(defn aggregate-loop-descriptor [(opcode i64)] (-> AggregateLoopDescriptor)
  (case opcode 0
        (aggregate-loop-descriptor-new 0) 1
        (aggregate-loop-descriptor-new 2) 2
        (aggregate-loop-descriptor-new 1) (aggregate-loop-descriptor-new -1)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [(mut index) 0]
    (loop (if (>= (load index) 1000000)
              (break)
              (let [value (aggregate-loop-descriptor 0)]
                (if (!= (.inputs value) 0)
                    (break)
                    0)
                (set! index (+ (load index) 1)))))
    (if (= (load index) 1000000) 0 1)))
