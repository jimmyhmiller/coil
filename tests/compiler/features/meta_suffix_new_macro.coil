(module compiler.features.meta-suffix-new-macro)
(import "coil.primitive" :as p)

; A generated Code definition changes the macro universe, so its callers must
; enter the definition-time tower rather than reuse the old checked closure.
(defn generate [] (-> Code)
  `(do
     (defn ~(p/syntax->datum `fresh) [(x Code)] (-> Code) x)
     (defn ~(p/syntax->datum `generated) [] (-> i64)
       (~(p/syntax->datum `fresh) (+ 20 22)))))
(meta (generate))

(defn main [] (-> i64)
  (if (= (generated) 42) 0 1))
