(module tail-borrowed-temporary)

(defstruct Packet [(remaining i64) (value i64) (label (slice u8))])

(defn walk [(packet Packet)] (-> (slice u8))
  (if (= (.remaining packet) 0)
      (.label packet)
      (walk (Packet
              :remaining (- (.remaining packet) 1)
              :value (+ (.value packet) 1)
              :label (.label packet)))))

(defn spin [(n i64)] (-> i64)
  (if (= n 0) 0 (spin (- n 1))))

(defn main [] (-> i64)
  (if (and (= (walk (Packet
                      :remaining 40
                      :value 0
                      :label "retained"))
              "retained")
           (= (spin 100000) 0))
      0
      1))
