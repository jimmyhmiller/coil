(module test.simd-resize)
(import "coil.simd" :as v)

(defn main [] (-> i64)
  (let [bytes (v/viota [u8 16])
        low (: (v/vwiden-low bytes) (vec u16 8))
        high (: (v/vwiden-high bytes) (vec u16 8))
        joined (: (v/vnarrow low high) (vec u8 16))]
    (for [i 0 8]
      (assert-eq (v/vextract low i) (cast u16 i))
      (assert-eq (v/vextract high i) (cast u16 (+ i 8))))
    (assert (v/mask-all? (v/v= bytes joined)))
    (let [negative (v/vsplat [i16 8] -999)
          positive (v/vsplat [i16 8] 999)
          signed (: (v/vnarrow-saturating negative positive) (vec i8 16))
          unsigned (: (v/vnarrow-saturating negative positive) (vec u8 16))]
      (assert-eq (v/vextract signed 0) (cast i8 -128))
      (assert-eq (v/vextract signed 15) (cast i8 127))
      (assert-eq (v/vextract unsigned 0) (cast u8 0))
      (assert-eq (v/vextract unsigned 15) (cast u8 255)))
    (let [a (v/viota [i32 3]) b (v/vsplat [i32 3] 99)
          zipped (v/vzip a b)
          unzipped (v/vunzip (.low zipped) (.high zipped))]
      (assert (v/mask-all? (v/v= (.low unzipped) a)))
      (assert (v/mask-all? (v/v= (.high unzipped) b))))
    (let [row (v/viota [i32 4])
          matrix (v/vtranspose4 row (v/vadd row (v/vsplat [i32 4] 4))
                                    (v/vadd row (v/vsplat [i32 4] 8))
                                    (v/vadd row (v/vsplat [i32 4] 12)))]
      (for [i 0 4]
        (assert-eq (v/vextract (.a matrix) i) (cast i32 (* i 4)))
        (assert-eq (v/vextract (.b matrix) i) (cast i32 (+ (* i 4) 1)))
        (assert-eq (v/vextract (.c matrix) i) (cast i32 (+ (* i 4) 2)))
        (assert-eq (v/vextract (.d matrix) i) (cast i32 (+ (* i 4) 3)))))
    0))
