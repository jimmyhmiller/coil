(module feature.parameterized-bound)

(defstruct I64Iter [(value i64)])

(impl Iterator I64Iter
  (next [(it (mut I64Iter))]
        (-> (Option i64))
        (Some (.value it))))

(impl Iterable I64Iter
  (iter [(it I64Iter)] (-> I64Iter) it))

(defn next-i64 [(I (Iterator i64))] [(source I)] (-> (Option i64))
  (let [(mut it) source]
    (next (mut it))))

(defn make-iterator [(C (Iterable I)) I] [(source C)] (-> I)
  (iter source))

; Named constructors are checked and then lowered into declaration order. The
; internal deferred trait call must retain the bound's explicit associated type
; when the lowered constructor is checked again.
(defstruct IteratorBox [I] [(iterator I)])

(defn box-iterator [(C (Iterable I)) (I (Iterator i64))]
  [(source C)]
  (-> (IteratorBox I))
  (IteratorBox :iterator (iter source)))

(defn main [] (-> i64)
  (let [it (I64Iter :value 42)
        made (make-iterator it)
        boxed (box-iterator made)]
    (match (next-i64 (.iterator boxed))
      (Some [value] value)
      (None [] 1))))
