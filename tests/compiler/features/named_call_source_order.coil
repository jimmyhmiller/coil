(module named-call-source-order)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.var" :use [var-static])

(defstruct Pair [(a i64) (b i64)])

(defsum Duo (DuoValue [(a i64) (b i64)]))

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn mark [(digit i64)] (-> i64)
  (store! (counter) (+ (* (load (counter)) 10) digit))
  digit)

(defn combine [(a i64) (b i64)] (-> i64)
  (+ (* a 10) b))

; A callable value has no signature; `:params` names its parameters so a named
; call orders its arguments as it would for `combine` itself.
(def combine-var :params [:a :b]
  (var-static (fnptr c [i64 i64] i64) (primitive/fnptr-of combine)))

(defn choose-first [T] [(first T) (second T)] (-> T)
  first)

(defn keyword-name [(k Keyword)] (-> (slice u8))
  (match k (KeywordValue [name] name)))

(defn main [] (-> i64)
  (block :fail
         (store! (counter) 0)
         (let [p (Pair :b (mark 2) :a (mark 1))]
           (when (not (= (load (counter)) 21)) (return-from :fail 1))
           (when (not (= (load (field p a)) 1)) (return-from :fail 2))
           (when (not (= (load (field p b)) 2)) (return-from :fail 3)))
         (let [d (DuoValue :b (mark 4) :a (mark 3))]
           (when (not (= (load (counter)) 2143)) (return-from :fail 4))
           (match d
             (DuoValue [a b]
                       (when (or (not (= a 3)) (not (= b 4)))
                         (return-from :fail 5)))))
         (when (not (= (combine :b (mark 6) :a (mark 5)) 56))
           (return-from :fail 6))
         (when (not (= (load (counter)) 214365)) (return-from :fail 7))
         (store! (counter) 0)
         (when (not (= (combine-var :b (mark 8) :a (mark 7)) 78))
           (return-from :fail 10))
         (when (not (= (load (counter)) 87)) (return-from :fail 11))
         (when (not (= (combine-var :a 1 :b 2) 12)) (return-from :fail 12))
         (when (not (= (choose-first :second 9 :first 7) 7))
           (return-from :fail 8))
         ; A grouped/ascribed keyword remains an ordinary positional value.
         (when (not (= (keyword-name (: :hot Keyword)) "hot"))
           (return-from :fail 9))
         0))
