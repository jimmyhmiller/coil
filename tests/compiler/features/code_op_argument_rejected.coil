(module code-op-argument-rejected)
(import "coil.primitive" :as primitive)
; code-line is an integer, and code-int? reads a node: the compiled engine used to
; read the integer as a node and crash.
(defn probe [(f Code)] (-> bool)
  (primitive/code-int? (primitive/code-line f)))
(defn main [] (-> i64) 0)
