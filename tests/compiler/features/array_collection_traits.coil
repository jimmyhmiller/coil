(module array-collection-traits)

; A fixed `(array T N)` carries no impls of its own — Coil has no const generics,
; so `impl [T N] Iterable (array T N)` is not expressible. It BORROWS as a slice,
; and that borrow now reaches trait dispatch, generic bounds, and inference, so an
; array participates in the ordinary collection vocabulary.
(import "coil.assert" :use *)
(import "coil.iter" :as it)
(import "coil.primitive" :as primitive)

(defstruct Point [(x i64) (y i64)])

(defn dbl [(n i64)] (-> i64)
  (* n 2))

(defn add [(x i64) (y i64)] (-> i64)
  (+ x y))

(defn big? [(n i64)] (-> bool)
  (> n 2))

(defn sum-slice [(xs (slice i64))] (-> i64)
  (let [(mut total) 0]
    (for x (iter xs) (store! total (+ (load total) x)))
    (load total)))

(defn point-x [(p Point)] (-> i64)
  (.x p))

; Method dispatch peels a pointer that carries no impl of its own, so a raw
; `(ptr (array T N))` — `slice-of`'s own argument shape — borrows the same way.
(defn sum-ptr [(q (ptr (array i64 3)))] (-> i64)
  (let [(mut t) 0]
    (for x (iter q) (store! t (+ (load t) x)))
    (+ (load t) (len q))))

(defn main [] (-> i64)
  ; Len/Get/Iterable on an array PLACE: a named `let` of array type has type
  ; `(ref (array T N))`, which is the shape the borrow has to see through.
  (let [xs [10 20 12]]
    (assert-eq (len xs) 3)
    (assert-eq (get xs 1) 20)
    (let [(mut total) 0]
      (for x (iter xs) (store! total (+ (load total) x)))
      (assert-eq (load total) 42))
    ; A `(slice T)` parameter takes the array place directly.
    (assert-eq (sum-slice xs) 42))
  ; …and an array RVALUE, which is spilled into the frame first.
  (assert-eq (sum-slice [1 2 3]) 6)
  (assert-eq (len [1 2 3 4]) 4)
  ; Set writes through to the array itself, not to a copy.
  (let [(mut ys) [1 2 3]]
    (set! (mut ys) 0 99)
    (assert-eq (get ys 0) 99)
    (assert-eq (load (index ys 0)) 99))
  ; Bounded generics: `(C (Iterable I))` binds C to the slice, so coil.iter's
  ; adapters and consumers accept an array source.
  (let [zs [1 2 3 4 5]]
    (assert-eq (it/count zs) 5)
    (assert-eq (it/fold (primitive/fnptr-of add) 0 zs) 15)
    (assert (it/any? (primitive/fnptr-of big?) zs))
    (assert-eq (it/fold (primitive/fnptr-of add)
                        0
                        (it/map (primitive/fnptr-of dbl) zs))
               30)
    (assert-eq (it/count (it/filter (primitive/fnptr-of big?) zs)) 3)
    (assert-eq (it/count (it/take 2 zs)) 2))
  (let [(mut ptr-src) [1 2 3]]
    (assert-eq (sum-ptr (mut ptr-src)) 9))
  ; Aggregate elements iterate by value like any other slice element.
  (let [ps [(Point :x 1 :y 2) (Point :x 3 :y 4)]
        (mut sum) 0]
    (for p (iter ps) (store! sum (+ (load sum) (point-x p))))
    (assert-eq (load sum) 4))
  0)
