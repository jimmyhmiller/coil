; Runtime `def`s whose initializers are string and keyword literals, and a sum
; wrapping them: all link-time constants.
(module def-string-keyword)

(defsum Greeting (Plain [(text (slice u8))]) (Tagged [(tag Keyword) (text (slice u8))]))

(def greeting "hello")
(def mode :fast)
(def empty "")
(def tagged (Tagged :tag :loud :text "hi"))

(defn keyword-name [(k Keyword)] (-> (slice u8))
  (match k (KeywordValue [name] name)))

(defn main [] (-> i64)
  (println "{} {} [{}] {}" greeting (len greeting) empty (keyword-name mode))
  (match tagged
    (Tagged [tag text] (println "{} {}" (keyword-name tag) text))
    (Plain [text] (println "{}" text)))
  0)
