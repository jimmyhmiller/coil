; Sums of each payload width the C ABI treats differently: no payload, one and two
; words (registers), three and eight words (a hidden result pointer), and a
; two-word payload holding a float, which is still integer data.
(module sum-return-abi-types)

(defsum S0 (Z0 []) (O0 []))
(defsum S1 (P1 [(a i64)]) (N1 []))
(defsum S2 (P2 [(a i64) (b i64)]) (N2 []))
(defsum S3 (P3 [(a i64) (b i64) (c i64)]) (N3 []))
(defsum S8 (P8 [(a i64) (b i64) (c i64) (d i64) (e i64) (f i64) (g i64) (h i64)]) (N8 []))
(defsum SF (PF [(x f64) (n i32)]) (NF []))

(defn d0 [(s S0)] (-> i64) (match s (Z0 [] 5) (O0 [] 6)))
(defn d1 [(s S1)] (-> i64) (match s (P1 [a] a) (N1 [] -1)))
(defn d2 [(s S2)] (-> i64) (match s (P2 [a b] (+ a (* 10 b))) (N2 [] -1)))
(defn d3 [(s S3)] (-> i64) (match s (P3 [a b c] (+ a (* 10 b) (* 100 c))) (N3 [] -1)))
(defn d8 [(s S8)] (-> i64)
  (match s (P8 [a b c d e f g h] (+ a b c d e f g (* 1000 h))) (N8 [] -1)))
(defn df [(s SF)] (-> i64) (match s (PF [x n] (+ (cast i64 (* x 4.0)) (cast i64 n))) (NF [] -1)))
