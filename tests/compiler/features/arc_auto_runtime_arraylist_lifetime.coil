(module arc_auto_runtime_arraylist_lifetime)
(import "coil.arraylist" :use *)
(import "coil.arc.auto-runtime" :as runtime)

(defn exercise [] (-> i64)
  (let [(mut first) (al-new [i64])
        (mut second) first]
    (al-push! [i64] (mut first) 19)
    (al-push! [i64] (mut second) 23)
    (+ (al-get [i64] first 0) (al-get [i64] second 1))))

(defn main [] (-> i64)
  (if (!= (runtime/auto-arraylist-live-count) 0)
      1
      (let [answer (exercise)]
        (if (!= (runtime/auto-arraylist-live-count) 0)
            2
            answer))))
