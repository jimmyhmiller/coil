(module tests.integer-intrinsics)
(import "coil.primitive" :as primitive)
(import "coil.integer" :as integer)

(defn main [] (-> i64)
  (do
    (assert (= (primitive/clz (primitive/cast u64 0)) (primitive/cast u64 64)))
    (assert (= (primitive/ctz (primitive/cast u64 0)) (primitive/cast u64 64)))
    (assert (= (primitive/popcount (primitive/cast u64 0xf0f0)) (primitive/cast u64 8)))
    (assert (= (primitive/bswap (primitive/cast u32 0x11223344)) (primitive/cast u32 0x44332211)))
    (assert (= (primitive/rotl (primitive/cast u32 0x12345678) (primitive/cast u32 8))
               (primitive/cast u32 0x34567812)))
    (assert (= (primitive/rotr (primitive/cast u32 0x12345678) (primitive/cast u32 8))
               (primitive/cast u32 0x78123456)))
    (assert (= (primitive/mulhi (primitive/cast u64 -1) (primitive/cast u64 2))
               (primitive/cast u64 1)))
    (assert (= (primitive/mulhi (primitive/cast i64 -2) (primitive/cast i64 3)) -1))
    (assert (primitive/iadd-overflow? (primitive/cast u8 255) (primitive/cast u8 1)))
    (assert (primitive/isub-overflow? (primitive/cast u8 0) (primitive/cast u8 1)))
    (assert (primitive/imul-overflow? (primitive/cast i8 100) (primitive/cast i8 2)))
    (assert (not (primitive/imul-overflow? (primitive/cast i8 10) (primitive/cast i8 2))))
    (let [r (integer/overflowing-add (primitive/cast u8 255) (primitive/cast u8 1))]
      (assert (= (load (field r value)) (primitive/cast u8 0)))
      (assert (load (field r overflow))))
    0))
