; Refer control — Clojure's `:refer-clojure :exclude/:only/:rename` for Coil.
;
; Every module refers all of `coil.core` implicitly; an explicit `(import "coil.core" …)`
; REPLACES that default. `:exclude` and `:rename` work on any import, not just core.
; The negative half of this feature (an excluded name really being gone, on all four
; surfaces) lives in the `refer_*_rejected.coil` fixtures.
(module refer-control)
(import "coil.core" :use * :exclude [empty?])
(import "coil.assert" :use [assert])
(import "coil.primitive" :as primitive)
(import "coil.slice" :use * :rename [[slice-len sl-count]])

; core's `empty?` is excluded, so this name is ours — no collision, no shadowing warning.
(defn empty? [(n i64)] (-> bool) (= n 0))

(defn main [] (-> i64)
  (assert (empty? 0))
  (assert (not (empty? 7)))
  ; `:rename` refers the target's export under a new local name…
  (assert (= (sl-count "abc") 3))
  ; …and everything core still refers is untouched: operators, macros, Option/Result.
  (assert (< 1 2))
  (assert (= (+ 20 22) 42))
  (when true (assert true))
  (match (Some 42) (Some [v] (assert (= v 42))) (None [] (assert false)))
  0)
