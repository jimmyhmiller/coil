(module typed-narrow-integer-consts)
(import "coil.primitive" :as primitive)

(const C-U8 u8 5)

(const C-I8 i8 -6)

(const C-U16 u16 700)

(const C-I16 i16 -701)

(const C-U32 u32 70000)

(const C-I32 i32 -70001)

(const C-U64 u64 700000)

(defn u8-ok [(v u8)] (-> bool)
  (= v C-U8))

(defn i8-ok [(v i8)] (-> bool)
  (= v C-I8))

(defn u16-ok [(v u16)] (-> bool)
  (= v C-U16))

(defn i16-ok [(v i16)] (-> bool)
  (= v C-I16))

(defn u32-ok [(v u32)] (-> bool)
  (= v C-U32))

(defn i32-ok [(v i32)] (-> bool)
  (= v C-I32))

(defn u64-ok [(v u64)] (-> bool)
  (= v C-U64))

(defn main [] (-> i64)
  (if (and (u8-ok (primitive/cast u8 5))
           (i8-ok (primitive/cast i8 -6))
           (u16-ok (primitive/cast u16 700))
           (i16-ok (primitive/cast i16 -701))
           (u32-ok (primitive/cast u32 70000))
           (i32-ok (primitive/cast i32 -70001))
           (u64-ok (primitive/cast u64 700000)))
      0
      1))
