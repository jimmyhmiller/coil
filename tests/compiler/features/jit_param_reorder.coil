(module compiler.features.jit-param-reorder)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Reordering published parameters must accept the new interface while preserving
; the old interface and behavior for callers and function pointers already bound.
; Uses the host JIT backend: LLVM on Linux, Native on macOS arm64.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        initial (jit/jit-compile-with-entry! (mut session)
          "(import \"coil.repl\")
           (defn damage [(target i64) (amount f32)] (-> i64)
             (+ (* target 100) (cast i64 amount)))
           (defn old-caller [] (-> i64) (damage 7 (cast f32 3)))
           (def saved (fnptr-of damage))
           (defn old-pointer [] (-> i64) (saved 7 (cast f32 3)))"
          "(coil.repl/publish)")]
    (println "initial status: {}" initial)
    (cond
      (!= initial 0) (do (jit/jit-session-free! (mut session)) 1)
      (!= (jit/jit-compile-with-entry! (mut session) ""
            "(if (and (= (old-caller) 703) (= (old-pointer) 703)) 0 1)") 0)
        (do (jit/jit-session-free! (mut session)) 2)
      :else
        (let [replacement (jit/jit-compile-with-entry! (mut session)
                "(defn damage [(amount f32) (target i64)] (-> i64)
                   (+ 1000 (+ (* target 100) (cast i64 amount))))"
                "(coil.repl/publish)")]
          (println "replacement status: {}" replacement)
          (if (!= replacement 0)
            (do (println "{}" (jit/jit-diagnostic (mut session)))
                (jit/jit-session-free! (mut session)) 3)
            (let [updated (jit/jit-compile-with-entry! (mut session)
                    "(defn new-caller [] (-> i64) (damage (cast f32 3) 7))
                     (def new-saved (fnptr-of damage))
                     (defn new-pointer [] (-> i64) (new-saved (cast f32 3) 7))"
                    "(coil.repl/publish)")
                  behavior (if (= updated 0)
                    (jit/jit-compile-with-entry! (mut session) ""
                      "(if (and (= (old-caller) 703) (= (old-pointer) 703)
                                (= (new-caller) 1703) (= (new-pointer) 1703)) 0 1)")
                    1)]
              (println "updated callers status: {}, behavior status: {}" updated behavior)
              (jit/jit-session-free! (mut session))
              (if (and (= updated 0) (= behavior 0)) 0 4)))))))
