; By-value aggregates whose size is not a multiple of 8 cross every call path
; intact: direct and generic calls, function pointers, returns, and generic
; containers. A 12-byte struct is coerced to [2 x i64]; the callee must not
; store those 16 bytes into a 12-byte slot (that was UB, and -O2 read the last
; field back as 0).
(module aggregate-abi-sizes)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free!])

(defstruct B3 [(a u8) (b u8) (c u8)])
(defstruct H6 [(a i16) (b i16) (c i16)])
(defstruct W12 [(a i32) (b i32) (c i32)])
(defstruct M10 [(a i64) (b u16)])
(defstruct W20 [(a i32) (b i32) (c i32) (d i32) (e i32)])
(defstruct F12 [(a f32) (b f32) (c f32)])
(defstruct A7 [(bytes (array u8 7))])

(defn b3-sum [(v B3)] (-> i64) (+ (cast i64 (.a v)) (cast i64 (.b v)) (cast i64 (.c v))))
(defn h6-sum [(v H6)] (-> i64) (+ (cast i64 (.a v)) (cast i64 (.b v)) (cast i64 (.c v))))
(defn w12-sum [(v W12)] (-> i64) (+ (cast i64 (.a v)) (cast i64 (.b v)) (cast i64 (.c v))))
(defn m10-sum [(v M10)] (-> i64) (+ (.a v) (cast i64 (.b v))))
(defn w20-sum [(v W20)] (-> i64)
  (+ (cast i64 (.a v)) (cast i64 (.b v)) (cast i64 (.c v)) (cast i64 (.d v)) (cast i64 (.e v))))
(defn f12-sum [(v F12)] (-> i64) (cast i64 (+ (.a v) (.b v) (.c v))))
(defn a7-sum [(v A7)] (-> i64)
  (let [(mut t) 0] (for b (.bytes v) (set! t (+ t (cast i64 b)))) t))

(defn make-w12 [(n i32)] (-> W12) (W12 :a n :b (+ n (: 1 i32)) :c (+ n (: 2 i32))))
(defn make-b3 [(n u8)] (-> B3) (B3 :a n :b (+ n (: 1 u8)) :c (+ n (: 2 u8))))
(defn pass-through [T] [(v T)] (-> T) v)

(defn check [(label (slice u8)) (got i64) (want i64)] (-> i64)
  (if (= got want)
      0
      (do (println "FAIL {}: got {} want {}" label got want) 1)))

(defn main [] (-> i64)
  (let [w (W12 :a 1 :b 2 :c 40)
        (mut fails) 0]
    (set! fails (+ fails (check "b3 direct" (b3-sum (B3 :a 1 :b 2 :c 3)) 6)))
    (set! fails (+ fails (check "h6 direct" (h6-sum (H6 :a 100 :b 200 :c 300)) 600)))
    (set! fails (+ fails (check "w12 direct" (w12-sum w) 43)))
    (set! fails (+ fails (check "m10 direct" (m10-sum (M10 :a 1000 :b 7)) 1007)))
    (set! fails (+ fails (check "w20 direct" (w20-sum (W20 :a 1 :b 2 :c 3 :d 4 :e 5)) 15)))
    (set! fails (+ fails (check "f12 direct" (f12-sum (F12 :a 1.0 :b 2.0 :c 4.0)) 7)))
    (set! fails (+ fails (check "a7 direct" (a7-sum (A7 :bytes [1 2 3 4 5 6 7])) 28)))
    (set! fails (+ fails (check "w12 generic" (w12-sum (pass-through w)) 43)))
    (set! fails (+ fails (check "b3 generic" (b3-sum (pass-through (B3 :a 4 :b 5 :c 6))) 15)))
    (set! fails (+ fails (check "w12 return" (w12-sum (make-w12 10)) 33)))
    (set! fails (+ fails (check "b3 return" (b3-sum (make-b3 (: 10 u8))) 33)))
    (let [f (fnptr-of w12-sum)
          g (fnptr-of make-w12)]
      (set! fails (+ fails (check "w12 fnptr arg" (f w) 43)))
      (set! fails (+ fails (check "w12 fnptr ret" (w12-sum (g 20)) 63))))
    (let [(mut xs) (al-new [W12] (malloc-allocator))
          (mut total) 0]
      (for i (range 0 4) (push! (mut xs) (make-w12 (cast i32 i))))
      (for x xs (set! total (+ total (cast i64 (.c x)))))
      (set! fails (+ fails (check "w12 arraylist" total 14)))
      (al-free! (mut xs)))
    (let [(mut ys) (al-new [H6] (malloc-allocator))
          (mut total) 0]
      (for i (range 0 3) (push! (mut ys) (H6 :a 1 :b 2 :c (cast i16 (* 10 i)))))
      (for y ys (set! total (+ total (cast i64 (.c y)))))
      (set! fails (+ fails (check "h6 arraylist" total 30)))
      (al-free! (mut ys)))
    (println "failures: {}" fails)
    fails))
