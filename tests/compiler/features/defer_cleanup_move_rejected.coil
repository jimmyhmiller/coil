(module defer-cleanup-move-rejected)
; A cleanup runs at every exit, so it may read an owner but not move it.
(defstruct Owner [(value i64)])

(impl Drop Owner (drop [(self (mut Owner))] (-> void) 0))

(defn consume [(o Owner)] (-> i64) (.value o))

(defn main [] (-> i64)
  (let [o (Owner :value 1)]
    (defer* (consume o))
    0))
