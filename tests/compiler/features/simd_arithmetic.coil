(defn check-u64 [] (-> i64)
  (let [a (v/viota [u64 16]) b (v/vsplat [u64 16] 3)
        sum (v/vadd a b) diff (v/vsub a b) prod (v/vmul a b)
        left (v/vshl a b) right (v/vshr-logical left b)
        rotated (v/vrotate-right (v/vrotate-left a b) b)
        counted (v/vpopcount a) leading (v/vclz a) trailing (v/vctz a)
        reversed (v/vbit-reverse (v/vbit-reverse a))
        swapped (v/vbyte-swap (v/vbyte-swap a))]
    (for [i 0 16]
      (assert-eq (v/vextract sum i) (cast u64 (+ i 3)))
      (assert-eq (v/vextract diff i) (cast u64 (- i 3)))
      (assert-eq (v/vextract prod i) (cast u64 (* i 3)))
      (assert-eq (v/vextract right i) (cast u64 i))
      (assert-eq (v/vextract rotated i) (cast u64 i))
      (assert-eq (v/vextract counted i) (cast u64 (p/popcount i)))
      (assert-eq (v/vextract leading i) (cast u64 (- (p/clz i) 0)))
      (assert-eq (v/vextract trailing i) (cast u64 (if (= i 0) 64 (p/ctz i))))
      (assert-eq (v/vextract reversed i) (cast u64 i))
      (assert-eq (v/vextract swapped i) (cast u64 i)))
    (assert-eq (v/vreduce-add a) (cast u64 120))
    (assert-eq (v/vreduce-min a) (cast u64 0))
    (assert-eq (v/vreduce-max a) (cast u64 15))
    (assert-eq (v/vreduce-or a) (cast u64 15))
    (assert-eq (v/vreduce-and a) (cast u64 0))
    (assert-eq (v/vreduce-xor a) (cast u64 0))
    (assert-eq (v/vextract (v/vshl b (v/vsplat [u64 16] 64)) 0) (cast u64 3))
    (assert-eq (v/vextract (v/vabs (v/vsplat [u64 16] 255)) 0) (cast u64 255))
    0))

(defn check-i64 [] (-> i64)
  (let [a (v/viota [i64 16]) b (v/vsplat [i64 16] 3)
        sum (v/vadd a b) diff (v/vsub a b) prod (v/vmul a b)
        left (v/vshl a b) right (v/vshr-logical left b)
        rotated (v/vrotate-right (v/vrotate-left a b) b)
        counted (v/vpopcount a) leading (v/vclz a) trailing (v/vctz a)
        reversed (v/vbit-reverse (v/vbit-reverse a))
        swapped (v/vbyte-swap (v/vbyte-swap a))]
    (for [i 0 16]
      (assert-eq (v/vextract sum i) (cast i64 (+ i 3)))
      (assert-eq (v/vextract diff i) (cast i64 (- i 3)))
      (assert-eq (v/vextract prod i) (cast i64 (* i 3)))
      (assert-eq (v/vextract right i) (cast i64 i))
      (assert-eq (v/vextract rotated i) (cast i64 i))
      (assert-eq (v/vextract counted i) (cast i64 (p/popcount i)))
      (assert-eq (v/vextract leading i) (cast i64 (- (p/clz i) 0)))
      (assert-eq (v/vextract trailing i) (cast i64 (if (= i 0) 64 (p/ctz i))))
      (assert-eq (v/vextract reversed i) (cast i64 i))
      (assert-eq (v/vextract swapped i) (cast i64 i)))
    (assert-eq (v/vreduce-add a) (cast i64 120))
    (assert-eq (v/vreduce-min a) (cast i64 0))
    (assert-eq (v/vreduce-max a) (cast i64 15))
    (assert-eq (v/vreduce-or a) (cast i64 15))
    (assert-eq (v/vreduce-and a) (cast i64 0))
    (assert-eq (v/vreduce-xor a) (cast i64 0))
    (assert-eq (v/vextract (v/vshl b (v/vsplat [i64 16] 64)) 0) (cast i64 3))
    (assert-eq (v/vextract (v/vabs (v/vsplat [i64 16] -3)) 0) (cast i64 3))
    0))

(defn check-f32 [] (-> i64)
  (let [a (v/vsplat [f32 4] 4.0) b (v/vsplat [f32 4] 2.0)]
    (assert (p/fcmp-eq (v/vextract (v/vdiv a b) 0) (cast f32 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vsqrt a) 0) (cast f32 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vfma a b b) 0) (cast f32 10.0)))
    (assert (p/fcmp-eq (v/vreduce-add a) (cast f32 16.0)))
    (assert (p/fcmp-eq (v/vreduce-min a) (cast f32 4.0)))
    (assert (p/fcmp-eq (v/vreduce-max a) (cast f32 4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vmin a b) 0) (cast f32 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vmax a b) 0) (cast f32 4.0)))
    (assert-eq (v/mask->bits (v/visfinite a)) (cast u64 15))
    (assert-eq (v/mask->bits (v/visnan a)) (cast u64 0))
    0))

(defn check-f64 [] (-> i64)
  (let [a (v/vsplat [f64 4] 4.0) b (v/vsplat [f64 4] 2.0)]
    (assert (p/fcmp-eq (v/vextract (v/vdiv a b) 0) (cast f64 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vsqrt a) 0) (cast f64 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vfma a b b) 0) (cast f64 10.0)))
    (assert (p/fcmp-eq (v/vreduce-add a) (cast f64 16.0)))
    (assert (p/fcmp-eq (v/vreduce-min a) (cast f64 4.0)))
    (assert (p/fcmp-eq (v/vreduce-max a) (cast f64 4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vmin a b) 0) (cast f64 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vmax a b) 0) (cast f64 4.0)))
    (assert-eq (v/mask->bits (v/visfinite a)) (cast u64 15))
    (assert-eq (v/mask->bits (v/visnan a)) (cast u64 0))
    0))

(defn main [] (-> i64)
  (do
    (check-u8)
    (check-i8)
    (check-u16)
    (check-i16)
    (check-u32)
    (check-i32)
    (check-u64)
    (check-i64)
    (check-f32)
    (check-f64)
    0))
