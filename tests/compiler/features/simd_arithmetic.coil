(module test.simd-arithmetic)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn check-u8 [] (-> i64)
  (let [a (v/viota [u8 16]) b (v/vsplat [u8 16] 3)
        sum (v/vadd a b) diff (v/vsub a b) prod (v/vmul a b)
        left (v/vshl a b) right (v/vshr-logical left b)
        rotated (v/vrotate-right (v/vrotate-left a b) b)
        counted (v/vpopcount a) leading (v/vclz a) trailing (v/vctz a)
        reversed (v/vbit-reverse (v/vbit-reverse a))
        swapped (v/vbyte-swap (v/vbyte-swap a))]
    (for [i 0 16]
      (assert-eq (v/vextract sum i) (cast u8 (+ i 3)))
      (assert-eq (v/vextract diff i) (cast u8 (- i 3)))
      (assert-eq (v/vextract prod i) (cast u8 (* i 3)))
      (assert-eq (v/vextract right i) (cast u8 i))
      (assert-eq (v/vextract rotated i) (cast u8 i))
      (assert-eq (v/vextract counted i) (cast u8 (p/popcount i)))
      (assert-eq (v/vextract leading i) (cast u8 (- (p/clz i) 56)))
      (assert-eq (v/vextract trailing i) (cast u8 (if (= i 0) 8 (p/ctz i))))
      (assert-eq (v/vextract reversed i) (cast u8 i))
      (assert-eq (v/vextract swapped i) (cast u8 i)))
    (assert-eq (v/vreduce-add a) (cast u8 120))
    (assert-eq (v/vreduce-min a) (cast u8 0))
    (assert-eq (v/vreduce-max a) (cast u8 15))
    (assert-eq (v/vreduce-or a) (cast u8 15))
    (assert-eq (v/vreduce-and a) (cast u8 0))
    (assert-eq (v/vreduce-xor a) (cast u8 0))
    (assert-eq (v/vextract (v/vshl b (v/vsplat [u8 16] 8)) 0) (cast u8 3))
    (assert-eq (v/vextract (v/vabs (v/vsplat [u8 16] 255)) 0) (cast u8 255))
    0))

(defn check-i8 [] (-> i64)
  (let [a (v/viota [i8 16]) b (v/vsplat [i8 16] 3)
        sum (v/vadd a b) diff (v/vsub a b) prod (v/vmul a b)
        left (v/vshl a b) right (v/vshr-logical left b)
        rotated (v/vrotate-right (v/vrotate-left a b) b)
        counted (v/vpopcount a) leading (v/vclz a) trailing (v/vctz a)
        reversed (v/vbit-reverse (v/vbit-reverse a))
        swapped (v/vbyte-swap (v/vbyte-swap a))]
    (for [i 0 16]
      (assert-eq (v/vextract sum i) (cast i8 (+ i 3)))
      (assert-eq (v/vextract diff i) (cast i8 (- i 3)))
      (assert-eq (v/vextract prod i) (cast i8 (* i 3)))
      (assert-eq (v/vextract right i) (cast i8 i))
      (assert-eq (v/vextract rotated i) (cast i8 i))
      (assert-eq (v/vextract counted i) (cast i8 (p/popcount i)))
      (assert-eq (v/vextract leading i) (cast i8 (- (p/clz i) 56)))
      (assert-eq (v/vextract trailing i) (cast i8 (if (= i 0) 8 (p/ctz i))))
      (assert-eq (v/vextract reversed i) (cast i8 i))
      (assert-eq (v/vextract swapped i) (cast i8 i)))
    (assert-eq (v/vreduce-add a) (cast i8 120))
    (assert-eq (v/vreduce-min a) (cast i8 0))
    (assert-eq (v/vreduce-max a) (cast i8 15))
    (assert-eq (v/vreduce-or a) (cast i8 15))
    (assert-eq (v/vreduce-and a) (cast i8 0))
    (assert-eq (v/vreduce-xor a) (cast i8 0))
    (assert-eq (v/vextract (v/vshl b (v/vsplat [i8 16] 8)) 0) (cast i8 3))
    (assert-eq (v/vextract (v/vabs (v/vsplat [i8 16] -3)) 0) (cast i8 3))
    0))

