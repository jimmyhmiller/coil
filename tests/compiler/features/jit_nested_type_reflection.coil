(module compiler.features.jit-nested-type-reflection)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        status
          (jit/jit-prepare-with-entry! (mut session)
            "(module nested-type-reflection)
             (import \"coil.primitive\" :as p)
             (defstruct Inner [(x i64) (y i16)])
             (defstruct Outer [(child Inner) (tag u8)])
             (defn make-size [(T Code)] (-> Code)
               (let [ty (p/code-field-qtype T 0)]
                 `(defn nested-size [] (-> i64)
                    (p/cast i64 (p/sizeof ~ty)))))
             (meta (make-size `Outer))"
            "0")]
    (when (= status 0) (jit/jit-abort-prepared! (mut session)))
    (jit/jit-session-free! (mut session))
    status))
