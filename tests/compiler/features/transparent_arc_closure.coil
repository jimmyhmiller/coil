(module transparent_arc_closure)
(import "coil.closure" :use *)

(defstruct Cell [(value i64)])

(defclosure read-cell [(cell Cell)] [(add i64)] i64
  (+ (.value cell) add))

(defn main [] (-> i64)
  (let [cell (Cell :value 40)
        first (read-cell-new cell)
        second first]
    (+ (first 1) (- (second 1) 40))))
