(module generic-argument-mismatch-rejected)

; A value of the wrong shape for a generic field leaves its type parameter
; unbound; the mismatch is the error, not the inference.

(defstruct Holder [T] [(p (ptr T))])

(defn run [] (-> i64)
  (let [(mut x) 5
        h (Holder :p (mut x))]
    0))

(defn main [] (-> i64) (run))
