(module nested-try-blocks)
(import "coil.try" :use [try try!])

; A try! exits the innermost enclosing try, so try blocks nest and sequence freely.

(defn half [(n i64)] (-> (Result i64 i64))
  (if (= (% n 2) 0) (Ok (/ n 2)) (Err n)))

(defn both-halves [(a i64) (b i64)] (-> (Result i64 i64))
  (let [x (: (try (Ok (try! (half a)))) (Result i64 i64))
        y (: (try (Ok (try! (half b)))) (Result i64 i64))]
    (match x
      (Ok [v] (match y (Ok [w] (Ok (+ v w))) (Err [e] (Err e))))
      (Err [e] (Err e)))))

(defn quarter-or-default [(a i64)] (-> (Result i64 i64))
  (try
    (let [inner (: (try (Ok (try! (half a)))) (Result i64 i64))]
      (match inner
        (Ok [v] (Ok (try! (half v))))
        (Err [_] (Ok -1))))))

(defn show [(r (Result i64 i64))] (-> i64)
  (match r
    (Ok [v] (println "ok {}" v))
    (Err [e] (println "err {}" e)))
  0)

(defn main [] (-> i64)
  (show (both-halves 4 6))
  (show (both-halves 4 5))
  (show (quarter-or-default 8))
  (show (quarter-or-default 3))
  (show (quarter-or-default 6))
  ; a raw loop label reused by an inner loop resolves to the inner loop
  (let [(mut hits) 0]
    (loop :walk
      (loop :walk (set! hits (+ hits 1)) (break :walk))
      (set! hits (+ hits 10))
      (break :walk))
    (println "hits {}" hits))
  0)
