(module test.simd-aggregate)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defstruct Record [(const N i64)] [(before i64) (chunk (v/Chunk u8 N)) (after i64)])

(defn make :inline (Never) [(const N i64)] [(tag i64)] (-> (Record N))
  (Record :before tag
          :chunk (v/Chunk :value (v/vsplat [u8 N] (cast u8 tag)) :valid (v/mask-low [N] tag))
          :after (+ tag 123)))

(defn verify [(const N i64)] [(item (Record N))] (-> i64)
  (let [chunk (.chunk item)]
    (assert-eq (.after item) (+ (.before item) 123))
    (assert-eq (v/vextract (.value chunk) 0) (cast u8 (.before item)))
    (assert-eq (v/mask-count (.valid chunk)) (.before item)))
  0)

(defn check-shape [(const N i64)] [] (-> i64)
  (let [items (p/alloc-stack (array (Record N) 3))
        base (cast (ptr (Record N)) items)]
    (for [i 0 3] (store! (p/index base i) (make [N] i)))
    (for [i 0 3] (verify (load (p/index base i)))))
  0)

(defn main [] (-> i64)
  (check-shape [(const 3)])
  (check-shape [(const 16)])
  (check-shape [(const 64)])
  0)
