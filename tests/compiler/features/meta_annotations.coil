(module compiler.features.meta-annotations)
(import "compiler.features.meta-annotations-embed" :use [embed-annotations])

(transform embed-annotations)

;;; `meta/annotations` answers the `:key value` pairs a function or `def` carries,
;;; in the order written, as one list; an empty list for a definition with none
;;; and `:unresolved` for a name the program does not define.
(defannotation :app/expose bool)
(defannotation :app/note (slice u8))

(defn exposed :app/expose true :app/note "twice" [(x i64)] (-> i64) (* x 2))
(def limit :app/expose false i64 100)
(defn plain [(x i64)] (-> i64) x)

(defn main [] (-> i64)
  (assert (= (on-function) "(:app/expose true :app/note \"twice\")"))
  (assert (= (on-def) "(:app/expose false)"))
  (assert (= (on-plain) "()"))
  (assert (= (on-missing) ":unresolved"))
  (assert (= (+ (exposed 1) (+ (plain 1) limit)) 103))
  0)
