(module compiler.features.macro-staging-impls)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.var" :use [Var])

; What a macro may use at expansion time. Each of these used to be missing from the
; metaprogram's staging closure:
; - `Var::new`, an inherent method `coil.alloc` adds to `coil.var`'s type;
; - `Var`'s own `get`/`set`, which the alloc extension "shadowed" in staging;
; - calling a `Var` that holds a function pointer (its `Callable` impl);
; - a helper reached only through a `:field value` constructor argument.

(defstruct Pair [(left i64) (right i64)])

(defn triple [(x i64)] (-> i64) (* x 3))
(defn only-in-constructor [(x i64)] (-> i64) (+ x 100))

(defn staged [(form Code)] (-> Code)
  (let [n (primitive/code-int form)
        cell (Var::new (malloc-allocator) n)
        slot (Var::new (malloc-allocator) (primitive/fnptr-of triple))
        pair (Pair :left (only-in-constructor n) :right 0)]
    (set cell (+ (get cell) 1))
    `~(+ (slot (get cell)) (.left pair))))

(defn main [] (-> i64)
  (println "{}" (staged 4))
  0)
