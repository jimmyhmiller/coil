(module rc_allocator_provenance_test)
(import "coil.alloc" :as alloc)
(import "coil.rc" :as rc)
(import "coil.primitive" :as primitive)

(defstruct CountedAllocator
  [(allocations i64)
   (deallocations i64)
   (retains i64)
   (releases i64)
   (payload-drops i64)])

(impl alloc/Allocator CountedAllocator
  (allocate [(self (ptr CountedAllocator)) (request (ref alloc/AllocRequest))]
            (-> (Option (ptr i8)))
    (store! (field self allocations) (primitive/iadd (load (field self allocations)) 1))
    (alloc/malloc-allocate (load request)))
  (resize [(self (ptr CountedAllocator))
           (memory (ptr i8))
           (old (ref alloc/AllocRequest))
           (new (ref alloc/AllocRequest))] (-> bool)
    false)
  (remap [(self (ptr CountedAllocator))
          (memory (ptr i8))
          (old (ref alloc/AllocRequest))
          (new (ref alloc/AllocRequest))] (-> (Option (ptr i8)))
    (None))
  (deallocate [(self (ptr CountedAllocator))
               (memory (ptr i8))
               (request (ref alloc/AllocRequest))] (-> i64)
    (store! (field self deallocations) (primitive/iadd (load (field self deallocations)) 1))
    (primitive/free memory)))

(defn counted-retain [(raw (ptr i8))] (-> i64)
  (let [state (primitive/cast (ptr CountedAllocator) raw)]
    (store! (field state retains) (primitive/iadd (load (field state retains)) 1))
    0))

(defn counted-release [(raw (ptr i8))] (-> i64)
  (let [state (primitive/cast (ptr CountedAllocator) raw)]
    (store! (field state releases) (primitive/iadd (load (field state releases)) 1))
    0))

(defstruct Payload [(state (ptr CountedAllocator))])
(impl Drop Payload
  (drop [(self (mut Payload))] (-> void)
    (let [state (.state self)]
      (store! (field state payload-drops)
              (primitive/iadd (load (field state payload-drops)) 1)))))

(defn dead-weak [(lease alloc/AllocatorLease)
                 (state (ptr CountedAllocator))] (-> (rc/WeakRc Payload))
  (match (rc/rc-new-in lease (Payload :state state))
    (None [] (do (alloc/oom) (primitive/zeroed (rc/WeakRc Payload))))
    (Some [owner]
      (let [other (clone owner)
            weak (rc/rc-downgrade owner)]
        weak))))

(defn main [] (-> i64)
  (let [state (primitive/alloc-static CountedAllocator)]
    (store! state (primitive/zeroed CountedAllocator))
    (let [ignored
            (let [weak
                    (dead-weak
                      (alloc/unsafe-allocator-lease-new
                        (primitive/make-dyn alloc/Allocator state)
                        (primitive/cast (ptr i8) state)
                        (primitive/fnptr-of counted-retain)
                        (primitive/fnptr-of counted-release))
                      state)]
              (match (rc/weak-rc-upgrade weak)
                (None [] 0)
                (Some [unexpected] 100)))]
      (cond (!= (load (field state allocations)) 1) 11
            (!= (load (field state deallocations)) 1) 12
            (!= (load (field state payload-drops)) 1) 13
            (!= (load (field state retains)) 0) 14
            (!= (load (field state releases)) 1) 15
            :else 42))))
