(module primitive-spelling-keep)
(import "coil.primitive" :as primitive)

; `coil lint --fix` input for coil.lint.primitives: every primitive here must
; stay. Each has no everyday spelling with the same meaning, or rewriting it
; would change what a name refers to.

; An i7 has no arithmetic or comparison impls.
(defn narrow [(w i7)] (-> bool)
  (primitive/icmp-lt (primitive/iadd w (: 1 i7)) (: 5 i7)))

; fcmp-ne is the ORDERED not-equal (false when either side is NaN); `!=` is
; true then. Floats have no `%`.
(defn float-ne [(x f64)] (-> bool) (primitive/fcmp-ne x x))

(defn float-rem [(x f64)] (-> f64) (primitive/frem x 2.0))

; udiv on a SIGNED type reads the bits as unsigned; `/` would divide signed.
(defn unsigned-view [(x i64)] (-> i64) (primitive/udiv x 2))

; A local named `index` shadows the core alias in this form.
(defn shadowed [(p (ptr i64))] (-> i64)
  (let [index 1]
    (load (primitive/index p index))))

; On literals alone a primitive takes its type from context, like a literal;
; `(+ (* 2 100) 50)` would be an i64. A return type is context the lint cannot see.
(defn small-sum [] (-> u8) (primitive/iadd (primitive/imul 2 100) 50))

; A const says its type, but `udiv` on a signed type still has no operator.
(const HALF-MAX i64 (primitive/udiv -2 2))

; A stack cell stays a cell when a local would behave differently: its type owns
; something (a local would run Drop), it escapes, or it is handed to something
; that does not take `(mut x)` as the pointer.
(defstruct Handle [(fd i64)])

(impl Drop Handle (drop [(self (mut Handle))] (-> void) 0))

(defn owned-cell [] (-> i64)
  (let [h (primitive/alloc-stack Handle)]
    (set! h (Handle :fd 3))
    (.fd h)))

(defn escaping-cell [] (-> (ptr i64))
  (let [c (primitive/alloc-stack i64)]
    c))

(defn read-cell [(p (ptr i64))] (-> i64) (load p))

(defn indirect-cell [] (-> i64)
  (let [c (primitive/alloc-stack i64)
        reader (fnptr-of read-cell)]
    (set! c 9)
    (call-ptr reader c)))

; A template expands in another module.
(defn template [(x Code)] (-> Code) `(primitive/iadd ~x 1))

(defn main [] (-> i64)
  (let [(mut xs) [10 20 30]]
    (println "{} {} {} {} {} {} {} {}"
             (narrow (: 2 i7))
             (float-ne 1.0)
             (float-rem 5.0)
             (unsigned-view -2)
             (shadowed (cast (ptr i64) (mut xs)))
             HALF-MAX
             (small-sum)
             (+ (owned-cell) (indirect-cell)))
    0))
