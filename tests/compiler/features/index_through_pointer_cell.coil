(module index-through-pointer-cell)
(import "coil.primitive" :as primitive)

; A `(mut p)` local or parameter holding a pointer is indexed through the
; pointer it holds, not across its own single cell.

(defn read [(p (ptr i64))] (-> i64) (load p))

(defn second-through [(p (mut (ptr i64)))] (-> i64) (load (index p 1)))

(defn main [] (-> i64)
  (let [buf (primitive/alloc-stack (array i64 4))
        (mut data) (cast (ptr i64) buf)]
    (store! (index data 0) 10)
    (store! (index data 1) 20)
    (store! (index data 2) 30)
    (println "{} {} {}" (read (index data 1)) (load (index data 2)) (second-through (mut data)))
    (set! data (index data 1))
    (println "{}" (read (index data 1)))
    0))
