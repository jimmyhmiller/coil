(module compiler.features.host-environment-types)
(import "coil.jit.environment")

;;; A module described to a session with nothing exposed: its record and generic
;;; come along, and `hidden` does not, so a session cannot call it.

(defstruct Pair [(a i64) (b i64)])
(defn id2 [T] [(v T)] (-> T) v)
(defn hidden [(n i64)] (-> i64) (+ n 1))
