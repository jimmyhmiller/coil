(module trait-extra-param-aggregate-abi)

; A trait method parameter typed by one of the trait's own extra parameters
; (`Event` here) has value ABI in a generic caller, while the implementing
; method takes the substituted aggregate by reference. Monomorphization must
; pass an address, on every call path: an aggregate result used to send the
; value through a different lowering, which failed LLVM verification.

(defstruct Light [(x i64)])
(defstruct Ev [(y i64) (z i64)])

(deftrait Machine [Self Event]
  (step [(state Self) (event Event)] (-> Light))
  (score [(state Self) (event Event)] (-> i64)))

(impl Machine Light
  (step [(s Light) (e Ev)] (-> Light) (Light :x (+ (.x s) (* (.y e) (.z e)))))
  (score [(s Light) (e Ev)] (-> i64) (+ (.x s) (.z e))))

(defn drive [E (S (Machine E))] [(s S) (e E)] (-> Light) (step s e))
(defn rate [E (S (Machine E))] [(s S) (e E)] (-> i64) (score s e))

(defn main [] (-> i64)
  (println "step {}" (.x (drive (Light :x 1) (Ev :y 2 :z 3))))
  (println "score {}" (rate (Light :x 10) (Ev :y 0 :z 5)))
  0)
