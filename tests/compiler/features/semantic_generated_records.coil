(module semantic-generated-records)
(import "coil.primitive" :as p)

; The spelling is deliberately identical. Only the syntax identity distinguishes
; these types, including when a checker asks about their signatures and fields.
(defn generate [(first Code) (second Code)] (-> Code)
  (let [one (p/fresh-identifier "Generated") two (p/fresh-identifier "Generated")]
    `(do
      (defstruct ~one [(value i64)])
      (defstruct ~two [(left i64) (right i64)])
      (defn* ~first [] (-> ~one) (~one :value 42))
      (defn* ~second [] (-> ~two) (~two :left 20 :right 22)))))
(generate make-one make-two)

(defn inspect [(modules Code)] (-> Code)
  (for [mi 0 (p/code-count modules)]
    (let [module (p/code-nth modules mi)]
      (when (p/code-eq (p/code-nth module 0) `semantic-generated-records)
        (for [fi 1 (p/code-count module)]
          (let [form (p/code-nth module fi)]
            (when (and (>= (p/code-count form) 5)
              (or (p/code-eq (p/code-nth form 1) `make-one)
                  (p/code-eq (p/code-nth form 1) `make-two)))
              (let [type (p/code-nth (p/code-nth form 3) 1)
                    body (p/code-nth form 4) decl (p/code-decl body)
                    count (if (p/code-eq (p/code-nth form 1) `make-one) 1 2)]
                (unless (p/code-eq (p/code-type-shape type) `struct)
                  (p/report type "generated type shape missing") 0)
                (unless (p/code-eq (p/code-decl type) decl)
                  (p/report type "type reference and constructor identities disagree") 0)
                (unless (= (p/code-field-count type) count)
                  (p/report type "generated type identities were conflated") 0)
                (unless (p/code-eq (p/code-field-qtype type 0) `i64)
                  (p/report type "generated field type missing") 0)
                (if (and (p/code-list? decl) (>= (p/code-count decl) 4))
                  (unless (and (p/code-eq (p/code-nth decl 2) `struct)
                    (p/code-eq (p/code-nth decl 3) (p/type-of body)))
                    (p/report body "constructor declaration disagrees with inferred type") 0)
                  (do (p/report body "generated constructor declaration missing") 0)))) 0)))))
  `(do ~@modules))
(checker inspect)
(defn main [] (-> i64)
  (let [one (make-one) two (make-two)]
    (if (and (= (.value one) 42) (= (+ (.left two) (.right two)) 42)) 0 1)))
