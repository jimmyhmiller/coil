(module compiler.features.jit-static-session)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (if (!= (jit/jit-compile! (mut session)
                              "(module retained.example)
                (defstruct Point [(x i64)])
                (defn original [] (-> i64) 7)
                (defn identity [T] [(value T)] (-> T) value)
                (defn plus-one [(value Code)] (-> Code) `(+ ~value 1))")
            0)
        1
        (if (!= (jit/jit-compile-with-entry! (mut session)
                                             "(defn __coil_session_entry_user [] (-> i64) 99)
                    (defn read-point [(p (ref Point))] (-> i64) (plus-one (.x p)))
                    (defn answer [] (-> i64) (let [p (Point :x (identity (original)))] (read-point p)))"
                                             "(if (= (answer) 8) 0 91)")
                0)
            2
            (if (= (jit/jit-compile! (mut session)
                                     "(defn invalid [] (-> i64) true)")
                   0)
                3
                (if (!= (jit/jit-compile-with-entry! (mut session)
                                                     "(defn still-here [] (-> i64) (+ (answer) (original)))"
                                                     "(if (= (still-here) 15) 0 92)")
                        0)
                    4
                    (if (= (jit/jit-compile! (mut session)
                                             "(defn original [] (-> i64) 100)")
                           0)
                        5
                        (if (!= (jit/jit-compile-with-entry! (mut session)
                                                             "(defn after-rejection [] (-> i64) (original))"
                                                             "(if (= (after-rejection) 7) 0 93)")
                                0)
                            6
                            0))))))))
