(module transparent_arc_shared_identity)

; Copying a heap-selected aggregate copies its managed reference. Mutation through
; either binding must reach the same object.
(defstruct Cell [(value i64)])

(defn set-cell [(cell (mut Cell)) (value i64)] (-> void)
  (set! (.value cell) value))

(defn main [] (-> i64)
  (let [first (Cell :value 10)
        (mut second) first]
    (set-cell (mut second) 42)
    (.value first)))
