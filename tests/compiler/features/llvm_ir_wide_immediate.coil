; An integer literal on an llvm-ir type wider than 8 bytes (i128) is sign
; extended across its whole slot. The direct backends used to write only the
; low 8 bytes, so `icmp ne i128 zeroinitializer, 0` could read stack garbage.
(module llvm-ir-wide-immediate)
(import "coil.primitive" :as primitive)

(defn zero-ne-zero [] (-> bool)
  (primitive/llvm-ir bool [] "%r = icmp ne i128 zeroinitializer, 0
ret i1 %r"))

(defn zero-eq-zero [] (-> bool)
  (primitive/llvm-ir bool [] "%r = icmp eq i128 zeroinitializer, 0
ret i1 %r"))

(defn zero-eq-minus-one [] (-> bool)
  (primitive/llvm-ir bool [] "%r = icmp eq i128 zeroinitializer, -1
ret i1 %r"))

; Dirty the stack between calls so an uninitialized upper half would show.
(defn scribble [(n i64)] (-> i64)
  (let [(mut junk) [n n n n n n n n]] (+ (get junk 0) (get junk 7))))

(defn main [] (-> i64)
  (let [(mut wrong) 0]
    (for i (range 0 200)
      (scribble (- -1 i))
      (when (zero-ne-zero) (set! wrong (+ wrong 1)))
      (when (not (zero-eq-zero)) (set! wrong (+ wrong 1)))
      (when (zero-eq-minus-one) (set! wrong (+ wrong 1))))
    (println "wrong: {}" wrong)
    wrong))
