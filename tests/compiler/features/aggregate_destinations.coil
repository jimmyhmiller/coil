(module test.aggregate-destinations)
(import "coil.primitive" :as p)

; An aggregate is built where it is going: a record literal or a returned local
; in the caller's result slot, a call result in a fresh binding, a payload in
; the sum that holds it. An assignment still copies: its new value may read
; the old one.
(defstruct P [(x i64) (y i64) (z i64)])
(defstruct W [(p P) (n i64)])
(defsum S (A [(p P)]) (B []))

(defn mk [(n i64)] (-> P) (P :x n :y (+ n 1) :z (+ n 2)))

(defn build [(n i64)] (-> P)
  (let [(mut r) (P :x 0 :y 0 :z 0)]
    (set! (.x r) n)
    (set! (.z r) (* n 3))
    r))

(defn pick [(c bool) (n i64)] (-> P) (if c (mk n) (build n)))

(defn wrap [(n i64)] (-> W) (W :p (mk n) :n n))

(defn some [(n i64)] (-> S) (if (> n 0) (A (mk n)) (B)))

(defn choose [(s S) (n i64)] (-> P) (match s (A [q] q) (B [] (mk n))))

; The new value reads the old fields, so it cannot be built over them.
(defn swap [(v (ptr P))] (-> i64)
  (set! v (P :x (.z v) :y (.y v) :z (.x v)))
  0)

(defn main [] (-> i64)
  (let [w (wrap 4)
        q (pick true 7)
        r (pick false 5)
        s (some 2)
        t (choose s 9)
        u (choose (B) 9)
        v (p/alloc-stack P)]
    (assert-eq (.x (.p w)) 4)
    (assert-eq (.z (.p w)) 6)
    (assert-eq (.n w) 4)
    (assert-eq (.y q) 8)
    (assert-eq (.x r) 5)
    (assert-eq (.y r) 0)
    (assert-eq (.z r) 15)
    (assert-eq (.z t) 4)
    (assert-eq (.x u) 9)
    (set! v (mk 10))
    (swap v)
    (assert-eq (.x v) 12)
    (assert-eq (.y v) 11)
    (assert-eq (.z v) 10)
    0))
