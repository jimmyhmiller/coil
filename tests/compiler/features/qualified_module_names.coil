(module compiler.features.qualified-module-names)
(import "coil.slice" :as sl)

; A module names its own definitions by their full qualifier, and an imported
; module by its full name whatever alias the import gave it.
(defn two [] (-> i64) 2)

(defn main [] (-> i64)
  (let [xs [1 2 3]]
    (println "{} {} {}"
             (compiler.features.qualified-module-names/two)
             (sl/slice-len xs)
             (coil.slice/slice-len xs))
    0))
