(module rc_allocator_drop_test)
(import "coil.rc" :as rc)

(defstruct Payload [(answer i64)])

(defn main [] (-> i64)
  (match (rc/rc-new (Payload :answer 42))
    (None [] 1)
    (Some [owner]
      (let [other (clone owner)
            weak (rc/rc-downgrade owner)]
        (match (rc/weak-rc-upgrade weak)
          (None [] 2)
          (Some [third]
            (.answer (rc/rc-borrow third))))))))
