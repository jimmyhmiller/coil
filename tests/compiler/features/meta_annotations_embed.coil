(module compiler.features.meta-annotations-embed)
(import "coil.meta" :as meta)

;;; Build-time tooling for meta_annotations.coil, which registers
;;; `embed-annotations` as a transform: embed in the host module what
;;; `meta/annotations` answers for four definitions, each as a function that
;;; returns the answer's source text.
(defn embed-annotations [(modules Code)] (-> Code)
  (let [host `compiler.features.meta-annotations]
    (meta/transform-result
      (meta/embed-text
        (meta/embed-text
          (meta/embed-text
            (meta/embed-text modules host "on-function"
              (meta/source (meta/annotations `compiler.features.meta-annotations.exposed)))
            host "on-def"
            (meta/source (meta/annotations `compiler.features.meta-annotations.limit)))
          host "on-plain"
          (meta/source (meta/annotations `compiler.features.meta-annotations.plain)))
        host "on-missing"
        (meta/source (meta/annotations `compiler.features.meta-annotations.nothing))))))
