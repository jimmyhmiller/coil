(module compiler.features.jit-static-no-replay)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(extern unlink :cc c [(ptr i8)] (-> i32))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (!= argc (primitive/cast i32 2))
      1
      (let [(mut session) (jit/jit-session-new (malloc-allocator))]
        (cond (!= (jit/jit-compile! (mut session)
                                    "(module retained.consumer)
                (import \"retained.dependency\" :as dep)
                (defn original [] (-> dep/Point) (dep/point))")
                  0)
                2
              (!= (unlink (load (primitive/index argv 1)))
                  (primitive/cast i32 0))
                3
              (!= (jit/jit-compile-with-entry! (mut session)
                                               "(defn later [] (-> i64) (let [p (original)] (.x p)))"
                                               "(if (= (later) 42) 0 90)")
                  0)
                4
              :else (jit/jit-reset! (mut session))))))
