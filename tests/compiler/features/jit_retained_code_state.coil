(module compiler.features.jit-retained-code-state)

(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.jit" :as jit)
(import "parser" :use [i64->str sconcat])

(const retained-source (slice u8)
  "(module retained.state)
   (import \"coil.primitive\" :as primitive)
   (defn retain [(next Code)] (-> Code)
     (let [accepted (primitive/code-session-state `0)]
       (do (primitive/code-session-stage! next) accepted)))
   (defn prior-monomorph-count [] (-> Code)
     (let [report (primitive/code-session-monomorphs)
           count (- (primitive/code-count report) 1)]
       `~count))
   (defn identity [T] [(value T)] (-> T) value)
   (defn instantiate [] (-> i64) (identity 41))
   (defn observed-monomorphs [] (-> i64) (prior-monomorph-count))")

(defn candidate [(a (dyn Allocator)) (next i64) (expected i64)
                 (invalid bool)] (-> (slice u8))
  (let [suffix
          (if invalid
              "\n(const invalid bool 41)\n"
              "\n")]
    (sconcat a retained-source
      (sconcat a "\n(defn observed [] (-> i64) (retain "
        (sconcat a (i64->str a next)
          (sconcat a "))" suffix))))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut session) (jit/jit-session-new a)]
    (if (!= (jit/jit-session-set-legacy-reload! (mut session) false) 0)
        1
        ; First candidate sees the default and commits retained state 1.
        (if (!= (jit/jit-prepare-replace-with-entry!
                  (mut session) (candidate a 1 0 false) "(if (= (observed) 0) 0 20)") 0)
            2
            (if (!= (jit/jit-commit-prepared! (mut session)) 0)
                3
                ; A candidate that stages 2 but fails checking must not publish it.
                (if (= (jit/jit-prepare-replace-with-entry!
                         (mut session) (candidate a 2 1 true) "0") 0)
                    4
                    ; The first committed program instantiated `identity<i64>`.
                    ; Candidate 3 sees that accepted structural report, then commits.
                    (if (!= (jit/jit-prepare-replace-with-entry!
                              (mut session) (candidate a 3 1 false)
                              "(if (> (observed-monomorphs) 0) 0 23)") 0)
                        5
                        (if (!= (jit/jit-commit-prepared! (mut session)) 0)
                            6
                            ; Explicit abort must discard staged state 4.
                            (if (!= (jit/jit-prepare-replace-with-entry!
                                      (mut session) (candidate a 4 3 false) "0") 0)
                                7
                                (do
                                  (jit/jit-abort-prepared! (mut session))
                                  ; Candidate 5 must still observe committed state 3.
                                  (if (!= (jit/jit-prepare-replace-with-entry!
                                            (mut session) (candidate a 5 3 false)
                                            "(if (= (observed) 3) 0 21)") 0)
                                      8
                                      (if (!= (jit/jit-commit-prepared! (mut session)) 0)
                                          9
                                          ; Finally prove committed state 5 is visible.
                                          (if (!= (jit/jit-prepare-replace-with-entry!
                                                    (mut session) (candidate a 6 5 false)
                                                    "(if (= (observed) 5) 0 22)") 0)
                                              10
                                              (do
                                                (jit/jit-abort-prepared! (mut session))
                                                0))))))))))))))
