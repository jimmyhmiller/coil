(module ref-param-pointer-args)

; A raw `(ptr T)` argument meets a reference parameter two ways: as the place
; of its pointee (`(ref T)`), or as a pointer value of its own (`(ref (ptr T))`,
; which `clone` on a pointer takes). Both must check and infer.

(defstruct V [(n i64)])

(defn peek [K] [(k (ref K))] (-> K) (load k))

; K is known from the expected result: the pointer is the reference.
(defn via-pointer [(p (ptr i64))] (-> i64) (peek p))

; clone of a pointer copies the pointer, concretely and generically
(defn dup [(p (ptr V))] (-> (ptr V)) (clone p))
(defn dup-generic [W] [(p (ptr W))] (-> (ptr W)) (clone p))

(defn main [] (-> i64)
  (let [(mut v) (V :n 41)
        (mut x) 7]
    (println "via-pointer {}" (via-pointer (mut x)))
    (let [q (dup (mut v))]
      (set! (.n q) (+ (.n q) 1))
      (println "dup {}" (.n v)))
    (println "dup-generic {}" (.n (dup-generic [V] (mut v))))
    0))
