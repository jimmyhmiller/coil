(module ownership_struct_drop_glue)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))]
        (-> void)
        (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

; Container deliberately has no Drop impl. Its needs-drop property and cleanup
; come entirely from its fields.
(defstruct Container [(first Leaf) (second Leaf)])

(defstruct GenericContainer [(T Drop)] [(first T) (second T)])

(defn run [] (-> void)
  (let [container
          (Container
            :first (Leaf :value 1)
            :second (Leaf :value 2))]
    (do)))

(defn run-generic [] (-> void)
  (let [container
          (GenericContainer
            :first (Leaf :value 1)
            :second (Leaf :value 2))]
    (do)))

(defn main [] (-> i64)
  (store! (counter) 0)
  (run)
  ; Compiler-generated structural glue destroys fields in reverse order.
  (let [concrete (load (counter))]
    (store! (counter) 0)
    (run-generic)
    (+ concrete (load (counter)))))
