(module format-specs)
(import "coil.debug" :use *)

; Width, fill, alignment, sign, zero padding and precision in format strings.
; A spec applies to the whole value the placeholder prints.

(defstruct Point [(x i64)])
(derive Debug Point)

(defn main [] (-> i64)
  (println "[{:.2}] [{:8.3}] [{:<8.1}] [{:^9.2}] [{:08.3}] [{:+.1}]" 3.14159 2.5 -1.25 0.5 -3.5 2.0)
  (println "[{:5}] [{:<5}] [{:^5}] [{:05}] [{:+}] [{:*>6}]" 42 42 42 -42 7 9)
  (println "[{:8}] [{:>8}] [{:^8}] [{:.3}] [{:-<7.2}]" "hi" "hi" "hi" "héllo" "abc")
  (println "[{:x}] [{:#x}] [{:08x}] [{:#010x}]" 255 255 255 255)
  (println "[{:12?}] [{:>12?}] [{:>6?}]" (Point :x 1) (Some 5) "hi")
  (println "[{}] [{}] [{:.0}] [{:.0}] [{:.1}]" -0.0 1.5 2.5 3.5 0.25)
  (println "{{literal}} {}" 1)
  0)
