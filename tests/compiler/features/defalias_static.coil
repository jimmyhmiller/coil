(module compiler.features.defalias-static)
;; `defalias` gives a module-local name to another declaration of the same
;; module. Every declaration kind resolves through it: types, constructors,
;; functions, sums, variants, and macros, spelled bare or fully qualified.
(defstruct Rect-v1 [(x i64) (y i64)])
(defalias Rect Rect-v1)
(defn area-v1 [(r Rect)] (-> i64) (* (.x r) (.y r)))
(defalias area area-v1)
(defsum Shape-v1 (Square-v1 [(side i64)]) (Circle-v1))
(defalias Shape Shape-v1)
(defalias Square Square-v1)
(defalias Circle Circle-v1)
(defn twice-v1 [(e Code)] (-> Code) `(* 2 ~e))
(defalias twice twice-v1)
(const LIMIT-v1 5)
(defalias LIMIT LIMIT-v1)

(defn side [(s Shape)] (-> i64)
  (match s (Square [n] n) (Circle [] 0)))

(defn main [] (-> i64)
  (let [r (Rect :x 2 :y 3)
        q (compiler.features.defalias-static.Rect :x 1 :y 1)
        callback (fnptr-of area)]
    (if (= (+ (twice (area r))
              (+ (compiler.features.defalias-static.area q)
                 (+ (side (Square 4)) (+ LIMIT (call-ptr callback r)))))
           28)
        0
        1)))
