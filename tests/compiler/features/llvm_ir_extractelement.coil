; `extractelement` in an llvm-ir escape works on every backend, with a constant
; or a runtime lane index. The direct arm64 and x86-64 backends interpret the
; escape themselves and used to abort with "unsupported op: extractelement".
(module llvm-ir-extractelement)
(import "coil.primitive" :as primitive)
(import "coil.simd" :use *)

(defn lane-i64 [(v (vec i64 4)) (i i64)] (-> i64)
  (primitive/llvm-ir i64 [v i] "%r = extractelement $t0 $0, i64 $1
ret $ret %r"))

(defn third-f32 [(v (vec f32 4))] (-> f32)
  (primitive/llvm-ir f32 [v] "%r = extractelement $t0 $0, i32 2
ret $ret %r"))

(defn lane-u8 [(v (vec u8 16)) (i i64)] (-> u8)
  (primitive/llvm-ir u8 [v i] "%r = extractelement $t0 $0, i64 $1
ret $ret %r"))

(defn lane-i16 [(v (vec i16 8)) (i i32)] (-> i16)
  (primitive/llvm-ir i16 [v i] "%r = extractelement $t0 $0, i32 $1
ret $ret %r"))

(defn main [] (-> i64)
  (let [ints (vinsert (vsplat [i64 4] 5) 3 40)
        floats (vec4f 1 2 3.5 4)
        bytes (vinsert (vsplat [u8 16] 1) 15 200)
        shorts (vinsert (vsplat [i16 8] -3) 6 1000)
        (mut total) 0]
    (for i (range 0 4) (set! total (+ total (lane-i64 ints i))))
    (println "{} {} {} {} {}"
             total
             (third-f32 floats)
             (lane-u8 bytes 15)
             (lane-i16 shorts 6)
             (lane-i16 shorts 1))
    0))
