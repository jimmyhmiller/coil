(module checker_nested_code_aggregate)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use *)

(defstruct CheckerItem
  [(module (slice u8))
   (name (slice u8))
   (form Code)])

(defn retain-checker-item [(modules Code)] (-> Code)
  (let [(mut items) (al-new [CheckerItem] (malloc-allocator))]
    (al-push! [CheckerItem] (mut items)
      (CheckerItem :module "fixture" :name "main" :form modules))
    (.form (al-elem [CheckerItem] (mut items) 0))))

(checker retain-checker-item)

(defn main [] (-> i64)
  42)
