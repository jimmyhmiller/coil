(module primitive-spelling-fix)
(import "coil.primitive" :as primitive)

; `coil lint --fix` input for coil.lint.primitives: every primitive here has an
; everyday spelling, so the fix removes them all, and then the import.

(defstruct V2 [(x f32) (y f32)])

; A const's declared type is the context its literal operations take.
(const SHIFT i64 (primitive/ishl 1 17))

(const FLAGS i32 (primitive/ior (primitive/ishl 1 4) 2))

(const SMALL u8 (primitive/iadd 200 50))

; `+` on V2 is defined with f32 additions; those are not `+` on V2, so they
; become `+` too.
(impl Add V2
  (+ [(a V2) (b V2)] (-> V2)
    (V2 :x (primitive/fadd (.x a) (.x b)) :y (primitive/fadd (.y a) (.y b)))))

(defn arith [(a u8) (b i32) (c i64) (d u64)] (-> i64)
  (let [s (primitive/iadd a (: 3 u8))
        t (primitive/iand 255 b)
        u (primitive/ishr c 2)
        v (primitive/urem d 7)
        w (primitive/ixor (primitive/ishl c 3) c)]
    (primitive/iadd (primitive/cast i64 s)
                    (primitive/iadd (primitive/cast i64 t)
                                    (primitive/iadd u (primitive/iadd (primitive/cast i64 v) w))))))

(defn floats [(x f32) (y f64)] (-> f64)
  (let [a (primitive/fmul x (: 2.0 f32))
        b (primitive/fadd 1.5 y)]
    (if (primitive/fcmp-lt a (: 3.0 f32))
        (primitive/fsub b (primitive/cast f64 a))
        b)))

;; IEEE float equality is `=`.
(defn same-float [(x f64) (y f64)] (-> bool) (primitive/fcmp-eq x y))

;; Stack cells become mutable locals: the first store initializes the local,
;; `load` reads it, and a function or extern taking the pointer gets `(mut x)`.
(extern clock_gettime :cc c [i32 (ptr Timespec)] (-> i32))

(defstruct Timespec [(sec i64) (nsec i64)])

(defn bump [(p (ptr V2))] (-> i64) (set! (.x p) (+ (.x p) (: 1.0 f32))) 0)

(defn cells [] (-> i64)
  (let [ts (primitive/alloc-stack Timespec)
        v (primitive/alloc-stack V2)
        n (primitive/alloc-stack u8)]
    (clock_gettime 0 ts)
    (primitive/store! v (V2 :x 1.0 :y 2.0))
    (bump v)
    (primitive/store! n 200)
    (+ (if (>= (.sec ts) 0) 1 0)
       (primitive/cast i64 (.x v))
       (primitive/cast i64 (primitive/load n)))))

(defn compare [(b u8) (c u8)] (-> i64)
  (if (and (primitive/icmp-lt 5 b) (primitive/icmp-eq b c)) 1 0))

(defn main [] (-> i64)
  (let [v (+ (V2 :x 1.0 :y 2.0) (V2 :x 3.0 :y 4.0))]
    (println "{} {} {} {} {} {} {} {} {} {}"
             (arith (: 250 u8) -1 100 (: 100 u64))
             (floats (: 1.0 f32) 2.0)
             (.y v)
             (compare (: 9 u8) (: 9 u8))
             (primitive/sizeof V2)
             SHIFT FLAGS SMALL
             (same-float 0.5 0.5) (cells))
    0))
