(module slice-of-arrays)
; A slice whose element type is itself an array: generic slice code indexes it by
; whole elements, never within the first element.
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free! al-slice])

(defn row [(a i64) (b i64)] (-> (array i64 2))
  (let [(mut r) (zeroed (array i64 2))]
    (set! (mut r) 0 a)
    (set! (mut r) 1 b)
    r))

(defn weigh [(rows (slice (array i64 2)))] (-> i64)
  (let [(mut total) 0]
    (for r rows (set! total (+ total (+ (get r 0) (* 10 (get r 1))))))
    total))

(defn main [] (-> i64)
  (let [(mut rows) (al-new [(array i64 2)] (malloc-allocator))]
    (push! (mut rows) (row 1 2))
    (push! (mut rows) (row 3 4))
    (push! (mut rows) (row 5 6))
    (let [view (al-slice rows)
          last (get view 2)]
      (println "weight {}" (weigh view))
      (println "last {} {}" (get last 0) (get last 1))
      (for r view (println "row {} {}" (get r 0) (get r 1))))
    (al-free! (mut rows))
    0))
