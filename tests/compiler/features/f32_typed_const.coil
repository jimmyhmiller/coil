(module f32_typed_const)
(import "coil.primitive" :as primitive)

; Both forms must lower to float at their use sites, including across a call.
(const DIRECT f32 50.0)
(const ASCRIBED f32 (: 12.5 f32))

(defn scaled [(value f32)] (-> f32)
  (+ (* value (: 2.0 f32)) ASCRIBED))

(defn main [] (-> i64)
  (primitive/cast i64 (scaled DIRECT)))
