; A mutable borrow of a local erases to a trait object, like a `(ptr T)` does.
(module dyn-from-mut-borrow)

(deftrait Counter [Self]
  (bump! [(self (ptr Self))] (-> i64)))

(defstruct Clicks [(n i64)])

(impl Counter Clicks
  (bump! [(self (ptr Clicks))]
         (-> i64)
         (set! (.n self) (+ (.n self) 1))
         (.n self)))

(defstruct Steps [(n i64) (by i64)])

(impl Counter Steps
  (bump! [(self (ptr Steps))]
         (-> i64)
         (set! (.n self) (+ (.n self) (.by self)))
         (.n self)))

(defn twice [(c (dyn Counter))] (-> i64)
  (bump! c)
  (bump! c))

(defn main [] (-> i64)
  (let [(mut clicks) (Clicks :n 0)
        (mut steps) (Steps :n 0 :by 5)]
    (println "{} {}" (twice (mut clicks)) (twice (mut steps)))
    (println "{} {}" (.n clicks) (.n steps))
    0))
