(module borrowed_allocator_escape_rejected)
(import "coil.alloc" :as alloc)
(import "coil.arc" :as arc)

(defstruct Payload [(value i64)])

; A borrowed allocator—including a scratch/arena allocator—cannot be silently
; retained by an escaping owner. Only an owned AllocatorLease satisfies new-in.
(defn escape [(borrowed (dyn alloc/Allocator))] (-> (Option (arc/Arc Payload)))
  (arc/arc-new-in borrowed (Payload :value 42)))

(defn main [] (-> i64) 0)
