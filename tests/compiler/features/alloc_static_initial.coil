(module alloc-static-initial)
(import "coil.primitive" :as primitive)

(defstruct Triple [(a i32) (b i32) (c i32)])

(defstruct Entry [(tag i32) (callback (fnptr c [] i64)) (tail i32)])

(defstruct ExplicitTriple :layout explicit :size 24 :align 8
  [(a i64 :at 0) (b i64 :at 8) (c i64 :at 16)])

(defn answer [] (-> i64)
  9)

(defn triple [] (-> (ptr Triple))
  (primitive/alloc-static Triple
                          (Triple
                            :a 1
                            :b 2
                            :c 3)))

(defn entry [] (-> (ptr Entry))
  (primitive/alloc-static Entry
                          (Entry
                            :tag 4
                            :callback (primitive/fnptr-of answer)
                            :tail 5)))

(defn explicit-triple [] (-> (ptr ExplicitTriple))
  (primitive/alloc-static ExplicitTriple
                          (ExplicitTriple
                            :a 11
                            :b 22
                            :c 33)))

(defn explicit-triples [] (-> (ptr (array ExplicitTriple 2)))
  (primitive/alloc-static (array ExplicitTriple 2)
                          [(ExplicitTriple
                             :a 1
                             :b 2
                             :c 3)
                           (ExplicitTriple
                             :a 4
                             :b 5
                             :c 6)]))

(defn main [] (-> i64)
  (let [p (triple)
        before (primitive/load (primitive/field p c))
        ep (explicit-triple)
        ea (primitive/index (primitive/cast (ptr ExplicitTriple) (explicit-triples)) 1)]
    (primitive/store! (primitive/field p c) (primitive/cast i32 6))
    (if (and (= before (primitive/cast i32 3))
             (and (= (primitive/load (primitive/field (triple) c)) (primitive/cast i32 6))
                  (and (= (primitive/call-ptr (primitive/load (primitive/field (entry) callback)))
                          9)
                       (and (= (+ (.a ep) (+ (.b ep) (.c ep))) 66)
                            (= (+ (.a ea) (+ (.b ea) (.c ea))) 15)))))
        0
        1)))
