(module alloc-static-initial)
(import "coil.primitive" :as primitive)

(defstruct Triple [(a i32) (b i32) (c i32)])
(defstruct Entry [(tag i32) (callback (fnptr c [] i64)) (tail i32)])

(defn answer [] (-> i64) 9)
(defn triple [] (-> (ptr Triple))
  (primitive/alloc-static Triple (Triple :a 1 :b 2 :c 3)))
(defn entry [] (-> (ptr Entry))
  (primitive/alloc-static Entry
    (Entry :tag 4 :callback (primitive/fnptr-of answer) :tail 5)))

(defn main [] (-> i64)
  (let [p (triple)
        before (primitive/load (primitive/field p c))]
    (primitive/store! (primitive/field p c) (primitive/cast i32 6))
    (if (and (= before (primitive/cast i32 3))
             (and (= (primitive/load (primitive/field (triple) c)) (primitive/cast i32 6))
                  (= (primitive/call-ptr
                       (primitive/load (primitive/field (entry) callback))) 9)))
        0
        1)))
