;; A local binding is never replaced by a global of the same spelling:
;; parameters, let, match arms, for, destructuring, anonymous fns and call heads.
(module local-shadows-global)

(const LIT 42)
(def glob 7)
(const n 100)
(def k 200)

(defsum Box (B [(v i64)]))
(defstruct P [(x i64)])

(defn add1 [(x i64)] (-> i64) (+ x 1))
(defn param-const [(LIT i64)] (-> i64) LIT)
(defn param-def [(glob i64)] (-> i64) glob)

(impl P (get-n [(p P) (n i64)] (-> i64) n))
(deftrait T [Self] (t [(s Self) (n i64)] (-> i64)))
(impl T P (t [(s P) (n i64)] (-> i64) (let [m n] m)))

(defn main [] (-> i64)
  (println "let {} {}" (let [LIT 9] LIT) (let [glob 5] glob))
  (println "params {} {}" (param-const 3) (param-def 4))
  (let [add1 (fnptr-of param-def)] (println "call-local {}" (add1 6)))
  (match (B 7) (B [n] (println "arm {}" n)))
  (for k (range 3 4) (println "for {}" k))
  (let [[n k] [1 2]] (println "destructure {} {}" n k))
  (let [g (: (fn [n] (+ n 1)) (fnptr c [i64] i64))] (println "anon {}" (g 41)))
  (let [n (+ n 1)] (println "self-init {}" n))
  (println "methods {} {}" (get-n (P :x 1) 7) (t (P :x 1) 8))
  (println "globals {} {} {} {}" LIT glob n k)
  0)
