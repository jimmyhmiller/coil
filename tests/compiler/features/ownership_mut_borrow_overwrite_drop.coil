(module ownership_mut_borrow_overwrite_drop)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))]
        (-> void)
        (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defstruct Pair [(leaves (array Leaf 2)) (leaf Leaf)])
(defstruct Holder [T] [(held T)])

; A mutable borrow always denotes an initialized owner, so a store through it
; replaces the value exactly as a store to the owner itself does.
(defn replace-field [(pair (mut Pair))] (-> void)
  (set! (.leaf pair) (Leaf :value 4)))

(defn replace-element [(pair (mut Pair))] (-> void)
  (set! (index (field pair leaves) 1) (Leaf :value 5)))

(defn replace-whole [(leaf (mut Leaf))] (-> void)
  (set! leaf (Leaf :value 6)))

(defn replace-generic [T] [(holder (mut (Holder T))) (value T)] (-> void)
  (set! (.held holder) value))

(defn through-borrows [] (-> i64)
  (store! (counter) 0)
  (let [(mut pair) (Pair :leaves [(Leaf :value 1) (Leaf :value 2)]
                         :leaf (Leaf :value 3))]
    (replace-field (mut pair))
    (replace-element (mut pair))
    (replace-whole (mut (.leaf pair))))
  ; 3, 2 and 4 are replaced in order; scope exit then drops the survivors in
  ; reverse field order: leaf 6, then elements 5 and 1.
  (load (counter)))

(defn through-generic [] (-> i64)
  (store! (counter) 0)
  (let [(mut holder) (Holder :held (Leaf :value 7))]
    (replace-generic (mut holder) (Leaf :value 8)))
  (let [(mut plain) (Holder :held 1)]
    (replace-generic (mut plain) 2))
  (load (counter)))

; A raw pointer is not a borrow: it may address storage that the store is
; initializing, so the store must not run drop glue on whatever was there.
(defn through-raw-pointer [] (-> i64)
  (store! (counter) 0)
  (let [slot (primitive/alloc-stack Leaf)]
    (store! (field slot value) 9)
    (set! slot (Leaf :value 1))
    (forget (load slot)))
  (load (counter)))

(defn main [] (-> i64)
  (let [borrows (through-borrows)
        generic (through-generic)
        raw (through-raw-pointer)]
    (if (and (= borrows 324651)
             (and (= generic 78) (= raw 0)))
        0
        1)))
