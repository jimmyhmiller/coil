(module test.primitive-mut-operand)
(import "coil.primitive" :as p)
(import "coil.assert" :use *)

;; A primitive operand is a value: a `(mut k)` local passed to one is read, as an
;; ordinary call's argument is. `code-nth` used to receive the local's reference
;; and fail "index out of range" at compile time; `iadd` reported
;; "i64 vs (mut i64)".
(defn second [(m Code)] (-> Code)
  (let [(mut k) 1]
    (p/code-nth m k)))

(defn main [] (-> i64)
  (let [(mut n) 40]
    (assert-eq (p/iadd n 2) 42)
    (assert-eq (second (10 20 30)) 20)
    0))
