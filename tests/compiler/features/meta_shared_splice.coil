(module compiler.features.meta-shared-splice)
(import "coil.primitive" :as primitive)

;;; A splice of a long list is shared, not copied, so the natural recursive ways of
;;; building a list stay linear (docs/design/META_MEMORY.md). This is the evidence
;;; that sharing changes nothing a metaprogram can see. Every list built by a
;;; natural idiom here is compared with the same list built the safe way, with a
;;; builder, at sizes below, at and above the length where sharing starts, and read
;;; every way a list can be read. A failed check is a compile error naming it.

;;; ---- the reference: the same list built with a builder ---------------------------
(defn reference [(i i64) (n i64)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for k (range i n) (push! (mut out) `(+ 0 ~k)))
    (primitive/code-list-done (load out))))

;;; ---- the natural idioms ----------------------------------------------------------
;;; cons-style recursion: one item, then the rest
(defn consing [(i i64) (n i64)] (-> Code)
  (if (>= i n) `() `((+ 0 ~i) ~@(consing (+ i 1) n))))

;;; the same with the rest bound first
(defn consing-bound [(i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [rest (consing-bound (+ i 1) n)] `((+ 0 ~i) ~@rest))))

;;; accumulation: an accumulator re-spliced to add one item
(defn accumulate [(i i64) (n i64) (acc Code)] (-> Code)
  (if (>= i n) acc (accumulate (+ i 1) n `(~@acc (+ 0 ~i)))))

;;; two items before and two after a long tail
(defn framed [(n i64)] (-> Code)
  `(first second ~@(consing 0 n) third fourth))

;;; the tail of the reference as the framed list holds it
(defn framed-reference [(n i64)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (push! (mut out) `first)
    (push! (mut out) `second)
    (for k (range 0 n) (push! (mut out) `(+ 0 ~k)))
    (push! (mut out) `third)
    (push! (mut out) `fourth)
    (primitive/code-list-done (load out))))

;;; joins of joins
(defn joined [(a i64) (b i64)] (-> Code)
  `(~@(consing 0 a) middle ~@(accumulate 0 b `())))

(defn joined-reference [(a i64) (b i64)] (-> Code)
  (let [(mut out) (primitive/code-list-new)]
    (for k (range 0 a) (push! (mut out) `(+ 0 ~k)))
    (push! (mut out) `middle)
    (for k (range 0 b) (push! (mut out) `(+ 0 ~k)))
    (primitive/code-list-done (load out))))

(defn check-text [(label (slice u8)) (got Code) (want Code)] (-> i64)
  (if (= (primitive/code-source got) (primitive/code-source want))
      0
      (primitive/error label)))

;;; a recursion that reads each level's result before using it, which lays every
;;; level out in turn, and the same built by explicit copying
(defn reading [(i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [rest (reading (+ i 1) n)]
        (if (= (len rest) 0)
            `((+ 0 ~i))
            `((+ 0 ~i) ~(get rest 0) ~@rest)))))

(defn reading-copy [(i i64) (n i64)] (-> Code)
  (if (>= i n)
      `()
      (let [rest (reading-copy (+ i 1) n)]
        (if (= (len rest) 0)
            `((+ 0 ~i))
            (primitive/code-concat `((+ 0 ~i) ~(get rest 0)) rest)))))

;;; ---- checks ----------------------------------------------------------------------
(defn check [(label (slice u8)) (got Code) (want Code)] (-> i64)
  (if (primitive/code-eq got want)
      0
      (primitive/error label)))

(defn check-len [(label (slice u8)) (got Code) (want i64)] (-> i64)
  (if (= (len got) want) 0 (primitive/error label)))

(defn check-size [(n i64)] (-> i64)
  (do
    (check "consing differs from the builder" (consing 0 n) (reference 0 n))
    (check "consing with the rest bound differs" (consing-bound 0 n) (reference 0 n))
    (check "accumulation differs" (accumulate 0 n `()) (reference 0 n))
    (check "a list framed by items differs" (framed n) (framed-reference n))
    (check-len "length of a framed list" (framed n) (+ n 4))
    (check "joins of joins differ" (joined n (/ n 2)) (joined-reference n (/ n 2)))
    (check-len "length of a join of joins" (joined n (/ n 2)) (+ (+ n (/ n 2)) 1))
    ; every way of reading it
    (let [t (consing 0 n)]
      (do
        (check "code-rest" (primitive/code-rest t) (primitive/code-rest (reference 0 n)))
        (check "code-slice" (primitive/code-slice t (/ n 3) (- n (/ n 3)))
               (primitive/code-slice (reference 0 n) (/ n 3) (- n (/ n 3))))
        (check-text "source text" t (reference 0 n))
        (check "vector template" `[~@t] `[~@(reference 0 n)])
        (if (> n 0)
            (do (check "first item" (get t 0) `(+ 0 0))
                (check "last item" (get t (- n 1)) `(+ 0 ~(- n 1))))
            0)))
    0))

;;; Sizes under the length where sharing starts, straddling it, and far beyond it.
(defn check-all [] (-> Code)
  (do
    (check-size 0) (check-size 1) (check-size 2) (check-size 5) (check-size 31)
    (check-size 32) (check-size 33) (check-size 34) (check-size 63) (check-size 64)
    (check-size 65) (check-size 100) (check-size 1000) (check-size 5000)
    (check "reading recursion matches explicit copying" (reading 0 300) (reading-copy 0 300))
    `0))

;;; ---- promotion: a joined list leaves the metaprogram as an ordinary one ------------
;;; The expansion is `(do (+ 0 0) (+ 0 1) … (+ 0 2999))`, whose value is the last.
(defn long-do [] (-> Code) `(do ~@(consing 0 3000)))

(defn main [] (-> i64)
  (do
    (check-all)
    (if (= (long-do) 2999) 0 1)))
