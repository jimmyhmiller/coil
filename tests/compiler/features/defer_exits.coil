(module defer-exits)
; `(defer* cleanup)` -- the core form behind `defer` -- guards the rest of its
; body: the cleanup runs when control leaves that body by any route, innermost
; first, after a break's value has been computed. The routes here include every
; macro in coil.try that leaves a `try` block.

(defsum E (Bad))

(defn fail [] (-> (Result i64 E)) (Err (Bad)))

(defn none [] (-> (Option i64)) (None [i64]))

(defn via-try! [] (-> (Result i64 E))
  (try (block :inner (defer* (println "try! cleanup")) (try! (fail)) (Ok 1))))

(defn via-try? [] (-> (Option i64))
  (try (block :s (defer* (println "try? cleanup")) (try? (none)) (Some 1))))

(defn via-try-or [] (-> i64)
  (try (block :s (defer* (println "try-or! cleanup")) (try-or! (fail) 7) 1)))

(defn via-some-or [] (-> i64)
  (try (block :s (defer* (println "some-or! cleanup")) (some-or! (none) 8) 1)))

(defn via-ensure [(n i64)] (-> i64)
  (try (block :s (defer* (println "ensure! cleanup {}" n)) (ensure! (> n 0) 9) n)))

;; LIFO within a body, inner body before outer.
(defn nested [] (-> (Result i64 E))
  (try
    (block :outer
      (defer* (println "outer 1"))
      (defer* (println "outer 2"))
      (block :inner
        (defer* (println "inner 1"))
        (defer* (println "inner 2"))
        (try! (fail))
        (Ok 0)))))

;; continue and break to a loop outside the guarded body.
(defn loops [] (-> i64)
  (let [(mut total) 0]
    (for i (range 0 4)
      (block :body
        (defer* (println "iteration {} done" i))
        (when (= i 1) (continue))
        (when (= i 3) (break))
        (set! total (+ total i))))
    total))

;; a labelled break past several loops and a block
(defn labelled [] (-> i64)
  (loop :outer
    (loop
      (block :s
        (defer* (println "leaving s"))
        (break :outer 42)))))

(defn returned [] (-> i64)
  (block :s
    (defer* (println "return-from cleanup"))
    (return-from :s 5)
    6))

;; The value leaving is the one it had before the cleanup ran.
(defn value-first [] (-> i64)
  (let [(mut n) 1]
    (let [r (block :s
              (defer* (set! n 100))
              (return-from :s n))
          (mut m) 2
          t (do (defer* (set! m 200)) m)]
      (println "break value {} after {}; tail value {} after {}" r n t m)
      (+ r t))))

;; A defer that is never reached registers nothing.
(defn unreached [(early bool)] (-> i64)
  (block :s
    (when early (return-from :s 1))
    (defer* (println "reached"))
    2))

(defn fn-body [] (-> i64)
  (defer* (println "function body cleanup"))
  (println "function body")
  3)

(defn let-body [] (-> i64)
  (let [x 4]
    (defer* (println "let body cleanup {}" x))
    (println "let body")
    x))

(defn loop-body [] (-> i64)
  (let [(mut i) 0]
    (while (< i 3)
      (defer* (set! i (+ i 1)))
      (println "loop body {}" i))
    i))

;; A comptime thunk is compiled with the functions its cleanups call.
(defn folded [] (-> i64)
  (comptime (block :b (defer* (+ 1 2)) 5)))

(defn main [] (-> i64)
  (match (via-try!) (Ok [_] (println "ok")) (Err [_] (println "err")))
  (match (via-try?) (Some [_] (println "some")) (None [] (println "none")))
  (println "{}" (via-try-or))
  (println "{}" (via-some-or))
  (println "{}" (via-ensure 0))
  (println "{}" (via-ensure 2))
  (match (nested) (Ok [_] (println "ok")) (Err [_] (println "err")))
  (let [total (loops)] (println "loops {}" total))
  (let [v (labelled)] (println "labelled {}" v))
  (let [v (returned)] (println "returned {}" v))
  (value-first)
  (let [a (unreached true) b (unreached false)] (println "unreached {} {}" a b))
  (let [v (fn-body)] (println "{}" v))
  (let [v (let-body)] (println "{}" v))
  (let [v (loop-body)] (println "{}" v))
  (println "folded {}" (folded))
  0)
