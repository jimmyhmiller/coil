(module compiler.features.jit-repl-impl-replace)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Under the `coil.repl` publish policy a function submitted again replaces the
;; accepted one, and so does an impl: trait, inherent and generic impls alike.
;; The compiler keeps its duplicate-impl error; the policy says the earlier impl
;; is being replaced. Code accepted earlier keeps the impl it bound.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rep.m)
         (import \"coil.repl\")
         (deftrait Shape [Self] (perimeter [(self Self)] (-> i64)))
         (defstruct Sq [(side i64)])
         (defstruct Box [T] [(item T)])
         (deftrait Size [Self] (size [(self Self)] (-> i64)))
         (impl Shape Sq (perimeter [(self Sq)] (-> i64) (* 4 (.side self))))
         (impl Sq (twice [(self Sq)] (-> i64) (* 2 (.side self))))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) 1))
         (defn old-perimeter [] (-> i64) (perimeter (Sq :side 2)))
         (defn old-twice [] (-> i64) (twice (Sq :side 2)))
         (defn old-size [] (-> i64) (size (Box :item 5)))"
        "(coil.repl/publish)") 0) 1
      ; The same three impls, submitted again with new bodies, replace them.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rep.m)
         (impl Shape Sq (perimeter [(self Sq)] (-> i64) (* 5 (.side self))))
         (impl Sq (twice [(self Sq)] (-> i64) (* 3 (.side self))))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) 2))
         (defn new-perimeter [] (-> i64) (perimeter (Sq :side 2)))
         (defn new-twice [] (-> i64) (twice (Sq :side 2)))
         (defn new-size [] (-> i64) (size (Box :item 5)))"
        "(coil.repl/publish)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rep.m)"
        "(if (and (= (rep.m.new-perimeter) 10)
                  (and (= (rep.m.new-twice) 6)
                       (and (= (rep.m.new-size) 2)
                            (and (= (rep.m.old-perimeter) 8)
                                 (and (= (rep.m.old-twice) 4) (= (rep.m.old-size) 1))))))
             0 1)") 0) 3
      ; A submission declaring one impl twice is still a duplicate.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module rep.m)
         (impl Shape Sq (perimeter [(self Sq)] (-> i64) 1))
         (impl Shape Sq (perimeter [(self Sq)] (-> i64) 2))"
        "(coil.repl/publish)") 0) 4
      ; ...and a session without the publish policy stays static.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rep.m)"
        "(if (= (rep.m.new-perimeter) 10) 0 1)") 0) 5
      :else (jit/jit-reset! (mut session)))))
