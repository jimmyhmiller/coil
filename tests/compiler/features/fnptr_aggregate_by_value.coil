;; `c` function pointers that take structs: anonymous functions and `fnptr-of`
;; ascribed a by-value C signature reach the function through a C entry; a
;; `(ref T)` pointer is what a named function's `fnptr-of` already is; constants
;; hold function pointers and are call heads; 4-byte structs survive the C ABI.
(module fnptr-aggregate-by-value)
(import "coil.primitive" :as primitive)

(defstruct S4 [(a i32)])
(defstruct Point [(x i64) (y i64)])

(defn take [(s S4)] (-> i64) (primitive/cast i64 (.a s)))
(defn px [(p Point)] (-> i64) (.y p))
(defn add [(p Point) (q Point)] (-> i64) (+ (.x p) (.y q)))
(defn two [(p S4) (q S4)] (-> i32) (+ (.a p) (.a q)))
(export-c two)
(defn inc [(x i64)] (-> i64) (+ x 1))
(defn fwd [(s S4)] (-> i64) (take s))

(const TAKE (fnptr c [S4] i64) (fnptr-of take))
(const BY-REF (fnptr c [(ref S4)] i64) (fnptr-of take))
(const INC (fnptr c [i64] i64) (fnptr-of inc))
(const LAMBDA (fnptr c [i64] i64) (fn [x] (* x 2)))
(const CALLED i64 (fwd (S4 :a 5)))

(defn main [] (-> i64)
  (let [f (: (fn [p] (+ (.x p) (* 10 (.y p)))) (fnptr c [Point] i64))
        g (: (fn [p q] (+ (.a p) (.a q))) (fnptr c [S4 S4] i32))
        r (: (fn [p] (.y p)) (fnptr c [(ref Point)] i64))
        cb (: (fnptr-of take) (fnptr c [S4] i64))
        cp (: (fnptr-of px) (fnptr c [Point] i64))
        rr (: (fnptr-of add) (fnptr c [(ref Point) (ref Point)] i64))
        t2 (: (fnptr-of two) (fnptr c [S4 S4] i32))
        pt (Point :x 5 :y 6)]
    (println "anon {} {} {}" (f (Point :x 1 :y 2)) (g (S4 :a 3) (S4 :a 4)) (r pt))
    (println "fnptr-of {} {} {}" (cb (S4 :a 7)) (cp (Point :x 1 :y 2)) (rr (Point :x 1 :y 1) pt))
    (println "export {}" (t2 (S4 :a 3) (S4 :a 4)))
    (println "call-ptr {} {}" (primitive/call-ptr cb (S4 :a 8)) (primitive/call-ptr BY-REF (S4 :a 9)))
    (println "consts {} {} {} {}" (TAKE (S4 :a 100)) (INC 41) (LAMBDA 21) CALLED)
    0))
