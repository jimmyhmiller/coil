;; `c` function pointers whose parameters are aggregates, by reference:
;; an anonymous function's pointer has the `(ref T)` surface a
;; named function's `fnptr-of` has; constants hold function pointers and are call
;; heads; a constant's initializer calls a function taking a struct; call-ptr and
;; Callable calls borrow struct temporaries. fnptr_c_by_value.coil covers the
;; by-value C entries.
(module fnptr-aggregate-by-value)
(import "coil.primitive" :as primitive)

(defstruct S4 [(a i32)])
(defstruct Point [(x i64) (y i64)])

(defn take [(s S4)] (-> i64) (primitive/cast i64 (.a s)))
(defn add [(p Point) (q Point)] (-> i64) (+ (.x p) (.y q)))
(defn inc [(x i64)] (-> i64) (+ x 1))
(defn fwd [(s S4)] (-> i64) (take s))

(const BY-REF (fnptr c [(ref S4)] i64) (fnptr-of take))
(const INC (fnptr c [i64] i64) (fnptr-of inc))
(const LAMBDA (fnptr c [i64] i64) (fn [x] (* x 2)))
(const CALLED i64 (fwd (S4 :a 5)))

(defn main [] (-> i64)
  (let [r (: (fn [p] (.y p)) (fnptr c [(ref Point)] i64))
        rr (: (fnptr-of add) (fnptr c [(ref Point) (ref Point)] i64))
        pt (Point :x 5 :y 6)]
    (println "anon {}" (r pt))
    (println "fnptr-of {} {}" (rr pt pt) (rr (Point :x 1 :y 1) pt))
    (println "call-ptr {}" (primitive/call-ptr BY-REF (S4 :a 9)))
    (println "consts {} {} {}" (INC 41) (LAMBDA 21) CALLED)
    0))
