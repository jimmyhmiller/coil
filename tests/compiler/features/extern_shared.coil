; Two modules declaring the same C function export one entity: `:use *` of both
; is not an ambiguity, and the bare name calls the shared symbol.
(module coil.tests.extern-shared)
(import "coil.tests.extern-shared-a" :use *)
(import "coil.tests.extern-shared-b" :use *)

(defn main [] (-> i64)
  (println "{} {} {}" (a-len c"abc") (b-len c"hello") (strlen c"xy"))
  0)
