(module compiler.features.jit-param-remove-edit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Idle published function: no accepted callers or captured pointers need repair.
; Removing a parameter must publish successfully before probing the new arity.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        initial (jit/jit-compile-with-entry! (mut session)
                  "(import \"coil.repl\")
                   (defn damage [(t i64) (amount f32)] (-> f32) amount)"
                  "(coil.repl/publish)")]
    (println "initial status: {}" initial)
    (if (!= initial 0)
      (do (println "{}" (jit/jit-diagnostic (mut session))) 10)
      (let [removal (jit/jit-compile-with-entry! (mut session)
                      "(defn damage [(t i64)] (-> f32) (cast f32 1.0))"
                      "(coil.repl/publish)")]
        (println "removal status: {}" removal)
        (if (!= removal 0)
          (do (println "{}" (jit/jit-diagnostic (mut session))) 11)
          (let [probe (jit/jit-compile-with-entry! (mut session) ""
                        "(if (= (damage 7) (cast f32 1.0)) 0 12)")]
            (println "probe status: {}" probe)
            (if (!= probe 0)
              (do (println "{}" (jit/jit-diagnostic (mut session))) 12)
              (jit/jit-session-free! (mut session)))))))))
