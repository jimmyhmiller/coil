(module ownership_move_out_of_place)
(import "coil.primitive" :as primitive)

; The sanctioned ways to own what a named value holds. Each owner is dropped
; exactly once; `drops` records the order as decimal digits.

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (drops) (+ (* (load (drops)) 10) (.value self)))))

; Matching on `(take! (mut r))` binds the payload by value.
(defn take-scrutinee [] (-> i64)
  (let [(mut r) (Ok [Owner i64] (Owner :value 1))]
    (match (take! (mut r))
      (Ok [v] (.value v))
      (Err [_] 0))))

; A by-value owner parameter moves into a mutable binding.
(defn rebind-parameter [(r (Result Owner i64))] (-> i64)
  (let [(mut owned) r]
    (match (take! (mut owned))
      (Ok [v] (.value v))
      (Err [_] 0))))

; A mutable bool local is a condition like any other value.
(defn mutable-condition [(c bool)] (-> i64)
  (let [(mut b) c]
    (set! b (not b))
    (if b 3 4)))

(defn main [] (-> i64)
  (store! (drops) 0)
  (println "{} {} {}"
           (take-scrutinee)
           (rebind-parameter (Ok (Owner :value 2)))
           (mutable-condition false))
  (println "dropped {}" (load (drops)))
  0)
