(module generated_named_constructor)
(import "coil.primitive" :as primitive)

(defn make-constructor [(name Code) (field-name Code) (value Code)] (-> Code)
  (let [keyword (primitive/code-symbol ":" field-name)]
    `(~name ~keyword ~value)))

(defstruct Payload [(answer i64)])

(defn main [] (-> i64)
  (.answer (make-constructor Payload answer 42)))
