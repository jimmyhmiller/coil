;; `(comptime …)` directly as a const's value is the const's value, and one
;; inside a runtime `def` initializer is folded like one in a function body.
(module comptime-in-const-and-def)
(import "coil.primitive" :as primitive)

(defstruct S [(a i64) (b bool) (c i64)])
(const OFF-C (comptime (primitive/offsetof S c)))
(const NESTED (comptime (comptime (+ 40 2))))

(defn six [] (-> i64) 6)
(def seven-sixes (comptime (* 7 (six))))

(defn main [] (-> i64)
  (println "offset {}" OFF-C)
  (println "nested {}" NESTED)
  (println "def {}" seven-sixes)
  0)
