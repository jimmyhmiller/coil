(module ownership_discarded_result_drop)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))]
        (-> void)
        (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defstruct Holder [(leaf Leaf)])

(defn make [(value i64)] (-> Leaf) (Leaf :value value))
(defn make-some [(value i64)] (-> (Option Leaf)) (Some (Leaf :value value)))
(defn peek [(holder (ref Holder))] (-> (ref Leaf)) (field holder leaf))
(defn wrap [T] [(value T)] (-> (Option T)) (Some value))

; A call or constructor result that no one receives is a fresh owner: it is
; dropped at the end of its statement, before the next statement runs.
(defn fresh-results [] (-> i64)
  (store! (counter) 0)
  (make 1)
  (make-some 2)
  (Some (Leaf :value 3))
  (if (= (load (counter)) 123) (make 4) (make 5))
  (match (Some (load (counter)))
    (Some [_] (make 6))
    (None [] (make 7)))
  (do (make 8) 0)
  (load (counter)))

; Discarding a result in a generic instance drops it; a Copy instance owns nothing.
(defn discard-generic [T] [(value T)] (-> i64)
  (wrap value)
  0)

(defn generic-results [] (-> i64)
  (store! (counter) 0)
  (discard-generic (Leaf :value 9))
  (discard-generic 5)
  (load (counter)))

; Naming an existing place as a statement neither moves nor drops it, and a
; borrowed result owns nothing. Only scope exit drops the holder's leaf.
(defn places-and-borrows [] (-> i64)
  (store! (counter) 0)
  (let [holder (Holder :leaf (Leaf :value 1))
        leaf (Leaf :value 2)]
    leaf
    (.leaf holder)
    (peek holder)
    (if (= (load (counter)) 0) leaf leaf)
    (store! (counter) (+ (load (counter)) 5)))
  ; 5, then reverse initialization order: leaf 2, then holder's leaf 1.
  (load (counter)))

; `take!` moves the value out; discarding what it returns drops it once, and
; the reinitialized owner is dropped once more at scope exit.
(defn discarded-take [] (-> i64)
  (store! (counter) 0)
  (let [(mut owner) (Leaf :value 3)]
    (take! (mut owner))
    (store! owner (Leaf :value 4)))
  (load (counter)))

; A loop body's value is discarded on every iteration, the tail included.
(defn loop-results [] (-> i64)
  (store! (counter) 0)
  (let [(mut i) 0]
    (loop (if (>= i 3)
              (break)
              (do
                (set! i (+ i 1))
                (make i)))))
  (load (counter)))

(defn main [] (-> i64)
  (let [fresh (fresh-results)
        generic (generic-results)
        places (places-and-borrows)
        taken (discarded-take)
        looped (loop-results)]
    (cond (!= fresh 123468) 1
          (!= generic 9) 2
          (!= places 521) 3
          (!= taken 34) 4
          (!= looped 123) 5
          :else 0)))
