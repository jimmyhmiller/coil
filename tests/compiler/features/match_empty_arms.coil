; An arm with no body yields no value: it is written for its effect, where the
; match is a statement.
(module match-empty-arms)

(defn log-opt [(o (Option i64))] (-> void)
  (match o
    (Some [x] (println "some {}" x))
    (None [])))

(defn count-evens [(xs (slice i64))] (-> i64)
  (let [(mut n) 0]
    (for x xs
      (match (% x 2)
        (0 (set! n (+ n 1)))
        (_)))
    n))

(defn main [] (-> i64)
  (log-opt (Some 3))
  (log-opt (None))
  (println "{}" (count-evens [1 2 3 4 6]))
  0)
