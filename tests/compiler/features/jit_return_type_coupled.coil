(module compiler.features.jit-return-type-coupled)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A dependent caller in the same edit must see the replacement sum return.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(module coupled-edit) (import \"coil.repl\")
       (defn damage [(x f32)] (-> f32) x)
       (defn fight [] (-> i64) (if (= (damage (cast f32 3)) (cast f32 3)) 0 1))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) "" "(fight)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(defsum HitResult (Hit [(value f32)]) (Miss))
       (defn damage [(x f32)] (-> HitResult) (Hit x))
       (defn fight [] (-> i64)
         (match (damage (cast f32 3))
           (Hit [n] (if (= n (cast f32 3)) 0 1))
           (Miss [] 2)))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) "" "(fight)") 0))
    (jit/jit-reset! (mut session))))
