(module test.const-generic-values)
(import "coil.primitive" :as p)

;; Value generic parameters of each allowed kind, used as struct arguments.
(defstruct Quantity [(const Unit Keyword)] [(value i64)])
(defstruct Flagged [T (const On bool)] [(x T)])
(defstruct Tagged [T (const Id i64)] [(x T)])

(defn meters [(q (Quantity :meters))] (-> i64) (.value q))
(defn feet [(q (Quantity (const :feet)))] (-> i64) (.value q))
(defn on [(f (Flagged i64 true))] (-> i64) (.x f))
(defn off [(f (Flagged i64 false))] (-> i64) (p/isub 0 (.x f)))
(defn seven [(t (Tagged u8 7))] (-> i64) (p/cast i64 (.x t)))

;; Value parameters pass through generic functions and are inferred from arguments.
(defn tagged-x [T (const N i64)] [(t (Tagged T N))] (-> T) (.x t))
(defn quantity-value [(const U Keyword)] [(q (Quantity U))] (-> i64) (.value q))
(defn flag-x [(const On bool)] [(f (Flagged i64 On))] (-> i64) (.x f))
(defn retag [T (const N i64)] [(x T)] (-> (Tagged T N)) (Tagged [T N] :x x))

(defn check-pass-through [] (-> i64)
  (let [t (Tagged [i64 3] :x 5)
        q (Quantity [(const :meters)] :value 6)
        f (Flagged [i64 false] :x 7)
        r (retag [u8 9] (cast u8 8))]
    (assert-eq (tagged-x t) 5)
    (assert-eq (quantity-value q) 6)
    (assert-eq (flag-x f) 7)
    (assert-eq (cast i64 (tagged-x r)) 8)
    0))

;; Value parameters used as expressions evaluate to their specialized value.
(defn length-of [(const N i64)] [(xs (array i64 N))] (-> i64) N)
(defn sum-first [(const N i64)] [(xs (array i64 N))] (-> i64)
  (let [(mut total) 0]
    (for [i 0 N] (set! total (+ (load total) (get (: xs (slice i64)) i))))
    (load total)))
(defn unit-of [(const U Keyword)] [(q (Quantity U))] (-> Keyword) U)
(defn flag-of [(const On bool)] [(f (Flagged i64 On))] (-> bool) On)
(defn small [(const N u8)] [] (-> u8) N)
(defn shadowed [(const N i64)] [(xs (array i64 N))] (-> i64) (let [N 100] N))

(defn check-values [] (-> i64)
  (let [three [1 2 3]
        m (Quantity [(const :meters)] :value 1)
        yes (Flagged [i64 true] :x 1)
        no (Flagged [i64 false] :x 1)]
    (assert-eq (length-of three) 3)
    (assert-eq (length-of [1 2 3 4 5]) 5)
    (assert-eq (sum-first three) 6)
    (assert (= (match (unit-of m) (KeywordValue [name] name)) "meters"))
    (assert (flag-of yes))
    (assert (not (flag-of no)))
    (assert-eq (small [(const 200)]) (cast u8 200))
    (assert-eq (shadowed three) 100)
    0))

(defn main [] (-> i64)
  (let [m (Quantity [(const :meters)] :value 10)
        f (Quantity [(const :feet)] :value 3)
        a (Flagged [i64 true] :x 20)
        b (Flagged [i64 false] :x 1)
        t (Tagged [u8 7] :x 10)]
    (assert-eq (meters m) 10)
    (assert-eq (feet f) 3)
    (assert-eq (on a) 20)
    (assert-eq (off b) -1)
    (assert-eq (seven t) 10)
    (check-pass-through)
    (check-values)))
