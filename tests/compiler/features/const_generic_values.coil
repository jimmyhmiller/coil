(module test.const-generic-values)
(import "coil.primitive" :as p)

;; Value generic parameters of each allowed kind, used as struct arguments.
(defstruct Quantity [(const Unit Keyword)] [(value i64)])
(defstruct Flagged [T (const On bool)] [(x T)])
(defstruct Tagged [T (const Id i64)] [(x T)])

(defn meters [(q (Quantity (const :meters)))] (-> i64) (.value q))
(defn feet [(q (Quantity (const :feet)))] (-> i64) (.value q))
(defn on [(f (Flagged i64 true))] (-> i64) (.x f))
(defn off [(f (Flagged i64 false))] (-> i64) (p/isub 0 (.x f)))
(defn seven [(t (Tagged u8 7))] (-> i64) (p/cast i64 (.x t)))

(defn main [] (-> i64)
  (let [m (Quantity [(const :meters)] :value 10)
        f (Quantity [(const :feet)] :value 3)
        a (Flagged [i64 true] :x 20)
        b (Flagged [i64 false] :x 1)
        t (Tagged [u8 7] :x 10)]
    (assert-eq (meters m) 10)
    (assert-eq (feet f) 3)
    (assert-eq (on a) 20)
    (assert-eq (off b) -1)
    (assert-eq (seven t) 10)
    0))
