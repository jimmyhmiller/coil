(module test.aggregate-spill-snapshot)
(import "coil.primitive" :as p)

(defstruct Item [(a i64) (b i64) (c i64) (d i64) (e i64) (f i64)])
(defstruct Table [(items (array Item 128)) (flags (array bool 128))])

(defn replace-and-index [(table (ptr Table)) (i i64)] (-> i64)
  (set! (p/index (field table items) i) (Item :a 91 :b 92 :c 93 :d 94 :e 95 :f 96))
  (set! (p/index (field table flags) i) false)
  i)

; The array argument is evaluated before the index argument. Materialization
; must snapshot it even if evaluating that index modifies the original storage.
(defn read-item [(table (ptr Table)) (i i64)] (-> Item)
  (get (.items table) i))

(defn snapshot [(table (ptr Table)) (i i64)] (-> Item)
  (get (.items table) (replace-and-index table i)))

(defn flag-snapshot [(table (ptr Table)) (i i64)] (-> bool)
  (get (.flags table) (replace-and-index table i)))

(defn main [] (-> i64)
  (let [table (p/alloc-stack Table)]
    (set! table (p/zeroed Table))
    (set! (p/index (field table items) 73) (Item :a 1 :b 2 :c 3 :d 4 :e 5 :f 6))
    (assert-eq (.f (read-item table 73)) 6)
    (let [item (snapshot table 73)]
      (assert-eq (.a item) 1)
      (assert-eq (.f item) 6)
      (assert-eq (.a (load (p/index (field table items) 73))) 91))
    (set! (p/index (field table flags) 73) true)
    (assert (flag-snapshot table 73))
    (assert (not (load (p/index (field table flags) 73))))
    0))
