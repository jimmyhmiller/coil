(module ownership_control_exit_drops)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn record [(value i64)] (-> void)
  (store! (counter) (+ (* (load (counter)) 10) value)))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (record (.value self))))

(defn labeled-break-drops [] (-> i64)
  (store! (counter) 0)
  (loop :outer
    (let [outer-owner (Owner :value 1)]
      (loop :inner
        (let [inner-owner (Owner :value 2)]
          (break :outer)))))
  ; The labeled edge crosses both lets: inner owner, then outer owner.
  (load (counter)))

(defn continue-drops [] (-> i64)
  (store! (counter) 0)
  (let [(mut i) 0]
    (loop (let [iteration-owner (Owner :value (+ (load i) 1))]
            (set! i (+ (load i) 1))
            (if (< (load i) 2)
                (continue)
                (break)))))
  ; Each iteration owns a fresh value and both exit kinds cross its scope.
  (load (counter)))

(defn break-value-survives-cleanup [] (-> i64)
  (store! (counter) 0)
  (let [value
          (loop (let [owner (Owner :value 3)]
                  (break 4)))]
    ; ECleanup must preserve the edge value while dropping the crossed owner.
    (+ (* (load (counter)) 10) value)))

(defn main [] (-> i64)
  ; 21 from the labeled break, 12 from continue+break, and 34 from a
  ; value-carrying break whose cleanup runs before control transfers.
  (+ (+ (labeled-break-drops) (continue-drops))
     (break-value-survives-cleanup)))
