; Nested variant patterns are compiled to a decision tree, so arms that each test
; one nested variant can together cover their outer variant, and names bind by
; reference exactly as they do in a plain arm.
(module match-nested-exhaustive)
(import "coil.io" :as io :use [IoError])

(defsum Fault (A) (B) (C [(code i64)]))
(defsum Pair (P [(left (Option i64)) (right (Option i64))]))

(defstruct Tok [(n i64)])
(impl Drop Tok
  (drop [(self (mut Tok))] (-> void)
    (println "drop tok {}" (.n self))
    0))
(defsum Slot (Full [(t Tok)]) (Vacant))

; every nested variant is covered, so no catch-all is needed; `(B)` is the
; nullary variant pattern, the same as `(B [])`
(defn code-of [(r (Result i64 Fault))] (-> i64)
  (match r
    (Err [(A [])] 1)
    (Err [(B)] 2)
    (Err [(C [code])] code)
    (Ok [v] v)))

; arms that call a void function
(defn report [(n i64)] (-> void) (println "report {}" n))
(defn report-nested [(r (Option (Option i64)))] (-> void)
  (match r
    (Some [(Some [n])] (report n))
    (_ (report 0))))

; the third arm is reached from two branches of the tree; its names bind once
(defn pair [(p Pair)] (-> i64)
  (match p
    (P [_ (Some [7])] 700)
    (P [(Some [x]) _] x)
    (P [_ (Some [y])] (* 10 y))
    (P [(None) (None)] -1)))

; a variant the scrutinee's own sum declares needs no import
(defn errno [(e IoError)] (-> i64)
  (match e
    (Errno [c] c)
    (_ -1)))

; an arm names a variant of the scrutinee's sum even where another sum's variant
; of that name is in scope
(defsum Reading (Eof) (Partial [(n i64)]))

(defn at-end [(e IoError)] (-> i64)
  (match e
    (Eof [] 1)
    (_ 0)))

(defn reading [(r Reading)] (-> i64)
  (match r
    (Eof [] 0)
    (Partial [n] n)))

; an owned payload is bound by reference: nothing moves out of the scrutinee
(defn slot-n [(o (Option Slot))] (-> i64)
  (match o
    (Some [(Vacant)] 0)
    (Some [(Full [t])] (.n t))
    (None [] -1)))

; `as` names the whole nested value while its variant is tested
(defn whole [(r (Result i64 Fault))] (-> i64)
  (match r
    (Err [(as e (C [n]))] (+ (* 100 n) (code-of (Err e))))
    (Err [_] -2)
    (Ok [v] v)))

; `(mut name)` binds a mutable copy, in a match arm and in let
(defn bump [(r (Result i64 i64))] (-> i64)
  (match r
    (Ok [(mut v)] (set! v (+ v 1)) v)
    (Err [e] e)))

(defn bump-nested [(o (Option (Option i64)))] (-> i64)
  (match o
    (Some [(Some [(mut n)])] (set! n (* n 2)) n)
    (_ 0)))

(defn bump-let [] (-> i64)
  (let [[(mut a) b] [1 2]]
    (set! a 10)
    (+ a b)))

(defn main [] (-> i64)
  (println "{} {} {} {}" (code-of (Err (A))) (code-of (Err (B))) (code-of (Err (C 7))) (code-of (Ok 9)))
  (report-nested (Some (Some 3)))
  (report-nested (Some (None)))
  (report-nested (None))
  (println "{} {} {} {} {}"
           (pair (P (Some 1) (Some 7)))
           (pair (P (Some 3) (Some 2)))
           (pair (P (None) (Some 4)))
           (pair (P (None) (None)))
           (pair (P (Some 5) (None))))
  (println "{} {}" (errno (io/Errno 2)) (errno (io/Eof)))
  (println "{} {} {} {}" (at-end (io/Eof)) (at-end (io/Errno 2)) (reading (Partial 5)) (reading (Eof)))
  (println "{} {} {}" (slot-n (Some (Full (Tok :n 4)))) (slot-n (Some (Vacant))) (slot-n (None)))
  (println "{} {} {}" (whole (Err (C 3))) (whole (Err (A))) (whole (Ok 8)))
  (let [n 5]
    (println "{} {} {} {}" (bump (Ok n)) (bump (Err -3)) (bump-nested (Some (Some n))) n))
  (println "{}" (bump-let))
  0)
