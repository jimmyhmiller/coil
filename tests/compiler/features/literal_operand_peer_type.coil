(module literal-operand-peer-type)

; A literal operand takes the type of the operand beside it, on either side.

(defn sub-from [(x u8)] (-> u8) (- 8 x))
(defn above? [(x u8)] (-> bool) (< 3 x))
(defn scale [(y f32)] (-> f32) (* 2.0 y))
(defn sum3 [(x u16) (y u16)] (-> u16) (+ 1 x y))
(defn same? [(x i32)] (-> bool) (= 7 x))

(defn main [] (-> i64)
  (println "{} {} {} {} {} {}" (sub-from 3) (above? 5) (above? 2) (scale 1.5) (sum3 2 3) (same? 7))
  0)
