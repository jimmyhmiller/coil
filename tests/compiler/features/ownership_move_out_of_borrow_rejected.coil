(module ownership-move-out-of-borrow-rejected)

; `(mut b)` lends b. A parameter that takes an owner by value cannot be handed
; a borrow: that silently copied the owner, and both copies were dropped.

(defstruct Bag [(n i64)])

(impl Drop Bag
  (drop [(self (mut Bag))] (-> void)
    (println "drop bag {}" (.n self))
    0))

(impl Len Bag
  (len [(b Bag)] (-> i64) (.n b)))

(defn main [] (-> i64)
  (let [(mut b) (Bag :n 3)]
    (println "len {}" (len (mut b)))
    0))
