(module sparse.static)
(import "coil.primitive" :as p)

(defn storage [] (-> (ptr (array i64 708334)))
  (p/alloc-static (array i64 708334) :elements [(0 1) (708333 42)]))
(export-c [storage :as "sparse_storage"])

(defn nested [] (-> (ptr (array (array i64 708334) 2)))
  (p/alloc-static (array (array i64 708334) 2)
    :elements [(1 (:elements [(708333 73)]))]))
(export-c [nested :as "sparse_nested"])

(defn empty [] (-> (ptr (array i64 708334)))
  (p/alloc-static (array i64 708334) :elements []))
(export-c [empty :as "sparse_empty"])

;; A parent sorted before its by-value child must not cache the child's opaque
;; LLVM size. Explicit tail padding also participates in the array stride.
(defstruct AParent :layout explicit :size 64 :align 32
  [(left ZChild :at 0) (right ZChild :at 32)])
(defstruct ZChild :layout explicit :size 32 :align 32
  [(first i64 :at 0) (last i64 :at 8)])
(defn records [] (-> (ptr (array AParent 16)))
  (p/alloc-static (array AParent 16) :elements
    [(9 (AParent :left (ZChild :first 11 :last 22) :right (ZChild :first 33 :last 44)))]))
(export-c [records :as "sparse_records"])

(defn answer [] (-> i64) 81)
(defn callbacks [] (-> (ptr (array (fnptr c [] i64) 708334)))
  (p/alloc-static (array (fnptr c [] i64) 708334) :elements [(708333 (p/fnptr-of answer))]))
(export-c [callbacks :as "sparse_callbacks"])

(extern sparse-native-check [] (-> i64))
(defn main [] (-> i64) (sparse-native-check))
