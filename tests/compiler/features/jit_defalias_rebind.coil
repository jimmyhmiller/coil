(module compiler.features.jit-defalias-rebind)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A retained session may rebind an alias. New references resolve to the new
;; target from every module; code accepted earlier keeps its original target.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rebind.m)
         (defstruct P-v1 [(x i64)])
         (defalias P P-v1)
         (defn get-v1 [(p P)] (-> i64) (.x p))
         (defalias get get-v1)
         (defn mac-v1 [(e Code)] (-> Code) `(+ 1 ~e))
         (defalias mac mac-v1)
         (defsum S-v1 (A-v1 [(n i64)]))
         (defalias S S-v1)
         (defalias A A-v1)"
        "0") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rebind.n)
         (defn old [] (-> i64) (rebind.m.mac (rebind.m.get (rebind.m.P :x 41))))"
        "(if (= (rebind.n.old) 42) 0 1)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rebind.m)
         (defstruct P-v2 [(x i64) (y i64)])
         (defalias P P-v2)
         (defn get-v2 [(p P)] (-> i64) (+ (.x p) (.y p)))
         (defalias get get-v2)
         (defalias helper helper-v2)
         (defn helper-v2 [] (-> i64) 7)
         (defn alias-before-target [] (-> i64) (helper))
         (defn mac-v2 [(e Code)] (-> Code) `(+ 100 ~e))
         (defalias mac mac-v2)
         (defsum S-v2 (A-v2 [(n i64)]) (B-v2))
         (defalias S S-v2)
         (defalias A A-v2)
         (defalias B B-v2)"
        "(if (= (rebind.m.alias-before-target) 7) 0 1)") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module rebind.n)
         (defn new [] (-> i64) (rebind.m.mac (rebind.m.get (rebind.m.P :x 1 :y 2))))
         (defn variant [(s rebind.m.S)] (-> i64) (match s (rebind.m.A [n] n) (rebind.m.B [] 7)))"
        "(if (and (= (rebind.n.new) 103) (and (= (rebind.n.old) 42) (= (rebind.n.variant (rebind.m.B)) 7))) 0 1)") 0) 4
      ; A single submission may not bind one alias twice.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module rebind.m) (defalias P P-v1) (defalias P P-v2)"
        "0") 0) 5
      :else (jit/jit-reset! (mut session)))))
