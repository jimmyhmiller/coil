(module rc_arc_owner_apis)
(import "coil.primitive" :as primitive)
(import "coil.rc" :as rc)
(import "coil.arc" :as arc)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Payload [(answer i64)])

(impl Drop Payload
  (drop [(self (mut Payload))] (-> void)
    (store! (drops) (+ (load (drops)) 1))))

(defn run-rc [] (-> i64)
  (store! (drops) 0)
  (let [answer
          (block :rc
            (match (rc/rc-new (Payload :answer 10))
              (None [] (break :rc 100))
              (Some [initial]
                (let [(mut owner) (load initial)]
                  (match (rc/rc-get-mut (mut owner))
                    (None [] (break :rc 101))
                    (Some [value] (store! (field value answer) 20)))
                  (let [weak (rc/rc-downgrade owner)]
                    (match (rc/rc-get-mut (mut owner))
                      (None [] 0)
                      (Some [_] (break :rc 102))))
                  (match (rc/rc-get-mut (mut owner))
                    (None [] (break :rc 103))
                    (Some [_] 0))
                  (let [raw (rc/rc-into-raw owner)
                        adopted (rc/unsafe-rc-from-raw raw)]
                    (match (rc/rc-try-unwrap adopted)
                      (Err [_] (break :rc 104))
                      (Ok [payload] (.answer payload))))))))]
    (+ answer (load (drops)))))

(defn run-arc [] (-> i64)
  (store! (drops) 0)
  (let [answer
          (block :arc
            (match (arc/arc-new (Payload :answer 10))
              (None [] (break :arc 100))
              (Some [initial]
                (let [(mut owner) (load initial)]
                  (match (arc/arc-get-mut (mut owner))
                    (None [] (break :arc 101))
                    (Some [value] (store! (field value answer) 20)))
                  (let [weak (arc/arc-downgrade owner)]
                    (match (arc/arc-get-mut (mut owner))
                      (None [] 0)
                      (Some [_] (break :arc 102))))
                  (match (arc/arc-get-mut (mut owner))
                    (None [] (break :arc 103))
                    (Some [_] 0))
                  (let [raw (arc/arc-into-raw owner)
                        adopted (arc/unsafe-arc-from-raw raw)]
                    (match (arc/arc-try-unwrap adopted)
                      (Err [_] (break :arc 104))
                      (Ok [payload] (.answer payload))))))))]
    (+ answer (load (drops)))))

(defn main [] (-> i64)
  (+ (run-rc) (run-arc)))
