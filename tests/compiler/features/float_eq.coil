(module test.float-eq)
(import "coil.assert" :use *)

;; Floats compare with IEEE `=`: NaN equals nothing, itself included, -0.0 equals
;; 0.0, and `!=` (not `=`) holds whenever either side is NaN.
(defstruct Sample [(at f64) (gain f32)])

(derive Eq Sample)

(defn nan [] (-> f64)
  (/ 0.0 0.0))

(defn main [] (-> i64)
  (assert (= 1.5 1.5))
  (assert (not (= (nan) (nan))))
  (assert (!= (nan) (nan)))
  (assert (!= (nan) 1.0))
  (assert (= -0.0 0.0))
  (assert (= (: 2.5 f32) (: 2.5 f32)))
  (assert (not (= (: 2.5 f32) (: 2.25 f32))))
  (assert (= (Sample :at 1.0 :gain 0.5) (Sample :at 1.0 :gain 0.5)))
  (assert (not (= (Sample :at (nan) :gain 0.5) (Sample :at (nan) :gain 0.5))))
  (assert (= (case 2.0 1.0 10 2.0 20 30) 20))
  0)
