; io/print-int writes a leading `-` for negative values, i64 MIN included. It
; used to emit one raw byte for any value below 10, so -42 became garbage and
; COIL_TRACE profile lines with a negative delta were unreadable.
(module print-int-negative)
(import "coil.io" :as io)

(defn main [] (-> i64)
  (let [w (io/stdout)]
    (for n [0 7 42 -1 -42 -1000 9223372036854775807 -9223372036854775808]
      (io/print-int w n)
      (io/print-str w "\n"))
    0))
