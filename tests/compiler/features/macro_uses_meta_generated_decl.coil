;; A macro whose closure calls a function that reads a declaration a (meta …)
;; generates: the generators run before the macro is compiled, and the function's
;; qualification is redone once the declaration exists (coil-bugs c81fo99shw8,
;; where coil.fs/write-file read its generated O_CREAT).
(module macro-uses-meta-generated-decl)
(import "coil.primitive" :as p)

(defn gen-k [] (-> Code) `(do (const ~(p/syntax->datum `K) 5)))
(meta (gen-k))

(defn use-k [] (-> i64) (+ K 37))
(defn stamp [(x Code)] (-> Code) (if (= (use-k) 42) `42 `0))

(defn main [] (-> i64)
  (println "{} {}" (stamp y) (use-k))
  0)
