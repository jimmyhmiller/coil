(module rc-arc-aborting-constructors)
(import "coil.rc" :use [rc-new! rc-borrow rc-strong-count])
(import "coil.arc" :use [arc-new! arc-borrow arc-strong-count])

; rc-new! and arc-new! return the owner directly and abort on an exhausted
; allocator, like box!.

(defn main [] (-> i64)
  (let [shared (rc-new! 42)
        other (clone shared)
        atomic (arc-new! 7)
        second (clone atomic)]
    (println "{} {}" (load (rc-borrow other)) (rc-strong-count shared))
    (println "{} {}" (load (arc-borrow second)) (arc-strong-count atomic)))
  0)
