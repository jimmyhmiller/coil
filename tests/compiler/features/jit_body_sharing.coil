(module compiler.features.jit-body-sharing)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.primitive" :as p)
(import "coil.str" :as str)
(import "coil.compiler.driver" :as driver)
(import "coil.compiler.loader" :use [Source ls-function])
(import "coil.arraylist" :use *)

;;; Test actual accepted snapshots, not just a standalone reference counter.
(defn body-address [(raw (ptr driver/ReplSession))] (-> i64)
  (block :found
    (let [revision (driver/compiler-revision-parent raw)]
      (match (ls-function (.loader revision) "jit.session.stable")
        (None [] 0)
        (Some [function] (break :found (p/cast i64 (.body function))))))
    0))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (a/malloc-allocator))
        raw (driver/repl-session (.raw (mut session)))
        initial "(import \"coil.jit.lifetime\") (defn stable [] (-> i64) 42)"]
    (assert (= (jit/jit-compile-with-entry! (mut session) initial "0") 0))
    (let [lines (body-address raw)
          (mut peak) (.live-bytes (.body-heap raw))
          (mut peak-blocks) 0]
      (assert (!= lines 0))
      (for [i 0 40]
        (let [(mut source) (str/sb-new (a/malloc-allocator))]
          (str/sb-push-str! (mut source) "(defn changing")
          (str/sb-push-i64! (mut source) (+ i 100))
          (str/sb-push-str! (mut source) " :jit/retain false :jit/root 71 :jit/root-version ")
          (str/sb-push-i64! (mut source) (+ i 100))
          (str/sb-push-str! (mut source) " [] (-> i64) 0)")
          (assert (= (jit/jit-compile-with-entry! (mut session) (str/sb-str (load source))
            "(if (= (stable) 42) 0 1)") 0))
          (assert (!= (body-address raw) 0))
          (str/sb-free! (mut source)))
        ; An accepted checked body keeps the same address while unrelated
        ; candidate scratch and the preceding metadata snapshot are destroyed.
        (assert (= (body-address raw) lines))
        ; Everything a submission seals shares one block, held by the state it
        ; produced, by the next state until that one is published, and by the facade,
        ; which is always one submission behind. So a submission's storage goes two
        ; submissions later, and steady state starts at the third iteration. From
        ; there neither the byte count nor the number of blocks may move at all.
        (let [bytes (.live-bytes (.body-heap raw))
              blocks (.live-blocks (.body-heap raw))]
          (when (= i 2) (set! peak bytes) (set! peak-blocks blocks) 0)
          (when (> i 2)
            (assert (= bytes (load peak)))
            (assert (= blocks (load peak-blocks)))
            0))
        (let [copies (.copied-bytes (.body-heap raw))]
          (assert (!= (jit/jit-compile-with-entry! (mut session)
            "(defn invalid [] (-> i64) true)" "0") 0))
          (assert (= (.copied-bytes (.body-heap raw)) copies))
          (assert (= (body-address raw) lines))))
      (assert (> (.live-blocks (.body-heap raw)) 0)))
    (assert (= (jit/jit-reset! (mut session)) 0))
    (assert (= (.live-bytes (.body-heap raw)) 0))
    (assert (= (.len (.pages (.body-heap raw))) 0)))
  0)
