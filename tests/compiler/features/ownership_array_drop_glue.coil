(module ownership_array_drop_glue)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))]
        (-> void)
        (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defn run [] (-> void)
  (let [items [(Leaf :value 1) (Leaf :value 2) (Leaf :value 3)]]
    (do)))

(defn main [] (-> i64)
  (store! (counter) 0)
  (run)
  ; The fixed-size cleanup loop walks 2, 1, 0, producing 321. Process exit
  ; status is therefore 321 modulo 256 = 65.
  (load (counter)))
