;; A struct whose field type a top-level macro declares can itself be derived:
;; the pre-expansion context keeps the struct for reflection, and only the
;; metaprogram closure leaves it out (coil-bugs macro-defsum-struct-field).
(module derive-macro-declared-field)

(defn defsum-debug [(name Code) & (variants Code)] (-> Code)
  `(do (defsum ~name ~@variants)
       (derive Debug Eq ~name)))

(defsum-debug Shape (Circle [(r i64)]) (Square [(side i64)]))

(defstruct Holder [(label i64) (shape Shape)])
(derive Debug Eq Holder)

(defn main [] (-> i64)
  (let [h (Holder :label 1 :shape (Square 4))]
    (println "{:?} {}" h (= h (Holder :label 1 :shape (Square 4))))
    0))
