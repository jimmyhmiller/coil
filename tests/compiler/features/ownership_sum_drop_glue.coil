(module ownership_sum_drop_glue)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))] (-> void)
    (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defsum Choice
  (Empty [])
  (Pair [(first Leaf) (second Leaf)]))

(defn drop-pair [] (-> void)
  (let [choice (Pair (Leaf :value 1) (Leaf :value 2))]
    (do)))

(defn drop-empty [] (-> void)
  (let [choice (Empty)]
    (do)))

(defn main [] (-> i64)
  (store! (counter) 0)
  (drop-empty)
  (drop-pair)
  ; Only the active payload is destroyed, in reverse field order.
  (load (counter)))
