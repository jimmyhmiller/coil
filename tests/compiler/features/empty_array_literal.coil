(module empty-array-literal)
(import "coil.slice" :use *)

; `[]` takes its element type from where it stands, and `(array T 0)` is a
; type like any other array.

(defstruct Point [(x i64) (y i64)])
(defstruct Tagged [(tag i64) (none (array u8 0))])

(def NOTHING (: [] (slice Point)))
(const EMPTY-NAMES (: [] (array i64 0)))

(defn total [(xs (slice i64))] (-> i64)
  (let [(mut t) 0]
    (for x xs (set! t (+ t x)))
    t))

(defn no-points [] (-> (slice Point)) [])

(defn length [T (const N i64)] [(xs (array T N))] (-> i64) N)

(defn main [] (-> i64)
  (let [e (: [] (slice i64))
        a (: [] (array i64 0))
        (mut seen) 0]
    (for p (no-points) (set! seen (+ seen (.x p))))
    (for x a (set! seen (+ seen x)))
    (println "{} {} {} {} {}" (slice-len e) (total []) (slice-len (no-points)) (len a) seen)
    (println "{} {} {}" (length a) (slice-len NOTHING) (len EMPTY-NAMES))
    (println "{} {}" (sizeof (array i64 0)) (sizeof Tagged))
    (println "{}" (total [1 2 3])))
  0)
