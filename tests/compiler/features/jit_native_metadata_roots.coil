(module compiler.features.jit-native-metadata-roots)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile! (mut s) "(import \"coil.jit.lifetime\")") 0))
    (assert (= (jit/jit-compile! (mut s)
      "(defn leaf :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64) 41)") 0))
    (assert (= (jit/jit-compile! (mut s)
      "(defn caller :jit/retain false :jit/root 2 :jit/root-version 1 [] (-> i64) (+ (leaf) 1)) (export-c [caller :as \"leased_caller\"])") 0))
    (let [address (jit/jit-symbol-address (mut s) "leased_caller")
          lease (jit/jit-generation-retain-current! (mut s))]
      (assert (!= (p/cast i64 address) 0)) (assert (> lease 0))
      (assert (= (jit/jit-compile! (mut s)
        "(defn next-leaf :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) 7)
         (defn next-caller :jit/retain false :jit/root 2 :jit/root-version 2 [] (-> i64) 8)") 0))
      (for [i 0 8]
        (assert (= (jit/jit-compile-with-entry! (mut s) "" "(- (+ (next-leaf) (next-caller)) 15)") 0))
        (assert (>= (jit/jit-reclaim-retired! (mut s)) 0))
        ; Only the caller image is explicitly leased. Its leaf image is reachable
        ; through an import and must survive even though both metadata roots moved.
        (assert (= (p/call-ptr (p/cast (fnptr c [] i64) address)) 42))
        (assert (<= (jit/jit-generation-count (mut s)) 5)))
      (assert (>= (jit/jit-generation-release-token! (mut s) lease) 0))
      (assert (>= (jit/jit-reclaim-retired! (mut s)) 2))
      (assert (<= (jit/jit-generation-count (mut s)) 3)))
    (assert (= (jit/jit-compile! (mut s) "(defn retained [] (-> i64) 19)") 0))
    (for [i 0 8]
      (assert (= (jit/jit-compile-with-entry! (mut s) "" "(- (retained) 19)") 0))
      (assert (>= (jit/jit-reclaim-retired! (mut s)) 0))
      (assert (<= (jit/jit-generation-count (mut s)) 4)))
    (assert (= (jit/jit-reset! (mut s)) 0))
    (assert (= (jit/jit-generation-count (mut s)) 0)))
  0)
