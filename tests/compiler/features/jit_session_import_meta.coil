(module compiler.features.jit-session-import-meta)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;;; A session imports coil.meta like any module. Its compile-time environment
;;; already holds coil.meta-runtime (injected with the metaprogram shim), so the
;;; macro context of the importing submission reaches the same module twice; that
;;; is one definition, not a redefinition. A macro the submission writes with it
;;; then expands in a later one.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session)
            "(module q) (import \"coil.meta\" :as meta)
             (defn plus-header [(c Code)] (-> Code) (let [n (len (meta/source (meta/toolchain)))] `(+ ~c ~n)))") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module q) (defn uses [] (-> i64) (plus-header 0))"
            "(if (> (q.uses) 20) 0 1)") 0) 2
      :else (jit/jit-reset! (mut session)))))
