            (assert-eq (load (p/index rbits i))
                       (if (= (load (p/index fbase i)) (cast u8 1))
                           (load (p/index vbits i))
                           (cast i64 77))))))
      written)))

(defn check-f32x8 [(state (ptr u64)) (density u64)] (-> i64)
  (let [values (p/alloc-stack (array f32 8))
        flags (p/alloc-stack (array u8 8))
        packed (p/alloc-stack (array f32 10))
        vbase (cast (ptr f32) values)
        fbase (cast (ptr u8) flags)
        pbase (cast (ptr f32) packed)
        pbits (cast (ptr u32) packed)
        vbits (cast (ptr u32) values)
        (mut active-count) 0]
    (for [i 0 8]
      (store! (p/index vbase i) (cast f32 (+ (* i 3) 1)))
      (let [on (< (% (next-random state) 100) density)]
        (store! (p/index fbase i) (if on (cast u8 1) (cast u8 0)))
        (when on (set! active-count (+ active-count 1)))))
    (for [i 0 10] (store! (p/index pbits i) (cast u32 77)))
    (let [active (v/v= (v/vloadu [u8 8] fbase) (v/vsplat [u8 8] (cast u8 1)))
          written (v/vcompress-store pbase active (v/vloadu [f32 8] vbase))
          (mut k) 0]
      (assert-eq written active-count)
      (for [i 0 8]
        (when (= (load (p/index fbase i)) (cast u8 1))
          (assert-eq (load (p/index pbits k)) (load (p/index vbits i)))
          (set! k (+ k 1))))
      ; exactly `written` elements were touched
      (for [i written 10] (assert-eq (load (p/index pbits i)) (cast u32 77)))
      ; expand the packed prefix back over a fill of 77s
      (for [i written 10] (store! (p/index pbits i) (cast u32 91)))
      (let [fill (p/alloc-stack (array f32 8))
            fillbits (cast (ptr u32) fill)]
        (for [i 0 8] (store! (p/index fillbits i) (cast u32 77)))
        (let [expanded (v/vexpand-load pbase active (v/vloadu [f32 8] (cast (ptr f32) fill)))
              result (p/alloc-stack (array f32 8))
              rbits (cast (ptr u32) result)]
          (v/vstoreu (cast (ptr f32) result) expanded)
          (for [i 0 8]
            (assert-eq (load (p/index rbits i))
                       (if (= (load (p/index fbase i)) (cast u8 1))
                           (load (p/index vbits i))
                           (cast u32 77))))))
      written)))

(defn check-f64x2 [(state (ptr u64)) (density u64)] (-> i64)
  (let [values (p/alloc-stack (array f64 2))
        flags (p/alloc-stack (array u8 2))
        packed (p/alloc-stack (array f64 4))
        vbase (cast (ptr f64) values)
        fbase (cast (ptr u8) flags)
        pbase (cast (ptr f64) packed)
        pbits (cast (ptr u64) packed)
        vbits (cast (ptr u64) values)
        (mut active-count) 0]
    (for [i 0 2]
      (store! (p/index vbase i) (cast f64 (+ (* i 3) 1)))
      (let [on (< (% (next-random state) 100) density)]
        (store! (p/index fbase i) (if on (cast u8 1) (cast u8 0)))
        (when on (set! active-count (+ active-count 1)))))
    (for [i 0 4] (store! (p/index pbits i) (cast u64 77)))
    (let [active (v/v= (v/vloadu [u8 2] fbase) (v/vsplat [u8 2] (cast u8 1)))
          written (v/vcompress-store pbase active (v/vloadu [f64 2] vbase))
          (mut k) 0]
      (assert-eq written active-count)
      (for [i 0 2]
        (when (= (load (p/index fbase i)) (cast u8 1))
          (assert-eq (load (p/index pbits k)) (load (p/index vbits i)))
          (set! k (+ k 1))))
      ; exactly `written` elements were touched
      (for [i written 4] (assert-eq (load (p/index pbits i)) (cast u64 77)))
      ; expand the packed prefix back over a fill of 77s
      (for [i written 4] (store! (p/index pbits i) (cast u64 91)))
      (let [fill (p/alloc-stack (array f64 2))
            fillbits (cast (ptr u64) fill)]
        (for [i 0 2] (store! (p/index fillbits i) (cast u64 77)))
        (let [expanded (v/vexpand-load pbase active (v/vloadu [f64 2] (cast (ptr f64) fill)))
              result (p/alloc-stack (array f64 2))
              rbits (cast (ptr u64) result)]
          (v/vstoreu (cast (ptr f64) result) expanded)
          (for [i 0 2]
            (assert-eq (load (p/index rbits i))
                       (if (= (load (p/index fbase i)) (cast u8 1))
                           (load (p/index vbits i))
                           (cast u64 77))))))
      written)))

(defn main [] (-> i64)
  (let [(mut state) (cast u64 12345)
        (mut total) 0]
    (for [round 0 40]
      (let [density (cast u64 (cond (= round 0) 0 (= round 1) 100 :else (% (* round 37) 101)))]
        (set! total (+ total (check-u8x64 (mut state) density)))
        (set! total (+ total (check-u8x128 (mut state) density)))
        (set! total (+ total (check-u16x32 (mut state) density)))
        (set! total (+ total (check-i32x16 (mut state) density)))
        (set! total (+ total (check-i32x64 (mut state) density)))
        (set! total (+ total (check-i64x4 (mut state) density)))
        (set! total (+ total (check-f32x8 (mut state) density)))
        (set! total (+ total (check-f64x2 (mut state) density)))
        0))
    (println "ok {}" (> total 0))
    0))
