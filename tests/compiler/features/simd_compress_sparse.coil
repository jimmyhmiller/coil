        vbits (cast (ptr i64) values)
        (mut active-count) 0]
    (for [i 0 4]
      (store! (p/index vbase i) (cast i64 (+ (* i 3) 1)))
      (let [on (< (% (next-random state) 100) density)]
        (store! (p/index fbase i) (if on (cast u8 1) (cast u8 0)))
        (when on (set! active-count (+ active-count 1)))))
    (for [i 0 6] (store! (p/index pbits i) (cast i64 77)))
    (let [active (v/v= (v/vloadu [u8 4] fbase) (v/vsplat [u8 4] (cast u8 1)))
          written (v/vcompress-store pbase active (v/vloadu [i64 4] vbase))
          (mut k) 0]
      (assert-eq written active-count)
      (for [i 0 4]
        (when (= (load (p/index fbase i)) (cast u8 1))
          (assert-eq (load (p/index pbits k)) (load (p/index vbits i)))
          (set! k (+ k 1))))
      ; exactly `written` elements were touched
      (for [i written 6] (assert-eq (load (p/index pbits i)) (cast i64 77)))
      ; expand the packed prefix back over a fill of 77s
      (for [i written 6] (store! (p/index pbits i) (cast i64 91)))
      (let [fill (p/alloc-stack (array i64 4))
            fillbits (cast (ptr i64) fill)]
        (for [i 0 4] (store! (p/index fillbits i) (cast i64 77)))
        (let [expanded (v/vexpand-load pbase active (v/vloadu [i64 4] (cast (ptr i64) fill)))
              result (p/alloc-stack (array i64 4))
              rbits (cast (ptr i64) result)]
