(module test.simd-compress-sparse)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

;; vcompress-store / vexpand-load against a scalar reference, over widths that
;; exercise every mask-bits width (below, at and above 64 lanes) and densities
;; from empty to full. LLVM lowers both as a loop over the set mask bits; the
;; loop must write exactly mask-count elements and keep inactive lanes' fill.

(defn next-random [(state (ptr u64))] (-> u64)
  ; an LCG: the arithmetic wraps on purpose
  (let [x (p/iadd (p/imul (load state) 6364136223846793005) 1442695040888963407)]
    (store! state x)
    (>> x 33)))

(defn check-u8x64 [(state (ptr u64)) (density u64)] (-> i64)
  (let [values (p/alloc-stack (array u8 64))
        flags (p/alloc-stack (array u8 64))
        packed (p/alloc-stack (array u8 66))
        vbase (cast (ptr u8) values)
        fbase (cast (ptr u8) flags)
        pbase (cast (ptr u8) packed)
        pbits (cast (ptr u8) packed)
        vbits (cast (ptr u8) values)
        (mut active-count) 0]
    (for [i 0 64]
      (store! (p/index vbase i) (p/cast u8 (+ (* i 3) 1)))  ; truncates on purpose
      (let [on (< (% (next-random state) 100) density)]
        (store! (p/index fbase i) (if on (cast u8 1) (cast u8 0)))
        (when on (set! active-count (+ active-count 1)))))
    (for [i 0 66] (store! (p/index pbits i) (cast u8 77)))
    (let [active (v/v= (v/vloadu [u8 64] fbase) (v/vsplat [u8 64] (cast u8 1)))
          written (v/vcompress-store pbase active (v/vloadu [u8 64] vbase))
          (mut k) 0]
      (assert-eq written active-count)
      (for [i 0 64]
        (when (= (load (p/index fbase i)) (cast u8 1))
          (assert-eq (load (p/index pbits k)) (load (p/index vbits i)))
          (set! k (+ k 1))))
      ; exactly `written` elements were touched
      (for [i written 66] (assert-eq (load (p/index pbits i)) (cast u8 77)))
      ; expand the packed prefix back over a fill of 77s
      (for [i written 66] (store! (p/index pbits i) (cast u8 91)))
      (let [fill (p/alloc-stack (array u8 64))
            fillbits (cast (ptr u8) fill)]
        (for [i 0 64] (store! (p/index fillbits i) (cast u8 77)))
        (let [expanded (v/vexpand-load pbase active (v/vloadu [u8 64] (cast (ptr u8) fill)))
              result (p/alloc-stack (array u8 64))
              rbits (cast (ptr u8) result)]
          (v/vstoreu (cast (ptr u8) result) expanded)
          (for [i 0 64]
            (assert-eq (load (p/index rbits i))
                       (if (= (load (p/index fbase i)) (cast u8 1))
                           (load (p/index vbits i))
                           (cast u8 77))))))
      written)))

