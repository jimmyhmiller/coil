        (when on (set! active-count (+ active-count 1)))))
    (for [i 0 130] (store! (p/index pbits i) (cast u8 77)))
    (let [active (v/v= (v/vloadu [u8 128] fbase) (v/vsplat [u8 128] (cast u8 1)))
