(module meta_dependencies)
(import "coil.primitive" :as p)
(import "coil.meta" :as meta)

(defn leaf [(x i64)] (-> i64) (+ x 1))
(defalias aliased leaf)
(const K 4)
(const K2 (+ K 1))
(defn twice [(x Code)] (-> Code) `(+ ~x ~x))
(defn middle [(x i64)] (-> i64) (+ (aliased x) K2))
(defn top [(x i64)] (-> i64) (twice (middle x)))
(defstruct Inner [(x i64)])
(defstruct Outer [(inner Inner)])
(defn read-outer [(x (ptr Outer))] (-> i64) (.x (.inner x)))

(defn cycle-a [(x i64)] (-> i64) (if (= x 0) 0 (cycle-b (- x 1))))
(defn cycle-b [(x i64)] (-> i64) (if (= x 0) 0 (cycle-a (- x 1))))

(defn contains? [(names Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for item (iter names) (when (= item name) (set! found true)))
    found))

(defn verify [(modules Code)] (-> Code)
  (unless (contains? (meta/dependencies `meta_dependencies.middle) `meta_dependencies.leaf)
    (p/error "missing direct call edge") 0)
  (unless (contains? (meta/dependencies `meta_dependencies.middle) `meta_dependencies.aliased)
    (p/error "missing alias provenance") 0)
  (unless (contains? (meta/dependencies `meta_dependencies.middle) `meta_dependencies.K2)
    (p/error "missing folded constant edge") 0)
  (unless (contains? (meta/dependencies `meta_dependencies.K2) `meta_dependencies.K)
    (p/error "missing constant initializer edge") 0)
  (unless (contains? (meta/dependencies `meta_dependencies.top) `meta_dependencies.twice)
    (p/error "missing macro provenance") 0)
  (unless (contains? (meta/dependent-closure `meta_dependencies.leaf) `meta_dependencies.top)
    (p/error "missing transitive dependent") 0)
  (unless (contains? (meta/dependent-closure `meta_dependencies.Inner) `meta_dependencies.read-outer)
    (p/error "missing nested type dependent") 0)
  (when (contains? (meta/dependents `meta_dependencies.leaf) `meta_dependencies.top)
    (p/error "direct query included transitive dependent") 0)
  (let [closure (meta/dependent-closure `meta_dependencies.cycle-a)]
    (unless (contains? closure `meta_dependencies.cycle-b) (p/error "missing cycle edge") 0)
    (when (contains? closure `meta_dependencies.cycle-a) (p/error "cycle included root") 0))
  (unless (= (meta/dependencies `meta_dependencies.missing) `:unresolved)
    (p/error "unknown declaration is not unresolved") 0)
  `0)
(checker verify)
(defn main [] (-> i64) (top 1))
