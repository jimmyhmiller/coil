(module ownership_branch_move_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (set! (.value self) 0)))

(defn consume [(owner Owner)] (-> void))

; Without conditional drop flags, accepting this would either leak on the false
; path or drop the already-consumed owner on the true path.
(defn main [] (-> i64)
  (let [owner (Owner :value 42)]
    (if true
        (consume owner)
        (do))
    0))
