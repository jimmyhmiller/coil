(module unary-and-variadic-operators)

; `(- x)` negates through Neg; arithmetic and bitwise operators fold left past two
; operands.

(defn square [(x i64)] (-> i64) (* x x))

(defn main [] (-> i64)
  (let [x 5
        f 2.5
        zero 0.0]
    (println "{} {} {} {}" (- x) (- (square 3)) (- f) (/ 1.0 (- zero)))
    (println "{} {} {} {}" (+ 1 2 3 4) (* 2 3 4) (- 20 5 3) (/ 100 5 2))
    (println "{} {} {}" (+ 1.5 2.5 3.0) (| 1 2 4) (& 7 6 4))
    (println "{}" (- (: 7 i8))))
  0)
