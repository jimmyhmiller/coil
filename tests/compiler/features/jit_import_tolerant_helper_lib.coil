(module compiler.features.jit-import-tolerant-helper-lib)
(import "coil.arraylist" :use [ArrayList al-elem])

(defstruct Rule [(name i64)])

(defn find-rule [(form Code) (rules (ptr (ArrayList Rule)))] (-> i64)
  (let [(mut found) -1]
    (for [i 0 (len rules)]
      (let [rule (al-elem [Rule] rules i)]
        (when (= (len form) (.name rule)) (set! found i))))
    (load found)))

(defn rewrite-many [(form Code) (rules (ptr (ArrayList Rule)))] (-> Code)
  (if (>= (find-rule form rules) 0) form form))

(defn entry [(form Code) (rules (ptr (ArrayList Rule)))] (-> Code)
  (rewrite-many form rules))
