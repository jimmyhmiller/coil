(module transparent_arc_weak)
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defn main [] (-> i64)
  (do
    (let [weak-cell
            (let [strong (Cell :value 42)
                  observer (weak strong)]
              (match (weak-upgrade observer)
                (None [] observer)
                (Some [live]
                  (if (= (.value live) 42) observer observer))))]
      ; The strong owner and the temporary upgraded owner are gone, but the weak
      ; control-block handle remains. It must not keep the payload alive.
      (match (weak-upgrade weak-cell)
        (None [] 0)
        (Some [unexpected] (.value unexpected))))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
