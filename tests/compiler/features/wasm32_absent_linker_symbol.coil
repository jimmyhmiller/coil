(module test.wasm32-absent-linker-symbol)
(import "coil.primitive" :as primitive)

; A Mach-O-only linker symbol has no definition in a Wasm module. Building this
; for wasm32 must fail naming the symbol, as a finalizer error: it used to read
; "unresolved global import (env.__memory_base/...)" and then "linker
; terminated by signal 1" with advice about native libraries.
(defn main [] (-> i32)
  (if (= (primitive/cast i64 (primitive/linker-address _mh_execute_header)) 0) 1 0))
