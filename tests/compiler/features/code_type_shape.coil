(module code_type_shape)
(import "coil.primitive" :as primitive)

(defstruct Record [(value i64)])
(defsum Choice (Empty) (Value [(value i64)]))

(defn reflected-shapes [] (-> Code)
  (if (and (primitive/code-eq (primitive/code-type-shape `Record) `struct)
           (primitive/code-eq (primitive/code-type-shape `Choice) `sum))
      ; hygiene: the generated fixture entry intentionally publishes the fixed source-visible name shape-result.
      `(defn ~(primitive/syntax->datum (primitive/fresh-identifier "shape-result"))
         [] (-> i64) 42)
      (primitive/error "code-type-shape returned the wrong representation kind")))

(meta (reflected-shapes))

(defn main [] (-> i64) (shape-result))
