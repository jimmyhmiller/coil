(module code-type-traits)
(import "coil.primitive" :as p)

; A checker asks which traits a type implements, of the type as `type-of`
; reports it: direct impls, generic impls whose pattern accepts the type, and
; not a trait nobody implemented for it.
(deftrait Shout [Self] (shout [(x Self)] (-> i64)))

(defstruct Loud [(v i64)])

(defstruct Quiet [(v i64)])

(defstruct Box [T] [(v T)])

(impl Shout Loud (shout [(x Loud)] (-> i64) 1))

(impl [T] Shout (Box T) (shout [(x (Box T))] (-> i64) 2))

(defn loud [] (-> Loud) (Loud :v 0))

(defn quiet [] (-> Quiet) (Quiet :v 0))

(defn boxed [] (-> (Box i64)) (Box :v 0))

(defn int [] (-> i64) 1)

(defn has? [(traits Code) (trait (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (p/code-count traits)]
      (when (= (p/code-sym (p/code-nth traits i)) trait) (set! found true)))
    found))

(defn expect [(body Code) (trait (slice u8)) (want bool)] (-> i64)
  (let [traits (p/code-type-traits (p/type-of body))]
    (unless (p/code-list? traits)
      (p/error "code-type-traits: no checked program in a checker"))
    (unless (= (has? traits trait) want)
      (p/report body (if want "a trait the type implements is missing" "a trait the type does not implement is listed")))
    0))

(defn check-fn [(name Code) (body Code)] (-> i64)
  (cond (p/code-eq name `loud)
          (do (expect body "code-type-traits.Shout" true)
              (expect body "coil.core.Eq" false))
        (p/code-eq name `boxed) (expect body "code-type-traits.Shout" true)
        (p/code-eq name `quiet) (expect body "code-type-traits.Shout" false)
        (p/code-eq name `int)
          (do (expect body "coil.core.Eq" true)
              (expect body "code-type-traits.Shout" false))
        :else 0))

(defn inspect [(modules Code)] (-> Code)
  (for [mi 0 (p/code-count modules)]
    (let [module (p/code-nth modules mi)]
      (when (p/code-eq (p/code-nth module 0) `code-type-traits)
        (for [fi 1 (p/code-count module)]
          (let [form (p/code-nth module fi)]
            (when (>= (p/code-count form) 5)
              (check-fn (p/code-nth form 1) (p/code-nth form 4))))))))
  `(do ~@modules))

(checker inspect)

(defn main [] (-> i64)
  (- (+ (shout (loud)) (shout (boxed)) (.v (quiet)) (int)) 4))
