(module alias-memory)
(import "coil.primitive" :as primitive)

; Explicit alias-aware accesses preserve ordinary load/store behavior while giving
; the LLVM backend the source language's scalar aliasing guarantee.
(defn main [] (-> i64)
  (let [slot (primitive/alloc-stack i32)]
    (primitive/alias-store! slot (primitive/cast i32 42))
    (if (= (primitive/alias-load i32 slot) (primitive/cast i32 42)) 0 1)))
