(module compiler.features.type-identity)
(import "coil.primitive" :as p)

(defstruct Record [(x i64)])
(defstruct Other [(x i64)])
(defalias Alias Record)
(defalias Chain Alias)
(defstruct Container [T] [(value T)])
(defalias Generic Container)

; Exercise semantic reflection through alias chains, qualification, nested
; function signatures, generic arguments and aggregate extents.
(defn check-identities [] (-> Code)
  (let [alias (p/code-type-identity `(ptr Chain))
        direct (p/code-type-identity `(ptr Record))
        qualified (p/code-type-identity `(ptr compiler.features.type-identity.Alias))
        other (p/code-type-identity `(ptr Other))
        nested (p/code-type-identity `(fnptr c [(ref Chain) (ptr (Generic (ptr Alias)))] (array (ptr Alias) 2)))
        plain (p/code-type-identity `(fnptr c [(ref Record) (ptr (Container (ptr Record)))] (array (ptr Record) 2)))
        longer (p/code-type-identity `(fnptr c [(ref Record) (ptr (Container (ptr Record)))] (array (ptr Record) 3)))]
    (unless (and (p/code-eq alias direct) (p/code-eq direct qualified))
      (p/error "type identities must follow aliases and preserve qualification"))
    (when (p/code-eq direct other)
      (p/error "distinct nominal declarations must have distinct type identities"))
    (unless (p/code-eq nested plain)
      (p/error "nested function-pointer signatures must resolve alias leaves"))
    (when (p/code-eq plain longer)
      (p/error "type identity must preserve aggregate extents"))
    `0))

(defn main [] (-> i64) (check-identities))
