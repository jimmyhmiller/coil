(module compiler.features.jit-repl-param-add)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Adding a parameter must publish a new signature while accepted callers keep
;; their original two-argument code. Do not retire the name before the edit:
;; this is the ordinary coil.repl publication path used by live edits.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (scope :session
           (defer (jit/jit-session-free! (mut session)))
           (cond (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(module scenario)
         (import \"coil.repl\")
         (import \"coil.var\" :use [var-static])
         (defn damage [(t i64) (amount f32)] (-> f32) amount)
         (defn old-caller [] (-> f32) (damage 1 (cast f32 7.0)))"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "initial publication failed: {}"
                              (jit/jit-diagnostic (mut session)))
                     1)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(if (= (old-caller) (cast f32 7.0)) 0 91)")
                     0)
                   2
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn damage [(t i64) (amount f32) (crit bool)] (-> f32) amount)"
                                                  "(coil.repl/publish)")
                     0)
                   (do
                     (println "parameter-add publication failed: {}"
                              (jit/jit-diagnostic (mut session)))
                     3)
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  "(defn new-caller [] (-> f32) (damage 1 (cast f32 11.0) true))"
                                                  "(coil.repl/publish)")
                     0)
                   4
                 (!= (jit/jit-compile-with-entry! (mut session)
                                                  ""
                                                  "(if (and (= (old-caller) (cast f32 7.0)) (= (new-caller) (cast f32 11.0))) 0 92)")
                     0)
                   5
                 :else 0))))
