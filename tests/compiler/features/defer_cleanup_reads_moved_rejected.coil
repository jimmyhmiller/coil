(module defer-cleanup-reads-moved-rejected)
; The cleanup reads `o` after the body has moved it away.
(defstruct Owner [(value i64)])

(impl Drop Owner (drop [(self (mut Owner))] (-> void) 0))

(defn consume [(o Owner)] (-> i64) (.value o))

(defn main [] (-> i64)
  (let [o (Owner :value 1)]
    (defer* (println "{}" (.value o)))
    (consume o)))
