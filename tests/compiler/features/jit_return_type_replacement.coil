(module compiler.features.jit-return-type-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Publishing f32 -> bool must accept the new signature and make it callable.
; Separate submissions avoid conflating publication with dependent checking.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(module return-edit) (import \"coil.repl\")
       (defn damage [(x f32)] (-> f32) x)"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) ""
      "(if (= (damage (cast f32 3)) (cast f32 3)) 0 1)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(defn damage [(x f32)] (-> bool) (> x (cast f32 0)))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) ""
      "(if (and (damage (cast f32 3)) (not (damage (cast f32 0)))) 0 1)") 0))
    (jit/jit-reset! (mut session))))
