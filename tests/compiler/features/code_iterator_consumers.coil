(module code-iterator-consumers)
(import "coil.primitive" :as primitive)

; Iterator consumers and adapters take callbacks over Code items inside macros,
; just as they do over runtime values.

(defn symbol? [(c Code)] (-> bool) (primitive/code-sym? c))

(defn count-symbols [& (forms Code)] (-> Code)
  (let [n (count (filter (fn [c] (primitive/code-sym? c)) forms))] `~n))

(defn all-symbols? [& (forms Code)] (-> Code)
  (if (all? (fn [c] (primitive/code-sym? c)) forms) `true `false))

(defn any-symbol? [& (forms Code)] (-> Code)
  (if (any? (fnptr-of symbol?) forms) `true `false))

(defn sum-ints [& (forms Code)] (-> Code)
  (let [total (fold (fn [acc c] (if (primitive/code-int? c) (+ acc (primitive/code-int c)) acc))
                    0
                    forms)]
    `~total))

(defn positive-count [& (forms Code)] (-> Code)
  (let [n (count (filter (fn [x] (> x 1)) [1 2 3]))] `~n))

(defn main [] (-> i64)
  (println "{} {} {}" (count-symbols a 1 b 2 c) (all-symbols? a b) (all-symbols? a 1))
  (println "{} {}" (any-symbol? 1 2 x) (any-symbol? 1 2))
  (println "{} {}" (sum-ints 1 x 2 y 39) (positive-count))
  0)
