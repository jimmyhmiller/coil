(module meta_semantic_transform_partial_model)
(import "coil.primitive" :as primitive)

(defstruct Record [(value i64)])

(defn generate [] (-> Code)
  `(defn* generated [] (-> i64) 2))

; A meta declaration forces the transform's provisional model through meta
; elaboration. The missing field must remain recoverable until this transform.
(meta (generate))

(defn rewrite [(form Code)] (-> Code)
  (if (primitive/code-list? form)
      (if (and (= (len form) 2) (= (get form 0) `.missing))
          (let [receiver (get form 1)]
            (if (= (primitive/type-of receiver) `:unknown)
                (primitive/error "semantic transform lost the receiver type")
                `(.value ~receiver)))
          (if (and (> (len form) 0) (= (get form 0) `quote))
              form
              (let [out (primitive/code-list-new)]
                (for [i 0 (len form)]
                  (primitive/code-list-push! out (rewrite (get form i))))
                (primitive/code-list-like form (primitive/code-list-done out)))))
      form))

(defn lower [(modules Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (for [i 0 (len modules)]
      (primitive/code-list-push! out (rewrite (get modules i))))
    `(do ~@(primitive/code-list-done out))))

(transform lower)

(defn read-value [(r (ptr Record))] (-> i64)
  (.missing r))

(defn main [] (-> i64)
  (let [(mut r) (Record :value 40)]
    (+ (read-value (mut r)) 2)))
