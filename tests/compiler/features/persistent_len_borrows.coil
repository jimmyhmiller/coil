(module persistent-len-borrows)
(import "coil.alloc" :use [malloc-allocator-lease])
(import "coil.pmap" :use [PMap pm-new-scalar pm-assoc!])
(import "coil.pvec" :use [PVec pv-new pv-push!])

; `len` on a persistent map or vector borrows it: counting a collection twice,
; or through a `Len` bound, leaves the caller's owner alive.

(defn size-of [(C Len)] [(c (ref C))] (-> i64) (len c))

(defn main [] (-> i64)
  (let [(mut m) (pm-new-scalar [i64 i64] (malloc-allocator-lease))
        (mut v) (pv-new [i64] (malloc-allocator-lease))]
    (pm-assoc! (mut m) 1 10)
    (pm-assoc! (mut m) 2 20)
    (pv-push! (mut v) 7)
    (println "map {} {}" (len m) (len m))
    (println "vec {} {}" (len v) (len v))
    (println "bound {} {}" (size-of m) (size-of v))
    (pm-assoc! (mut m) 3 30)
    (println "map after {}" (len m))
    0))
