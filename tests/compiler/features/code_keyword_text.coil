(module code-keyword-text)
(import "coil.primitive" :as primitive)

; code-str and code-symbol read a keyword as its name; a CodeBuilder held in a
; mutable binding is pushed onto like any other.

(defn name-of [(k Code)] (-> Code)
  `~(primitive/code-str k))

(defn sum-of [& (xs Code)] (-> Code)
  (let [(mut b) (primitive/code-list-new)]
    (primitive/code-list-push! b `+)
    (for x xs (primitive/code-list-push! b x))
    `(~@b)))

(defn main [] (-> i64)
  (println "{} {}" (name-of :initial) (sum-of 1 2 3 4))
  0)
