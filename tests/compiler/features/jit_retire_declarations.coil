(module compiler.features.jit-retire-declarations)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A retained session may retire accepted aliases, traits and impls, then
;; declare replacements under the same names. Accepted code keeps what it bound.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m)
         (defsum Light-v1 (Red-v1) (Amber-v1))
         (defalias Light Light-v1)
         (defalias Red Red-v1)
         (defalias Amber Amber-v1)
         (deftrait Shape [Self] (area [(self Self)] (-> i64)))
         (defstruct Sq [(side i64)])
         (defstruct Box [T] [(item T)])
         (impl Shape Sq (area [(self Sq)] (-> i64) (* (.side self) (.side self))))
         (deftrait Size [Self] (size [(self Self)] (-> i64)))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) 1))
         (impl Sq (twice [(self Sq)] (-> i64) (* 2 (.side self))))
         (defn old-area [] (-> i64) (area (Sq :side 3)))
         (defn old-size [] (-> i64) (size (Box :item 5)))
         (defn old-twice [] (-> i64) (twice (Sq :side 4)))"
        "(if (and (= (retire.m.old-area) 9) (and (= (retire.m.old-size) 1) (= (retire.m.old-twice) 8))) 0 1)") 0) 1
      ; A retired alias no longer resolves.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m) (retire-alias Amber) (defn uses-amber [] (-> i64) (match (Amber) (Red [] 1) (Amber [] 2)))"
        "0") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m) (retire-alias Amber)"
        "0") 0) 3
      (= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m) (defn later-amber [] (-> retire.m.Light) (Amber))"
        "0") 0) 4
      ; A retired trait is replaced, with its impls; old callers keep theirs.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m)
         (retire-trait Shape)
         (deftrait Shape [Self] (area [(self Self)] (-> i64)) (perimeter [(self Self)] (-> i64)))
         (impl Shape Sq (area [(self Sq)] (-> i64) (.side self)) (perimeter [(self Sq)] (-> i64) (* 4 (.side self))))
         (defn new-area [] (-> i64) (+ (area (Sq :side 3)) (perimeter (Sq :side 3))))"
        "(if (and (= (retire.m.new-area) 15) (= (retire.m.old-area) 9)) 0 1)") 0) 5
      ; A generic trait impl is replaced.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m)
         (retire-impl [T] Size (Box T))
         (impl [T] Size (Box T) (size [(self (Box T))] (-> i64) (+ 1 (sizeof T))))
         (defn new-size [] (-> i64) (size (Box :item 5)))"
        "(if (and (= (retire.m.new-size) 9) (= (retire.m.old-size) 1)) 0 1)") 0) 6
      ; An inherent impl is replaced with a different signature.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m)
         (retire-inherent Sq)
         (impl Sq (twice [(self Sq) (extra i64)] (-> i64) (+ extra (* 2 (.side self)))))
         (defn new-twice [] (-> i64) (twice (Sq :side 4) 1))"
        "(if (and (= (retire.m.new-twice) 9) (= (retire.m.old-twice) 8)) 0 1)") 0) 7
      ; A rejected retirement leaves the accepted declarations in place.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m) (retire-trait Shape) (defn broken [] (-> i64) true)"
        "0") 0) 8
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module retire.m) (defn still [] (-> i64) (perimeter (Sq :side 2)))"
        "(if (= (retire.m.still) 8) 0 1)") 0) 9
      :else (jit/jit-reset! (mut session)))))
