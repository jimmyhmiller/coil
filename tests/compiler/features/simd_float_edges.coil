(module test.simd-float-edges)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn check-f32 [] (-> i64)
  (let [zero (v/vzero [f32 4]) negzero (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0x80000000))
        nan (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0x7fc01234)) inf (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0x7f800000)) ninf (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0xff800000))
        one (v/vsplat [f32 4] 1.0)]
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vmin zero negzero)) 0) (cast u32 0x80000000))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vmax zero negzero)) 0) (cast u32 0))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vneg zero)) 0) (cast u32 0x80000000))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vabs negzero)) 0) (cast u32 0))
    (assert (v/mask-all? (v/visnan (v/vmin one nan))))
    (assert (v/mask-all? (v/visnan (v/vmax nan one))))
    (assert (v/mask-none? (v/visfinite inf)))
    (assert (v/mask-none? (v/visfinite ninf)))
    (assert (v/mask-none? (v/visfinite nan)))
    (assert (v/mask-none? (v/v= nan nan)))
    (assert (v/mask-all? (v/v!= nan nan)))
    (assert (v/mask-none? (v/v< nan one)))
    (assert (v/mask-none? (v/v>= nan one)))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vfma (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0x3f800001)) (v/vbitcast [f32 4 u32 4] (v/vsplat [u32 4] 0x3f7ffffe)) (v/vsplat [f32 4] -1.0))) 0) (cast u32 0xa8800000))
    (assert-eq (v/vextract (v/vconvert [u8 f32 4] nan) 0) (cast u8 0))
    (assert-eq (v/vextract (v/vconvert [u8 f32 4] inf) 0) (cast u8 0xff))
    (assert-eq (v/vextract (v/vconvert [u8 f32 4] ninf) 0) (cast u8 0))
    (assert-eq (v/vextract (v/vconvert [i8 f32 4] nan) 0) (cast i8 0))
    (assert-eq (v/vextract (v/vconvert [i8 f32 4] inf) 0) (cast i8 0x7f))
    (assert-eq (v/vextract (v/vconvert [i8 f32 4] ninf) 0) (cast i8 -128))
    (assert-eq (v/vextract (v/vconvert [u16 f32 4] nan) 0) (cast u16 0))
    (assert-eq (v/vextract (v/vconvert [u16 f32 4] inf) 0) (cast u16 0xffff))
    (assert-eq (v/vextract (v/vconvert [u16 f32 4] ninf) 0) (cast u16 0))
    (assert-eq (v/vextract (v/vconvert [i16 f32 4] nan) 0) (cast i16 0))
    (assert-eq (v/vextract (v/vconvert [i16 f32 4] inf) 0) (cast i16 0x7fff))
    (assert-eq (v/vextract (v/vconvert [i16 f32 4] ninf) 0) (cast i16 -32768))
    (assert-eq (v/vextract (v/vconvert [u32 f32 4] nan) 0) (cast u32 0))
    (assert-eq (v/vextract (v/vconvert [u32 f32 4] inf) 0) (cast u32 0xffffffff))
    (assert-eq (v/vextract (v/vconvert [u32 f32 4] ninf) 0) (cast u32 0))
    (assert-eq (v/vextract (v/vconvert [i32 f32 4] nan) 0) (cast i32 0))
    (assert-eq (v/vextract (v/vconvert [i32 f32 4] inf) 0) (cast i32 0x7fffffff))
    (assert-eq (v/vextract (v/vconvert [i32 f32 4] ninf) 0) (cast i32 -2147483648))
    (assert-eq (v/vextract (v/vconvert [u64 f32 4] nan) 0) (cast u64 0))
    (assert-eq (v/vextract (v/vconvert [u64 f32 4] inf) 0) (cast u64 0xffffffffffffffff))
    (assert-eq (v/vextract (v/vconvert [u64 f32 4] ninf) 0) (cast u64 0))
    (assert-eq (v/vextract (v/vconvert [i64 f32 4] nan) 0) (cast i64 0))
    (assert-eq (v/vextract (v/vconvert [i64 f32 4] inf) 0) (cast i64 0x7fffffffffffffff))
    (assert-eq (v/vextract (v/vconvert [i64 f32 4] ninf) 0) (cast i64 -9223372036854775808))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] -3.5)) 0) (cast f32 -4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] -2.5)) 0) (cast f32 -2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] -1.5)) 0) (cast f32 -2.0)))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vround (v/vsplat [f32 4] -0.5))) 0) (cast u32 0x80000000))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vround (v/vsplat [f32 4] -0.25))) 0) (cast u32 0x80000000))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] 0.5)) 0) (cast f32 0.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] 1.5)) 0) (cast f32 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] 2.5)) 0) (cast f32 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] 3.5)) 0) (cast f32 4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f32 4] 3.75)) 0) (cast f32 4.0)))
    0))

(defn check-f64 [] (-> i64)
  (let [zero (v/vzero [f64 4]) negzero (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0x8000000000000000))
        nan (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0x7ff8000000001234)) inf (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0x7ff0000000000000)) ninf (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0xfff0000000000000))
        one (v/vsplat [f64 4] 1.0)]
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vmin zero negzero)) 0) (cast u64 0x8000000000000000))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vmax zero negzero)) 0) (cast u64 0))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vneg zero)) 0) (cast u64 0x8000000000000000))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vabs negzero)) 0) (cast u64 0))
    (assert (v/mask-all? (v/visnan (v/vmin one nan))))
    (assert (v/mask-all? (v/visnan (v/vmax nan one))))
    (assert (v/mask-none? (v/visfinite inf)))
    (assert (v/mask-none? (v/visfinite ninf)))
    (assert (v/mask-none? (v/visfinite nan)))
    (assert (v/mask-none? (v/v= nan nan)))
    (assert (v/mask-all? (v/v!= nan nan)))
    (assert (v/mask-none? (v/v< nan one)))
    (assert (v/mask-none? (v/v>= nan one)))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vfma (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0x3ff0000000000001)) (v/vbitcast [f64 4 u64 4] (v/vsplat [u64 4] 0x3feffffffffffffe)) (v/vsplat [f64 4] -1.0))) 0) (cast u64 0xb970000000000000))
    (assert-eq (v/vextract (v/vconvert [u8 f64 4] nan) 0) (cast u8 0))
    (assert-eq (v/vextract (v/vconvert [u8 f64 4] inf) 0) (cast u8 0xff))
    (assert-eq (v/vextract (v/vconvert [u8 f64 4] ninf) 0) (cast u8 0))
    (assert-eq (v/vextract (v/vconvert [i8 f64 4] nan) 0) (cast i8 0))
    (assert-eq (v/vextract (v/vconvert [i8 f64 4] inf) 0) (cast i8 0x7f))
    (assert-eq (v/vextract (v/vconvert [i8 f64 4] ninf) 0) (cast i8 -128))
    (assert-eq (v/vextract (v/vconvert [u16 f64 4] nan) 0) (cast u16 0))
    (assert-eq (v/vextract (v/vconvert [u16 f64 4] inf) 0) (cast u16 0xffff))
    (assert-eq (v/vextract (v/vconvert [u16 f64 4] ninf) 0) (cast u16 0))
    (assert-eq (v/vextract (v/vconvert [i16 f64 4] nan) 0) (cast i16 0))
    (assert-eq (v/vextract (v/vconvert [i16 f64 4] inf) 0) (cast i16 0x7fff))
    (assert-eq (v/vextract (v/vconvert [i16 f64 4] ninf) 0) (cast i16 -32768))
    (assert-eq (v/vextract (v/vconvert [u32 f64 4] nan) 0) (cast u32 0))
    (assert-eq (v/vextract (v/vconvert [u32 f64 4] inf) 0) (cast u32 0xffffffff))
    (assert-eq (v/vextract (v/vconvert [u32 f64 4] ninf) 0) (cast u32 0))
    (assert-eq (v/vextract (v/vconvert [i32 f64 4] nan) 0) (cast i32 0))
    (assert-eq (v/vextract (v/vconvert [i32 f64 4] inf) 0) (cast i32 0x7fffffff))
    (assert-eq (v/vextract (v/vconvert [i32 f64 4] ninf) 0) (cast i32 -2147483648))
    (assert-eq (v/vextract (v/vconvert [u64 f64 4] nan) 0) (cast u64 0))
    (assert-eq (v/vextract (v/vconvert [u64 f64 4] inf) 0) (cast u64 0xffffffffffffffff))
    (assert-eq (v/vextract (v/vconvert [u64 f64 4] ninf) 0) (cast u64 0))
    (assert-eq (v/vextract (v/vconvert [i64 f64 4] nan) 0) (cast i64 0))
    (assert-eq (v/vextract (v/vconvert [i64 f64 4] inf) 0) (cast i64 0x7fffffffffffffff))
    (assert-eq (v/vextract (v/vconvert [i64 f64 4] ninf) 0) (cast i64 -9223372036854775808))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] -3.5)) 0) (cast f64 -4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] -2.5)) 0) (cast f64 -2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] -1.5)) 0) (cast f64 -2.0)))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vround (v/vsplat [f64 4] -0.5))) 0) (cast u64 0x8000000000000000))
    (assert-eq (v/vextract (v/vbitcast [u64 4 f64 4] (v/vround (v/vsplat [f64 4] -0.25))) 0) (cast u64 0x8000000000000000))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] 0.5)) 0) (cast f64 0.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] 1.5)) 0) (cast f64 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] 2.5)) 0) (cast f64 2.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] 3.5)) 0) (cast f64 4.0)))
    (assert (p/fcmp-eq (v/vextract (v/vround (v/vsplat [f64 4] 3.75)) 0) (cast f64 4.0)))
    0))

(defn main [] (-> i64) (do (check-f32) (check-f64) 0))
