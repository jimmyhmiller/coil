(module arc_auto_runtime_closure_lifetime)
(import "coil.arc.auto-runtime" :as auto)
(import "coil.closure" :use *)

(defstruct Cell [(value i64)])

(defclosure read-cell
            [(cell Cell)]
            []
            i64
            (.value cell))

(defn main [] (-> i64)
  (do
    (let [cell (Cell :value 42)
          first (read-cell-new cell)
          second first]
      (+ (first) (- (second) 42)))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
