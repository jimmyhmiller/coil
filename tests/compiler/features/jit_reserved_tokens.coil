(module compiler.features.jit-reserved-tokens)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.compiler.driver" :as driver)
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (a/malloc-allocator))]
    (assert (= (jit/jit-generation-retain-reserved! (mut session)) -1))
    (assert (= (jit/jit-generation-token-leases (mut session)) 0))
    (assert (= (jit/jit-generation-reserve-tokens! (mut session) -1) -1))
    (assert (= (jit/jit-generation-reserve-tokens! (mut session) 9223372036854775807) -1))
    (assert (= (jit/jit-prepare-with-entry! (mut session) "(defn value [] (-> i64) 42)" "0") 0))
    (assert (= (jit/jit-generation-reserve-tokens! (mut session) 8) 0))
    (assert (= (jit/jit-generation-token-leases (mut session)) 0))
    (let [raw (driver/repl-session (.raw (mut session)))
          tokens (field raw client-tokens) buffer (.data tokens) capacity (.cap tokens)]
      (assert (= (jit/jit-publish-prepared! (mut session)) 0))
      (let [(mut token) 0]
        (for [i 0 capacity]
          (let [next (jit/jit-generation-retain-reserved! (mut session))]
            (assert (> next 0))
            (when (> i 0) (assert (= next (load token))))
            (set! token next)
            (assert (= (.data tokens) buffer))
            (assert (= (.cap tokens) capacity))))
        (assert (= (jit/jit-generation-retain-reserved! (mut session)) -1))
        (assert (= (jit/jit-generation-token-leases (mut session)) capacity))
        (assert (= (jit/jit-finalize-published! (mut session)) 0))
        (for [i 0 capacity]
          (assert (= (jit/jit-generation-release-token! (mut session) (load token)) (- (- capacity i) 1)))))
      (assert (= (jit/jit-generation-token-leases (mut session)) 0)))
    (assert (= (jit/jit-reset! (mut session)) 0)))
  0)
