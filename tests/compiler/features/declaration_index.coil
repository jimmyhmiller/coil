(module test.declaration-index)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.reader" :use [Sexp])
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [parse-program sx-at sx-items sx-sval])
(import "coil.compiler.comptime" :use [set-sem-model cp-find-fn cp-find-fn-exact cp-find-exact-decl])

(defn empty-program [(a (dyn Allocator))] (-> (ptr Program))
  (match (parse-program a (box! a (ArrayList Sexp) (al-new [Sexp] a)))
    (Ok [program] (box! a Program program))
    (Err [_] (do (assert false) (p/cast (ptr Program) 0)))))

(defn function [(a (dyn Allocator)) (name (slice u8))] (-> Func)
  (let [f (p/alloc-stack Func)]
    (set! f (p/zeroed Func))
    (set! (.name f) name)
    (set! (.ret f) (TInt 64 true))
    (set! (.params f) (box! a (ArrayList Param) (al-new [Param] a)))
    (load f)))

(defn main [] (-> i64)
  (let [a (malloc-allocator) program (empty-program a)]
    (push! (.funcs program) (function a "left.value"))
    (push! (.funcs program) (function a "right.value"))
    (push! (.funcs program) (function a "left.unique"))
    (set-sem-model program)
    (let [ambiguous (cp-find-fn program "value" "")
          qualified (cp-find-fn program "value" "right")
          unique (cp-find-fn program "unique" "")
          missing (cp-find-fn program "missing" "")]
      (assert-eq (.status ambiguous) 2)
      (assert-eq (.name (.fn ambiguous)) "left.value")
      (assert-eq (.status qualified) 0)
      (assert-eq (.name (.fn qualified)) "right.value")
      (assert-eq (.status unique) 0)
      (assert-eq (.status missing) 1))
    ; Exact lookup takes the first match, while a qualified name query must
    ; still detect duplicate declarations.
    (push! (.funcs program) (function a "left.value"))
    (assert-eq (.status (cp-find-fn program "value" "left")) 2)
    (assert-eq (p/cast i64 (cp-find-fn-exact program "left.value"))
               (p/cast i64 (al-elem [Func] (.funcs program) 0)))
    ; Republish the same address and list length with a renamed function.
    (set! (.name (al-elem [Func] (.funcs program) 2)) "left.renamed")
    (set-sem-model program)
    (assert-eq (.status (cp-find-fn program "unique" "")) 1)
    (assert-eq (.status (cp-find-fn program "renamed" "")) 0)
    (let [decl (cp-find-exact-decl a program "left.renamed")]
      (assert (.found decl))
      (assert-eq (sx-sval (sx-at (sx-items (.rec decl)) 3)) "left.renamed"))
    (let [record (p/alloc-stack StructDef)]
      (set! record (p/zeroed StructDef))
      (set! (.name record) "left.Record")
      (push! (.structs program) (load record)))
    (set-sem-model program)
    (let [decl (cp-find-exact-decl a program "left.Record")]
      (assert (.found decl))
      (assert-eq (sx-sval (sx-at (sx-items (.rec decl)) 2)) "struct"))
    (set! (.name (al-elem [StructDef] (.structs program) 0)) "left.Republished")
    (set-sem-model program)
    (assert (not (.found (cp-find-exact-decl a program "left.Record"))))
    (assert (.found (cp-find-exact-decl a program "left.Republished")))
    (set-sem-model (p/cast (ptr Program) 0))
    0))
