(module ownership_transform_recheck_rejected)
(import "coil.rc" :as rc)

(defn identity-transform [(modules Code)] (-> Code)
  `(do ~@modules))

(transform identity-transform :phase ownership)

(defstruct Payload [(value i64)])

(defn consume [(owner (rc/Rc Payload))] (-> i64)
  (.value (rc/rc-borrow owner)))

(defn main [] (-> i64)
  (match (rc/rc-new (Payload :value 1))
    (None [] 0)
    (Some [owner]
          (do
            (consume owner)
            (consume owner)))))
