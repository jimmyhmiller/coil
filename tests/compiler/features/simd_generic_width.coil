(module test.simd-generic-width)
(import "coil.primitive" :as primitive)
(import "coil.simd" :as v)

(defstruct Packet [T (const N i64)] [(values (vec T N))])

(defn seed [T (const N i64)] [(value T)] (-> (vec T N))
  (v/vinsert (v/vzero [T N]) 0 value))

(defn twice [T (const N i64)] [(value (vec T N))] (-> (vec T N))
  (v/vadd value value))

(defn first-lane [T (const N i64)] [(value (vec T N))] (-> T)
  (v/vextract value 0))

(defn through-generic [T (const N i64)] [(value (vec T N))] (-> T)
  (first-lane (twice value)))

(defn packet-first [T (const N i64)] [(packet (Packet T N))] (-> T)
  (first-lane (.values packet)))

(defn main [] (-> i64)
  (let [bytes (seed [u8 16] 21)
        words (seed [i32 8] 21)
        packet (Packet :values bytes)]
    (assert-eq (through-generic bytes) (cast u8 42))
    (assert-eq (through-generic words) (cast i32 42))
    (assert-eq (first-lane [u8 16] bytes) (cast u8 21))
    (assert-eq (packet-first packet) (cast u8 21))
    0))
