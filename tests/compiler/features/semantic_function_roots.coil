(module semantic-function-roots)
(import "coil.primitive" :as p)
(defstruct Point [(x i64)])
(def global 17)
(defn root-scalar [] (-> i64) (+ 1 2))
(defn root-record [] (-> Point) (Point :x 7))
(defn root-field [(point Point)] (-> i64) (.x point))
(defn root-local [(value i64)] (-> i64) value)
(defn root-global [] (-> i64) global)
(defn multiple-roots [(point Point)] (-> i64) (.x point) (+ 2 3))
(defn require-type [(node Code) (expected Code)] (-> i64)
  (unless (p/code-eq (p/type-of node) expected)
    (p/report node "function root has missing or incorrect semantic type") 0) 0)
(defn require-declaration [(node Code) (expected Code)] (-> i64)
  (let [decl (p/code-decl node)]
    (if (and (p/code-list? decl) (>= (p/code-count decl) 4))
      (unless (p/code-eq (p/code-nth decl 3) expected)
        (p/report node "function root has incorrect resolved identity") 0)
      (do (p/report node "function root has no resolved identity") 0))) 0)
(defn check-roots [(modules Code)] (-> Code)
  (for [mi 0 (p/code-count modules)]
    (let [module (p/code-nth modules mi)]
      (when (p/code-eq (p/code-nth module 0) `semantic-function-roots)
        (for [fi 1 (p/code-count module)]
          (let [form (p/code-nth module fi)]
            (when (and (p/code-list? form) (and (>= (p/code-count form) 5)
              (or (p/code-eq (p/code-nth form 0) `defn) (p/code-eq (p/code-nth form 0) `defn*))))
              (let [name (p/code-nth form 1) tail (p/code-nth form (- (p/code-count form) 1))]
                (cond
                  (p/code-eq name `root-record)
                    (require-type tail `semantic-function-roots.Point)
                  (p/code-eq name `root-field)
                    (do (require-type tail `i64) (require-declaration tail `coil.primitive.load))
                  (p/code-eq name `root-global)
                    (do (require-type tail `i64) (require-declaration tail `semantic-function-roots.global))
                  (p/code-eq name `multiple-roots)
                    (do (require-type (p/code-nth form 4) `i64)
                        (require-declaration (p/code-nth form 4) `coil.primitive.load)
                        (require-type tail `i64))
                  (or (p/code-eq name `root-scalar) (p/code-eq name `root-local))
                    (require-type tail `i64)
                  :else 0))) 0)))))
  `(do ~@modules))
(checker check-roots)
(defn main [] (-> i64)
  (let [point (root-record)]
    (if (and (= (root-field point) 7)
      (and (= (root-scalar) 3)
        (and (= (root-local 23) 23)
          (and (= (root-global) 17) (= (multiple-roots point) 5))))) 0 1)))
