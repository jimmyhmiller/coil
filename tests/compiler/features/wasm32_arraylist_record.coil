(module test.wasm32-arraylist-record)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-new al-push! al-get])
(import "coil.primitive" :as primitive)

; A slice before trailing scalar fields exercises wasm32's target-dependent
; aggregate layout. ArrayList indexing must use the same stride as LLVM uses
; for the stored value.
(defstruct Record
  [(first (ptr u8))
   (second (ptr u8))
   (kind i64)
   (tail bool)])

(defn record-new [(kind i64)] (-> Record)
  (let [(mut record) (primitive/zeroed Record)]
    (store! (field record second) (primitive/cast (ptr u8) 4096))
    (store! (field record kind) kind)
    (load record)))

(defn wasm32-arraylist-record [] (-> i64)
  (let [(mut records) (al-new [Record] (malloc-allocator))]
    (al-push! [Record] (mut records) (record-new 1))
    (al-push! [Record] (mut records) (record-new 6))
    (let [record (al-get [Record] records 1)]
      (load (field record kind)))))

(defn main [] (-> i64)
  (wasm32-arraylist-record))

(export-c [wasm32-arraylist-record :as "wasm32_arraylist_record"])
