;; A struct constructor's arguments are checked, then checked again inside the
;; generated constructor body; a `(mut …)` borrow in a nested call survives that.
(module struct-ctor-mut-borrow-arg)
(import "coil.alloc" :as alloc)
(import "coil.arraylist" :use *)

(defstruct Owned [(keys (slice i64)) (count i64)])

(defn main [] (-> i64)
  (let [(mut keys) (al-new [i64] (alloc/malloc-allocator))]
    (push! [i64] (mut keys) 40)
    (push! [i64] (mut keys) 2)
    (let [owned (Owned :count (len keys) :keys (al-into-slice (mut keys)))]
      (println "{} {}" (+ (get (.keys owned) 0) (get (.keys owned) 1)) (.count owned))
      (alloc/free [i64] (alloc/malloc-allocator) (.keys owned))
      0)))
