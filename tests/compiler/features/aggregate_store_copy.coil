(module test.aggregate-store-copy)
(import "coil.primitive" :as p)

(defstruct Block [(items (array i64 2048))])

(defn copy-block [(dst (ptr Block)) (src (ptr Block))] (-> i64)
  (set! dst (load src))
  0)

(defn copy-items [(dst (ptr Block)) (src (ptr Block))] (-> i64)
  (set! (field dst items) (load (field src items)))
  0)

(defn destination [(dst (ptr Block)) (src (ptr Block)) (order (ptr i64))] (-> (ptr Block))
  (assert-eq (load order) 0)
  (set! order 1)
  (set! (p/index (field src items) 0) 43)
  dst)

(defn source [(src (ptr Block)) (order (ptr i64))] (-> (ptr Block))
  (assert-eq (load order) 1)
  (set! order 2)
  src)

(defn ordered-copy [(dst (ptr Block)) (src (ptr Block)) (order (ptr i64))] (-> i64)
  (set! (destination dst src order) (load (source src order)))
  0)

(defn main [] (-> i64)
  (let [buffer (p/alloc-stack (array i64 2049))
        src (p/cast (ptr Block) buffer)
        dst (p/cast (ptr Block) (p/index buffer 1))]
    (set! buffer (p/zeroed (array i64 2049)))
    (set! (p/index buffer 0) 17)
    (set! (p/index buffer 2047) 29)
    (copy-block dst src)
    (assert-eq (load (p/index buffer 1)) 17)
    (assert-eq (load (p/index buffer 2048)) 29)
    (assert-eq (load (p/index buffer 2047)) 0)
    (copy-items dst dst)
    (copy-block dst dst)
    (assert-eq (load (p/index buffer 1)) 17)
    (let [(mut order) 0]
      (ordered-copy dst src (mut order))
      (assert-eq order 2)
      (assert-eq (load (p/index buffer 1)) 43))
    0))
