; A trait method parameter spelled over `Self` is checked with value ABI — the

; generic body has no aggregate representation to reference yet. The implementing
; method takes the substituted aggregate by Coil's implicit immutable reference,
; so monomorphization has to materialize the argument into a place. It did not:
; the instance handed the aggregate by VALUE to a pointer parameter, which the
; LLVM backend spilled behind the scenes while the native backends passed the
; aggregate's first word as the address and dereferenced it.
(module generic-trait-call-aggregate-abi)
(import "coil.assert" :use [assert])
(import "coil.primitive" :as primitive)

(defstruct Pair [(left i64) (right i64)])

(defstruct Triple [(a i64) (b i64) (c i64)])

(deftrait Total [Self]
  (total [(value Self)] (-> i64)))

(impl Total Pair
  (total [(pair Pair)]
         (-> i64)
         (+ (primitive/load (primitive/field pair left))
            (primitive/load (primitive/field pair right)))))

(impl Total Triple
  (total [(triple Triple)]
         (-> i64)
         (+ (primitive/load (primitive/field triple a))
            (+ (primitive/load (primitive/field triple b))
               (primitive/load (primitive/field triple c))))))

(impl Total i64
  (total [(value i64)] (-> i64) value))

(defn doubled-total [(T Total)] [(value T)] (-> i64)
  (* (total value) 2))

; A second bound parameter proves the reconciliation is per-argument rather than
; per-call: only the aggregates need an address.
(defn total-gap [(T Total) (U Total)] [(lo T) (hi U)] (-> i64)
  (- (total hi) (total lo)))

; The generic instance still returns its aggregate by value.
(defn ident [(T Total)] [(value T)] (-> T)
  value)

(defn main [] (-> i64)
  (assert (= (doubled-total (Pair :left 10 :right 20)) 60))
  (assert (= (doubled-total (Triple
                              :a 1
                              :b 2
                              :c 3))
             12))
  (assert (= (doubled-total 21) 42))
  (assert (= (total-gap (Pair :left 1 :right 1)
                        (Triple
                          :a 4
                          :b 5
                          :c 6))
             13))
  (assert (= (total-gap 2 (Pair :left 3 :right 4)) 5))
  (assert (= (total (ident (Pair :left 8 :right 9))) 17))
  0)
