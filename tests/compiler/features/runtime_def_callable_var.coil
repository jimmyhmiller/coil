(module runtime-def-callable-var)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])

(defn double [(x i64)] (-> i64)
  (* x 2))

(defn triple [(x i64)] (-> i64)
  (* x 3))

(def hot (var-static (fnptr c [i64] i64) (primitive/fnptr-of double)))

(defn main [] (-> i64)
  (let [alias hot
        before (hot 10)]
    (set hot (primitive/fnptr-of triple))
    (+ (- before 20)
       (- (alias 10) 30))))
