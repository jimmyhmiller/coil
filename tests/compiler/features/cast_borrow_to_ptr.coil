; `(cast (ptr T) (mut x))` is the explicit address of a local, for code that
; takes a raw pointer. It also works at compile time.
(module cast-borrow-to-ptr)

(defstruct Pair [(a i64) (b i64)])

(defn clear! [(words (ptr i64)) (n i64)] (-> i64)
  (for i (range 0 n) (store! (index words i) 0))
  0)

(defn sum-through-pointer [] (-> i64)
  (let [(mut p) (Pair :a 20 :b 22)
        raw (cast (ptr Pair) (mut p))]
    (+ (.a raw) (.b raw))))

(const SUM (sum-through-pointer))

(defn main [] (-> i64)
  (let [(mut p) (Pair :a 5 :b 6)
        (mut n) 9]
    (clear! (cast (ptr i64) (mut p)) 2)
    (store! (cast (ptr i64) (mut n)) 3)
    (println "{} {} {} {}" (.a p) (.b p) n SUM)
    0))
