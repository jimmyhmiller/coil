(module compiler.features.derive-qualified-shape)
(import "coil.primitive" :as p)
(import "coil.derive" :use [derive])

; A distinct record with the same basename must not steal the sum deriver.
(defstruct Result [(value i64)])
(defn record-arm [(T Code)] (-> Code) (p/error "qualified sum selected record arm"))
(defn sum-arm [(T Code)] (-> Code) '(defstruct Generated []))
(defderive Shape
  (struct [T] (record-arm T))
  (sum [T] (sum-arm T)))
(derive Shape (coil.core.Result T E))
(defn main [] (-> i64) 0)
