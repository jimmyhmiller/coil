(module callable)

; Callable dispatch stays static for both concrete and generic implementing types.

(defstruct Vec3 [(x i64) (y i64) (z i64)])

(defn get [(v Vec3) (index i64)] (-> i64)
  (if (= index 0)
      (load (field v x))
      (if (= index 1) (load (field v y)) (load (field v z)))))

(impl Callable Vec3
  (call [(self Vec3) (index i64)] (-> i64)
    (get self index)))

(defstruct Box [T] [(value T)])

(impl [T] Callable (Box T)
  (call [(self (Box T))] (-> T)
    (load (field self value))))

(deftrait Invokable [Self A R]
  (call :inline (Always) [(self Self) (x A)] (-> R)))
(defstruct OtherCallable [(unused i64)])

; `call` is an ordinary member of an ordinary namespaced trait.
(impl Invokable OtherCallable
  (call [(self OtherCallable) (x i64)] (-> i64) x))

(defn main [] (-> i64)
  (let [v (Vec3 :x 10 :y 20 :z 30)
        b (Box :value 12)
        q (OtherCallable :unused 0)]
    (+ (- (v 2) (b)) (q 7))))
