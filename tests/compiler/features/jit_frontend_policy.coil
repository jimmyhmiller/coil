(module compiler.features.jit-frontend-policy)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (if (!= (jit/jit-session-set-legacy-reload! (mut session) false) 0)
        1
        (if (!= (jit/jit-submit! (mut session) "(defn identity [(x i64)] (-> i64) x)") 0)
            2
            (if (!= (jit/jit-session-set-legacy-reload! (mut session) true) -1)
                3
                0)))))
