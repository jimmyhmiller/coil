(module compiler.features.jit-frontend-policy)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut session)
                                "(defn identity [(x i64)] (-> i64) x)")
              0)
            1
          (!= (jit/jit-evaluate! (mut session) "(identity 7)") 0) 2
          (!= (jit/jit-compile! (mut session)
                                "(deftrait Later [Self] (later [(value Self)] (-> Self))) (impl Later i64 (later [(value i64)] (-> i64) (+ value 1)))")
              0)
            3
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(defn uses-later [] (-> i64) (later 41))"
                                           "(if (= (uses-later) 42) 0 90)")
              0)
            4
          :else (jit/jit-reset! (mut session)))))
