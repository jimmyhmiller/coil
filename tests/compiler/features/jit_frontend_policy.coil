(module compiler.features.jit-frontend-policy)

(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (if (!= (jit/jit-session-set-legacy-reload! (mut session) false) 0)
        1
        (if (!= (jit/jit-submit! (mut session) "(defn identity [(x i64)] (-> i64) x)") 0)
            2
            (if (!= (jit/jit-submit! (mut session) "(identity 7)") 0)
                3
                (if (< (jit/jit-reclaim-retired! (mut session)) 0)
                    4
                    (if (!= (jit/jit-submit! (mut session) "(identity 8)") 0)
                        5
                        (if (!= (jit/jit-session-set-legacy-reload! (mut session) true) -1)
                            6
                            (if (!= (jit/jit-replace-source! (mut session)
                                      "(deftrait Later [Self] (later [(value Self)] (-> Self)))\n(impl Later i64 (later [(value i64)] (-> i64) (+ value 1)))") 0)
                                7
                                (if (!= (jit/jit-submit! (mut session)
                                          "(defn uses-later [] (-> i64) (later 41))") 0)
                                    8
                                    0))))))))))
