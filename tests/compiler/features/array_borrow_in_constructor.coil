;; An array place borrowed as a slice, or indexed through `get`, inside a struct
;; constructor's arguments. The constructor checks its arguments a second time, and
;; the borrow must survive that (coil-bugs cj772fafy49).
(module array-borrow-in-constructor)

(defstruct R [(x i64) (y i64)])
(defstruct Window [(items (slice i64)) (first i64)])

(defn sum [(xs (slice i64))] (-> i64) (fold (fn [a b] (+ a b)) 0 xs))

(defn main [] (-> i64)
  (let [parts [7 8]
        r (R :x (get parts 0) :y (get parts 1))
        w (Window :items parts :first (get parts 0))]
    (println "{} {} {} {}" (.x r) (.y r) (sum (.items w)) (.first w))
    0))
