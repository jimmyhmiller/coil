(module compiler.features.jit-deep-source)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.str" :use [sb-new sb-push-str! sb-str])
(import "coil.jit" :as jit)

; The front end recurses once per level of source nesting, and its frames are
; large (the parser's list case alone is ~34 KiB), so it needs the compiler's
; worker stack. An embedding host calls in from its own thread — here the 8 MiB
; main thread — so every entry point runs its front-end work on a
; compiler-sized worker. 1500 levels needs tens of MiB of stack and is under the
; parser's 2000-level limit; it overflowed `jit-env-check` on the host's thread.

(defn nested-source [(levels i64)] (-> (slice u8))
  (let [(mut out) (sb-new (malloc-allocator))]
    (sb-push-str! (mut out) "(module deep) (defn depth [] (-> i64) ")
    (for [i 0 levels] (sb-push-str! (mut out) "(+ 1 "))
    (sb-push-str! (mut out) "0")
    (for [i 0 levels] (sb-push-str! (mut out) ")"))
    (sb-push-str! (mut out) ") (export-c [depth :as \"coil_deep_depth\"])")
    (sb-str out)))

(defn main [] (-> i64)
  (let [source (nested-source 1500)
        (mut checked) (jit/jit-checked-session-new (malloc-allocator))
        env (jit/jit-env-check (mut checked) (jit/jit-env-empty) source)]
    (assert (jit/jit-env-valid? env))
    (assert (jit/jit-env-defines? (mut checked) env "deep.depth"))
    (jit/jit-env-release! (mut checked) env)
    (jit/jit-session-free! (mut checked))
    (let [(mut native) (jit/jit-session-new (malloc-allocator))]
      (assert (= (jit/jit-compile! (mut native) source) 0))
      (let [address (jit/jit-symbol-address (mut native) "coil_deep_depth")]
        (assert (!= (cast i64 address) 0))
        (assert (= (call-ptr (cast (fnptr c [] i64) address)) 1500)))
      (jit/jit-session-free! (mut native)))
    0))
