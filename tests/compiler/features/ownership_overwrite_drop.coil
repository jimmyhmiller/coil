(module ownership_overwrite_drop)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))] (-> void)
    (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defstruct Container [(leaf Leaf)])

(defn replace-whole [] (-> i64)
  (store! (counter) 0)
  (let [(mut owner) (Leaf :value 1)]
    (store! owner (Leaf :value 2)))
  ; Replacing drops 1 before the new owner drops 2 at scope exit.
  (load (counter)))

(defn replace-field [] (-> i64)
  (store! (counter) 0)
  (let [(mut container) (Container :leaf (Leaf :value 3))]
    (set! (.leaf container) (Leaf :value 4)))
  ; Projection overwrite destroys only the old field, then aggregate glue drops
  ; the replacement at scope exit.
  (load (counter)))

(defn consume [(owner Leaf)] (-> void))

(defn reinitialize-moved [] (-> i64)
  (store! (counter) 0)
  (let [(mut owner) (Leaf :value 4)]
    (consume owner)
    (store! owner (Leaf :value 5)))
  ; The callee drops 4 and the reinitialized caller slot later drops 5.
  (load (counter)))

(defn main [] (-> i64)
  (+ (+ (replace-whole) (replace-field)) (reinitialize-moved)))
