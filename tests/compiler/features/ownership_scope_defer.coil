(module ownership_scope_defer)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn record [(value i64)] (-> void)
  (store! (counter) (+ (* (load (counter)) 10) value)))

(defstruct Owner [(value i64)])
(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (record (.value self))))

(defn main [] (-> i64)
  (store! (counter) 0)
  (let [result
          (scope :request
            (defer (record 9))
            (let [owner (Owner :value 1)]
              (return-from :request 4)))]
    ; The inner owner drops before the enclosing scope performs its explicit
    ; defer. The carried return-from value survives both cleanup layers.
    (+ (* (load (counter)) 10) result)))
