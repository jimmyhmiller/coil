(module test.simd-core)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)
(import "coil.slice" :use [slice-data])

(defn classify [N] [(bytes (vec u8 N))] (-> u64)
  (let [digits (v/vand (v/v>= bytes (v/vsplat [u8 N] 48))
                      (v/v<= bytes (v/vsplat [u8 N] 57)))]
    (v/mask->bits digits)))

(defn main [] (-> i64)
  (let [bytes (v/vloadu [u8 16] (slice-data "a0b1c2d3e4f5g6h7"))]
    (assert-eq (classify bytes) (cast u64 0xaaaa))
    (assert-eq (v/vlanes bytes) 16)
    (assert-eq (v/vextract bytes 0) (cast u8 97))
    (assert-eq (v/vextract bytes 16) (cast u8 0))
    (assert-eq (v/vextract (v/vinsert bytes 0 42) 0) (cast u8 42))
    (assert-eq (v/mask->bits (v/bits->mask [16] 0x8001)) (cast u64 0x8001))
    (assert-eq (v/vextract (v/vadd (v/vsplat [u8 16] 255) (v/vsplat [u8 16] 1)) 0)
               (cast u8 0))
    (assert (p/fcmp-eq (v/vextract (v/vmul (v/vsplat [f32 4] 2.0)
                                         (v/vsplat [f32 4] 3.0)) 3)
                      (cast f32 6.0)))
    0))
