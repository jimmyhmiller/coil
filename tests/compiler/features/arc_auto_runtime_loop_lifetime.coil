(module arc_auto_runtime_loop_lifetime)
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defn main [] (-> i64)
  (do
    (let [(mut i) 0]
      (loop
        (let [iteration (Cell :value (load i))]
          (set! i (+ (load i) 1))
          (if (< (load i) 4)
              (continue)
              (break)))))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
