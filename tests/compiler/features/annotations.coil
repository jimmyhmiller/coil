(module annotations)

(defsum Route
  (Get [(path (slice u8))])
  (Post [(path (slice u8))]))

(defannotation :http/route Route)

(defannotation :tool/tag Keyword)

(defn add-one :inline (Always) [(x i64)] (-> i64)
  (+ x 1))

(defn hinted :inline (Hint) [(x i64)] (-> i64)
  (+ x 2))

(defn kept-out-of-line :inline (Never) [(x i64)] (-> i64)
  (+ x 3))

(defn users :http/route (Get "/users") :tool/tag :hot [] (-> i64)
  (add-one (hinted (kept-out-of-line 36))))

(defn keyword-value [] (-> Keyword)
  :hot)

(defn main [] (-> i64)
  (match (keyword-value)
    (KeywordValue [_] (if (= (users) 42) 0 1))))
