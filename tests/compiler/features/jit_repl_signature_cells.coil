(module compiler.features.jit-repl-signature-cells)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Each ABI keeps its callers and stored pointers; same-ABI edits update its cell.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            "(import \"coil.repl\")\n(import \"coil.alloc\" :use [malloc-allocator box! free alloc-slice-new])\n(import \"coil.primitive\" :as primitive)\n(import \"coil.var\" :use [var-static])\n(defn damage [(target i64) (amount f32)] (-> f32) (+ amount 1.0))\n(defstruct Holder [(callback (fnptr c [i64 f32] f32))])\n(def saved (fnptr-of damage))\n(def heap (var-static (ptr Holder) (primitive/cast (ptr Holder) 0)))\n(defn old-caller [] (-> f32) (damage 0 (cast f32 2.0)))\n(defn old-global [] (-> f32) (saved 0 (cast f32 2.0)))\n(defn old-heap [] (-> f32) (let [callback (.callback (get heap))] (callback 0 (cast f32 2.0))))"
                                            "(coil.repl/publish)")
               0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(do (set heap (box! (malloc-allocator) Holder (Holder :callback (fnptr-of damage)))) 0)")
               0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            "(defn damage [(target i64) (amount i32)] (-> f32) (+ (cast f32 amount) 10.0))\n(defn coupled [] (-> f32) (damage 0 (cast i32 2)))\n(def int-saved (fnptr-of damage))"
                                            "(coil.repl/publish)")
               0))
    (assert (>= (jit/jit-reclaim-retired! (mut session)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(if (and (= (old-caller) 3.0) (= (old-global) 3.0) (= (old-heap) 3.0) (= (coupled) 12.0) (= (int-saved 0 (cast i32 2)) 12.0)) 0 91)")
               0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            "(defn damage [(target i64) (amount i32)] (-> f32) (+ (cast f32 amount) 20.0))"
                                            "(coil.repl/publish)")
               0))
    (assert (>= (jit/jit-reclaim-retired! (mut session)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(if (and (= (coupled) 22.0) (= (int-saved 0 (cast i32 2)) 22.0) (= (old-caller) 3.0)) 0 92)")
               0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            "(defn damage [(target i64) (amount f32)] (-> f32) (+ amount 30.0))"
                                            "(coil.repl/publish)")
               0))
    (assert (>= (jit/jit-reclaim-retired! (mut session)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(if (and (= (old-caller) 32.0) (= (old-global) 32.0) (= (old-heap) 32.0) (= (coupled) 22.0)) 0 93)")
               0))
    (assert (!= (jit/jit-compile-with-entry! (mut session)
                                             "(defn damage [(target i64) (amount i16)] (-> f32) missing-value)"
                                             "(coil.repl/publish)")
                0))
    (assert (>= (jit/jit-reclaim-retired! (mut session)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(if (and (= (damage 0 (cast f32 2.0)) 32.0) (= (coupled) 22.0)) 0 94)")
               0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
                                            ""
                                            "(do (free [Holder] (malloc-allocator) (alloc-slice-new (get heap) 1)) 0)")
               0))
    (jit/jit-session-free! (mut session))
    0))
