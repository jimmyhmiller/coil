(module compiler.features.jit-repl-signature-cells)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Each signature generation has its own live cell. Old callers and pointers must
; survive publication, abort, later compatible edits, and metadata reclamation.
(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(module signature-cells) (import \"coil.repl\") (import \"coil.alloc\") (import \"coil.var\") (import \"coil.primitive\" :as p)
       (defn f [] (-> i64) 6) (defn f [] (-> i64) 7)
       (defn idle [] (-> i64) (f))
       (def old-global (fnptr-of f))
       (def old-heap (coil.var/var-static (ptr (fnptr c [] i64)) (cast (ptr (fnptr c [] i64)) 0)))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(do (set old-heap (coil.alloc/box! (coil.alloc/malloc-allocator) (fnptr c [] i64) (fnptr-of f))) 0)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defn f [] (-> i64) 9)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-prepare-with-entry! (mut s)
      "(defn f [] (-> bool) true)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-abort-prepared! (mut s)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(if (= (f) 9) 0 1)") 0))
    (assert (!= (jit/jit-compile-with-entry! (mut s)
      "(defn f [] (-> bool) missing-value)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(if (= (f) 9) 0 1)") 0))
    ; The caller precedes the changed definition in the same transaction.
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defn fresh [] (-> bool) (f)) (defn f [] (-> bool) true)"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defn f [] (-> bool) false)" "(coil.repl/publish)") 0))
    (assert (>= (jit/jit-reclaim-retired! (mut s)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(if (and (not (fresh))
                (and (= (idle) 9)
                     (and (= (old-global) 9) (= (p/call-ptr (load (get old-heap))) 9)))) 0 1)") 0))
    ; Returning to an earlier signature starts another generation.
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defn f [] (-> i64) 42)" "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(do (coil.alloc/destroy (coil.alloc/malloc-allocator) (get old-heap))
           (if (and (= (f) 42) (and (= (idle) 9) (not (fresh)))) 0 1))") 0))
    (jit/jit-reset! (mut s))))
