(module test.simd-guard-page)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(extern getpagesize [] (-> i32))
(extern mmap [(ptr u8) u64 i32 i32 i32 i64] (-> (ptr u8)))
(extern mprotect [(ptr u8) u64 i32] (-> i32))
(extern munmap [(ptr u8) u64] (-> i32))

(defn anonymous-flags [] (-> Code)
  (if (p/code-eq (p/target-os) `darwin) `4098 `34))

(defn main [] (-> i64)
  (let [page (cast i64 (getpagesize))
        mapping (mmap (cast (ptr u8) 0) (cast u64 (* page 2)) 3 (anonymous-flags) -1 0)
        boundary (p/index mapping page)]
    (assert (!= (cast i64 mapping) -1))
    (assert-eq (mprotect boundary (cast u64 page) 0) (cast i32 0))
    (for [i 0 page] (store! (p/index mapping i) (cast u8 37)))
    ; Every tail length, including zero with the pointer inside PROT_NONE.
    (for [count 0 65]
      (let [start (p/index boundary (- 0 count))
            fill (v/vsplat [u8 64] 99)
            active (v/mask-low [64] count)
            value (v/vload-partial start count fill)
            offsets (v/viota [i64 64])
            gathered (v/vgather start offsets active fill)]
        (for [i 0 64]
          (assert-eq (v/vextract value i) (if (< i count) (cast u8 37) (cast u8 99)))
          (assert-eq (v/vextract gathered i) (v/vextract value i)))
        (v/vstore-partial start count (v/vsplat [u8 64] 37))
        (v/vscatter start offsets active (v/vsplat [u8 64] 37))
        (assert-eq (v/vcompress-store start active (v/vsplat [u8 64] 37)) count)
        (assert (v/mask-all? (v/v= (v/vexpand-load start active fill) value)))))
    (assert-eq (munmap mapping (cast u64 (* page 2))) (cast i32 0))
    0))
