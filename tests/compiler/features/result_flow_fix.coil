(module result_flow_fix)
(import "coil.result" :use [ok? err?])

; `coil lint --fix` input for the result-flow checker. Every fix must compile and
; keep behavior; the fast gate compares the program's output before and after.

(defstruct Big [(x i64) (y i64)])

(defn found [(ok bool)] (-> (Result Big i64))
  (if ok (Ok (Big :x 1 :y 2)) (Err 1)))

; The Ok binder is the block's tail, and the fallback is a fresh value.
(defn tail-binder [(ok bool)] (-> i64)
  (let [(mut b) (match (found ok)
                  (Ok [v] v)
                  (Err [_] (Big :x 10 :y 20)))]
    (set! (.x b) (+ (.x b) 100))
    (+ (.x b) (.y b))))

; An aggregate `let` cannot be rebound mutably, so the rebinding is fused into
; the `try-or!` binding.
(defn rebound-mutably [(ok bool)] (-> i64)
  (match (found ok)
    (Err [_] 0)
    (Ok [query] (let [(mut owned) query]
                  (set! (.y owned) 7)
                  (+ (.x owned) (.y owned))))))

; Not the first binding: no suggestion.
(defn rebound-later [(ok bool)] (-> i64)
  (match (found ok)
    (Err [_] 0)
    (Ok [query] (let [k 5
                      (mut owned) query]
                  (set! (.x owned) k)
                  (.x owned)))))

; An Ok binder of `_` unwraps nothing: a match answering true/false is `ok?` or
; `err?`, and any other stays a match.
(defn present? [(ok bool)] (-> bool)
  (match (found ok) (Ok [_] true) (Err [_] false)))

(defn absent? [(ok bool)] (-> bool)
  (match (found ok) (Err [_] true) (Ok [_] false)))

(defn weight [(ok bool)] (-> i64)
  (match (found ok) (Ok [_] 5) (Err [_] 0)))

(defn main [] (-> i64)
  (println "{} {} {} {} {} {}" (present? true) (present? false) (absent? true) (absent? false)
           (weight true) (weight false))
  (println "{} {} {} {} {} {}"
           (tail-binder true)
           (tail-binder false)
           (rebound-mutably true)
           (rebound-mutably false)
           (rebound-later true)
           (rebound-later false))
  0)
