(module generated.llvm-session-test)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io)
(import "coil.scratch" :as scratch)
(import "coil.reader" :use [Sexp Diag])
(import "coil.compiler.ast" :use *)
(import "coil.compiler.parser" :use [parse-program])
(import "coil.compiler.loader" :use [cstr->slice])
(import "coil.compiler.codegen" :as cg)
(import "coil.compiler.ffi" :use *)

(defn require [(ok bool) (message (slice u8))] (-> i64)
  (unless ok
    (io/write-all (io/stderr)
                  (str->cstr (malloc-allocator) message)
                  (len message))
    (exit 1))
  0)

(defn expression [(a (dyn Allocator)) (kind ExprKind)] (-> (ptr Expr))
  (let [e (box! a Expr (p/zeroed Expr))]
    (set! (.kind e) kind)
    (set! (.source e) -1)
    e))

(defn call-expr [(a (dyn Allocator)) (name (slice u8)) (argument (ptr Expr))] (-> (ptr Expr))
  (let [args (box! a (ArrayList Expr) (al-new [Expr] a))]
    (unless (= (p/cast i64 argument) 0) (push! args (load argument)) 0)
    (expression a (ECall name (box! a (ArrayList Type) (al-new [Type] a)) args))))

(defn signature [(a (dyn Allocator)) (index i64)] (-> (ptr Func))
  (let [f (box! a Func (p/zeroed Func))]
    (set! (.name f)
          (cond (= index 0) "main"
                (= index 1) "answer"
                (= index 2) "counter"
                :else "plus-one"))
    (set! (.cc f) "c")
    (set! (.ret f) (TInt 64 true))
    (set! (.params f) (box! a (ArrayList Param) (al-new [Param] a)))
    (set! (.type_params f)
          (box! a (ArrayList (slice u8)) (al-new [(slice u8)] a)))
    (set! (.bounds f) (box! a (ArrayList Bound) (al-new [Bound] a)))
    (set! (.annotations f)
          (box! a (ArrayList Annotation) (al-new [Annotation] a)))
    (set! (.body f) (box! a (ArrayList Expr) (al-new [Expr] a)))
    (when (= index 3)
      (push! (.params f)
             (Param
               :name "x"
               :positional_only false
               :ty (TInt 64 true)
               :bid 0
               :owned_type (p/cast (ptr Type) 0)))
      0)
    f))

(defn body [(a (dyn Allocator)) (index i64)] (-> (ptr Func))
  (let [f (signature a index)
        none (p/cast (ptr Expr) 0)
        node
          (cond (= index 0) (call-expr a "answer" none)
                (= index 1)
                  (expression a
                              (EBin 0
                                    (expression a
                                                (EBin 0
                                                      (call-expr a
                                                                 "counter"
                                                                 none)
                                                      (call-expr a
                                                                 "counter"
                                                                 none)))
                                    (call-expr a
                                               "plus-one"
                                               (expression a (EInt 24)))))
                (= index 2)
                  (let [binds (box! a (ArrayList Bind) (al-new [Bind] a))
                        seq (box! a (ArrayList Expr) (al-new [Expr] a))
                        place (expression a (EVar "cell"))]
                    (push! binds
                           (Bind
                             :name "cell"
                             :mutable false
                             :value
                               (load (expression a
                                                 (EAlloc 1
                                                         (TInt 64 true)
                                                         (expression a (EInt 7))
                                                         (None))))
                             :bid 0
                             :owned_type (p/cast (ptr Type) 0)))
                    (push! seq
                           (load (expression a
                                             (EStore place
                                                     (expression a
                                                                 (EBin 0
                                                                       (expression a
                                                                                   (ELoad place))
                                                                       (expression a
                                                                                   (EInt 1))))))))
                    (push! seq (load (expression a (ELoad place))))
                    (expression a (ELet binds seq)))
                :else
                  (expression a
                              (EBin 0
                                    (expression a (EVar "x"))
                                    (expression a (EInt 1)))))]
    (push! (.body f) (load node))
    f))

(defn program [(a (dyn Allocator)) (with-bodies bool)] (-> (ptr Program))
  (let [empty (box! a (ArrayList Sexp) (al-new [Sexp] a))
        program
          (match (parse-program a empty)
            (Ok [out] (box! a Program out))
            (Err [_]
                 (do
                   (require false "empty program construction failed")
                   (p/cast (ptr Program) 0))))]
    (for [i 0 4]
      (push! (.funcs program)
             (load (if with-bodies (body a i) (signature a i))))
      0)
    program))

(defn verify [(module (ptr i8))] (-> i64)
  (let [message (p/alloc-stack (ptr i8))]
    (store! message (p/cast (ptr i8) 0))
    (require (= (LLVMVerifyModule module 2 message) (p/cast i32 0))
             "incremental module failed LLVM verification")
    (unless (= (p/cast i64 (load message)) 0)
      (LLVMDisposeMessage (load message))
      0))
  0)

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        declarations (program a false)
        ordinary
          (cg/codegen-module a (program a true) (p/cast (ptr i8) 0) 0 false)
        incremental
          (cg/codegen-session-open a declarations (p/cast (ptr i8) 0) 0 false)]
    (for [i 0 4]
      (let [arena (p/alloc-stack scratch/ScratchArena)]
        (scratch/scratch-init-with-cap arena a 65536)
        (let [temporary (scratch/scratch-allocator arena)
              f (body temporary i)]
          (match (cg/codegen-session-function! incremental f temporary)
            (Ok [_] 0)
            (Err [_] (require false "incremental function failed")))
          (match (cg/codegen-session-function! incremental f temporary)
            (Ok [_] (require false "duplicate body was accepted"))
            (Err [_] 0)))
        (scratch/scratch-close! arena))
      0)
    (let [module (cg/codegen-session-finish! incremental)
          expected (LLVMPrintModuleToString ordinary)
          actual (LLVMPrintModuleToString module)]
      (verify ordinary)
      (verify module)
      (require (= (cstr->slice expected) (cstr->slice actual))
               "incremental/ordinary LLVM IR differs")
      (require (= (p/cast i64 (cg/codegen-session-finish! incremental)) 0)
               "finish transferred module twice")
      (match (cg/codegen-session-function! incremental (body a 0) a)
        (Ok [_] (require false "closed session accepted body"))
        (Err [_] 0))
      (io/write-all (io/stdout) actual (len (cstr->slice actual)))
      (LLVMDisposeMessage expected)
      (LLVMDisposeMessage actual)
      (cg/codegen-dispose-module! ordinary)
      (cg/codegen-dispose-module! module))
    (let [abandoned
            (cg/codegen-session-open a declarations (p/cast (ptr i8) 0) 0 false)]
      (cg/codegen-session-abort! abandoned)
      (cg/codegen-session-abort! abandoned))
    0))
