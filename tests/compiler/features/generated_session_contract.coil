(module generated.session-contract-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)
(import "coil.io" :as io)
(import "coil.reader" :use *)
(import "coil.compiler.driver" :as driver)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.parser" :use [sconcat])
(import "coil.compiler.expander" :use [ReadDefault ReadForms])
(import "coil.compiler.ffi" :use [getenv])
(import "coil.compiler.metaengine" :use [access])
(import "coil.compiler.metaengine" :as engine)
(import "coil.compiler.ast" :as ast)
(import "coil.compiler.parser" :as parser)
(import "coil.compiler.comptime" :as ct)
(import "coil.compiler.metahost" :as host)
(import "coil.compiler.unit_state" :as unit)
(import "coil.compiler.ctval" :as values)
(import "coil.compiler.codelib" :as codes)
(import "coil.compiler.codegen_a64" :as native)
(import "coil.compiler.generated_symbols" :as symbols)
(import "coil.scratch" :as scratch)

(defn require [(ok bool) (message (slice u8))] (-> i64)
  (if ok 0 (do (io/write-all (io/stderr) (str->cstr (malloc-allocator) message) (len message)) (abort) 0)))

(defn form [(a (dyn Allocator)) (source (slice u8))] (-> Sexp)
  (match (read-all a source 0)
    (Ok [forms] (get (load forms) 0))
    (Err [_] (do (require false "invalid test form") (primitive/zeroed Sexp)))))

(defn multiplicity [(a (dyn Allocator))] (-> i64)
  (let [state (primitive/alloc-stack LS)
        one (form a "(extern alpha :cc c [] (-> i64))")
        two (form a "(extern beta :cc c [] (-> i64))")
        (mut snapshot) (al-new [driver/GeneratedInterfaceForm] a)]
    (ls-init! (mut state) a)
    (push! (mut snapshot) (driver/GeneratedInterfaceForm :module "generated.interface" :form one :whole-module true))
    (push! (mut snapshot) (driver/GeneratedInterfaceForm :module "generated.interface" :form two :whole-module true))
    (push! (mut (.out state)) (mk-tagged one (Some "generated.interface")))
    (push! (mut (.out state)) (mk-tagged one (Some "generated.interface")))
    (require (not (driver/generated-interfaces-unchanged? a (mut state) (mut snapshot)))
             "duplicate declaration consumed two distinct snapshot entries")
    (store! (al-elem [TaggedForm] (field state out) 0) (mk-tagged two (Some "generated.interface")))
    (require (driver/generated-interfaces-unchanged? a (mut state) (mut snapshot))
             "declaration reordering must preserve the interface")
    (push! (mut snapshot) (driver/GeneratedInterfaceForm :module "generated.interface" :form one :whole-module true))
    (push! (mut (.out state)) (mk-tagged two (Some "generated.interface")))
    (require (not (driver/generated-interfaces-unchanged? a (mut state) (mut snapshot)))
             "equal sets with different multiplicities must not compare equal")
    (store! (al-elem [TaggedForm] (field state out) 2) (mk-tagged one (Some "generated.interface")))
    (require (driver/generated-interfaces-unchanged? a (mut state) (mut snapshot))
             "matching repeated declarations must compare equal")))

; There is no public Code sentinel for declining a reader invocation today.
; Exercise the production transaction finalizer with its actual ReadDefault
; result, then retry in the same session with a different body and namespace map.
(defn shared-symbol-ownership [(a (dyn Allocator))] (-> i64)
  (let [owners (symbols/owners-new a)
        (mut first) (al-new [(slice u8)] a)
        (mut second) (al-new [(slice u8)] a)]
    (push! (mut first) "existing")
    (push! (mut second) "fresh") (push! (mut second) "existing")
    (match (symbols/owners-claim! owners "source.unit" (mut first))
      (Ok [_] 0) (Err [_] (require false "initial shared symbol ownership failed")))
    (match (symbols/owners-claim! owners "typed.unit" (mut second))
      (Err [_] 0) (Ok [_] (require false "typed/source duplicate owner accepted")))
    (match (symbols/owner-of owners "fresh")
      (None [] 0) (Some [_] (require false "failed symbol batch reserved its prefix")))
    (symbols/owners-release! owners "wrong.unit" (mut first))
    (match (symbols/owner-of owners "existing")
      (Some [owner] (require (= owner "source.unit") "wrong owner released shared storage"))
      (None [] (require false "wrong owner removed a symbol")))
    (symbols/owners-release! owners "source.unit" (mut first))
    (match (symbols/owners-claim! owners "typed.unit" (mut second))
      (Ok [_] 0) (Err [_] (require false "released symbol batch could not be retried")))
    (match (symbols/owners-claim! owners "typed.unit" (mut second))
      (Ok [_] 0) (Err [_] (require false "identical owner claim is not idempotent")))
    0))

(defn declined-retry [(a (dyn Allocator))] (-> i64)
  (let [session (primitive/alloc-stack driver/GeneratedUnitCollector)
        prior (getenv c"COIL_MODULE_MAP")
        prior-virtuals (.virtual_sources (loader-unit-state))
        stable-interface "(module generated.stable) (extern stable :cc c [] (-> i64)) (export stable)"
        retry-interface "(module generated.retry) (extern retry :cc c [] (-> i64)) (export retry)"]
    (set! session (primitive/zeroed driver/GeneratedUnitCollector))
    (set! (.a session) a)
    (set! (.active session) 1)
    (set! (.units session) (al-new [driver/GeneratedUnit] a))
    (set! (.virtuals session) (al-new [VirtualSource] a))
    (set! (.virtual_sources (loader-unit-state)) (field session virtuals))
    (require (= (driver/collect-generated-unit-owned session a "generated.stable" stable-interface
                   "(module generated.stable) (defn stable [] (-> i64) 1)") 1) "initial unit registration")
    (require (= (driver/collect-generated-unit-owned session a "generated.retry" retry-interface
                   "(module generated.retry) (defn retry [] (-> i64) 21)") 1) "declining unit registration")
    (require (!= (primitive/cast i64 (virtual-source "generated.retry")) 0) "accepted interface not visible")
    (match (driver/finish-generated-reader session 1 (ReadDefault))
      (ReadDefault [] 0)
      (_ (require false "declined result was not preserved")))
    (require (= (len (.units session)) 1) "decline did not restore committed unit count")
    (require (= (primitive/cast i64 (virtual-source "generated.retry")) 0) "declined interface remains visible")
    (require (= (primitive/cast i64 prior) (primitive/cast i64 (getenv c"COIL_MODULE_MAP")))
             "registration mutated the process namespace map")
    (require (= (driver/collect-generated-unit-owned session a "generated.retry" retry-interface
                   "(module generated.retry) (defn retry [] (-> i64) 42)") 1) "retry conflicts with declined body")
    (match (driver/finish-generated-reader session 1 (ReadForms (form a "(do)")))
      (ReadForms [_] 0)
      (_ (require false "successful retry did not retain its result")))
    (require (= (len (.units session)) 2) "successful retry did not commit")
    (driver/generated-cleanup! session)
    (require (= (len (.virtuals session)) 0) "session interfaces remain after cleanup")
    (require (= (len (.units session)) 0) "session body ownership remains after cleanup")
    (set! (.virtual_sources (loader-unit-state)) prior-virtuals)
    0))

(defn released [(p (ptr i8))] (-> i64)
  (let [value (primitive/cast (ptr i64) p)]
    (set! value (+ (load value) 1)) 0))

(defn image-increment [(image (ptr i8))] (-> i64)
  (let [fp (engine/dlsym image c"unit_increment")]
    (require (!= (primitive/cast i64 fp) 0) "unit image has no counter entry")
    (primitive/call-ptr (primitive/cast (fnptr c [] i64) fp))))

(defn facade-backend-probe [(a (dyn Allocator)) (source (slice u8)) (cwd (slice u8))
                           (output (ptr i8)) (triple (ptr i8)) (path (slice u8))] (-> i64)
  (require (driver/parallel-codegen?) "facade lost command parallel-codegen policy")
  (require (= (driver/test-roots-file) "facade-test-roots") "facade lost command test roots")
  (require (= (.errs (ct/warn-box)) 0) "facade inherited caller diagnostic state")
  (set! (.errs (ct/warn-box)) 123)
  (set! (driver/entry-shape) (driver/EntryShape :tests 7 :has-main true))
  (set! (native/cga64-unit-state) (native/Cga64UnitState :curl true :llvm true))
  (unit/unit-resource! output (primitive/fnptr-of released))
  1)

(defn facade-ownership [(a (dyn Allocator))] (-> i64)
  (let [context (primitive/alloc-stack driver/DumpCtx)
        collector (primitive/alloc-stack driver/GeneratedUnitCollector)
        releases (primitive/alloc-stack i64)
        prior-warnings (.errs (ct/warn-box))
        prior-parallel (driver/parallel-codegen?)
        prior-roots (driver/test-roots-file)
        prior-entry (load (driver/entry-shape))
        prior-native (load (native/cga64-unit-state))]
    (set! releases 0)
    (set! context (primitive/zeroed driver/DumpCtx))
    (set! collector (primitive/zeroed driver/GeneratedUnitCollector))
    (set! (.config collector) (driver/compilation-unit-config a))
    (set! (.virtuals collector) (al-new [VirtualSource] a))
    (set! (.a context) a)
    (set! (.mode context) 1)
    (set! (.obj context) (primitive/cast (ptr i8) releases))
    (set! (.build-fn context) (primitive/fnptr-of facade-backend-probe))
    (driver/set-parallel-codegen! true)
    (driver/set-test-roots-file! "facade-test-roots")
    (require (= (driver/compile-emitting-facade context collector) 1) "facade backend result was lost")
    (require (= (load releases) 1) "facade resources survived completed emission")
    (require (= (.errs (ct/warn-box)) prior-warnings) "facade polluted caller diagnostics")
    (require (= (.tests (driver/entry-shape)) 7) "facade entry facts were lost at teardown")
    (require (.has-main (driver/entry-shape)) "facade main entry fact was lost")
    (require (.curl (native/cga64-unit-state)) "facade native curl dependency was lost")
    (require (.llvm (native/cga64-unit-state)) "facade native LLVM dependency was lost")
    (driver/set-parallel-codegen! prior-parallel)
    (driver/set-test-roots-file! prior-roots)
    (set! (driver/entry-shape) prior-entry)
    (set! (native/cga64-unit-state) prior-native)
    0))

(defn unit-scopes [(a (dyn Allocator))] (-> i64)
  (let [outer (primitive/alloc-stack driver/CompilationUnitSession)
        inner (primitive/alloc-stack driver/CompilationUnitSession)
        config (primitive/alloc-stack driver/CompilationUnitConfig)
        prior-ast (ast/ast-unit-state)
        prior-ct (ct/comptime-unit-state)
        prior-hook (host/meta-host-box)
        prior-opt (engine/opt-level)
        releases (primitive/alloc-stack i64)
        image-path (getenv c"COIL_UNIT_STATIC_IMAGE")
        root-image (if (= (primitive/cast i64 image-path) 0) (primitive/cast (ptr i8) 0)
                       (engine/me-unit-dylib a (cstr->slice image-path)))
        (mut virtuals) (al-new [VirtualSource] a)]
    (set! releases 0)
    (set! config (driver/compilation-unit-config a))
    (set! (.optimization config) 0)
    (unless (= (primitive/cast i64 image-path) 0)
      (require (!= (primitive/cast i64 root-image) 0) "root static image failed to load")
      (require (= (image-increment root-image) 1) "root image counter did not start at one") 0)
    (for [iteration 0 12]
      (let [ua (driver/compilation-unit-enter! outer config (mut virtuals) true)
            outer-ast (ast/ast-unit-state)
            outer-image (if (= (primitive/cast i64 image-path) 0) (primitive/cast (ptr i8) 0)
                            (engine/me-unit-dylib ua (cstr->slice image-path)))]
        (unless (= (primitive/cast i64 image-path) 0)
          (require (!= (primitive/cast i64 outer-image) 0) "unit static image failed to load")
          (require (= (image-increment outer-image) 1) "unit image shared root or prior-unit statics") 0)
        (require (= (.init (ast/type-res-box)) 0) "type-resolution registry leaked from prior unit")
        (require (= (.n (ct/gensym-cell)) 0) "gensym state leaked from prior unit")
        (require (= (.errs (ct/warn-box)) 0) "diagnostic state leaked from prior unit")
        (require (= (load (parser/parse-depth-cell)) 0) "parser depth leaked from prior unit")
        (require (= (.errset (host/meta-host-box)) 0) "metaprogram error leaked from prior unit")
        (require (= (.active (engine/meta-engine)) 0) "metaprogram entries leaked from prior unit")
        (require (= (engine/opt-level) 0) "normalized optimization was not applied")
        (require (= (next-nid) 1) "reader node identities did not begin a fresh domain")
        (require (scratch/scratch-owns-address? (field outer arena)
                   (primitive/cast (ptr i8) (values/new-cell (values/CInt 42))))
                 "compile-time value cell escaped unit storage")
        (require (scratch/scratch-owns-address? (field outer arena)
                   (primitive/cast (ptr i8) (codes/code-mk-int 42)))
                 "compiler Code constructor escaped unit storage")
        (set! (.init (ast/type-res-box)) 1)
        (set! (.n (ct/gensym-cell)) 123)
        (set! (.errs (ct/warn-box)) 9)
        (set! (parser/parse-depth-cell) 7)
        (set! (.errset (host/meta-host-box)) 1)
        (engine/set-opt-level! 2)
        (unit/unit-resource! (primitive/cast (ptr i8) releases) (primitive/fnptr-of released))
        (let [ia (driver/compilation-unit-enter! inner config (mut virtuals) true)]
          (unless (= (primitive/cast i64 image-path) 0)
            (let [image (engine/me-unit-dylib ia (cstr->slice image-path))]
              (require (!= (primitive/cast i64 image) 0) "nested static image failed to load")
              (require (= (image-increment image) 1) "nested image shared caller statics")) 0))
        (require (= (.init (ast/type-res-box)) 0) "nested unit inherited semantic registry")
        (require (= (.errset (host/meta-host-box)) 0) "nested unit inherited metaprogram error")
        (require (= (engine/opt-level) 0) "nested unit did not use normalized configuration")
        (driver/compilation-unit-leave! inner)
        (unless (= (primitive/cast i64 image-path) 0)
          (require (= (image-increment (engine/me-unit-dylib ua (cstr->slice image-path))) 2)
                   "same-unit reopen did not preserve its own static instance") 0)
        (require (= (primitive/cast i64 (ast/ast-unit-state)) (primitive/cast i64 outer-ast)) "nested unit did not restore state identity")
        (require (= (.n (ct/gensym-cell)) 123) "nested unit changed caller semantic state")
        (require (= (engine/opt-level) 2) "nested unit did not restore caller options")
        ; Touch a large arena allocation in every sequential unit. The harness
        ; measures this executable's RSS and rejects accumulated unit storage.
        (match (alloc [u8] ua (* 64 (* 1024 1024)))
          (None [] (require false "large unit allocation failed"))
          (Some [bytes]
            (for [page 0 16384]
              (primitive/store! (primitive/index (slice-data bytes) (* page 4096)) (cast u8 iteration)) 0)))
        (driver/compilation-unit-leave! outer)) 0)
    (require (= (load releases) 12) "unit resources were not released exactly once")
    (require (= (primitive/cast i64 (ast/ast-unit-state)) (primitive/cast i64 prior-ast)) "caller AST state not restored")
    (require (= (primitive/cast i64 (ct/comptime-unit-state)) (primitive/cast i64 prior-ct)) "caller semantic state not restored")
    (require (= (primitive/cast i64 (host/meta-host-box)) (primitive/cast i64 prior-hook)) "caller metaprogram hooks not restored")
    (require (= (engine/opt-level) prior-opt) "caller options not restored")
    (unless (= (primitive/cast i64 image-path) 0)
      (require (= (image-increment root-image) 2) "unit execution changed root image statics")
      (engine/dlclose root-image) 0)
    (println "unit scopes: 12 large sequential units and nested state restoration passed")
    0))

(defn object-facts [] (-> i64)
  (let [defined (getenv c"COIL_LINK_FACTS_DEFINED")
        referenced (getenv c"COIL_LINK_FACTS_REFERENCED")]
    (when (and (!= (primitive/cast i64 defined) 0) (!= (primitive/cast i64 referenced) 0))
      (for [i 0 16]
        (let [owner (driver/object-link-facts (cstr->slice defined))
              consumer (driver/object-link-facts (cstr->slice referenced))]
          (require (and (.defines-curl owner) (and (.needs-llvm owner) (not (.needs-curl owner))))
                   "wrong defined-object dependency facts")
          (require (and (.needs-curl consumer) (and (not (.defines-curl consumer)) (not (.needs-llvm consumer))))
                   "wrong referenced-object dependency facts"))
        0)
      (println "object link facts: repeated scans passed")
      0)
    0))

(defn extension-growth [(a (dyn Allocator))] (-> i64)
  (let [chunk (primitive/alloc-stack (array u8 1024))
        bytes (primitive/cast (ptr u8) chunk)
        (mut list) (al-new [u8] a)
        (mut changes) 0
        (mut retained-capacity) 0]
    (for [i 0 1024] (primitive/store! (primitive/index bytes i) (cast u8 (primitive/iand i 255))) 0)
    (for [i 0 128]
      (let [before (.cap list)]
        (al-extend! [u8] (mut list) bytes 1024)
        (when (!= before (.cap list))
          (set! changes (+ (load changes) 1))
          (set! retained-capacity (+ (load retained-capacity) (.cap list))) 0)) 0)
    (require (<= (load changes) 8) "fixed-size extensions do not grow geometrically")
    (require (< (load retained-capacity) (* (len list) 2)) "extension growth retains quadratic capacity")
    (for [i 0 (len list)]
      (require (= (al-get [u8] list i) (cast u8 (primitive/iand i 255))) "extension growth corrupts contents") 0)
    (let [before (.cap list)]
      (al-extend! [u8] (mut list) bytes 0)
      (require (= before (.cap list)) "empty extension changes capacity"))
    (al-free! [u8] (mut list))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)]
    (extension-growth a)
    (multiplicity a)
    (declined-retry a)
    (shared-symbol-ownership a)
    (facade-ownership a)
    (unit-scopes a)
    (object-facts)
    0))
