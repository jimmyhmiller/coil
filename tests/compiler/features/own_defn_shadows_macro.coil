; A module's own function shadows an ambient macro of the same name, exactly as
; it shadows an imported function: `block` and `when` here are ordinary functions.
(module own-defn-shadows-macro)

(defn block [(x i64)] (-> i64) (* x 2))
(defn when [(x i64) (y i64)] (-> i64) (+ x y))

(defn main [] (-> i64)
  (println "{} {}" (block 5) (when 3 4))
  0)
