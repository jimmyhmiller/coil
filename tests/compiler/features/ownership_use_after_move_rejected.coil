(module ownership_use_after_move_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (set! (.value self) 0)))

; Plain affine parameters consume ownership. `(ref Owner)` would borrow instead.
(defn consume [(owner Owner)] (-> i64)
  (.value owner))

(defn main [] (-> i64)
  (let [owner (Owner :value 42)]
    (consume owner)
    (consume owner)))
