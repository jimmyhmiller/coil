(module arc_auto_runtime_sum_lifetime)
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defsum MaybeCell
  (Nothing)
  (Something [(cell Cell)]))

(defn main [] (-> i64)
  (do
    (let [first (Something (Cell :value 42))
          second first]
      (match second
        (Nothing [] 0)
        (Something [held]
                   (let [value held] (.value value)))))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
