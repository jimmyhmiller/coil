(module void-match-discarded)
(import "coil.result" :use [Option Some None])

(defn finish [(value (ptr i64))] (-> void)
  (set! value 2))

(defn main [] (-> i64)
  (let [(mut number) 1]
    (match (Some 1)
      (None [] (assert false))
      (Some [value]
        (let [(mut staged) value]
          (assert (= staged 1))
          (finish (mut number)))))
    (assert (= number 2))
    0))
