(module test.simd-portable)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

; No platform I/O or assertion runtime: the same semantic fixture can execute
; in the direct Wasm backend and the bytecode interpreter as well as native code.
(defn main [] (-> i64)
  (let [value (v/viota [u32 8]) mask (v/mask-low [8] 3)
        prefix (v/vscan-add value (cast u32 10))
        fill (v/vsplat [u32 8] 99)
        packed (v/vcompress value mask fill)
        expanded (v/vexpand packed mask fill)
        buffer (p/alloc-stack (array u32 8)) base (cast (ptr u32) buffer)]
    (v/vstoreu base value)
    (let [partial (v/vload-partial base 3 fill)]
      (if (and (= (v/vreduce-add value) (cast u32 28))
               (= (.carry prefix) (cast u32 38))
               (= (v/mask->bits mask) (cast u64 7))
               (v/mask-all? (v/v= expanded partial))
               (= (v/vextract packed 7) (cast u32 99))
               (= (v/vextract (v/vreverse value) 0) (cast u32 7)))
          0 1))))
