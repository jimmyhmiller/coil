(module compiler.features.jit-import-jit-facade)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        status
          (jit/jit-prepare-with-entry! (mut session)
                                       "(module imported-jit-facade)
                                        (import \"coil.jit\" :as jit)
                                        (defn value [] (-> i64) 1)"
                                       "0")]
    (when (= status 0)
      (assert (= (jit/jit-abort-prepared! (mut session)) 0)))
    (assert (= (jit/jit-session-free! (mut session)) 0))
    status))
