(module compiler.features.jit-hidden-names)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;;; A name whose code is gone is gone for later submissions: a transaction entry
;;; is hidden once its submission is published, and a `:jit/retain false`
;;; function nothing reaches is reclaimed. Naming either later is an ordinary
;;; compile error, never a call into code that no longer exists. (Submissions use
;;; the session's own module, where the entries are defined.)
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
            "(import \"coil.jit.lifetime\") (defn scratch :jit/retain false [] (-> i64) 7)"
            "(if (= (scratch) 7) 0 1)") 0) 1
      (< (jit/jit-reclaim-retired! (mut session)) 0) 2
      ; the first submission's entry
      (= (jit/jit-compile! (mut session) "(defn calls-entry [] (-> i64) (__coil_jit_entry_0))") 0) 3
      ; the reclaimed function
      (= (jit/jit-compile! (mut session) "(defn calls-scratch [] (-> i64) (scratch))") 0) 4
      ; the session goes on
      (!= (jit/jit-compile-with-entry! (mut session) "(defn fine [] (-> i64) 3)" "(if (= (fine) 3) 0 1)") 0) 5
      :else (jit/jit-reset! (mut session)))))
