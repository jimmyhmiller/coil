(module compiler.features.meta-shared-splice-scale)
(import "coil.primitive" :as primitive)

;;; The natural recursive ways to build a list must stay linear. At this size
;;; copying the tail at every step would need hundreds of gigabytes, so this does
;;; not finish unless splices of long lists share instead of copy. Correctness at
;;; every size is meta_shared_splice.coil; this is only the scale guard.

(defn consing [(i i64) (n i64)] (-> Code)
  (if (>= i n) `() `(~i ~@(consing (+ i 1) n))))

(defn accumulate [(i i64) (n i64) (acc Code)] (-> Code)
  (if (>= i n) acc (accumulate (+ i 1) n `(~@acc ~i))))

(defn framed [(n i64)] (-> Code)
  `(first ~@(consing 0 n) last))

(defn check-len [(label (slice u8)) (got Code) (want i64)] (-> i64)
  (if (= (len got) want) 0 (primitive/error label)))

;;; 100,000 items each way, and the last item of one read back through a join.
(defn check-all [] (-> Code)
  (do
    (check-len "consing" (consing 0 100000) 100000)
    (check-len "accumulate" (accumulate 0 100000 `()) 100000)
    (check-len "framed" (framed 100000) 100002)
    (if (primitive/code-eq (get (framed 100000) 100001) `last)
        0
        (primitive/error "the last item of a framed list"))
    `0))

;;; The whole list also has to survive being handed to the compiler as program text.
(defn long-do [] (-> Code) `(do ~@(consing 0 100000)))

(defn main [] (-> i64)
  (do
    (check-all)
    (if (= (long-do) 99999) 0 1)))
