(module compiler.features.jit-retire-definitions)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; Nothing is ever replaced: writing a definition again is an error. A submission
;; can retire an accepted function, struct, sum, constant, `def` or macro, which
;; removes it, and may then define the name again. Code accepted earlier keeps
;; what it bound.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r)
         (defn helper [(n i64)] (-> i64) (+ n 1))
         (defn calls-helper [] (-> i64) (helper 1))
         (defstruct P [(x i64)])
         (defn make-p [] (-> P) (P :x 5))
         (defn read-p [] (-> i64) (.x (make-p)))
         (defsum S (A) (B))
         (defn s-tag [] (-> i64) (match (B) (A [] 1) (B [] 2)))
         (const K 3)
         (defn uses-k [] (-> i64) K)
         (def G i64 7)
         (defn uses-g [] (-> i64) G)
         (defn twice [(c Code)] (-> Code) `(* 2 ~c))
         (defn uses-twice [] (-> i64) (twice 5))"
        "(if (= (+ (r.calls-helper) (+ (r.read-p) (+ (r.s-tag) (+ (r.uses-k) (+ (r.uses-g) (r.uses-twice)))))) 29) 0 1)") 0) 1
      ; Without retiring it, a definition cannot be written again.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module r) (defn helper [(n i64)] (-> i64) n)" "0") 0) 2
      (= (jit/jit-compile-with-entry! (mut session)
        "(module r) (defstruct P [(x i64)])" "0") 0) 3
      (= (jit/jit-compile-with-entry! (mut session)
        "(module r) (const K 4)" "0") 0) 4
      ; A retired function is gone: nothing new can call it.
      (= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-defn helper) (defn calls-retired [] (-> i64) (helper 1))" "0") 0) 5
      ; Retired and defined again with another signature. The old caller still
      ; runs the code it was compiled against.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-defn helper) (defn helper [(n i64) (m i64)] (-> i64) (+ n m))
         (defn calls-new-helper [] (-> i64) (helper 10 20))"
        "(if (and (= (r.calls-new-helper) 30) (= (r.calls-helper) 2)) 0 1)") 0) 6
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-struct P) (defstruct P [(y i64) (x i64)])
         (defn read-new-p [] (-> i64) (.x (P :y 1 :x 9)))"
        "(if (and (= (r.read-new-p) 9) (= (r.read-p) 5)) 0 1)") 0) 7
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-sum S) (defsum S (A) (B) (C))
         (defn new-tag [] (-> i64) (match (C) (A [] 1) (B [] 2) (C [] 3)))"
        "(if (and (= (r.new-tag) 3) (= (r.s-tag) 2)) 0 1)") 0) 8
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-const K) (const K 10) (defn uses-new-k [] (-> i64) K)"
        "(if (and (= (r.uses-new-k) 10) (= (r.uses-k) 3)) 0 1)") 0) 9
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-def G) (def G i64 70) (defn uses-new-g [] (-> i64) G)"
        "(if (and (= (r.uses-new-g) 70) (= (r.uses-g) 7)) 0 1)") 0) 10
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-defn twice) (defn twice [(c Code)] (-> Code) `(* 3 ~c))
         (defn uses-new-twice [] (-> i64) (twice 5))"
        "(if (and (= (r.uses-new-twice) 15) (= (r.uses-twice) 10)) 0 1)") 0) 11
      ; Reclaiming keeps everything something still runs.
      (< (jit/jit-reclaim-retired! (mut session)) 0) 12
      (!= (jit/jit-compile-with-entry! (mut session) ""
        "(if (= (+ (r.calls-helper) (+ (r.calls-new-helper) (+ (r.read-p) (+ (r.read-new-p) (+ (r.uses-k) (r.uses-new-k)))))) 59) 0 1)") 0) 13
      ; Retired in one submission, the names are free in every later one.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r) (retire-defn calls-new-helper) (retire-struct P) (retire-const K) (retire-def G) (retire-defn twice)"
        "0") 0) 14
      (= (jit/jit-compile-with-entry! (mut session)
        "(module r) (defn after-retire [] (-> i64) (+ K G))" "0") 0) 15
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module r)
         (defn calls-new-helper [] (-> i64) 1)
         (defstruct P [(z i64)])
         (const K 20)
         (def G i64 700)
         (defn twice [(c Code)] (-> Code) `(* 4 ~c))
         (defn later [] (-> i64) (+ (calls-new-helper) (+ (.z (P :z 1)) (+ K (+ G (twice 1))))))"
        "(if (and (= (r.later) 726) (and (= (r.calls-helper) 2) (= (r.read-p) 5))) 0 1)") 0) 16
      (< (jit/jit-reclaim-retired! (mut session)) 0) 17
      (!= (jit/jit-compile-with-entry! (mut session) ""
        "(if (and (= (r.later) 726) (and (= (r.uses-new-k) 10) (= (r.uses-twice) 10))) 0 1)") 0) 18
      :else (jit/jit-reset! (mut session)))))
