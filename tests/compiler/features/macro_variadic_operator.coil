(module macro-variadic-operator)

; A macro template's operators are core's, qualified for hygiene, and still take
; any number of operands.

(defn triple [(x Code)] (-> Code) `(+ ~x ~x ~x))
(defn spread [(x Code)] (-> Code) `(- ~x 1 2 3))
(defn negate [(x Code)] (-> Code) `(- ~x))

(defn main [] (-> i64)
  (println "{} {} {}" (triple 2) (spread 10) (negate 5))
  0)
