(module def-static-data)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.var" :use [var-static])

; Module-level data: every def below is laid out once, in static storage, and
; every engine reads the same bytes.

(defsum Ev (Coin) (Push) (Wait [(ms i64)]))
(defstruct Span [(sec i64) (nsec i64)])
(defstruct Op [(n i64) (f (fnptr c [i64] i64)) (tbl (array i64 3))])

(defn twice [(x i64)] (-> i64) (* 2 x))
(defn sq [(x i64)] (-> i64) (* x x))
(defn inc [(x i64)] (-> i64) (+ x 1))

; Plain array literals of integers, and of constructors.
(def WORKING-SET [1 2 1 3])
(def PAIR [5 6])
(def TABLE [(Coin) (Push) (Wait :ms 7) (Coin)])
; Computed at compile time: calls, string views, structs out of field order.
(def DOUBLED [(twice 1) (twice 2) (twice 3)])
(def PIECES [(sv "a") (sv "bc")])
(def SPANS [(Span :nsec 9 :sec 1) (Span :sec 2 :nsec 8)])
(def LOCAL (Span :nsec 3 :sec 4))
(def VIEW (: [10 20 30] (slice i64)))
; Addresses are laid out by the linker; the parts between them that are not
; constants yet are computed at compile time.
(def OPS [(fnptr-of twice) (fnptr-of inc)])
(def OP (Op :tbl [7 8 9] :f (fnptr-of sq) :n (+ 1 2)))
(def counter (var-static i64 (* 5 2)))
(def GREETING c"hey")
; An absolute address written as an integer, through casts: what a JIT session's
; environment text says for a host variable.
(defstruct Cell [(at (ptr i64))])
(def AT-ADDRESS (Cell :at (cast (ptr i64) (cast (ptr i8) 4096))))
(def NO-ADDRESS (: (cast (ptr i8) 0) (ptr i8)))

; Constants computed with calls, inside arrays and structs.
(const XS [(twice 1) (twice 2)])
(const ORIGIN (Span :sec 5 :nsec 0))

(defn ev-code [(e Ev)] (-> i64)
  (match e (Coin [] 1) (Push [] 2) (Wait [ms] ms)))

;; The def itself, borrowed as a slice: the slice outlives this frame.
(defn table [] (-> (slice Ev)) TABLE)

(defn table-ascribed [] (-> (slice Ev)) (: TABLE (slice Ev)))

(defn lookup [(i i64)] (-> i64) (get WORKING-SET i))

(defn sum [(xs (slice i64))] (-> i64)
  (let [(mut total) 0]
    (for x xs (set! total (+ total x)))
    total))

(defn main [] (-> i64)
  (for e (table) (print "{} " (ev-code e)))
  (println "")
  (for e (table-ascribed) (print "{} " (ev-code e)))
  (println "")
  (println "{} {} {} {}" (lookup 0) (lookup 3) (sum WORKING-SET) (sum PAIR))
  (println "{} {} {}" (get DOUBLED 2) (len (.raw (get PIECES 1))) (.sec (get SPANS 0)))
  (println "{} {} {} {}" (.nsec (get SPANS 0)) (.sec LOCAL) (.nsec LOCAL) (sum VIEW))
  (println "{} {}" (primitive/call-ptr (get OPS 0) 5) (primitive/call-ptr (get OPS 1) 5))
  (println "{} {} {}" (.n OP) (primitive/call-ptr (.f OP) 4) (sum (.tbl OP)))
  (set counter (+ (get counter) 1))
  (println "{} {}" (get counter) (primitive/load GREETING))
  (println "{} {} {}" (get XS 1) (.sec ORIGIN) (.nsec ORIGIN))
  (println "{} {}" (cast i64 (.at AT-ADDRESS)) (cast i64 NO-ADDRESS))
  0)
