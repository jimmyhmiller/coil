(module test.aggregate-call-result-copy)
(import "coil.primitive" :as p)

; A call returns a big struct through a hidden pointer. Its result must reach
; its destination as a memory copy, not an LLVM aggregate load/store, which the
; backend expands field by field (seconds of instruction selection per copy).
(defstruct Block [(tag i64) (items (array i64 510)) (last i64)])

(defsum Holder (Held [(b Block)]) (Empty []))

(defn make-block [(n i64)] (-> Block)
  (let [(mut b) (p/zeroed Block)]
    (set! (.tag b) n)
    (set! (p/index (field (mut b) items) 509) (* n 3))
    (set! (.last b) (* n 2))
    b))

(defn forward [(n i64)] (-> Block)
  (make-block n))

(defn store-result [(dst (ptr Block)) (n i64)] (-> i64)
  (set! dst (make-block n))
  0)

(defn hold [(n i64)] (-> Holder)
  (Held (make-block n)))

(defn take [T] [(dst (ptr T)) (v T)] (-> i64)
  (set! dst v)
  0)

(defn pass-result [(dst (ptr Block)) (n i64)] (-> i64)
  (take dst (make-block n)))

; The first store may copy from the call's return slot; the binding is still a
; value, so the second store must see the same bytes.
(defn reuse [(dst (ptr Block)) (other (ptr Block)) (n i64)] (-> i64)
  (let [x (make-block n)]
    (set! dst x)
    (set! other x)
    (.tag x)))

(defn check [(b (ptr Block)) (n i64)] (-> i64)
  (assert-eq (.tag b) n)
  (assert-eq (load (p/index (field b items) 509)) (* n 3))
  (assert-eq (.last b) (* n 2))
  0)

(defn main [] (-> i64)
  (let [one (p/alloc-stack Block)
        two (p/alloc-stack Block)]
    (store-result one 7)
    (check one 7)
    (set! one (forward 5))
    (check one 5)
    (pass-result two 11)
    (check two 11)
    (assert-eq (reuse one two 13) 13)
    (check one 13)
    (check two 13)
    (match (hold 4)
      (Held [b] (do (set! one b) 0))
      (Empty [] (do (assert-eq 0 1) 0)))
    (check one 4)
    0))
