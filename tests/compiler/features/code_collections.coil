(module code-collections)

(import "coil.primitive" :as primitive)
(import "coil.assert" :use [assert-eq])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-free! al-get al-len al-new])
(import "coil.slice" :use [slice-new])

(defn meta-check [(ok bool) (message (slice u8))] (-> Code)
  (if ok `() (primitive/error message)))

(defn copy-code [(forms Code)] (-> Code)
  (code-collect forms))

(defn generated [] (-> Code)
  (let [x (primitive/fresh-identifier "collection-value")
        forms `(~x ~x ~x)
        view (primitive/code-slice forms 0 3)
        copied (copy-code view)
        vector `[~x ~x]
        (mut first) (iter forms)
        (mut second) (iter forms)
        _len (meta-check (= (len forms) 3) "Code Len must use code-count")
        _get (meta-check (primitive/bound-identifier=? (get forms 1) x)
                         "Code Get must preserve identifier identity")
        _scalar (meta-check (empty? `atom) "scalar Code must have no children")
        _vector (meta-check (= (len vector) 2) "vector Code must be iterable")
        _view (meta-check (= (len view) 3) "Code views must retain their extent")
        _first-a (match (next (mut first))
                   (Some [v] (meta-check (primitive/bound-identifier=? v x)
                                        "first Code iterator lost identity"))
                   (None [] (primitive/error "first Code iterator ended early")))
        _first-b (match (next (mut second))
                   (Some [v] (meta-check (primitive/bound-identifier=? v x)
                                        "Code iterators must have independent cursors"))
                   (None [] (primitive/error "second Code iterator ended early")))
        _second-a (match (next (mut first))
                    (Some [_] 0)
                    (None [] (primitive/error "Code iterator ended before second child")))
        _third-a (match (next (mut first))
                   (Some [_] 0)
                   (None [] (primitive/error "Code iterator ended before third child")))
        _done-a (match (next (mut first))
                  (Some [_] (primitive/error "Code iterator yielded past its end"))
                  (None [] 0))
        _still-done-a (match (next (mut first))
                        (Some [_] (primitive/error "exhausted Code iterator resumed"))
                        (None [] 0))
        ; hygiene: the generated fixture deliberately publishes this test helper.
        main-name (primitive/syntax->datum (primitive/fresh-identifier "generated-value"))]
    `(defn ~main-name [(~x i64)] (-> i64)
       (+ ~(get copied 0) (+ ~(get copied 1) ~(get copied 2))))))

(meta (generated))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        values (primitive/alloc-stack (array i64 3))
        _v0 (store! (index values 0) 7)
        _v1 (store! (index values 1) 8)
        _v2 (store! (index values 2) 9)
        source (slice-new (index values 0) 3)
        (mut out) (al-new [i64] a)]
    (for item (iter source)
      (push! (mut out) item))
    (assert-eq (al-len [i64] out) 3)
    (assert-eq (al-get [i64] out 1) 8)
    (assert-eq (generated-value 14) 42)
    (al-free! [i64] (mut out))
    0))
