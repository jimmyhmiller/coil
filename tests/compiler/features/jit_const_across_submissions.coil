(module compiler.features.jit-const-across-submissions)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A non-literal const is materialized where it is used. A later submission may
;; use a const an earlier one accepted, so the type of that const's initializer
;; has to survive retention, including a node the checker typed again after the
;; submission's semantic maps were saved.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cs.m)
         (defn build [] (-> i64) (let [p 40] (+ p 9)))
         (const TABLE (build))"
        "0") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cs.m)"
        "(if (= cs.m.TABLE 49) 0 1)") 0) 2
      ; The same across a second and a third submission.
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cs.m) (const DOUBLE (* 2 TABLE))"
        "0") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session)
        "(module cs.m)"
        "(if (and (= cs.m.TABLE 49) (= cs.m.DOUBLE 98)) 0 1)") 0) 4
      :else (jit/jit-reset! (mut session)))))
