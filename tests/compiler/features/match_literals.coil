; Literal patterns: integers, characters, strings and booleans, as whole arms and
; inside payloads. A literal never covers its type, except `true` with `false`.
(module match-literals)

(defsum Cell (Open [(cost i64)]) (Wall))

(defn digit-name [(n i64)] (-> (slice u8))
  (match n
    (0 "zero")
    (1 "one")
    (-1 "minus one")
    (_ "many")))

(defn yes-no [(b bool)] (-> (slice u8))
  (match b
    (true "yes")
    (false "no")))

(defn vowel? [(c u8)] (-> bool)
  (match c
    (#\a true)
    (#\e true)
    (#\i true)
    (#\o true)
    (#\u true)
    (_ false)))

(defn command [(s (slice u8))] (-> i64)
  (match s
    ("go" 1)
    ("stop" 2)
    (_ 0)))

(defn cost [(c Cell)] (-> (slice u8))
  (match c
    (Open [1] "cheap")
    (Open [n] (if (> n 5) "dear" "fair"))
    (Wall [] "blocked")))

(defn flags [(o (Option bool))] (-> i64)
  (match o
    (Some [true] 1)
    (Some [false] 0)
    (None [] -1)))

(defn main [] (-> i64)
  (println "{} {} {} {}" (digit-name 0) (digit-name 1) (digit-name -1) (digit-name 9))
  (println "{} {}" (yes-no true) (yes-no false))
  (println "{} {}" (vowel? #\e) (vowel? #\z))
  (println "{} {} {}" (command "go") (command "stop") (command "wander"))
  (println "{} {} {} {}" (cost (Open 1)) (cost (Open 9)) (cost (Open 3)) (cost (Wall)))
  (println "{} {} {}" (flags (Some true)) (flags (Some false)) (flags (None)))
  0)
