(module fnptr-generic-by-value)
(import "coil.slice" :use *)
(import "coil.result" :use *)
(import "coil.iter" :use *)
(import "coil.arraylist" :use *)
(import "coil.alloc" :use *)

; A `c` function pointer that takes a struct or sum by value reaches a Coil
; function, which takes it by reference, through a by-value C entry. That holds
; when the pointer type is only known after generic inference (`sort`), for a sum
; (`map-err`), and for a generic struct a `Callable` bound asks for (`fold`).

(defstruct WC [(w i64) (c i64)])
(defn by-rank [(a WC) (b WC)] (-> i64) (- (.c a) (.c b)))

(defsum E (Bad [(code i64)]) (Worse))
(defsum Wrapped (W [(e E)]))
(defn fail [] (-> (Result i64 E)) (Err (Bad 3)))

(defsum Shape (Sq [(side i64)]) (Dot))

(defn main [] (-> i64)
  (let [(mut xs) [(WC :w 1 :c 3) (WC :w 2 :c 1) (WC :w 3 :c 2)]]
    (sort (mut xs) (fnptr-of by-rank))
    (for x (iter xs) (println "sorted {}" (.w x))))
  (let [(mut ys) [(WC :w 4 :c 2) (WC :w 5 :c 1)]]
    (sort (mut ys) (fn [a b] (- (.c a) (.c b))))
    (for y (iter ys) (println "sorted fn {}" (.w y))))
  (match (map-err [i64 E Wrapped] (fail) (fn [e] (W e)))
    (Ok [v] (println "ok {}" v))
    (Err [w] (match w (W [e] (match e (Bad [c] (println "wrapped bad {}" c))
                                      (Worse [] (println "wrapped worse")))))))
  (println "fold enumerate {}"
           (fold (fn [acc it] (+ acc (* (.index it) (.value it)))) 0 (enumerate [10 20 30])))
  (let [(mut shapes) (al-new [Shape] (malloc-allocator))]
    (push! (mut shapes) (Sq 4))
    (push! (mut shapes) (Dot))
    (push! (mut shapes) (Sq 5))
    (println "fold sums {}"
             (fold (fn [acc s] (+ acc (match s (Sq [n] (* n n)) (Dot [] 100)))) 0 shapes))
    (al-free! (mut shapes)))
  0)
