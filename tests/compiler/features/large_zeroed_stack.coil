(module large_zeroed_stack)
(import "coil.primitive" :as primitive)

(defn clear [(p (ptr u8)) (size i64)] (-> i64)
  (for [i 0 size]
    (set! (primitive/index p i) (primitive/cast u8 0)))
  0)

(defn main [] (-> i64)
  (let [(mut bytes) (primitive/zeroed (array u8 32768))
        p (primitive/cast (ptr u8) (mut bytes))]
    (clear p 24000)
    (primitive/cast i64 (load (primitive/index p 7)))))
