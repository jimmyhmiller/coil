(module test.artifact-wire)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)
(import "coil.slice" :use *)
(import "coil.io" :as io)
(import "coil.fs" :as fs)
(import "coil.reader" :use *)
(import "coil.compiler.parser" :use *)
(import "coil.compiler.loader" :use *)
(import "coil.compiler.artifact_identity" :use *)
(import "coil.compiler.artifact_wire" :use *)

(defn fixture [(a (dyn Allocator))] (-> (ptr ProviderMetadata))
  (let [m (box! a ProviderMetadata (p/zeroed ProviderMetadata))
        setup (box! a LS (p/zeroed LS))
        (mut registry) (al-new [(ptr Sexp)] a)
        (mut inputs) (al-new [ArtifactInput] a)
        (mut names) (al-new [(slice u8)] a)]
    (ls-init! (mut setup) a)
    (register-source! (mut setup) "provider.coil" "source\nsecond line\n")
    (push! (mut inputs) (ArtifactInput :path "z" :digest "last"))
    (push! (mut inputs) (ArtifactInput :path "a" :digest "first"))
    (push! (mut names) "reader.example.read-source")
    (push! (mut names) "reader.example.helper")
    (let [imp (imp-entry (mut setup) "reader.example")]
      (mi-add-alias! imp "s" "coil.str")
      (push! (field (field imp imp) uses)
             (mk-use a
                     "coil.arraylist"
                     (UAll)
                     (empty-names a)
                     (empty-renames a))))
    (push! (field setup exports)
           (ExpEntry
             :name "reader.example"
             :names (load names)
             :forms (al-new [Sexp] a)))
    (match (read-all a "(hello [:key 42 -3 1.0 c\"bytes\" \"nul\\0inside\"])" 0)
      (Err [_] 0)
      (Ok [xs]
          (let [node (al-elem [Sexp] xs 0)]
            (set! (.hyg node) 123)
            (set! (.hmod node) "reader.example")
            (set! (.horigin node) 4)
            (set! (.hflags node) 9)
            (push! (mut registry) node))))
    (set! (.provider m) "reader.example")
    (set! (.entry m) "reader.example.read-source")
    (set! (.symbol m) "coil_mp_0")
    (set! (.sdk m) "sdk")
    (set! (.host m) "host")
    (set! (.target m) "target")
    (set! (.options m) "options")
    (set! (.inputs m) (box-al [ArtifactInput] a (load inputs)))
    (set! (.key m)
          (artifact-key a
                        (.provider m)
                        (.entry m)
                        "sdk"
                        "host"
                        "target"
                        "options"
                        (.inputs m)))
    (set! (.image_digest m) "image")
    (set! (.setup m) setup)
    (set! (.names m) (box-al [(slice u8)] a (load names)))
    (set! (.registry m) (box-al [(ptr Sexp)] a (load registry)))
    m))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [a (malloc-allocator)
        mode (if (> argc (cast i32 1)) (cstr->slice (load (index argv 1))) "")
        path (if (> argc (cast i32 2)) (cstr->slice (load (index argv 2))) "")]
    (cond (= mode "hash")
            (match (artifact-file-digest a path)
              (Err [_] 1)
              (Ok [digest]
                  (io/print-str (io/stdout) digest)
                  (io/print-str (io/stdout) "\n")
                  0))
          (= mode "keys")
            (let [m (fixture a)
                  inputs (.inputs m)
                  first (get (load inputs) 0)]
              (io/print-str (io/stdout) (.key m))
              (io/print-str (io/stdout) "\n")
              (set! inputs 0 (get (load inputs) 1))
              (set! inputs 1 first)
              (io/print-str (io/stdout)
                            (artifact-key a
                                          (.provider m)
                                          (.entry m)
                                          "sdk"
                                          "host"
                                          "target"
                                          "options"
                                          inputs))
              (io/print-str (io/stdout) "\n")
              0)
          (= mode "write")
            (match (wire-put-provider a (fixture a))
              (Err [_] 2)
              (Ok [bytes]
                  (match (fs/write-file a path bytes) (Err [_] 3) (Ok [_] 0))))
          (= mode "validate")
            (let [(mut inputs) (al-new [ArtifactInput] a)]
              (push! (mut inputs)
                     (ArtifactInput :path path
                       :digest (cstr->slice (load (index argv 3)))))
              (match (artifact-validate-inputs a (mut inputs))
                (Err [_] 1)
                (Ok [_] 0)))
          :else
            (match (fs/read-file a path)
              (Err [_] 3)
              (Ok [bytes]
                  (match (wire-provider a bytes)
                    (Err [_] 1)
                    (Ok [metadata]
                        (let [m metadata]
                          (match (wire-put-provider a m)
                            (Err [_] 2)
                            (Ok [again] (if (= bytes again) 0 4)))))))))))
