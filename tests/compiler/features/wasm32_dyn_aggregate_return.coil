(module wasm32_dyn_aggregate_return)
(import "coil.primitive" :as primitive)
(import "coil.dyn" :use *)

(deftrait Inner [Self]
  (value [(self (ptr Self))] (-> i64)))

(deftrait Outer [Self]
  (as-inner [(self (ptr Self))] (-> (dyn Inner))))

(defdyn Inner)
(defdyn Outer)

(defstruct Both [(n i64)])

(impl Inner Both
  (value [(self (ptr Both))] (-> i64)
    (.n self)))

(impl Outer Both
  (as-inner [(self (ptr Both))] (-> (dyn Inner))
    self))

(defn call-through-outer [(outer (dyn Outer))] (-> i64)
  (let [inner (as-inner outer)]
    (value inner)))

(defn wasm32-dyn-aggregate-return [] (-> i64)
  (let [both (primitive/alloc-stack Both)]
    (set! (.n both) 42)
    (call-through-outer both)))

(export-c [wasm32-dyn-aggregate-return :as "wasm32_dyn_aggregate_return"])

(defn main [] (-> i64) 0)
