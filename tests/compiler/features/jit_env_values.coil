(module compiler.features.jit-env-values)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.compiler.live_ir" :as ir)
(import "coil.arraylist" :as al)

; Compiler states are values. A check builds a new one from any held one and
; writes neither it nor anything else, so this holds several at once, makes two
; different edits of one base, watches a failed check change nothing, and releases
; them in an order unrelated to the order they were made in.

; How many parameters `name` takes in `env`, or -1 if it has no such function.
(defn arity [(session (ptr jit/JitSession)) (env jit/JitEnv) (name (slice u8))] (-> i64)
  (if (not (jit/jit-env-defines? session env name))
      -1
      (match (jit/jit-env-live-function (a/malloc-allocator) session env name)
        (None [] -1)
        (Some [lowered] (let [(mut function) lowered] (al/al-len (.parameters function)))))))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-checked-session-new (a/malloc-allocator))
        empty (jit/jit-env-empty)]
    (assert (not (jit/jit-env-valid? empty)))
    (assert (not (jit/jit-env-valid? (jit/jit-env-current (mut session)))))
    (let [base (jit/jit-env-check (mut session) empty
                 "(module shapes) (defn area [(w i64) (h i64)] (-> i64) (* w h))
                  (defn unit [] (-> i64) (area 1 1))")]
      (assert (jit/jit-env-valid? base))
      (assert (= (arity (mut session) base "shapes.area") 2))
      (assert (= (arity (mut session) base "shapes.unit") 0))
      ; Building a value does not make it the one the session serves.
      (assert (not (jit/jit-env-valid? (jit/jit-env-current (mut session)))))
      ; Two edits of the same base, both alive, neither visible in the other.
      (let [wider (jit/jit-env-check (mut session) base
                    "(module shapes) (defn volume [(w i64) (h i64) (d i64)] (-> i64) (* (area w h) d))")
            renamed (jit/jit-env-check (mut session) base
                      "(module shapes) (defn perimeter [(w i64) (h i64)] (-> i64) (* 2 (+ w h)))")]
        (assert (jit/jit-env-valid? wider))
        (assert (jit/jit-env-valid? renamed))
        (assert (= (arity (mut session) wider "shapes.volume") 3))
        (assert (= (arity (mut session) wider "shapes.perimeter") -1))
        (assert (= (arity (mut session) renamed "shapes.perimeter") 2))
        (assert (= (arity (mut session) renamed "shapes.volume") -1))
        (assert (= (arity (mut session) base "shapes.volume") -1))
        (assert (= (arity (mut session) base "shapes.perimeter") -1))
        ; A check that fails yields no value and disturbs none.
        (let [broken (jit/jit-env-check (mut session) wider
                       "(module shapes) (defn bad [] (-> i64) (volume 1 2))")]
          (assert (not (jit/jit-env-valid? broken)))
          (assert (> (len (jit/jit-diagnostic (mut session))) 0)))
        (assert (= (arity (mut session) wider "shapes.volume") 3))
        (assert (= (arity (mut session) wider "shapes.bad") -1))
        ; A chain: each state is built on the last, and the old ones stay whole.
        (let [(mut tip) (jit/jit-env-retain (mut session) wider)]
          (for [i 0 12]
            (let [next (jit/jit-env-check (mut session) (load tip)
                         "(module shapes) (defn area [(w i64) (h i64)] (-> i64) (+ (* w h) 0))")]
              (assert (jit/jit-env-valid? next))
              (jit/jit-env-release! (mut session) (load tip))
              (set! tip next)))
          (assert (= (arity (mut session) (load tip) "shapes.volume") 3))
          (assert (= (arity (mut session) (load tip) "shapes.area") 2))
          ; The base goes first, while states built on it are still held.
          (jit/jit-env-release! (mut session) base)
          (assert (= (arity (mut session) wider "shapes.area") 2))
          (assert (= (arity (mut session) renamed "shapes.unit") 0))
          ; A session that still has holders refuses to be reset.
          (assert (= (jit/jit-reset! (mut session)) -1))
          (jit/jit-env-release! (mut session) renamed)
          (assert (= (arity (mut session) (load tip) "shapes.volume") 3))
          (jit/jit-env-release! (mut session) wider)
          (jit/jit-env-release! (mut session) (load tip)))))
    (assert (= (jit/jit-reset! (mut session)) 0))
    0))
