(module arc_auto_runtime_control_flow)
(import "coil.arc.auto-runtime" :as auto)

(defstruct Cell [(value i64)])

(defn choose [(item Cell) (left bool)] (-> Cell)
  (if left item item))

(defn main [] (-> i64)
  (do
    (let [root (Cell :value 40)
          selected (choose root true)
          alias selected]
      (+ (.value alias) 2))
    (if (= (auto/auto-object-live-count) 0) 42 1)))
