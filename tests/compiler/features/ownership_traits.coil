(module ownership_traits_test)

; Marker traits have no methods and therefore admit methodless impls. Copy is the
; first compiler-known use, but the parser rule is intentionally general.
(deftrait LocalMarker [Self])

(defstruct Marked [(value i64)])

(impl LocalMarker Marked)

; Clone borrows its source; calling it must not consume or require a mutable owner.
(defstruct Handle [(value i64)])

(impl Clone Handle
  (clone [(self (ref Handle))]
         (-> Handle)
         (Handle :value (.value self))))

; Drop is an ordinary implementable trait even before automatic drop elaboration.
(impl Drop Handle
  (drop [(self (mut Handle))]
        (-> void)
        (set! (.value self) 0)))

(defn main [] (-> i64)
  (let [original (Handle :value 42)
        duplicate (clone original)]
    (.value duplicate)))
