(module transparent_arc_generic_nested)
(import "coil.arraylist" :use *)

(defstruct Box [T] [(value T)])

(defn main [] (-> i64)
  (let [(mut values) (al-new [i64])]
    (al-push! [i64] (mut values) 40)
    (let [first (Box [(ArrayList i64)] :value values)
          (mut second) first]
      (al-push! [i64] (mut (.value second)) 2)
      (+ (al-get [i64] (.value first) 0)
         (al-get [i64] (.value first) 1)))))
