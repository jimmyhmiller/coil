(module ownership-generic-owner-borrow)

; A generic `T` parameter has value ABI until it is substituted. Substituted with
; an owner, it is moved into an owning slot, and the name then denotes that slot:
; lending it to a `(ref T)` parameter must pass the slot itself, not a spill of
; the slot's address (which handed the callee a pointer to a pointer).

(deftrait Peek [Self]
  (peek [(x (ref Self))] (-> i64))
  (val [(x Self)] (-> i64)))

(defstruct Tok [(n i64)])

(impl Drop Tok
  (drop [(self (mut Tok))] (-> void)
    (println "drop {}" (.n self))
    0))

(impl Peek Tok
  (peek [(x (ref Tok))] (-> i64) (.n x))
  (val [(x Tok)] (-> i64) (.n x)))

(defn borrow [(T Peek)] [(x (ref T))] (-> i64) (peek x))

; the A19 reproduction: an owned generic parameter lent to a reference parameter
(defn consume [(T Peek)] [(x T)] (-> i64) (borrow x))

; the same parameter lent straight to the trait method
(defn peek-direct [(T Peek)] [(x T)] (-> i64) (peek x))

; lent twice, then consumed: the borrows must not move it
(defn lend-then-take [(T Peek)] [(x T)] (-> i64)
  (+ (borrow x) (+ (peek x) (val x))))

; a local moved from the parameter is already a place
(defn rebind [(T Peek)] [(x T)] (-> i64) (let [y x] (borrow y)))

(defn main [] (-> i64)
  (println "consume {}" (consume (Tok :n 5)))
  (println "peek-direct {}" (peek-direct (Tok :n 6)))
  (println "lend-then-take {}" (lend-then-take (Tok :n 7)))
  (println "rebind {}" (rebind (Tok :n 8)))
  0)
