(module ownership-borrowed-temporary-drop-test)

(import "coil.primitive" :as primitive)

(defstruct Owner [(value i64)])

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (drops) (+ (load (drops)) 1))))

(defn make-owner [] (-> Owner)
  (Owner :value 42))

(defn borrow-owner [(owner (ref Owner))] (-> i64)
  (.value owner))

(defn main [] (-> i64)
  (let [value (borrow-owner (make-owner))]
    (if (and (= value 42) (= (load (drops)) 1)) 0 1)))
