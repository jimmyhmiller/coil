(module compiler.features.jit-generation-tokens)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn token-lifetime-test [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        v1 "1"
        v2 "2"
        v3 "3"
        (mut token) 0]
    (cond (!= (jit/jit-compile! (mut session) "(defn first [] (-> i64) 1)") 0) 2
          (do
            (set! token (jit/jit-generation-retain-current! (mut session)))
            false)
            20
          (<= (load token) 0) 3
          (!= (jit/jit-generation-token-leases (mut session)) 1) 4
          (!= (jit/jit-compile! (mut session) "(defn second [] (-> i64) 2)") 0)
            5
          (!= (jit/jit-compile! (mut session) "(defn third [] (-> i64) 3)") 0) 6
          (< (jit/jit-generation-count (mut session)) 3) 7
          ; Reclamation may discard the unleased middle image, but the exact v1
          ; token must keep v1 mapped while v3 remains current.
          (!= (jit/jit-reclaim-retired! (mut session)) 0) 8
          (!= (jit/jit-generation-count (mut session)) 3) 9
          (!= (jit/jit-reset! (mut session)) -1) 10
          (!= (jit/jit-generation-release-token! (mut session) (load token)) 0)
            11
          (!= (jit/jit-generation-token-leases (mut session)) 0) 12
          (!= (jit/jit-reset! (mut session)) 0) 15
          :else 0)))

; ABI context contains declarations for every accepted definition, but only a
; relocation creates native ownership. `newest` directly calls `old`; the
; all accepted static definitions remain available until the session resets.
(defn exact-import-ownership-test [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile! (mut session) "(defn old [] (-> i64) 40)") 0) 22
          (!= (jit/jit-compile! (mut session) "(defn middle [] (-> i64) 99)") 0)
            23
          (!= (jit/jit-compile! (mut session)
                                "(defn newest [] (-> i64) (+ (old) 2))")
              0)
            24
          (!= (jit/jit-generation-count (mut session)) 3) 25
          (!= (jit/jit-reclaim-retired! (mut session)) 0) 26
          (!= (jit/jit-generation-count (mut session)) 3) 27
          ; Evaluating newest creates a fourth small generation. Its direct import
          ; of newest must retain newest's transitive dependency on old.
          (!= (jit/jit-evaluate! (mut session) "(newest)") 0) 28
          (< (jit/jit-reclaim-retired! (mut session)) 0) 29
          (!= (jit/jit-evaluate! (mut session) "(newest)") 0) 30
          (!= (jit/jit-reset! (mut session)) 0) 31
          :else 0)))

(defn main [] (-> i64)
  (let [token-status (token-lifetime-test)]
    (if (!= token-status 0) token-status (exact-import-ownership-test))))
