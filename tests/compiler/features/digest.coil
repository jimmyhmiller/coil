(module test.digest)
(import "coil.compiler.digest" :as hash)
(import "coil.primitive" :as p)
(import "coil.alloc" :as alloc)
(import "coil.slice" :as sl)
(import "coil.str" :as str)
(import "coil.io" :as io)

(extern atoll :cc c [(ptr i8)] (-> i64))

(extern malloc :cc c [i64] (-> (ptr u8)))

(extern free :cc c [(ptr u8)] (-> void))

(defn print-digest [(a (dyn alloc/Allocator)) (state (ptr hash/Sha256))] (-> i64)
  (let [w (io/stdout)]
    (io/print-str w (hash/sha256-hex a state))
    (io/print-str w "\n")
    0))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [state (p/alloc-stack hash/Sha256)
        limit (p/alloc-stack hash/Sha256)
        a (alloc/malloc-allocator)]
    (hash/sha256-init! state)
    (if (= argc (cast i32 1))
        (do
          (print-digest a state)
          (hash/sha256-update! state "abc")
          (print-digest a state)
          (print-digest a state)
          (hash/sha256-update! state "def")
          (print-digest a state)
          (hash/sha256-init! limit)
          (store! (field limit bytes) (cast u64 0x1fffffffffffffff))
          (let [before (hash/sha256-hex a limit)]
            (if (hash/sha256-update! limit "x")
                2
                (if (str/str-eq before (hash/sha256-hex a limit)) 0 3))))
        (let [n (atoll (load (index argv 1)))
              step (atoll (load (index argv 2)))
              bytes (malloc (+ n 1))
              (mut at) 0]
          (for [i 0 n]
            (store! (index bytes i) (cast u8 (p/ixor (* i 131) (p/ishr i 3))))
            0)
          (loop (if (>= (load at) n) (break) 0)
            (let [count (if (> (+ (load at) step) n) (- n (load at)) step)]
              (hash/sha256-update! state
                                   (sl/slice-new (index bytes (load at)) count))
              (store! at (+ (load at) count))))
          (print-digest a state)
          (free bytes)
          0))))
