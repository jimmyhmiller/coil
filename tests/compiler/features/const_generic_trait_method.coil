(module compiler.features.const-generic-trait-method)

;; A constant is evaluated from the closure of the functions its initializer
;; reaches. A generic function there calls trait methods on its type parameter,
;; which mono resolves to an impl's checked method only once it specializes the
;; generic, so the closure has to carry the methods of every impl it selects: a
;; primitive impl (`Add i64`), a user trait impl, and an inherent impl.
(deftrait Shape [Self] (area [(self Self)] (-> i64)))
(defstruct Sq [(side i64)])
(impl Shape Sq (area [(self Sq)] (-> i64) (* (.side self) (.side self))))
(impl Sq (twice [(self Sq)] (-> i64) (* 2 (.side self))))

(defn double [(T Add)] [(x T)] (-> T) (let [y x] (+ y y)))
(defn area-of [(T Shape)] [(x T)] (-> i64) (area x))

(defn via-add [] (-> i64) (double 20))
(defn via-trait [] (-> i64) (area-of (Sq :side 5)))
(defn via-inherent [] (-> i64) (twice (Sq :side 7)))

(const ADDED (via-add))
(const SHAPED (via-trait))
(const DOUBLED (via-inherent))

(defn main [] (-> i64)
  (if (and (= ADDED 40) (and (= SHAPED 25) (= DOUBLED 14))) 0 1))
