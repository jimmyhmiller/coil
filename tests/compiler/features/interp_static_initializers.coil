(module interp_static_initializers)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [var-static])

; Initialized static storage in every engine: a runtime def, a Var cell, an
; array literal borrowed as a slice, and a sparse :elements table.
(defstruct Pair [(left i64) (right i64)])

(def answer 42)
(def origin (Pair :left 3 :right 4))
(def counter (var-static i64 7))

(defn table [] (-> (ptr (array i64 8)))
  (primitive/alloc-static (array i64 8) :elements [(1 10) (6 60)]))

(defn sum [(xs (slice i64))] (-> i64)
  (fold (fn [acc x] (+ acc x)) 0 xs))

(defn main [] (-> i64)
  (set counter (+ (get counter) 1))
  (println "{} {} {} {} {} {}"
           answer
           (+ (.left origin) (.right origin))
           (get counter)
           (sum [1 2 3])
           (load (index (table) 1))
           (load (index (table) 6)))
  0)
