(module callable-closure-reload)
(import "coil.primitive" :as primitive)
(import "coil.closure" :use *)

(defclosure hot-adder [(n i64)] [(x i64)] i64 (+ n x))

; A replacement produced by the JIT has this same checked signature.
(defn replacement [(env (ptr hot-adder-env)) (x i64)] (-> i64)
  (* (.n env) x))

(defn main [] (-> i64)
  (let [f (hot-adder-new 5)
        before (f 3)]
    (hot-adder-set-code! f (primitive/fnptr-of replacement))
    (let [after (f 3)]
      (hot-adder-free f)
      (+ before after))))
