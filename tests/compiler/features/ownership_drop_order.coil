(module ownership_drop_order)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

(defn make-and-drop [] (-> i64)
  (let [first (Owner :value 1)
        second (Owner :value 2)]
    99))

(defn main [] (-> i64)
  (store! (counter) 0)
  (make-and-drop)
  ; Reverse declaration order and exactly once: second then first.
  (load (counter)))
