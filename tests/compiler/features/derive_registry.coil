(module derive_registry_feature)
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)
(import "coil.alloc" :as alloc)

(deftrait Tag [Self] (tag [(x Self)] (-> i64)))

(deftrait GenericTag [Self] (generic-tag [(x Self)] (-> i64)))

(defderive Tag
           (struct [T] `(impl Tag ~T (tag [(x ~T)] (-> i64) 11)))
           (sum [T] `(impl Tag ~T (tag [(x ~T)] (-> i64) 22))))

; The registry must receive the complete `(GenericPoint T)` Code form. Looking
; up only its symbol head is sufficient for choosing the struct arm, but the
; registered deriver needs the intact target to emit its generic impl.
(defn derive-generic-tag [(target Code)] (-> Code)
  (let [T (primitive/code-nth target 1)]
    `(impl [~T] GenericTag ~target
       (generic-tag [(x ~target)] (-> i64) 33))))

(defderive GenericTag (struct [target] (derive-generic-tag target)))

(defstruct Point [(x i64)])

(defstruct GenericPoint [T] [(x T)])

(defsum Choice (A) (B [(n i64)]))

(derive Eq Tag Point)

(derive Tag Choice)

(derive GenericTag (GenericPoint T))

(defn main [] (-> i64)
  (let [p (primitive/alloc-stack Point)]
    (set! (.x p) 3)
    (if (and (= (tag (load p)) 11)
             (and (= (tag (A)) 22)
                  (= (generic-tag (GenericPoint [i64] :x 3)) 33)))
        0
        1)))
