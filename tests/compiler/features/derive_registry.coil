(module derive_registry_feature)
(import "coil.derive" :use *)
(import "coil.alloc" :as alloc)

(deftrait Tag [Self] (tag [(x Self)] (-> i64)))
(defderive Tag
           (struct [T] `(impl Tag ~T (tag [(x ~T)] (-> i64) 11)))
           (sum [T] `(impl Tag ~T (tag [(x ~T)] (-> i64) 22))))

(defstruct Point [(x i64)])
(defsum Choice (A) (B [(n i64)]))
(derive Eq Tag Point)
(derive Tag Choice)

(defn main [] (-> i64)
  (let [p (alloc/stack Point)]
    (set! (.x p) 3)
    (if (and (= (tag (load p)) 11) (= (tag (A)) 22)) 0 1)))
