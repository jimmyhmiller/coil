(module c-aggregate-bounded-read)

(defstruct Bytes1 [(bytes (array u8 1))])

(defstruct Bytes3 [(bytes (array u8 3))])

(defstruct Bytes4 [(bytes (array u8 4))])

(defstruct Bytes9 [(bytes (array u8 9))])

(defstruct Bytes12 [(bytes (array u8 12))])

(defstruct Bytes16 [(bytes (array u8 16))])

(defstruct Bytes24 [(bytes (array u8 24))])

(extern bytes1_new :cc c [] (-> (ptr Bytes1)))

(extern bytes3_new :cc c [] (-> (ptr Bytes3)))

(extern bytes4_new :cc c [] (-> (ptr Bytes4)))

(extern bytes9_new :cc c [] (-> (ptr Bytes9)))

(extern bytes12_new :cc c [] (-> (ptr Bytes12)))

(extern bytes16_new :cc c [] (-> (ptr Bytes16)))

(extern bytes24_new :cc c [] (-> (ptr Bytes24)))

(extern bytes1_sum :cc c [Bytes1] (-> i64))

(extern bytes3_sum :cc c [Bytes3] (-> i64))

(extern bytes4_sum :cc c [Bytes4] (-> i64))

(extern bytes9_sum :cc c [Bytes9] (-> i64))

(extern bytes12_sum :cc c [Bytes12] (-> i64))

(extern bytes16_sum :cc c [Bytes16] (-> i64))

(extern bytes24_sum :cc c [Bytes24] (-> i64))

(extern bytes4_value :cc c [i32] (-> Bytes4))

(extern free :cc c [(ptr i8)] (-> void))

; Internal parameters are pointer-represented. This is the path that bypassed
; ABI padding, unlike a fresh constructor passed directly to an extern.
(defn relay4 [(value Bytes4)] (-> i64)
  (bytes4_sum value))

(defn indirect4 [(value Bytes4)] (-> i64)
  (call-ptr (fnptr-of bytes4_sum) value))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (let [one (bytes1_new)
        three (bytes3_new)
        four (bytes4_new)
        nine (bytes9_new)
        twelve (bytes12_new)
        sixteen (bytes16_new)
        large (bytes24_new)
        local (bytes4_value argc)]
    (assert-eq (bytes1_sum (load one)) 1)
    (assert-eq (bytes3_sum (load three)) 6)
    (assert-eq (relay4 (load four)) 10)
    (assert-eq (indirect4 (load four)) 10)
    (assert-eq (relay4 local) (+ (cast i64 argc) 9))
    (assert-eq (bytes9_sum (load nine)) 45)
    (assert-eq (bytes12_sum (load twelve)) 78)
    (assert-eq (bytes16_sum (load sixteen)) 136)
    (assert-eq (bytes24_sum (load large)) 300)
    (free (cast (ptr i8) one))
    (free (cast (ptr i8) three))
    (free (cast (ptr i8) four))
    (free (cast (ptr i8) nine))
    (free (cast (ptr i8) twelve))
    (free (cast (ptr i8) sixteen))
    (free (cast (ptr i8) large)))
  0)
