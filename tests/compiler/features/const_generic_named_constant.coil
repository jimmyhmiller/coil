(module const-generic-named-constant)
(import "coil.simd" :use [native-lanes])

; `(const NAME)` passes a constant as an explicit generic argument.

(const LANES 4)
(const UNIT :meters)
(const NARROW (: 3 u8))
(const HARDWARE (native-lanes u8))

(defstruct Quantity [(const Unit Keyword)] [(value f64)])
(defstruct Lanes [(const N i64)] [(xs (array i64 N))])

(defn width [(const N i64)] [] (-> i64) N)
(defn unit-value [(const U Keyword)] [(q (Quantity U))] (-> f64) (.value q))

(defn main [] (-> i64)
  (let [l (Lanes [(const LANES)] :xs [1 2 3 4])]
    (println "{} {} {} {}" (width [(const LANES)]) (width [(const NARROW)]) (get (.xs l) 3)
             (unit-value (Quantity [(const UNIT)] :value 2.5)))
    (println "{}" (= (width [(const HARDWARE)]) (native-lanes u8))))
  0)
