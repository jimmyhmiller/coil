(module transparent_arc_sum_alias)

(defstruct Cell [(value i64)])
(defsum MaybeCell
  (Nothing)
  (Something [(cell Cell)]))

(defn main [] (-> i64)
  (let [first (Something (Cell :value 10))
        second first]
    (match second
      (Nothing [] 0)
      (Something [held]
        (let [(mut target) held]
          (set! (.value target) 42)
          (match first
            (Nothing [] 0)
            (Something [original]
              (let [source original] (.value source)))))))))
