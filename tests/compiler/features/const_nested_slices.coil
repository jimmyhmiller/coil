;; Compile-time constants whose values hold slices other than strings: an array
;; literal borrowed as a slice gets static storage, and the fold materializes the
;; slice as a static array it points at (coil-bugs const-table-nested-const-slice,
;; const-table-nested-literal-slice).
(module const-nested-slices)

(defstruct Item [(name (slice u8)) (tags (slice (slice u8)))])
(defstruct Group [(title (slice u8)) (items (slice Item))])

(const NAMES (slice (slice u8)) ["a" "b"])
(const ITEMS [(Item :name "a" :tags ["x" "y"]) (Item :name "b" :tags ["z"])])
(const GROUPS [(Group :title "g1" :items ITEMS)])
(const NUMS (slice i64) [3 4 5])

(defn first-group [] (-> Group) (get GROUPS 0))

(defn main [] (-> i64)
  (let [g (first-group)]
    (println "{} {}" (len NAMES) (get NAMES 1))
    (println "{} {} {} {}" (.title g) (.name (get (.items g) 1))
             (len (.tags (get (.items g) 0))) (get (.tags (get (.items g) 0)) 1))
    (println "{} {}" (len NUMS) (+ (get NUMS 0) (get NUMS 2)))
    0))
