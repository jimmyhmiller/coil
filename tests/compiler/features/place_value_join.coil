(module place_value_join)
(import "coil.control" :use [block return-from])
(import "coil.try" :use [try try-or!])
(import "coil.primitive" :as primitive)

; An owning aggregate `let` is a `(ref T)` place and a constructed temporary is a
; `(mut T)` place. Where control flow joins one of those with a plain `T`, or with
; each other, the result is the value `T`: the place side is loaded, as it would be
; if an annotation supplied `T`. These used to be type errors in unannotated
; positions (`if`, `match`, and the loop behind `block`/`try`).

(defstruct Big [(x i64) (y i64) (z i64)])

(defn make [(x i64)] (-> Big) (Big :x x :y (* x 2) :z (* x 3)))

(defn found [(ok bool) (x i64)] (-> (Result Big i64))
  (if ok (Ok (make x)) (Err x)))

(defn if-local-or-call [(c bool)] (-> i64)
  (let [b (if c (let [l (make 1)] l) (make 2))]
    (.z b)))

(defn if-call-or-local [(c bool)] (-> i64)
  (let [l (make 3)
        b (if c (make 4) l)]
    (.z b)))

(defn match-binder-or-constructor [(ok bool)] (-> i64)
  (let [b (match (found ok 5)
            (Ok [v] v)
            (Err [_] (Big :x 0 :y 0 :z 7)))]
    (.z b)))

; The `return-from` carries a value and the block's tail names a local.
(defn block-value-then-place [(c bool)] (-> i64)
  (let [b (block :k
            (when c (return-from :k (make 6)))
            (let [l (make 7)] l))]
    (.z b)))

; The first break is a place, so the loop is re-typed when the value arrives.
(defn block-place-then-value [(c bool)] (-> i64)
  (let [b (block :k
            (let [l (make 8)]
              (when c (return-from :k l)))
            (make 9))]
    (.z b)))

; The shape `coil lint --fix` produces from a Result match with a fallback.
(defn try-or-aggregate [(ok bool)] (-> i64)
  (let [(mut b) (try (let [v (try-or! (found ok 10) (make 11))] v))]
    (set! (.x b) 100)
    (+ (.x b) (.z b))))

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (counter) (+ (* (load (counter)) 10) (.value self)))))

; Each owner is dropped exactly once, after its last use.
(defn owner-join [(c bool)] (-> i64)
  (let [o (if c (let [l (Owner :value 1)] l) (Owner :value 2))]
    (.value o)))

(defn main [] (-> i64)
  (println "if {} {} {} {}"
           (if-local-or-call true)
           (if-local-or-call false)
           (if-call-or-local true)
           (if-call-or-local false))
  (println "match {} {}"
           (match-binder-or-constructor true)
           (match-binder-or-constructor false))
  (println "block {} {} {} {}"
           (block-value-then-place true)
           (block-value-then-place false)
           (block-place-then-value true)
           (block-place-then-value false))
  (println "try-or {} {}" (try-or-aggregate true) (try-or-aggregate false))
  (store! (counter) 0)
  (let [first (owner-join true)
        second (owner-join false)]
    (println "owners {} {} dropped {}" first second (load (counter))))
  0)
