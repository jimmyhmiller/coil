(module allocator_lease_test)
(import "coil.alloc" :as alloc)
(import "coil.primitive" :as primitive)

(defn main [] (-> i64)
  (let [lease (alloc/malloc-allocator-lease)
        duplicate (clone lease)]
    (match (alloc/lease-raw-alloc duplicate
                                  (alloc/AllocRequest
                                    :type-id 0
                                    :count 8
                                    :bytes 8
                                    :align 8))
      (None [] 1)
      (Some [memory]
            (do
              (store! (primitive/cast (ptr i64) memory) 42)
              (let [answer (load (primitive/cast (ptr i64) memory))]
                (alloc/lease-raw-free duplicate
                                      memory
                                      (alloc/AllocRequest
                                        :type-id 0
                                        :count 8
                                        :bytes 8
                                        :align 8))
                answer))))))
