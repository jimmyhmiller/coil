(module transparent_arc_nested_lifetime)
(import "coil.arraylist" :use *)

(defstruct Leaf [(value i64)])

(defsum Tree
  (Branch [(children (ArrayList Tree))])
  (Item [(leaf Leaf)]))

(defn leaf-value [(tree Tree)] (-> i64)
  (match tree
    (Item [leaf] (let [held leaf] (.value held)))
    (Branch [children] (leaf-value (al-get [Tree] children 0)))))

(defn main [] (-> i64)
  (let [(mut children) (al-new [Tree])]
    (al-push! [Tree] (mut children) (Item (Leaf :value 42)))
    (leaf-value (Branch children))))
