(module compiler.features.tracing-allocator)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.tracealloc" :as trace)

(defn main [] (-> i64)
  (let [state (primitive/alloc-stack trace/TracingAllocator)
        _ (trace/tracing-allocator-init state "fixture" (alloc/malloc-allocator))
        a (trace/tracing-allocator-view state)]
    (match (alloc/alloc [u8] a 16)
      (None [] 1)
      (Some [memory]
        (do
          (let [before (trace/tracing-allocator-stats state)]
            (if (or (!= (.allocation-calls before) 1)
                    (or (!= (.current-live-bytes before) 16)
                        (or (!= (.peak-live-bytes before) 16)
                            (!= (.cumulative-bytes before) 16))))
                2
                (do
                  (alloc/free [u8] a memory)
                  (let [after (trace/tracing-allocator-stats state)]
                    (if (and (= (.current-live-bytes after) 0)
                             (= (.backing-bytes after) -1))
                        0
                        3))))))))))
