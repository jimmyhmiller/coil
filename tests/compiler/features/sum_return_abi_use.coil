; The consumer half of the cross-backend sum test (see sum_return_abi_lib).
(module sum-return-abi-use)
(import "sum-return-abi-types" :use *)

(extern sum_abi_fn :cc c [i64] (-> (ptr i8)))

(defn check [(label (slice u8)) (got i64) (want i64)] (-> i64)
  (if (= got want)
      0
      (do (println "FAIL {}: got {} want {}" label got want) 1)))

(defn main [] (-> i64)
  (let [mk0 (cast (fnptr c [i64] S0) (sum_abi_fn 0))
        mk1 (cast (fnptr c [i64] S1) (sum_abi_fn 1))
        mk2 (cast (fnptr c [i64] S2) (sum_abi_fn 2))
        mk3 (cast (fnptr c [i64] S3) (sum_abi_fn 3))
        mk8 (cast (fnptr c [i64] S8) (sum_abi_fn 8))
        mkf (cast (fnptr c [i64] SF) (sum_abi_fn 9))
        (mut fails) 0]
    (set! fails (+ fails (check "s0" (d0 (mk0 1)) 6)))
    (set! fails (+ fails (check "s1" (d1 (mk1 7)) 7)))
    (set! fails (+ fails (check "s2" (d2 (mk2 3)) 43)))
    (set! fails (+ fails (check "s3" (d3 (mk3 1)) 321)))
    (set! fails (+ fails (check "s8" (d8 (mk8 1)) 8028)))
    (set! fails (+ fails (check "s8 empty" (d8 (mk8 -1)) -1)))
    (set! fails (+ fails (check "sf" (df (mkf 4)) 12)))
    (println "failures: {}" fails)
    fails))
