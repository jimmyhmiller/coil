(module dyn_storage)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(import "dyn_provider" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defsum DynChoice
  (NoProvider [])
  (HasProvider [(provider (dyn ModelProvider))]))

(defstruct AgentRunJob
  [(provider (dyn ModelProvider))])

(defstruct ProviderRegistry
  [(providers (ArrayList (dyn ModelProvider)))])

(defn invoke [(job (ptr AgentRunJob))] (-> i64)
  (run (.provider job)))

(defn erase-provider [(provider (ptr Provider))] (-> (dyn ModelProvider))
  provider)

(defn run-local [(provider (dyn ModelProvider))] (-> i64)
  (let [local (: provider (dyn ModelProvider))]
    (run local)))

(defn main [] (-> i64)
  (let [provider (primitive/alloc-stack Provider)
        job (primitive/alloc-stack AgentRunJob)
        providers (primitive/alloc-stack (array (dyn ModelProvider) 2))
        (mut list) (al-new [(dyn ModelProvider)] (malloc-allocator))]
    (set! (.value provider) 42)
    ; Expected-type coercion must work for fields and array elements.
    (set! (.provider job) provider)
    (set! (primitive/index providers 0) provider)
    (set! (primitive/index providers 1) (erase-provider provider))
    ; A dynamic trait is an ordinary fixed-size generic argument.
    (al-push! (mut list) (primitive/make-dyn ModelProvider provider))
    (let [boxed (alloc/box! (malloc-allocator)
                            (dyn ModelProvider)
                            (erase-provider provider))
          choice (HasProvider (erase-provider provider))
          optional (Some [(dyn ModelProvider)] (erase-provider provider))]
      (if (and (= (invoke job) (primitive/cast i64 42))
               (and (= (run (load (primitive/index providers 0))) (primitive/cast i64 42))
                    (and (= (run (load boxed)) (primitive/cast i64 42))
                         (and (= (run-local (al-get [(dyn ModelProvider)] (load list) 0)) (primitive/cast i64 42))
                              (and (match choice
                                     (HasProvider [p] (= (run p) (primitive/cast i64 42)))
                                     (NoProvider [] false))
                                   (match optional
                                     (Some [p] (= (run p) (primitive/cast i64 42)))
                                     (None [] false)))))))
          0
          1))))
