(module const-macro-initializer)
(import "coil.assert" :use [assert])

;;; A `const` initializer is ordinary syntax, so a macro call in it must expand
;;; before the value is folded. Expansion needs the metaprogram compiled first,
;;; and that closure carries every const along to be type-checked — where an
;;; unexpanded call is rejected against the macro's own `Code` parameters. The
;;; round recovers by expanding the rejected call and checking again, which only
;;; works while the setup diagnostic reaches `LS.check_diags`.
(defn twice [(x Code)] (-> Code)
  `(+ ~x ~x))

(defn pick-second [(a Code) (b Code)] (-> Code)
  b)

(const DIRECT (twice 5))

(const NESTED (twice (cond true 3 :else 4)))

(const CORE (cond false 1 :else 7))

(const PICKED (pick-second 1 2))

(static-assert (= DIRECT 10) "a macro-built const folds to a literal")

(defn main [] (-> i64)
  (assert (= DIRECT 10))
  (assert (= NESTED 6))
  (assert (= CORE 7))
  (assert (= PICKED 2))
  ; the same macros in an ordinary expression position, which always worked
  (assert (= (twice 5) DIRECT))
  0)
