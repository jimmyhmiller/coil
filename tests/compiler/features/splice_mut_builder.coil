; A CodeBuilder held in a `(mut …)` local splices and unquotes like any builder.
(module splice-mut-builder)
(import "coil.primitive" :as primitive)

(defn sum-of [& (xs Code)] (-> Code)
  (let [(mut terms) (primitive/code-list-new)]
    (for x (iter xs) (push! (mut terms) x))
    `(+ ~@terms)))

(defn product [(x Code) (y Code)] (-> Code)
  (let [(mut call) (primitive/code-list-new)]
    (push! (mut call) `*)
    (push! (mut call) x)
    (push! (mut call) y)
    `(if true ~call 0)))

(defn main [] (-> i64)
  (println "{} {}" (sum-of 40 2) (product 6 7))
  0)
