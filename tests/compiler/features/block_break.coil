(module block-break)

; `block*` is left only by a labelled break; an unlabeled break or continue inside
; it belongs to the loop around it.

; an unlabeled break inside a block leaves the enclosing loop
(defn first-over [(limit i64)] (-> i64)
  (let [(mut i) 0]
    (loop (block* :step
            (when (> i limit) (break))
            (set! i (+ i 1))))
    i))

; continue inside a block goes to the next iteration of the loop
(defn sum-odd [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (loop (set! i (+ i 1))
          (when (> i n) (break))
          (block* :check
            (when (= (% i 2) 0) (continue))
            (set! total (+ total i))))
    total))

; a labelled break still leaves the block with its value
(defn classify [(x i64)] (-> i64)
  (block* :done
    (when (< x 0) (break :done -1))
    (when (= x 0) (break :done 0))
    1))

; through several blocks, and to the innermost loop only
(defn nested [] (-> i64)
  (let [(mut outer) 0
        (mut inner-total) 0]
    (loop (set! outer (+ outer 1))
          (when (> outer 3) (break))
          (block* :a
            (let [(mut j) 0]
              (loop (block* :b
                      (block* :c
                        (set! j (+ j 1))
                        (when (> j outer) (break))
                        (set! inner-total (+ inner-total 1))))))))
    inner-total))

; an unlabeled loop is reached even when its body is mostly blocks
(defn labelled-outer [] (-> i64)
  (let [(mut i) 0]
    (loop :outer
      (block* :inner
        (set! i (+ i 1))
        (when (= i 5) (break))))
    i))

(defn main [] (-> i64)
  (println "first-over {}" (first-over 4))
  (println "sum-odd {}" (sum-odd 9))
  (println "classify {} {} {}" (classify -3) (classify 0) (classify 8))
  (println "nested {}" (nested))
  (println "labelled-outer {}" (labelled-outer))
  0)
