(module block-break)

; `block*` is left only by a labelled break; an unlabeled break or continue inside
; it belongs to the loop around it.

; an unlabeled break inside a block leaves the enclosing loop
(defn first-over [(limit i64)] (-> i64)
  (let [(mut i) 0]
    (loop (block* :step
            (when (> i limit) (break))
            (set! i (+ i 1))))
    i))

; continue inside a block goes to the next iteration of the loop
(defn sum-odd [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (loop (set! i (+ i 1))
          (when (> i n) (break))
          (block* :check
            (when (= (% i 2) 0) (continue))
            (set! total (+ total i))))
    total))

; a labelled break still leaves the block with its value
(defn classify [(x i64)] (-> i64)
  (block* :done
    (when (< x 0) (break :done -1))
    (when (= x 0) (break :done 0))
    1))

; through several blocks, and to the innermost loop only
(defn nested [] (-> i64)
  (let [(mut outer) 0
        (mut inner-total) 0]
    (loop (set! outer (+ outer 1))
          (when (> outer 3) (break))
          (block* :a
            (let [(mut j) 0]
              (loop (block* :b
                      (block* :c
                        (set! j (+ j 1))
                        (when (> j outer) (break))
                        (set! inner-total (+ inner-total 1))))))))
    inner-total))

; a labelled loop is reached by its own label through the blocks inside it
(defn labelled-outer [] (-> i64)
  (let [(mut i) 0]
    (loop :outer
      (block* :inner
        (set! i (+ i 1))
        (when (= i 5) (break))))
    i))

; The forms built on block*. A match arm with a nested pattern is tried inside a
; block, and so is the body of `block`: a `(break)` in either leaves the user's loop.
(defn lookup [(xs (slice i64)) (i i64)] (-> (Result (Option i64) i64))
  (if (< i (len xs))
      (Ok [(Option i64) i64] (Some (get xs i)))
      (Ok [(Option i64) i64] (None [i64]))))

(defn first-negative [(xs (slice i64))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (match (lookup xs i)
            (Ok [(Some [v])]
              (do (when (< v 0) (set! found i) (break))
                  (set! i (+ i 1))
                  0))
            (_ (break))))
    found))

(defn count-to [(n i64)] (-> i64)
  (let [(mut i) 0]
    (while true
      (block :step
        (set! i (+ i 1))
        (when (>= i n) (break))))
    i))

(defn main [] (-> i64)
  (println "first-over {}" (first-over 4))
  (println "sum-odd {}" (sum-odd 9))
  (println "classify {} {} {}" (classify -3) (classify 0) (classify 8))
  (println "nested {}" (nested))
  (println "labelled-outer {}" (labelled-outer))
  (println "first-negative {} {}" (first-negative [3 1 -4 1]) (first-negative [2 7]))
  (println "count-to {}" (count-to 7))
  0)
