(module receiver-peer-type)

; A trait method's arguments that have no type of their own take it from the
; argument in the Self position, and a receiver with none takes it from a peer.

(deftrait Same [Self] (same? [(a Self) (b Self)] (-> bool)))

(impl [T] Same (Option T)
  (same? [(a (Option T)) (b (Option T))] (-> bool)
    (match a (Some [_] (some? b)) (None [] (not (some? b))))))

(defn some? [T] [(o (Option T))] (-> bool) (match o (Some [_] true) (None [] false)))

(defn both [T] [(a T) (b (Option T))] (-> bool) (some? b))

(defn main [] (-> i64)
  (let [x (: (Some 3) (Option i64))
        r (: (Ok 1) (Result i64 (slice u8)))]
    (println "{} {} {} {}" (= x (None)) (= r (Ok 1)) (= (None) x) (= (Ok 1) r))
    (println "{} {}" (same? x (None)) (same? (None) x))
    (println "{}" (both 1 (None)))
    (assert-eq r (Ok 1))
    (assert-eq (Some 3) x)
    0))
