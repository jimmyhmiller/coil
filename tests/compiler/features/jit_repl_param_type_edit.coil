(module compiler.features.jit-repl-param-type-edit)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Publishing a new parameter signature must not unify it with the old Var's
; function-pointer type. This is the minimal f32 -> i32 edit from cm4kvxksrdt.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        initial
          (jit/jit-compile-with-entry! (mut session)
                                       "(import \"coil.repl\")
                   (defn damage [(target i64) (amount f32)] (-> f32) amount)"
                                       "(coil.repl/publish)")]
    (println "initial status: {}" initial)
    (if (!= initial 0)
        (do
          (println "{}" (jit/jit-diagnostic (mut session)))
          (jit/jit-session-free! (mut session))
          1)
        (let [replacement
                (jit/jit-compile-with-entry! (mut session)
                                             "(defn damage [(target i64) (amount i32)] (-> f32) (cast f32 amount))"
                                             "(coil.repl/publish)")]
          (println "replacement status: {}" replacement)
          (when (!= replacement 0)
            (println "{}" (jit/jit-diagnostic (mut session))))
          (jit/jit-session-free! (mut session))
          (if (= replacement 0) 0 2)))))
