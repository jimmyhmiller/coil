(module compiler.features.jit-session-imports)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A module accepted by an earlier submission, or declared earlier in the same
;; submission, is importable by name: it has no file to resolve.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session)
            "(module imports.base) (defn one [] (-> i64) 1)") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module imports.mid)
             (import \"imports.base\" :as b)
             (import \"imports.base\" :use [one])
             (defn two [] (-> i64) (+ (b/one) (one)))"
            "(if (= (imports.mid.two) 2) 0 1)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module imports.p) (defn seven [] (-> i64) 7)
             (module imports.q) (import \"imports.p\" :as p)
             (defn also-seven [] (-> i64) (p/seven))"
            "(if (= (imports.q.also-seven) 7) 0 1)") 0) 3
      ; A name no submission declared and no file provides is still an error.
      (= (jit/jit-compile! (mut session)
           "(module imports.r) (import \"imports.never\" :as n)") 0) 4
      :else (do (jit/jit-reset! (mut session)) 0))))
