(module ownership_generic_wrapped_drop)
(import "coil.primitive" :as primitive)
(import "coil.result" :use *)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (counter) (+ (load (counter)) (.value self)))))

(defstruct Holder [T] [(held T)])
(defsum Either [T] (Left [(held T)]) (Right [(n i64)]))

; Each local's type wraps T without being T. Whether it owns anything is only
; known once T is substituted, so the instance must still drop it at scope exit.
(defn hold-struct [T] [(value T)] (-> i64)
  (let [h (Holder :held value)] 0))

(defn hold-sum [T] [(value T)] (-> i64)
  (let [e (Left [T] value)] 0))

(defn wrap [T] [(value T)] (-> (Option T))
  (Some value))

; The shape of `coil.pvec/pv-pop`: an `(Option T)` result bound only to discard it.
(defn hold-option [T] [(value T)] (-> i64)
  (let [dropped (wrap value)] 0))

; A match payload of type `(Option T)` moved out of an owned scrutinee.
(defn hold-nested [T] [(value T)] (-> i64)
  (match (Some (Some value))
    (Some [inner] 1)
    (None [] 0)))

; A Copy instance of the same templates owns nothing and must still run.
(defn copy-instances [] (-> i64)
  (+ (+ (hold-struct 1) (hold-sum 2)) (+ (hold-option 3) (hold-nested 4))))

(defn main [] (-> i64)
  (store! (counter) 0)
  (hold-struct (Owner :value 1))
  (hold-sum (Owner :value 2))
  (hold-option (Owner :value 4))
  (hold-nested (Owner :value 8))
  ; 1 + 2 + 4 + 8: every owner dropped exactly once. The Copy instances add 1.
  (+ (load (counter)) (* 100 (copy-instances))))
