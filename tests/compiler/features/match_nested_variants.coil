; A payload position may select a variant. The arm matches only when every nested
; variant matches; otherwise matching falls through to the next arm.
(module match-nested-variants)

(defsum ParseError (Empty) (NotADigit [(at i64)]))
(defsum Shape (Circle [(r i64)]) (Square [(side i64)]))
(defsum Pair (Both [(left Shape) (right (Option i64))]))

(defn show [(r (Result i64 ParseError))] (-> i64)
  (match r
    (Ok [v] (println "ok {}" v))
    (Err [(NotADigit [at])] (println "bad digit at {}" at))
    (Err [e] (println "some other error")))
  0)

(defn nested [(o (Option (Option (Result i64 ParseError))))] (-> i64)
  (match o
    (Some [(Some [(Ok [v])])] v)
    (Some [(Some [(Err [(NotADigit [at])])])] (- 0 at))
    (Some [_] -100)
    (None [] -1)))

(defn pair [(p Pair)] (-> i64)
  (match p
    (Both [(Circle [r]) (Some [n])] (+ (* 100 r) n))
    (Both [(Square [s]) extra] (* 1000 s))
    (_ 7)))

(defn main [] (-> i64)
  (show (Ok 42))
  (show (Err (NotADigit 3)))
  (show (Err (Empty)))
  (println "{} {} {} {} {}"
           (nested (Some (Some (Ok 5))))
           (nested (Some (Some (Err (NotADigit 9)))))
           (nested (Some (Some (Err (Empty)))))
           (nested (Some (None)))
           (nested (None)))
  (println "{} {} {}"
           (pair (Both (Circle 2) (Some 3)))
           (pair (Both (Circle 2) (None)))
           (pair (Both (Square 4) (None))))
  0)
