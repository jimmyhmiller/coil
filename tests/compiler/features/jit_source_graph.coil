(module compiler.features.jit-source-graph)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)
(import "coil.str" :as str)
(import "coil.primitive" :as primitive)
(import "coil.scratch" :as scratch)

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (< argc (primitive/cast i32 2))
      1
      (let [a (malloc-allocator)
            (mut session) (jit/jit-session-new a)
            (mut arena) (primitive/zeroed scratch/ScratchArena)]
        (scratch/scratch-init (mut arena) a)
        (let [(mut graph)
                (jit/jit-read-source-graph (scratch/scratch-allocator (mut arena))
                                           (str/cstr->str (load (primitive/index argv
                                                                                 1))))
              (mut entry) false
              (mut dependency) false]
          (for [i 0 (jit/jit-source-graph-count (mut graph))]
            (let [name (jit/jit-source-graph-module (mut graph) i)
                  text (jit/jit-source-graph-text (mut graph) i)]
              (when (= name "graph.entry") (set! entry (> (len text) 0)) 0)
              (when (= name "graph.dependency")
                (set! dependency (> (len text) 0))
                0)))
          (let [ok
                  (if (= argc (primitive/cast i32 2))
                      (and (jit/jit-source-graph-ok? (mut graph))
                           (and (load entry) (load dependency)))
                      (and (not (jit/jit-source-graph-ok? (mut graph)))
                           (and (> (len (jit/jit-source-graph-diagnostic (mut graph)))
                                   0)
                                (> (len (jit/jit-source-graph-error-path (mut graph)))
                                   0))))]
            (scratch/scratch-close! (mut arena))
            ; Graph storage is gone; the independent JIT must remain usable.
            (if (not ok)
                3
                (jit/jit-submit! (mut session) "(+ 20 22)")))))))
