(module ownership_borrowed_match)
(import "coil.primitive" :as primitive)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (drops) (+ (load (drops)) 1))))

(defsum Boxed
  (Empty)
  (Present [(owner Owner)]))

(defn borrowed-value [(boxed (ref Boxed))] (-> i64)
  (match boxed
    (Empty [] 0)
    ; A borrowed match binds a reference into the retained payload. Inspecting
    ; it must not move or destroy the affine Owner stored in `boxed`.
    (Present [owner] (.value owner))))

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [(mut status) 0]
    (let [boxed (Present (Owner :value 42))]
      (if (and (= (borrowed-value boxed) 42)
               (= (load (drops)) 0))
          0
          (set! status 1)))
    (if (and (= (load status) 0) (= (load (drops)) 1))
        0
        2)))
