; `(.field value)` reads a field of a value that is not a place: a call result,
; a chain over one, a `for` element, a match payload, and an owning temporary,
; which is destroyed exactly once after the read.
(module field-read-temporaries)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new al-free!])

(defstruct Point [(x i64) (y i64)])

(defstruct Rect [(origin Point) (size Point)])

(defsum Shape (Box [(r Rect)]) (Dot [(p Point)]))

(defstruct Res [(id i64)])

(impl Drop Res
  (drop [(self (mut Res))] (-> void) (println "drop {}" (.id self))))

(defstruct Holder [(res Res) (n i64)])

(defn make-rect [(x i64)] (-> Rect)
  (Rect
    :origin (Point :x x :y 2)
    :size (Point :x 3 :y 4)))

(defn make-holder [(id i64)] (-> Holder)
  (Holder
    :res (Res :id id)
    :n (* id 10)))

(defn origin-x [] (-> i64)
  (.x (.origin (make-rect 11))))

(const FOLDED (origin-x))

(defn main [] (-> i64)
  (println "call {}" (.x (.origin (make-rect 7))))
  (println "chain {}" (.y (.size (make-rect 1))))
  (let [(mut xs) (al-new [Point] (malloc-allocator))]
    (push! (mut xs) (Point :x 10 :y 20))
    (push! (mut xs) (Point :x 30 :y 40))
    (for p (iter xs) (println "for {} {}" (.x p) (.y p)))
    (al-free! (mut xs)))
  (match (Box (make-rect 5))
    (Box [r] (println "match {}" (.x (.origin r))))
    (Dot [p] (println "dot {}" (.x p))))
  (let [n (.n (make-holder 1))
        id (.id (.res (make-holder 2)))]
    (println "owner {} {}" n id))
  (println "const {}" FOLDED)
  0)
