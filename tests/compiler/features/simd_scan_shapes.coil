(module test.simd-scan-shapes)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn check-shape [N] [] (-> i64)
  (let [integers (v/viota [i64 N])
        floats (: (v/vconvert integers) (vec f64 N))
        sum (v/vscan-add floats 7.0)
        maximum (v/vscan-max (v/vneg floats) -99.0)]
    (for [i 0 (v/vlanes floats)]
      (assert (p/fcmp-eq (v/vextract (.values sum) i) (cast f64 (+ 7 (/ (* i (+ i 1)) 2)))))
      (assert (p/fcmp-eq (v/vextract (.values maximum) i) 0.0)))
    (let [negative-zero (v/vsplat [f64 N] -0.0)
          result (v/vscan-add negative-zero -0.0)
          bits (: (v/vbitcast (.values result)) (vec u64 N))]
      (assert (v/mask-all? (v/v= bits (v/vsplat [u64 N] 0x8000000000000000))))))
  0)

(defn main [] (-> i64)
  (check-shape [(const 1)])
  (check-shape [(const 3)])
  (check-shape [(const 8)])
  (check-shape [(const 16)])
  (check-shape [(const 32)])
  (check-shape [(const 64)])
  0)
