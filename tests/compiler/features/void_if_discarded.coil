(module void_if_discarded)

(import "coil.primitive" :as primitive)

(extern free :cc c [(ptr i8)] (-> void))

(defn main [] (-> i64)
  (do
    ; Both branches yield C void. This `if` is deliberately not the tail: ordinary
    ; expression lowering must merge control flow without asking LLVM for a void phi.
    (if true
        (free (primitive/cast (ptr i8) 0))
        (free (primitive/cast (ptr i8) 0)))
    0))
