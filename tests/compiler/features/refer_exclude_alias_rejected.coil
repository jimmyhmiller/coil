; SURFACE 4 (ambient primitive aliases): an excluded core alias is gone, forcing the
; qualified `primitive/load`.
(module refer-exclude-alias-rejected)
(import "coil.core" :use * :exclude [load])
(import "coil.primitive" :as primitive)
(defn main [] (-> i64)
  (let [p (primitive/alloc-stack i64)] (load p)))
