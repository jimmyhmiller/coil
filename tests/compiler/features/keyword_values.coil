(module keyword-values)

; Keywords compare, hash and pass positionally like any other value. A call only
; reads as named when its keywords label the callee's parameters.

(defsum Mode (Fixed [(kind Keyword) (n i64)]))

(defn speed [(mode Keyword)] (-> i64) (case mode :fast 3 :slow 1 0))

(defn pick [(which Keyword) (n i64)] (-> i64) (if (= which :double) (* n 2) n))

(defn move [(x i64) (dx i64)] (-> i64) (+ x dx))

(defn main [] (-> i64)
  (println "{} {} {}" (= :fast :fast) (!= :fast :slow) (= (hash :a) (hash :a)))
  (println "{} {} {}" (speed :slow) (speed :fast) (speed :other))
  (println "{} {}" (pick :double 21) (move :dx 2 :x 1))
  (match (Fixed :turbo 9)
    (Fixed [kind n] (println "{}" (if (= kind :turbo) n 0))))
  0)
