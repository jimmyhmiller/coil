(module compiler.features.meta-suffix-expansion)
(import "coil.primitive" :as p)

; The generated declarations use the completed macro context, including nested
; binding macros and a macro that calls an ordinary helper. Sibling names and
; public names must be visible without expanding the existing program again.
(defn answer [] (-> i64) 42)
(defn add-answer [(value Code)] (-> Code)
  `(+ ~value ~(answer)))

(defn generate [] (-> Code)
  `(do
     (const ~(p/syntax->datum `OFFSET) 2)
     (defn ~(p/syntax->datum `generated) [([left right] (array i64 2))] (-> i64)
       (let [[a b] [left right]]
         (add-answer (- (+ a b) OFFSET))))))

(meta (generate))
; No generated forms is also an expansion wave with an unchanged prefix.
(defn empty [] (-> Code) `(do))
(meta (empty))

(defn main [] (-> i64)
  (if (= (generated [1 1]) 42) 0 1))
