(module ownership_move_drops_in_callee)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (counter) (+ (load (counter)) (.value self)))))

(defn consume [(owner Owner)] (-> i64)
  (.value owner))

(defn run [] (-> i64)
  (let [owner (Owner :value 7)]
    (consume owner)))

(defn main [] (-> i64)
  (store! (counter) 0)
  (run)
  ; The caller suppresses its drop after the move; the callee drops exactly once.
  (load (counter)))
