(module compiler.features.jit-closure-return-type-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A returned closure changes both capture layout and call parameter list.
; Retain a v1 value, publish v2 under a distinct type identity, then call both.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(module closure-edit)
       (import \"coil.repl\") (import \"coil.closure\" :use [defclosure]) (import \"coil.var\" :use [var-static])
       (defclosure callback-v1 [(base f32) (extra f32)] [(x f32)] f32 (+ (+ base extra) x))
       (defn arm [(base f32)] (-> (ptr callback-v1)) (callback-v1-new base (cast f32 2)))
       (def old (var-static (ptr callback-v1) (cast (ptr callback-v1) 0)))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) ""
      "(do (set old (arm (cast f32 3))) (if (= (callback-v1-call (get old) (cast f32 4)) (cast f32 9)) 0 1))") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session)
      "(defclosure callback-v2 [(base f32)] [(x f32) (y f32)] f32 (+ (+ base x) y))
       (defn arm [(base f32)] (-> (ptr callback-v2)) (callback-v2-new base))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut session) ""
      "(let [fresh (arm (cast f32 10))
             ok (and (= (callback-v1-call (get old) (cast f32 4)) (cast f32 9))
                     (= (fresh (cast f32 1) (cast f32 2)) (cast f32 13)))]
         (callback-v2-free fresh) (callback-v1-free (get old)) (if ok 0 1))") 0))
    (jit/jit-reset! (mut session))))
