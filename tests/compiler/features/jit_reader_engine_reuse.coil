(module compiler.features.jit-reader-engine-reuse)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.dbgalloc" :use [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.jit" :as jit)

;; A session's source provider is compiled once: every later read reuses its
;; engine (the gate counts the builds under COIL_TRACE). Freeing the session
;; returns everything the cached engine held.
(defn main [] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))
        (mut s) (jit/jit-session-new (debug-allocator-view debug))]
    (cond (!= (jit/jit-session-set-source-provider! (mut s) "retained.provider" "read-source" "" "") 0) 1
          (!= (jit/jit-compile! (mut s) "(module reuse.a) (defn one [] (-> i64) 1)") 0) 2
          (!= (jit/jit-compile! (mut s) "(module reuse.a) (defn two [] (-> i64) 2)") 0) 3
          (!= (jit/jit-compile! (mut s) "(module reuse.a) (defn three [] (-> i64) 3)") 0) 4
          (!= (jit/jit-compile-with-entry! (mut s) "" "(if (= (+ (one) (+ (two) (three))) 6) 0 1)") 0) 5
          (!= (jit/jit-session-free! (mut s)) 0) 6
          (!= (debug-allocator-deinit! debug) 0) 7
          :else 0)))
