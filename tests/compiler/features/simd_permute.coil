(module test.simd-permute)
(import "coil.simd" :as v)
(import "coil.primitive" :as p)

(defn main [] (-> i64)
  (let [bytes (v/viota [u8 16])
        indices (v/vsub (v/vsplat [u32 16] 15) (v/viota [u32 16]))
        reversed (v/vtable bytes indices)
        joined (v/vshuffle bytes (v/vsplat [u8 16] 99) (v/vadd indices (v/vsplat [u32 16] 8)))]
    (for [i 0 16]
      (assert-eq (v/vextract reversed i) (cast u8 (- 15 i)))
      (assert-eq (v/vextract joined i) (if (< i 8) (cast u8 99) (cast u8 (- 23 i)))))
    (assert-eq (v/vextract (v/vtable bytes (v/vsplat [i8 4] -1)) 0) (cast u8 0))
    (assert-eq (v/vextract (v/vtable bytes (v/vsplat [u8 4] 16)) 0) (cast u8 0))
    (assert-eq (v/mask->bits (v/mask-low [16] 3)) (cast u64 7))
    (assert-eq (v/mask->bits (v/mask-low [16] -1)) (cast u64 0))
    (assert-eq (v/mask->bits (v/mask-low [16] 17)) (cast u64 65535))
    (let [wide (v/vconvert [u16 u8 16] bytes)
          floats (v/vconvert [f32 u16 16] wide)
          narrow (v/vconvert [u8 f32 16] floats)]
      (assert-eq (v/vextract wide 15) (cast u16 15))
      (assert-eq (v/mask->bits (v/v= bytes narrow)) (cast u64 65535)))
    (assert-eq (v/vextract (v/vconvert [i16 i8 4] (v/vsplat [i8 4] -1)) 0) (cast i16 -1))
    (assert-eq (v/vextract (v/vconvert [u8 f32 4] (v/vsplat [f32 4] 999.0)) 0) (cast u8 255))
    (assert-eq (v/vextract (v/vconvert [i8 f32 4] (v/vsplat [f32 4] -999.0)) 0) (cast i8 -128))
    (assert-eq (v/vextract (v/vbitcast [u32 4 f32 4] (v/vsplat [f32 4] 1.0)) 0) (cast u32 1065353216))
    0))
