(module test.mutable-binding-fresh-value)
(import "coil.primitive" :as p)
(import "coil.assert" :use *)

;; A bare `(mut x)` binding of plain data binds a copy: of a freshly built
;; value, of another local, or of a parameter that arrived by immutable
;; reference. Aliasing a place is spelled `(mut place)`.
(defstruct Rect [(w i64) (h i64)])
(defsum Shape (Round [(r i64)]) (Square [(side i64)]))

(defn area [(r Rect)] (-> i64) (* (.w r) (.h r)))

;; `r` arrives by immutable reference; the mutable binding is this function's copy.
(defn widened-area [(r Rect)] (-> i64)
  (let [(mut c) r]
    (set! (.w c) (* (.w c) 10))
    (area c)))

(defn main [] (-> i64)
  (let [(mut r) (Rect :w 2 :h 3)
        (mut z) (p/zeroed Rect)
        (mut xs) [1 2 3]
        (mut s) (Round :r 1)]
    (assert-eq (area r) 6)
    (set! (.w r) 5)
    (assert-eq (area r) 15)
    (set! (.w z) 4)
    (set! (.h z) 4)
    (assert-eq (area z) 16)
    (store! (p/index (mut xs) 0) 10)
    (assert-eq (get (: xs (slice i64)) 0) 10)
    (set! s (Square :side 7))
    (assert-eq (match s (Round [r] r) (Square [side] side)) 7)
    ;; a mutable binding of a local copies it; `(mut place)` aliases instead
    (let [(mut n) 10
          (mut copied) n
          (mut aliased) (mut n)]
      (set! copied 20)
      (assert-eq n 10)
      (set! aliased 30)
      (assert-eq n 30))
    ;; and of a parameter: the caller's value is untouched
    (let [original (Rect :w 2 :h 3)]
      (assert-eq (widened-area original) 60)
      (assert-eq (.w original) 2))
    ;; the copy is independent of the value it was built from
    (let [source (Rect :w 1 :h 1)
          (mut copy) (p/zeroed Rect)]
      (set! copy (load source))
      (set! (.w copy) 9)
      (assert-eq (.w source) 1)
      (assert-eq (.w copy) 9))
    0))
