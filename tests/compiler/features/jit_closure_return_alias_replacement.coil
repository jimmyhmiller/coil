(module compiler.features.jit-closure-return-alias-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Retaining the authored spelling Callback must not retain its old meaning.
; Old callers, factory pointers, and closure values keep the original signature.
(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(module closure-alias)
       (import \"coil.repl\") (import \"coil.closure\" :use [defclosure])
       (import \"coil.var\" :use [var-static])
       (defclosure callback-v1 [(base f32) (extra f32)] [(x f32)] f32 (+ (+ base extra) x))
       (defalias Callback callback-v1)
       (defn arm [(base f32)] (-> (ptr Callback)) (callback-v1-new base (cast f32 2)))
       (defn retained-arm [(base f32)] (-> (ptr callback-v1)) (arm base))
       (def old-factory (fnptr-of arm))
       (def old-value (var-static (ptr callback-v1) (cast (ptr callback-v1) 0)))"
      "(coil.repl/publish)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(do (set old-value (arm (cast f32 3))) 0)") 0))
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defclosure callback-v2 [(base f32)] [(x f32) (y f32)] f32 (+ (+ base x) y))
       (defalias Callback callback-v2)
       (defn fresh-arm [(base f32)] (-> (ptr Callback)) (arm base))
       (defn arm [(base f32)] (-> (ptr Callback)) (callback-v2-new base))"
      "(coil.repl/publish)") 0))
    ; The same resolved type written directly is compatible with the alias.
    ; The previously accepted fresh-arm must see this update through its cell.
    (assert (= (jit/jit-compile-with-entry! (mut s)
      "(defn arm [(base f32)] (-> (ptr callback-v2)) (callback-v2-new (+ base (cast f32 100))))"
      "(coil.repl/publish)") 0))
    (assert (>= (jit/jit-reclaim-retired! (mut s)) 0))
    (assert (= (jit/jit-compile-with-entry! (mut s) ""
      "(let [from-caller (retained-arm (cast f32 3))
             from-pointer (old-factory (cast f32 3))
             fresh (fresh-arm (cast f32 10))
             ok (and (= (callback-v1-call (get old-value) (cast f32 4)) (cast f32 9))
                     (and (= (from-caller (cast f32 4)) (cast f32 9))
                          (and (= (from-pointer (cast f32 4)) (cast f32 9))
                               (= (fresh (cast f32 1) (cast f32 2)) (cast f32 113)))))]
         (callback-v1-free (get old-value)) (callback-v1-free from-caller)
         (callback-v1-free from-pointer) (callback-v2-free fresh) (if ok 0 1))") 0))
    (jit/jit-reset! (mut s))))
