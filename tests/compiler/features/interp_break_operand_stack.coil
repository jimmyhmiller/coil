(module interp_break_operand_stack)

; A break or return-from out of the middle of an expression. The bytecode
; interpreter had already pushed the destination of the enclosing store; the
; break left it on the operand stack, so the loop's value was copied into the
; wrong place. Native backends have no operand stack and always got 33.
(defstruct Big [(x i64) (y i64) (z i64)])

(defn make [(x i64)] (-> Big) (Big :x x :y (* x 2) :z (* x 3)))

(defn escape-a-binding [(ok bool)] (-> i64)
  (let [b (block :k
            (let [v (if ok (make 10) (return-from :k (make 11)))]
              v))]
    (.z b)))

(defn dead-tail [] (-> i64)
  (let [b (block :k (return-from :k (make 11)) (make 1))]
    (.z b)))

(defn continue-mid-expression [] (-> i64)
  (let [(mut total) 0
        (mut i) 0]
    (while (< i 4)
      (set! i (+ i 1))
      (set! total (+ total (if (= i 2) (continue) i))))
    total))

(defn main [] (-> i64)
  (println "{} {} {} {}"
           (escape-a-binding true)
           (escape-a-binding false)
           (dead-tail)
           (continue-mid-expression))
  0)
