(module arc_concurrency_stress)
(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)
(import "coil.arc" :as arc)
(import "coil.thread" :as thread)

(defn payload-drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Payload [(answer i64)])

(impl Drop Payload
  (drop [(self (mut Payload))]
        (-> void)
        (atomic/atomic-add (payload-drops) 1)))

(defstruct Job
  [(raw-owner (ptr Payload))
   (iterations i64)
   (failures (ptr i64))])

(defn worker [(raw (ptr i8))] (-> (ptr i8))
  (let [job (primitive/cast (ptr Job) raw)
        raw-owner (load (field job raw-owner))
        owner (arc/unsafe-arc-from-raw raw-owner)
        weak (arc/arc-downgrade owner)
        (mut i) 0]
    ; Publish that the raw owning reference has been adopted by this worker.
    ; `pthread_join` synchronizes the main thread before it inspects this field.
    (store! (field job raw-owner) (primitive/cast (ptr Payload) 0))
    (loop (if (>= (load i) (load (field job iterations)))
              (break)
              (do
                ; Each worker owns a distinct strong and weak handle, but all of the
                ; handles contend on the same control block.
                (let [temporary (clone owner)]
                  (when (!= (.answer (arc/arc-borrow temporary)) 42)
                    (atomic/atomic-add (load (field job failures)) 1)))
                (match (arc/weak-upgrade weak)
                  (None [] (atomic/atomic-add (load (field job failures)) 1))
                  (Some [temporary]
                        (when (!= (.answer (arc/arc-borrow temporary)) 42)
                          (atomic/atomic-add (load (field job failures)) 1))))
                (set! i (+ (load i) 1))))))
  (primitive/cast (ptr i8) 0))

(defn stress [] (-> i64)
  (let [failures (primitive/alloc-stack i64)
        jobs (primitive/alloc-stack (array Job 4))
        threads (primitive/alloc-stack (array thread/Thread 4))
        (mut spawned) 0]
    (store! failures 0)
    (match (arc/arc-new (Payload :answer 42))
      (None [] 100)
      (Some [root]
            (let [(mut i) 0]
              ; Every raw pointer owns exactly one strong reference. A successful
              ; worker adopts it; a failed spawn is adopted and released below.
              (loop (if (>= (load i) 4)
                        (break)
                        (let [job (primitive/index jobs (load i))]
                          (store! (field job raw-owner) (arc/arc-into-raw (clone root)))
                          (store! (field job iterations) 20000)
                          (store! (field job failures) failures)
                          (if (= (thread/thread-spawn (primitive/index threads (load i))
                                                      (primitive/fnptr-of worker)
                                                      (primitive/cast (ptr i8) job))
                                 (primitive/cast i32 0))
                              (set! spawned (+ (load spawned) 1))
                              (break))
                          (set! i (+ (load i) 1)))))
              (set! i 0)
              (loop (if (>= (load i) (load spawned))
                        (break)
                        (do
                          (when (!= (thread/thread-join (primitive/index threads (load i)))
                                    (primitive/cast i32 0))
                            (atomic/atomic-add failures 1))
                          (set! i (+ (load i) 1)))))
              ; Recover any owning raw handle whose thread was not started. Successful
              ; workers clear their slot before exiting and have now been joined.
              (set! i 0)
              (loop (if (>= (load i) 4)
                        (break)
                        (let [raw-owner (load (field (primitive/index jobs (load i)) raw-owner))]
                          (unless (= (primitive/cast i64 raw-owner) 0)
                            (let [released (arc/unsafe-arc-from-raw raw-owner)] 0))
                          (set! i (+ (load i) 1)))))
              (if (= (load spawned) 4) (load failures) 101))))))

(defn main [] (-> i64)
  (atomic/atomic-store (payload-drops) 0)
  (let [failures (stress)]
    (if (!= failures 0)
        failures
        (if (= (atomic/atomic-load (payload-drops)) 1) 42 103))))
