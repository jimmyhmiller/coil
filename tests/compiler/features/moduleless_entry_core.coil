; An entry file with no (module …) and no imports sees all of coil.core: its
; `def` aliases (cast, sizeof, zeroed) and the names a macro template refers to.
(defstruct Pair [(a i64) (b i64)])

(defn zero? [(x Code)] (-> Code) `(= ~x 0))

(defn main [] (-> i64)
  (let [p (zeroed Pair)]
    (println "{} {} {} {}" (cast i64 (: 200 u8)) (sizeof Pair) (.a p) (zero? (.b p)))
    0))
