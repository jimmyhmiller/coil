(module compiler.features.jit-env-stale)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)

; A check reports the accepted functions it left reading an interface it changed.
; It does not re-check them or refuse the edit: the holder of the state decides.

(defn stale? [(session (ptr jit/JitSession)) (env jit/JitEnv) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (jit/jit-env-stale-count session env)]
      (when (= (jit/jit-env-stale-name session env i) name) (set! found true) 0))
    (load found)))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-checked-session-new (a/malloc-allocator))
        base (jit/jit-env-check (mut session) (jit/jit-env-empty)
               "(module shapes)
                (defstruct Box [(w i64) (h i64)])
                (defn area [(w i64) (h i64)] (-> i64) (* w h))
                (defn unit [] (-> i64) (area 1 1))
                (defn twice [(n i64)] (-> i64) (* 2 (unit)))
                (defn box-area [(b Box)] (-> i64) (area (.w b) (.h b)))
                (defn unrelated [(n i64)] (-> i64) (+ n 1))")]
    (assert (jit/jit-env-valid? base))
    (assert (= (jit/jit-env-stale-count (mut session) base) 0))

    ; A body edit changes no interface: nothing that reads `area` is stale.
    (let [body-only (jit/jit-env-check (mut session) base
                      "(module shapes) (defn area [(w i64) (h i64)] (-> i64) (+ 0 (* w h)))")]
      (assert (jit/jit-env-valid? body-only))
      (assert (= (jit/jit-env-stale-count (mut session) body-only) 0))
      (jit/jit-env-release! (mut session) body-only))

    ; A signature edit is accepted, and says exactly who it broke: the direct
    ; readers of `area`, not their callers and not the unrelated.
    (let [narrowed (jit/jit-env-check (mut session) base
                     "(module shapes) (defn area [(w i64)] (-> i64) (* w w))")]
      (assert (jit/jit-env-valid? narrowed))
      (assert (= (jit/jit-env-stale-count (mut session) narrowed) 2))
      (assert (stale? (mut session) narrowed "shapes.unit"))
      (assert (stale? (mut session) narrowed "shapes.box-area"))
      (assert (not (stale? (mut session) narrowed "shapes.twice")))
      (assert (not (stale? (mut session) narrowed "shapes.unrelated")))
      ; The base is untouched: nothing in it became stale.
      (assert (= (jit/jit-env-stale-count (mut session) base) 0))

      ; The client re-checks a stale function from its own source. It really is
      ; broken, and the compiler says why.
      (let [source (jit/jit-env-definition-source (mut session) narrowed "shapes.unit")]
        (assert (= source "(defn unit [] (-> i64) (area 1 1))"))
        (let [rechecked (jit/jit-env-check (mut session) narrowed "(module shapes) (defn unit [] (-> i64) (area 1 1))")]
          (assert (not (jit/jit-env-valid? rechecked)))
          (assert (> (len (jit/jit-diagnostic (mut session))) 0))))

      ; Repairing both callers in the same check as nothing else leaves nothing stale.
      (let [repaired (jit/jit-env-check (mut session) narrowed
                       "(module shapes) (defn unit [] (-> i64) (area 1))
                        (defn box-area [(b Box)] (-> i64) (area (.w b)))")]
        (assert (jit/jit-env-valid? repaired))
        (assert (= (jit/jit-env-stale-count (mut session) repaired) 0))

        ; Once `unit` no longer reads `area`, changing `area` again leaves it alone.
        (let [detached (jit/jit-env-check (mut session) repaired
                         "(module shapes) (defn unit [] (-> i64) 1)")
              widened (jit/jit-env-check (mut session) detached
                        "(module shapes) (defn area [(w i64) (h i64) (d i64)] (-> i64) (* w (* h d)))")]
          (assert (jit/jit-env-valid? widened))
          (assert (= (jit/jit-env-stale-count (mut session) widened) 1))
          (assert (stale? (mut session) widened "shapes.box-area"))
          (jit/jit-env-release! (mut session) widened)
          (jit/jit-env-release! (mut session) detached))
        (jit/jit-env-release! (mut session) repaired))

      ; Editing a caller and its callee together: the caller was part of the check.
      (let [together (jit/jit-env-check (mut session) base
                       "(module shapes) (defn area [(w i64)] (-> i64) (* w w))
                        (defn unit [] (-> i64) (area 1))")]
        (assert (jit/jit-env-valid? together))
        (assert (= (jit/jit-env-stale-count (mut session) together) 1))
        (assert (stale? (mut session) together "shapes.box-area"))
        (jit/jit-env-release! (mut session) together))
      (jit/jit-env-release! (mut session) narrowed))

    ; A struct whose shape changes stales the functions that mention it.
    (let [reshaped (jit/jit-env-check (mut session) base
                     "(module shapes) (defstruct Box [(w i64) (h i64) (d i64)])")]
      (assert (jit/jit-env-valid? reshaped))
      (assert (stale? (mut session) reshaped "shapes.box-area"))
      (assert (not (stale? (mut session) reshaped "shapes.unit")))
      (jit/jit-env-release! (mut session) reshaped))

    ; A constant is accepted once and not checked again, exactly like a function, so
    ; it has to be reported the same way when what its initializer calls changes.
    (let [measured (jit/jit-env-check (mut session) base
                     "(module shapes) (def plot i64 (area 3 4))")]
      (assert (jit/jit-env-valid? measured))
      (assert (= (jit/jit-env-stale-count (mut session) measured) 0))
      (let [quiet (jit/jit-env-check (mut session) measured
                    "(module shapes) (defn unrelated [(n i64)] (-> i64) (+ n 2))")]
        (assert (jit/jit-env-valid? quiet))
        (assert (not (stale? (mut session) quiet "shapes.plot")))
        (jit/jit-env-release! (mut session) quiet))
      (let [narrowed (jit/jit-env-check (mut session) measured
                       "(module shapes) (defn area [(w i64)] (-> i64) (* w w))")]
        (assert (jit/jit-env-valid? narrowed))
        (assert (stale? (mut session) narrowed "shapes.plot"))
        (jit/jit-env-release! (mut session) narrowed))
      (jit/jit-env-release! (mut session) measured))

    (jit/jit-env-release! (mut session) base)
    (assert (= (jit/jit-reset! (mut session)) 0))
    0))
