(module compiler.features.jit-env-stale)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)

; A check reports the accepted definitions that depend on what it changed. It
; does not recheck them, refuse the edit, or replace anything: a definition is
; never written twice. This client gives each version of a function its own
; name, marked `:jit/retain false`, and points a stable name at the current one
; with `defalias`. A version nothing reaches any more is released, so it stops
; being anyone's dependent.

(defn stale? [(session (ptr jit/JitSession)) (env jit/JitEnv) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (jit/jit-env-stale-count session env)]
      (when (= (jit/jit-env-stale-name session env i) name) (set! found true) 0))
    found))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-checked-session-new (a/malloc-allocator))
        base (jit/jit-env-check (mut session) (jit/jit-env-empty)
               "(module shapes)
                (import \"coil.jit.lifetime\")
                (defstruct Box1 [(w i64) (h i64)])
                (defalias Box Box1)
                (defn area--1 :jit/retain false [(w i64) (h i64)] (-> i64) (* w h))
                (defalias area area--1)
                (defn unit--1 :jit/retain false [] (-> i64) (area 1 1))
                (defalias unit unit--1)
                (defn twice [(n i64)] (-> i64) (* 2 (unit)))
                (defn box-area--1 :jit/retain false [(b Box)] (-> i64) (area (.w b) (.h b)))
                (defalias box-area box-area--1)
                (defn unrelated [(n i64)] (-> i64) (+ n 1))")]
    (assert (jit/jit-env-valid? base))
    (assert (= (jit/jit-env-stale-count (mut session) base) 0))

    ; Writing a definition again is refused.
    (let [again (jit/jit-env-check (mut session) base
                  "(module shapes) (defn unrelated [(n i64)] (-> i64) (+ n 2))")]
      (assert (not (jit/jit-env-valid? again))))

    ; A new definition nothing reaches changes what nobody read.
    (let [added (jit/jit-env-check (mut session) base
                  "(module shapes) (defn area--2 :jit/retain false [(w i64) (h i64)] (-> i64) (+ 0 (* w h)))")]
      (assert (jit/jit-env-valid? added))
      (assert (= (jit/jit-env-stale-count (mut session) added) 0))
      (jit/jit-env-release! (mut session) added))

    ; Pointing `area` at a definition with another signature: exactly the readers
    ; of `area` depend on that, not their callers and not the unrelated.
    (let [narrowed (jit/jit-env-check (mut session) base
                     "(module shapes) (defn area--2 :jit/retain false [(w i64)] (-> i64) (* w w))
                      (defalias area area--2)")]
      (assert (jit/jit-env-valid? narrowed))
      (assert (= (jit/jit-env-stale-count (mut session) narrowed) 2))
      (assert (stale? (mut session) narrowed "shapes.unit--1"))
      (assert (stale? (mut session) narrowed "shapes.box-area--1"))
      ; The base is untouched: nothing in it became stale.
      (assert (= (jit/jit-env-stale-count (mut session) base) 0))

      ; The client rechecks a dependent from its own source, as a new definition.
      ; It really is broken, and the compiler says why.
      (assert (= (jit/jit-env-definition-source (mut session) narrowed "shapes.unit--1")
                 "(defn unit--1 :jit/retain false [] (-> i64) (area 1 1))"))
      (let [rechecked (jit/jit-env-check (mut session) narrowed
                        "(module shapes) (defn unit--2 :jit/retain false [] (-> i64) (area 1 1))")]
        (assert (not (jit/jit-env-valid? rechecked)))
        (assert (> (len (jit/jit-diagnostic (mut session))) 0)))

      ; Repairing both and pointing their names at the repairs: what reads those
      ; names depends on that now.
      (let [repaired (jit/jit-env-check (mut session) narrowed
                       "(module shapes) (defn unit--2 :jit/retain false [] (-> i64) (area 1))
                        (defalias unit unit--2)
                        (defn box-area--2 :jit/retain false [(b Box)] (-> i64) (area (.w b)))
                        (defalias box-area box-area--2)")]
        (assert (jit/jit-env-valid? repaired))
        (assert (= (jit/jit-env-stale-count (mut session) repaired) 1))
        (assert (stale? (mut session) repaired "shapes.twice"))

        ; An old version nothing uses is released. `box-area--1` has no user left,
        ; so pointing `area` at yet another definition no longer reports it.
        ; `unit--1` stays: `twice` was compiled calling it, and has not been
        ; rechecked, so it still reads `area` through `unit--1`.
        (let [widened (jit/jit-env-check (mut session) repaired
                        "(module shapes) (defn area--3 :jit/retain false [(w i64) (h i64) (d i64)] (-> i64) (* w (* h d)))
                         (defalias area area--3)")]
          (assert (jit/jit-env-valid? widened))
          (assert (= (jit/jit-env-stale-count (mut session) widened) 3))
          (assert (stale? (mut session) widened "shapes.unit--1"))
          (assert (stale? (mut session) widened "shapes.unit--2"))
          (assert (stale? (mut session) widened "shapes.box-area--2"))
          (assert (not (stale? (mut session) widened "shapes.box-area--1")))
          (jit/jit-env-release! (mut session) widened))
        (jit/jit-env-release! (mut session) repaired))
      (jit/jit-env-release! (mut session) narrowed))

    ; Pointing `Box` at another struct: what spells `Box` depends on it.
    (let [reshaped (jit/jit-env-check (mut session) base
                     "(module shapes) (defstruct Box2 [(w i64) (h i64) (d i64)]) (defalias Box Box2)")]
      (assert (jit/jit-env-valid? reshaped))
      (assert (= (jit/jit-env-stale-count (mut session) reshaped) 1))
      (assert (stale? (mut session) reshaped "shapes.box-area--1"))
      (jit/jit-env-release! (mut session) reshaped))

    ; A constant is accepted once and not checked again, like a function, so it is
    ; reported the same way when what its initializer calls is pointed elsewhere.
    (let [measured (jit/jit-env-check (mut session) base
                     "(module shapes) (def plot i64 (area 3 4))")]
      (assert (jit/jit-env-valid? measured))
      (assert (= (jit/jit-env-stale-count (mut session) measured) 0))
      (let [quiet (jit/jit-env-check (mut session) measured
                    "(module shapes) (defn other [(n i64)] (-> i64) (+ n 2))")]
        (assert (jit/jit-env-valid? quiet))
        (assert (not (stale? (mut session) quiet "shapes.plot")))
        (jit/jit-env-release! (mut session) quiet))
      (let [narrowed (jit/jit-env-check (mut session) measured
                       "(module shapes) (defn area--2 :jit/retain false [(w i64)] (-> i64) (* w w))
                        (defalias area area--2)")]
        (assert (jit/jit-env-valid? narrowed))
        (assert (stale? (mut session) narrowed "shapes.plot"))
        (jit/jit-env-release! (mut session) narrowed))
      (jit/jit-env-release! (mut session) measured))

    (jit/jit-env-release! (mut session) base)
    (assert (= (jit/jit-reset! (mut session)) 0))
    0))
