(module compiler.features.jit-checked-baseline)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(import "coil.compiler.live_ir" :as ir)
(import "coil.primitive" :as p)
(import "coil.arraylist" :as al)
(import "coil.scratch" :as scratch)

(defn main [] (-> i64)
  (let [arena (p/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init-with-cap arena (a/malloc-allocator) 4096)
    (let [allocator (scratch/scratch-allocator arena)
          (mut session) (jit/jit-checked-session-new allocator)]
      (assert (= (jit/jit-prepare! (mut session)
        "(module checked) (import \"coil.primitive\" :as p)
         (defstruct Rect [(width i64)])
         (defn read [(r Rect)] (-> i64) (.width r))
         (defn make [] (-> Rect) (Rect :width 7))
         (defn inner [(x i64)] (-> i64) (p/iadd x 1))
         (defn outer [(x i64)] (-> i64) (inner x))") 0))
      (for [i 0 3]
        (let [name (if (= i 0) "checked.read" (if (= i 1) "checked.make" "checked.outer"))]
          (match (jit/jit-live-function allocator (mut session) name)
            (None [] (assert false))
            (Some [artifact]
              (let [(mut function) artifact]
                (assert (ir/verify (mut function)))
                (when (> i 0)
                  (let [(mut found) false]
                    (for [j 0 (al/al-len (.instructions function))]
                      (let [instruction (al/al-get (.instructions function) j)]
                        (when (= (.op instruction) (if (= i 1) 12 13)) (set! found true))))
                    (assert (load found)))))))))
      (assert (= (jit/jit-publish-prepared! (mut session)) 0))
      (jit/jit-finalize-published! (mut session))
      (assert (= (jit/jit-generation-count (mut session)) 0))
      (assert (= (jit/jit-prepare! (mut session)
        "(module checked) (defstruct Rect [(height f64) (width i64)])") 0))
      (match (jit/jit-live-function allocator (mut session) "checked.read")
        (None [] (assert false))
        (Some [artifact]
          (let [(mut function) artifact]
            (jit/jit-abort-prepared! (mut session))
            (assert (ir/verify (mut function))))))
      (assert (= (jit/jit-prepare! (mut session)
        "(module checked) (defstruct Rect [(width i64) (depth i64)])") 0))
      (assert (= (jit/jit-publish-prepared! (mut session)) 0))
      (jit/jit-finalize-published! (mut session))
      (assert (= (jit/jit-generation-count (mut session)) 0))
      (jit/jit-reset! (mut session)))
    (scratch/scratch-close! arena)) 0)
