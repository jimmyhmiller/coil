(module ownership_named_constructor_initialization)
(import "coil.primitive" :as primitive)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (drops) (+ (load (drops)) 1))))

(defstruct Wrapper [(owner Owner)])

; Returning an owning aggregate constructed with named fields moves the
; compiler's constructor temporary exactly once. The temporary must not be
; treated as a second use while the return value crosses the function boundary.
(defn make-wrapper [(value i64)] (-> Wrapper)
  (Wrapper :owner (Owner :value value)))

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [wrapper (make-wrapper 42)]
    (do))
  ; Constructing the field initializes unoccupied storage. Only the final live
  ; Owner is destroyed; there is no zero-filled predecessor to drop.
  (load (drops)))
