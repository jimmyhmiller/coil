(module ownership_named_constructor_initialization)
(import "coil.primitive" :as primitive)

(defn drops [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (store! (drops) (+ (load (drops)) 1))))

(defstruct Wrapper [(owner Owner)])

(defn main [] (-> i64)
  (store! (drops) 0)
  (let [wrapper (Wrapper :owner (Owner :value 42))]
    (do))
  ; Constructing the field initializes unoccupied storage. Only the final live
  ; Owner is destroyed; there is no zero-filled predecessor to drop.
  (load (drops)))
