(module compiler.features.host-environment)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.var" :use [Var])
(import "coil.jit" :as jit)
(import "compiler.features.host-environment-app" :as app)
(import "compiler.features.host-environment-embed" :use [embed-environment])

; Adds `environment` and `helper-only` to this module at build time, each
; returning a description embedded as a string.
(transform embed-environment)

;;; A program that describes one of its modules to a JIT session running inside
;;; it. At build time a transform (host_environment_embed.coil) asks the compiler
;;; for the module's declarations, keeps and exports its functions and `def`s, and
;;; embeds the description in this module as a string. At run time a session takes
;;; that string as its environment: code it compiles calls the program's own
;;; functions, reads and writes the program's own `def`, and uses its types,
;;; generic and macro.

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        adopted (jit/jit-session-set-environment! (mut session) (environment))]
    (cond
      (!= adopted 0) (do (println "environment {}: {}" adopted (jit/jit-diagnostic (mut session))) 1)
      ; The session calls the program's own functions and changes its own `def`.
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module compiler.features.host-environment-app)
             (defn session-fn [] (-> i64)
               (bump!)
               (+ (helper (twice 3)) (+ (area (Point :x 2 :y 3)) (+ (id (get counter)) (assist 0)))))"
            "(if (= (compiler.features.host-environment-app.session-fn) 68) 0 1)") 0) 2
      (!= (get app/counter) 42) 3
      ; A second session: once started, a session takes no environment.
      (!= (jit/jit-session-set-environment! (mut session) (environment)) -1) 4
      :else
        (let [(mut other) (jit/jit-session-new (malloc-allocator))
              ; A subset: only `helper` is declared.
              subset (jit/jit-session-set-environment! (mut other) (helper-only))
              calls (jit/jit-compile-with-entry! (mut other)
                      "(module compiler.features.host-environment-app) (defn plus-one [] (-> i64) (helper 1))"
                      "(if (= (compiler.features.host-environment-app.plus-one) 8) 0 1)")
              ; ... so `area` is not there.
              missing (jit/jit-compile! (mut other)
                        "(module compiler.features.host-environment-app) (defn no-area [] (-> i64) (area (Point :x 1 :y 1)))")]
          (jit/jit-reset! (mut other))
          (jit/jit-reset! (mut session))
          (cond (!= subset 0) 5
                (!= calls 0) 6
                (= missing 0) 7
                :else 0)))))
