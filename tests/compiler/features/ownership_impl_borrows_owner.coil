(module ownership-impl-borrows-owner)

; A trait that takes `Self` by value lets an implementation consume an owner. An
; implementation that only reads it may borrow it instead, spelling the parameter
; `(ref T)`: then `len`, `iter` and their kin leave the caller's owner alive, at a
; concrete call and through a generic bound alike.

(defstruct Bag [(n i64)])

(defstruct BagIter [(at i64) (end i64)])

(impl Drop Bag
  (drop [(self (mut Bag))] (-> void)
    (println "drop bag {}" (.n self))
    0))

(impl Len Bag
  (len [(b (ref Bag))] (-> i64) (.n b)))

(impl Iterator BagIter
  (next [(it (mut BagIter))] (-> (Option i64))
    (if (< (.at it) (.end it))
        (let [v (.at it)]
          (set! (.at it) (+ v 1))
          (Some v))
        (None))))

(impl Iterable Bag
  (iter [(b (ref Bag))] (-> BagIter) (BagIter :at 0 :end (.n b))))

(defn twice [(C Len)] [(c C)] (-> i64) (+ (len c) (len c)))

(defn main [] (-> i64)
  (let [(mut b) (Bag :n 3)]
    (println "len {}" (len b))
    (println "len again {}" (len b))
    (println "len mut {}" (len (mut b)))
    (for x (iter b) (println "item {}" x))
    (for x (iter (mut b)) (println "item mut {}" x))
    (println "still here {}" (len b))
    (println "twice {}" (twice b))
    (println "end of scope"))
  0)
