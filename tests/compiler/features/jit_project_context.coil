(module jit-project-context)
(import "coil.primitive" :as p)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)
(extern getenv :cc c [(ptr i8)] (-> (ptr i8)))
(defn main [] (-> i64)
  (let [(mut compiler) (jit/jit-session-new (a/malloc-allocator))
        roots (getenv c"COIL_NAMESPACE_ROOTS")]
    (assert (= (jit/jit-session-load-project! (mut compiler)) 0))
    (assert (= roots (getenv c"COIL_NAMESPACE_ROOTS")))
    (assert (= (jit/jit-compile-with-entry! (mut compiler)
      "(module session) (import \"project-dependency.values\" :as dependency)"
      "(if (= (dependency/answer) 42) 0 1)") 0))
    (assert (= (jit/jit-session-load-project! (mut compiler)) -1))
    (assert (= (jit/jit-reset! (mut compiler)) 0))
    0))
