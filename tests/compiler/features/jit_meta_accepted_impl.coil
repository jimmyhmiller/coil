(module compiler.features.jit-meta-accepted-impl)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; A metaprogram a submission defines is compiled from its own closure. A prelude
;; impl method it selects -- string `=` -- must come from the session's accepted
;; functions whether the session is new or already holds an empty submission.
(defn source [] (-> (slice u8))
  "(import \"coil.primitive\" :as p)
   (defn check [] (-> Code) (if (= (p/code-str `x) \"x\") `0 `1))")

(defn main [] (-> i64)
  (let [(mut fresh) (jit/jit-session-new (malloc-allocator))
        (mut later) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut fresh) (source) "(check)") 0) 1
      (!= (jit/jit-compile! (mut later) "") 0) 2
      (!= (jit/jit-compile-with-entry! (mut later) (source) "(check)") 0) 3
      :else 0)))
