(module dynamic.stack)
(import "coil.primitive" :as p)

(extern memset :cc c [(ptr u8) i32 u64] (-> (ptr u8)))

(defn disturb [] (-> i64)
  (let [bytes (p/alloc-stack (array u8 1024))]
    (memset (cast (ptr u8) bytes) 99 1024)
    (cast i64 (load (cast (ptr u8) bytes)))))

(defn exercise [(count u64) (choose bool)] (-> i64)
  (block :done
           (let [first (p/alloc-stack-bytes count)
                 second (p/alloc-stack-bytes count)
                 slots (p/alloc-stack (array (ptr u8) 4))
                 branch
                   (if choose
                       (p/alloc-stack-bytes count)
                       (p/alloc-stack-bytes (+ count (cast u64 1))))]
             (if (= (cast u64 first) (cast u64 second)) (break :done 1) 0)
             (if (!= (p/iand (cast i64 first) 15) 0) (break :done 2) 0)
             (if (!= (p/iand (cast i64 second) 15) 0) (break :done 3) 0)
             (store! first (cast u8 21))
             (store! second (cast u8 22))
             (store! branch (cast u8 23))
             (for [i 0 4]
               (let [bytes (p/alloc-stack-bytes (+ count (cast u64 i)))]
                 (store! (index (cast (ptr (ptr u8)) slots) i) bytes)
                 (store! bytes (cast u8 (+ i 30))))
               0)
             (if (!= (disturb) 99) (break :done 4) 0)
             (if (!= (load first) (cast u8 21)) (break :done 5) 0)
             (if (!= (load second) (cast u8 22)) (break :done 6) 0)
             (if (!= (load branch) (cast u8 23)) (break :done 7) 0)
             (for [i 0 4]
               (let [bytes (load (index (cast (ptr (ptr u8)) slots) i))]
                 (if (!= (load bytes) (cast u8 (+ i 30))) (break :done 8) 0)
                 (if (!= (p/iand (cast i64 bytes) 15) 0) (break :done 9) 0))
               0)
             0)))

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (block :done
           (let [n (+ (cast u64 32) (cast u64 argc))]
             ;; Repeated calls must release their frames: these allocations total over
             ;; 20 MiB if mistakenly retained by the caller across function returns.
             (for [i 0 64]
               (let [result (exercise (+ (cast u64 65536) n) false)]
                 (if (!= result 0) (break :done result) 0))
               0)
             (+ (exercise n true) (exercise n false)))))
