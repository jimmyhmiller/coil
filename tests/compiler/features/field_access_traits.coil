(module test.field-access-traits)
(import "coil.primitive" :as p)
(import "coil.assert" :use *)

;; A real field is read, written and borrowed exactly as before. Only a name the
;; type does not have goes to an impl of FieldGet/FieldSet/FieldPlace.

(defstruct Celsius [(degrees f64)])

;; A computed property: read and write.
(impl FieldGet (Field Celsius :fahrenheit)
  (get-field [(self (Field Celsius :fahrenheit)) (target Celsius)] (-> f64)
    (+ 32.0 (* 1.8 (.degrees target)))))
(impl FieldSet (Field Celsius :fahrenheit)
  (set-field! [(self (Field Celsius :fahrenheit)) (target (mut Celsius)) (value f64)] (-> i64)
    (set! (.degrees target) (/ (- value 32.0) 1.8))
    0))

;; A handle that forwards to storage it points at, including a nested place.
(defstruct Point [(x i64) (y i64)])
(defstruct Rect [(origin Point) (w i64)])
(defstruct Handle [(obj (ptr Rect))])

(impl FieldGet (Field Handle :w)
  (get-field [(self (Field Handle :w)) (target Handle)] (-> i64) (.w (.obj target))))
(impl FieldSet (Field Handle :w)
  (set-field! [(self (Field Handle :w)) (target (mut Handle)) (value i64)] (-> i64)
    (set! (.w (.obj target)) value)
    0))
(impl FieldPlace (Field Handle :origin)
  (field-place [(self (Field Handle :origin)) (target Handle)] (-> (ptr Point))
    (field (.obj target) origin)))

;; One impl for every name on a type: N is an ordinary Keyword value in the body.
(defstruct Bag [(base i64)])
(impl [(const N Keyword)] FieldGet (Field Bag N)
  (get-field [(self (Field Bag N)) (target Bag)] (-> i64)
    (match N (KeywordValue [name] (+ (.base target) (len name))))))

;; A concrete field beside the catch-all is the more specific impl.
(impl FieldGet (Field Bag :id)
  (get-field [(self (Field Bag :id)) (target Bag)] (-> i64) 99))

(defn bump [(v (mut i64))] (-> i64) (store! v (+ (load v) 1)) 0)
(defn read-nested [(h Handle)] (-> i64) (.x (.origin h)))

(defn main [] (-> i64)
  (let [(mut c) (Celsius :degrees 100.0)
        (mut r) (Rect :origin (Point :x 5 :y 6) :w 3)
        (mut h) (Handle :obj (p/alloc-stack Rect))
        (mut b) (Bag :base 10)]
    (store! (.obj h) (load (mut r)))

    ;; real fields: unchanged
    (assert-eq (cast i64 (.degrees c)) 100)
    (assert-eq (.w r) 3)
    (set! (.w r) 4)
    (assert-eq (.w r) 4)

    ;; computed property
    (assert-eq (cast i64 (.fahrenheit c)) 212)
    (set! (.fahrenheit c) 32.0)
    (assert-eq (cast i64 (.degrees c)) 0)
    (set! (.degrees c) 10.0)
    (assert-eq (cast i64 (.fahrenheit c)) 50)

    ;; handle: read, write, and a place that chains, writes and borrows
    (assert-eq (.w h) 3)
    (set! (.w h) 12)
    (assert-eq (.w h) 12)
    (assert-eq (.x (.origin h)) 5)
    (assert-eq (read-nested h) 5)
    (set! (.x (mut (.origin h))) 7)
    (assert-eq (.x (.origin h)) 7)
    (bump (mut (.x (mut (.origin h)))))
    (assert-eq (.x (.origin h)) 8)
    ;; a field with only a place: the write goes through it
    (set! (.origin h) (Point :x 1 :y 2))
    (assert-eq (.x (.origin h)) 1)
    (assert-eq (.y (.origin h)) 2)

    ;; one impl for every name, and specificity
    (assert-eq (.xy b) 12)
    (assert-eq (.longer b) 16)
    (assert-eq (.id b) 99)
    0))
