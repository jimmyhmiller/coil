(module process_facade)
(import "coil.process" :as process)

; Compile-time contract: a Python-style facade can expose child-process types
; while retaining its own current-process operations.
(defn child-id [(child (ptr process/Child))] (-> i64)
  (cast i64 (.pid child)))

(defn main [] (-> i64)
  (if (> (process/id) 0) 0 1))
