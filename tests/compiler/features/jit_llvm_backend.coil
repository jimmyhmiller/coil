(module compiler.features.jit-llvm-backend)
(import "coil.alloc" :use [malloc-allocator abort])
(import "coil.time" :use [monotonic-now-ms])
(import "coil.jit" :as jit)

; The LLVM backend is selectable on every supported host, its optimization level
; survives a reset, and options the host cannot honour are refused up front.

(def loop-source
  "(module opt.loop)
   (defn spin [(n i64)] (-> i64)
     (let [(mut acc) 0]
       (for i (range 0 n) (set! acc (+ acc (^ i (& i 255)))))
       acc))
   (export-c [spin :as \"spin\"])")

(defn now [] (-> i64)
  (match (monotonic-now-ms) (Ok [ms] ms) (Err [_] 0)))

(defn llvm-session [(level i64)] (-> jit/JitSession)
  (let [defaults (jit/jit-default-options)
        options (jit/JitOptions :toolchain (.toolchain defaults) :backend (jit/Llvm) :opt-level level)]
    (match (jit/jit-session-new-with-options (malloc-allocator) options)
      (Ok [session] session)
      (Err [_] (abort) (jit/jit-session-new (malloc-allocator))))))

; Milliseconds for one call of `spin` over `n` iterations, or -1 on failure.
(defn time-spin [(session (mut jit/JitSession)) (n i64) (expected i64)] (-> i64)
  (if (!= (jit/jit-compile! session loop-source) 0)
      -1
      (let [spin (cast (fnptr c [i64] i64) (jit/jit-symbol-address session "spin"))
            start (now)
            result (spin n)
            stop (now)]
        (if (= result expected) (- stop start) -1))))

; Refused, and the error prints through its derived Debug impl.
(defn refused? [(options jit/JitOptions)] (-> bool)
  (match (jit/jit-session-new-with-options (malloc-allocator) options)
    (Ok [_] false)
    (Err [error] (println "refused: {:?}" error) true)))

(defn main [] (-> i64)
  (let [n 200000000
        expected (let [(mut acc) 0]
                   (for i (range 0 n) (set! acc (+ acc (^ i (& i 255)))))
                   acc)
        (mut slow) (llvm-session 0)
        (mut fast) (llvm-session 2)
        o0 (time-spin (mut slow) n expected)
        o2 (time-spin (mut fast) n expected)
        defaults (jit/jit-default-options)]
    (cond (!= (jit/jit-session-backend (mut fast)) (jit/Llvm)) 1
          (!= (jit/jit-backend-name (jit/jit-session-backend (mut fast))) "llvm") 1
          (or (< o0 0) (< o2 0)) 2
          ; O2 vectorizes or folds the loop; O0 keeps every operation. The margin
          ; is several times wider than 2x, which leaves room for a loaded machine.
          (> (* o2 2) o0) 3
          ; The level lives in the session's runner, so a reset keeps it.
          (!= (jit/jit-reset! (mut fast)) 0) 4
          (let [again (time-spin (mut fast) n expected)] (or (< again 0) (> (* again 2) o0))) 5
          (not (refused? (jit/JitOptions :toolchain (.toolchain defaults) :backend (jit/Llvm) :opt-level 4))) 6
          (not (refused? (jit/JitOptions :toolchain (.toolchain defaults) :backend (jit/Llvm) :opt-level -1))) 7
          ; The native backend has no optimization levels (and exists only on macOS arm64).
          (not (refused? (jit/JitOptions :toolchain (.toolchain defaults) :backend (jit/Native) :opt-level 2))) 8
          (!= (jit/jit-session-free! (mut slow)) 0) 9
          (!= (jit/jit-session-free! (mut fast)) 0) 10
          :else 0)))
