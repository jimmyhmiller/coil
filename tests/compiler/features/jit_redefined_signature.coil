(module compiler.features.jit-redefined-signature)
(import "coil.alloc" :as a)
(import "coil.jit" :as jit)

; A function redefined with a different signature is checked against from then on.
; The session used to give the new definition its predecessor's signature, so a call
; with the old arity was accepted and a call with the new one refused.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-checked-session-new (a/malloc-allocator))]
    (assert (= (jit/jit-prepare! (mut session)
                 "(module shapes) (defn area [(w i64) (h i64)] (-> i64) (* w h))") 0))
    (assert (= (jit/jit-commit-prepared! (mut session)) 0))
    (assert (= (jit/jit-prepare! (mut session)
                 "(module shapes) (defn area [(w i64)] (-> i64) (* w w))") 0))
    (assert (= (jit/jit-commit-prepared! (mut session)) 0))
    (assert (!= (jit/jit-prepare! (mut session)
                  "(module shapes) (defn old-arity [] (-> i64) (area 2 2))") 0))
    (assert (= (jit/jit-prepare! (mut session)
                 "(module shapes) (defn new-arity [] (-> i64) (area 2))") 0))
    (assert (= (jit/jit-commit-prepared! (mut session)) 0))
    ; Redefining it back is a redefinition like any other.
    (assert (= (jit/jit-prepare! (mut session)
                 "(module shapes) (defn area [(w i64) (h i64)] (-> i64) (* w h))") 0))
    (assert (= (jit/jit-commit-prepared! (mut session)) 0))
    (assert (= (jit/jit-prepare! (mut session)
                 "(module shapes) (defn again [] (-> i64) (area 2 2))") 0))
    (jit/jit-abort-prepared! (mut session))
    0))
