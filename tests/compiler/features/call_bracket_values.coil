; A bracket right after a call head reads as explicit type arguments only when
; its elements name types; locals, constructors and calls make it an array.
(module call-bracket-values)
(import "coil.primitive" :as primitive)

(defsum Op (Plus) (Minus))
(defsum Tok (B [(op Op)]) (N [(n i64)]))
(defstruct Pt [(x i64) (y i64)])

(defn count [(xs (slice Tok))] (-> i64) (len xs))

(defn total [(xs (slice i64))] (-> i64)
  (let [(mut t) 0]
    (for x xs (set! t (+ t x)))
    t))

(defn zero [T] [] (-> T) (primitive/zeroed T))

(defn main [] (-> i64)
  (let [a 1
        b 2]
    (println "{} {} {}" (count [(B (Plus))]) (count [(N a) (N 5)]) (total [a b]))
    (for t [(N 3) (B (Minus))]
      (match t (N [n] (println "n {}" n)) (B [_] (println "b"))))
    ; type arguments still read as types
    (println "{} {}" (zero [i64]) (.x (zero [Pt]))))
  0)
