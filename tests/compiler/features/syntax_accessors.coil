(module test.syntax-accessors)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use [Sexp SexpKind KInt KFloat KSym KKw KStr KCStr KList KVec KView mk-sexp])
(import "coil.compiler.parser" :use [sx-info sx-tag sx-ival sx-sval sx-items])

(defn check [(kind SexpKind)] (-> i64)
  (let [node (mk-sexp kind -1 -1) expected (sx-info node)]
    (assert-eq (sx-tag node) (.tag expected))
    (assert-eq (sx-ival node) (.ival expected))
    (assert-eq (sx-sval node) (.sval expected))
    (assert-eq (p/cast i64 (sx-items node)) (p/cast i64 (.items expected)))
    0))

(defn main [] (-> i64)
  (let [a (malloc-allocator) items (box! a (ArrayList Sexp) (al-new [Sexp] a))]
    (push! items (mk-sexp (KInt 7) -1 -1))
    (check (KInt 42))
    (check (KFloat 4607182418800017408))
    (check (KSym "symbol"))
    (check (KKw "keyword"))
    (check (KStr "text"))
    (check (KCStr "cstring"))
    (check (KList items))
    (check (KVec items))
    (check (KView items 0 1))
    0))
