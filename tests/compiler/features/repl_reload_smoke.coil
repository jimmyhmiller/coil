(module replsession)

(import "coil.primitive" :as primitive)
(import "coil.var")
(import "coil.jit.reload")

(defn twice [(x i64)] (-> i64)
  (* x 2))

(defn twice [(x i64)] (-> i64)
  (* x 3))

; Internal entrypoints keep their ordinary function identity. Calls in their
; bodies still lower through the reloadable binding.
(defn __repl_eval [] (-> i64)
  (twice 10))

(defn shadow [(twice i64)] (-> i64)
  twice)

(defn main [] (-> i64)
  (let [f twice]
    (- (+ (__repl_eval) (+ (f 10) (shadow 7))) 67)))
