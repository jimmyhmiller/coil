(module compiler.features.jit-scratch-footprint)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

;; macOS only: a first compile closes ~180 MB of scratch segments. They must go
;; back to the system instead of staying dirty in malloc's large-block cache,
;; which used to leave the process ~220 MB resident after a one-line compile.
(extern getpid :cc c [] (-> i32))
(extern proc_pid_rusage :cc c [i32 i32 (ptr u8)] (-> i32))

(defn footprint-mb [] (-> i64)
  (let [(mut info) (: (zeroed (array u8 512)) (array u8 512))]
    ; RUSAGE_INFO_V2; ri_phys_footprint is the u64 at byte 72.
    (proc_pid_rusage (getpid) 2 (cast (ptr u8) (mut info)))
    (/ (load (cast (ptr i64) (index (cast (ptr u8) (mut info)) 72))) 1048576)))

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile! (mut session) "(module footprint.w) (defn f [] (-> i64) 1)") 0) 1
      (> (footprint-mb) 100) (do (println "footprint {} MB" (footprint-mb)) 2)
      :else 0)))
