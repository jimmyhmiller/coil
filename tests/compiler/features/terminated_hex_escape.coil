(module terminated-hex-escape)
(import "coil.assert" :use *)
(import "coil.slice" :use *)

(defn main [] (-> i64)
  ; NUL, U+03BB LAMBDA, and U+1F603 SMILING FACE encode to 1 + 2 + 4 bytes.
  (let [s "\x0;\x3bb;\x1f603;"]
    (assert-eq (slice-len [u8] s) 7)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 0)) 0)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 1)) 206)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 2)) 187)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 3)) 240)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 4)) 159)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 5)) 152)
    (assert-eq (primitive/cast i64 (slice-get [u8] s 6)) 131))
  0)
