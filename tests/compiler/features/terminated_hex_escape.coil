(module terminated-hex-escape)
(import "coil.assert" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)

(defn main [] (-> i64)
  (let [text "\x0;\x3bb;\x1f603;"
        bytes c"\x00;\x7f;"]
    (assert-eq (slice-len [u8] text) 7)
    (assert-eq (primitive/cast i64 (slice-get [u8] text 0)) 0)
    (assert-eq (primitive/cast i64 (slice-get [u8] text 1)) 206)
    (assert-eq (primitive/cast i64 (slice-get [u8] text 2)) 187)
    (assert-eq (primitive/cast i64 (slice-get [u8] text 3)) 240)
    (assert-eq (primitive/cast i64 (slice-get [u8] text 6)) 131)
    (assert-eq (primitive/cast i64 (load bytes)) 0)
    (assert-eq (primitive/cast i64 (load (primitive/index bytes 1))) 127))
  0)
