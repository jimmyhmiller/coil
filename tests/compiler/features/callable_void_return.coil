(module callable-void-return)
(import "coil.primitive" :as p)
(import "coil.var" :as var)
(defn write-value [(target (ptr i64))] (-> void) (store! target 42))
(def callback (var/var-static (fnptr c [(ptr i64)] void) (p/fnptr-of write-value)))
(defn invoke [R] [(f (fnptr c [(ptr i64)] R)) (target (ptr i64))] (-> R)
  (p/call-ptr f target))
(defn main [] (-> i32)
  (let [target (p/alloc-stack i64)]
    (store! target 0)
    (callback target)
    (assert (= (load target) 42))
    (store! target 0)
    (invoke (p/fnptr-of write-value) target)
    (assert (= (load target) 42)))
  0)
