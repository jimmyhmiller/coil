(module compiler.features.retained-context)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.reader" :use [next-node-id])
(import "coil.compiler.ast" :use [Type TStruct])
(import "coil.compiler.comptime" :use [type-map-record type-map-lookup])
(import "coil.compiler.loader" :use [VirtualSource])
(import "coil.compiler.unit_state" :use [unit-resource!])
(import "coil.compiler.driver" :as driver)

(defn release-marker [(raw (ptr i8))] (-> i64)
  (let [count (p/cast (ptr i64) raw)]
    (store! count (+ (load count) 1))
    0))

(defn retained-type? [(id i64) (expected (slice u8))] (-> bool)
  (match (type-map-lookup id)
    (Some [ty] (match ty (TStruct [name] (= name expected)) (_ false)))
    (None [] false)))

; The same numeric syntax identity belongs to different type universes. Suspend
; under one caller and resume under another, including a nested retained unit.
; Closing the nested unit must release only its resources and restore the outer
; type map; closing the outer must restore the original caller's map.
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        config (p/alloc-stack driver/CompilationUnitConfig)
        first (p/alloc-stack driver/CompilationUnitSession)
        second (p/alloc-stack driver/CompilationUnitSession)
        releases (p/alloc-stack i64)
        none (p/cast (ptr (ArrayList VirtualSource)) 0)
        outer-id (next-node-id)]
    (store! releases 0)
    (type-map-record outer-id (TStruct "outer.Type"))
    (store! config (driver/compilation-unit-config a))
    (driver/compilation-unit-enter! first config none false)
    (let [first-id (next-node-id)]
      (unit-resource! (p/cast (ptr i8) releases) (p/fnptr-of release-marker))
      (type-map-record first-id (TStruct "first.Type"))
      (driver/compilation-unit-suspend! first)
      (if (not (retained-type? outer-id "outer.Type"))
          1
          (do
            (driver/compilation-unit-enter! second config none false)
            (let [second-id (next-node-id)]
              (unit-resource! (p/cast (ptr i8) releases)
                              (p/fnptr-of release-marker))
              (type-map-record second-id (TStruct "second.Type"))
              (driver/compilation-unit-suspend! second)
              (driver/compilation-unit-resume! first)
              (if (or (!= (load releases) 0)
                      (not (retained-type? first-id "first.Type")))
                  2
                  (do
                    (driver/compilation-unit-resume! second)
                    (if (not (retained-type? second-id "second.Type"))
                        3
                        (do
                          (driver/compilation-unit-leave! second)
                          (if (or (!= (load releases) 1)
                                  (not (retained-type? first-id "first.Type")))
                              4
                              (do
                                (driver/compilation-unit-leave! first)
                                (if (and (= (load releases) 2)
                                         (retained-type? outer-id "outer.Type"))
                                    0
                                    5)))))))))))))
