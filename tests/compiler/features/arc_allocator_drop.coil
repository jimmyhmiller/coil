(module arc_allocator_drop_test)
(import "coil.arc" :as arc)

(defstruct Payload [(answer i64)])

(defn main [] (-> i64)
  (match (arc/arc-new (Payload :answer 42))
    (None [] 1)
    (Some [owner]
          (let [other (clone owner)
                weak (arc/arc-downgrade owner)]
            (match (arc/weak-upgrade weak)
              (None [] 2)
              (Some [third]
                    (.answer (arc/arc-borrow third))))))))
