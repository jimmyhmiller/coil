(module transparent_arc_plain_collections)
(import "coil.arraylist" :use *)

; This file is intentionally ordinary source. Compile it with
; `--use coil.arc.auto`; ownership and allocator spellings below are forbidden.
(defstruct Person
  [(id i64)
   (scores (ArrayList i64))])

(defn score-total [(person Person)] (-> i64)
  (+ (al-get [i64] (.scores person) 0)
     (al-get [i64] (.scores person) 1)))

(defn main [] (-> i64)
  (let [(mut scores) (al-new [i64])]
    (al-push! [i64] (mut scores) 19)
    (al-push! [i64] (mut scores) 23)
    (let [person (Person :id 7 :scores scores)]
      (score-total person))))
