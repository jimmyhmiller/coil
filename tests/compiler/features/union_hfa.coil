(module feature.union-hfa)
(import "coil.primitive" :as primitive)

(defstruct Floats :layout explicit :size 12 :align 4
  [(scalar f32 :at 0) (lanes (array f32 3) :at 0)])

(defstruct Nested [(values Floats) (tail f32)])

(defn echo [(value Floats)] (-> Floats)
  value)

(defn echo-nested [(value Nested)] (-> Nested)
  value)

(export-c [echo :as "coil_union_echo"] [echo-nested :as "coil_union_nested"])

(extern native-union-check :as "native_union_check" :cc c [] (-> i64))

(defn main [] (-> i64)
  (native-union-check))
