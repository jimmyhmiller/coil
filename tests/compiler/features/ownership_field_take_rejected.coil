(module ownership_field_take_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)))

(defstruct Pair [(a Owner) (b Owner)])

(defn consume [(o Owner)] (-> i64) (.value o))

; `take!` leaves its place uninitialized, which only a whole binding can record.
(defn main [] (-> i64)
  (let [(mut p) (Pair :a (Owner :value 1) :b (Owner :value 2))]
    (consume (take! (mut (.a p))))))
