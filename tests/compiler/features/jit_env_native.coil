(module compiler.features.jit-env-native)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; A session that runs code can hold a checked state as a value. A client checks
; an edit against the running program's state, reads what it would stale,
; rechecks a dependent against the candidate, and publishes nothing. The
; running program keeps its code until the client submits for real. Nothing is
; ever replaced: the client gives a new version its own name.

(def BASE "(module p)
(defn helper--1 [(n i64)] (-> i64) (+ n 1))
(defalias helper helper--1)
(defn calls-helper [] (-> i64) (helper 1))
(defn unrelated [] (-> i64) 7)")

(defn stale? [(s (ptr jit/JitSession)) (e jit/JitEnv) (name (slice u8))] (-> bool)
  (let [(mut found) false]
    (for [i 0 (jit/jit-env-stale-count s e)]
      (when (= (jit/jit-env-stale-name s e i) name) (set! found true) 0))
    found))

(defn main [] (-> i64)
  (let [(mut s) (jit/jit-session-new (malloc-allocator))]
    (assert (= (jit/jit-compile-with-entry! (mut s) BASE "(- (calls-helper) 2)") 0))
    (let [current (jit/jit-env-current (mut s))
          edit (jit/jit-env-check (mut s) current
                 "(module p) (defn helper--2 [(n i64) (m i64)] (-> i64) (+ n m)) (defalias helper helper--2)")]
      (assert (jit/jit-env-valid? edit))
      (assert (= (jit/jit-env-stale-count (mut s) edit) 1))
      (assert (stale? (mut s) edit "p.calls-helper"))
      ; The dependent, rechecked against the candidate as a new definition, no
      ; longer checks. The candidate is still held, unchanged.
      (assert (= (jit/jit-env-definition-source (mut s) edit "p.calls-helper")
                 "(defn calls-helper [] (-> i64) (helper 1))"))
      (let [again (jit/jit-env-check (mut s) edit "(module p) (defn calls-helper--2 [] (-> i64) (helper 1))")]
        (assert (not (jit/jit-env-valid? again))))
      (assert (jit/jit-env-valid? edit))
      ; A repaired version checks, and leaves nothing stale.
      (let [repaired (jit/jit-env-check (mut s) edit "(module p) (defn calls-helper--2 [] (-> i64) (helper 1 1))")]
        (assert (jit/jit-env-valid? repaired))
        (assert (= (jit/jit-env-stale-count (mut s) repaired) 0))
        (jit/jit-env-release! (mut s) repaired))
      ; None of it was published: the running program still has its old code.
      (assert (= (jit/jit-compile-with-entry! (mut s) "(module p)" "(- (calls-helper) 2)") 0))
      (jit/jit-env-release! (mut s) edit)
      (jit/jit-env-release! (mut s) current))
    ; The session still takes real submissions, under its own rule: a new
    ; version is a new name. The old caller keeps running its old code.
    (assert (= (jit/jit-compile-with-entry! (mut s)
                 "(module p) (defn helper--2 [(n i64) (m i64)] (-> i64) (+ n m)) (defalias helper helper--2)
                  (defn calls-helper--2 [] (-> i64) (helper 1 2))"
                 "(- (+ (calls-helper--2) (calls-helper)) 5)") 0))
    (jit/jit-reset! (mut s))
    0))
