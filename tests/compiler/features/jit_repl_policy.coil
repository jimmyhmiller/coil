(module compiler.features.jit-repl-policy)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond (!= (jit/jit-compile-with-entry! (mut session)
                                           "(module policy.example)
         (import \"coil.repl\")
         (defn f [] (-> i64) 15)
         (defn caller [] (-> i64) (f))"
                                           "(coil.repl/publish)")
              0)
            1
          (!= (jit/jit-compile-with-entry! (mut session)
                                           ""
                                           "(if (= (caller) 15) 0 90)")
              0)
            2
          (!= (jit/jit-prepare-with-entry! (mut session)
                                           "(defn f [] (-> i64) 99)"
                                           "(coil.repl/publish)")
              0)
            3
          (!= (jit/jit-abort-prepared! (mut session)) 0) 4
          (!= (jit/jit-compile-with-entry! (mut session)
                                           ""
                                           "(if (= (caller) 15) 0 91)")
              0)
            5
          (!= (jit/jit-compile-with-entry! (mut session)
                                           "(defn f [] (-> i64) 20)"
                                           "(coil.repl/publish)")
              0)
            6
          (!= (jit/jit-compile-with-entry! (mut session)
                                           ""
                                           "(if (= (caller) 20) 0 92)")
              0)
            7
          (= (jit/jit-compile-with-entry! (mut session)
                                          "(defn f [] (-> bool) true)"
                                          "(coil.repl/publish)")
             0)
            8
          (!= (jit/jit-compile-with-entry! (mut session)
                                           ""
                                           "(if (= (caller) 20) 0 93)")
              0)
            9
          :else (jit/jit-reset! (mut session)))))
