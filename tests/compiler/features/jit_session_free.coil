(module compiler.features.jit-session-free)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.dbgalloc" :use [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.jit" :as jit)

;; A session can be freed. While a generation lease is outstanding the free is
;; refused and the session keeps working; once released, the free returns every
;; allocation the session made through its allocator.
(defn main [] (-> i64)
  (let [debug (debug-allocator-init (malloc-allocator))
        (mut session) (jit/jit-session-new (debug-allocator-view debug))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module freeing.a) (defn one [] (-> i64) 1)"
            "(if (= (freeing.a.one) 1) 0 1)") 0) 1
      (!= (jit/jit-generation-retain! (mut session)) 1) 2
      (!= (jit/jit-session-free! (mut session)) -1) 3
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module freeing.b) (import \"freeing.a\" :as a) (defn two [] (-> i64) (+ (a/one) 1))"
            "(if (= (freeing.b.two) 2) 0 1)") 0) 4
      (< (jit/jit-generation-release! (mut session)) 0) 5
      (!= (jit/jit-session-free! (mut session)) 0) 6
      (!= (cast i64 (.raw session)) 0) 7
      ; Freeing a freed handle is a no-op.
      (!= (jit/jit-session-free! (mut session)) 0) 8
      (!= (debug-allocator-deinit! debug) 0) 9
      :else 0)))
