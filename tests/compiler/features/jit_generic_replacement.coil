(module compiler.features.jit-generic-replacement)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Under the coil.repl policy a generic function can be redefined. New uses
; specialize the replacement, code accepted earlier keeps the specialization it
; bound, and a rejected replacement leaves the accepted template in place.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))]
    (cond
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module definitions) (import \"coil.repl\")
             (defn pick [T] [(a T) (b T)] (-> T) a)
             (defn answer [] (-> i64) (pick 1 2))"
            "(coil.repl/publish)") 0) 1
      (!= (jit/jit-compile-with-entry! (mut session) "" "(if (= (answer) 1) 0 1)") 0) 2
      (!= (jit/jit-compile-with-entry! (mut session)
            "(module definitions) (defn pick [T] [(a T) (b T)] (-> T) b)"
            "(coil.repl/publish)") 0) 3
      (!= (jit/jit-compile-with-entry! (mut session) ""
            "(if (and (= (pick 1 2) 2) (= (answer) 1)) 0 1)") 0) 4
      ; a replacement that does not check is rejected...
      (= (jit/jit-compile-with-entry! (mut session)
            "(module definitions) (defn pick [T] [(a T) (b T)] (-> T) undefined-name)"
            "(coil.repl/publish)") 0) 5
      ; ...and the accepted replacement still stands.
      (!= (jit/jit-compile-with-entry! (mut session) "" "(if (= (pick 1 2) 2) 0 1)") 0) 6
      :else (do (jit/jit-reset! (mut session)) 0))))
