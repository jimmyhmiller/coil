(module transform-generated-fix-target)

(import "coil.primitive" :as primitive)

(defn generated-marker-head? [(f Code)] (-> bool)
  (and (primitive/code-list? f)
       (and (> (primitive/code-count f) 0)
            (primitive/code-eq (primitive/code-nth f 0) `generated-marker))))

(defn has-generated-marker? [(f Code)] (-> bool)
  (if (primitive/code-list? f)
      (if (generated-marker-head? f)
          true
          (has-generated-marker-kids? f 0 (primitive/code-count f)))
      false))

(defn has-generated-marker-kids? [(f Code) (i i64) (n i64)] (-> bool)
  (if (>= i n)
      false
      (if (has-generated-marker? (primitive/code-nth f i))
          true
          (has-generated-marker-kids? f (+ i 1) n))))

;; Preserve every unaffected subtree by identity. Only the marker's containing
;; path is rebuilt, so the transform does not erase source provenance elsewhere.
;; hygiene: generated primitive/load intentionally resolves in the transported place's use-site context.
(defn generated-load [(place Code)] (-> Code)
  (let [out (primitive/code-list-new)]
    (primitive/code-list-push! out (primitive/datum->syntax place "primitive/load"))
    (primitive/code-list-push! out place)
    (primitive/code-list-done out)))

(defn rewrite-generated [(f Code)] (-> Code)
  (if (primitive/code-list? f)
      (if (generated-marker-head? f)
          (generated-load (primitive/code-nth f 1))
          (if (has-generated-marker? f)
              `(~@(rewrite-generated-kids f 0 (primitive/code-count f)))
              f))
      f))

(defn rewrite-generated-kids [(f Code) (i i64) (n i64)] (-> Code)
  (let [out (primitive/code-list-new)
        (mut j) i]
    (while (< (load j) n)
      (primitive/code-list-push! out (rewrite-generated (primitive/code-nth f (load j))))
      (store! j (+ (load j) 1)))
    (primitive/code-list-done out)))

(defn introduce-generated [(modules Code)] (-> Code)
  `(do ~@(rewrite-generated-kids modules 0 (primitive/code-count modules))))

(transform introduce-generated)

(defn main [] (-> i64)
  (generated-marker (primitive/alloc-static i64)))
