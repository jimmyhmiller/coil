(module compiler.features.retained-heap)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [hm-free!])
(import "coil.slice" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.retained_heap" :as heap)
(import "coil.compiler.retained_graph" :as graph)

(defstruct Node [(value i64) (next (ptr Node))])
(defn fix-node [(g (ptr graph/Graph)) (from (ptr i8)) (to (ptr i8))] (-> i64)
  (let [old (p/cast (ptr Node) from) new (p/cast (ptr Node) to)]
    (set! (.value new) (.value old))
    (set! (.next new) (p/cast (ptr Node) (graph/graph-address g (p/cast i64 (.next old))))))
  0)
(defn scan-node [(g (ptr graph/Graph)) (raw (ptr i8))] (-> i64)
  (let [node (p/cast (ptr Node) raw)]
    (when (graph/graph-enter-typed! g (p/cast i64 node) (p/sizeof Node) (p/alignof Node)
      1 (p/fnptr-of fix-node) (p/fnptr-of scan-node))
      (scan-node g (p/cast (ptr i8) (.next node))) 0))
  0)

(defn main [] (-> i64)
  (let [a (malloc-allocator) store (box! a heap/Heap (heap/heap-new a))
        (mut arena) (p/zeroed scratch/ScratchArena)]
    (scratch/scratch-init-with-cap (mut arena) a 256)
    (let [temp (scratch/scratch-allocator (mut arena))
          pair (match (alloc [Node] temp 2) (Some [value] (slice-data value))
            (None [] (do (abort) (p/cast (ptr Node) 0))))
          extra (box! temp Node (Node :value 42 :next (p/index pair 1)))
          g (box! temp graph/Graph (graph/graph-new temp temp))]
      (set! pair (Node :value 7 :next pair))
      (set! (p/index pair 1) (Node :value 9 :next extra))
      (set! (.heap g) store)
      ; A larger normal range aliases the frozen first node. Its second node
      ; has an independent cycle and must have its closure promoted as well.
      (graph/graph-range! g (p/cast i64 pair) (* 2 (p/sizeof Node)) (p/alignof Node))
      (scan-node g (p/cast (ptr i8) pair))
      (scan-node g (p/cast (ptr i8) (p/index pair 1)))
      (set! (.freezing g) true)
      (scan-node g (p/cast (ptr i8) pair))
      (set! (.freezing g) false)
      (graph/graph-finish! g)
      (let [kept (p/cast (ptr Node) (graph/graph-address g (p/cast i64 pair)))
            (mut owners) (.owners g)]
        (assert (= (.live-blocks store) 2))
        (scratch/scratch-close! (mut arena))
        (assert (= (.next kept) kept))
        (assert (= (.value (.next (p/index kept 1))) 42))
        (assert (= (.next (.next (p/index kept 1))) (p/index kept 1)))
        (scratch/scratch-init-with-cap (mut arena) a 256)
        (let [temp2 (scratch/scratch-allocator (mut arena))
              g2 (box! temp2 graph/Graph (graph/graph-new temp2 temp2))]
          (set! (.heap g2) store)
          (graph/graph-range! g2 (p/cast i64 kept) (* 2 (p/sizeof Node)) (p/alignof Node))
          (scan-node g2 (p/cast (ptr i8) kept))
          (scan-node g2 (p/cast (ptr i8) (p/index kept 1)))
          (graph/graph-finish! g2)
          (assert (= (.payload-bytes g2) 0))
          (assert (= (graph/graph-address g2 (p/cast i64 kept)) (p/cast i64 kept)))
          (heap/release-list! store (mut owners))
          (assert (= (.value (.next (p/index kept 1))) 42))
          (heap/release-list! store (mut (.owners g2))))
        (scratch/scratch-close! (mut arena))))
    (assert (= (.live-blocks store) 0))
    (assert (= (.live-bytes store) 0))
    (assert (= (.len (.pages store)) 0))
    ; Cover every page of a large range and preserve a nonzero alignment residue.
    (let [item (heap/allocate-block! store 9000 16 7)
          base (p/cast i64 (.data item))]
      (heap/retain! item)
      (assert (= (% base 16) 7))
      (assert (= (heap/find-block store base) item))
      (assert (= (heap/find-block store (+ base 8999)) item))
      (assert (= (p/cast i64 (heap/find-block store (+ base 9000))) 0))
      (heap/release! store item))
    (assert (= (.live-blocks store) 0))
    (hm-free! (mut (.pages store)))
    (free [heap/Heap] a (slice-new store 1)))
  0)
