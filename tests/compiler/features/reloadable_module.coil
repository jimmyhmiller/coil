(module reloadable-module-test)
(import "coil.primitive" :as primitive)
(import "coil.var")
(import "coil.jit.reload")

; Opt ordinary compiled modules into the same native stable-cell lowering used
; by the in-process JIT session.
(reloadable-module)

(defn step [(x i64)] (-> i64)
  (+ x 1))

(defn indirect [(x i64)] (-> i64)
  (let [f step]
    (f x)))

(defn recurse [(x i64)] (-> i64)
  (if (= x 0) 0 (+ 1 (recurse (- x 1)))))

(defn main [] (-> i64)
  (if (and (= (indirect 4) 5) (= (recurse 4) 4)) 0 1))
