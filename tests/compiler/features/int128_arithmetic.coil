(module int128-arithmetic)
(import "coil.primitive" :as primitive)

; i128 and u128 across every engine: literals past i64, arithmetic, shifts and
; rotations at every word boundary, comparisons, conversions, overflow tests,
; and values in structs, arrays, sums, statics and calls.

(defstruct Pair [(tag i8) (wide i128) (after i64)])
(defsum Amount (Small [(n i64)]) (Big [(n u128)]))

(def LIMIT (: 340282366920938463463374607431768211455 u128))
(def PAIR (Pair :tag 1 :wide -170141183460469231731687303715884105728 :after 9))
(const PRODUCT (* (: 4000000000 i128) (: 5000000000 i128)))

(defn sum8 [(a i128) (b i128) (c i128) (d i128) (e i128) (f i128) (g i128) (h i128)] (-> i128)
  (+ a b c d e f g h))

(defn mixed [(x i64) (w u128) (y i64)] (-> u128)
  (+ w (cast u128 x) (cast u128 y)))

(defn amount-value [(a Amount)] (-> u128)
  (match a (Small [n] (cast u128 n)) (Big [n] n)))

(defn main [] (-> i64)
  (let [big (: 18446744073709551616 i128)          ; 2^64
        neg (: -5 i128)
        u (: 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_fff0 u128)
        m (: 170141183460469231731687303715884105727 i128)]
    (println "{} {} {} {}" big neg u m)
    (println "{} {} {} {}" (+ big neg) (- neg big) (* big neg) (* (: 123456789123456789 i128) (: 987654321987654321 i128)))
    (println "{} {} {} {}" (/ m (: 7 i128)) (% m (: 7 i128)) (/ neg (: 2 i128)) (% neg (: 3 i128)))
    (println "{} {} {}" (/ u (: 10 u128)) (% u (: 10 u128)) (/ LIMIT (: 3 u128)))
    (println "{} {} {}" (& u (cast u128 big)) (| neg big) (^ u (: 1 u128)))
    (for n [0 1 63 64 65 127]
      (println "shift {}: {} {} {}" n (<< (: 3 u128) (cast u128 n)) (>> u (cast u128 n)) (>> (: -1000 i128) (cast i128 n))))
    (println "rot {} {}" (primitive/rotl u (: 4 u128)) (primitive/rotr (: 1 u128) (: 1 u128)))
    (println "cmp {} {} {} {} {} {}" (< neg big) (<= big big) (> u (: 0 u128)) (>= neg (: 0 i128)) (= big big) (!= u LIMIT))
    (println "cmp-signed {} {}" (< (: -1 i128) (: 1 i128)) (< (primitive/cast u128 (: -1 i128)) (: 1 u128)))
    (println "cast {} {} {} {}" (primitive/cast i64 big) (cast i128 (: -7 i64)) (primitive/cast u128 (: -7 i64)) (primitive/cast u8 u))
    (println "float {} {} {} {}" (cast f64 big) (cast i128 (: -2.5e20 f64)) (cast u128 (: 3.0e30 f64)) (cast f32 neg))
    (println "bits {} {} {} {}" (primitive/clz big) (primitive/ctz big) (primitive/popcount u) (primitive/inot (: 0 i128)))
    (println "bswap {}" (primitive/bswap (: 1 u128)))
    (println "mulhi {} {}" (primitive/mulhi LIMIT LIMIT) (primitive/mulhi (: -1 i128) (: 2 i128)))
    (println "ovf {} {} {} {}" (primitive/iadd-overflow? m (: 1 i128)) (primitive/isub-overflow? (: 0 u128) (: 1 u128))
             (primitive/imul-overflow? LIMIT (: 2 u128)) (primitive/imul-overflow? big big))
    (println "ovf-ok {} {}" (primitive/iadd-overflow? big big) (primitive/imul-overflow? (: 3 i128) (: -4 i128)))
    (println "ovf-min {} {}" (primitive/imul-overflow? (: -9223372036854775808 i128) big)
             (primitive/imul-overflow? (: 9223372036854775808 i128) big))
    (let [top (: 633825300114114700748351602687 i100)]   ; 2^99 - 1
      (println "i100 {} {} {}" (cast i128 (primitive/iadd top (: 1 i100))) (primitive/iadd-overflow? top (: 1 i100))
               (primitive/imul-overflow? top (: 2 i100))))
    (println "calls {} {}" (sum8 big big big big neg neg neg neg) (mixed 1 u 2))
    (let [(mut p) (zeroed Pair)
          xs [big neg m]]
      (set! (.wide p) (primitive/imul big big))
      (set! (.after p) 3)
      (println "struct {} {} {} {}" (.wide p) (.after p) (.wide PAIR) (.after PAIR))
      (println "array {} {}" (get xs 2) (+ (get xs 0) (get xs 1))))
    (println "sum {} {}" (amount-value (Big :n LIMIT)) (amount-value (Small :n 4)))
    (println "static {} {}" LIMIT PRODUCT))
  0)
