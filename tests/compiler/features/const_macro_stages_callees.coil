;; A macro first invoked from a `const` initializer is staged before any function
;; body in its closure is checked. When its closure reaches a library function whose
;; own body still holds a macro call (`slice-new` -> `dbg-slice-new-check`), the
;; tower expands that call instead of failing (coil-bugs
;; macro-code-eq-metaprogram-engine).
(module const-macro-stages-callees)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use [slice-new])

(defn pick [(linux Code) (other Code)] (-> Code)
  (if (= (primitive/target-os) `linux) linux other))

(defn measured [(x Code)] (-> Code)
  (let [s (slice-new (primitive/cast (ptr u8) c"ab") 2)]
    (if (= (len s) 2) x `0)))

(const PICKED (pick 1 1))
(const MEASURED (measured 7))

(defn main [] (-> i64)
  (println "{} {}" PICKED MEASURED)
  0)
