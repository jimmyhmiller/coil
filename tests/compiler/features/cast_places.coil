; `cast` on a place: an explicit `(mut x)` is the local's address; a mutable
; local or reference parameter named bare converts its VALUE. A mutable
; pointer local cast to a pointer used to yield the local's own address, and a
; numeric cast of a mutable local was rejected.
(module cast-places)

(defstruct Pair [(a i64) (b i64)])

(defn pair-address [(p (mut Pair))] (-> i64)
  (let [raw (cast (ptr Pair) p)]
    (+ (.a raw) (.b raw))))

(defn widen [(n (mut i64))] (-> f64) (cast f64 n))

(defn main [] (-> i64)
  (let [(mut storage) 40
        (mut ptr-local) (cast (ptr i64) (mut storage))
        same (cast (ptr i64) ptr-local)
        (mut small) 300
        (mut pair) (Pair :a 1 :b 2)
        (mut counter) 7]
    (println "{} {} {} {}"
             (load same)
             (cast i64 (cast u8 small))
             (pair-address (mut pair))
             (widen (mut counter)))
    0))
