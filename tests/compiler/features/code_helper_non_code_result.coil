; A function that takes Code runs only at compile time, whatever it returns: its
; call to a Code→Code helper with Code arguments is an ordinary call, not a macro
; invocation — even when no macro reaches it. Importing coil.lint.names alone
; exercises the same shape in the standard library.
(module code-helper-non-code-result)
(import "coil.primitive" :as primitive)
(import "coil.lint.names")

(defn second [(e Code)] (-> Code) (primitive/code-nth e 1))

(defn second-count [(e Code)] (-> i64) (primitive/code-count (second e)))

(defn second-list? [(e Code)] (-> bool)
  (let [(mut seen) false]
    (when (primitive/code-list? (second e)) (set! seen true))
    seen))

(defn describe [(e Code)] (-> Code)
  (if (second-list? e) `~(second-count e) `-1))

(defn main [] (-> i64)
  (println "{} {}" (describe (a (b c d))) (describe (a b)))
  0)
