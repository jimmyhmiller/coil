;; A defalias may name a function of its module, before or after the function's
;; definition (declaration macros like `defn` expand before the alias is checked).
(module defalias-function)
(defalias early get-v1)
(defn get-v1 [] (-> i64) 40)
(defalias late get-v1)
(defn main [] (-> i64)
  (println "{}" (+ (early) (late) -38))
  0)
