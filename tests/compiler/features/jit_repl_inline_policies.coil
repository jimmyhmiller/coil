(module compiler.features.jit-repl-inline-policies)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.jit" :as jit)

; Exercise all inline policies, removal, and an annotated initial publication.
(defn main [] (-> i64)
  (let [(mut session) (jit/jit-session-new (malloc-allocator))
        initial (jit/jit-compile-with-entry! (mut session)
          "(import \"coil.repl\")
           (defn damage :inline (Never) [(amount i64)] (-> i64) (+ amount 1))
           (defn identity :inline (Hint) [T] [(x T)] (-> T) x)
           (defn syntax :inline (Never) [] (-> Code) `5)
           (const initial-damage (damage 4))
           (export-c [damage :as \"inline_damage\"])"
          "(coil.repl/publish)")]
    (println "initial status: {}" initial)
    (if (!= initial 0)
      1
      (let [edited (jit/jit-compile-with-entry! (mut session)
              "(defn damage :inline (Always) [(amount i64)] (-> i64) (+ amount 1))"
              "(coil.repl/publish)")]
        (println "inline edit status: {}" edited)
        (if (!= edited 0)
          2
          (let [hint (jit/jit-compile-with-entry! (mut session)
                        "(defn damage :inline (Hint) [(amount i64)] (-> i64) (+ amount 1))"
                        "(coil.repl/publish)")
                removed (jit/jit-compile-with-entry! (mut session)
                           "(defn damage [(amount i64)] (-> i64) (+ amount 1))"
                           "(coil.repl/publish)")
                result (jit/jit-compile-with-entry! (mut session) ""
                         "(if (and (= (damage :amount 4) 5) (= initial-damage (identity 5))) 0 1)")]
            (jit/jit-session-free! (mut session))
            (if (and (= hint 0) (= removed 0)) result 3)))))))
