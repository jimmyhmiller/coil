(module scope-defer-exits)
; The library spellings: `(scope :s ...)` with `(defer cleanup)`, and `defer`
; directly in any body. Every exit runs the cleanups -- including the break a
; macro such as `try!` writes, which `scope` once could not see and skipped.

(defsum E (Bad))

(defn fail [] (-> (Result i64 E)) (Err (Bad)))

;; The original report: `try!` leaving a scope skipped its defer.
(defn f [] (-> (Result i64 E))
  (try (scope :inner (defer (println "cleanup")) (try! (fail)) (Ok 1))))

(defn nested [] (-> i64)
  (scope :outer
    (defer (println "outer"))
    (scope :inner
      (defer (println "inner"))
      (return-from :outer 3))))

(defn in-loop [] (-> i64)
  (let [(mut n) 0]
    (for i (range 0 3)
      (defer (set! n (+ n 1)))
      (when (= i 1) (continue))
      (println "i {}" i))
    n))

(defn in-let [] (-> i64)
  (let [x 5]
    (defer (println "let cleanup {}" x))
    x))

(defn main [] (-> i64)
  (match (f) (Ok [_] (println "ok")) (Err [_] (println "err")))
  (let [v (nested)] (println "nested {}" v))
  (let [v (in-loop)] (println "in-loop {}" v))
  (let [v (in-let)] (println "in-let {}" v))
  (defer (println "main cleanup"))
  0)
