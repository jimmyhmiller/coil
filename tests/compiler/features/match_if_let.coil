; if-let, when-let and while-let: one refutable pattern against one value.
(module match-if-let)

(defsum Fault (A) (C [(code i64)]))

(defn port-or [(o (Option i64))] (-> i64)
  (if-let [(Some [p]) o] p 8080))

(defn code-or-zero [(r (Result i64 Fault))] (-> i64)
  (if-let [(Err [(C [c])]) r] c 0))

(defn is-none? [(o (Option i64))] (-> bool)
  (if-let [(None) o] true false))

(defn is-seven? [(n i64)] (-> bool)
  (if-let [7 n] true false))

(defn total [] (-> i64)
  (let [(mut it) (range 0 5)
        (mut sum) 0]
    (while-let [(Some [x]) (next (mut it))]
      (when (= x 3) (continue))
      (set! sum (+ sum x)))
    sum))

(defn main [] (-> i64)
  (println "{} {}" (port-or (Some 80)) (port-or (None)))
  (println "{} {} {}" (code-or-zero (Err (C 4))) (code-or-zero (Err (A))) (code-or-zero (Ok 1)))
  (println "{} {} {} {}" (is-none? (None)) (is-none? (Some 1)) (is-seven? 7) (is-seven? 8))
  (when-let [(Some [x]) (Some 12)] (println "got {}" x))
  (when-let [(Some [x]) (: (None) (Option i64))] (println "never {}" x))
  (println "{}" (total))
  0)
