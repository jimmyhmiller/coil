(module field-place-syntax)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)

(defstruct Point [(x i64) (y i64)])
(defstruct Rect [(origin Point) (width i64)])

(defn bump! [(x (mut i64))] (-> i64)
  (set! x (+ (load x) 1)))

(defn main [] (-> i64)
  (let [rect (primitive/alloc-stack Rect)]
    (set! rect
          (Rect
            :origin (Point :x 10 :y 20)
            :width 30))
    (set! (.width rect) 40)
    (set! (.x (.origin rect)) 2)
    (bump! (mut (.x (.origin rect))))
    (if (= (.. rect origin x) 3)
        (+ (.width rect) (.x (.origin rect)))
        99)))
