(module ownership_generic_drop)
(import "coil.primitive" :as primitive)

(defn counter [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))]
        (-> void)
        (store! (counter) (+ (load (counter)) (.value self)))))

; Ownership and cleanup for T are deferred until this function is instantiated.
(defn consume-generic [T] [(value T)] (-> void))

(defn main [] (-> i64)
  (store! (counter) 0)
  (consume-generic (Owner :value 9))
  (load (counter)))
