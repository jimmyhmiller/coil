(module ownership_match_payload_move_rejected)

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)))

; A match on a named value binds its payload by reference; moving the payload
; out would leave `r` to drop it again.
(defn unwrap [(r (Result Owner i64))] (-> Owner)
  (match r
    (Ok [v] v)
    (Err [_] (Owner :value 0))))

(defn main [] (-> i64)
  (let [o (unwrap (Ok (Owner :value 1)))] (.value o)))
