(module borrowing-traits)

; Formatting and comparing lend their operands. An owner whose Display, Debug
; or Eq impl borrows is still alive afterwards, and derived Eq, Hash and Debug
; borrow.

(defstruct Ticket [(n i64)])

(impl Drop Ticket
  (drop [(self (mut Ticket))] (-> void) (println "drop {}" (.n self))))

(impl Display Ticket
  (display-fmt [(t (ref Ticket)) (f (ptr Formatter))] (-> i64)
    (fmt (formatter-writer f) "ticket-{}" (.n t))
    0))

(impl Debug Ticket
  (debug-fmt [(t (ref Ticket)) (f (ptr Formatter))] (-> i64)
    (fmt (formatter-writer f) "(Ticket {})" (.n t))
    0))

(impl Eq Ticket
  (= [(a (ref Ticket)) (b (ref Ticket))] (-> bool) (= (.n a) (.n b))))

(defstruct Point [(x i64) (y i64)])
(derive Eq Hash Debug Point)

(defsum Shape (Circle [(r i64)]) (Square [(side i64)]))
(derive Eq Hash Debug Shape)

(defn main [] (-> i64)
  (let [a (Ticket :n 1)
        b (Ticket :n 2)]
    (println "{} {:?} [{:>10}]" a a a)
    (println "{} {}" (!= a b) (= a a))
    (println "still {} {}" (.n a) (.n b)))
  (let [p (Point :x 1 :y 2)]
    (println "{:?} {} {} {}" p (= p (Point :x 1 :y 2)) (!= p (Point :x 2 :y 1))
             (= (hash p) (hash (Point :x 1 :y 2))))
    (println "{:?} {}" (Square :side 3) (!= (Circle :r 1) (Square :side 1))))
  (println "{} {}" (!= 3 4) (!= (: 7 u64) 7))
  0)
