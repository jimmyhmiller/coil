(module test.vector-fma-single-rounding)
(import "coil.primitive" :as p)

; Also exercises the legacy raw-IR intrinsic path, independently of coil.simd.
(defn main [] (-> i64)
  (let [storage (p/alloc-stack (array f32 4))
        value (p/llvm-ir (vec f32 4)
          [(cast f32 1.00000011920928955078125)
           (cast f32 0.99999988079071044921875)
           (cast f32 -1.0)]
          "declare <4 x float> @llvm.fma.v4f32(<4 x float>, <4 x float>, <4 x float>)
%a = insertelement <4 x float> zeroinitializer, float $0, i32 0
%b = insertelement <4 x float> zeroinitializer, float $1, i32 0
%c = insertelement <4 x float> zeroinitializer, float $2, i32 0
%r = call <4 x float> @llvm.fma.v4f32(<4 x float> %a, <4 x float> %b, <4 x float> %c)
ret <4 x float> %r")]
    (p/llvm-ir i64 [(cast (ptr f32) storage) value]
      "store $t1 $1, ptr $0, align 1
ret i64 0")
    (if (= (load (cast (ptr u32) storage)) (cast u32 0xa8800000)) 0 1)))
