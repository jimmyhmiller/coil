(module array-literals)
(import "coil.assert" :use *)
(import "coil.slice" :use [slice-get slice-len])
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList al-len al-get al-free!])
(import "coil.collect" :use [collect])

(defstruct Header [(name (slice u8)) (value (slice u8))])

(defstruct Request [(headers (slice Header))])

(defn sum3 [(xs (array i64 3))] (-> i64)
  (+ (load (index xs 0)) (+ (load (index xs 1)) (load (index xs 2)))))

(defn sum-slice [(xs (slice i64))] (-> i64)
  (+ (slice-get xs 0) (+ (slice-get xs 1) (slice-get xs 2))))

(defn header-count [(request Request)] (-> i64)
  (slice-len (.headers request)))

(defn main [] (-> i64)
  (let [xs [10 20 12]]
    (assert-eq (sum3 xs) 42)
    (assert-eq (sum-slice [10 20 12]) 42)
    (assert-eq (header-count (Request :headers
                                        [(Header :name "Accept" :value "application/json")
                                         (Header :name "User-Agent" :value "coil-array-literal-test")]))
               2)
    (let [(mut owned) (collect [(ArrayList i64)] (malloc-allocator) [7 8 9])]
      (assert-eq (al-len [i64] owned) 3)
      (assert-eq (al-get [i64] owned 1) 8)
      (al-free! [i64] (mut owned)))
    0))
