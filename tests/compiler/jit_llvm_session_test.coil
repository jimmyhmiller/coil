;;; Exercise the LLVM runner on every LLVM-enabled host, including ARM64 where
;;; coil.jit's default runner uses Mach-O. Submission uses the SDK's compiler owner.
(module compiler.tests.jit-llvm-session)
(import "coil.primitive" :as p)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.compiler.loader" :use [set-self-command!])
(import "coil.compiler.metaengine" :use [set-meta-build-obj! set-meta-jit!])
(import "coil.compiler.comptime_eval" :use [register-comptime-fold!])
(import "coil.compiler.driver" :as sdk)
(import "coil.compiler.jit_llvm" :as llvm)

(defn main [] (-> i64)
  (set-self-command! "coil")
  (set-meta-build-obj! (p/fnptr-of llvm/jit-llvm-build-object))
  (set-meta-jit! false)
  (register-comptime-fold!)
  (block :test
    (let [a (malloc-allocator)
          session (sdk/repl-session-new-with-runner a
            (p/fnptr-of llvm/jit-llvm-run) (p/fnptr-of llvm/llvm-jit-reclaim!)
            (p/fnptr-of llvm/llvm-jit-generation-count) (p/fnptr-of llvm/llvm-jit-retain-current!)
            (p/fnptr-of llvm/llvm-jit-release-token!) (p/fnptr-of llvm/llvm-jit-token-leases)
                                    (p/fnptr-of llvm/llvm-jit-set-roots!))]
      (when (!= (sdk/repl-session-compile! session
        "(defn base [] (-> i64) 40) (export-c [base :as \"captured\"])" "0") 0)
        (return-from :test 1))
      (let [state (p/cast (ptr llvm/LLVMJitState) (sdk/repl-session-native-state session))
            old (llvm/llvm-jit-sym-lookup state "captured")
            token (sdk/repl-session-generation-retain-current! session)]
        (when (= (p/cast i64 old) 0) (return-from :test 2))
        (when (!= (sdk/repl-session-compile! session
          "(defn next [] (-> i64) (+ (base) 2))" "(if (= (next) 42) 0 91)") 0)
          (return-from :test 3))
        (for [i 0 20]
          (when (!= (sdk/repl-session-compile! session "" "(if (= (next) 42) 0 92)") 0)
            (return-from :test 4))
          (when (= (sdk/repl-session-compile! session "(defn rejected [] (-> i64) 99)" "9") 0)
            (return-from :test 5)))
        (when (!= (p/call-ptr (p/cast (fnptr c [] i64) old)) 40) (return-from :test 6))
        (when (!= (sdk/repl-session-reset! session) -1) (return-from :test 7))
        (sdk/repl-session-generation-release-token! session token))
      (when (!= (sdk/repl-session-reset! session) 0) (return-from :test 8))
      ; A lease on an old caller roots its imported callee even after both
      ; compiler metadata roots have moved to newer, unrelated definitions.
      (assert (= (sdk/repl-session-compile! session "(import \"coil.jit.lifetime\")" "0") 0))
      (assert (= (sdk/repl-session-compile! session
        "(defn leaf :jit/retain false :jit/root 1 :jit/root-version 1 [] (-> i64) 41)" "0") 0))
      (assert (= (sdk/repl-session-compile! session
        "(defn caller :jit/retain false :jit/root 2 :jit/root-version 1 [] (-> i64) (+ (leaf) 1)) (export-c [caller :as \"leased_caller\"])" "0") 0))
      (let [state (p/cast (ptr llvm/LLVMJitState) (sdk/repl-session-native-state session))
            old (llvm/llvm-jit-sym-lookup state "leased_caller")
            token (sdk/repl-session-generation-retain-current! session)]
        (assert (> token 0)) (assert (!= (p/cast i64 old) 0))
        (assert (= (sdk/repl-session-compile! session
          "(defn next-leaf :jit/retain false :jit/root 1 :jit/root-version 2 [] (-> i64) 7)
           (defn next-caller :jit/retain false :jit/root 2 :jit/root-version 2 [] (-> i64) 8)" "0") 0))
        (for [i 0 8]
          (assert (= (sdk/repl-session-compile! session "" "(- (+ (next-leaf) (next-caller)) 15)") 0))
          (assert (>= (sdk/repl-session-reclaim-retired! session) 0))
          (assert (= (p/call-ptr (p/cast (fnptr c [] i64) old)) 42))
          (assert (<= (sdk/repl-session-generation-count session) 5)))
        (assert (>= (sdk/repl-session-generation-release-token! session token) 0))
        (assert (>= (sdk/repl-session-reclaim-retired! session) 2))
        (assert (<= (sdk/repl-session-generation-count session) 3)))
      (assert (= (sdk/repl-session-reset! session) 0))
      0)))
