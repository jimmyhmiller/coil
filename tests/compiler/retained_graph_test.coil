(module retainedgraphtest)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.scratch" :as scratch)
(import "coil.compiler.retained_graph" :use *)

(defstruct Node [(value i64) (next (ptr Node))])
(defn fix-node [(g (ptr Graph)) (from (ptr i8)) (to (ptr i8))] (-> i64)
  (let [source (p/cast (ptr Node) from) target (p/cast (ptr Node) to)]
    (set! (.next target) (p/cast (ptr Node) (graph-address g (p/cast i64 (.next source)))))))
(defn visit [(g (ptr Graph)) (node (ptr Node))] (-> i64)
  (when (graph-enter! g (p/cast i64 node) (p/sizeof Node) (p/alignof Node) 1 (p/fnptr-of fix-node))
    (visit g (.next node)) 0) 0)
(defn demand [(good bool)] (-> i64) (unless good (abort) 0) 0)
(defn main [] (-> i64)
  (let [source (p/alloc-stack scratch/ScratchArena)
        work (p/alloc-stack scratch/ScratchArena)
        destination (p/alloc-stack scratch/ScratchArena)]
    (scratch/scratch-init source (malloc-allocator))
    (scratch/scratch-init work (malloc-allocator))
    (scratch/scratch-init destination (malloc-allocator))
    (let [a (scratch/scratch-allocator source)
          bytes (match (alloc [Node] a 3) (Some [items] items) (None [] (do (abort) (slice-new [Node] (p/cast (ptr Node) 0) 0))))
          nodes (slice-data bytes)
          second (p/index nodes 1)
          g (box! (scratch/scratch-allocator work) Graph
            (graph-new (scratch/scratch-allocator work) (scratch/scratch-allocator destination)))]
      ; Unreachable source-arena capacity must not become retained graph storage.
      (match (alloc-bytes a 1048576 16) (Some [_] 0) (None [] (do (abort) 0)))
      (set! nodes (Node :value 11 :next second))
      (set! second (Node :value 22 :next nodes))
      (set! (p/index nodes 2) (Node :value 33 :next (p/cast (ptr Node) 0)))
      ; Discover the interior pointer first, then the complete containing array.
      (visit g second)
      (graph-range! g (p/cast i64 nodes) (* 3 (p/sizeof Node)) (p/alignof Node))
      (visit g (p/index nodes 2))
      (graph-finish! g)
      (let [copied (p/cast (ptr Node) (graph-address g (p/cast i64 nodes)))
            middle (p/cast (ptr Node) (graph-address g (p/cast i64 second)))]
        (demand (= (.bytes g) (* 3 (p/sizeof Node))))
        (scratch/scratch-close! source)
        (scratch/scratch-close! work)
        (demand (= (.value copied) 11))
        (demand (= (.value middle) 22))
        (demand (= (p/cast i64 (.next copied)) (p/cast i64 middle)))
        (demand (= (p/cast i64 (.next middle)) (p/cast i64 copied)))
        (demand (= (.value (p/index copied 2)) 33))
        (demand (= (p/cast i64 (.next (p/index copied 2))) 0))))
    (scratch/scratch-close! destination))
  0)
