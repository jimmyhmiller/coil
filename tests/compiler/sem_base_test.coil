(module compiler.tests.sem-base)
(import "coil.primitive" :as p)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.dbgalloc" :use *)
(import "coil.compiler.ast" :use *)
(import "coil.compiler.sem_base" :use *)

; A type whose every part lives in memory the test then scribbles over, so a
; lookup that still pointed into it would read garbage.
(defn scratch-fn-type [(a (dyn Allocator)) (name (slice u8))] (-> Type)
  (let [(mut params) (al-new [Type] a)]
    (push! (mut params)
           (TApp (sem-own-bytes a name)
                 (box! a (ArrayList Type) (al-new [Type] a))))
    (push! (mut params) (TPtr (box! a Type (TInt 8 false))))
    (TFn
      :cc (sem-own-bytes a "c")
      :params (box! a (ArrayList Type) (load params))
      :ret (box! a Type (TStruct (sem-own-bytes a name))))))

; The struct a type names: itself, or a function type's result.
(defn struct-name-of-ret [(t Type)] (-> (slice u8))
  (match t
    (TStruct [name] name)
    (TFn [_ _ ret] (match (load ret) (TStruct [name] name) (_ "not a struct")))
    (_ "neither a struct nor a fn")))

(defn first-param-name [(t Type)] (-> (slice u8))
  (match t
    (TFn [_ params _]
         (match (get (load params) 0) (TApp [name _] name) (_ "not an app")))
    (_ "not a fn")))

(defn type-name-at [(base (ptr SemBase)) (node-id i64)] (-> (slice u8))
  (match (sem-base-type base node-id)
    (Some [t] (struct-name-of-ret t))
    (None [] "absent")))

(defn bid-at [(base (ptr SemBase)) (node-id i64)] (-> i64)
  (match (sem-base-bid base node-id) (Some [bid] bid) (None [] -1)))

(defn name-at [(base (ptr SemBase)) (node-id i64)] (-> (slice u8))
  (match (sem-base-name base node-id) (Some [name] name) (None [] "absent")))

(deftest entries-own-their-storage-and-everything-is-returned
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [base (sem-base-new a)
                 owner (sem-owner-new a)]
             ; Record from throwaway memory, then destroy it. Tearing that allocator down
             ; with its allocations still live is the point, so it reports them as leaked;
             ; the allocator this test answers for is `debug`.
             (let [throwaway (debug-allocator-init (malloc-allocator))
                   ta (debug-allocator-view throwaway)]
               (let [(mut t) (scratch-fn-type ta "geometry.Point")]
                 (sem-base-put-type! base owner 10 (mut t)))
               (sem-base-put-name! base
                                   owner
                                   11
                                   (sem-own-bytes ta "geometry.area"))
               (sem-base-put-bid! base 12 7)
               (debug-allocator-deinit! throwaway))
             (sem-owner-done! owner)
             (assert-eq (type-name-at base 10) "geometry.Point")
             (match (sem-base-type base 10)
               (Some [t] (assert-eq (first-param-name t) "geometry.Point"))
               (None [] (assert false)))
             (assert-eq (name-at base 11) "geometry.area")
             (assert-eq (bid-at base 12) 7)
             (assert-eq (.bnext base) 7)
             (assert-eq (type-name-at base 99) "absent")
             (assert-eq (bid-at base 99) -1)
             (assert (sem-base-has? base 11))
             (assert (not (sem-base-has? base 99)))
             (sem-base-release! base))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest a-derived-base-shares-and-neither-side-disturbs-the-other
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [old (sem-base-new a)
                 first (sem-owner-new a)]
             (for [node-id 1 2001]
               (let [(mut t) (TStruct "app.Old")]
                 (sem-base-put-type! old first node-id (mut t))
                 (sem-base-put-bid! old node-id node-id)))
             (sem-owner-done! first)
             (let [before (.live-allocations debug)
                   next (sem-base-derive a old)
                   second (sem-owner-new a)
                   (mut t) (TStruct "app.New")]
               (sem-base-put-type! next second 700 (mut t))
               (sem-base-put-bid! next 700 -5)
               (sem-owner-done! second)
               ; A path through each of two tries, an arena and a base: not 2000 entries.
               (assert (< (- (.live-allocations debug) before) 120))
               (assert-eq (type-name-at old 700) "app.Old")
               (assert-eq (type-name-at next 700) "app.New")
               (assert-eq (bid-at old 700) 700)
               (assert-eq (bid-at next 700) -5)
               (assert-eq (type-name-at next 1999) "app.Old")
               ; The old base going away leaves the new one whole.
               (sem-base-release! old)
               (assert-eq (type-name-at next 1999) "app.Old")
               (assert-eq (type-name-at next 700) "app.New")
               (sem-base-release! next)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest a-fallback-answers-only-what-the-base-lacks
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [shim (sem-base-new a)
                 app (sem-base-new a)
                 owner (sem-owner-new a)
                 (mut from-shim) (TStruct "shim.T")
                 (mut from-app) (TStruct "app.T")]
             (sem-base-put-type! shim owner 1 (mut from-shim))
             (sem-base-put-type! shim owner 2 (mut from-shim))
             (sem-base-put-type! app owner 2 (mut from-app))
             (sem-owner-done! owner)
             (assert-eq (type-name-at app 1) "absent")
             (sem-base-set-fallback! app shim)
             (assert-eq (type-name-at app 1) "shim.T")
             (assert-eq (type-name-at app 2) "app.T")
             ; The app base keeps the shim alive on its own.
             (sem-base-release! shim)
             (assert-eq (type-name-at app 1) "shim.T")
             (let [derived (sem-base-derive a app)]
               (sem-base-release! app)
               (assert-eq (type-name-at derived 1) "shim.T")
               (sem-base-release! derived)))
           (assert-eq (debug-allocator-deinit! debug) 0)))

(deftest pruning-drops-dead-entries-and-frees-an-arena-with-its-last-entry
         (let [debug (debug-allocator-init (malloc-allocator))
               a (debug-allocator-view debug)]
           (let [base (sem-base-new a)
                 keep (sem-owner-new a)
                 (mut t) (TStruct "app.Kept")]
             (for [node-id 1 101]
               (sem-base-put-type! base keep node-id (mut t))
               (sem-base-put-bid! base node-id 1))
             (sem-owner-done! keep)
             (let [settled (.live-allocations debug)]
               ; Eighty edits: each adds entries under fresh ids and kills the last lot.
               (for [edit 0 80]
                 (let [owner (sem-owner-new a)
                       (mut fresh) (TStruct "app.Edited")
                       (mut live) (hm-new-scalar [i64 i64] (malloc-allocator))
                       lo (+ 1000 (* edit 10))]
                   (for [node-id lo (+ lo 10)]
                     (sem-base-put-type! base owner node-id (mut fresh))
                     (sem-base-put-name! base owner node-id "app.edited"))
                   (sem-owner-done! owner)
                   (for [node-id 1 101] (set! (mut live) node-id 1))
                   (for [node-id lo (+ lo 10)] (set! (mut live) node-id 1))
                   (assert-eq (sem-base-prune! base (mut live))
                              (if (= edit 0) 0 20))
                   (hm-free! (mut live))))
               (assert-eq (sem-base-entries base) 220)
               (assert-eq (type-name-at base 1790) "app.Edited")
               (assert-eq (type-name-at base 1780) "absent")
               ; One edit's worth of storage outstanding, however many edits there were.
               (assert (< (- (.live-allocations debug) settled) 80)))
             (sem-base-release! base))
           (assert-eq (debug-allocator-deinit! debug) 0)))
