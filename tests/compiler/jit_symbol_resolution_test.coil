(module tests.compiler.jit-symbol-resolution-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [al-new push!])
(import "coil.assert" :use *)
(import "coil.compiler.jit" :use [JitSym jit-syms-lookup])

(deftest retained-symbols-use-exact-names
         (let [a (malloc-allocator)
               (mut symbols) (al-new [JitSym] a)]
           (push! (mut symbols)
                  (JitSym
                    :name "_replsession.lighting"
                    :addr (primitive/cast (ptr i8) 44)
                    :owner (primitive/cast (ptr i8) 0)))
           (push! (mut symbols)
                  (JitSym
                    :name "_paper.lighting"
                    :addr (primitive/cast (ptr i8) 22)
                    :owner (primitive/cast (ptr i8) 0)))
           (assert-eq 0
                      (primitive/cast i64
                                      (jit-syms-lookup (mut symbols)
                                                       "_lighting")))
           (assert-eq 44
                      (primitive/cast i64
                                      (jit-syms-lookup (mut symbols)
                                                       "_replsession.lighting")))
           (assert-eq 22
                      (primitive/cast i64
                                      (jit-syms-lookup (mut symbols)
                                                       "_paper.lighting")))))
