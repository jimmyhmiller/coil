(module thread-available-parallelism-test)
(import "coil.thread" :as thread)

(deftest available-parallelism-is-at-least-one
  (match (thread/available-parallelism)
    (Ok [n] (assert (>= n 1)))
    (Err [_] (assert false))))

(deftest available-parallelism-is-a-plausible-cpu-count
  (match (thread/available-parallelism)
    (Ok [n] (assert (<= n 4096)))
    (Err [_] (assert false))))
