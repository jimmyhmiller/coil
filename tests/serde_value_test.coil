; DOM (coil.serde.value) tests: decode arbitrary documents, query them, and

; round-trip through every backend.
(module serde-value-tests)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.alloc" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.arraylist" :use *)
(import "coil.serde" :use *)
(import "coil.serde.value" :use *)
(import "coil.serde.json" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.msgpack" :use *)

(const DOC
       "{\"version\": 3, \"name\": \"app\", \"tags\": [\"a\", \"b\"], \"ratio\": 0.5, \"debug\": true, \"extra\": null, \"nested\": {\"deep\": [1, 2, 3]}}")

(deftest jval-decode-and-query
         (let [a (malloc-allocator)]
           (match (from-json [JVal] a DOC)
             (Err [_] (assert false))
             (Ok [v]
                 (do
                   (assert-eq (jv-int (jv-get v "version")) 3)
                   (assert (str-eq (jv-str (jv-get v "name")) "app"))
                   (assert-eq (jv-len (jv-get v "tags")) 2)
                   (assert (str-eq (jv-str (jv-nth (jv-get v "tags") 1)) "b"))
                   (assert (primitive/fcmp-eq (jv-float (jv-get v "ratio")) 0.5))
                   (assert-eq (jv-int (jv-get v "debug")) 1)
                   (assert (jv-null? (jv-get v "extra")))
                   (assert (jv-null? (jv-get v "missing")))
                   (assert-eq (jv-int (jv-nth (jv-get (jv-get v "nested") "deep") 2)) 3)
                   (assert-eq (jv-len v) 7))))))

;;; canonical JSON re-render, used to compare structurally across formats
(defn render [(a (dyn Allocator)) (v JVal)] (-> (slice u8))
  (match (to-json-str a v)
    (Err [_] "")
    (Ok [s] s)))

(deftest jval-roundtrip-json
         (let [a (malloc-allocator)]
           (match (from-json [JVal] a DOC)
             (Err [_] (assert false))
             (Ok [v]
                 (let [s1 (render a v)]
                   (assert (> (slice-len s1) (cast i64 0)))
                   (match (from-json [JVal] a s1)
                     (Err [_] (assert false))
                     (Ok [v2] (assert (str-eq s1 (render a v2))))))))))

(deftest jval-cross-format
         (let [a (malloc-allocator)]
           (match (from-json [JVal] a DOC)
             (Err [_] (assert false))
             (Ok [v]
                 (let [want (render a v)]
                   ; through sexp
                   (match (to-sexp-str a v)
                     (Err [_] (assert false))
                     (Ok [ss]
                         (match (from-sexp [JVal] a ss)
                           (Err [_] (assert false))
                           (Ok [vs] (assert (str-eq want (render a vs)))))))
                   ; through msgpack
                   (match (to-msgpack-bytes a v)
                     (Err [_] (assert false))
                     (Ok [mb]
                         (match (from-msgpack [JVal] a mb)
                           (Err [_] (assert false))
                           (Ok [vm] (assert (str-eq want (render a vm))))))))))))

(deftest jval-sexp-native
         (let [a (malloc-allocator)]
           ; a sexp document decodes: symbols read as strings, (map …) as an object
           (match (from-sexp [JVal] a "(map \"k\" (1 two 3.5) \"flag\" true)")
             (Err [_] (assert false))
             (Ok [v]
                 (do
                   (assert-eq (jv-len v) 2)
                   (assert-eq (jv-int (jv-nth (jv-get v "k") 0)) 1)
                   (assert (str-eq (jv-str (jv-nth (jv-get v "k") 1)) "two"))
                   (assert (primitive/fcmp-eq (jv-float (jv-nth (jv-get v "k") 2)) 3.5))
                   (assert-eq (jv-int (jv-get v "flag")) 1))))))

(deftest jval-bad-input
         (let [a (malloc-allocator)]
           ; truncated msgpack: no data-model kind at all
           (match (from-msgpack [JVal] a "")
             (Err [_] (assert true))
             (Ok [_] (assert false)))))
