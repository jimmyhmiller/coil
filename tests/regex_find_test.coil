(module regex-find-test)
(import "coil.regex" :as re)

(defn span [(start i64) (end i64)] (-> (Option re/Span))
  (Some (re/Span :start start :end end)))

(defn same? [(got (Option re/Span)) (want (Option re/Span))] (-> bool)
  (let [ok
          (match got
            (Some [g]
                  (match want
                    (Some [w] (= g w))
                    (None [] false)))
            (None []
                  (match want
                    (Some [w] false)
                    (None [] true))))]
    (when (not ok) (println "got {:?}, want {:?}" got want))
    ok))

(defn group-of [(const N i64)] [(caps (Option (re/Captures N))) (i i64)] (-> (Option re/Span))
  (match caps
    (Some [c] (re/group c i))
    (None [] (None))))

(defn counted [(calls (ptr i64))] (-> (slice u8))
  (store! calls (+ (load calls) 1))
  "xxabbbczz")

(deftest find-literal-fast-path
         (assert (same? (re/find "abc" "--abc--abc") (span 2 5)))
         (assert (same? (re/find "abc" "--ab-") (None)))
         (assert (same? (re/find "" "xyz") (span 0 0)))
         (assert (same? (re/find "^ab" "abab") (span 0 2)))
         (assert (same? (re/find "^ab" "xab") (None)))
         (assert (same? (re/find "ab$" "abab") (span 2 4)))
         (assert (same? (re/find "^ab$" "ab") (span 0 2)))
         (assert (same? (re/find "^$" "") (span 0 0)))
         (assert (same? (re/find "$" "abc") (span 3 3)))
         (assert (same? (re/find "\\$5" "cost: $5") (span 6 8)))
         (assert (same? (re/find-at "abc" "abcabc" 1) (span 3 6)))
         (assert (same? (re/find-at "abc" "abcabc" 4) (None)))
         (assert (same? (re/find-at "" "abc" 3) (span 3 3)))
         (assert (same? (re/find-at "" "abc" 4) (None)))
         (assert (same? (re/find-at "^a" "aa" 1) (None)))
         (assert (same? (re/find-at "a$" "aa" 1) (span 1 2))))

(deftest find-is-leftmost-first
         ; Leftmost-first (Perl, RE2, Rust), not leftmost-longest (POSIX): the first
         ; alternative that leads to a match wins even when a later one is longer.
         (assert (same? (re/find "a|ab" "ab") (span 0 1)))
         (assert (same? (re/find "ab|a" "ab") (span 0 2)))
         (assert (same? (re/find "(a|ab)(c|bcd)" "abcd") (span 0 4)))
         ; The leftmost start wins over a longer match further right.
         (assert (same? (re/find "b+|aaaa" "xbaaaa") (span 1 2)))
         ; Greedy and lazy quantifiers select different spans.
         (assert (same? (re/find "a+" "xaaay") (span 1 4)))
         (assert (same? (re/find "a+?" "xaaay") (span 1 2)))
         (assert (same? (re/find "a*?b" "aaab") (span 0 4)))
         (assert (same? (re/find "<.*>" "<a><b>") (span 0 6)))
         (assert (same? (re/find "<.*?>" "<a><b>") (span 0 3)))
         (assert (same? (re/find "a{2,4}" "aaaaa") (span 0 4)))
         (assert (same? (re/find "a{2,4}?" "aaaaa") (span 0 2)))
         (assert (same? (re/find "a{2,}?" "aaaaa") (span 0 2)))
         (assert (same? (re/find "a??b" "ab") (span 0 2)))
         (assert (same? (re/find "x*" "") (span 0 0)))
         (assert (same? (re/find "a*" "baa") (span 0 0))))

(deftest find-assertions-and-flags
         (assert (same? (re/find "\\bcat\\b" "concat cat") (span 7 10)))
         (assert (same? (re/find "\\Bcat" "cat concat") (span 7 10)))
         (assert (same? (re/find "^a|b" "xb") (span 1 2)))
         (assert (same? (re/find "a|b$" "ax") (span 0 1)))
         (assert (same? (re/find "(?m:^\\w+$)" "one\ntwo") (span 0 3)))
         (assert (same? (re/find "(?i:hello)" "say HeLLo") (span 4 9)))
         (assert (same? (re/find "a.c" "a\nc abc") (span 4 7)))
         (assert (same? (re/find "(?s:a.c)" "a\nc abc") (span 0 3)))
         ; `\b` looks at the byte before the start offset.
         (assert (same? (re/find-at "\\bcat" "concat cat" 3) (span 7 10)))
         (assert (same? (re/find-at "\\Bcat" "concat cat" 3) (span 3 6))))

(deftest find-past-the-bit-parallel-limit
         ; is-match? keeps one state per bit of a word; find allows 256 states.
         (assert (same? (re/find "x{100}"
                                 "--xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx--")
                        (span 2 102)))
         (assert (same? (re/find "x{100}"
                                 "--xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx--")
                        (None))))

(deftest find-evaluates-the-haystack-once
         (let [(mut calls) 0]
           (assert (same? (re/find "ab+c" (counted (mut calls))) (span 2 7)))
           (assert-eq (load calls) 1)
           (assert (same? (re/find-at "z" (counted (mut calls)) 3) (span 7 8)))
           (assert-eq (load calls) 2)
           (assert (same? (group-of (re/captures "(b)" (counted (mut calls))) 1)
                          (span 3 4)))
           (assert-eq (load calls) 3)))

(deftest captures-groups
         (let [hay "key=value; other=thing"
               caps (re/captures "(\\w+)=(\\w+)" hay)]
           (match caps
             (Some [c]
                   (do
                     (assert-eq (re/group-count c) 3)
                     (assert (same? (re/group c 0) (span 0 9)))
                     (assert (same? (re/group c 1) (span 0 3)))
                     (assert (same? (re/group c 2) (span 4 9)))
                     (assert (same? (re/group c 3) (None)))
                     (assert (same? (re/group c -1) (None)))
                     (match (re/group-bytes c hay 2)
                       (Some [b] (assert (= b "value")))
                       (None [] (assert false)))))
             (None [] (assert false)))))

(deftest captures-numbering-and-participation
         ; Groups are numbered by their opening parenthesis.
         (let [caps (re/captures "((a)(b))(?:c)(d)?" "abc")]
           (assert (same? (group-of caps 0) (span 0 3)))
           (assert (same? (group-of caps 1) (span 0 2)))
           (assert (same? (group-of caps 2) (span 0 1)))
           (assert (same? (group-of caps 3) (span 1 2)))
           ; (d)? did not participate.
           (assert (same? (group-of caps 4) (None))))
         ; A group inside an alternative that was not taken.
         (let [caps (re/captures "(a)|(b)" "b")]
           (assert (same? (group-of caps 1) (None)))
           (assert (same? (group-of caps 2) (span 0 1))))
         ; A repeated group reports its last iteration.
         (assert (same? (group-of (re/captures "(a|b)+" "abab") 1) (span 3 4)))
         (assert (same? (group-of (re/captures "(ab){2}" "ababab") 1)
                        (span 2 4)))
         (assert (same? (group-of (re/captures "(ab){1,3}" "ababab") 1)
                        (span 4 6)))
         (assert (same? (group-of (re/captures "(ab){1,3}?" "ababab") 1)
                        (span 0 2)))
         (assert (same? (group-of (re/captures "(a){0}b" "ab") 1) (None)))
         ; Leftmost-first alternation chooses which groups participate.
         (let [caps (re/captures "(a|ab)(c|bcd)(d*)" "abcd")]
           (assert (same? (group-of caps 1) (span 0 1)))
           (assert (same? (group-of caps 2) (span 1 4)))
           (assert (same? (group-of caps 3) (span 4 4))))
         (assert (same? (group-of (re/captures "(a*)+" "b") 1) (span 0 0)))
         (assert (same? (group-of (re/captures "(a*)+" "aa") 1) (span 0 2)))
         ; A loop iteration that matches empty is not taken (RE2's rule: a thread
         ; never revisits a state at the same position).
         (assert (same? (group-of (re/captures "(a*)*" "b") 1) (None)))
         (assert (same? (group-of (re/captures "(|a)*" "a") 0) (span 0 1)))
         (assert (same? (group-of (re/captures "x(a)" "abc") 0) (None))))

(deftest captures-log-line
         ; The motivating case: one access-log line split into its fields.
         (let [line
                 "10.0.0.7 - - [11/Oct/2026:10:00:00 +0000] \"GET /index.html HTTP/1.1\" 200 512 0.003"
               caps
                 (re/captures "^(\\S+) - - \\[([^\\]]+)\\] \"(\\S+) (\\S+) (\\S+)\" (\\d+) (\\d+) ([\\d.]+)$"
                              line)]
           (match caps
             (Some [c]
                   (do
                     (assert-eq (re/group-count c) 9)
                     (assert (= (unwrap (re/group-bytes c line 1)) "10.0.0.7"))
                     (assert (= (unwrap (re/group-bytes c line 2))
                                "11/Oct/2026:10:00:00 +0000"))
                     (assert (= (unwrap (re/group-bytes c line 3)) "GET"))
                     (assert (= (unwrap (re/group-bytes c line 4))
                                "/index.html"))
                     (assert (= (unwrap (re/group-bytes c line 5)) "HTTP/1.1"))
                     (assert (= (unwrap (re/group-bytes c line 6)) "200"))
                     (assert (= (unwrap (re/group-bytes c line 7)) "512"))
                     (assert (= (unwrap (re/group-bytes c line 8)) "0.003"))))
             (None [] (assert false)))))

(defn unwrap [(o (Option (slice u8)))] (-> (slice u8))
  (match o
    (Some [b] b)
    (None [] "<none>")))

(deftest find-iter-non-overlapping
         (let [(mut it) (re/find-iter "\\d+" "a1 22 333 b")]
           (assert (same? (next (mut it)) (span 1 2)))
           (assert (same? (next (mut it)) (span 3 5)))
           (assert (same? (next (mut it)) (span 6 9)))
           (assert (same? (next (mut it)) (None)))
           (assert (same? (next (mut it)) (None))))
         (assert-eq (count (re/find-iter "o" "foo boo")) 4)
         (assert-eq (count (re/find-iter "xyz" "foo")) 0)
         (assert-eq (fold (fn [acc s] (+ acc (re/span-len s)))
                          0
                          (re/find-iter "[a-z]+" "ab cde f"))
                    6))

(deftest find-iter-empty-matches
         ; An empty match that abuts the previous match is skipped; after an empty
         ; match the search resumes one byte later (RE2, Go and Rust behave the same).
         (let [(mut it) (re/find-iter "a*" "baaab")]
           (assert (same? (next (mut it)) (span 0 0)))
           (assert (same? (next (mut it)) (span 1 4)))
           (assert (same? (next (mut it)) (span 5 5)))
           (assert (same? (next (mut it)) (None))))
         (assert-eq (count (re/find-iter "" "abc")) 4)
         (assert-eq (count (re/find-iter "" "")) 1)
         (let [(mut it) (re/find-iter "\\b" "ab cd")]
           (assert (same? (next (mut it)) (span 0 0)))
           (assert (same? (next (mut it)) (span 2 2)))
           (assert (same? (next (mut it)) (span 3 3)))
           (assert (same? (next (mut it)) (span 5 5)))
           (assert (same? (next (mut it)) (None)))))

(deftest captures-iter-fields
         (let [hay "x=1 y= z=33"
               (mut it) (re/captures-iter "(\\w+)=(\\d+)?" hay)]
           (match (next (mut it))
             (Some [c]
                   (do
                     (assert (same? (re/group c 1) (span 0 1)))
                     (assert (same? (re/group c 2) (span 2 3)))))
             (None [] (assert false)))
           (match (next (mut it))
             (Some [c]
                   (do
                     (assert (same? (re/group c 1) (span 4 5)))
                     (assert (same? (re/group c 2) (None)))))
             (None [] (assert false)))
           (match (next (mut it))
             (Some [c]
                   (do
                     (assert (same? (re/group c 1) (span 7 8)))
                     (assert (same? (re/group c 2) (span 9 11)))))
             (None [] (assert false)))
           (assert (match (next (mut it)) (Some [c] false) (None [] true))))
         (let [(mut lines) 0]
           (for c
             (re/captures-iter "(?m:^(\\w+): (\\d+)$)"
                               "a: 1\nbb: 22\nbad\nc: 3")
             (set! lines (+ lines 1)))
           (assert-eq lines 3)))
