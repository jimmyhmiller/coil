(module probe2)
(import "coil.scheme" :use *)

; binary tree: (cons left right), leaf = '()
(define (make-tree d)
  (if (< d 1) '() (cons (make-tree (- d 1)) (make-tree (- d 1)))))

(define (check-tree t)
  (if (scm-null? t) 1 (+ 1 (+ (check-tree (car t)) (check-tree (cdr t))))))

; vectors
(define (vfill v i n)
  (if (< i n) (begin (scm-vector-set! v i (* i 2)) (vfill v (+ i 1) n)) v))

(defn main [] (-> i64)
  (display (check-tree (make-tree 10)))
  (newline)
  (scm-let ((v (scm-make-vector 5)))
    (vfill v 0 5)
    (display (scm-vector-ref v 3))
    (newline))
  (fixnum-value (mk-fixnum 0)))
