(module probe7)
(import "coil.scheme" :use *)
(define (build n acc) (if (< n 1) acc (build (- n 1) (cons n acc))))
(defn main [] (-> i64)
  (scm-let ((live (build 1000 '())))
    (display (mk-fixnum (gc-sp))) (newline)      ; shadow-stack depth with a live local
    (display (mk-fixnum (gc-live))) (newline)
    (collect)
    (display (mk-fixnum (gc-live))) (newline)    ; live count AFTER collect
    (fixnum-value (mk-fixnum 0))))
