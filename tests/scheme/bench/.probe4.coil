(module probe4)
(import "coil.scheme" :use *)
(define (build n acc) (if (< n 1) acc (build (- n 1) (cons n acc))))
(define (sum l acc) (if (scm-null? l) acc (sum (cdr l) (+ acc (car l)))))
; hold a big live list while churning garbage: forces repeated marking of live data
(define (churn k live total)
  (if (< k 1) total
      (churn (- k 1) live (+ total (sum (build 20000 '()) 0)))))
(defn main [] (-> i64)
  (scm-let ((live (build 400000 '())))
    (display (churn 200 live 0)) (newline)
    (display (sum live 0)) (newline)
    (display (mk-fixnum (gc-collections))) (newline))
  (fixnum-value (mk-fixnum 0)))
