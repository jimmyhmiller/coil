(module probe1)
(import "coil.scheme" :use *)

(define (build n acc)
  (if (< n 1) acc (build (- n 1) (cons n acc))))

(define (sum l acc)
  (if (scm-null? l) acc (sum (cdr l) (+ acc (car l)))))

(defn main [] (-> i64)
  (display (sum (build 100 '()) 0))
  (newline)
  (display (scm-length (build 10 '())))
  (newline)
  (display (scm-reverse (build 5 '())))
  (newline)
  (fixnum-value (mk-fixnum 0)))
