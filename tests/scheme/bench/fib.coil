(module bench-fib)
(import "coil.scheme" :use *)

; Plain Scheme — bare literals, no runtime spellings. The dialect's whole-tree
; pass lowers them; `define` expands to `defn`, so this is native code.
(define (fib n)
  (if (scm-lt n 2)
      n
      (scm-add (fib (scm-sub n 1)) (fib (scm-sub n 2)))))

; ⚠ `main`'s value IS the process exit code, and inside a dialect module the
; whole-tree pass lowers a bare `0` to `(mk-fixnum 0)` — whose tagged word is 1.
; So a Scheme module's `main` cannot end in a bare literal; `(fixnum-value 0)`
; would work, but the honest spelling is the raw i64 the host wants.
(defn main [] (-> i64)
  (scm-display (fib 30))
  (scm-newline)
  (fixnum-value (mk-fixnum 0)))
