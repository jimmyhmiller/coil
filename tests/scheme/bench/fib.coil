(module bench-fib)
(import "coil.scheme" :use *)

; The same program in the dialect. `define` is a macro over `defn`, so this
; compiles to a native Coil function — there is no interpreter under it.
(define (fib n)
  (if (truthy? (scm-lt n (mk-fixnum 2)))
      n
      (scm-add (fib (scm-sub n (mk-fixnum 1)))
               (fib (scm-sub n (mk-fixnum 2))))))

(defn main [] (-> i64)
  (scm-display (fib (mk-fixnum 30)))
  (scm-newline)
  0)
