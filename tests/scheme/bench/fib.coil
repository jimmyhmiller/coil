(module bench-fib)
(import "coil.scheme" :use *)

;; The body below is IDENTICAL to fib.scm — `<`, `+`, `-`, `display`, `newline`,
;; bare integer literals. Not Coil spellings of Scheme, actual R5RS names.
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

;; ⚠ `main`'s value is the process EXIT CODE, and inside a dialect module the
;; whole-tree pass lowers a bare `0` to `(mk-fixnum 0)` — whose tagged word is 1.
;; So a Scheme module's main cannot end in a bare literal.
(defn main [] (-> i64)
  (display (fib 30))
  (newline)
  (fixnum-value (mk-fixnum 0)))
