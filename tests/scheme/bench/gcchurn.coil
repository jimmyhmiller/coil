(module bench-gcchurn)
(import "coil.scheme" :use *)

;; The same program as gcchurn.scm — byte-identical below the `main` wrapper.
;;
;; ⚠ THIS DRIVER'S EXISTENCE IS THE RESULT. gcchurn.scm carried a long comment
;; explaining why it deliberately had NO .coil counterpart: the collector freed
;; values that were still reachable, because nothing populated the shadow stack.
;; `mark-roots` walked an empty root set and the sweep reclaimed the live heap, so
;; a 200 x 12,000 run was killed at 120s having produced nothing.
;;
;; That was true and is no longer. src/apps/scheme/rooting.coil now frames every
;; Scheme procedure and roots what must survive an allocation, so this case runs
;; and agrees with Chez. The dash in the benchmark table was a real finding about
;; the collector, not a property of this program.
;;
;; The shape is the one most favourable to a GENERATIONAL collector and least
;; favourable to ours: the live set is a single round's list, so nearly everything
;; is garbage when a collection runs. Chez's minor collection copies only
;; survivors and does work proportional to what LIVES; our mark-sweep walks every
;; slab to rebuild the free list and does work proportional to the HEAP. That is
;; the comparison this case exists to make, and it is the one the other three
;; cannot — they are sized so the live set never crosses the threshold.
(define (build n acc)
  (if (< n 1) acc (build (- n 1) (cons n acc))))

(define (sum l acc)
  (if (null? l) acc (sum (cdr l) (+ acc (car l)))))

(define (rounds k n total)
  (if (< k 1) total (rounds (- k 1) n (+ total (sum (build n '()) 0)))))

;; 200 x 12,000 = 2.4M pairs, matching gcchurn.scm exactly. The round count is
;; part of the comparison and must not drift from the .scm — the harness checks
;; that every implementation prints the same answer, which only means something
;; if they ran the same work.
(defn main [] (-> i64)
  (display (rounds 200 12000 0))
  (newline)
  (fixnum-value (mk-fixnum 0)))
