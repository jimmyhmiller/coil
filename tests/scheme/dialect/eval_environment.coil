(module eval-environment)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((report (scheme-report-environment 5))
        (null (null-environment 5))
        (interaction (interaction-environment)))
    (write (list (environment? report)
                 (environment? null)
                 (environment? interaction)))
    (newline)
    (write (eval '(+ 1 2 3 4) report))
    (newline)
    (write (eval '((lambda (x) (* x x)) 9) report))
    (newline)
    (write
      (eval '(begin
               (define (factorial n)
                 (if (= n 0) 1 (* n (factorial (- n 1)))))
               (factorial 8))
            report))
    (newline)
    (write (procedure? (eval '+ report)))
    (newline)
    (write (eval '(if #t 17 23) null))
    (newline)
    (write (eval '(begin (define x 1) (set! x (+ x 4)) x) interaction))
    (newline)
    (write
      (eval '(let ((x 10))
               (list (let ((x 2) (y x)) y)
                     (let* ((x 2) (y x)) y)))
            report))
    (newline)
    (write
      (eval '(let loop ((n 10) (sum 0))
               (if (= n 0) sum (loop (- n 1) (+ sum n))))
            report))
    (newline)
    (write
      (eval '(letrec ((even? (lambda (n) (if (= n 0) #t (odd? (- n 1)))))
                      (odd? (lambda (n) (if (= n 0) #f (even? (- n 1))))))
               (list (even? 20) (odd? 20)))
            report))
    (newline)
    (write
      (eval '(list (and 1 2 3)
                   (or #f #f 9)
                   (cond ((= 1 2) 'no) ((+ 2 3) => list) (else 'bad))
                   (case 2 ((1) 'one) ((2 3) 'two-or-three) (else 'bad)))
            report))
    (newline)
    (write
      (eval '(list (string->number "ff" 16)
                   (number->string 255 16)
                   (map (lambda (x) (* x x)) '(1 2 3 4))
                   (append '(a b) '(c) '(d e))
                   (reverse '(1 2 3))
                   (list-ref '(10 20 30) 1)
                   (gcd 84 126 210)
                   (lcm 6 10 15))
            report))
    (newline)
    (write
      (eval '(let ((s (string #\a #\b #\c))
                   (v (vector 1 2 3))
                   (p (cons 'left 'right)))
               (string-set! s 1 #\x)
               (vector-set! v 2 9)
               (set-car! p 'changed)
               (list s (vector->list v) p
                     (char-ci=? #\A #\a)
                     (char->integer #\A)))
            report))
    (newline)
    (write
      (eval '(let loop ((n 800) (xs '()))
               (if (= n 0) (length xs) (loop (- n 1) (cons n xs))))
            report))
    (newline)
    (write
      (eval '(do ((i 0 (+ i 1)) (previous 99 i))
                 ((= i 5) previous))
            report))
    (newline)
    (write
      (eval '(let ((count 0) (promise #f))
               (set! promise (delay (begin (set! count (+ count 1)) count)))
               (list (force promise) (force promise) count))
            report))
    (newline)
    (write
      (eval '(quasiquote
               (a (unquote (+ 1 2))
                  (unquote-splicing (list 4 5))
                  #(v (unquote (+ 5 1)))))
            report))
    (newline)
    (write
      (eval '(list
               (caaaar (cons (cons (cons (cons 'ok 'x) 'y) 'z) 'q))
               (cddddr (cons 'a (cons 'b (cons 'c (cons 'd 'ok))))))
            report))
    (newline)
    (write
      (eval '(list (string<? "a" "b" "c")
                   (string-ci=? "A" "a" "A")
                   (char<? #\a #\b #\c)
                   (char-ci=? #\A #\a #\A))
            report))
    (newline)
    (write
      (eval '(call-with-input-file
               "tests/scheme/fixtures/datums.scm"
               (lambda (port) (read port)))
            report))
    (newline)
    (write
      (eval '(call-with-input-file
               "tests/scheme/fixtures/input.txt"
               (lambda (port)
                 (list (char-ready? port) (read-char port) (char-ready? port))))
            report))
    (newline)
    (write
      (eval '(list (complex? 3/4) (real? 1.5) (rational? 7)
                   (numerator -6/8) (denominator -6/8) (magnitude -12))
            report))
    (newline)
    (let ((loader load))
      (loader "tests/scheme/fixtures/load.scm" interaction)
      (let ((first (eval '(loaded-add 1) interaction)))
        (apply loader (list "tests/scheme/fixtures/load.scm" interaction))
        (write (list first (eval 'loaded-base interaction)))))
    (newline)
    (write
      (eval '(let ((z (make-rectangular 3 4)))
               (list (complex? z) (real? z)
                     (real-part (+ z 2)) (imag-part (* z z))))
            report))
    (newline)
    (write
      (eval '(begin
               (define-syntax add-with-temp
                 (syntax-rules ()
                   ((_ x) (let ((temp 1)) (+ temp x)))))
               (define-syntax collect
                 (syntax-rules () ((_ x ...) (list x ...))))
               (list
                 (let ((temp 100) (+ (lambda (a b) 999)))
                   (add-with-temp temp))
                 (collect 1 2 3)
                 (let-syntax
                   ((twice (syntax-rules () ((_ x) (+ x x)))))
                   (twice 21))
                 (letrec-syntax
                   ((ping (syntax-rules () ((_ x) (pong x))))
                    (pong (syntax-rules () ((_ x) x))))
                   (ping 42))))
            report))
    (newline)
    (fixnum-value (mk-fixnum 0))))
