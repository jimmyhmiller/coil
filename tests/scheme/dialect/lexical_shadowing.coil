(module lexical-shadowing)
(import "coil.scheme" :use *)

(define (add-two x) (+ x 2))
(define (collect first . rest) (cons first rest))

(defn main [] (-> i64)
  (write
    (list
      (let ((f add-two)) (f 40))
      (map add-two '(1 2 3))
      (let ((+ (lambda (a b) (list 'shadowed a b)))) (+ 4 5))
      (let ((car (lambda (x) 'local-car))) (car '(ignored)))
      (let ((f collect)) (f 1 2 3 4))))
  (newline)
  (fixnum-value (mk-fixnum 0)))
