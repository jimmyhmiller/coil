(module numeric-flonum)
;; Public R5RS inexact-number smoke test. This deliberately crosses the reader,
;; dialect lowering, heap representation, arithmetic, predicates and printer.
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (display (list (number? 0.5) (inexact? 0.5) (exact? 0.5)
                 (integer? 3.0) (integer? 3.5) (integer? 1e300)))
  (newline)
  (display (+ 1 0.5))
  (newline)
  (display (* 2.0 3))
  (newline)
  (display (- 5.5 2))
  (newline)
  (display (list (< 1 1.5 2) (= 2.0 2) (> 3.0 2)
                 (zero? 0.0) (positive? 0.25) (negative? -0.25)))
  (newline)
  (display (eqv? 0.5 0.5))
  (newline)
  (write '(0.5 1.25))
  (newline)
  (display (list (abs -2.5) (max 9 2.5) (min 9 2.5)))
  (newline)
  (display (list (floor -1.2) (ceiling -1.2) (truncate -1.8)
                 (round 2.5) (round 3.5) (round -2.5) (round -3.5)))
  (newline)
  (display (list (= (floor 1e300) 1e300)
                 (= (ceiling 1e300) 1e300)
                 (= (truncate 1e300) 1e300)
                 (= (round 1e300) 1e300)))
  (newline)
  (display (list (exact->inexact 7) (even? 4.0) (odd? 3.0)))
  (newline)
  (display (list (/ 1 2) (/ -6 8) (/ 8 4) (/ 2) (/ 1 2.0)))
  (newline)
  (display (list (+ (/ 1 2) (/ 1 3))
                 (- (/ 3 4) (/ 1 4))
                 (* (/ 2 3) (/ 9 4))))
  (newline)
  (display (list (number? (/ 1 2)) (exact? (/ 1 2))
                 (inexact? (/ 1 2)) (= (/ 1 2) (/ 2 4))
                 (eqv? (/ 1 2) (/ 2 4))
                 (exact->inexact (/ 1 2))))
  (newline)
  (display (list (floor (/ -3 2)) (ceiling (/ -3 2))
                 (truncate (/ -3 2)) (round (/ 1 2))
                 (round (/ 3 2)) (round (/ 5 2)) (round (/ -3 2))))
  (newline)
  (display (list 3/4 -6/8 '5/6 `(1/3)))
  (newline)
  (display (string->number "6/8"))
  (newline)
  (write (number->string -3/4))
  (newline)
  (display (list (string->number "1.25") (string->number "-2e1")
                 (= (string->number (number->string 0.1)) 0.1)))
  (newline)
  (display (list (inexact->exact 0.5) (inexact->exact 0.1)
                 (exact? (inexact->exact 0.1))
                 (= (exact->inexact (inexact->exact 0.1)) 0.1)))
  (newline)
  (display (list (sqrt 4) (sqrt 9/16)
                 (> (sqrt 2) 1.4) (< (sqrt 2) 1.5)
                 (= (exp 0) 1) (= (log 1) 0)))
  (newline)
  (display (list (= (sin 0) 0) (= (cos 0) 1) (= (tan 0) 0)
                 (= (asin 0) 0) (= (acos 1) 0)
                 (= (atan 0) 0) (= (atan 0 1) 0)))
  (newline)
  (display (list (expt 2 -3) (expt 4 0.5)))
  (newline)
  (display (list (> (sin 1.5707963267948966) 0.999999)
                 (< (cos 3.141592653589793) -0.999999)
                 (> (log (exp 1)) 0.999999)
                 (< (log (exp 1)) 1.000001)
                 (> (atan 1) 0.785397) (< (atan 1) 0.785399)))
  (newline)
  (display (expt 2 100))
  (newline)
  (display (list (+ (expt 2 60) (expt 2 60))
                 (- 0 (expt 2 70))
                 (* (expt 2 40) (expt 2 40))))
  (newline)
  (display (list (number? (expt 2 100)) (integer? (expt 2 100))
                 (exact? (expt 2 100)) (even? (expt 2 100))
                 (positive? (expt 2 100))
                 (= (expt 2 100) (expt 2 100))
                 (< (expt 2 99) (expt 2 100))))
  (newline)
  (display 1267650600228229401496703205376)
  (newline)
  (display '(1267650600228229401496703205376))
  (newline)
  (display (list (= (string->number "1267650600228229401496703205376")
                    (expt 2 100))
                 (string=? (number->string (expt 2 100))
                           "1267650600228229401496703205376")))
  (newline)
  (write (number->string (expt 2 100) 16))
  (newline)
  (display (= (string->number (number->string (expt 2 100) 16) 16)
              (expt 2 100)))
  (newline)
  (display (list (quotient (expt 2 100) 3)
                 (remainder (expt 2 100) 3)
                 (modulo (- 0 (expt 2 100)) 3)))
  (newline)
  (display (list (gcd (expt 2 100) (* 3 (expt 2 80)))
                 (lcm (expt 2 70) (expt 2 80))))
  (newline)
  (display (/ (expt 2 100) 3))
  (newline)
  (display (list (* (/ (expt 2 100) 3) 3)
                 (+ (/ (expt 2 100) 3) 1/3)
                 (= (/ (expt 2 100) 3)
                    (/ (* 2 (expt 2 100)) 6))))
  (newline)
  (display 1267650600228229401496703205376/3)
  (newline)
  (display '(1267650600228229401496703205376/3))
  (newline)
  (display (list (= (string->number "1267650600228229401496703205376/3")
                    (/ (expt 2 100) 3))
                 (string? (number->string (/ (expt 2 100) 3)))
                 (string=? (number->string (/ (expt 2 100) 3))
                           "1267650600228229401496703205376/3")))
  (newline)
  (display (list #b101 #o17 #d19 #xFF #e1.25 #i10 #e#x10 #x#i10))
  (newline)
  (display '(#x2a #e#b11 #i#o10))
  (newline)
  (display (list (string->number "#x10000000000000000000000000")
                 (string->number "#e1.25")
                 (string->number "#i#b101")
                 (string->number "#xg")
                 (string->number "#eff" 16)
                 (string->number "#xff" 10)))
  (newline)
  (display (list (floor (/ (expt 2 100) 3))
                 (ceiling (/ (expt 2 100) 3))
                 (truncate (/ (- 0 (expt 2 100)) 3))
                 (round (/ (expt 2 100) 3))
                 (round (+ (expt 2 100) 1/2))
                 (round (+ (expt 2 100) 3/2))))
  (newline)
  (display (list (exact? (inexact->exact 1e300))
                 (= (exact->inexact (inexact->exact 1e300)) 1e300)
                 (exact? (inexact->exact 1e-100))))
  (newline)
  (display (list (sqrt (expt 2 200))
                 (sqrt (/ (expt 2 200) 9))
                 (inexact? (sqrt (+ (expt 2 200) 1)))
                 (positive? (/ (expt 2 100) 3))
                 (inexact? (sin (/ (expt 2 100) 3)))))
  (newline)
  (display (list (complex? 3/4) (real? 1.25) (rational? 1/3)
                 (numerator -6/8) (denominator -6/8)
                 (numerator 0.5) (denominator 0.5)
                 (magnitude -9)
                 (rationalize 3/10 1/10)
                 (rationalize 0.3 1/10)
                 (> (angle -1) 3.14) (< (angle -1) 3.15)
                 (= (angle 1) 0)))
  (newline)
  (display (list (number->string 1.0)
                 (number->string -0.0)
                 (inexact? (string->number (number->string 1.0)))
                 (inexact? (string->number (number->string -0.0)))))
  (newline)
  (display (list (number->string
                   (exact->inexact 17154109944140030/17154109944140437))
                 (= (exact->inexact 17154109944140030/17154109944140437)
                    0.99999999999997624)))
  (newline)
  (display (list (= (exact->inexact
                      (/ (+ (expt 2 2000) 1) (expt 2 2000))) 1.0)
                 (= (exact->inexact (/ 1 (expt 2 1074)))
                    4.9406564584124654e-324)
                 (zero? (exact->inexact (/ 1 (expt 2 1075))))))
  (newline)
  (display (list #e0.1 #e1e-3 #e1.2e2 #e-0.125
                 (string->number "#e0.1")
                 (string->number "#e1e-3")
                 (string->number "#e1.2e2")))
  (newline)
  (let ((p (open-input-file "tests/scheme/fixtures/exact-decimals.scm")))
    (display (list (read p) (read p) (read p) (read p) (read p) (read p)))
    (newline)
    (close-input-port p))
  (display (list #e0.1+0.2i (exact? #e0.1+0.2i) #e1.5@0
                 (string->number "#e0.1+0.2i")
                 (string->number "#e1.5@0")
                 (string->number "#e1@1")))
  (newline)
  (fixnum-value (mk-fixnum 0)))
