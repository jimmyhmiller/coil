(module case05)
;; Public-surface counterpart of tests/scheme/cases/05-derived-forms.scm.
(import "coil.scheme" :use *)

(define p (delay (begin 'forced 42)))

(define (even-88?)
  (letrec ((e? (lambda (n) (if (= n 0) #t (o? (- n 1)))))
           (o? (lambda (n) (if (= n 0) #f (e? (- n 1))))))
    (e? 88)))

(define (arrow-cadr found)
  (if found (cadr found) 'none))

(define internal-offset 100)
(define (internal-defined n)
  (define internal-offset 2)
  (define (even? x) (if (= x 0) #t (odd? (- x 1))))
  (define (odd? x) (if (= x 0) #f (even? (- x 1))))
  (list (+ n internal-offset) (even? n) (odd? n)))

(defn main [] (-> i64)
  (display (let ((a 1) (b 2)) (+ a b)))
  (newline)
  (display (let* ((a 1) (b (+ a 1))) (list a b)))
  (newline)
  (display (even-88?))
  (newline)
  (display (do ((i 0 (+ i 1)) (acc '() (cons i acc)))
               ((= i 5) (reverse acc))))
  (newline)
  ; A missing step retains that variable while other variables advance.
  (display (do ((i 0 (+ i 1)) (held 7))
               ((= i 3) (list i held))))
  (newline)
  (let ((found (assv 1 '((1 a) (2 b)))))
    (display (arrow-cadr found)))
  (newline)
  (display (cond (#f 'no) (else 'yes)))
  (newline)
  (display (case 3 ((1 2) 'low) ((3 4) 'mid) (else 'high)))
  (newline)
  (display (list (and) (or) (and 1 2) (or #f 2) (and #f 1)))
  (newline)
  (display (list (force p) (force p)))
  (newline)
  (display (let () 42))
  (newline)
  (display (internal-defined 10))
  (newline)
  (display
    ((lambda (n)
       (define internal-offset 3)
       (define (even? x) (if (= x 0) #t (odd? (- x 1))))
       (define (odd? x) (if (= x 0) #f (even? (- x 1))))
       (list (+ n internal-offset) (even? n) (odd? n)))
     5))
  (newline)
  (fixnum-value (mk-fixnum 0)))
