(module scheme-tail-closure)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (display
    (let ((step (lambda (proc n)
                  (if (= n 0) 'closure-done
                    (proc proc (- n 1))))))
      (step step 10000000)))
  (newline)
  (display
    (let ((step (lambda (proc n)
                  (if (= n 0) 'apply-done
                    (apply proc (list proc (- n 1)))))))
      (step step 1000000)))
  (newline)
  (display
    (let ((step (lambda (proc n)
                  (if (= n 0) 'values-done
                    (call-with-values
                      (lambda () (values proc (- n 1)))
                      (lambda (next m) (next next m)))))))
      (step step 200000)))
  (newline)
  (display
    (let ((step (lambda (proc n . rest)
                  (if (= n 0) 'variadic-done
                    (apply proc proc (- n 1) rest)))))
      (step step 200000)))
  (newline)
  (fixnum-value 0))
