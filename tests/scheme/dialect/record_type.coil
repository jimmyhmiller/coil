(module record-type)
(import "coil.scheme" :use *)

(define-record-type point
  (fields x (mutable y))
  (nongenerative point-v1))

(define-record-type (cell make-cell cell?)
  (fields (immutable value))
  (nongenerative cell-v1))

(define-record-type animal
  (fields name)
  (nongenerative animal-v1))

(define-record-type dog
  (parent animal)
  (fields (mutable age))
  (nongenerative dog-v1))

(defn main [] (-> i64)
  (let ((p (make-point 10 20))
        (c (make-cell 7))
        (d (make-dog 'fido 3))
        (p2 ((record-constructor (record-type-descriptor point)) 8 9)))
    (display (point? p)) (newline)
    (display (point-x p)) (newline)
    (point-y-set! p 42)
    (display (point-y p)) (newline)
    (display (cell? c)) (newline)
    (display (cell-value c)) (newline)
    (display (animal? d)) (newline)
    (display (dog? d)) (newline)
    (display (animal-name d)) (newline)
    (dog-age-set! d 4)
    (display (dog-age d)) (newline)
    (display (point-x p2)) (newline))
  0)
