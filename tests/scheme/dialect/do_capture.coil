(module do-capture)
(import "coil.scheme" :use *)

(define (copy-backwards buf)
  (define (copy)
    (let ((tmp (make-vector (vector-length buf) 0)))
      (do ((i (- (vector-length buf) 1) (- i 1)))
          ((< i 0) tmp)
        (vector-set! tmp i (vector-ref buf i)))
      (set! buf tmp)
      buf))
  (copy))

(defn main [] (-> i64)
  (let ((result (copy-backwards (vector 10 20 30))))
    (display (vector-ref result 0))
    (newline))
  0)
