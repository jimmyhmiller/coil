(module reader-identifiers)
(import "coil.scheme" :use *)

(define (read-all port reversed)
  (let ((datum (read port)))
    (if (eof-object? datum)
        (reverse reversed)
        (read-all port (cons datum reversed)))))

(defn main [] (-> i64)
  (let ((port (open-input-file "tests/scheme/fixtures/identifier-tokens.scm")))
    (write (read-all port '()))
    (newline)
    (close-input-port port))
  (fixnum-value (mk-fixnum 0)))
