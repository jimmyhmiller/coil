(module identifier-case)
(import "coil.scheme" :use *)



(DEFINE MiXeD 10)
(DEFINE (AdD-One X) (+ x 1))
(DEFINE-SYNTAX My-When
  (SYNTAX-RULES ()
    ((_ test body) (IF test body 'skipped))))

(defn main [] (-> i64)
  (WRITE
    (LIST mixed MIXED
          (ADD-ONE Mixed)
          (LET ((VaLuE 3)) VALUE)
          (LET LoOp ((N 5) (SuM 0))
            (IF (= n 0) sum (LOOP (- N 1) (+ SUM n))))
          (MY-WHEN #T 'Worked)
          (EQUAL? '(FOO Foo foo) '(foo foo foo))))
  (NEWLINE)
  (fixnum-value (mk-fixnum 0)))
