(module foreign-procedure)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((c-getpid (foreign-procedure "getpid" () int))
        (c-abs (foreign-procedure "abs" (int) int))
        (c-strlen (foreign-procedure "strlen" (string) size_t)))
    ;; The exact PID is deliberately not snapshotted; positivity proves the
    ;; zero-argument call crossed the native boundary and returned a Scheme value.
    (display (> (c-getpid) 0)) (newline)
    (display (c-abs -42)) (newline)
    (display (c-strlen "coil")) (newline)
    (let ((bv (make-bytevector 4 7)))
      (bytevector-u8-set! bv 2 99)
      (display (bytevector-u8-ref bv 2)) (newline)
      (display (bytevector-length bv)) (newline)))
  0)
