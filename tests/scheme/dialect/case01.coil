(module case01)
;; Case 01 — the irreducible core: quote, if, lambda, define, set!, begin.
;;
;; The dialect equivalent of tests/scheme/cases/01-core-eval.scm, run against
;; tests/scheme/expected/01-core-eval.txt. Scheme syntax IS Coil syntax here —
;; the source below is the .scm case verbatim, wrapped in a module that imports
;; `coil.scheme` (the dialect's opt-in marker) and a `main` that runs it.
;;
;; ⚠ NOT NAMED `coil.scheme.*`. Both dialect passes skip any module under that
;; prefix, because the dialect's own runtime is ordinary Coil. A test file named
;; that way would silently not be rewritten at all.
(import "coil.scheme" :use *)

;; Top level, exactly as the case writes it. `define` of a variable and `define`
;; of a procedure — including both variadic shapes — are top-level forms, so they
;; live here rather than inside `main`.
(define x 41)

(define (f . rest) rest)
(define (g a . rest) (list a rest))

(defn main [] (-> i64)
  ;; `(set! x (+ x 1))` — `set!` is reserved as Coil's 3-argument Set method, so
  ;; forms.coil routes the 2-argument Scheme spelling to `scm-set!`.
  (set! x (+ x 1))
  (display x) (newline)

  ;; R5RS's `(if #f #f)` is the unspecified value, which has no printed
  ;; representation to compare against — hence the case's third arm: with #f as
  ;; the test, the false branch is taken and a quoted symbol is what gets
  ;; displayed.
  (display (if #f #f 'unspecified-is-not-compared)) (newline)

  ;; An APPLIED lambda. R5RS §4.2.2 defines `let` as exactly this application, so
  ;; forms.coil rewrites it to `scm-let` — semantics-preserving by construction.
  (display ((lambda (a b) (* a b)) 6 7)) (newline)

  ;; Variadic calls. `defn` has no runtime rest parameter, so the surplus
  ;; arguments are collected into a `list` at the CALL SITE — which is why these
  ;; have to be direct calls the pass can see.
  (display (f 1 2 3)) (newline)
  (display (g 1 2 3)) (newline)

  (display (quote (a b c))) (newline)

  (begin (display "seq") (newline))

  ;; ⚠ main's value is the EXIT CODE and a bare 0 lowers to (mk-fixnum 0) = 1.
  (fixnum-value (mk-fixnum 0)))
