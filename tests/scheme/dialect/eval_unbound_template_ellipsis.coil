(module eval-unbound-template-ellipsis)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((environment (scheme-report-environment 5)))
    (eval '(define-syntax invalid-repeat
             (syntax-rules () ((_ value) (list value introduced ...))))
          environment)
    (eval '(invalid-repeat 1) environment))
  (fixnum-value (mk-fixnum 0)))
