(module numeric-fixnum)
;; The exact-integer subset of case 08. This remains separate until the required
;; bignum/rational/inexact tower makes the complete oracle representable.
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (display (expt 2 20))
  (newline)
  (display (list (quotient 7 2) (remainder 7 2) (modulo -7 2)))
  (newline)
  (display (list (max 1 2 3) (min 1 2 3) (abs -4)
                 (gcd 32 -36) (lcm 32 -36)))
  (newline)
  (display (string->symbol
             (list->string
               (map char-downcase
                    (string->list (number->string 255 16))))))
  (newline)
  (display (string->number "ff" 16))
  (newline)
  (display (list (exact? 1) (inexact? 1)))
  (newline)
  (display
    (list (quotient -1152921504606846976 -1)
          (abs -1152921504606846976)
          (remainder -1152921504606846976 -1)
          (modulo -1152921504606846976 -1)))
  (newline)
  (fixnum-value (mk-fixnum 0)))
