(module scheme-cond-quoted-symbol)
(import "coil.scheme" :use *)

(define (spell value)
  (cond
    ((eq? value 'nil) "nil")
    (else "other")))

(defn main [] (-> i64)
  (display (spell (string->symbol "nil")))
  (newline)
  (display (spell (string->symbol "something-else")))
  (newline)
  (fixnum-value (mk-fixnum 0)))
