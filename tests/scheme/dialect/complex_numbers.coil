(module scheme-complex-numbers)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((z (make-rectangular 3 4))
        (w (make-rectangular 1 -2)))
    (write
      (list z w (number? z) (complex? z) (real? z) (rational? z)
            (exact? z) (inexact? z)
            (real-part z) (imag-part z)
            (real-part (+ z 2)) (imag-part (+ z 2))
            (real-part (* z w)) (imag-part (* z w))
            (real-part (/ z w)) (imag-part (/ z w))
            (magnitude z)
            (= z (make-rectangular 3 4))
            (number->string z)
            (real-part (string->number "3+4i"))
            (imag-part (string->number "3+4i"))
            (real-part (string->number "-2i"))
            (imag-part (string->number "-2i"))
            (real-part 3+4i) (imag-part 3+4i)
            (equal? '3+4i z)
            (real-part 2@0) (imag-part 2@0)
            (real-part (string->number "2@0"))
            (< (abs (- (real-part (expt 2+0i 3)) 8)) 0.000000001)
            (< (abs (imag-part (expt 2+0i 3))) 0.000000001)
            (< 3.14 (imag-part (log -1)) 3.15)
            (< (abs (- (real-part (exp (log z))) 3)) 0.000000001)
            (< (abs (- (imag-part (exp (log z))) 4)) 0.000000001)
            (< (abs (real-part (sin 0+1i))) 0.000000001)
            (< 1.17 (imag-part (sin 0+1i)) 1.18)
            (< 1.54 (real-part (cos 0+1i)) 1.55)
            (< (abs (imag-part (cos 0+1i))) 0.000000001)
            (< 1.56 (real-part (asin 2)) 1.58)
            (real-part (sqrt -4)) (imag-part (sqrt -4))))
    (newline))
  (display
    (list (number->string (sqrt -0.0))
          (< 3.14 (angle -0.0) 3.15)
          (= (angle 0.0) 0.0)
          (= (imag-part (sqrt -1.0)) 1.0)
          (< (abs (real-part (log -1.0))) 0.000000001)
          (< 3.14 (imag-part (log -1.0)) 3.15)
          (< 1.57 (real-part (asin 2.0)) 1.58)
          (< -1.32 (imag-part (asin 2.0)) -1.31)
          (< (abs (real-part (acos 2.0))) 0.000000001)
          (< 1.31 (imag-part (acos 2.0)) 1.32)))
  (newline)
  (let ((below (make-rectangular -1.0 -0.0))
        (above (make-rectangular -1.0 0.0)))
    (display (list (< -3.15 (angle below) -3.14)
                   (< 3.14 (angle above) 3.15)
                   (< (imag-part (sqrt below)) 0)
                   (> (imag-part (sqrt above)) 0)
                   (< (imag-part (log below)) 0)
                   (> (imag-part (log above)) 0)))
    (newline))
  ;; Explicit complex signed zero selects a side of the inverse-function cuts.
  ;; This is deliberately separate from real `2.0`, whose principal-value
  ;; convention approaches the real axis from a specified implicit side.
  (let ((right-above (make-rectangular 2.0 0.0))
        (right-below (make-rectangular 2.0 -0.0))
        (left-above (make-rectangular -2.0 0.0))
        (left-below (make-rectangular -2.0 -0.0))
        (imag-right (make-rectangular 0.0 2.0))
        (imag-left (make-rectangular -0.0 2.0)))
    (display
      (list (string=? (number->string right-below) "2.0-0.0i")
            (string=? (number->string
                        (string->number (number->string right-below)))
                      "2.0-0.0i")
            (> (imag-part (asin right-above)) 0)
            (< (imag-part (asin right-below)) 0)
            (> (imag-part (asin left-above)) 0)
            (< (imag-part (asin left-below)) 0)
            (< (imag-part (acos right-above)) 0)
            (> (imag-part (acos right-below)) 0)
            (< (imag-part (acos left-above)) 0)
            (> (imag-part (acos left-below)) 0)
            (> (real-part (atan imag-right)) 1.5)
            (< (real-part (atan imag-left)) -1.5)))
    (newline))
  (fixnum-value (mk-fixnum 0)))
