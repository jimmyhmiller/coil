(module primitive-values)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (display (list (procedure? car) (procedure? char-downcase) (procedure? +)))
  (newline)
  (display (let ((first car)) (first '(9 8))))
  (newline)
  (write (map char-downcase '(#\A #\b #\C)))
  (newline)
  (display (apply + 1 2 '(3 4)))
  (newline)
  (display (call-with-values (lambda () (values 20 22)) +))
  (newline)
  (display
    (let ((sum +) (product *))
      (list (sum) (sum 7) (sum 1 2 3 4) (product) (product 2 3 4 5))))
  (newline)
  (display
    (let ((negate not) (magnitude abs) (divide quotient)
          (fourth cadddr) (same-ci string-ci=?))
      (list (negate #f) (negate '()) (magnitude -9) (divide 17 5)
            (fourth '(1 2 3 4)) (same-ci "Coil" "cOIL"))))
  (newline)
  (display
    (let ((put string-set!) (fill vector-fill!))
      (let ((s (string-copy "cat")) (v (vector 1 2 3)))
        (put s 0 #\b)
        (fill v 8)
        (list s v))))
  (newline)
  (display
    (let ((subtract -) (divide /) (less <) (same =)
          (maker list) (vector-maker vector)
          (greatest max) (least min) (common gcd) (multiple lcm))
      (list (procedure? subtract)
            (subtract 20 3 2) (subtract 9)
            (divide 24 2 3) (divide 4)
            (apply less '(1 2 3 4))
            (apply same '(7 7 7))
            (apply maker '(a b c))
            (apply vector-maker '(5 6 7))
            (apply greatest '(3 9 4))
            (apply least '(3 9 4))
            (apply common '(84 126 210))
            (apply multiple '(6 10 15)))))
  (newline)
  (write (map list '(1 2) '(3 4)))
  (newline)
  (display
    (let ((join append) (join-text string-append) (mapper map)
          (applier apply) (valuer values)
          (make-text make-string) (make-vec make-vector))
      (list (join '(1 2) '(3) '(4 5))
            (join-text "a" "b" "c")
            (string-append "d" "e" "f")
            (mapper + '(1 2) '(10 20))
            (applier + 1 2 '(3 4))
            (call-with-values (lambda () (valuer 7 8 9)) list)
            (make-text 3 #\x)
            (make-vec 3 6))))
  (newline)
  (display
    (let ((each for-each) (total 0))
      (each (lambda (x) (set! total (+ total x))) '(1 2 3 4))
      total))
  (newline)
  (display
    (let ((number-text number->string) (parse-number string->number)
          (angle atan))
      (list (number-text 255 16)
            (parse-number "ff" 16)
            (> (angle 1 1) 0.78)
            (< (angle 1 1) 0.79))))
  (newline)
  (display
    (let ((x 0))
      (let ((inc (lambda () (set! x (+ x 1)) x))
            (get (lambda () x))
            (shadow (lambda (x) (set! x 99) x)))
        (list (inc) (inc) (get) (shadow 7) x))))
  (newline)
  (display
    (let ((reader read) (peeker peek-char) (reader-char read-char)
          (emitter display) (writer write) (line newline) (put write-char)
          (current-in current-input-port) (current-out current-output-port))
      (list (procedure? reader) (procedure? peeker) (procedure? reader-char)
            (procedure? emitter) (procedure? writer) (procedure? line)
            (procedure? put) (input-port? (current-in))
            (output-port? (current-out)))))
  (newline)
  (display
    (let ((reader read) (opener open-input-file) (closer close-input-port))
      (let ((p (opener "tests/scheme/fixtures/datums.scm")))
        (let ((v (reader p))) (closer p) v))))
  (newline)
  (let ((emitter display) (writer write) (put write-char) (line newline))
    (emitter "io")
    (put #\space)
    (writer "ok")
    (line))
  (display
    (let ((sum8 (lambda (a b c d e f g h) (+ a b c d e f g h))))
      (list (sum8 1 2 3 4 5 6 7 8)
            (apply sum8 '(1 2 3 4 5 6 7 8))
            ((if #t sum8 sum8) 1 2 3 4 5 6 7 8))))
  (newline)
  (display
    (let ((root sqrt) (down floor) (up ceiling) (cut truncate) (nearest round)
          (to-inexact exact->inexact) (to-exact inexact->exact)
          (rect make-rectangular) (real real-part) (imag imag-part)
          (sine sin) (cosine cos) (logarithm log) (exponential exp))
      (let ((z (rect 3 4)))
        (list (root 81) (down 7/2) (up 7/2) (cut -7/2) (nearest 5/2)
              (inexact? (to-inexact 2)) (to-exact 2.0)
              (real z) (imag z)
              (zero? (sine 0)) (= (cosine 0) 1)
              (= (logarithm 1) 0) (= (exponential 0) 1)))))
  (newline)
  (display
    (let ((chars->text string))
      (list (string #\C #\o #\i #\l)
            (chars->text #\R #\5 #\R #\S)
            (apply chars->text '(#\o #\k)))))
  (newline)
  (display
    (let ((ready char-ready?) (opener open-input-file) (closer close-input-port))
      (let ((p (opener "tests/scheme/fixtures/input.txt")))
        (let ((before (ready p)) (c (read-char p)))
          (let ((after (ready p)))
            (closer p)
            (list before c after))))))
  (newline)
  (write
    (let ((start transcript-on) (stop transcript-off))
      (start "/tmp/coil-scheme-public-transcript.txt")
      (with-output-to-file "/tmp/coil-scheme-public-session.txt"
        (lambda () (display "T")))
      (stop)
      (call-with-input-file "/tmp/coil-scheme-public-transcript.txt"
        (lambda (p) (read-char p)))))
  (newline)
  (fixnum-value (mk-fixnum 0)))
