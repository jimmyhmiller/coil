(module scheme-lambda-surface)
(import "coil.scheme" :use *)

;; First-class procedures through the public Scheme surface: callback,
;; environment capture, and application through a lexical variable.
(defn main [] (-> i64)
  (display (map (lambda (x) (+ x 1)) '(1 2 3)))
  (newline)
  (display (let ((n 10)) (map (lambda (x) (+ x n)) '(1 2 3))))
  (newline)
  (display (let ((f (lambda (x) (+ x 1)))) (f 41)))
  (newline)
  (display
    (letrec ((fact (lambda (n)
                     (if (= n 0) 1 (* n (fact (- n 1)))))))
      (fact 6)))
  (newline)
  (display
    (let sum ((n 10) (acc 0))
      (+ n acc)
      (if (= n 0) acc (sum (- n 1) (+ acc n)))))
  (newline)
  (display
    (letrec ((even-local? (lambda (n) (if (= n 0) #t (odd-local? (- n 1)))))
             (odd-local? (lambda (n) (if (= n 0) #f (even-local? (- n 1))))))
      (even-local? 20)))
  (newline)
  (display
    (letrec ((f (lambda (ignored) 1)))
      (set! f (lambda (ignored) 2))
      (f 0)))
  (newline)
  (display
    (let ((f4 (lambda (a b c d) (+ a b c d)))
          (f5 (lambda (a b c d e) (+ a b c d e)))
          (f6 (lambda (a b c d e f) (+ a b c d e f))))
      (list (f4 1 2 3 4)
            (f5 1 2 3 4 5)
            (f6 1 2 3 4 5 6)
            (apply f6 '(1 2 3 4 5 6))
            (apply f6 1 2 3 '(4 5 6)))))
  (newline)
  (display (map (lambda (a b c) (+ a b c))
                '(1 2 3) '(10 20) '(100 200 300)))
  (newline)
  (for-each + '(1 2) '(10 20) '(100 200))
  (display 'multi-list-for-each)
  (newline)
  (display (list (not #f) (not '())))
  (newline)
  (display (let ((f (lambda args args))) (f 1 2 3)))
  (newline)
  (display
    (let ((f (lambda (a b . rest) (list a b rest))))
      (list (f 1 2 3 4) (apply f 1 '(2 3 4)))))
  (newline)
  (display
    (let ((captured 10))
      (let ((f (lambda (a . rest) (cons (+ a captured) rest))))
        (list (f 1 2 3) (apply f '(4 5 6))))))
  (newline)
  (display (let ((f (lambda args args))) (f)))
  (newline)
  (display
    (letrec ((collect (lambda (n . seen)
                        (if (= n 0) seen
                            (apply collect (- n 1) (cons n seen))))))
      (collect 3)))
  (newline)
  (fixnum-value 0))
