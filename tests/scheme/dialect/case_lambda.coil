(module case-lambda)
(import "coil.scheme" :use *)

(define choose-arity
  (case-lambda
    (() 100)
    ((x) x)
    ((x y) (+ x y))
    ((x y . more) (+ x (+ y (length more))))))

;; Capturing a variadic/case-lambda binding is the pattern used by Jolt's
;; successive collection-dispatch wrappers (`(define saved nth)` followed by
;; `(set! nth (case-lambda ...))`).  The saved procedure must receive the
;; original argument sequence, not one argument containing that sequence.
(define saved-choose-arity choose-arity)

(defn main [] (-> i64)
  (set! choose-arity
    (case-lambda
      ((x) (saved-choose-arity x))
      ((x y) (saved-choose-arity x y))
      ((x y . more) (apply saved-choose-arity x y more))))
  (display (choose-arity)) (newline)
  (display (choose-arity 7)) (newline)
  ;; An exact clause wins before the later rest clause.
  (display (choose-arity 20 22)) (newline)
  (display (choose-arity 20 20 1 2)) (newline)
  (display (saved-choose-arity 20 20 1 2)) (newline)
  (fixnum-value (mk-fixnum 0)))
