(module eval-no-matching-syntax)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((environment (scheme-report-environment 5)))
    (eval '(define-syntax only-two
             (syntax-rules () ((_ a b) (+ a b))))
          environment)
    (eval '(only-two 1) environment))
  (fixnum-value (mk-fixnum 0)))
