(module case06)
;; Public-surface counterpart of tests/scheme/cases/06-quasiquote.scm.
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((n 5))
  (display `(a b ,n))
  (newline)
  (display `(a ,@(list 1 2) b))
  (newline)
  (display `(1 ,@'() 2))
  (newline)
  (display `#(a ,n))
  (newline)
  (display '#(1 a))
  (newline)
  (display (equal? (quasiquote
                     (a (quasiquote
                          (b (unquote (c (unquote n)))))))
                   (list 'a
                         (list 'quasiquote
                               (list 'b (list 'unquote (list 'c n)))))))
  (newline)
  (display `(,@(list 1 2) . 3))
  (newline)
  )
  (fixnum-value (mk-fixnum 0)))
