(module mutable-sequences)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((s (make-string 3 #\a)))
    (string-set! s 1 #\b)
    (write s)
    (newline)
    (let ((copy (string-copy s)))
      (string-fill! s #\z)
      (write (list s copy))
      (newline)))
  (let ((v (make-vector 3 'x)))
    (vector-set! v 1 'y)
    (write v)
    (newline)
    (vector-fill! v 9)
    (write v)
    (newline))
  (fixnum-value (mk-fixnum 0)))
