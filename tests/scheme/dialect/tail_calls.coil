(module scheme-tail-calls)
(import "coil.scheme" :use *)

;; Different source arities deliberately produce different native prototypes.
;; R5RS still requires the mutual tail chain to run in constant space.
(define (tail-one n)
  (if (= n 0) 'done (tail-two (- n 1) #f)))
(define (tail-two n ignored)
  (if (= n 0) 'done (tail-one (- n 1))))

(defn main [] (-> i64)
  (do (display (tail-one 10000000))
      (newline)
      (fixnum-value 0)))
