(module case07)
;; Public-surface counterpart of tests/scheme/cases/07-syntax-rules.scm.
(import "coil.scheme" :use *)

(define-syntax swap!
  (syntax-rules ()
    ((_ a b) (let ((tmp a)) (set! a b) (set! b tmp)))))

(define-syntax my-or
  (syntax-rules ()
    ((_) #f)
    ((_ e) e)
    ((_ e r ...) (let ((t e)) (if t t (my-or r ...))))))

(define-syntax my-let
  (syntax-rules ()
    ((_ ((n v) ...) body ...) ((lambda (n ...) body ...) v ...))))

(define-syntax tail-pattern
  (syntax-rules ()
    ((_ a ... last) (list 'last last))))

(define-syntax vector-copy-list
  (syntax-rules ()
    ((_ #(x ...)) (vector->list #(x ...)))))

(define-syntax nested-copy
  (syntax-rules ()
    ((_ ((x ...) ...)) (list (list x ...) ...))))

(define-syntax literal-choice
  (syntax-rules (else)
    ((_ else value) value)
    ((_ other value) 0)))

(define definition-helper (lambda (value) (+ value 1)))
(define-syntax call-definition-helper
  (syntax-rules ()
    ((_ value) (definition-helper value))))

(define tmp 1)
(define other 2)
(define t 'outer)

(defn main [] (-> i64)
  (swap! tmp other)
  (display (list tmp other))
  (newline)
  (display (my-or #f t))
  (newline)
  (display (my-let ((a 1) (b 2)) (+ a b)))
  (newline)
  (display (tail-pattern 1 2 3))
  (newline)
  (display (vector-copy-list #(4 5 6)))
  (newline)
  (display (nested-copy ((1 2) (3))))
  (newline)
  (display (list (literal-choice else 7)
                 (let ((else #t)) (literal-choice else 7))
                 ((lambda (else) (literal-choice else 7)) #t)
                 (let ((marker #t))
                   (let-syntax
                     ((same-marker
                        (syntax-rules (marker)
                          ((_ marker) 1)
                          ((_ other) 0))))
                     (same-marker marker)))))
  (newline)
  (display
    (let ((definition-helper (lambda (ignored) 999)))
      (call-definition-helper 41)))
  (newline)
  (fixnum-value (mk-fixnum 0)))
