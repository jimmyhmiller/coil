(module case09)
;; Case 09 — the standard-procedure grind: pairs, lists, strings, chars,
;; vectors, equivalence, and procedures used as values.
;;
;; The dialect equivalent of tests/scheme/cases/09-lists-strings.scm, checked
;; against tests/scheme/expected/09-lists-strings.txt. All thirteen expected
;; lines are produced, byte for byte.
;;
;; ⚠ NOT NAMED `coil.scheme.*`. Both dialect passes skip any module under that
;; prefix, because the dialect's own runtime is ordinary Coil. A test file named
;; that way would silently not be rewritten at all.
(import "coil.primitive" :as primitive)
(import "coil.scheme" :use *)

;; ---- why this is not the .scm case verbatim ---------------------------------
;;
;; Three separate host facts force spelling changes, and each is a real limit
;; rather than a stylistic preference. Everything else below is the case as
;; written.
;;
;; 1. MOST STANDARD PROCEDURES ARE ONLY BOUND UNDER THEIR `scm-` NAMES.
;;    stdproc.coil defines `scm-cadr`, `scm-append`, `scm-length`, `scm-memq`,
;;    `scm-string-append` and the rest; forms.coil binds only `+ - * < > =`,
;;    `list`, `display` and `newline` under their R5RS spellings, and heap.coil
;;    contributes `car`/`cdr`/`cons`. So `(cadr x)` is `(scm-cadr x)` here.
;;    Nothing about the values changes — only the name the call site writes.
;;
;; 2. `append`, `apply` AND `map` ARE VARIADIC IN R5RS AND FIXED-ARITY HERE.
;;    forms.coil's variadic machinery collects surplus arguments at the CALL
;;    SITE, but only for procedures the pass saw `define`d in THIS module with a
;;    dotted signature — a `scm-` procedure from the runtime is an ordinary
;;    fixed-arity function, so the pass has nothing to collect against. Hence
;;    `(append '(1) '(2) '(3 4))` is written as a right-nested pair of binary
;;    `scm-append` calls (which is what a left-to-right variadic append means),
;;    `(apply + 1 2 '(3 4))` uses `scm-apply3` — the three-fixed-argument
;;    spelling, the last of which is the spread list — and `(map + a b)` uses
;;    `scm-map2`, the two-list arity.
;;
;; 3. A PROCEDURE PASSED AS A VALUE MUST BE WRAPPED EXPLICITLY.
;;    There is no closure conversion: `+` is a MACRO, not a value, and a lambda
;;    in value position is unimplemented. stdproc.coil's answer is to wrap a
;;    named Coil function as a procedure object, and there are two kinds:
;;
;;      make-procedure   fixed arity, called through a correctly-typed pointer
;;      make-reducer     variadic fold, which is the only honest `+` as a value
;;
;;    `(apply + 1 2 '(3 4))` must fold over FIVE arguments, so a fixed-arity
;;    wrapper around `scm-add` would answer 3 instead of 10 — the reducer is
;;    load-bearing, not a convenience. `(map + '(1 2 3) '(10 20 30))` folds each
;;    pair through the same object.
;;
;; ⚠ `make-procedure` / `make-reducer` RATHER THAN THE `scm-procedure` /
;;    `scm-reducer` MACROS, and the reason is a genuine interaction between two
;;    parts of the dialect that both work correctly on their own.
;;
;;    `scm-procedure` builds the name of its arity-specific helper by pasting the
;;    TEXT of its second argument onto `fnptr` — `(scm-procedure f 1)` emits a
;;    call to `fnptr1`. But this module is rewritten by the whole-tree pass
;;    BEFORE macros expand, and that pass lifts every bare integer to a Val: the
;;    `1` has already become `(mk-fixnum 1)` by the time the macro reads it, so
;;    `code-str` yields `mk-fixnum` and the expansion calls the nonexistent
;;    `fnptrmk-fixnum__0`. Neither side is wrong — literal lifting has to happen
;;    at every position (see forms.coil), and a macro that pastes a name has to
;;    read its argument's text — but they cannot both apply to the same form.
;;    Writing the expansion by hand steps around it: `fnptr0`/`fnptr1` are named
;;    directly, and the arity reaches `make-procedure` as the tagged fixnum its
;;    `procedure-arity` accessor already expects to untag.
;;
;; `(import "coil.primitive" :as primitive)` is required for the same
;; namespace reason core.coil documents: `fnptr0` and `scm-reducer` expand to
;; `primitive/fnptr-of` in the CALLER's namespace, and a namespace alias does not
;; transit `:reexport`. Without this line the module fails with "call to
;; undefined function 'primitive/fnptr-of'".

;; The producer for `call-with-values`. It must be a named top-level procedure
;; because a procedure VALUE needs a code pointer, and `(lambda () (values 1 2))`
;; in value position has no closure to become.
(define (produce-1-2) (scm-values-list (list 1 2)))

;; `+` as a first-class value: a reducer over `scm-add` with R5RS's identity 0.
(define (plus-proc) (scm-reducer scm-add (mk-fixnum 0)))

(defn main [] (-> i64)
  ;; (display (list (car '(1 2)) (cdr '(1 2)) (cadr '(1 2 3)) (cddr '(1 2 3))))
  (display (list (car '(1 2)) (cdr '(1 2)) (scm-cadr '(1 2 3)) (scm-cddr '(1 2 3))))
  (newline)

  ;; (display (append '(1) '(2) '(3 4)))
  (display (scm-append '(1) (scm-append '(2) '(3 4))))
  (newline)

  ;; (display (list (length '(1 2 3)) (reverse '(1 2 3)) (list-tail '(1 2 3 4) 2)))
  (display (list (scm-length '(1 2 3)) (scm-reverse '(1 2 3)) (scm-list-tail '(1 2 3 4) 2)))
  (newline)

  ;; (display (list (memq 'c '(a b c)) (assq 'b '((a 1) (b 2)))))
  ;; Both return the found SUBLIST / PAIR, not #t — that is what makes
  ;; `(cdr (assq k alist))` the idiomatic lookup, and it is what the expected
  ;; `((c) (b 2))` pins down.
  (display (list (scm-memq 'c '(a b c)) (scm-assq 'b '((a 1) (b 2)))))
  (newline)

  ;; (display (map + '(1 2 3) '(10 20 30)))
  (display (scm-map2 (plus-proc) '(1 2 3) '(10 20 30)))
  (newline)

  ;; (display (apply + 1 2 '(3 4)))  — five arguments folded, hence the reducer
  (display (scm-apply3 (plus-proc) 1 2 '(3 4)))
  (newline)

  ;; (display (list (eq? 'a 'a) (eqv? 1 1) (equal? '(1 (2)) '(1 (2)))))
  ;; `eq?` on symbols is true because interning makes both sites the same object;
  ;; `equal?` is the only one of the three that recurses into the nested list.
  (display (list (scm-eq? 'a 'a) (scm-eqv? 1 1) (scm-equal? '(1 (2)) '(1 (2)))))
  (newline)

  ;; (write (list (string-append "a" "bc") (string-length "abc") (substring "abcde" 1 3)))
  ;; `write`, not `display`: the expected line is `("abc" 3 "bc")` with quotes,
  ;; which is exactly the distinction between the two printers.
  (scm-write (list (scm-string-append "a" "bc")
                   (scm-string-length "abc")
                   (scm-substring "abcde" 1 3)))
  (newline)

  ;; (write (list (string->symbol "hi") (symbol->string 'hi) (string->list "ab")))
  ;; The three entries print differently — bare `hi`, quoted `"hi"`, and a list
  ;; of `#\` characters — so this line is what separates a symbol from a string
  ;; from a char under `write`.
  (scm-write (list (scm-string->symbol "hi")
                   (scm-symbol->string 'hi)
                   (scm-string->list "ab")))
  (newline)

  ;; (write (list (char->integer #\A) (char-upcase #\a) (char<? #\a #\b)))
  (scm-write (list (scm-char->integer #\A) (scm-char-upcase #\a) (scm-char<? #\a #\b)))
  (newline)

  ;; (display (list (vector-ref '#(1 2 3) 1) (vector->list '#(1 2)) (list->vector '(3 4))))
  ;; ⚠ `'#(1 2 3)` IS NOT SUPPORTED. `quote-data` (forms.coil) materializes
  ;; integers, symbols, the boolean and char literals, and list spines; it has no
  ;; vector case, and `#(…)` reads as a shape it would turn into the unspecified
  ;; value. Every vector literal here is therefore built with `list->vector` from
  ;; the equivalent quoted list, which produces the same object the literal
  ;; denotes — `#(1 2 3)` and `(list->vector '(1 2 3))` differ only in that the
  ;; latter is freshly allocated, which nothing on this line observes.
  (display (list (scm-vector-ref (scm-list->vector '(1 2 3)) 1)
                 (scm-vector->list (scm-list->vector '(1 2)))
                 (scm-list->vector '(3 4))))
  (newline)

  ;; (display (call-with-values (lambda () (values 1 2)) +))
  ;; The producer's two values are packaged by `values`, unpacked into an
  ;; argument list, and folded by the reducer — 3.
  (display (scm-call-with-values (make-procedure (fnptr0 produce-1-2) (mk-fixnum 0))
                                 (plus-proc)))
  (newline)

  ;; (display (list (number? 1) (string? "a") (symbol? 'a) (procedure? car) (vector? '#(1))))
  ;; `car` is a Coil function, not a value, so `procedure?` is asked about the
  ;; wrapped procedure object — which is what `car` denotes as a value here.
  (display (list (scm-number? 1)
                 (scm-string? "a")
                 (scm-symbol? 'a)
                 (scm-procedure? (make-procedure (fnptr1 scm-car) (mk-fixnum 1)))
                 (scm-vector? (scm-list->vector '(1)))))
  (newline)

  ;; main's value is the EXIT CODE, and the whole-tree pass lowers a bare `0` to
  ;; `(mk-fixnum 0)` — whose tagged word is 1. Untagging is the honest spelling.
  (fixnum-value (mk-fixnum 0)))
