(module character-strings)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (display (list (char<=? #\a #\a) (char>=? #\z #\a)
                 (char-ci=? #\A #\a) (char-ci<? #\a #\B)
                 (char-ci>? #\Z #\a) (char-ci<=? #\A #\a)
                 (char-ci>=? #\b #\A)))
  (newline)
  (display (list (char-alphabetic? #\q) (char-numeric? #\7)
                 (char-whitespace? #\space) (char-upper-case? #\Q)
                 (char-lower-case? #\q) (char-numeric? #\q)))
  (newline)
  (display (list (string<=? "ab" "ab") (string>=? "b" "aa")
                 (string-ci=? "Coil" "cOIL")
                 (string-ci<? "abc" "ABD")
                 (string-ci>? "Z" "a")
                 (string-ci<=? "same" "SAME")
                 (string-ci>=? "b" "A")))
  (newline)
  (let ((p (open-input-file "tests/scheme/fixtures/casefold.scm")))
    (let* ((upper (read p)) (lower (read p))
           (yes (read p)) (no (read p))
           (space (read p)) (line (read p)))
      (close-input-port p)
      (display (list upper lower (eq? upper lower) yes no
                     (= (char->integer space) 32)
                     (= (char->integer line) 10)))))
  (newline)
  (display (list #T #F (= (char->integer #\SPACE) 32)
                 (= (char->integer #\NewLine) 10)))
  (newline)
  (display (list (= (char->integer #\nul) 0)
                 (= (char->integer #\alarm) 7)
                 (= (char->integer #\backspace) 8)
                 (= (char->integer #\linefeed) 10)
                 (= (char->integer #\vtab) 11)
                 (= (char->integer #\page) 12)
                 (= (char->integer #\return) 13)
                 (= (char->integer #\esc) 27)
                 (= (char->integer #\delete) 127)
                 (= (char->integer #\rubout) 127)))
  (newline)
  (fixnum-value (mk-fixnum 0)))
