(module cxr-family)
(import "coil.scheme" :use *)

(defn make-tree [(n i64)] (-> i64)
  (if (= n 0) 'ok
    (cons (make-tree (- n 1)) (make-tree (- n 1)))))

(define saved-comparator char-ci<=?)

(defn main [] (-> i64)
  (let ((t2 (make-tree 2)) (t3 (make-tree 3)) (t4 (make-tree 4)))
      (write
        (list (caar t2) (cadr t2) (cdar t2) (cddr t2)
              (caaar t3) (caadr t3) (cadar t3) (caddr t3)
              (cdaar t3) (cdadr t3) (cddar t3) (cdddr t3)
              (caaaar t4) (caaadr t4) (caadar t4) (caaddr t4)
              (cadaar t4) (cadadr t4) (caddar t4) (cadddr t4)
              (cdaaar t4) (cdaadr t4) (cdadar t4) (cdaddr t4)
              (cddaar t4) (cddadr t4) (cdddar t4) (cddddr t4)))
      (newline))
  (write
    (list (char<? #\a #\b #\c)
          (char<? #\a #\c #\b)
          (string-ci=? "A" "a" "A")
          (apply string<? '("a" "b" "c"))
          (apply char-ci<=? '(#\A #\a #\B))))
  (newline)
  (write
    (let ((char<? (lambda (a b c) 'shadowed))
          (string=? (lambda args 'also-shadowed)))
      (list (char<? 1 2 3) (string=? "x" "y" "z"))))
  (newline)
  (write (list (procedure? saved-comparator)
               (apply saved-comparator '(#\A #\a #\B))))
  (newline)
  (fixnum-value (mk-fixnum 0)))
