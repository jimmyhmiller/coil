; Phase 3: the standard-procedure grind.
(display (list (car '(1 2)) (cdr '(1 2)) (cadr '(1 2 3)) (cddr '(1 2 3)))) (newline)
(display (append '(1) '(2) '(3 4))) (newline)
(display (list (length '(1 2 3)) (reverse '(1 2 3)) (list-tail '(1 2 3 4) 2))) (newline)
(display (list (memq 'c '(a b c)) (assq 'b '((a 1) (b 2))))) (newline)
(display (map + '(1 2 3) '(10 20 30))) (newline)
(display (apply + 1 2 '(3 4))) (newline)
(display (list (eq? 'a 'a) (eqv? 1 1) (equal? '(1 (2)) '(1 (2))))) (newline)
(write (list (string-append "a" "bc") (string-length "abc") (substring "abcde" 1 3))) (newline)
(write (list (string->symbol "hi") (symbol->string (quote hi)) (string->list "ab"))) (newline)
(write (list (char->integer #\A) (char-upcase #\a) (char<? #\a #\b))) (newline)
(display (list (vector-ref '#(1 2 3) 1) (vector->list '#(1 2)) (list->vector '(3 4)))) (newline)
(display (call-with-values (lambda () (values 1 2)) +)) (newline)
(display (list (number? 1) (string? "a") (symbol? 'a) (procedure? car) (vector? '#(1)))) (newline)
