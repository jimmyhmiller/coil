(module scheme-mal-cli)
(import "coil.scheme" :use *)
(import "scheme-mal-stage1" :use *)
(import "scheme-mal-stage5" :use *)
(import "scheme-mal-host" :as host)

(define (mal-repl-loop ignored)
  (display "mal-user> ")
  (let ((line (mal5-readline-from-port (current-input-port))))
    (if (eq? line (mal-nil-value)) line
        (begin
          (display (mal5-rep (mal-value line)))
          (newline)
          (mal-repl-loop line)))))

(defn main [] (-> i64)
  (mal-repl-loop (s-nil))
  (host/exit-success))
