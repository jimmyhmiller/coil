(module scheme-mal-host)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.time" :as time)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "scheme-mal-stage1" :use *)

(defn mal-time-last [] (-> (ptr i64)) (alloc/static i64))
(defn mal-time-ms [] (-> i64)
  (match (time/monotonic-now-ms)
    (Ok [value]
      ; Upstream Mal assumes two calls separated by evaluator work compare
      ; strictly greater. Millisecond clocks may legitimately return the same
      ; tick on a fast host, so retain real time while breaking ties monotonically.
      (let [last (primitive/load (mal-time-last))
            next (if (<= value last) (+ last 1) value)]
        (primitive/store! (mal-time-last) next)
        next))
    (Err [_] 0)))
(defn mal-time-value [] (-> i64)
  (let [value (mal-number (mk-fixnum (mal-time-ms)))]
    (gc-root-permanent value)
    value))
(defn make-mal-time-procedure [] (-> i64)
  (stdproc/make-procedure
    (stdproc/fnptr0->i64 (primitive/fnptr-of mal-time-value)) 0))
(defn exit-success [] (-> i64) 0)

(export mal-time-ms mal-time-value make-mal-time-procedure exit-success)
