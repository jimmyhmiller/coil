(module scheme-mal-stage4-test)
(import "coil.assert" :use *)
(import "coil.scheme" :use *)
(import "scheme-mal-stage4" :use *)

(define (expect input wanted) (assert (string=? (mal4-rep input) wanted)))

(deftest upstream-mal-stage4-conditionals-and-core
  (expect "(list 1 2 3)" "(1 2 3)")
  (expect "(count (list 1 2 3))" "3")
  (expect "(count nil)" "0")
  (expect "(if true 7 8)" "7")
  (expect "(if false 7 8)" "8")
  (expect "(if nil 7 8)" "8")
  (expect "(if 0 7 8)" "7")
  (expect "(if false 7)" "nil")
  (expect "(= (list 1 2) (list 1 2))" "true")
  (expect "(>= (count (list 1 2 3)) 3)" "true"))

(deftest upstream-mal-stage4-functions-closures-and-recursion
  (expect "((fn* (a b) (+ b a)) 3 4)" "7")
  (expect "(((fn* (a) (fn* (b) (+ a b))) 5) 7)" "12")
  (expect "(def! gen-plusX (fn* (x) (fn* (b) (+ x b))))" "#<function>")
  (expect "(def! plus7 (gen-plusX 7))" "#<function>")
  (expect "(plus7 8)" "15")
  (expect "(let* [b 0 f (fn* [] b)] (let* [b 1] (f)))" "0")
  (expect "(do (def! a 6) 7 (+ a 8))" "14")
  (expect "(def! sumdown (fn* (N) (if (> N 0) (+ N (sumdown (- N 1))) 0)))" "#<function>")
  (expect "(sumdown 6)" "21")
  (expect "(def! fib (fn* (N) (if (= N 0) 1 (if (= N 1) 1 (+ (fib (- N 1)) (fib (- N 2)))))))" "#<function>")
  (expect "(fib 4)" "5")
  (expect "((fn* (& more) (count more)) 1 2 3)" "3"))
