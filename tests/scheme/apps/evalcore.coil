(module scheme-evalcore)
;; A portable first-order metacircular Scheme evaluator. This is the native
;; dialect port of src/apps/mini-scheme/meta/evalcore.scm, not a translated Coil
;; implementation: environments, closures, primitives, and the target program
;; are all Scheme data manipulated through the public R5RS surface.
(import "coil.scheme" :use *)

(define genv '())
(define (defvar! name val) (set! genv (cons (cons name val) genv)) name)
(define (cadr* x) (car (cdr x)))
(define (caddr* x) (car (cdr (cdr x))))
(define (cadddr* x) (car (cdr (cdr (cdr x)))))
(define (cdddr* x) (cdr (cdr (cdr x))))

(define (glookup s g)
  (if (null? g) s
      (if (eq? (car (car g)) s) (cdr (car g)) (glookup s (cdr g)))))
(define (lookup s env)
  (if (null? env) (glookup s genv)
      (if (eq? (car (car env)) s) (cdr (car env)) (lookup s (cdr env)))))
(define (bind ps as env)
  (if (null? ps) env
      (bind (cdr ps) (cdr as) (cons (cons (car ps) (car as)) env))))
(define (evlist es env)
  (if (null? es) '()
      (cons (seval (car es) env) (evlist (cdr es) env))))

(define (seval e env)
  (if (number? e) e
  (if (symbol? e) (lookup e env)
  (if (eq? (car e) 'quote) (cadr* e)
  (if (eq? (car e) 'if)
      (if (seval (cadr* e) env)
          (seval (caddr* e) env)
          (seval (cadddr* e) env))
  (if (eq? (car e) 'lambda)
      (cons 'closure (cons (cadr* e) (cons (caddr* e) env)))
  (if (eq? (car e) 'define)
      (defvar! (cadr* e) (seval (caddr* e) env))
      (sapply (seval (car e) env) (evlist (cdr e) env)))))))))

(define (sapply f as)
  (if (eq? (car f) 'prim)
      (doprim (cadr* f) as)
      (seval (caddr* f) (bind (cadr* f) as (cdddr* f)))))

(define (doprim op as)
  (if (eq? op '+) (+ (car as) (cadr* as))
  (if (eq? op '-) (- (car as) (cadr* as))
  (if (eq? op '*) (* (car as) (cadr* as))
  (if (eq? op '<) (< (car as) (cadr* as))
  (if (eq? op '=) (= (car as) (cadr* as)) 0))))))

(define (setup)
  (defvar! '+ (cons 'prim (cons '+ '())))
  (defvar! '- (cons 'prim (cons '- '())))
  (defvar! '* (cons 'prim (cons '* '())))
  (defvar! '< (cons 'prim (cons '< '())))
  (defvar! '= (cons 'prim (cons '= '()))))

(define target
  '(begin
     (define fib (lambda (n)
       (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
     (fib 20)))

(define (run-evaluator)
  (setup)
  (seval (cadr* target) '())
  (seval (caddr* target) '()))

(defn main [] (-> i64)
  (display (run-evaluator))
  (newline)
  (fixnum-value (mk-fixnum 0)))
