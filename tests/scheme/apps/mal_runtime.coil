(module scheme-mal-runtime)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)

;; Private application record tag. The Scheme runtime currently owns tags 1-15;
;; this Mal record uses the same traced three-payload object layout.
(defn mal-record-tag [] (-> i64) 16)
(defn make-mal-record [(kind i64) (value i64) (meta i64)] (-> i64)
  (allocate (mal-record-tag) kind value meta))
(defn mal-record? [(x i64)] (-> i64) (mk-bool (has-tag? x (mal-record-tag))))
(defn mal-record-kind [(x i64)] (-> i64)
  (load (field (obj-of x) a)))
(defn mal-record-value [(x i64)] (-> i64)
  (load (field (obj-of x) b)))
(defn mal-record-value-set! [(x i64) (value i64)] (-> i64)
  (store! (field (obj-of x) b) value)
  value)
(defn mal-record-meta [(x i64)] (-> i64)
  (load (field (obj-of x) c)))
(defn mal-record-meta-set! [(x i64) (value i64)] (-> i64)
  (store! (field (obj-of x) c) value)
  value)

(export make-mal-record mal-record? mal-record-kind mal-record-value
        mal-record-value-set! mal-record-meta mal-record-meta-set!)
