(module scheme-mal-stage3)
(import "coil.scheme" :use *)
(import "scheme-mal-stage1" :use *)

;; Upstream Mal's environment is a mutable bindings table plus an outer link.
;; It is private evaluator state, so one mutable pair `(bindings . outer)` carries
;; the product directly. The previous three-element vector cost three Coil heap
;; objects for every interpreted function call because vectors use chained
;; storage; this representation costs one.
(define (mal3-make-env outer) (cons '() outer))
(define (mal3-env-bindings env) (car env))
(define (mal3-env-outer env) (cdr env))
(define (mal3-env-set env key value)
  (set-car! env (cons (cons key value) (mal3-env-bindings env)))
  value)
(define (mal3-env-get env key)
  (let ((entry (assq key (mal3-env-bindings env))))
    (if entry (cdr entry)
        (if (mal3-env-outer env) (mal3-env-get (mal3-env-outer env) key) #f))))
(define (mal3-env-get-local env key)
  (let ((entry (assq key (mal3-env-bindings env))))
    (if entry (cdr entry) #f)))

(define (mal3-bind-params env binds args)
  (if (null? binds) env
      (if (eq? (car binds) '&)
          (begin (mal3-env-set env (cadr binds) (mal-list args)) env)
          (begin
            (mal3-env-set env (car binds) (car args))
            (mal3-bind-params env (cdr binds) (cdr args))))))
(define (mal3-make-bound-env outer binds args)
  (mal3-bind-params (mal3-make-env outer) binds args))

(define (mal3-bind-all binds env)
  (if (null? binds) env
      (let ((key (mal-value (car binds)))
            (value (mal3-eval (cadr binds) env)))
        (mal3-env-set env key value)
        (mal3-bind-all (cddr binds) env))))

(define (mal3-eval-alist xs env)
  (if (null? xs) '()
      (cons (cons (caar xs) (mal3-eval (cdar xs) env))
            (mal3-eval-alist (cdr xs) env))))

(define (mal3-eval ast env)
  (let ((type (and (mal-object? ast) (mal-type ast))))
    (case type
      ((symbol) (mal3-env-get env (mal-value ast)))
      ((vector)
       (mal-vector (list->vector
         (map (lambda (item) (mal3-eval item env))
              (vector->list (mal-value ast))))))
      ((map) (mal-map (mal3-eval-alist (mal-value ast) env)))
      ((list)
       (let ((items (mal-value ast)))
         (if (null? items) ast
             (case (mal-value (car items))
               ((def!)
                (let ((symbol (mal-value (cadr items)))
                      (value (mal3-eval (list-ref items 2) env)))
                  (mal3-env-set env symbol value)))
               ((let*)
                (let ((child (mal3-make-env env))
                      (raw (mal-value (cadr items))))
                  (mal3-bind-all
                    (if (vector? raw) (vector->list raw) raw) child)
                  (mal3-eval (list-ref items 2) child)))
               (else
                (let ((op (mal3-eval (car items) env))
                      (args (map (lambda (item) (mal3-eval item env))
                                 (cdr items))))
                  (apply op args)))))))
      (else ast))))

(define mal3-repl-env
  (let ((env (mal3-make-env #f)))
    (mal3-env-set env '+
      (lambda (a b) (mal-number (+ (mal-value a) (mal-value b)))))
    (mal3-env-set env '-
      (lambda (a b) (mal-number (- (mal-value a) (mal-value b)))))
    (mal3-env-set env '*
      (lambda (a b) (mal-number (* (mal-value a) (mal-value b)))))
    (mal3-env-set env '/
      (lambda (a b) (mal-number (/ (mal-value a) (mal-value b)))))
    (gc-root-permanent env)
    env))

(define (mal3-rep input)
  (mal-print (mal3-eval (mal-read-string input) mal3-repl-env) #t))

(export mal3-rep mal3-eval mal3-make-env mal3-make-bound-env
        mal3-env-set mal3-env-get mal3-env-get-local mal3-env-outer mal3-repl-env)
