(module scheme-mal-stage4)
(import "coil.scheme" :use *)
(import "scheme-mal-stage1" :use *)
(import "scheme-mal-stage3" :use *)

(define (mal4-bool x) (if x (mal-true-value) (mal-false-value)))
(define (mal4-sequence-value x)
  (if (vector? x) (vector->list x) x))
(define (mal4-list-equal? xs ys)
  (if (null? xs) (null? ys)
      (if (null? ys) #f
          (and (mal4-equal? (car xs) (car ys))
               (mal4-list-equal? (cdr xs) (cdr ys))))))
(define (mal4-map-entry key entries)
  (if (null? entries) #f
      (if (mal4-equal? key (caar entries)) (car entries)
          (mal4-map-entry key (cdr entries)))))
(define (mal4-map-equal? xs ys)
  (if (null? xs) #t
      (let ((entry (mal4-map-entry (caar xs) ys)))
        (and entry
             (and (mal4-equal? (cdar xs) (cdr entry))
                  (mal4-map-equal? (cdr xs) ys))))))
(define (mal4-equal? a b)
  (if (or (not (mal-object? a)) (not (mal-object? b))) #f
      (let ((ta (mal-type a)) (tb (mal-type b)))
        (if (and (eq? ta 'map) (eq? tb 'map))
            (and (= (length (mal-value a)) (length (mal-value b)))
                 (mal4-map-equal? (mal-value a) (mal-value b)))
        (if (and (memq ta '(list vector)) (memq tb '(list vector)))
            (mal4-list-equal? (mal4-sequence-value (mal-value a))
                              (mal4-sequence-value (mal-value b)))
            (and (eq? ta tb) (equal? (mal-value a) (mal-value b))))))))
(define (mal4-printed args readable separator)
  (if (null? args) ""
      (if (null? (cdr args)) (mal-print (car args) readable)
          (string-append (mal-print (car args) readable) separator
                         (mal4-printed (cdr args) readable separator)))))

(define (mal4-eval-forms forms env)
  (if (null? forms) (mal-nil-value)
      (if (null? (cdr forms)) (mal4-eval (car forms) env)
          (begin (mal4-eval (car forms) env)
                 (mal4-eval-forms (cdr forms) env)))))
(define (mal4-eval-alist xs env)
  (if (null? xs) '()
      (cons (cons (caar xs) (mal4-eval (cdar xs) env))
            (mal4-eval-alist (cdr xs) env))))
(define (mal4-bind-all binds env)
  (if (null? binds) env
      (begin
        (mal3-env-set env (mal-value (car binds))
          (mal4-eval (cadr binds) env))
        (mal4-bind-all (cddr binds) env))))

(define (mal4-eval ast env)
  (let ((type (and (mal-object? ast) (mal-type ast))))
    (case type
      ((symbol) (mal3-env-get env (mal-value ast)))
      ((vector)
       (mal-vector (list->vector
         (map (lambda (item) (mal4-eval item env))
              (vector->list (mal-value ast))))))
      ((map) (mal-map (mal4-eval-alist (mal-value ast) env)))
      ((list)
       (let ((items (mal-value ast)))
         (if (null? items) ast
             (case (mal-value (car items))
               ((def!)
                (mal3-env-set env (mal-value (cadr items))
                  (mal4-eval (list-ref items 2) env)))
               ((let*)
                (let ((child (mal3-make-env env))
                      (raw (mal-value (cadr items))))
                  (mal4-bind-all (mal4-sequence-value raw) child)
                  (mal4-eval (list-ref items 2) child)))
               ((do) (mal4-eval-forms (cdr items) env))
               ((if)
                (let ((condition (mal4-eval (cadr items) env)))
                  (if (memq (mal-type condition) '(false nil))
                      (if (< (length items) 4) (mal-nil-value)
                          (mal4-eval (list-ref items 3) env))
                      (mal4-eval (list-ref items 2) env))))
               ((fn*)
                (let ((params (map mal-value
                                (mal4-sequence-value (mal-value (cadr items)))))
                      (body (list-ref items 2)))
                  (lambda args
                    (mal4-eval body (mal3-make-bound-env env params args)))))
               (else
                (apply (mal4-eval (car items) env)
                       (map (lambda (item) (mal4-eval item env))
                            (cdr items))))))))
      (else ast))))

(define mal4-repl-env
  (let ((env (mal3-make-env #f)))
    (mal3-env-set env '+ (lambda (a b) (mal-number (+ (mal-value a) (mal-value b)))))
    (mal3-env-set env '- (lambda (a b) (mal-number (- (mal-value a) (mal-value b)))))
    (mal3-env-set env '* (lambda (a b) (mal-number (* (mal-value a) (mal-value b)))))
    (mal3-env-set env '/ (lambda (a b) (mal-number (/ (mal-value a) (mal-value b)))))
    (mal3-env-set env 'list (lambda args (mal-list args)))
    (mal3-env-set env 'list? (lambda (x) (mal4-bool (eq? (mal-type x) 'list))))
    (mal3-env-set env 'empty? (lambda (x) (mal4-bool (null? (mal4-sequence-value (mal-value x))))))
    (mal3-env-set env 'count (lambda (x) (mal-number
      (if (eq? x (mal-nil-value)) 0 (length (mal4-sequence-value (mal-value x)))))))
    (mal3-env-set env '< (lambda (a b) (mal4-bool (< (mal-value a) (mal-value b)))))
    (mal3-env-set env '<= (lambda (a b) (mal4-bool (<= (mal-value a) (mal-value b)))))
    (mal3-env-set env '> (lambda (a b) (mal4-bool (> (mal-value a) (mal-value b)))))
    (mal3-env-set env '>= (lambda (a b) (mal4-bool (>= (mal-value a) (mal-value b)))))
    (mal3-env-set env '= (lambda (a b) (mal4-bool (mal4-equal? a b))))
    (mal3-env-set env 'not (lambda (x)
      (mal4-bool (memq (mal-type x) '(false nil)))))
    (mal3-env-set env 'pr-str
      (lambda args (mal-string (mal4-printed args #t " "))))
    (mal3-env-set env 'str
      (lambda args (mal-string (mal4-printed args #f ""))))
    (gc-root-permanent env)
    env))

(define (mal4-rep input)
  (mal-print (mal4-eval (mal-read-string input) mal4-repl-env) #t))
(define (mal4-environment) mal4-repl-env)

(export mal4-rep mal4-eval mal4-environment mal4-equal? mal4-bool mal4-printed)
