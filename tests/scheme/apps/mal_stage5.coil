(module scheme-mal-stage5)
(import "coil.primitive" :as primitive)
(import "coil.scheme" :use *)
(import "scheme-mal-host" :as host)
(import "scheme-mal-stage1" :use *)
(import "scheme-mal-stage3" :use *)
(import "scheme-mal-stage4" :use *)

(define (mal5-sequence-value x) (if (vector? x) (vector->list x) x))
(define (mal5-eval-alist xs env)
  (if (null? xs) '()
      (cons (cons (caar xs) (mal5-run (cdar xs) env))
            (mal5-eval-alist (cdr xs) env))))
(define (mal5-bind-all binds env)
  (if (null? binds) env
      (let ((value (mal5-run (cadr binds) env)))
        (if (mal5-pending-throw?) env
            (begin
              (mal3-env-set env (mal-value (car binds)) value)
              (mal5-bind-all (cddr binds) env))))))
(define (mal5-eval-prefix forms env)
  (if (null? (cdr forms)) (car forms)
      (let ((value (mal5-run (car forms) env)))
        (if (mal5-pending-throw?) value
            (mal5-eval-prefix (cdr forms) env)))))

;; A bounce is private evaluator state. Mal values are tagged vectors (or host
;; procedures), so a raw pair cannot be confused with a user value. One pair is
;; materially cheaper than the old three-element vector, which required a header
;; plus two chained storage cells on every trampoline step.
(define (mal5-bounce ast env) (cons ast env))
(define (mal5-bounce? x) (pair? x))
(define (mal5-bounce-ast x) (car x))
(define (mal5-bounce-env x) (cdr x))
(define (mal5-native op metadata) (vector 'mal-native op metadata))
(define (mal5-native? x)
  (and (vector? x)
       (and (= (vector-length x) 3) (eq? (vector-ref x 0) 'mal-native))))
(define (mal5-native-op x) (vector-ref x 1))
(define (mal5-native-meta x) (vector-ref x 2))

;; Mal exceptions are evaluator state rather than host exceptions. Coil's Scheme
;; subset intentionally has no call/cc or exception primitive yet, so a thrown
;; Mal value is propagated through the trampoline and consumed by the nearest
;; `try*`. The evaluator is single-threaded, making one pending slot sufficient.
(define mal5-throw-active #f)
(define mal5-throw-value (mal-nil-value))
(define mal5-debug-name (string->symbol "DEBUG-EVAL"))
(define (mal5-pending-throw?) mal5-throw-active)
(define (mal5-raise value)
  (set! mal5-throw-value value)
  (set! mal5-throw-active #t)
  value)
(define (mal5-take-throw)
  (let ((value mal5-throw-value))
    (set! mal5-throw-active #f)
    (set! mal5-throw-value (mal-nil-value))
    value))
(define (mal5-read-string-safe input)
  (let ((value (mal-read-string input)))
    (if (mal-error? value)
        (mal5-raise (mal-string (mal-value value)))
        value)))
(define (mal5-call op args)
  (if (mal-func? op)
      (mal5-run (mal-func-ast op)
        (mal3-make-bound-env (mal-func-env op) (mal-func-params op) args))
      (apply (if (mal5-native? op) (mal5-native-op op) op) args)))
(define (mal5-swap atom op args)
  (let ((value (mal5-call op (cons (mal-value atom) args))))
    (mal-value-set! atom value)
    value))
(define (mal5-read-all port reversed)
  (let ((char (read-char port)))
    (if (eof-object? char) (list->string (reverse reversed))
        (mal5-read-all port (cons char reversed)))))
(define (mal5-readline-chars port reversed)
  (let ((char (read-char port)))
    (if (eof-object? char)
        (if (null? reversed) #f (list->string (reverse reversed)))
        (if (char=? char #\newline)
            (list->string (reverse reversed))
            (mal5-readline-chars port (cons char reversed))))))
(define (mal5-readline-from-port port)
  (let ((line (mal5-readline-chars port '())))
    (if line (mal-string line) (mal-nil-value))))
(define (mal5-readline prompt)
  (display (mal-value prompt))
  (mal5-readline-from-port (current-input-port)))
(define (mal5-slurp path)
  (let ((port (open-input-file path)))
    (let ((contents (mal5-read-all port '())))
      (close-input-port port)
      contents)))
(define (mal5-load-file path env)
  (mal5-run
    (mal5-read-string-safe
      (string-append "(do " (mal5-slurp path) "\nnil)")) env))
(define (mal5-starts-with? ast name)
  (and (mal-object? ast)
       (and (eq? (mal-type ast) 'list)
            (let ((items (mal-value ast)))
              (and (not (null? items))
                   (and (mal-object? (car items))
                        (and (eq? (mal-type (car items)) 'symbol)
                             (eq? (mal-value (car items)) name))))))))
(define (mal5-quasiquote-expand-list items)
  (if (null? items) (mal-list '())
      (let ((item (car items))
            (rest (mal5-quasiquote-expand-list (cdr items))))
        (if (mal5-starts-with? item 'splice-unquote)
            (mal-list (list (mal-symbol 'concat)
                            (cadr (mal-value item)) rest))
            (mal-list (list (mal-symbol 'cons)
                            (mal5-quasiquote-expand item) rest))))))
(define (mal5-quasiquote-expand ast)
  (if (mal5-starts-with? ast 'unquote) (cadr (mal-value ast))
      (if (not (mal-object? ast)) ast
          (case (mal-type ast)
            ((list) (mal5-quasiquote-expand-list (mal-value ast)))
            ((vector)
             (mal-list (list (mal-symbol 'vec)
               (mal5-quasiquote-expand-list
                 (vector->list (mal-value ast))))))
            ((symbol map) (mal-list (list (mal-symbol 'quote) ast)))
            (else ast)))))
(define (mal5-debug-ast ast)
  (if (mal5-starts-with? ast 'quasiquote)
      (mal5-quasiquote-expand (cadr (mal-value ast)))
      ast))
(define (mal5-quasiquote-list items env)
  (if (null? items) '()
      (let ((item (car items)))
        (if (mal5-starts-with? item 'splice-unquote)
            (append (mal5-sequence-value
                      (mal-value (mal5-run (cadr (mal-value item)) env)))
                    (mal5-quasiquote-list (cdr items) env))
            (cons (mal5-quasiquote item env)
                  (mal5-quasiquote-list (cdr items) env))))))
(define (mal5-quasiquote ast env)
  (if (mal5-starts-with? ast 'unquote)
      (mal5-run (cadr (mal-value ast)) env)
      (if (not (mal-object? ast)) ast
          (case (mal-type ast)
            ((list) (mal-list (mal5-quasiquote-list (mal-value ast) env)))
            ((vector) (mal-vector (list->vector
              (mal5-quasiquote-list (vector->list (mal-value ast)) env))))
            (else ast)))))
(define (mal5-concat args)
  (if (null? args) '()
      (append (mal5-sequence-value (mal-value (car args)))
              (mal5-concat (cdr args)))))
(define (mal5-map-ref key items)
  (if (null? items) #f
      (if (mal4-equal? key (caar items)) (cdar items)
          (mal5-map-ref key (cdr items)))))
(define (mal5-map-remove keys items)
  (if (null? items) '()
      (if (mal5-any-equal? (caar items) keys)
          (mal5-map-remove keys (cdr items))
          (cons (car items) (mal5-map-remove keys (cdr items))))))
(define (mal5-any-equal? key keys)
  (if (null? keys) #f
      (or (mal4-equal? key (car keys)) (mal5-any-equal? key (cdr keys)))))
(define (mal5-pairs xs)
  (mal-list->alist xs))
(define (mal5-map-assoc collection kvs)
  (let ((pairs (mal5-pairs kvs)))
    (append pairs (mal5-map-remove (map car pairs) (mal-value collection)))))
(define (mal5-butlast xs)
  (if (null? (cdr xs)) '() (cons (car xs) (mal5-butlast (cdr xs)))))
(define (mal5-last xs) (if (null? (cdr xs)) (car xs) (mal5-last (cdr xs))))
(define (mal5-apply-args op args)
  (mal5-call op
    (append (mal5-butlast args)
            (mal5-sequence-value (mal-value (mal5-last args))))))
(define (mal5-map-call op items)
  (if (null? items) '()
      (cons (mal5-call op (list (car items)))
            (mal5-map-call op (cdr items)))))
(define (mal5-with-meta x metadata)
  (if (mal-func? x)
      (let ((copy (mal-func (mal-func-ast x) (mal-func-params x) (mal-func-env x))))
        (mal-func-macro-set! copy (mal-func-macro? x))
        (mal-func-meta-set! copy metadata)
        copy)
      (if (procedure? x) (mal5-native x metadata)
          (if (mal5-native? x) (mal5-native (mal5-native-op x) metadata)
              (let ((copy (mal-object (mal-type x) (mal-value x))))
                (mal-meta-set! copy metadata) copy)))))
(define (mal5-seq x)
  (if (eq? x (mal-nil-value)) (mal-nil-value)
      (case (mal-type x)
        ((list) (if (null? (mal-value x)) (mal-nil-value) x))
        ((vector) (if (= (vector-length (mal-value x)) 0) (mal-nil-value)
                      (mal-list (vector->list (mal-value x)))))
        ((string) (if (= (string-length (mal-value x)) 0) (mal-nil-value)
                      (mal-list (map (lambda (char) (mal-string (list->string (list char))))
                                     (string->list (mal-value x))))))
        (else (mal-nil-value)))))

(defn mal5-run [(ast i64) (env i64)] (-> i64)
  (let [sp (gc-sp)
        initial (mal5-bounce ast env)
        (mut current) initial]
    (loop
      (gc-sp-set! sp)
      (gc-root (primitive/load (mut current)))
      (if (truthy? (mal5-bounce? (primitive/load (mut current))))
          (primitive/store!
            (mut current)
            (mal5-step (mal5-bounce-ast (primitive/load (mut current)))
                       (mal5-bounce-env (primitive/load (mut current)))))
        (break)))
    (let [out (primitive/load (mut current))]
      (gc-sp-set! sp)
      out)))

;; Stage 5's essential change: every interpreted tail position calls mal5-eval
;; directly with the next AST/environment. Coil lowers that self-tail call to a
;; loop, so Mal recursion no longer consumes one native frame per interpreted call.
(define (mal5-step ast env)
  (if (mal5-pending-throw?) mal5-throw-value
  (begin
  (let ((debug (mal3-env-get-local env mal5-debug-name)))
    (if (and debug
             (not (and (mal-object? debug)
                       (memq (mal-type debug) '(false nil)))))
        (begin (display "EVAL: ")
               (display (mal-print (mal5-debug-ast ast) #t)) (newline))
        #f))
  (let ((type (and (mal-object? ast) (mal-type ast))))
    (case type
      ((symbol)
       (let ((value (mal3-env-get env (mal-value ast))))
         (if value value
             (mal5-raise
               (mal-string
                 (string-append
                   (symbol->string (mal-value ast)) " not found"))))))
      ((vector)
       (mal-vector (list->vector
         (map (lambda (item) (mal5-run item env))
              (vector->list (mal-value ast))))))
      ((map) (mal-map (mal5-eval-alist (mal-value ast) env)))
      ((list)
       (let ((items (mal-value ast)))
         (if (null? items) ast
             (case (mal-value (car items))
               ((def!)
                (let ((value (mal5-run (list-ref items 2) env)))
                  (if (mal5-pending-throw?) value
                      (mal3-env-set env (mal-value (cadr items)) value))))
               ((defmacro!)
                (let ((original (mal5-run (list-ref items 2) env)))
                  (if (mal5-pending-throw?) original
                      (let ((value (mal-func (mal-func-ast original)
                                             (mal-func-params original)
                                             (mal-func-env original))))
                        (mal-func-meta-set! value (mal-func-meta original))
                        (mal-func-macro-set! value #t)
                        (mal3-env-set env (mal-value (cadr items)) value)))))
               ((let*)
                (let ((child (mal3-make-env env))
                      (raw (mal-value (cadr items))))
                  (mal5-bind-all (mal5-sequence-value raw) child)
                  (mal5-bounce (list-ref items 2) child)))
               ((do)
                (let ((forms (cdr items)))
                  (if (null? forms) (mal-nil-value)
                      (mal5-bounce (mal5-eval-prefix forms env) env))))
               ((if)
                (let ((condition (mal5-run (cadr items) env)))
                  (if (memq (mal-type condition) '(false nil))
                      (if (< (length items) 4) (mal-nil-value)
                          (mal5-bounce (list-ref items 3) env))
                      (mal5-bounce (list-ref items 2) env))))
               ((quote) (cadr items))
               ((quasiquote) (mal5-quasiquote (cadr items) env))
               ((try*)
                (let ((result (mal5-run (cadr items) env)))
                  (if (mal5-pending-throw?)
                      (if (< (length items) 3) result
                          (let ((clause (mal-value (list-ref items 2)))
                                (raised (mal5-take-throw)))
                            (if (or (null? clause)
                                    (not (eq? (mal-value (car clause)) 'catch*)))
                                result
                                (let ((child (mal3-make-env env)))
                                  (mal3-env-set child
                                    (mal-value (cadr clause)) raised)
                                  (mal5-bounce (list-ref clause 2) child)))))
                      result)))
               ((fn*)
                (mal-func (list-ref items 2)
                  (map mal-value
                    (mal5-sequence-value (mal-value (cadr items)))) env))
               (else
                (let ((op (mal5-run (car items) env))
                      (raw-args (cdr items)))
                  (if (and (mal-func? op) (mal-func-macro? op))
                      (mal5-bounce (mal5-call op raw-args) env)
                      (let ((args (map (lambda (item) (mal5-run item env))
                                       raw-args)))
                        (if (mal5-pending-throw?) mal5-throw-value
                        (if (mal-func? op)
                            (mal5-bounce (mal-func-ast op)
                              (mal3-make-bound-env (mal-func-env op)
                                                   (mal-func-params op) args))
                            (apply (if (mal5-native? op) (mal5-native-op op) op)
                                   args)))))))))))
      (else ast))))))

(define mal5-repl-env
  (let ((env (mal3-make-env (mal4-environment))))
    (mal3-env-set env 'read-string
      (lambda (x) (mal5-read-string-safe (mal-value x))))
    (mal3-env-set env 'eval (lambda (ast) (mal5-run ast env)))
    (mal3-env-set env 'slurp (lambda (path) (mal-string (mal5-slurp (mal-value path)))))
    (mal3-env-set env 'load-file (lambda (path) (mal5-load-file (mal-value path) env)))
    ; Mal identifiers are case-sensitive even though R5RS source identifiers are
    ; folded. Construct this host-provided uppercase name dynamically.
    (mal3-env-set env (string->symbol "*ARGV*") (mal-list '()))
    (mal3-env-set env 'atom (lambda (x) (mal-atom x)))
    (mal3-env-set env 'atom? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'atom)))))
    (mal3-env-set env 'deref (lambda (x) (mal-value x)))
    (mal3-env-set env 'reset! (lambda (atom x) (mal-value-set! atom x) x))
    (mal3-env-set env 'swap! (lambda (atom op . args) (mal5-swap atom op args)))
    (mal3-env-set env 'cons (lambda (x xs)
      (mal-list (cons x (mal5-sequence-value (mal-value xs))))))
    (mal3-env-set env 'concat (lambda args (mal-list (mal5-concat args))))
    (mal3-env-set env 'vec (lambda (x)
      (if (eq? (mal-type x) 'vector) x
          (mal-vector (list->vector (mal-value x))))))
    (mal3-env-set env 'vector (lambda args (mal-vector (list->vector args))))
    (mal3-env-set env 'nth (lambda (x n)
      (let ((items (mal5-sequence-value (mal-value x)))
            (index (mal-value n)))
        (if (or (< index 0) (>= index (length items)))
            (mal5-raise (mal-string "nth index beyond length"))
            (list-ref items index)))))
    (mal3-env-set env 'first (lambda (x)
      (if (eq? x (mal-nil-value)) (mal-nil-value)
          (let ((items (mal5-sequence-value (mal-value x))))
            (if (null? items) (mal-nil-value) (car items))))))
    (mal3-env-set env 'rest (lambda (x)
      (if (eq? x (mal-nil-value)) (mal-list '())
          (let ((items (mal5-sequence-value (mal-value x))))
            (mal-list (if (null? items) '() (cdr items)))))))
    (mal3-env-set env 'macro? (lambda (x)
      (mal4-bool (and (mal-func? x) (mal-func-macro? x)))))
    (mal3-env-set env 'nil? (lambda (x) (mal4-bool (eq? x (mal-nil-value)))))
    (mal3-env-set env 'true? (lambda (x) (mal4-bool (eq? x (mal-true-value)))))
    (mal3-env-set env 'false? (lambda (x) (mal4-bool (eq? x (mal-false-value)))))
    (mal3-env-set env 'number? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'number)))))
    (mal3-env-set env 'string? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'string)))))
    (mal3-env-set env 'symbol? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'symbol)))))
    (mal3-env-set env 'symbol (lambda (x)
      (mal-symbol (string->symbol (mal-value x)))))
    (mal3-env-set env 'keyword? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'keyword)))))
    (mal3-env-set env 'keyword (lambda (x)
      (if (and (mal-object? x) (eq? (mal-type x) 'keyword)) x
          (mal-keyword (string->symbol (mal-value x))))))
    (mal3-env-set env 'vector? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'vector)))))
    (mal3-env-set env 'map? (lambda (x) (mal4-bool
      (and (mal-object? x) (eq? (mal-type x) 'map)))))
    (mal3-env-set env 'fn? (lambda (x) (mal4-bool
      (or (procedure? x) (or (mal5-native? x)
          (and (mal-func? x) (not (mal-func-macro? x))))))))
    (mal3-env-set env 'assoc (lambda (map . kvs) (mal-map (mal5-map-assoc map kvs))))
    (mal3-env-set env 'get (lambda (map key)
      (if (eq? map (mal-nil-value)) (mal-nil-value)
          (let ((value (mal5-map-ref key (mal-value map))))
            (if value value (mal-nil-value))))))
    (mal3-env-set env 'contains? (lambda (map key)
      (mal4-bool (if (eq? map (mal-nil-value)) #f
                     (mal5-map-ref key (mal-value map))))))
    (mal3-env-set env 'hash-map (lambda args (mal-map (mal5-pairs args))))
    (mal3-env-set env 'dissoc (lambda (map . keys)
      (mal-map (mal5-map-remove keys (mal-value map)))))
    (mal3-env-set env 'keys (lambda (collection)
      (mal-list (map car (mal-value collection)))))
    (mal3-env-set env 'vals (lambda (collection)
      (mal-list (map cdr (mal-value collection)))))
    (mal3-env-set env 'sequential? (lambda (x) (mal4-bool
      (and (mal-object? x) (memq (mal-type x) '(list vector))))))
    (mal3-env-set env 'apply (lambda (op . args) (mal5-apply-args op args)))
    (mal3-env-set env 'map (lambda (op items)
      (mal-list (mal5-map-call op (mal5-sequence-value (mal-value items))))))
    (mal3-env-set env 'conj (lambda (collection . args)
      (if (eq? (mal-type collection) 'vector)
          (mal-vector (list->vector
            (append (vector->list (mal-value collection)) args)))
          (mal-list (append (reverse args) (mal-value collection))))))
    (mal3-env-set env 'seq (lambda (x) (mal5-seq x)))
    (mal3-env-set env 'with-meta (lambda (x metadata) (mal5-with-meta x metadata)))
    (mal3-env-set env 'meta (lambda (x)
      (let ((metadata (if (mal-func? x) (mal-func-meta x)
                          (if (mal5-native? x) (mal5-native-meta x)
                              (if (mal-object? x) (mal-meta x) #f)))))
        (if metadata metadata (mal-nil-value)))))
    (mal3-env-set env 'prn (lambda args
      (display (mal4-printed args #t " ")) (newline) (mal-nil-value)))
    (mal3-env-set env 'println (lambda args
      (display (mal4-printed args #f " ")) (newline) (mal-nil-value)))
    ; Successful self-hosting does not exercise these error/interactive paths.
    ; They remain present in core_ns; catchable exceptions are tracked separately.
    (mal3-env-set env 'throw (lambda (x) (mal5-raise x)))
    (mal3-env-set env 'readline (lambda (prompt) (mal5-readline prompt)))
    (mal3-env-set env (string->symbol "*host-language*") (mal-string "scheme (coil)"))
    (mal3-env-set env 'time-ms (host/make-mal-time-procedure))
    (mal5-run (mal-read-string
      "(defmacro! cond (fn* (& xs) (if (> (count xs) 0) (list 'if (first xs) (if (> (count xs) 1) (nth xs 1) nil) (cons 'cond (rest (rest xs)))))))") env)
    ; The arithmetic core lives in the outer stage-4 environment. Promote its
    ; hottest bindings into this environment so every interpreted `+`, `-`, or
    ; comparison does not linearly scan the whole stepA namespace first.
    (mal3-env-set env '+ (mal3-env-get (mal3-env-outer env) '+))
    (mal3-env-set env '- (mal3-env-get (mal3-env-outer env) '-))
    (mal3-env-set env '* (mal3-env-get (mal3-env-outer env) '*))
    (mal3-env-set env '/ (mal3-env-get (mal3-env-outer env) '/))
    (mal3-env-set env '= (mal3-env-get (mal3-env-outer env) '=))
    (mal3-env-set env '< (mal3-env-get (mal3-env-outer env) '<))
    (mal3-env-set env '<= (mal3-env-get (mal3-env-outer env) '<=))
    (mal3-env-set env '> (mal3-env-get (mal3-env-outer env) '>))
    (mal3-env-set env '>= (mal3-env-get (mal3-env-outer env) '>=))
    (gc-root-permanent env)
    env))
(define (mal5-rep input)
  (let ((result (mal5-run (mal5-read-string-safe input) mal5-repl-env)))
    (if (mal5-pending-throw?)
        (string-append "Error: " (mal-print (mal5-take-throw) #t))
        (mal-print result #t))))
(define (mal5-eval ast env) (mal5-run ast env))

(export mal5-rep mal5-eval mal5-repl-env mal5-run mal5-readline-from-port)
