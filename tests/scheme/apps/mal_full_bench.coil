(module scheme-mal-full-bench)
(import "coil.scheme" :use *)
(import "scheme-mal-stage5" :use *)

(define (mal-full-bench-loop n result)
  (if (= n 0) result
      (begin
        (mal5-rep "(sum2 200 0)")
        (mal5-rep "(fib 12)")
        (mal5-rep "(unless false (plus7 8) 0)")
        (mal-full-bench-loop (- n 1) (mal5-rep "(sum2 50 0)")))))

(define (mal-full-benchmark)
  (mal5-rep "(def! sum2 (fn* (n acc) (if (= n 0) acc (sum2 (- n 1) (+ n acc)))))")
  (mal5-rep "(def! fib (fn* (n) (if (<= n 1) n (+ (fib (- n 1)) (fib (- n 2))))))")
  (mal5-rep "(def! plus7 ((fn* (x) (fn* (y) (+ x y))) 7))")
  (mal5-rep "(defmacro! unless (fn* (pred yes no) `(if ~pred ~no ~yes)))")
  (mal-full-bench-loop 100 ""))

(export mal-full-benchmark)
