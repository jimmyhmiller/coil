(module scheme-mal-host-test)
(import "coil.assert" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.symbol" :as symbol)
(import "coil.str" :use *)
(import "scheme-mal-host" :use *)
(import "scheme-mal-stage1" :use *)

(deftest time-value-is-a-mal-number
  (let [value (mal-time-value)]
    (assert (is-heap value))
    (assert (is-symbol (mal-type value)))))

(deftest time-procedure-is-callable
  (let [value (stdproc/call--0 (make-mal-time-procedure))]
    (assert (is-heap value))
    (assert (is-symbol (mal-type value)))
    (assert (str-eq (symbol/symbol-name (mal-type value)) "number"))
    (assert (is-string (mal-print value (s-true))))))

(deftest time-procedure-is-callable-through-dynamic-apply
  (let [p (make-mal-time-procedure)
        args (cons p (cons (s-nil) (s-nil)))
        value (stdproc/scm-apply-args args)]
    (assert (is-heap value))
    (assert (is-symbol (mal-type value)))
    (assert (str-eq (symbol/symbol-name (mal-type value)) "number"))))
