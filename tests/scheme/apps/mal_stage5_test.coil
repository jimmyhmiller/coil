(module scheme-mal-stage5-test)
(import "coil.scheme.check" :use *)
(import "coil.scheme" :use *)
(import "scheme-mal-stage5" :use *)
(import "scheme-mal-stage1" :use *)

(deftest upstream-mal-stage5-argv
  (check (string=? (mal5-rep "*ARGV*") "()") 1)
)

(deftest upstream-mal-stage5-time
  (check (string? (mal5-rep "(time-ms)")) 2)
)

(deftest upstream-mal-stage5-time-predicate
  (check (string=? (mal5-rep "(number? (time-ms))") "true") 3)
)

(deftest upstream-mal-stage5-time-binding
  (mal5-rep "(def! start-time (time-ms))")
  (check (string=? (mal5-rep "(number? start-time)") "true") 4))

(deftest upstream-mal-stage5-tail-call
  (mal5-rep "(def! sum2 (fn* (n acc) (if (= n 0) acc (sum2 (- n 1) (+ n acc)))))")
  (check (string=? (mal5-rep "(sum2 10000 0)") "50005000") 5))

(deftest mal-map-equality-is-order-independent
  (check (string=?
    (mal5-rep "(= {:a 11 :b 22} (hash-map :b 22 :a 11))") "true") 6))

(deftest mal-errors-are-values-caught-by-try
  (check (string=? (mal5-rep "(try* abc (catch* e e))")
                   "\"abc not found\"") 7)
  (check (string=? (mal5-rep "(try* (nth () 1) (catch* e e))")
                   "\"nth index beyond length\"") 8)
  (check (string=? (mal5-rep "(try* (throw (list 1 2 3)) (catch* e e))")
                   "(1 2 3)") 9)
  (check (string=? (mal5-rep "(throw \"err1\")")
                   "Error: \"err1\"") 10)
  (check (string=?
    (mal5-rep "(try* (eval (read-string \"(+ 1\")) (catch* e e))")
    "\"unexpected EOF: unbalanced sequence\"") 11)
  (check (string=?
    (mal5-rep "(try* (eval (read-string \"[+ 1\")) (catch* e e))")
    "\"unexpected EOF: unbalanced sequence\"") 12)
  (check (string=?
    (mal5-rep "(try* (eval (read-string \"{:a 1\")) (catch* e e))")
    "\"unexpected EOF: unbalanced sequence\"") 13))

(deftest mal-readline-reads-one-line-from-a-port
  (let ((port (open-input-file "tests/scheme/fixtures/mal-readline.txt")))
    (let ((value (mal5-readline-from-port port)))
      (close-input-port port)
      (check (string=? (mal-print value #t) "\"hello from readline\"") 14))))

(deftest failed-def-does-not-overwrite-the-old-binding
  (mal5-rep "(def! x \"x\")")
  (check (string=? (mal5-rep "(def! x (nth (list 1 2) 2))")
                   "Error: \"nth index beyond length\"") 15)
  (check (string=? (mal5-rep "x") "\"x\"") 16)
  (check (string=? (mal5-rep "(def! x (nth [1 2] 2))")
                   "Error: \"nth index beyond length\"") 17)
  (check (string=? (mal5-rep "x") "\"x\"") 18))
