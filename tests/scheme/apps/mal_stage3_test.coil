(module scheme-mal-stage3-test)
(import "coil.assert" :use *)
(import "coil.scheme" :use *)
(import "scheme-mal-stage3" :use *)

(define (expect input wanted)
  (assert (string=? (mal3-rep input) wanted)))

(deftest upstream-mal-stage3-environments
  (expect "(+ 1 2)" "3")
  (expect "(def! x 3)" "3")
  (expect "x" "3")
  (expect "(def! x 4)" "4")
  (expect "x" "4")
  (expect "(def! y (+ 1 7))" "8")
  (expect "y" "8")
  (expect "(def! mynum 111)" "111")
  (expect "(def! MYNUM 222)" "222")
  (expect "mynum" "111")
  (expect "MYNUM" "222"))

(deftest upstream-mal-stage3-let-star
  ; Test roots are independent; establish the upstream corpus's preceding state.
  (expect "(def! x 4)" "4")
  (expect "(let* (z 9) z)" "9")
  (expect "(let* (x 9) x)" "9")
  (expect "x" "4")
  (expect "(let* (z (+ 2 3)) (+ 1 z))" "6")
  (expect "(let* (p (+ 2 3) q (+ 2 p)) (+ p q))" "12")
  (expect "(let* [z 9] z)" "9")
  (expect "(let* [a 5 b 6] [3 4 a [b 7] 8])" "[3 4 5 [6 7] 8]")
  (expect "(let* (z 2) (let* (q 9) x))" "4")
  (expect "(let* (x 2 x 3) x)" "3"))
