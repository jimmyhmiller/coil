(module scheme-lox-cli)
(import "coil.primitive" :as primitive)
(import "coil.str" :use [cstr->str])
(import "coil.scheme.stdproc" :as stdproc)
(import "coil.scheme.value" :as value)
(import "scheme-lox" :as lox)

;; The interpreter and file reader live in portable Scheme. This small host ABI
;; adapter is the only non-R5RS layer: turn argv[1] into the canonical Scheme
;; string representation and hand it to `lox-run-file`.
(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (if (= (primitive/cast i64 argc) 2)
      (do
        (value/fixnum-value
          (lox/lox-run-file
            (stdproc/string-from-slice
              (cstr->str (load (primitive/index argv 1)))))))
      64))
