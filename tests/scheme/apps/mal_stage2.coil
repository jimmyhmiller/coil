(module scheme-mal-stage2)
(import "coil.scheme" :use *)
(import "scheme-mal-stage1" :use *)

;; Compatibility port of upstream Mal step2_eval.scm. The evaluator and its
;; environment structure remain the upstream algorithm; only R7RS library helpers
;; are expressed through Coil Scheme's R5RS procedures.
(define (mal-env-ref key env)
  (let ((entry (assq key env)))
    (if entry (cdr entry) #f)))

(define mal-repl-env
  (let ((env (list (cons '+ (lambda (a b) (mal-number (+ (mal-value a) (mal-value b)))))
        (cons '- (lambda (a b) (mal-number (- (mal-value a) (mal-value b)))))
        (cons '* (lambda (a b) (mal-number (* (mal-value a) (mal-value b)))))
        (cons '/ (lambda (a b) (mal-number (/ (mal-value a) (mal-value b))))))))
    (gc-root-permanent env) env))

(define (mal-eval-alist xs env)
  (if (null? xs) '()
      (cons (cons (caar xs) (mal-eval (cdar xs) env))
            (mal-eval-alist (cdr xs) env))))

(define (mal-eval ast env)
  (let ((type (and (mal-object? ast) (mal-type ast))))
  (case type
    ((symbol)
     (mal-env-ref (mal-value ast) env))
    ((vector)
     (mal-vector
       (list->vector
         (map (lambda (item) (mal-eval item env))
              (vector->list (mal-value ast))))))
    ((map)
     (mal-map (mal-eval-alist (mal-value ast) env)))
    ((list)
     (let ((items (mal-value ast)))
       (if (null? items) ast
           (let ((op (mal-eval (car items) env))
                 (ops (map (lambda (item) (mal-eval item env)) (cdr items))))
             (apply op ops)))))
    (else ast))))

(define (mal-eval-rep input)
  (mal-print (mal-eval (mal-read-string input) mal-repl-env) #t))

(export mal-eval mal-eval-rep mal-repl-env)
