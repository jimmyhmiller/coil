(module scheme-mal-stage1)
(import "coil.scheme" :use *)
(import "scheme-mal-runtime" :as runtime)

;; Compatibility port of kanaka/mal's R7RS Scheme reader/printer, pinned and
;; attributed in tests/scheme/third_party/mal/UPSTREAM.md.  This deliberately
;; retains Mal's tagged object model instead of replacing it with Coil-specific
;; host structs.

(define (mal-object type value)
  (runtime/make-mal-record type value #f))
(define (mal-object? x) (runtime/mal-record? x))
(define (mal-type x) (runtime/mal-record-kind x))
(define (mal-value x) (runtime/mal-record-value x))
(define (mal-value-set! x value) (runtime/mal-record-value-set! x value))
(define (mal-meta x) (runtime/mal-record-meta x))
(define (mal-meta-set! x value) (runtime/mal-record-meta-set! x value))

(define mal-true
  (let ((value (mal-object 'true #t))) (gc-root-permanent value) value))
(define mal-false
  (let ((value (mal-object 'false #f))) (gc-root-permanent value) value))
(define mal-nil
  (let ((value (mal-object 'nil #f))) (gc-root-permanent value) value))
(define (mal-true-value) mal-true)
(define (mal-false-value) mal-false)
(define (mal-nil-value) mal-nil)
(define (mal-number x) (mal-object 'number x))
(define (mal-string x) (mal-object 'string x))
(define (mal-symbol x) (mal-object 'symbol x))
(define (mal-keyword x) (mal-object 'keyword x))
(define (mal-list x) (mal-object 'list x))
(define (mal-vector x) (mal-object 'vector x))
(define (mal-map x) (mal-object 'map x))
(define (mal-atom x) (mal-object 'atom x))
(define (mal-error message) (mal-object 'error message))
(define (mal-error? x)
  (and (mal-object? x) (eq? (mal-type x) 'error)))
(define (mal-func ast params env)
  (vector 'mal-func ast params env #f #f))
(define (mal-func? x)
  (and (vector? x)
       (and (= (vector-length x) 6) (eq? (vector-ref x 0) 'mal-func))))
(define (mal-func-ast x) (vector-ref x 1))
(define (mal-func-params x) (vector-ref x 2))
(define (mal-func-env x) (vector-ref x 3))
(define (mal-func-macro? x) (vector-ref x 4))
(define (mal-func-macro-set! x value) (vector-set! x 4 value))
(define (mal-func-meta x) (vector-ref x 5))
(define (mal-func-meta-set! x value) (vector-set! x 5 value))

(define (mal-char->string c) (list->string (list c)))
(define (mal-char-code=? c n) (= (char->integer c) n))
(define (mal-whitespace? c)
  (or (char-whitespace? c) (mal-char-code=? c 44)))
(define (mal-special? c)
  (or (mal-char-code=? c 91)
      (or (mal-char-code=? c 93)
      (or (mal-char-code=? c 123)
      (or (mal-char-code=? c 125)
      (or (mal-char-code=? c 40)
      (or (mal-char-code=? c 41)
      (or (mal-char-code=? c 39)
      (or (mal-char-code=? c 96)
      (or (mal-char-code=? c 126)
      (or (mal-char-code=? c 94)
          (mal-char-code=? c 64))))))))))))
(define (mal-word-end? c)
  (or (mal-whitespace? c)
      (or (mal-special? c)
          (or (mal-char-code=? c 34) (mal-char-code=? c 59)))))

(define (mal-scan-string-end s i n escaped)
  (if (>= i n) n
      (let ((c (string-ref s i)))
        (if escaped
            (mal-scan-string-end s (+ i 1) n #f)
            (if (mal-char-code=? c 92)
                (mal-scan-string-end s (+ i 1) n #t)
                (if (mal-char-code=? c 34) (+ i 1)
                    (mal-scan-string-end s (+ i 1) n #f)))))))
(define (mal-scan-word-end s i n)
  (if (or (>= i n) (mal-word-end? (string-ref s i))) i
      (mal-scan-word-end s (+ i 1) n)))
(define (mal-skip-comment s i n)
  (if (or (>= i n) (char=? (string-ref s i) #\newline)) i
      (mal-skip-comment s (+ i 1) n)))
(define (mal-tokenize-from s i n rev)
  (if (>= i n) (reverse rev)
      (let ((c (string-ref s i)))
        (if (mal-whitespace? c)
            (mal-tokenize-from s (+ i 1) n rev)
        (if (mal-char-code=? c 59)
            (mal-tokenize-from s (mal-skip-comment s (+ i 1) n) n rev)
        (if (mal-char-code=? c 126)
            (if (< (+ i 1) n)
                (if (mal-char-code=? (string-ref s (+ i 1)) 64)
                    (mal-tokenize-from s (+ i 2) n (cons "~@" rev))
                    (mal-tokenize-from s (+ i 1) n (cons "~" rev)))
                (mal-tokenize-from s (+ i 1) n (cons "~" rev)))
        (if (mal-char-code=? c 34)
            (let ((end (mal-scan-string-end s (+ i 1) n #f)))
              (mal-tokenize-from s end n (cons (substring s i end) rev)))
        (if (mal-special? c)
            (mal-tokenize-from s (+ i 1) n (cons (mal-char->string c) rev))
            (let ((end (mal-scan-word-end s (+ i 1) n)))
              (mal-tokenize-from s end n (cons (substring s i end) rev)))))))))))
(define (mal-tokenize s)
  (mal-tokenize-from s 0 (string-length s) '()))

;; Upstream uses an R7RS record with mutable position. A three-slot vector has
;; precisely the same private product semantics for this compatibility port.
(define (mal-reader tokens) (vector 'reader (list->vector tokens) 0))
(define (mal-reader-tokens r) (vector-ref r 1))
(define (mal-reader-position r) (vector-ref r 2))
(define (mal-reader-position-set! r i) (vector-set! r 2 i))
(define (mal-peek r)
  (let ((i (mal-reader-position r)) (v (mal-reader-tokens r)))
    (if (>= i (vector-length v)) #f (vector-ref v i))))
(define (mal-next r)
  (let ((x (mal-peek r)))
    (if x (mal-reader-position-set! r (+ (mal-reader-position r) 1)) #f)
    x))

(define (mal-unescape-from token i end rev)
  (if (>= i end) (list->string (reverse rev))
      (let ((c (string-ref token i)))
        (if (and (mal-char-code=? c 92) (< (+ i 1) end))
            (let ((e (string-ref token (+ i 1))))
              (mal-unescape-from token (+ i 2) end
                (cons (if (char=? e #\n) #\newline e) rev)))
            (mal-unescape-from token (+ i 1) end (cons c rev))))))
(define (mal-unescape token)
  (mal-unescape-from token 1 (- (string-length token) 1) '()))

(define (mal-map-key-equal? a b)
  (and (eq? (mal-type a) (mal-type b))
       (equal? (mal-value a) (mal-value b))))
(define (mal-alist-has-key? key entries)
  (if (null? entries) #f
      (or (mal-map-key-equal? key (caar entries))
          (mal-alist-has-key? key (cdr entries)))))
(define (mal-list->alist xs)
  (if (null? xs) '()
      (let ((tail (mal-list->alist (cddr xs))))
        ; Mal maps retain the last value for a duplicate key. Build from the
        ; right so an earlier occurrence is simply omitted when the tail already
        ; contains that key.
        (if (mal-alist-has-key? (car xs) tail) tail
            (cons (cons (car xs) (cadr xs)) tail)))))
(define (mal-read-macro r name)
  (mal-next r)
  (let ((form (mal-read-form r)))
    (if (mal-error? form) form
        (mal-list (list (mal-symbol name) form)))))
(define (mal-read-list-items r end rev)
  (let ((token (mal-peek r)))
    (if (not token) (mal-error "unexpected EOF: unbalanced sequence")
    (if (equal? token end)
        (begin (mal-next r) (reverse rev))
        (let ((form (mal-read-form r)))
          (if (mal-error? form) form
              (mal-read-list-items r end (cons form rev))))))))
(define (mal-read-sequence r end kind)
  (mal-next r)
  (let ((items (mal-read-list-items r end '())))
    (if (mal-error? items) items
        (case kind
          ((list) (mal-list items))
          ((vector) (mal-vector (list->vector items)))
          ((map) (mal-map (mal-list->alist items)))))))
(define (mal-read-atom r)
  (let ((token (mal-next r)))
    (if (string=? token "true") mal-true
    (if (string=? token "false") mal-false
    (if (string=? token "nil") mal-nil
    (if (string->number token) (mal-number (string->number token))
    (if (mal-char-code=? (string-ref token 0) 34) (mal-string (mal-unescape token))
    (if (mal-char-code=? (string-ref token 0) 58)
        (mal-keyword (string->symbol (substring token 1 (string-length token))))
        (mal-symbol (string->symbol token))))))))))
(define (mal-read-form r)
  (let ((token (mal-peek r)))
    (if (not token) (mal-error "unexpected EOF: unbalanced input")
    (if (string=? token "'") (mal-read-macro r 'quote)
    (if (string=? token "`") (mal-read-macro r 'quasiquote)
    (if (string=? token "~") (mal-read-macro r 'unquote)
    (if (string=? token "~@") (mal-read-macro r 'splice-unquote)
    (if (string=? token "@") (mal-read-macro r 'deref)
    (if (string=? token "^")
        (begin
          (mal-next r)
          (let ((meta (mal-read-form r)))
            (mal-list (list (mal-symbol 'with-meta) (mal-read-form r) meta))))
    (if (string=? token "(") (mal-read-sequence r ")" 'list)
    (if (string=? token "[") (mal-read-sequence r "]" 'vector)
    (if (string=? token "{") (mal-read-sequence r "}" 'map)
        (mal-read-atom r)))))))))))))
(define (mal-read-string input)
  (let ((tokens (mal-tokenize input)))
    (if (null? tokens) mal-nil
        (mal-read-form (mal-reader tokens)))))

(define (mal-join xs sep)
  (if (null? xs) ""
      (if (null? (cdr xs)) (car xs)
          (string-append (car xs) sep (mal-join (cdr xs) sep)))))
(define (mal-escape-string-from s i n)
  (if (>= i n) ""
      (let ((c (string-ref s i)))
        (string-append
          (if (mal-char-code=? c 92) "\\\\"
              (if (mal-char-code=? c 34) "\\\""
                  (if (mal-char-code=? c 10) "\\n"
                      (mal-char->string c))))
          (mal-escape-string-from s (+ i 1) n)))))
(define (mal-escape-string s)
  (string-append "\"" (mal-escape-string-from s 0 (string-length s)) "\""))
(define (mal-map-flat xs)
  (if (null? xs) '()
      (cons (caar xs) (cons (cdar xs) (mal-map-flat (cdr xs))))))
(define (mal-print-list xs open close readable)
  (string-append open
    (mal-join (map (lambda (x) (mal-print x readable)) xs) " ") close))
(define (mal-print ast readable)
  (if (procedure? ast) "#<fn>"
  (if (mal-func? ast) "#<func>"
  (let ((type (mal-type ast)) (value (mal-value ast)))
    (case type
      ((true) "true")
      ((false) "false")
      ((nil) "nil")
      ((number) (number->string value))
      ((string) (if readable (mal-escape-string value) value))
      ((keyword) (string-append ":" (symbol->string value)))
      ((symbol) (symbol->string value))
      ((list) (mal-print-list value "(" ")" readable))
      ((vector) (mal-print-list (vector->list value) "[" "]" readable))
      ((map) (mal-print-list (mal-map-flat value) "{" "}" readable))
      ((atom) (string-append "(atom " (mal-print value readable) ")"))
      (else "#<unknown>"))))))

(define (mal-rep input) (mal-print (mal-read-string input) #t))

(export mal-object mal-object? mal-type mal-value mal-value-set! mal-meta mal-meta-set!
        mal-true-value mal-false-value mal-nil-value
        mal-number mal-string mal-symbol mal-keyword mal-list mal-vector mal-map mal-atom
        mal-error mal-error?
        mal-func mal-func? mal-func-ast mal-func-params mal-func-env
        mal-func-macro? mal-func-macro-set!
        mal-func-meta mal-func-meta-set!
        mal-list->alist mal-read-string mal-print mal-rep)
