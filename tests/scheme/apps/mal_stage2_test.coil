(module scheme-mal-stage2-test)
(import "coil.assert" :use *)
(import "coil.scheme" :use *)
(import "scheme-mal-stage2" :use *)

(deftest upstream-mal-stage2-arithmetic
  (assert (string=? (mal-eval-rep "(+ 1 2)") "3"))
  (assert (string=? (mal-eval-rep "(+ 5 (* 2 3))") "11"))
  (assert (string=? (mal-eval-rep "(/ (- (+ 515 (* 87 311)) 302) 27)") "1010"))
  (assert (string=? (mal-eval-rep "(* -3 6)") "-18")))

(deftest upstream-mal-stage2-collections
  (assert (string=? (mal-eval-rep "()") "()"))
  (assert (string=? (mal-eval-rep "[nil]") "[nil]"))
  (assert (string=? (mal-eval-rep "[1 2 (+ 1 2)]") "[1 2 3]"))
  (assert (string=? (mal-eval-rep "{\"a\" (+ 7 8)}") "{\"a\" 15}"))
  (assert (string=? (mal-eval-rep "{:a (+ 7 8)}") "{:a 15}"))
  (assert (string=? (mal-eval-rep "[]") "[]"))
  (assert (string=? (mal-eval-rep "{}") "{}")))
