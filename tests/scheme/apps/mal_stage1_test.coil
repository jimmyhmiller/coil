(module scheme-mal-stage1-test)
(import "coil.scheme.check" :use *)
(import "scheme-mal-stage1" :use *)
(import "coil.scheme" :use *)

;; Smoke representatives from upstream tests/step1_read_print.mal. The Python
;; corpus runner expands this to the complete pinned successful-case set.
(deftest upstream-mal-number
  (check (string=? (mal-rep "1") "1") 401))
(deftest upstream-mal-symbol
  (check (string=? (mal-rep "abc-def") "abc-def") 402))
(deftest upstream-mal-nested-list
  (check (string=? (mal-rep "(+ 1 (+ 2 3))") "(+ 1 (+ 2 3))") 403))
(deftest upstream-mal-comma-whitespace
  (check (string=? (mal-rep "(1 2, 3,,,,)") "(1 2 3)") 404))
(deftest upstream-mal-string-escape
  (check (string=? (mal-rep "\"abc\\\"def\"") "\"abc\\\"def\"") 405))
(deftest upstream-mal-quote
  (check (string=? (mal-rep "'(1 2 3)") "(quote (1 2 3))") 406))
(deftest upstream-mal-vector
  (check (string=? (mal-rep "[+ 1 [+ 2 3]]") "[+ 1 [+ 2 3]]") 407))
(deftest upstream-mal-map
  (check (string=? (mal-rep "{:a {:b 2}}") "{:a {:b 2}}") 408))
(deftest upstream-mal-comment
  (check (string=? (mal-rep "1 ; ignored") "1") 409))
