(module scheme-lox)
;; A portable Scheme tree-walking Lox interpreter. It scans real source text,
;; builds a tagged-list AST with recursive descent, then executes it against a
;; mutable association-list environment. The acceptance program exercises
;; functions/closures as well as classes, fields, inheritance, `this`, and
;; `super` without relying on continuations or implementation extensions.
(import "coil.scheme" :use *)

(define lox-diagnostic #f)
(define lox-diagnostics '())
(define (diagnose! phase message)
  (if lox-diagnostic #f
      (let ((diagnostic (list phase message)))
        (set! lox-diagnostic diagnostic)
        (set! lox-diagnostics (list diagnostic))))
  'nil)
;; Add an independent error after an earlier one. Ordinary scanner, parser, and
;; runtime paths remain first-error-only so recovery does not emit cascades.
(define (diagnose-next! phase message)
  (let ((diagnostic (list phase message)))
    (if lox-diagnostic #f (set! lox-diagnostic diagnostic))
    (set! lox-diagnostics (append lox-diagnostics (list diagnostic))))
  'nil)
(define (report-diagnostics diagnostics)
  (if (pair? diagnostics)
      (begin
        (display "[") (display (car (car diagnostics))) (display "] ")
        (display (cadr (car diagnostics))) (newline)
        (report-diagnostics (cdr diagnostics)))
      #f))

;; ---- scanner ---------------------------------------------------------------
(define (digit? c)
  (if (char<? c #\0) #f (if (char>? c #\9) #f #t)))
(define (alpha? c)
  (if (char=? c #\_) #t
      (if (char<? c #\A) #f
          (if (char>? c #\z) #f
              (if (and (char>? c #\Z) (char<? c #\a)) #f #t)))))
(define (alnum? c) (or (alpha? c) (digit? c)))
(define (space? c)
  (or (char=? c #\space)
      (or (char=? c #\newline) (char=? c #\tab))))
(define (ch-left-paren) (integer->char 40))
(define (ch-right-paren) (integer->char 41))
(define (ch-left-brace) (integer->char 123))
(define (ch-right-brace) (integer->char 125))
(define (ch-semicolon) (integer->char 59))
(define (ch-plus) (integer->char 43))
(define (ch-minus) (integer->char 45))
(define (ch-star) (integer->char 42))
(define (ch-slash) (integer->char 47))
(define (ch-less) (integer->char 60))
(define (ch-greater) (integer->char 62))
(define (ch-bang) (integer->char 33))
(define (ch-equal) (integer->char 61))
(define (ch-quote) (integer->char 34))
(define (ch-comma) (integer->char 44))
(define (ch-dot) (integer->char 46))

(define (token type value) (list type value))
(define (token-type t) (car t))
(define (token-value t) (cadr t))

;; Return `(value . remaining-characters)`. Every numeric spelling becomes an
;; inexact Scheme number, matching Lox's single binary64 numeric type.
(define (scan-integer chars value)
  (if (and (pair? chars) (digit? (car chars)))
      (scan-integer (cdr chars)
                    (+ (* value 10) (- (char->integer (car chars)) 48)))
      (cons value chars)))
(define (scan-fraction chars numerator scale)
  (if (and (pair? chars) (digit? (car chars)))
      (scan-fraction
        (cdr chars)
        (+ (* numerator 10) (- (char->integer (car chars)) 48))
        (* scale 10))
      (cons (exact->inexact (/ numerator scale)) chars)))
(define (scan-number chars)
  (let ((whole (scan-integer chars 0)))
    (let ((rest (cdr whole)))
      (if (and (pair? rest)
               (and (char=? (car rest) (ch-dot))
                    (and (pair? (cdr rest)) (digit? (cadr rest)))))
          (scan-fraction (cdr rest) (car whole) 1)
          (cons (exact->inexact (car whole)) rest)))))

(define (skip-comment chars)
  (if (null? chars) '()
      (if (char=? (car chars) #\newline) (cdr chars)
          (skip-comment (cdr chars)))))

(define (scan-name chars reversed)
  (if (and (pair? chars) (alnum? (car chars)))
      (scan-name (cdr chars) (cons (car chars) reversed))
      (cons (string->symbol (list->string (reverse reversed))) chars)))

(define (scan-string chars reversed)
  (if (null? chars)
      (begin
        (diagnose! 'scan "Unterminated string.")
        (cons (list->string (reverse reversed)) '()))
      (if (char=? (car chars) (ch-quote))
          (cons (list->string (reverse reversed)) (cdr chars))
          (scan-string (cdr chars) (cons (car chars) reversed)))))

(define (keyword-type name)
  (if (eq? name 'var) 'var
  (if (eq? name 'print) 'print
  (if (eq? name 'while) 'while
  (if (eq? name 'class) 'class
  (if (eq? name 'this) 'this
  (if (eq? name 'super) 'super
  (if (eq? name 'fun) 'fun
  (if (eq? name 'return) 'return
  (if (eq? name 'if) 'if
  (if (eq? name 'else) 'else
  (if (eq? name 'for) 'for
  (if (eq? name 'true) 'true
  (if (eq? name 'false) 'false
  (if (eq? name 'nil) 'nil
  (if (eq? name 'and) 'and
  (if (eq? name 'or) 'or 'identifier)))))))))))))))))

(define (scan-chars chars)
  (if (null? chars) (list (token 'eof 'eof))
    (let ((c (car chars)) (rest (cdr chars)))
      (cond
        ((space? c) (scan-chars rest))
        ((digit? c)
         (let ((r (scan-number chars)))
           (cons (token 'number (car r)) (scan-chars (cdr r)))))
        ((alpha? c)
         (let ((r (scan-name chars '())))
           (cons (token (keyword-type (car r)) (car r))
                 (scan-chars (cdr r)))))
        ((char=? c (ch-quote))
         (let ((r (scan-string rest '())))
           (cons (token 'string (car r)) (scan-chars (cdr r)))))
        ((char=? c (ch-left-paren)) (cons (token 'left-paren c) (scan-chars rest)))
        ((char=? c (ch-right-paren)) (cons (token 'right-paren c) (scan-chars rest)))
        ((char=? c (ch-left-brace)) (cons (token 'left-brace c) (scan-chars rest)))
        ((char=? c (ch-right-brace)) (cons (token 'right-brace c) (scan-chars rest)))
        ((char=? c (ch-semicolon)) (cons (token 'semicolon c) (scan-chars rest)))
        ((char=? c (ch-comma)) (cons (token 'comma c) (scan-chars rest)))
        ((char=? c (ch-dot)) (cons (token 'dot c) (scan-chars rest)))
        ((char=? c (ch-plus)) (cons (token 'plus c) (scan-chars rest)))
        ((char=? c (ch-minus)) (cons (token 'minus c) (scan-chars rest)))
        ((char=? c (ch-star)) (cons (token 'star c) (scan-chars rest)))
        ((char=? c (ch-slash))
         (if (and (pair? rest) (char=? (car rest) (ch-slash)))
             (scan-chars (skip-comment (cdr rest)))
             (cons (token 'slash c) (scan-chars rest))))
        ((char=? c (ch-less))
         (if (and (pair? rest) (char=? (car rest) (ch-equal)))
             (cons (token 'less-equal '<=) (scan-chars (cdr rest)))
             (cons (token 'less c) (scan-chars rest))))
        ((char=? c (ch-greater))
         (if (and (pair? rest) (char=? (car rest) (ch-equal)))
             (cons (token 'greater-equal '>=) (scan-chars (cdr rest)))
             (cons (token 'greater c) (scan-chars rest))))
        ((char=? c (ch-bang))
         (if (and (pair? rest) (char=? (car rest) (ch-equal)))
             (cons (token 'bang-equal '!=) (scan-chars (cdr rest)))
             (cons (token 'bang c) (scan-chars rest))))
        ((char=? c (ch-equal))
         (if (and (pair? rest) (char=? (car rest) (ch-equal)))
             (cons (token 'equal-equal '==) (scan-chars (cdr rest)))
             (cons (token 'equal '=) (scan-chars rest))))
        (else
          (diagnose! 'scan "Unexpected character.")
          (scan-chars rest))))))

(define (scan source) (scan-chars (string->list source)))

;; ---- parser ----------------------------------------------------------------
;; Every parser returns `(node . remaining-tokens)`.
(define (parsed-node r) (car r))
(define (parsed-rest r) (cdr r))
(define (at? tokens type)
  (and (pair? tokens) (eq? (token-type (car tokens)) type)))
(define (statement-end tokens)
  (if (at? tokens 'semicolon) (cdr tokens)
      (begin (diagnose! 'parse "Expect ';' after statement.") tokens)))

(define (parse-primary tokens)
  (let ((t (car tokens)) (rest (cdr tokens)))
    (if (eq? (token-type t) 'number)
        (cons (list 'literal (token-value t)) rest)
    (if (eq? (token-type t) 'true)
        (cons (list 'literal #t) rest)
    (if (eq? (token-type t) 'false)
        (cons (list 'literal #f) rest)
    (if (eq? (token-type t) 'nil)
        (cons (list 'literal 'nil) rest)
    (if (eq? (token-type t) 'string)
        (cons (list 'literal (token-value t)) rest)
    (if (eq? (token-type t) 'super)
        (if (not (at? rest 'dot))
            (begin
              (diagnose! 'parse "Expect '.' after 'super'.")
              (cons (list 'literal 'nil) rest))
            (if (not (at? (cdr rest) 'identifier))
                (begin
                  (diagnose! 'parse "Expect superclass method name.")
                  (cons (list 'literal 'nil) (cdr rest)))
                (cons (list 'super (token-value (cadr rest)))
                      (cdr (cdr rest)))))
    (if (eq? (token-type t) 'this)
        (cons (list 'this) rest)
    (if (eq? (token-type t) 'identifier)
        (cons (list 'variable (token-value t)) rest)
    (if (eq? (token-type t) 'left-paren)
        (let ((r (parse-expression rest)))
          (if (at? (parsed-rest r) 'right-paren)
              (cons (list 'grouping (parsed-node r))
                    (cdr (parsed-rest r)))
              (begin
                (diagnose! 'parse "Expect ')' after expression.")
                (cons (parsed-node r) (parsed-rest r)))))
        (begin
          (diagnose! 'parse "Expect expression.")
          (cons (list 'literal #f) rest)))))))))))))

(define (parse-factor-tail left tokens)
  (if (or (at? tokens 'star) (at? tokens 'slash))
      (let ((op (token-type (car tokens)))
            (r (parse-unary (cdr tokens))))
        (parse-factor-tail (list 'binary op left (parsed-node r))
                           (parsed-rest r)))
      (cons left tokens)))
(define (parse-factor tokens)
  (let ((r (parse-unary tokens)))
    (parse-factor-tail (parsed-node r) (parsed-rest r))))

(define (parse-arguments tokens reversed)
  (if (at? tokens 'right-paren)
      (cons (reverse reversed) (cdr tokens))
      (let ((r (parse-expression tokens)))
        (if (>= (length reversed) 255)
            (diagnose! 'parse "Can't have more than 255 arguments.") #f)
        (if (at? (parsed-rest r) 'comma)
            (parse-arguments (cdr (parsed-rest r))
                             (cons (parsed-node r) reversed))
            (cons (reverse (cons (parsed-node r) reversed))
                  (cdr (parsed-rest r)))))))

(define (parse-call-tail callee tokens)
  (if (at? tokens 'left-paren)
      (let ((args (parse-arguments (cdr tokens) '())))
        (parse-call-tail (list 'call callee (parsed-node args))
                         (parsed-rest args)))
      (if (at? tokens 'dot)
          (if (at? (cdr tokens) 'identifier)
              (parse-call-tail (list 'get callee (token-value (cadr tokens)))
                               (cdr (cdr tokens)))
              (begin
                (diagnose! 'parse "Expect property name after '.'.")
                (cons callee (cdr tokens))))
          (cons callee tokens))))
(define (parse-call tokens)
  (let ((r (parse-primary tokens)))
    (parse-call-tail (parsed-node r) (parsed-rest r))))

(define (parse-unary tokens)
  (if (or (at? tokens 'bang) (at? tokens 'minus))
      (let ((op (token-type (car tokens)))
            (right (parse-unary (cdr tokens))))
        (cons (list 'unary op (parsed-node right)) (parsed-rest right)))
      (parse-call tokens)))

(define (parse-term-tail left tokens)
  (if (or (at? tokens 'plus) (at? tokens 'minus))
      (let ((op (token-type (car tokens)))
            (r (parse-factor (cdr tokens))))
        (parse-term-tail (list 'binary op left (parsed-node r))
                         (parsed-rest r)))
      (cons left tokens)))
(define (parse-term tokens)
  (let ((r (parse-factor tokens)))
    (parse-term-tail (parsed-node r) (parsed-rest r))))

(define (comparison-op? tokens)
  (or (at? tokens 'less)
      (or (at? tokens 'less-equal)
          (or (at? tokens 'greater) (at? tokens 'greater-equal)))))
(define (parse-comparison-tail left tokens)
  (if (comparison-op? tokens)
      (let ((op (token-type (car tokens)))
            (right (parse-term (cdr tokens))))
        (parse-comparison-tail
          (list 'binary op left (parsed-node right)) (parsed-rest right)))
      (cons left tokens)))
(define (parse-comparison tokens)
  (let ((left (parse-term tokens)))
    (parse-comparison-tail (parsed-node left) (parsed-rest left))))

(define (parse-equality-tail left tokens)
  (if (or (at? tokens 'equal-equal) (at? tokens 'bang-equal))
      (let ((op (token-type (car tokens)))
            (right (parse-comparison (cdr tokens))))
        (parse-equality-tail (list 'binary op left (parsed-node right))
                             (parsed-rest right)))
      (cons left tokens)))
(define (parse-equality tokens)
  (let ((left (parse-comparison tokens)))
    (parse-equality-tail (parsed-node left) (parsed-rest left))))

(define (parse-and-tail left tokens)
  (if (at? tokens 'and)
      (let ((right (parse-equality (cdr tokens))))
        (parse-and-tail (list 'logical 'and left (parsed-node right))
                        (parsed-rest right)))
      (cons left tokens)))
(define (parse-and tokens)
  (let ((left (parse-equality tokens)))
    (parse-and-tail (parsed-node left) (parsed-rest left))))

(define (parse-or-tail left tokens)
  (if (at? tokens 'or)
      (let ((right (parse-and (cdr tokens))))
        (parse-or-tail (list 'logical 'or left (parsed-node right))
                       (parsed-rest right)))
      (cons left tokens)))
(define (parse-or tokens)
  (let ((left (parse-and tokens)))
    (parse-or-tail (parsed-node left) (parsed-rest left))))

(define (parse-assignment tokens)
  (let ((left (parse-or tokens)))
    (if (at? (parsed-rest left) 'equal)
        (let ((right (parse-assignment (cdr (parsed-rest left)))))
          (cons (if (eq? (car (parsed-node left)) 'get)
                    (list 'set (cadr (parsed-node left))
                          (caddr (parsed-node left)) (parsed-node right))
                    (if (eq? (car (parsed-node left)) 'variable)
                        (list 'assign (cadr (parsed-node left)) (parsed-node right))
                        (begin
                          (diagnose! 'parse "Invalid assignment target.")
                          (parsed-node left))))
                (parsed-rest right)))
        left)))
(define (parse-expression tokens) (parse-assignment tokens))

(define (parse-block-items tokens reversed)
  (if (at? tokens 'eof)
      (begin
        (diagnose! 'parse "Expect '}' after block.")
        (cons (reverse reversed) tokens))
  (if (at? tokens 'right-brace)
      (cons (reverse reversed) (cdr tokens))
    (let ((r (parse-declaration tokens)))
      (parse-block-items (parsed-rest r) (cons (parsed-node r) reversed))))))

(define (parse-parameters tokens reversed)
  (if (at? tokens 'right-paren)
      (cons (reverse reversed) (cdr tokens))
      (if (not (at? tokens 'identifier))
          (begin
            (diagnose! 'parse "Expect parameter name.")
            (cons (reverse reversed) tokens))
          (let ((name (token-value (car tokens))) (rest (cdr tokens)))
            (if (>= (length reversed) 255)
                (diagnose! 'parse "Can't have more than 255 parameters.") #f)
            (if (at? rest 'comma)
                (parse-parameters (cdr rest) (cons name reversed))
                (if (at? rest 'right-paren)
                    (cons (reverse (cons name reversed)) (cdr rest))
                    (begin
                      (diagnose! 'parse "Expect ')' after parameters.")
                      (cons (reverse (cons name reversed)) rest))))))))

(define (parse-function tokens)
  (let ((name (token-value (cadr tokens)))
        (after-name (cdr (cdr tokens))))
    (if (not (at? after-name 'left-paren))
        (begin
          (diagnose! 'parse "Expect '(' after function name.")
          (cons (list 'function name '() '()) after-name))
        (let ((params (parse-parameters (cdr after-name) '())))
          (if (or lox-diagnostic (not (at? (parsed-rest params) 'left-brace)))
              (begin
                (if lox-diagnostic #f
                    (diagnose! 'parse "Expect '{' before function body."))
                (cons (list 'function name (parsed-node params) '())
                      (parsed-rest params)))
              (let ((body (parse-block-items (cdr (parsed-rest params)) '())))
                (cons (list 'function name (parsed-node params) (parsed-node body))
                      (parsed-rest body))))))))

(define (parse-method tokens)
  (let ((name (token-value (car tokens))) (after-name (cdr tokens)))
    (if (not (at? after-name 'left-paren))
        (begin
          (diagnose! 'parse "Expect '(' after method name.")
          (cons (list 'function name '() '()) after-name))
        (let ((params (parse-parameters (cdr after-name) '())))
          (if (or lox-diagnostic (not (at? (parsed-rest params) 'left-brace)))
              (begin
                (if lox-diagnostic #f
                    (diagnose! 'parse "Expect '{' before function body."))
                (cons (list 'function name (parsed-node params) '())
                      (parsed-rest params)))
              (let ((body (parse-block-items (cdr (parsed-rest params)) '())))
                (cons (list 'function name (parsed-node params) (parsed-node body))
                      (parsed-rest body))))))))
(define (parse-methods tokens reversed)
  (if (at? tokens 'right-brace)
      (cons (reverse reversed) (cdr tokens))
      (let ((method (parse-method tokens)))
        (parse-methods (parsed-rest method)
                       (cons (parsed-node method) reversed)))))
(define (parse-class tokens)
  (let ((name (token-value (cadr tokens))) (rest (cdr (cdr tokens))))
    (if (and (at? rest 'less) (not (at? (cdr rest) 'identifier)))
        (begin
          (diagnose! 'parse "Expect superclass name.")
          (cons (list 'class name #f '()) (cdr rest)))
        (let ((parent (if (at? rest 'less) (token-value (cadr rest)) #f))
              (body-start (if (at? rest 'less) (cdr (cdr rest)) rest)))
          (if (not (at? body-start 'left-brace))
              (begin
                (diagnose! 'parse "Expect '{' before class body.")
                (cons (list 'class name parent '()) body-start))
              (let ((methods (parse-methods (cdr body-start) '())))
                (cons (list 'class name parent (parsed-node methods))
                      (parsed-rest methods))))))))

(define (parse-if-statement tokens)
  (let ((condition (parse-expression (cdr (cdr tokens)))))
    (let ((then-branch (parse-statement (cdr (parsed-rest condition)))))
      (if (at? (parsed-rest then-branch) 'else)
          (let ((else-branch (parse-statement (cdr (parsed-rest then-branch)))))
            (cons (list 'if (parsed-node condition) (parsed-node then-branch)
                        (parsed-node else-branch))
                  (parsed-rest else-branch)))
          (cons (list 'if (parsed-node condition) (parsed-node then-branch) #f)
                (parsed-rest then-branch))))))
(define (parse-while-statement tokens)
  (let ((condition (parse-expression (cdr (cdr tokens)))))
    (let ((body (parse-statement (cdr (parsed-rest condition)))))
      (cons (list 'while (parsed-node condition) (parsed-node body))
            (parsed-rest body)))))

;; Recover a malformed `for` clause at its next separator. The enclosing parse
;; is already invalid, but continuing through the header exposes independent
;; syntax errors instead of hiding everything behind the first one.
(define (discard-through tokens type)
  (if (at? tokens 'eof) tokens
      (if (at? tokens type) (cdr tokens)
          (discard-through (cdr tokens) type))))

;; Parse Lox `for` and lower it to the smaller statement core:
;; initializer; while (condition) { body; increment; }
(define (parse-for-statement tokens)
  (let ((start (cdr (cdr tokens))))
    (let ((initializer
            (if (at? start 'semicolon) (cons #f (cdr start))
              (if (at? start 'var) (parse-declaration start)
                (let ((r (parse-expression start)))
                  (if (at? (parsed-rest r) 'semicolon)
                      (cons (list 'expression (parsed-node r))
                            (cdr (parsed-rest r)))
                      (begin
                        (diagnose-next! 'parse "Expect ';' after expression.")
                        (cons (list 'expression (parsed-node r))
                              (discard-through (parsed-rest r) 'semicolon)))))))))
      (let ((condition
              (if (at? (parsed-rest initializer) 'semicolon)
                  (cons (list 'literal #t) (cdr (parsed-rest initializer)))
                (let ((r (parse-expression (parsed-rest initializer))))
                  (if (at? (parsed-rest r) 'semicolon)
                      (cons (parsed-node r) (cdr (parsed-rest r)))
                      (begin
                        (diagnose-next! 'parse "Expect ';' after expression.")
                        (cons (parsed-node r)
                              (discard-through (parsed-rest r) 'semicolon))))))))
        (let ((increment
                (if (at? (parsed-rest condition) 'right-paren)
                    (cons #f (cdr (parsed-rest condition)))
                  (let ((r (parse-expression (parsed-rest condition))))
                    (cons (parsed-node r) (cdr (parsed-rest r)))))))
          (let ((body (parse-statement (parsed-rest increment))))
            (let ((loop-body
                    (if (parsed-node increment)
                        (list 'block
                              (list (parsed-node body)
                                    (list 'expression (parsed-node increment))))
                        (parsed-node body))))
              (let ((loop (list 'while (parsed-node condition) loop-body)))
                (if (parsed-node initializer)
                    (cons (list 'block (list (parsed-node initializer) loop))
                          (parsed-rest body))
                    (cons loop (parsed-rest body)))))))))))
(define (parse-statement tokens)
  (if (at? tokens 'print)
      (let ((r (parse-expression (cdr tokens))))
        (cons (list 'print (parsed-node r)) (statement-end (parsed-rest r))))
    (if (at? tokens 'if) (parse-if-statement tokens)
      (if (at? tokens 'for) (parse-for-statement tokens)
      (if (at? tokens 'while) (parse-while-statement tokens)
        (if (at? tokens 'return)
            (if (at? (cdr tokens) 'semicolon)
                (cons (list 'return (list 'literal 'nil) #f) (cdr (cdr tokens)))
                (let ((r (parse-expression (cdr tokens))))
                  (cons (list 'return (parsed-node r) #t)
                        (statement-end (parsed-rest r)))))
          (if (at? tokens 'left-brace)
              (let ((r (parse-block-items (cdr tokens) '())))
                (cons (list 'block (parsed-node r)) (parsed-rest r)))
            (let ((r (parse-expression tokens)))
              (cons (list 'expression (parsed-node r))
                    (statement-end (parsed-rest r)))))))))))

(define (parse-declaration tokens)
  (if (at? tokens 'class) (parse-class tokens)
  (if (at? tokens 'fun) (parse-function tokens)
  (if (at? tokens 'var)
      (if (not (at? (cdr tokens) 'identifier))
          (begin
            (diagnose! 'parse "Expect variable name.")
            (cons (list 'var 'invalid (list 'literal 'nil)) (cdr tokens)))
      (let ((name (token-value (cadr tokens)))
            (rest (cdr (cdr tokens))))
        (if (at? rest 'semicolon)
            (cons (list 'var name (list 'literal 'nil)) (cdr rest))
            (if (at? rest 'equal)
                (let ((r (parse-expression (cdr rest))))
                  (cons (list 'var name (parsed-node r))
                        (statement-end (parsed-rest r))))
                (begin
                  (diagnose! 'parse "Expect '=' or ';' after variable name.")
                  (cons (list 'var name (list 'literal 'nil)) rest))))))
      (parse-statement tokens)))))

(define (parse-program-items tokens reversed)
  (if (or lox-diagnostic (at? tokens 'eof)) (reverse reversed)
    (let ((r (parse-declaration tokens)))
      (parse-program-items (parsed-rest r) (cons (parsed-node r) reversed)))))
(define (parse tokens) (parse-program-items tokens '()))

;; ---- resolver --------------------------------------------------------------
;; The tree-walker deliberately keeps environments simple, but Lox still has a
;; static phase. A stack of mutable association lists tracks whether each local
;; has merely been declared or is ready to read. Function/class context supplies
;; the errors that dynamic lookup cannot detect without executing bad code.
(define resolver-scopes '())
(define resolver-function 'none)
(define resolver-class 'none)

(define (resolver-begin-scope!)
  (set! resolver-scopes (cons '() resolver-scopes)))
(define (resolver-end-scope!)
  (set! resolver-scopes (cdr resolver-scopes)))
(define (resolver-current-binding name)
  (if (null? resolver-scopes) #f (assq name (car resolver-scopes))))
(define (resolver-declare! name)
  (if (null? resolver-scopes) #f
      (if (resolver-current-binding name)
          (diagnose-next! 'resolve "Already a variable with this name in this scope.")
          (set-car! resolver-scopes
                    (cons (cons name 'declared) (car resolver-scopes))))))
(define (resolver-define! name)
  (if (null? resolver-scopes) #f
      (let ((binding (resolver-current-binding name)))
        (if binding (set-cdr! binding 'defined) #f))))
(define (resolver-bind-ready! name)
  (resolver-declare! name)
  (if lox-diagnostic #f (resolver-define! name)))

(define (resolve-expressions expressions)
  (if (null? expressions) #f
      (begin
        (resolve-expression (car expressions))
        (resolve-expressions (cdr expressions)))))

(define (resolve-expression expression)
  (let ((kind (car expression)))
        (if (eq? kind 'literal) #f
        (if (eq? kind 'grouping) (resolve-expression (cadr expression))
        (if (eq? kind 'this)
            (if (eq? resolver-class 'none)
                (diagnose-next! 'resolve "Can't use 'this' outside of a class.") #f)
        (if (eq? kind 'variable)
            (let ((binding (resolver-current-binding (cadr expression))))
              (if (and binding (eq? (cdr binding) 'declared))
                  (diagnose-next! 'resolve
                    "Can't read local variable in its own initializer.")
                  #f))
        (if (eq? kind 'assign) (resolve-expression (caddr expression))
        (if (eq? kind 'get) (resolve-expression (cadr expression))
        (if (eq? kind 'set)
            (begin (resolve-expression (cadr expression))
                   (resolve-expression (cadddr expression)))
        (if (eq? kind 'super)
            (if (eq? resolver-class 'none)
                (diagnose-next! 'resolve "Can't use 'super' outside of a class.")
                (if (not (eq? resolver-class 'subclass))
                    (diagnose-next! 'resolve
                      "Can't use 'super' in a class with no superclass.")
                    #f))
        (if (eq? kind 'unary) (resolve-expression (caddr expression))
        (if (eq? kind 'call)
            (begin (resolve-expression (cadr expression))
                   (resolve-expressions (caddr expression)))
        (if (eq? kind 'logical)
            (begin (resolve-expression (caddr expression))
                   (resolve-expression (cadddr expression)))
        (if (eq? kind 'binary)
            (begin (resolve-expression (caddr expression))
                   (resolve-expression (cadddr expression)))
            #f))))))))))))))

(define (resolve-parameters parameters)
  (if (null? parameters) #f
      (begin
        (resolver-bind-ready! (car parameters))
        (resolve-parameters (cdr parameters)))))
(define (resolve-function function function-kind)
  (let ((saved resolver-function))
    (set! resolver-function function-kind)
    (resolver-begin-scope!)
    (resolve-parameters (caddr function))
    (resolve-statements (cadddr function))
    (resolver-end-scope!)
    (set! resolver-function saved)))
(define (resolve-methods methods)
  (if (null? methods) #f
      (begin
        (resolve-function
          (car methods)
          (if (eq? (cadr (car methods)) 'init) 'initializer 'method))
        (resolve-methods (cdr methods)))))

(define (resolve-class-statement statement)
  (let ((saved resolver-class)
        (name (cadr statement))
        (parent (caddr statement))
        (super-scope? #f))
    (set! resolver-class (if parent 'subclass 'class))
    (resolver-declare! name)
    (if lox-diagnostic #f (resolver-define! name))
    (if (and parent (eq? parent name))
        (diagnose-next! 'resolve "A class can't inherit from itself.") #f)
    (if (and parent (not lox-diagnostic))
        (begin
          (resolve-expression (list 'variable parent))
          (resolver-begin-scope!)
          (set! super-scope? #t)
          (resolver-bind-ready! 'super)) #f)
    (if lox-diagnostic #f
        (begin
          (resolver-begin-scope!)
          (resolver-bind-ready! 'this)
          (resolve-methods (cadddr statement))
          (resolver-end-scope!)))
    (if super-scope?
        (resolver-end-scope!) #f)
    (set! resolver-class saved)))

(define (resolve-statement statement)
  (let ((kind (car statement)))
        (if (eq? kind 'print) (resolve-expression (cadr statement))
        (if (eq? kind 'expression) (resolve-expression (cadr statement))
        (if (eq? kind 'var)
            (begin
              (resolver-declare! (cadr statement))
              (if lox-diagnostic #f (resolve-expression (caddr statement)))
              (if lox-diagnostic #f (resolver-define! (cadr statement))))
        (if (eq? kind 'function)
            (begin
              (resolver-bind-ready! (cadr statement))
              (if lox-diagnostic #f (resolve-function statement 'function)))
        (if (eq? kind 'class) (resolve-class-statement statement)
        (if (eq? kind 'return)
            (if (eq? resolver-function 'none)
                (diagnose-next! 'resolve "Can't return from top-level code.")
                (if (eq? resolver-function 'initializer)
                    (if (caddr statement)
                        (diagnose-next! 'resolve
                          "Can't return a value from an initializer.")
                        #f)
                    (resolve-expression (cadr statement))))
        (if (eq? kind 'if)
            (begin
              (resolve-expression (cadr statement))
              (resolve-statement (caddr statement))
              (if (cadddr statement)
                  (resolve-statement (cadddr statement)) #f))
        (if (eq? kind 'while)
            (begin (resolve-expression (cadr statement))
                   (resolve-statement (caddr statement)))
        (if (eq? kind 'block)
            (begin
              (resolver-begin-scope!)
              (resolve-statements (cadr statement))
              (resolver-end-scope!))
            #f)))))))))))

(define (resolve-statements statements)
  (if (null? statements) #f
      (begin
        (resolve-statement (car statements))
        (resolve-statements (cdr statements)))))
(define (resolve program)
  (set! resolver-scopes '())
  (set! resolver-function 'none)
  (set! resolver-class 'none)
  (resolve-statements program))

;; ---- interpreter -----------------------------------------------------------
(define lox-environment-box (cons '() '()))
(define (lox-environment) (car lox-environment-box))
(define (set-lox-environment! value)
  (set-car! lox-environment-box value))
(define lox-globals '())
(define lox-scope-depth 0)
(define (env-define! name value)
  (let ((binding (cons name value)))
    (set-lox-environment! (cons binding (lox-environment)))
    (if (= lox-scope-depth 0)
        (set! lox-globals (cons binding lox-globals)) #f)
    value))
(define (env-get name)
  (let ((binding (assq name (lox-environment))))
    (if binding (cdr binding)
        (let ((global (assq name lox-globals)))
          (if global (cdr global)
              (diagnose! 'runtime "Undefined variable."))))))
(define (env-assign! name value)
  (let ((binding (assq name (lox-environment))))
    (if binding (begin (set-cdr! binding value) value)
        (let ((global (assq name lox-globals)))
          (if global (begin (set-cdr! global value) value)
              (diagnose! 'runtime "Undefined variable."))))))

(define (lox-eval-list expressions)
  (if (null? expressions) '()
      (cons (lox-eval (car expressions))
            (lox-eval-list (cdr expressions)))))
(define (bind-arguments params args)
  (if (null? params) '()
      (cons (cons (car params) (car args))
            (bind-arguments (cdr params) (cdr args)))))
(define (return-signal? value)
  (and (pair? value) (eq? (car value) 'return-signal)))
(define (lox-truthy? value)
  (if (eq? value #f) #f (if (eq? value 'nil) #f #t)))

;; Keep the Scheme representation behind the interpreter boundary. Lox has one
;; numeric type and spells its booleans and nil differently; jlox also removes
;; the redundant `.0` from an integral binary64 value when printing it.
(define (lox-stringify value)
  (if (eq? value 'nil) "nil"
  (if (eq? value #t) "true"
  (if (eq? value #f) "false"
  (if (number? value)
      (let ((text (number->string value)))
        (let ((n (string-length text)))
          (if (and (>= n 2)
                   (and (char=? (string-ref text (- n 2)) #\.)
                        (char=? (string-ref text (- n 1)) #\0)))
              (substring text 0 (- n 2))
              text)))
  (if (string? value) value
  (if (and (pair? value) (eq? (car value) 'lox-class))
      (symbol->string (cadddr value))
  (if (and (pair? value) (eq? (car value) 'lox-instance))
      (string-append (symbol->string (cadddr (cadr value))) " instance")
  (if (and (pair? value) (eq? (car value) 'lox-function))
      (string-append "<fn "
        (string-append (car (cdr (cddr (cddr value)))) ">"))
      "<value>")))))))))

(define (lox-equal? left right)
  (if (and (number? left) (number? right)) (= left right)
      (if (and (string? left) (string? right)) (string=? left right)
          (if (or (boolean? left) (or (eq? left 'nil) (eq? right 'nil)))
              (eq? left right)
              (eq? left right)))))

(define (class-find-method class name)
  (let ((found (assq name (caddr class))))
    (if found (cdr found)
        (if (cadr class)
            (class-find-method (cadr class) name)
            #f))))
(define (bind-method method instance)
  (list 'lox-function (cadr method) (caddr method)
        (cons (cons 'this instance) (cadddr method))
        (car (cddr (cddr method)))
        (car (cdr (cddr (cddr method))))))
(define (instance-get instance name)
  (if (or (not (pair? instance)) (not (eq? (car instance) 'lox-instance)))
      (diagnose! 'runtime "Only instances have properties.")
      (let ((field (assq name (caddr instance))))
        (if field (cdr field)
            (let ((method (class-find-method (cadr instance) name)))
              (if method (bind-method method instance)
                  (diagnose! 'runtime "Undefined property.")))))))
(define (instance-set! instance name value)
  (if (or (not (pair? instance)) (not (eq? (car instance) 'lox-instance)))
      (diagnose! 'runtime "Only instances have fields.")
      (let ((field (assq name (caddr instance))))
        (if field (set-cdr! field value)
            (set-car! (cddr instance)
                      (cons (cons name value) (caddr instance))))
        value)))

(define (lox-call-function function args)
  (let ((saved (lox-environment))
        (saved-depth lox-scope-depth)
        (params (cadr function))
        (body (caddr function))
        (closure (cadddr function))
        (initializer? (car (cddr (cddr function)))))
    ;; Replacing the global environment makes `saved` otherwise reachable only
    ;; from this local binding. Keep it in the active environment graph as an
    ;; internal binding whose name cannot be produced by the Lox scanner; the GC
    ;; can then preserve it across an arbitrarily allocating function body.
    (set-lox-environment!
          (append (bind-arguments params args)
                  (cons (cons 'coil:lox:saved-environment saved) closure)))
    (set! lox-scope-depth (+ saved-depth 1))
    (let ((result (lox-exec-list body)))
      (set-lox-environment! saved)
      (set! lox-scope-depth saved-depth)
      (if initializer? (cdr (assq 'this closure))
          (if (return-signal? result) (cadr result) 'nil)))))
(define (lox-call callable args)
  (if (not (pair? callable))
      (diagnose! 'runtime "Can only call functions and classes.")
  (if (eq? (car callable) 'lox-class)
      (let ((instance (list 'lox-instance callable '()))
            (initializer (class-find-method callable 'init)))
        (if (and (not initializer) (not (null? args)))
            (diagnose! 'runtime "Wrong number of arguments.")
        (if (and initializer (not (= (length (cadr initializer)) (length args))))
            (diagnose! 'runtime "Wrong number of arguments.")
            (begin
              (if initializer (lox-call-function (bind-method initializer instance) args) #f)
              instance))))
      (if (eq? (car callable) 'lox-function)
          (if (= (length (cadr callable)) (length args))
              (lox-call-function callable args)
              (diagnose! 'runtime "Wrong number of arguments."))
          (diagnose! 'runtime "Can only call functions and classes.")))))

(define (lox-eval-unary expression)
  (let ((op (cadr expression)) (right (lox-eval (caddr expression))))
    (if (eq? op 'minus)
        (if (number? right) (* -1.0 right)
            (diagnose! 'runtime "Operand must be a number."))
        (if (lox-truthy? right) #f #t))))

;; Stage binary evaluation through procedure parameters. Parameters are rooted
;; by the Scheme transform, whereas a surface `let` binding is not yet safely
;; rootable before dynamic-call lowering. This keeps the left operand alive while
;; evaluating an arbitrarily allocating right operand (recursive Fibonacci is
;; the compact regression for the first collection).
(define (lox-binary-values op left right)
  (if (eq? op 'plus)
      (if (and (string? left) (string? right))
          (string-append left right)
          (if (and (number? left) (number? right)) (+ left right)
              (diagnose! 'runtime "Operands must be two numbers or two strings.")))
  (if (eq? op 'minus)
      (if (and (number? left) (number? right)) (- left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'star)
      (if (and (number? left) (number? right)) (* left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'slash)
      (if (and (number? left) (number? right))
          (if (zero? right)
              (diagnose! 'runtime "Division by zero.")
              (exact->inexact (/ left right)))
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'less)
      (if (and (number? left) (number? right)) (< left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'less-equal)
      (if (and (number? left) (number? right)) (<= left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'greater)
      (if (and (number? left) (number? right)) (> left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'greater-equal)
      (if (and (number? left) (number? right)) (>= left right)
          (diagnose! 'runtime "Operands must be numbers."))
  (if (eq? op 'equal-equal) (lox-equal? left right)
  (if (eq? op 'bang-equal)
      (if (lox-equal? left right) #f #t)
      #f)))))))))))
(define (lox-eval-binary-right expression left)
  (lox-binary-values (cadr expression) left
                     (lox-eval (cadddr expression))))
(define (lox-eval-binary expression)
  (lox-eval-binary-right expression (lox-eval (caddr expression))))

(define (lox-eval expression)
  (let ((kind (car expression)))
    (if (eq? kind 'literal) (cadr expression)
    (if (eq? kind 'grouping) (lox-eval (cadr expression))
    (if (eq? kind 'this) (env-get 'this)
    (if (eq? kind 'variable) (env-get (cadr expression))
    (if (eq? kind 'assign)
        (env-assign! (cadr expression) (lox-eval (caddr expression)))
    (if (eq? kind 'get)
        (instance-get (lox-eval (cadr expression)) (caddr expression))
    (if (eq? kind 'set)
        (instance-set! (lox-eval (cadr expression)) (caddr expression)
                       (lox-eval (cadddr expression)))
    (if (eq? kind 'super)
        (let ((method (class-find-method (env-get 'super) (cadr expression))))
          (if method (bind-method method (env-get 'this))
              (diagnose! 'runtime "Undefined property.")))
    (if (eq? kind 'unary) (lox-eval-unary expression)
    (if (eq? kind 'call)
        (lox-call (lox-eval (cadr expression))
                  (lox-eval-list (caddr expression)))
    (if (eq? kind 'logical)
        (let ((op (cadr expression)) (left (lox-eval (caddr expression))))
          (if (eq? op 'or)
              (if (lox-truthy? left) left (lox-eval (cadddr expression)))
              (if (lox-truthy? left) (lox-eval (cadddr expression)) left)))
    (if (eq? kind 'binary) (lox-eval-binary expression)
        #f))))))))))))))

(define (method-values methods closure)
  (if (null? methods) '()
      (let ((method (car methods)))
        (cons
          (cons (cadr method)
                (list 'lox-function (caddr method) (cadddr method) closure
                      (eq? (cadr method) 'init)
                      (symbol->string (cadr method))))
          (method-values (cdr methods) closure)))))

(define (lox-exec-list statements)
  (if (or lox-diagnostic (null? statements)) #f
      (let ((result (lox-exec (car statements))))
        (if (return-signal? result) result
            (lox-exec-list (cdr statements))))))

(define (lox-exec-block statements)
  (let ((saved (lox-environment)) (saved-depth lox-scope-depth))
    (set! lox-scope-depth (+ saved-depth 1))
    (let ((result (lox-exec-list statements)))
      (set-lox-environment! saved)
      (set! lox-scope-depth saved-depth)
      result)))

;; A two-state self-tail-recursive loop. Surface `let` precedes dynamic-call
;; lowering, so the rooting pass cannot safely propagate its body as tail code.
;; Carrying the previous body result as explicit state keeps both recursive calls
;; syntactically direct and lets the backend guarantee `musttail`.
(define (lox-exec-while statement state)
  (if (eq? state 'loop-check)
      (if (lox-truthy? (lox-eval (cadr statement)))
          (lox-exec-while statement (lox-exec (caddr statement)))
          #f)
      (if (return-signal? state) state
          (lox-exec-while statement 'loop-check))))

(define (lox-exec statement)
  (let ((kind (car statement)))
    (if (eq? kind 'print)
        (let ((value (lox-eval (cadr statement))))
          (if lox-diagnostic #f
              (begin (display (lox-stringify value)) (newline) #f)))
    (if (eq? kind 'var)
        (env-define! (cadr statement) (lox-eval (caddr statement)))
    (if (eq? kind 'function)
        (begin
          (env-define! (cadr statement) 'nil)
          (env-assign! (cadr statement)
                       (list 'lox-function (caddr statement)
                             (cadddr statement) (lox-environment) #f
                             (symbol->string (cadr statement)))))
    (if (eq? kind 'class)
        (let ((name (cadr statement))
              (parent (if (caddr statement) (env-get (caddr statement)) #f)))
          (if (and parent
                   (or (not (pair? parent))
                       (not (eq? (car parent) 'lox-class))))
              (diagnose! 'runtime "Superclass must be a class.")
              (begin
                (env-define! name 'nil)
                (let ((base (lox-environment)))
                  (if parent
                      (set-lox-environment! (cons (cons 'super parent) base)) #f)
                  (let ((class (list 'lox-class parent
                                     (method-values (cadddr statement)
                                                    (lox-environment))
                                     name)))
                    (set-lox-environment! base)
                    (env-assign! name class))))))
    (if (eq? kind 'return)
        (list 'return-signal (lox-eval (cadr statement)))
    (if (eq? kind 'if)
        (if (lox-truthy? (lox-eval (cadr statement)))
            (lox-exec (caddr statement))
            (if (cadddr statement) (lox-exec (cadddr statement)) #f))
    (if (eq? kind 'expression) (lox-eval (cadr statement))
    (if (eq? kind 'block) (lox-exec-block (cadr statement))
    (if (eq? kind 'while)
        (lox-exec-while statement 'loop-check)
        #f)))))))))))

(define lox-numeric-source
  "// Lox uses binary64 for every number and has its own output spellings.\nprint 7 / 2; print 1.25 + 0.75; print 1 == 1.0; print false; print nil;")

(define lox-source
  "var a = 1; var total = 0; while (a < 6) { total = total + a; a = a + 1; } print total; print total == 15; var word = \"co\" + \"il\"; print word; print false or true; print true and 42; fun add(a, b) { return a + b; } print add(20, 22); fun makeAdder(base) { fun addBase(x) { return base + x; } return addBase; } var add10 = makeAdder(10); print add10(5); if (total >= 15) print \"branch\"; else print \"wrong\"; print 4 > 3; print 3 <= 3; print 2 != 3; fun sum6(a, b, c, d, e, f) { return a + b + c + d + e + f; } print sum6(1, 2, 3, 4, 5, 6); var shadow = \"outer\"; { var shadow = \"inner\"; print shadow; } print shadow; print !false; print !nil; print -5 + 8; var escaped = nil; { var secret = 30; fun addSecret(x) { return secret + x; } escaped = addSecret; } print escaped(12); fun returnBlock() { { var hidden = 99; return hidden; } } print returnBlock(); var loopTotal = 0; for (var i = 0; i < 4; i = i + 1) loopTotal = loopTotal + i; print loopTotal; class Counter { init(start) { this.value = start; } bump() { this.value = this.value + 1; return this.value; } } var counter = Counter(40); print counter.bump(); print counter.bump(); class LoudCounter < Counter { bump() { return super.bump() + 100; } } var loud = LoudCounter(5); print loud.bump(); loud.extra = \"field\"; print loud.extra; var lexical = \"global\"; { fun showLexical() { print lexical; } showLexical(); var lexical = \"block\"; showLexical(); }")

(define (lox-run source)
  (set! lox-diagnostic #f)
  (set! lox-diagnostics '())
  (set-lox-environment! '())
  (set! lox-globals '())
  (set! lox-scope-depth 0)
  (let ((tokens (scan source)))
    (if lox-diagnostic
        (begin (report-diagnostics lox-diagnostics) 65)
        (let ((program (parse tokens)))
          (if lox-diagnostic
              (begin (report-diagnostics lox-diagnostics) 65)
              (begin
                (resolve program)
                (if lox-diagnostic
                    (begin (report-diagnostics lox-diagnostics) 65)
                    (begin
                      (lox-exec-list program)
                      (if lox-diagnostic
                          (begin (report-diagnostics lox-diagnostics) 70)
                          0)))))))))

(define (read-lox-source port reversed)
  (let ((next (read-char port)))
    (if (eof-object? next)
        (list->string (reverse reversed))
        (read-lox-source port (cons next reversed)))))
(define (lox-run-file path)
  (call-with-input-file path
    (lambda (port) (lox-run (read-lox-source port '())))))

(define (lox-self-test)
  (lox-run lox-numeric-source)
  (lox-run lox-source)
  (lox-run "print @;")
  (lox-run "print \"unterminated;")
  (lox-run "print (1 + 2;")
  (lox-run "print 1")
  (lox-run "{ print 1;")
  (lox-run "print missing;")
  (lox-run "fun one(a) { return a; } print one();")
  (lox-run "print 1();")
  (lox-run "print \"x\" + 1;")
  (lox-run "print 1 / 0;")
  (lox-run "print -\"x\";")
  (lox-run "print 1.nope;")
  (lox-run "class Empty {} var e = Empty(); print e.nope;")
  (lox-run "{ var local = local; }")
  (lox-run "{ var duplicate = 1; var duplicate = 2; }")
  (lox-run "return 1;")
  (lox-run "print this;")
  (lox-run "super.nope;")
  (lox-run "class Base { method() {} } class Bad { method() { super.method(); } }")
  (lox-run "class Loop < Loop {}")
  (lox-run "class BadInit { init() { return 1; } }")
  (lox-run "var NotClass = \"value\"; class Child < NotClass {}")
  (lox-run "class Parent {} class Child < Parent { method() { super.missing(); } } Child().method();")
  'nil)
