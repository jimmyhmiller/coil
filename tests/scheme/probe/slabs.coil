(module slabs)
(import "coil.io" :use *)
(import "coil.primitive" :as primitive)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
; Allocate garbage in a tight loop and report slab/collection state.
(defn churn [(n i64)] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) n) (break)
      (do (cons (mk-fixnum (load i)) (s-nil))
          (set! i (+ (load i) 1))))))
  0)
; Build a DEEP tree that stays live across collections, then churn around it.
; The tracer must follow both slots of every node and survive recursion to the
; tree's depth — the case flat garbage never exercises.
(defn make-tree [(d i64)] (-> i64)
  (if (< d 1) (s-nil) (cons (make-tree (- d 1)) (make-tree (- d 1)))))
(defn check [(t i64)] (-> i64)
  (if (is-null t) 1 (+ 1 (+ (check (car t)) (check (cdr t))))))

(defn main [] (-> i64)
  (let [sp (gc-sp) t (make-tree 14)]
    (gc-root t)
    (churn 3000000)
    (print-str (stderr) "walk=") (print-int (stderr) (check t))
    (gc-sp-set! sp))
  (print-str (stderr) "total=") (print-int (stderr) (gc-total))
  (print-str (stderr) " collections=") (print-int (stderr) (gc-collections))
  (print-str (stderr) " live=") (print-int (stderr) (gc-live))
  (print-str (stderr) "\n")
  0)
