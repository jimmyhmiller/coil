(module gcstat)
;; A GC-instrumented run of the bintree benchmark.
;;
;; ⚠ NOT a dialect module — it does not import coil.scheme, so the whole-tree
;; lowering pass leaves its string literals alone. A dialect module cannot print
;; diagnostics with coil.io, because `"total="` would be lowered to a Val.
;; The Scheme program under test is built with the runtime API directly.
(import "coil.io" :use *)
(import "coil.scheme.value" :use *)
(import "coil.scheme.heap" :use *)
(import "coil.scheme.core" :use *)

(defn make-tree [(d i64)] (-> i64)
  (if (< d 1) (s-nil) (cons (make-tree (- d 1)) (make-tree (- d 1)))))
(defn check [(t i64)] (-> i64)
  (if (is-null t) 1 (+ 1 (+ (check (car t)) (check (cdr t))))))
(defn rounds [(k i64) (d i64) (total i64)] (-> i64)
  (if (< k 1) total (rounds (- k 1) d (+ total (check (make-tree d))))))

(defn main [] (-> i64)
  (print-int (stdout) (rounds 90 14 0)) (print-str (stdout) "\n")
  (print-str (stderr) "total=") (print-int (stderr) (gc-total))
  (print-str (stderr) " collections=") (print-int (stderr) (gc-collections))
  (print-str (stderr) " peak=") (print-int (stderr) (gc-peak))
  (print-str (stderr) "\n")
  0)
