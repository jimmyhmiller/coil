(module rtsound)
(import "coil.scheme" :use *)
;; The bintree shape that used to be swept mid-build, at a scale that forces
;; several collections but keeps recursion depth small (14).
(define (make-tree d)
  (if (< d 1) '() (cons (make-tree (- d 1)) (make-tree (- d 1)))))
(define (check t)
  (if (null? t) 1 (+ 1 (+ (check (car t)) (check (cdr t))))))
(define (rounds k d total)
  (if (< k 1) total (rounds (- k 1) d (+ total (check (make-tree d))))))
(defn main [] (-> i64)
  (display (rounds 40 14 0))
  (newline)
  (fixnum-value (mk-fixnum 0)))
