(module tcmutscm)
(import "coil.scheme" :use *)
;; R5RS requires a tail call to run in constant space regardless of WHICH
;; procedure it targets. This pair is the canonical case: neither procedure is
;; self-recursive, so self-call TCO alone cannot save it.
(define (my-even? n) (if (= n 0) 1 (my-odd? (- n 1))))
(define (my-odd? n)  (if (= n 0) 0 (my-even? (- n 1))))
(defn main [] (-> i64)
  (display (my-even? 50000000))
  (newline)
  (fixnum-value (mk-fixnum 0)))
