(module tailcc-cross-arity)

(defcc scheme-tail :params [] :ret rax :clobber [] :native tail)

(defn even-tail :cc scheme-tail [(n i64)] (-> i64)
  (if (= n 0) 1 (odd-tail (- n 1) 0)))

(defn odd-tail :cc scheme-tail [(n i64) (ignored i64)] (-> i64)
  (if (= n 0) 0 (even-tail (- n 1))))

(defn main [] (-> i64)
  (if (= (even-tail 100000000) 1) 0 1))
