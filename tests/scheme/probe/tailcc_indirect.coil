(module tailcc-indirect)
(import "coil.primitive" :as primitive)

(defcc scheme-tail :native tail)

(defn via-pointer :cc scheme-tail
  [(target (fnptr scheme-tail [i64] i64)) (n i64)] (-> i64)
  (if (= n 0) 0 (primitive/call-ptr target (- n 1))))

(defn return-direct :cc scheme-tail [(n i64)] (-> i64)
  (if (= n 0) 0 (via-pointer (primitive/fnptr-of return-direct) n)))

(defn main [] (-> i64)
  (return-direct 100000000))
