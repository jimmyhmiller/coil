(module scheme-parameterize-runtime)
(import "coil.scheme" :use *)

(defn main [] (-> i64)
  (let ((p (make-parameter 1)))
    (let ((before (p))
          (inside (parameterize ((p 9)) (p)))
          (after (p)))
      (fixnum-value
        (if (and (= before 1) (and (= inside 9) (= after 1))) 0 1)))))
