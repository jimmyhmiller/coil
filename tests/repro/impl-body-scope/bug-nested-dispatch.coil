(module p9)
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defstruct Val [(kinds i64)])

(derive Eq Val)

(defstruct Other [(z i64)])

(defn other-same [(a Other) (b Other)] (-> bool)
  (let [(mut x) (primitive/zeroed Val)
        (mut y) (primitive/zeroed Val)]
    (set! (.kinds x) (.z a))
    (set! (.kinds y)
          (.z b))
    (= (load x) (load y))))

(impl Eq Other (= [(a Other) (b Other)] (-> bool) (other-same a b)))

(defn main [] (-> i64)
  (fmt (stdout) "ok\n")
  0)
