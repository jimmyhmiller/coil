(module pb)
(import "coil.primitive" :as primitive)
(import "coil.io" :use *)
(import "coil.fmt" :use *)

(defstruct Other [(z i64)])

(defn helper [(a i64) (b i64)] (-> bool)
  (= a b))

(impl Eq Other (= [(a Other) (b Other)] (-> bool) (helper (.z a) (.z b))))

(defn main [] (-> i64)
  (fmt (stdout) "ok={}\n" (if (= (primitive/zeroed Other) (primitive/zeroed Other)) 1 0))
  0)
