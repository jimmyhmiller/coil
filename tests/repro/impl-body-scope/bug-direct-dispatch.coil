(module pa)
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)
(import "coil.io" :use *)
(import "coil.fmt" :use *)
(defstruct Val [(kinds i64)])
(derive Eq Val)
(defstruct Other [(v Val)])
(impl Eq Other (= [(a Other) (b Other)] (-> bool) (= (load (field a v)) (load (field b v)))))
(defn main [] (-> i64) (fmt (stdout) "ok\n") 0)
