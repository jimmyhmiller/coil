(module paredit-balance-repro)
(import "coil.primitive" :as primitive)

; The first form has one missing `)` on the `(loop ...)`. The intended repair is
; local: add one close after the loop body, before `(primitive/load found)`.
(defn locally-broken [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut found) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (when (= (load i) (primitive/cast i64 2))
                      (store! found 1)
                      (break))
                (set! i (primitive/iadd (load i) 1)))))
    (load found)))

; This following form is already balanced. Its indentation is normal Coil style:
; a multiline cond predicate followed by its result expression. `balance` must
; leave it byte-for-byte unchanged.
(defn already-valid [(decl i64) (actual i64)] (-> i64)
  (cond (and (and (= decl (primitive/cast i64 5)) (= actual (primitive/cast i64 4)))
             (not (and (= decl (primitive/cast i64 6))
                       (= actual (primitive/cast i64 7)))))
          (primitive/iadd decl actual)
        (and (and (= decl (primitive/cast i64 11)) (= actual (primitive/cast i64 11)))
             (and (= decl actual)
                  (= (primitive/iadd decl 1) (primitive/iadd actual 1))))
          (primitive/isub decl actual)
        :else 0))
