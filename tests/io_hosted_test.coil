(module io-hosted-test)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc)
(import "coil.io" :as io)
(import "coil.str" :as str)

(extern pipe :cc c [(ptr i32)] (-> i32))
(extern close :cc c [i32] (-> i32))

(defn main [] (-> i64)
  (let [a (alloc/malloc-allocator)
        fds (primitive/alloc-stack (array i32 2))
        writer (primitive/alloc-stack io/Writer)
        reader (primitive/alloc-stack io/Reader)
        byte (primitive/alloc-stack i8)]
    (if (!= (pipe (primitive/cast (ptr i32) fds)) (primitive/cast i32 0))
        1
        (do
          (io/fd-writer writer (primitive/cast i64 (load (primitive/index fds 1))))
          (io/fd-reader reader (primitive/cast i64 (load (primitive/index fds 0))))
          (let [result
                  (match (io/write-line writer "hello")
                    (Err [e] 2)
                    (Ok [n]
                        (if (!= n (primitive/cast i64 6))
                            3
                            (match (io/read-line-alloc a reader 32)
                              (Err [e] 4)
                              (Ok [line]
                                  (let [linep (primitive/alloc-stack io/OwnedBytes)
                                        text (io/owned-bytes-slice line)]
                                    (store! linep line)
                                    (if (str/str-eq text "hello")
                                        (do (io/owned-bytes-free a linep) 0)
                                        (do (io/owned-bytes-free a linep) 5))))))))]
            (close (load (primitive/index fds 0)))
            (close (load (primitive/index fds 1)))
            result)))))
