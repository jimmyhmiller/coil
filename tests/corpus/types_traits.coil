(module corpus.types-traits)
;; Types, structs and traits end to end: values and casts, type ascription and
;; inference across a let, structs and big aggregates by value, computed fields,
;; generics with bounds and compile-time value parameters, operator traits,
;; inherent and extension methods, qualified trait calls, specialization and
;; structural impls, blanket impls, supertraits, parameterized traits with
;; associated types, Callable values, anonymous functions and function pointers,
;; derive, and dyn trait objects.
;;
;; Each section prints what it computed and checks it; main returns the number
;; of failed checks.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :use [malloc-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.iter" :as lazy)
(import "coil.cc" :as cc)

;; ---------------------------------------------------------------- harness

(defn failures [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn check [(name (slice u8)) (got i64) (want i64)] (-> void)
  (if (= got want)
      (println "  {} = {}" name got)
      (do (store! (failures) (+ (load (failures)) 1))
          (println "  FAIL {} = {}, want {}" name got want))))

(defn check-true [(name (slice u8)) (ok bool)] (-> void)
  (check name (if ok 1 0) 1))

(defn section [(title (slice u8))] (-> void)
  (println "== {}" title))

;; ---------------------------------------------------------------- values

(defsum Res [T E] (Okk [(v T)]) (Errr [(e E)]))

(defn via-ascription [] (-> (Res i64 bool))
  (let [r (: (Okk 5) (Res i64 bool))] r))

;; The return type flows into a let binding that is the let's own value.
(defn via-return [] (-> (Res i64 bool))
  (let [r (Okk 6)] r))

(defn res-value [(r (Res i64 bool))] (-> i64)
  (match r (Okk [v] v) (Errr [_] -1)))

(defn values-section [] (-> void)
  (section "values, casts and ascription")
  (let [small (: 200 u8)
        big (cast i64 small)
        wide (: 18446744073709551615 u64)
        hex 0xFFFFFFFFFFFFFFFF
        ratio (/ (cast f64 big) 8.0)
        truncated (cast i64 -7.9)]
    (check "u8 widens" big 200)
    (check-true "u64 max is not an i64" (= wide (: 18446744073709551615 u64)))
    (check "a hex literal is a bit pattern" hex -1)
    (check "f64 division" (cast i64 (* ratio 10.0)) 250)
    (check "float to int truncates toward zero" truncated -7)
    (check "i32 arithmetic" (cast i64 (* (: 46340 i32) (: 46340 i32))) 2147395600)
    (check "u8 wraps through primitive" (cast i64 (primitive/iadd (: 250 u8) (: 10 u8))) 4)
    (check "char literal" #\A 65)
    (check "keyword equality" (if (= :fast :fast) 1 0) 1))
  (check "ascription supplies a stranded type argument" (res-value (via-ascription)) 5)
  (check "the return type flows into a let" (res-value (via-return)) 6)
  (check "ascription of a literal" (cast i64 (: 65535 u16)) 65535))

;; ---------------------------------------------------------------- structs

(defstruct Point [(x i64) (y i64)])
(defstruct Rect [(origin Point) (size Point)])

(defn area [(r Rect)] (-> i64)
  (* (.x (.size r)) (.y (.size r))))

(defn grow! [(r (mut Rect)) (by i64)] (-> void)
  (set! (.x (.size r)) (+ (.x (.size r)) by))
  (set! (.. r size y) (+ (.. r size y) by)))

;; A struct argument read through a pointer by a compound form, in a constructor
;; whose fields are out of order: the constructor checks its checked arguments
;; again, and a borrowed `(load (do p))` checks to the pointer `(do p)`.
(defn areas-through [(p (ptr Rect)) (flag bool)] (-> Point)
  (Point :y (area (load (if flag p p))) :x (area (do p))))

(defstruct Mixed [(a u8) (b i64) (c u16)])

;; 328 bytes and 88 bytes: copied by loop and unrolled.
(defstruct Big [(arr (array i64 40)) (tag i64)])
(defstruct Mid [(arr (array i32 20)) (tag i64)])

(defn fill-big [(k i64)] (-> Big)
  (let [(mut b) (zeroed Big)]
    (for i (range 0 40) (set! (mut (.arr b)) i (* i k)))
    (set! (.tag b) k)
    b))

(defn sum-big [(b Big)] (-> i64)
  (let [(mut total) (.tag b)]
    (for v (.arr b) (set! total (+ total v)))
    total))

(defn fill-mid [(k i64)] (-> Mid)
  (let [(mut m) (zeroed Mid)]
    (for i (range 0 20) (set! (mut (.arr m)) i (cast i32 (+ i k))))
    (set! (.tag m) (* k 1000))
    m))

(defn sum-mid [(m Mid)] (-> i64)
  (let [(mut total) (.tag m)]
    (for v (.arr m) (set! total (+ total (cast i64 v))))
    total))

(defsum Carrier
  (CEmpty [])
  (CMid [(m Mid)])
  (CPair [(a i64) (b i64)]))

(defn carrier-value [(c Carrier)] (-> i64)
  (match c
    (CEmpty [] -1)
    (CMid [m] (sum-mid m))
    (CPair [a b] (* a b))))

(defn structs-section [] (-> void)
  (section "structs and aggregates")
  (let [(mut r) (Rect :origin (Point :x 0 :y 0) :size (Point :y 3 :x 2))]
    (grow! (mut r) 1)
    (check "nested set! through a mut reference" (area r) 12)
    (let [through (areas-through (cast (ptr Rect) (mut r)) true)]
      (check "a struct read through a pointer, in a named constructor" (+ (.x through) (.y through)) 24))
    (let [(mut copy) r]
      (set! (.x (.origin copy)) 99)
      (check "a struct let is a copy" (.x (.origin r)) 0)
      (check "the copy changed" (.x (.origin copy)) 99)))
  (check "sizeof with padding" (cast i64 (sizeof Mixed)) 24)
  (check "alignof" (cast i64 (alignof Mixed)) 8)
  (check "offsetof" (cast i64 (offsetof Mixed c)) 16)
  (let [b (fill-big 3)
        b2 b]
    (check "a big struct by value, copied" (sum-big b2) 2343)
    (check "big struct tag" (.tag b2) 3))
  (check "a mid struct returned by value" (sum-mid (fill-mid 5)) 5290)
  (check "an aggregate payload through match" (carrier-value (CMid (fill-mid 2))) 2230)
  (check "a scalar payload" (carrier-value (CPair 6 7)) 42)
  (check "an empty variant" (carrier-value (CEmpty)) -1)
  (let [a (malloc-allocator)
        (mut mids) (ArrayList::new [Mid] a)]
    (for i (range 0 5) (push! (mut mids) (fill-mid i)))
    (check "an array of structs on the heap" (sum-mid (get mids 3)) 3250)
    (check "first element" (sum-mid (get mids 0)) 190)
    (free! (mut mids))))

;; ---------------------------------------------------------------- computed fields

(defstruct Celsius [(degrees f64)])

(impl FieldGet (Field Celsius :fahrenheit)
  (get-field [(self (Field Celsius :fahrenheit)) (c Celsius)] (-> f64)
    (+ 32.0 (* 1.8 (.degrees c)))))

(impl FieldSet (Field Celsius :fahrenheit)
  (set-field! [(self (Field Celsius :fahrenheit)) (c (mut Celsius)) (f f64)] (-> i64)
    (set! (.degrees c) (/ (- f 32.0) 1.8))
    0))

(defn computed-section [] (-> void)
  (section "computed fields")
  (let [(mut t) (Celsius :degrees 100.0)]
    (check "a computed read" (cast i64 (.fahrenheit t)) 212)
    (set! (.fahrenheit t) 32.0)
    (check "a computed write" (cast i64 (.degrees t)) 0)))

;; ---------------------------------------------------------------- generics

(defn largest [(T Ord)] [(a T) (b T)] (-> T)
  (if (> a b) a b))

(defn move-by [(x i64) (dx i64) (scale i64)] (-> i64)
  (+ x (* dx scale)))

(defstruct Quantity [(const Unit Keyword)] [(value f64)])

(defn add-quantities [(const U Keyword)] [(a (Quantity U)) (b (Quantity U))] (-> (Quantity U))
  (Quantity :value (+ (.value a) (.value b))))

(defn array-length [T (const N i64)] [(xs (array T N))] (-> i64) N)

(const LANES 4)
(const UNIT :meters)
(const NARROW (: 3 u8))

(defstruct Lanes [(const N i64)] [(xs (array i64 N))])

(defn width [(const N i64)] [] (-> i64) N)
(defn unit-value [(const U Keyword)] [(q (Quantity U))] (-> f64) (.value q))

(defn same? [(T Eq)] [(a (ref T)) (b (ref T))] (-> bool) (= a b))
(defn pointee-size [T] [(p (ptr T))] (-> i64) (cast i64 (sizeof T)))

(defstruct Pair [A B] [(first A) (second B)])

(defn swap-pair [A B] [(p (Pair A B))] (-> (Pair B A))
  (Pair :first (.second p) :second (.first p)))

(defn generics-section [] (-> void)
  (section "generics")
  (check "inferred type argument" (largest 3 9) 9)
  (check "explicit type argument" (largest [i64] 12 4) 12)
  (check "a float instance" (cast i64 (* 10.0 (largest 2.5 1.0))) 25)
  (check "positional call" (move-by 1 2 3) 7)
  (check "named arguments in any order" (move-by :scale 3 :x 1 :dx 2) 7)
  (let [a (: (Quantity :value 1.5) (Quantity :meters))
        b (: (Quantity :value 2.0) (Quantity :meters))]
    (check "a const Keyword parameter" (cast i64 (* 10.0 (.value (add-quantities a b)))) 35))
  (check "a const length inferred from an array" (array-length [1 2 3]) 3)
  (let [l (Lanes [(const LANES)] :xs [1 2 3 4])]
    (check "a named constant as a generic argument" (width [(const LANES)]) 4)
    (check "a narrow constant" (width [(const NARROW)]) 3)
    (check "a const-sized field" (get (.xs l) 3) 4)
    (check "a keyword constant"
           (cast i64 (unit-value (Quantity [(const UNIT)] :value 2.5))) 2))
  (let [x (: 7 u64)
        y (: 2.5 f32)
        (mut n) 5
        (mut b) (: 1 u8)]
    (check-true "a literal lent to (ref T) takes its peer's type" (same? x 7))
    (check-true "and in either position" (not (same? 0 x)))
    (check-true "a float peer" (same? y 2.5))
    (check "a (mut x) borrow binds T to the place's type" (pointee-size (mut n)) 8)
    (check "a u8 place" (pointee-size (mut b)) 1))
  (let [p (swap-pair (Pair :first 1 :second true))]
    (check-true "a generic struct swapped" (and (.first p) (= (.second p) 1)))))

;; ---------------------------------------------------------------- traits and operators

(defstruct Vec2 [(x i64) (y i64)])

(impl Add Vec2
  (+ [(a Vec2) (b Vec2)] (-> Vec2)
    (Vec2 :x (+ (.x a) (.x b)) :y (+ (.y a) (.y b)))))

(impl Mul Vec2
  (* [(a Vec2) (b Vec2)] (-> Vec2)
    (Vec2 :x (* (.x a) (.x b)) :y (* (.y a) (.y b)))))

(impl Neg Vec2
  (neg [(a Vec2)] (-> Vec2) (Vec2 :x (- (.x a)) :y (- (.y a)))))

(impl Eq Vec2
  (= [(a Vec2) (b Vec2)] (-> bool) (and (= (.x a) (.x b)) (= (.y a) (.y b)))))

(impl Ord Vec2
  (< [(a Vec2) (b Vec2)] (-> bool) (< (+ (.x a) (.y a)) (+ (.x b) (.y b))))
  (<= [(a Vec2) (b Vec2)] (-> bool) (<= (+ (.x a) (.y a)) (+ (.x b) (.y b))))
  (> [(a Vec2) (b Vec2)] (-> bool) (> (+ (.x a) (.y a)) (+ (.x b) (.y b))))
  (>= [(a Vec2) (b Vec2)] (-> bool) (>= (+ (.x a) (.y a)) (+ (.x b) (.y b)))))

(impl Display Vec2
  (display-fmt [(v Vec2) (f (ptr Formatter))] (-> i64)
    (fmt (writer f) "<{}, {}>" (.x v) (.y v))
    0))

(deftrait Area [Self]
  (area-of [(self Self)] (-> i64)))

(impl Area Vec2
  (area-of [(v Vec2)] (-> i64) (* (.x v) (.y v))))

(defn total-area [(T Area)] [(a T) (b T)] (-> i64)
  (+ (area-of a) (area-of b)))

;; A trait method over Self takes value ABI in the generic body and a reference in
;; the impl: an aggregate argument must reach it as an address on every path.
(defstruct Triple [(a i64) (b i64) (c i64)])

(deftrait Total [Self]
  (total [(value Self)] (-> i64)))

(impl Total Vec2 (total [(v Vec2)] (-> i64) (+ (.x v) (.y v))))
(impl Total Triple (total [(t Triple)] (-> i64) (+ (.a t) (.b t) (.c t))))
(impl Total i64 (total [(v i64)] (-> i64) v))

(defn doubled-total [(T Total)] [(value T)] (-> i64) (* (total value) 2))
(defn total-gap [(T Total) (U Total)] [(lo T) (hi U)] (-> i64) (- (total hi) (total lo)))
(defn ident [(T Total)] [(value T)] (-> T) value)

;; A method parameter typed by one of the trait's own extra parameters.
(defstruct Light [(level i64)])
(defstruct Ev [(y i64) (z i64)])

(deftrait Machine [Self Event]
  (step [(state Self) (event Event)] (-> Light))
  (score [(state Self) (event Event)] (-> i64)))

(impl Machine Light
  (step [(s Light) (e Ev)] (-> Light) (Light :level (+ (.level s) (* (.y e) (.z e)))))
  (score [(s Light) (e Ev)] (-> i64) (+ (.level s) (.z e))))

(defn drive [E (S (Machine E))] [(s S) (e E)] (-> Light) (step s e))
(defn rate [E (S (Machine E))] [(s S) (e E)] (-> i64) (score s e))

(defn traits-section [] (-> void)
  (section "traits and operators")
  (let [a (Vec2 :x 1 :y 2)
        b (Vec2 :x 3 :y 4)
        sum (+ a b)]
    (println "  {} + {} = {}" a b sum)
    (check "Add" (.y sum) 6)
    (check "variadic Add folds left" (.x (+ a b a)) 5)
    (check "Mul" (.y (* a b)) 8)
    (check "Neg" (.x (- a)) -1)
    (check-true "Eq" (= (+ a b) (Vec2 :x 4 :y 6)))
    (check-true "!= through Eq" (!= a b))
    (check-true "Ord" (< a b))
    (check "a generic Ord instance" (.x (largest a b)) 3)
    (check "a user trait through a bound" (total-area a b) 14))
  (check "aggregate through a bounded generic" (doubled-total (Vec2 :x 10 :y 20)) 60)
  (check "a bigger aggregate" (doubled-total (Triple :a 1 :b 2 :c 3)) 12)
  (check "a scalar instance" (doubled-total 21) 42)
  (check "two bound parameters" (total-gap (Vec2 :x 1 :y 1) (Triple :a 4 :b 5 :c 6)) 13)
  (check "scalar and aggregate" (total-gap 2 (Vec2 :x 3 :y 4)) 5)
  (check "a generic returns an aggregate" (total (ident (Vec2 :x 8 :y 9))) 17)
  (check "an extra trait parameter" (.level (drive (Light :level 1) (Ev :y 2 :z 3))) 7)
  (check "and its second method" (rate (Light :level 10) (Ev :y 0 :z 5)) 15))

;; ---------------------------------------------------------------- methods

(defstruct Counter [(count i64) (step i64)])

(impl Counter
  (new [(step i64)] (-> Counter) (Counter :count 0 :step step))
  (tick! [(c (mut Counter))] (-> i64)
    (set! (.count c) (+ (.count c) (.step c)))
    (.count c))
  (value [(c Counter)] (-> i64) (.count c)))

(defsum Choice (Number [(n i64)]) (Nothing))

(impl Choice
  (choice-score [(c Choice)] (-> i64)
    (match c (Number [n] n) (Nothing [] 0))))

(deftrait Scored [Self] (choice-score [(x Self)] (-> i64)))
(impl Scored Choice (choice-score [(c Choice)] (-> i64) 99))

(defstruct Box [T] [(value T)])

(impl [T] (Box T)
  (boxed [(value T)] (-> (Box T)) (Box :value value))
  (unbox [(b (Box T))] (-> T) (.value b)))

;; The more specific inherent impl wins, as with traits.
(impl (Box i64) (unbox [(b (Box i64))] (-> i64) (+ 100 (.value b))))

(impl i64
  (twice [(x i64)] (-> i64) (* x 2))
  (one [] (-> i64) 1))

(impl [T] (slice T) (extent [(s (slice T))] (-> i64) (len s)))

;; An impl on a type another module declares calls this module's functions. (A
;; macro's staging closure used to take in every impl that shared the type's
;; dispatch key, coil.slice's or coil.arraylist's own among them, without what
;; their bodies call.)
(defn weight-of [(n i64)] (-> i64) (* n 3))
(impl (slice u8) (weight [(s (slice u8))] (-> i64) (weight-of (len s))))
(impl [T] (ArrayList T) (list-weight [(xs (ArrayList T))] (-> i64) (weight-of (len xs))))
(impl [T] (array T 2) (array-mark [(xs (array T 2))] (-> i64) 4))

(deftrait A [Self] (go [(x Self)] (-> i64)))
(deftrait B [Self] (go [(x Self)] (-> i64)))
(impl A i64 (go [(x i64)] (-> i64) 111))
(impl B i64 (go [(x i64)] (-> i64) 222))

(defn methods-section [] (-> void)
  (section "inherent methods and qualified calls")
  (let [(mut c) (Counter::new 5)]
    (tick! (mut c))
    (tick! (mut c))
    (check "an associated function and a mut receiver" (value c) 10)
    (check "a qualified receiver call" (Counter::value c) 10))
  (check "a method on a sum" (choice-score (Number 5)) 5)
  (check "the trait method stays reachable" (Scored::choice-score (Number 5)) 99)
  (check "a generic inherent impl" (if (unbox (Box::boxed true)) 1 0) 1)
  (check "specialized for (Box i64)" (unbox (Box::boxed 7)) 107)
  (check "an extension on i64" (twice 4) 8)
  (check "an associated function on i64" (i64::one) 1)
  (check "an extension on slices" (extent "hello") 5)
  (check "an extension calling its module's function" (weight "abcd") 12)
  (let [(mut xs) (ArrayList::new [i64] (malloc-allocator))]
    (push! (mut xs) 1)
    (check "an extension on another module's type" (list-weight xs) 3)
    (free! (mut xs)))
  (check "an extension on arrays" (array-mark [1 2]) 4)
  (check "A::go picks trait A" (A::go 5) 111)
  (check "B::go picks trait B" (B::go 5) 222))

;; ---------------------------------------------------------------- methods named like a free function

;; A free function keeps every call it accepts. A call it rejects goes to the
;; method of that name on the first argument's type: an inherent method, or a
;; trait method that type implements.
(defstruct Tally [(n i64)])

(impl Tally
  (tally! [(t (mut Tally)) (by i64)] (-> i64) (set! (.n t) (+ (.n t) by)) (.n t))
  (badge [(t Tally)] (-> i64) 1)
  (count [(t Tally)] (-> i64) (.n t)))

(defn tally! [(x i64)] (-> i64) (+ x 1000))
(defn badge [(t Tally)] (-> i64) 2)

(deftrait Weighed [Self] (weight [(x Self)] (-> i64)))
(impl Weighed Tally (weight [(t Tally)] (-> i64) (* 10 (.n t))))
(defn weight [(x i64) (y i64)] (-> i64) (+ x y))

(defstruct Bin [K V] [(k K) (v V)])
(impl [K V] (Bin K V) (count [(b (Bin K V))] (-> i64) 2))

(defn bin-count [K V] [(b (Bin K V))] (-> i64) (count b))

(defn tally-twice! [(t Code)] (-> Code) `(tally! (mut ~t) 2))

(defn fallback-section [] (-> void)
  (section "methods named like a free function")
  (let [(mut t) (Tally :n 0)]
    (check "the function rejects a (mut Tally): the method" (tally! (mut t) 5) 5)
    (check "the function accepts an i64: the function" (tally! 1) 1001)
    (check "both accept: the function" (badge t) 2)
    (check "coil.iter.count rejects a Tally: the method" (count t) 5)
    (check "a macro template's call" (tally-twice! t) 7)
    (check "a trait method" (weight t) 70)
    (check "the two-argument function" (weight 1 2) 3))
  (check "a generic receiver" (count (Bin :k 1 :v true)) 2)
  (check "a generic receiver in a generic body" (bin-count (Bin :k "k" :v 3)) 2)
  (check "coil.iter.count still counts" (count (lazy/range 0 4)) 4))

;; ---------------------------------------------------------------- specialization and structural impls

(defstruct Duo [A B] [(x A) (y B)])

(impl [A B] Len (Duo A B) (len [(p (Duo A B))] (-> i64) 6))
(impl Len (Duo i64 i64) (len [(p (Duo i64 i64))] (-> i64) 7))

(defn tell [(T Len)] [(x T)] (-> i64) (len x))

(defstruct Cell [T] [(v T)])

(impl [(T Eq)] Eq (Cell T)
  (= [(a (Cell T)) (b (Cell T))] (-> bool) (= (.v a) (.v b))))

(deftrait Tag [Self] (tag [(x Self)] (-> i64)))
(impl [T] Tag (slice T) (tag [(x (slice T))] (-> i64) 100))
(impl [T] Tag (ptr T) (tag [(x (ptr T))] (-> i64) 200))
(impl [T] Tag (array T 4) (tag [(x (array T 4))] (-> i64) 300))
(impl Tag (fnptr (cc/C) [i64] i64) (tag [(x (fnptr (cc/C) [i64] i64))] (-> i64) 500))

(defn a-fn [(n i64)] (-> i64) n)

(defn specialization-section [] (-> void)
  (section "specialization and structural impls")
  (let [specific (: (Duo :x 1 :y 2) (Duo i64 i64))
        general (: (Duo :x 1 :y true) (Duo u8 bool))]
    (check "the concrete impl wins" (len specific) 7)
    (check "the general impl covers the rest" (len general) 6)
    (check "the same choice through a bound" (tell specific) 7)
    (check "and the general one" (tell general) 6))
  (check-true "a bounded impl" (= (Cell :v 5) (Cell :v 5)))
  (check-true "a bounded impl, unequal" (!= (Cell :v 5) (Cell :v 6)))
  (let [(mut p) 42
        (mut q) 42
        pp (cast (ptr i64) (mut p))
        qp (cast (ptr i64) (mut q))
        (mut cur) pp
        arr [1 2 3 4]]
    (check-true "pointers order by address" (!= (< pp qp) (> pp qp)))
    ; a `(mut cur)` local compares the pointer it holds, not its own address
    (check-true "a mutable pointer local compares its pointer" (and (= cur pp) (!= cur qp)))
    (set! cur qp)
    (check-true "and sees what it was set to" (and (= cur qp) (= qp cur) (!= cur pp)))
    (check-true "a pointer is not below itself" (not (< pp pp)))
    (check-true "pointer equality is identity" (and (= pp pp) (!= pp qp)))
    (check "an impl on slices" (tag "abc") 100)
    (check "a pointer's own impl wins over autoderef" (tag pp) 200)
    (check "an impl on arrays" (tag arr) 300)
    (check "an impl on function pointers" (tag (fnptr-of a-fn)) 500))
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [i64] a)]
    (push! (mut xs) 5)
    (push! (mut xs) 6)
    (let [xp (cast (ptr (ArrayList i64)) (mut xs))]
      (check "autoderef finds the pointee's impl" (len xp) 2))
    (free! (mut xs))))

;; ---------------------------------------------------------------- blanket impls

(deftrait Key [Self] (key-code [(k Self)] (-> i64)))

(impl [(T Hash Eq)] Key T
  (key-code [(k T)] (-> i64) (% (hash k) 1000)))

(defstruct Badge [(id i64)])
(impl Key Badge (key-code [(b Badge)] (-> i64) (.id b)))
(impl [X] Key (Cell X) (key-code [(b (Cell X))] (-> i64) -1))

(deftrait Shape [Self] (shape-area [(s Self)] (-> i64)))
(defstruct Square [(side i64)])
(impl Shape Square (shape-area [(s Square)] (-> i64) (* (.side s) (.side s))))

(impl [(T Shape)] Display T
  (display-fmt [(s T) (f (ptr Formatter))] (-> i64)
    (fmt (writer f) "area {}" (shape-area s))
    0))

(defn code-of [(K Key)] [(k K)] (-> i64) (key-code k))
(defn code-via-hash [(K Hash Eq)] [(k K)] (-> i64) (key-code k))

(defn blanket-section [] (-> void)
  (section "blanket impls")
  (check-true "a blanket impl over Hash and Eq" (= (key-code 5) (% (hash 5) 1000)))
  (check "a specific impl wins" (key-code (Badge :id 7)) 7)
  (check "a constructor impl wins" (key-code (Cell :v true)) -1)
  (check "through a Key bound" (code-of (Badge :id 8)) 8)
  (check-true "through the blanket impl's own bounds" (= (code-via-hash 11) (% (hash 11) 1000)))
  (println "  blanket Display: {} beside {}" (Square :side 3) 12))

;; ---------------------------------------------------------------- supertraits and parameterized traits

(deftrait Animal [Self] (legs [(x Self)] (-> i64)))
(deftrait Pet [Self] :requires [Animal] (pet-name [(x Self)] (-> i64)))
(defstruct Dog [(n i64)])
(impl Animal Dog (legs [(x Dog)] (-> i64) 4))
(impl Pet Dog (pet-name [(x Dog)] (-> i64) 7))

; A `Pet` bound alone reaches `Animal`'s methods: every Pet is an Animal.
(defn pet-score [(P Pet)] [(p P)] (-> i64) (+ (pet-name p) (* 10 (legs p))))

(defn animal-legs [(A Animal)] [(x A)] (-> i64) (Animal::legs x))

(defn pet-legs [(P Pet)] [(p P)] (-> i64) (animal-legs p))

(deftrait Container [Self Elem]
  (head [(c Self)] (-> (Option Elem)))
  (size [(c Self)] (-> i64)))

(defstruct IntBox [(v i64)])
(impl Container IntBox
  (head [(c IntBox)] (-> (Option i64)) (Some (.v c)))
  (size [(c IntBox)] (-> i64) 1))

(defstruct NoBox [(x i64)])
(impl Container NoBox
  (head [(c NoBox)] (-> (Option i64)) (None))
  (size [(c NoBox)] (-> i64) 0))

(defn describe [(C Container)] [(c C)] (-> i64)
  (match (head c) (Some [_] (+ 100 (size c))) (None [] (size c))))

(defn drain-count [(C Pop)] [(xs (mut C))] (-> i64)
  (let [(mut n) 0]
    (while-let [(Some [_]) (pop! (mut xs))] (set! n (+ n 1)))
    n))

(defn first-i64 [(I (Iterator i64))] [(source I)] (-> i64)
  (let [(mut it) source]
    (match (next (mut it)) (Some [v] v) (None [] 0))))

;; An impl parameter fixed only by the associated type a bounded caller states.
(deftrait Migration [Self Old]
  (migrate-value [(next (mut Self)) (old (ref Old))] (-> i64)))

(defstruct OldRecord [(v i64)])
(defstruct NewRecord [(v i64)])

(impl [From New] Migration (ArrayList New)
  (migrate-value [(next (mut (ArrayList New))) (old (ref (ArrayList From)))] (-> i64)
    (+ (* 10 (len next)) (len old))))

(defn migrate! [Old (New (Migration Old))] [(next (mut New)) (old (ref Old))] (-> i64)
  (migrate-value (mut next) old))

(defn parameterized-section [] (-> void)
  (section "supertraits and parameterized traits")
  (check "a supertrait method through the subtrait's bound" (pet-score (Dog :n 1)) 47)
  (check "Animal::legs" (Animal::legs (Dog :n 1)) 4)
  (check "a Pet passed where an Animal is required" (pet-legs (Dog :n 1)) 4)
  (check "an associated element type, Some" (describe (IntBox :v 7)) 101)
  (check "an associated element type, None" (describe (NoBox :x 0)) 0)
  (check "an explicit (Iterator i64) bound" (first-i64 (lazy/range 42 43)) 42)
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [i64] a)
        (mut old) (ArrayList::new [OldRecord] a)
        (mut new) (ArrayList::new [NewRecord] a)]
    (push! (mut xs) 10)
    (push! (mut xs) 20)
    (push! (mut xs) 30)
    (check "Pop as a bound drains a list" (drain-count (mut xs)) 3)
    (check "and leaves it empty" (len xs) 0)
    (push! (mut old) (OldRecord :v 1))
    (push! (mut old) (OldRecord :v 2))
    (push! (mut new) (NewRecord :v 3))
    (check "an impl parameter from the argument" (migrate-value (mut new) old) 12)
    (check "an impl parameter from the caller's bound"
           (migrate! [(ArrayList OldRecord) (ArrayList NewRecord)] (mut new) old) 12)
    (free! (mut xs))
    (free! (mut old))
    (free! (mut new))))

;; ---------------------------------------------------------------- callable values and functions

(defstruct Scale [(factor i64)])
(impl Callable Scale
  (call [(self Scale) (x i64)] (-> i64) (* (.factor self) x)))

(defstruct Vec3 [(x i64) (y i64) (z i64)])
(impl Callable Vec3
  (call [(self Vec3) (i i64)] (-> i64)
    (case i 0 (.x self) 1 (.y self) (.z self))))

(defstruct Thunk [T] [(value T)])
(impl [T] Callable (Thunk T)
  (call [(self (Thunk T))] (-> T) (.value self)))

(defn apply-twice [(f (fnptr (cc/C) [i64] i64)) (x i64)] (-> i64) (f (f x)))

(defn square [(x i64)] (-> i64) (* x x))

(defn apply-callable [(F (Callable i64 i64))] [(f F) (x i64)] (-> i64) (Callable::call f x))

;; A value bounded by Callable is called like a function.
(defn apply-direct [(F (Callable i64 i64))] [(f F) (x i64)] (-> i64) (f x))

(defn callable-section [] (-> void)
  (section "callable values and function pointers")
  (let [triple (Scale :factor 3)
        v (Vec3 :x 10 :y 20 :z 30)
        t (Thunk :value 12)]
    (check "a Callable struct" (triple 14) 42)
    (check "a Callable with an index" (- (v 2) (t)) 18)
    (check "a Callable through a bound" (apply-callable triple 5) 15)
    (check "a bounded Callable called directly" (+ (apply-direct triple 5) (apply-direct (fnptr-of square) 3)) 24))
  (check "an anonymous fn as a fnptr" (apply-twice (fn [n] (* n n)) 3) 81)
  (check "fnptr-of a named function" (apply-twice (fnptr-of square) 2) 16)
  (let [pick (fnptr-of largest [i64])]
    (check "fnptr-of a generic instance" (pick 4 9) 9))
  (check "fold and map with anonymous fns"
         (fold (fn [total value] (+ total value)) 0 (map (fn [x] (+ x 2)) (range 0 10)))
         65))

;; ---------------------------------------------------------------- derive

(defstruct Spot [(x i64) (y i64)])
(derive Debug Eq Hash Clone Spot)

(defsum Event
  (Login [(user (slice u8)) (token (slice u8))])
  (Logout [(user (slice u8))]))
(derive (Debug (variant Login (field token (skip)))) Event)

(defsum Figure (Circle [(r i64)]) (Rectangle [(side i64) (filled bool)]) (Dot) (Blob [(w f64)]))
(derive Debug Eq Figure)

(defsum Code2 (K1 [(a i64)]) (K2))
(derive Eq Hash Code2)

(defstruct Holder [(label i64) (figure Figure)])
(derive Eq Debug Holder)

(defn derive-section [] (-> void)
  (section "derive")
  (let [p (Spot :x 1 :y 2)]
    (println "  {:?}" p)
    (println "  {:#?}" p)
    (check-true "derived Eq" (= p (Spot :x 1 :y 2)))
    (check-true "derived Eq, unequal" (!= p (Spot :x 2 :y 1)))
    (check-true "derived Hash agrees with Eq" (= (hash p) (hash (Spot :x 1 :y 2))))
    (check "derived Clone" (.y (clone p)) 2))
  (println "  {:?}" (Login :user "ada" :token "secret"))
  (println "  {:?} {:?}" (Logout :user "bob") (Rectangle 3 true))
  (check-true "sum Eq, same variant" (= (Circle 2) (Circle 2)))
  (check-true "sum Eq, payload differs" (!= (Circle 2) (Circle 3)))
  (check-true "sum Eq, nullary" (= (Dot) (Dot)))
  (check-true "sum Eq, variants differ" (!= (Dot) (Circle 1)))
  (check-true "a float payload" (= (Blob 1.5) (Blob 1.5)))
  (check-true "a bool payload" (!= (Rectangle 1 true) (Rectangle 1 false)))
  (check-true "sum Hash" (= (hash (K1 4)) (hash (K1 4))))
  (check-true "sum Hash differs" (!= (hash (K1 4)) (hash (K2))))
  (check-true "a struct holding a sum"
              (and (= (Holder :label 1 :figure (Dot)) (Holder :label 1 :figure (Dot)))
                   (!= (Holder :label 1 :figure (Dot)) (Holder :label 1 :figure (Circle 1))))))

;; ---------------------------------------------------------------- dyn

(deftrait Speak [Self]
  (speak [(self (ptr Self))] (-> (slice u8)))
  (bump! [(self (ptr Self))] (-> i64)))

(defstruct Dog2 [(age i64)])
(defstruct Cat [(lives i64)])

(impl Speak Dog2
  (speak [(self (ptr Dog2))] (-> (slice u8)) "woof")
  (bump! [(self (ptr Dog2))] (-> i64) (set! (.age self) (+ (.age self) 1)) (.age self)))

(impl Speak Cat
  (speak [(self (ptr Cat))] (-> (slice u8)) "meow")
  (bump! [(self (ptr Cat))] (-> i64) (set! (.lives self) (- (.lives self) 1)) (.lives self)))

(defn introduce [(animal (dyn Speak))] (-> i64)
  (println "  says {}" (speak animal))
  (bump! animal))

(defn dyn-section [] (-> void)
  (section "dyn trait objects")
  (let [(mut dog) (Dog2 :age 3)
        (mut cat) (Cat :lives 9)]
    (check "a dog through dyn" (introduce (mut dog)) 4)
    (check "a cat through dyn" (introduce (mut cat)) 8)
    (check "the dyn call wrote through the pointer" (.age dog) 4)
    (let [p (cast (ptr Cat) (mut cat))]
      (check "a raw pointer converts to dyn" (introduce p) 7))))

;; ---------------------------------------------------- inference from context

(defsum Fault (Negative [(n i64)]))

(defsum Wrapped (Wrap [(fault Fault)]))

(defn positive [(n i64)] (-> (Result i64 Fault)) (if (> n 0) (Ok n) (Err (Negative n))))

(defn doubled [(n i64)] (-> (Result i64 Fault)) (Ok (* n 2)))

(defn map-fault [T E F] [(r (Result T E)) (f (fnptr (cc/C) [E] F))] (-> (Result T F))
  (match r (Ok [v] (Ok v)) (Err [e] (Err (call-ptr f e)))))

(defn wrapped-sum [(n i64)] (-> (Result i64 Wrapped))
  ; the fn's body, not the context, says what F is
  (try (Ok (+ 1 (try! (map-fault (positive n) (fn [e] (Wrap e))))))))

(defn small [] (-> (Option u32)) (Some 5))

(defn result-of [T] [(r (Result T i64))] (-> i64) (match r (Ok [_] 1) (Err [e] e)))

(defn inference-section [] (-> void)
  (section "inference from context")
  (check "a try's type from its tail" (match (try (doubled (try! (positive 3)))) (Ok [v] v) (Err [_] -1)) 6)
  (check "a try's early exit" (match (try (doubled (try! (positive -3)))) (Ok [v] v) (Err [(Negative [n])] n)) -3)
  (check "map with a fn literal under try!" (match (wrapped-sum 4) (Ok [v] v) (Err [_] -1)) 5)
  (check-true "a literal inside Some takes u32" (= (small) (Some 5)))
  (check "a constructor's type argument from its payload" (result-of (Ok (Res2 :a 1))) 1))

(defstruct Res2 [(a i64)])

;; ---------------------------------------------------------------- main

(defn main [] (-> i64)
  (store! (failures) 0)
  (values-section)
  (structs-section)
  (computed-section)
  (generics-section)
  (traits-section)
  (methods-section)
  (fallback-section)
  (specialization-section)
  (blanket-section)
  (parameterized-section)
  (callable-section)
  (derive-section)
  (dyn-section)
  (inference-section)
  (println "types-traits: {} failures" (load (failures)))
  (load (failures)))
