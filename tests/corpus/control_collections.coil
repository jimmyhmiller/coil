;;; Control flow and collections, end to end: bindings and branches, every loop
;;; and exit form, destructuring, named calls, recursion, text building,
;;; explicit closures, lazy iterators, and the standard collections (ArrayList,
;;; HashMap with scalar and string keys, fixed and inline lists, persistent
;;; vectors and maps, slices and arrays), trait objects, and the command line.
;;;
;;; Every section prints what it computed and checks it; main returns the number
;;; of failed checks. The corpus runs it on arm64, LLVM, the interpreter and
;;; under coil.safety, with the arguments `alpha beta gamma`. It frees what it
;;; allocates, so the safety profile's leak report stays empty.
(module corpus.control-collections)
(import "coil.alloc" :as alloc :use [malloc-allocator malloc-allocator-lease arena-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.fixedlist" :use [FixedList InlineList])
(import "coil.pvec" :use [PVec pv-new pv-push! pv-set pv-get])
(import "coil.pmap" :use [PMap pm-new-scalar pm-assoc! pm-assoc pm-dissoc pm-contains?])
(import "coil.collect" :use [collect])
(import "coil.iter" :use [Indexed])
(import "coil.closure" :use [defclosure])
(import "coil.str" :use [StrBuf format!
                         str-keyops str-keyops-borrowed str-split str-find str-trim substr str-parse-int
                         sv String])
(import "coil.slice" :use [subslice])
(import "coil.args" :use [args-set! args-count args-nth])
(import "coil.var" :use [var-static])

;; ---------------------------------------------------------------------------
;; Self-checking

(def failures (var-static i64 0))

(defn check [(what (slice u8)) (ok bool)] (-> void)
  (unless ok
    (set failures (+ (get failures) 1))
    (println "FAILED: {}" what)))

(defn check-eq [(what (slice u8)) (got i64) (want i64)] (-> void)
  (unless (= got want)
    (set failures (+ (get failures) 1))
    (println "FAILED: {}: got {}, want {}" what got want)))

;; ---------------------------------------------------------------------------
;; 1. Bindings and branches

(defn classify [(n i64)] (-> (slice u8))
  (cond (< n 0) "negative"
        (= n 0) "zero"
        (< n 10) "small"
        :else "large"))

(defn word-value [(w (slice u8))] (-> i64)
  (case w "one" 1 "two" 2 "three" 3 0))

(defn port [(o (Option i64))] (-> i64)
  (if-let [(Some [p]) o] p 8080))

(defn section-branches [] (-> void)
  (let [x 4
        x (* x 10)
        (mut total) 0
        (mut log) 0]
    (when (> x 30) (set! total (+ total 1)))
    (unless (> x 30) (set! total (+ total 100)))
    (when-let [(Ok [n]) (: (Ok 3) (Result i64 i64))] (set! total (+ total n)))
    (let [(mut it) (range 0 5)]
      (while-let [(Some [i]) (next (mut it))] (set! log (+ log i))))
    (println "branches: {} {} {} {} words {} {} {} ports {} {} total {} log {}"
             x (classify -3) (classify 0) (classify 42)
             (word-value "two") (word-value "three") (word-value "nine")
             (port (Some 80)) (port (None)) total log)
    (check-eq "let rebinds in sequence" x 40)
    (check "cond chooses the first true test" (and (= (classify 7) "small") (= (classify 42) "large")))
    (check-eq "case over strings" (+ (word-value "two") (word-value "nine")) 2)
    (check-eq "if-let" (+ (port (Some 80)) (port (None))) 8160)
    (check-eq "when/unless/when-let" total 4)
    (check-eq "while-let" log 10)))

;; ---------------------------------------------------------------------------
;; 2. Loops and exits

(defn first-multiple [(of i64)] (-> i64)
  (block :search
    (for i (range 1 100)
      (when (= (% i of) 0) (return-from :search i)))
    -1))

(defn loop-value [] (-> i64)
  (let [(mut i) 0]
    (loop
      (set! i (+ i 3))
      (when (> i 20) (break (* i 2))))))

(defn sum-odd [(n i64)] (-> i64)
  (let [(mut i) 0
        (mut total) 0]
    (loop (set! i (+ i 1))
          (when (> i n) (break))
          (block* :check
            (when (= (% i 2) 0) (continue))
            (set! total (+ total i))))
    total))

(defn first-over [(limit i64)] (-> i64)
  (let [(mut i) 0]
    (loop (block* :step
            (when (> i limit) (break))
            (set! i (+ i 1))))
    i))

(defn block-classify [(x i64)] (-> i64)
  (block* :done
    (when (< x 0) (break :done -1))
    (when (= x 0) (break :done 0))
    1))

(defn nested-loops [] (-> i64)
  (let [(mut outer) 0
        (mut inner-total) 0]
    (loop (set! outer (+ outer 1))
          (when (> outer 3) (break))
          (block* :a
            (let [(mut j) 0]
              (loop (block* :b
                      (block* :c
                        (set! j (+ j 1))
                        (when (> j outer) (break))
                        (set! inner-total (+ inner-total 1))))))))
    inner-total))

(defn labelled-outer [] (-> i64)
  (let [(mut i) 0
        (mut pairs) 0]
    (loop :outer
      (set! i (+ i 1))
      (for j (range 0 10)
        (when (= j i) (continue :outer))
        (when (>= i 6) (break :outer))
        (set! pairs (+ pairs 1))))
    (+ (* i 100) pairs)))

(defn lookup [(xs (slice i64)) (i i64)] (-> (Result (Option i64) i64))
  (if (< i (len xs))
      (Ok [(Option i64) i64] (Some (get xs i)))
      (Ok [(Option i64) i64] (None [i64]))))

(defn first-negative [(xs (slice i64))] (-> i64)
  (let [(mut i) 0
        (mut found) -1]
    (loop (match (lookup xs i)
            (Ok [(Some [v])]
              (do (when (< v 0) (set! found i) (break))
                  (set! i (+ i 1))
                  0))
            (_ (break))))
    found))

(defn count-to [(n i64)] (-> i64)
  (let [(mut i) 0]
    (while true
      (block :step
        (set! i (+ i 1))
        (when (>= i n) (break))))
    i))

(defn section-loops [] (-> void)
  (let [got [(first-multiple 7) (loop-value) (sum-odd 9) (first-over 4) (block-classify -3) (block-classify 0)
             (block-classify 8) (nested-loops) (labelled-outer) (first-negative [3 1 -4 1]) (first-negative [2 7])
             (count-to 7)]
        want [7 42 25 5 -1 0 1 6 615 2 -1 7]]
    (print "loops:")
    (for g got (print " {}" g))
    (println "")
    (for i (range 0 (len got)) (check-eq "loop exit" (get got i) (get want i)))))

;; ---------------------------------------------------------------------------
;; 3. Destructuring

(defstruct Point [(x i64) (y i64)])
(defstruct Segment [(from Point) (to Point)])

(defn sum-pair [([a b] (slice i64))] (-> i64) (+ a b))

(defn length-squared [((Segment :from (Point :x x1 :y y1) :to (Point :x x2 :y y2)) Segment)] (-> i64)
  (+ (* (- x2 x1) (- x2 x1)) (* (- y2 y1) (- y2 y1))))

(defn section-destructuring [] (-> void)
  (let [[first second & rest] [10 20 30 40 50]
        [_ middle _ :as all] [1 2 3]
        (Point :x px) (Point :x 7 :y 8)
        (as whole (Point :y py)) (Point :x 1 :y 9)
        seg (Segment :from (Point :x 1 :y 1) :to (Point :x 4 :y 5))
        (mut xs-total) 0]
    (for (Point :x x) [(Point :x 1 :y 0) (Point :x 2 :y 0) (Point :x 3 :y 0)]
      (set! xs-total (+ xs-total x)))
    (println "destructure: {} {} {} {} {} {} {} {} {} {}"
             first second (len rest) (get rest 2) middle (len all) px py (sum-pair [3 4]) (length-squared seg))
    (check "array prefix and rest" (and (= first 10) (= second 20) (= (len rest) 3) (= (get rest 2) 50)))
    (check "ignored elements and :as" (and (= middle 2) (= (len all) 3)))
    (check "struct field subsets" (and (= px 7) (= py 9) (= (.x whole) 1)))
    (check-eq "pattern parameter" (sum-pair [3 4]) 7)
    (check-eq "nested pattern parameter" (length-squared seg) 25)
    (check-eq "for with a pattern" xs-total 6)))

;; ---------------------------------------------------------------------------
;; 4. Named calls evaluate in the order they are written

(def order (var-static i64 0))

(defn mark [(digit i64)] (-> i64)
  (set order (+ (* (get order) 10) digit))
  digit)

(defn combine [(a i64) (b i64)] (-> i64) (+ (* a 10) b))

(defn move-by [(x i64) (dx i64) (scale i64)] (-> i64) (+ x (* dx scale)))

(defsum Duo (DuoValue [(a i64) (b i64)]))

(defn section-named-calls [] (-> void)
  (set order 0)
  (let [p (Point :y (mark 2) :x (mark 1))
        after-struct (get order)
        c (combine :b (mark 4) :a (mark 3))
        after-call (get order)
        d (DuoValue :b (mark 6) :a (mark 5))]
    (println "named: struct {}/{} order {} call {} order {} sum {} order {} positional {} named {}"
             (.x p) (.y p) after-struct c after-call
             (match d (DuoValue [a b] (combine a b))) (get order)
             (move-by 1 2 3) (move-by :scale 3 :x 1 :dx 2))
    (check-eq "struct fields in written order" after-struct 21)
    (check-eq "named arguments in written order" after-call 2143)
    (check-eq "named arguments reach their parameters" c 34)
    (check-eq "variant fields in written order" (get order) 214365)
    (check-eq "named equals positional" (move-by :scale 3 :x 1 :dx 2) (move-by 1 2 3))))

;; ---------------------------------------------------------------------------
;; 5. Recursion and text

(defn fib [(n i64)] (-> i64) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(defn ackermann [(m i64) (n i64)] (-> i64)
  (cond (= m 0) (+ n 1)
        (= n 0) (ackermann (- m 1) 1)
        :else (ackermann (- m 1) (ackermann m (- n 1)))))

(defn even? [(n i64)] (-> bool) (if (= n 0) true (odd? (- n 1))))
(defn odd? [(n i64)] (-> bool) (if (= n 0) false (even? (- n 1))))

;; Accumulating self recursion, a million calls deep: every backend and the
;; interpreter run a self call in tail position as a jump, in constant stack.
(defn count-down [(n i64) (acc i64)] (-> i64)
  (if (= n 0) acc (count-down (- n 1) (+ acc 1))))

;; A tail call that swaps its arguments: the new values are all computed before
;; any parameter is overwritten.
(defn swap-down [(n i64) (a i64) (b i64)] (-> i64)
  (if (= n 0) (+ (* a 10) b) (swap-down (- n 1) b a)))

(defn palindrome? [(s (slice u8))] (-> bool)
  (if (< (len s) 2)
      true
      (and (= (get s 0) (get s (- (len s) 1)))
           (palindrome? (substr s 1 (- (len s) 1))))))

(defn reverse-into! [(sb (mut StrBuf)) (s (slice u8))] (-> void)
  (when (> (len s) 0)
    (reverse-into! (mut sb) (substr s 1 (len s)))
    (push-str! (mut sb) (substr s 0 1))))

(defn section-recursion-and-text [] (-> void)
  (let [a (malloc-allocator)
        (mut sb) (StrBuf::new a)
        (mut rev) (StrBuf::new a)
        (mut parts) (str-split a "red,green,,blue" ",")
        (mut s) (String::from-view a (sv "Grüße"))]
    (push-str! (mut sb) "fib(20)=")
    (push-i64! (mut sb) (fib 20))
    (format! (mut sb) " ack={} even={}" (ackermann 2 3) (even? 10))
    (reverse-into! (mut rev) "stressed")
    (write-view! (mut s) (sv ", Welt"))
    (let [found (match (str-find "hello world" "wor") (Some [i] i) (None [] -1))
          parsed (match (str-parse-int "-1234") (Some [n] n) (None [] 0))
          (mut runes) 0]
      (for _ (as-string-view s) (set! runes (+ runes 1)))
      (println "text: {} | {} | parts {} [{}] | find {} | trim [{}] | parse {} | runes {} bytes {} | {}"
               (str sb) (str rev) (len parts) (get parts 3) found (str-trim "  padded \t")
               parsed runes (len (bytes (as-string-view s))) (bytes (as-string-view s)))
      (println "recursion: accumulate {} swap {} {} palindromes {} {} {}"
               (count-down 1000000 0) (swap-down 1000001 3 4) (swap-down 10 3 4) (palindrome? "racecar") (palindrome? "abca") (odd? 7))
      (check "StrBuf with formatting" (= (str sb) "fib(20)=6765 ack=9 even=true"))
      (check "recursion through a StrBuf" (= (str rev) "desserts"))
      (check "split keeps empty fields" (and (= (len parts) 4) (= (get parts 2) "") (= (get parts 3) "blue")))
      (check-eq "str-find" found 6)
      (check "str-trim" (= (str-trim "  padded \t") "padded"))
      (check-eq "str-parse-int" parsed -1234)
      (check-eq "runes, not bytes" runes 11)
      (check-eq "UTF-8 bytes" (len (bytes (as-string-view s))) 13)
      (check-eq "a million self tail calls" (count-down 1000000 0) 1000000)
      (check "a deep tail call that swaps its arguments" (and (= (swap-down 1000001 3 4) 43) (= (swap-down 10 3 4) 34)))
      (check "recursive palindrome" (and (palindrome? "racecar") (not (palindrome? "abca"))))
      (check "mutual recursion" (and (odd? 7) (even? 10))))
    (free! (mut sb))
    (free! (mut rev))
    (free! (mut parts))
    (free! (mut s))))

;; ---------------------------------------------------------------------------
;; 6. Closures with an explicit environment, and plain function values

(defclosure adder [(n i64)] [(x i64)] i64 (+ n x))
(defclosure scaler [(k i64)] [(x i64)] i64 (* k x))

(defn apply-twice [(f (fnptr c [i64] i64)) (x i64)] (-> i64) (f (f x)))

(defn section-closures [] (-> void)
  (let [add5 (adder-new 5)
        triple (scaler-new 3)
        (mut via-closures) 0]
    (for x [1 2 3] (set! via-closures (+ via-closures (scaler-call triple (adder-call add5 x)))))
    (println "closures: {} {} {} twice {}"
             (adder-call add5 37) (scaler-call triple 14) via-closures (apply-twice (fn [n] (* n n)) 3))
    (check-eq "closure over a captured value" (adder-call add5 37) 42)
    (check-eq "two closures composed" via-closures 63)
    (check-eq "anonymous function value" (apply-twice (fn [n] (* n n)) 3) 81)
    (adder-free add5)
    (scaler-free triple)))

;; ---------------------------------------------------------------------------
;; 7. Lazy iterators

(defn even-number? [(n i64)] (-> bool) (= (% n 2) 0))

(defn section-iterators [] (-> void)
  (let [a (malloc-allocator)
        (mut xs) (collect [(ArrayList i64)] a [5 2 8 1 9 4])
        evens (count (filter (fnptr-of even-number?) xs))
        windowed (fold (fn [acc n] (+ acc n)) 0 (take 3 (skip 1 xs)))
        squares (fold (fn [acc n] (+ acc n)) 0 (map (fn [n] (* n n)) (range 0 5)))
        chained (fold (fn [acc n] (+ (* acc 10) n)) 0 (chain [1 2] [3 4]))
        big (find (fn [n] (> n 7)) xs)
        (mut zipped) 0
        (mut weighted) 0]
    (for item (zip [1 2 3] [10 20 30])
      (let [pair item] (set! zipped (+ zipped (* (.first pair) (.second pair))))))
    (for (Indexed :index i :value n) (enumerate xs) (set! weighted (+ weighted (* i n))))
    (println "iterators: evens {} window {} squares {} chain {} find {:?} any {} all {} zip {} enumerate {}"
             evens windowed squares chained big (any? (fn [n] (> n 8)) xs) (all? (fn [n] (> n 0)) xs) zipped weighted)
    (check-eq "filter + count" evens 3)
    (check-eq "skip + take + fold" windowed 11)
    (check-eq "map over a range" squares 30)
    (check-eq "chain" chained 1234)
    (check "find" (match big (Some [n] (= n 8)) (None [] false)))
    (check "any?/all?" (and (any? (fn [n] (> n 8)) xs) (all? (fn [n] (> n 0)) xs) (not (any? (fn [n] (> n 9)) xs))))
    (check-eq "zip" zipped 140)
    (check-eq "enumerate" weighted 77)
    (free! (mut xs))))

;; ---------------------------------------------------------------------------
;; 8. Owned collections

(defn row [(a i64) (b i64)] (-> (array i64 2)) [a b])

(defn weigh [(rows (slice (array i64 2)))] (-> i64)
  (let [(mut total) 0]
    (for r rows (set! total (+ total (get r 0) (* 10 (get r 1)))))
    total))

(defn section-arraylist [] (-> void)
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [i64] a)
        (mut rows) (ArrayList::new [(array i64 2)] a)]
    (for i (range 0 100) (push! (mut xs) (* i i)))
    (set! (mut xs) 0 -1)
    (let [popped (pop! (mut xs))]
      (push! (mut rows) (row 1 2))
      (push! (mut rows) (row 3 4))
      (push! (mut rows) (row 5 6))
      (let [view (slice rows)
            last (get view 2)]
        (println "arraylist: len {} first {} last {} popped {:?} rows {} last-row {} {}"
                 (len xs) (get xs 0) (get xs 98) popped (weigh view) (get last 0) (get last 1))
        (check-eq "push grows" (len xs) 99)
        (check "set and get" (and (= (get xs 0) -1) (= (get xs 98) 9604)))
        (check "pop" (match popped (Some [v] (= v 9801)) (None [] false)))
        (check-eq "slice of arrays" (weigh view) 129)
        (check-eq "whole-element indexing" (+ (get last 0) (get last 1)) 11)))
    (free! (mut xs))
    (free! (mut rows))))

(defn section-hashmap [] (-> void)
  (let [a (malloc-allocator)
        (mut squares) (HashMap::new-scalar [i64 i64] a)
        (mut owned) (HashMap::new [(slice u8) i64] a (str-keyops))
        (mut borrowed) (HashMap::new [(slice u8) i64] a (str-keyops-borrowed))
        (mut key-bytes) (: [104 105] (array u8 2))]
    (for i (range 0 1000) (set! (mut squares) i (* i i)))
    (remove! (mut squares) 10)
    ;; An owned-key map copies the key, so changing the caller's bytes later
    ;; does not change the key it stored.
    (set! (mut owned) (subslice (: (mut key-bytes) (slice u8)) 0 2) 1)
    (set! (mut key-bytes) 1 111)
    (set! (mut owned) "two" 2)
    (set! (mut owned) "two" 22)
    (set! (mut borrowed) "static" 7)
    (let [hi (get owned "hi")
          ho (get owned "ho")
          (mut key-sum) 0]
      (for k squares (set! key-sum (+ key-sum k)))
      (println "hashmap: len {} 999->{:?} 10->{:?} contains {} keys {} owned {:?} {:?} {:?} len {} borrowed {:?}"
               (len squares) (get squares 999) (get squares 10) (contains? squares 500)
               key-sum hi ho (get owned "two") (len owned) (get borrowed "static"))
      (check-eq "scalar map size after a removal" (len squares) 999)
      (check "scalar lookups" (and (match (get squares 999) (Some [v] (= v 998001)) (None [] false))
                                   (match (get squares 10) (Some [_] false) (None [] true))))
      (check-eq "iterating keys" key-sum 499490)
      (check "owned keys are copied" (and (match hi (Some [v] (= v 1)) (None [] false))
                                          (match ho (Some [_] false) (None [] true))))
      (check "overwrite keeps one entry" (and (= (len owned) 2) (match (get owned "two") (Some [v] (= v 22)) (None [] false))))
      (check "borrowed keys" (match (get borrowed "static") (Some [v] (= v 7)) (None [] false))))
    (free! (mut squares))
    (free! (mut owned))
    (free! (mut borrowed))))

(defstruct Recent [(items (InlineList i64 4)) (total i64)])

(defn remember! [(r (mut Recent)) (x i64)] (-> void)
  (when (= (len (.items r)) 4) (pop! (mut (.items r))))
  (push! (mut (.items r)) x)
  (set! (.total r) (+ (.total r) x)))

(defn section-fixed-lists [] (-> void)
  (let [arena (arena-allocator 1024)
        storage (match (alloc/alloc [i64] arena 8) (Some [cells] cells) (None [] (: [] (slice i64))))
        (mut fixed) (FixedList::new storage)
        (mut recent) (Recent :items (InlineList::new [i64 4]) :total 0)]
    (for i (range 0 8) (push! (mut fixed) (* i 3)))
    (for i (range 1 7) (remember! (mut recent) i))
    (println "fixed: len {} last {} recent len {} last {} total {}"
             (len fixed) (get fixed 7) (len (.items recent)) (get (.items recent) 3) (.total recent))
    (check-eq "fixed list fills its storage" (len fixed) 8)
    (check-eq "fixed list element" (get fixed 7) 21)
    (check-eq "inline list in a struct" (len (.items recent)) 4)
    (check-eq "inline list after pops" (get (.items recent) 3) 6)))

(defn section-persistent [] (-> void)
  (let [(mut v) (pv-new [i64] (malloc-allocator-lease))
        (mut m) (pm-new-scalar [i64 i64] (malloc-allocator-lease))]
    (for i (range 0 100) (pv-push! (mut v) i))
    (for i (range 0 50) (pm-assoc! (mut m) i (* i 2)))
    (let [v2 (pv-set (clone v) 50 -1)
          m2 (pm-dissoc (pm-assoc (clone m) 100 1) 0)]
      (println "persistent: vec {} {:?} {} {:?} map {} {} {} {} {}"
               (len v) (pv-get v 50) (len v2) (pv-get v2 50)
               (len m) (pm-contains? m 0) (len m2) (pm-contains? m2 0) (pm-contains? m2 100))
      (check "an update leaves the old vector intact"
             (and (= (pv-get v 50) (Some 50)) (= (pv-get v2 50) (Some -1))))
      (check "persistent vector length" (and (= (len v) 100) (= (len v2) 100)))
      (check "an update leaves the old map intact" (and (pm-contains? m 0) (not (pm-contains? m2 0))))
      (check-eq "persistent map length" (len m2) 50))))

(defn total [(xs (slice i64))] (-> i64) (fold (fn [acc x] (+ acc x)) 0 xs))

;; Folding over a slice of arrays hands each array to the function by value.
(defn row-weights [(rows (slice (array i64 2)))] (-> i64)
  (fold (fn [acc r] (+ acc (* (get r 0) (get r 1)))) 0 rows))

(defn section-slices-and-arrays [] (-> void)
  (let [(mut arr) [1 2 3 4 5 6]
        whole (: (mut arr) (slice i64))
        middle (subslice whole 2 5)
        a 1
        b 2]
    (set! (mut arr) 0 10)
    (println "slices: total {} middle {} len {} first {} bracket-values {} {}"
             (total arr) (total middle) (len middle) (get whole 0) (total [a b]) (len [(Some a) (None)]))
    (check-eq "an array borrowed as a slice" (total arr) 30)
    (check-eq "subslice" (total middle) 12)
    (check-eq "a slice sees the array's writes" (get whole 0) 10)
    (check-eq "brackets after a call head hold values" (total [a b]) 3)
    (println "  rows: {}" (row-weights [[1 2] [3 4] [5 6]]))
    (check-eq "fold over a slice of arrays" (row-weights [[1 2] [3 4] [5 6]]) 44)))

;; ---------------------------------------------------------------------------
;; 9. Trait objects

(deftrait Shape [Self]
  (area [(self (ptr Self))] (-> i64))
  (name [(self (ptr Self))] (-> (slice u8))))

(defstruct Square [(side i64)])
(defstruct Rect [(w i64) (h i64)])
(impl Shape Square
  (area [(self (ptr Square))] (-> i64) (* (.side self) (.side self)))
  (name [(self (ptr Square))] (-> (slice u8)) "square"))
(impl Shape Rect
  (area [(self (ptr Rect))] (-> i64) (* (.w self) (.h self)))
  (name [(self (ptr Rect))] (-> (slice u8)) "rect"))

(defn describe [(s (dyn Shape))] (-> i64)
  (print "{}={} " (name s) (area s))
  (area s))

(defn section-dyn [] (-> void)
  (let [(mut sq) (Square :side 3)
        (mut r) (Rect :w 2 :h 5)
        (mut shapes) (ArrayList::new [(dyn Shape)] (malloc-allocator))]
    (push! (mut shapes) (: (mut sq) (dyn Shape)))
    (push! (mut shapes) (: (mut r) (dyn Shape)))
    (push! (mut shapes) (: (cast (ptr Square) (mut sq)) (dyn Shape)))
    (print "dyn: ")
    (let [sum (fold (fn [acc s] (+ acc (describe s))) 0 shapes)]
      (println "sum {}" sum)
      (check-eq "dispatch through a list of trait objects" sum 28))
    (free! (mut shapes))))

;; ---------------------------------------------------------------------------
;; 10. The command line

(defn section-args [] (-> void)
  (print "args: {} after the program:" (- (args-count) 1))
  (for i (range 1 (args-count)) (print " {}" (args-nth i)))
  (println "")
  (check-eq "argument count" (args-count) 4)
  (check "arguments in order" (and (= (args-nth 1) "alpha") (= (args-nth 3) "gamma")))
  (check "past the end is empty" (= (len (args-nth 9)) 0)))

;; ---------------------------------------------------------------------------

(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)
  (args-set! argc argv)
  (section-branches)
  (section-loops)
  (section-destructuring)
  (section-named-calls)
  (section-recursion-and-text)
  (section-closures)
  (section-iterators)
  (section-arraylist)
  (section-hashmap)
  (section-fixed-lists)
  (section-persistent)
  (section-slices-and-arrays)
  (section-dyn)
  (section-args)
  (println "control-collections: {} failures" (get failures))
  (get failures))
