;;; Machine code, end to end: functions whose whole body is bytes for the
;;; target, under the C convention and under a `:shim` convention that pins
;;; registers, a fragment that reads and writes memory, one with no result, and
;;; one that never returns. Each is defined for the architecture being compiled
;;; for by an exhaustive choice on `(target-arch)`.
;;;
;;; Every section prints what it computed and checks it. The program ends by
;;; jumping, through machine code, to a function that exits with the number of
;;; failed checks. The corpus runs it on arm64, LLVM and x64; the interpreter
;;; runs no machine code and refuses it.
(module corpus.machine-code)
(import "coil.primitive" :as primitive)
(import "coil.var" :use [Var var-static])

;; ---------------------------------------------------------------------------
;; Self-checking

(def failures (var-static i64 0))

(defn check-eq [(what (slice u8)) (got i64) (want i64)] (-> void)
  (unless (= got want)
    (set failures (+ (get failures) 1))
    (println "FAILED: {}: got {}, want {}" what got want)))

(extern exit :cc c [i32] (-> never))

;; ---------------------------------------------------------------------------
;; Definitions per architecture

;; A function NAME whose body is the AARCH64 or X86-64 bytes, whichever
;; architecture the program is compiled for.
(defn defmachine [(name Code)
                  (cc Code)
                  (params Code)
                  (result Code)
                  (aarch64 Code)
                  (x86-64 Code)] (-> Code)
  (match (target-arch)
    (Aarch64 []
             `(defn ~name :cc ~cc ~params (-> ~result)
                (primitive/machine-code (Aarch64) ~@aarch64)))
    (X86_64 []
            `(defn ~name :cc ~cc ~params (-> ~result)
               (primitive/machine-code (X86_64) ~@x86-64)))
    (_ (primitive/error "the machine-code corpus has bytes for aarch64 and x86_64 only"))))

;; Two arguments and a result in registers the C conventions would not use.
(defn defpinned [(name Code)] (-> Code)
  (match (target-arch)
    (Aarch64 [] `(defcc ~name :params [x9 x10] :ret x9 :clobber [x9 x10] :lower shim))
    (X86_64 [] `(defcc ~name :params [rax rdx] :ret rax :clobber [rax rdx] :lower shim))
    (_ (primitive/error "the machine-code corpus pins aarch64 and x86_64 registers only"))))

;; ---------------------------------------------------------------------------
;; Arithmetic in the C convention

;; add x0, x0, x1 / lea rax, [rdi+rsi]
(defmachine add2 c [(a i64) (b i64)] i64
  [0x00 0x00 0x01 0x8b]
  [0x48 0x8d 0x04 0x37])

(defn section-add [] (-> void)
  (let [x (+ 30 10)]  ; computed, so the arguments are really in registers
    (println "add: {} {}" (add2 x 2) (add2 -5 5))
    (check-eq "add2 40 2" (add2 x 2) 42)
    (check-eq "add2 -5 5" (add2 -5 5) 0)))

;; ---------------------------------------------------------------------------
;; Memory: the bytes store through a pointer the caller then reads

;; str x1, [x0] / mov [rdi], rsi
(defmachine write-cell! c [(place (ptr i64)) (value i64)] void
  [0x01 0x00 0x00 0xf9]
  [0x48 0x89 0x37])

(defn section-store [] (-> void)
  (let [(mut cell) 0]
    (write-cell! (cast (ptr i64) (mut cell)) 1234)
    (println "store: {}" cell)
    (check-eq "the cell machine code wrote" cell 1234)))

;; ---------------------------------------------------------------------------
;; No result: the bytes are a no-op, and the call returns

;; nop / nop
(defmachine idle c [] void
  [0x1f 0x20 0x03 0xd5]
  [0x90])

(defn section-idle [] (-> void)
  (idle)
  (println "idle: returned"))

;; ---------------------------------------------------------------------------
;; A :shim convention: the caller puts the arguments in the pinned registers

(defpinned pinned)

;; sub x9, x9, x10 / sub rax, rdx
(defmachine sub2 pinned [(a i64) (b i64)] i64
  [0x29 0x01 0x0a 0xcb]
  [0x48 0x29 0xd0])

(defn section-pinned [] (-> void)
  (let [x (+ 40 10)]
    (println "pinned: {}" (sub2 x 8))
    (check-eq "sub2 50 8, not 8 50" (sub2 x 8) 42)))

;; ---------------------------------------------------------------------------
;; Never returning: no return instruction follows the bytes, which jump

;; br x1 / jmp rsi
(defmachine jump c [(failed i32) (target (fnptr c [i32] never))] never
  [0x20 0x00 0x1f 0xd6]
  [0xff 0xe6])

(defn finish :cc c [(failed i32)] (-> never)
  (println "jump: landed, {} failed" failed)
  (exit failed))

(defn main [] (-> i64)
  (section-add)
  (section-store)
  (section-idle)
  (section-pinned)
  (jump (primitive/cast i32 (get failures)) (fnptr-of finish)))
