;;; Numbers, end to end: integers of every width (8 to 128 bits and odd widths),
;;; wrapping primitives against the checked operators, division and remainder
;;; signs, shifts, bit operations, bit-field layouts, overflow detection, casts,
;;; floats and their IEEE edges, coil.math, number formatting, and SIMD lanes.
;;;
;;; Every section prints what it computed and checks it; main returns the number
;;; of failed checks. The corpus runs it on arm64 and LLVM. The interpreter keeps
;;; every integer in one 64-bit cell, so it must refuse this program, which
;;; computes with i128.
;;;
;;; Wrapping and truncation are always spelled with `primitive/`, so the program
;;; is also correct under `coil.safety`, where `+ - *` and `cast` are checked.
(module corpus.numerics)
(import "coil.primitive" :as p)
(import "coil.math" :as math)
(import "coil.integer" :use [overflowing-add overflowing-sub overflowing-mul])
(import "coil.simd" :as v)
(import "coil.var" :use [var-static])
(import "coil.layout" :as layout)

;; ---------------------------------------------------------------------------
;; Self-checking

(def failures (var-static i64 0))

(defn check [(what (slice u8)) (ok bool)] (-> void)
  (unless ok
    (set failures (+ (get failures) 1))
    (println "FAILED: {}" what)))

(defn check-eq [(what (slice u8)) (got i64) (want i64)] (-> void)
  (unless (= got want)
    (set failures (+ (get failures) 1))
    (println "FAILED: {}: got {}, want {}" what got want)))

(defn check-all [(what (slice u8)) (got (slice i64)) (want (slice i64))] (-> void)
  (check-eq what (len got) (len want))
  (for i (range 0 (len got))
    (when (!= (get got i) (get want i))
      (set failures (+ (get failures) 1))
      (println "FAILED: {} [{}]: got {}, want {}" what i (get got i) (get want i)))))

;; ---------------------------------------------------------------------------
;; 1. Wrapping arithmetic at each width

(defn section-wrapping [] (-> void)
  (let [got [(cast i64 (p/iadd (: 250 u8) (: 10 u8)))
             (cast i64 (p/imul (: 20 u8) (: 20 u8)))
             (cast i64 (p/iadd (: 127 i8) (: 1 i8)))
             (cast i64 (p/isub (: -128 i8) (: 1 i8)))
             (cast i64 (p/imul (: 300 u16) (: 300 u16)))
             (cast i64 (p/isub (: 0 i16) (: -32768 i16)))
             (cast i64 (p/iadd (: 4294967295 u32) (: 2 u32)))
             (cast i64 (p/imul (: 65536 i32) (: 65536 i32)))
             (p/iadd 9223372036854775807 1)
             (cast i64 (p/cast u2 6))
             (cast i64 (p/iadd (: 3 u2) (: 3 u2)))
             (cast i64 (p/cast i3 5))
             (cast i64 (p/cast u7 200))
             (cast i64 (p/imul (: 3 i3) (: 3 i3)))
             (cast i64 (p/iadd (: 16777215 u24) (: 2 u24)))
             (cast i64 (p/isub (: -64 i7) (: 1 i7)))]
        want [4 144 -128 127 24464 -32768 1 0 -9223372036854775808 2 2 -3 72 1 1 63]]
    (print "wrapping:")
    (for x got (print " {}" x))
    (println "")
    (check-all "wrapping" got want)))

;; ---------------------------------------------------------------------------
;; 2. Division and remainder: truncation toward zero, and unsigned division

(defn section-division [] (-> void)
  (let [got [(/ -7 2) (% -7 2) (/ 7 -2) (% 7 -2) (/ -7 -2) (% -7 -2)
             (cast i64 (p/udiv (p/cast u64 -2) (: 3 u64)))
             (cast i64 (p/urem (p/cast u64 -1) (: 10 u64)))
             (cast i64 (/ (: -100 i8) (: 3 i8)))
             (cast i64 (% (: -100 i8) (: 3 i8)))
             (cast i64 (/ (: 200 u8) (: 3 u8)))
             (cast i64 (% (: 65535 u16) (: 256 u16)))
             (/ 100 5 2)]
        want [-3 -1 -3 1 3 -1 6148914691236517204 5 -33 -1 66 255 10]]
    (print "division:")
    (for x got (print " {}" x))
    (println "")
    (check-all "division" got want)))

;; ---------------------------------------------------------------------------
;; 3. Shifts follow the type's signedness

(defn section-shifts [] (-> void)
  (let [got [(<< 1 62)
             (>> -16 2)
             (cast i64 (>> (p/cast u64 -16) (: 2 u64)))
             (cast i64 (p/ishl (: 129 u8) (: 1 u8)))
             (cast i64 (>> (: -64 i8) (: 3 i8)))
             (cast i64 (>> (: 192 u8) (: 3 u8)))
             (cast i64 (<< (: 1 u32) (: 31 u32)))
             (cast i64 (>> (: -2147483648 i32) (: 31 i32)))]
        want [4611686018427387904 -4 4611686018427387900 2 -8 24 2147483648 -1]]
    (print "shifts:")
    (for x got (print " {}" x))
    (println "")
    (check-all "shifts" got want)))

;; ---------------------------------------------------------------------------
;; 4. Bit operations and bit-field layouts

(defstruct Flags :layout (layout/Bits) :backing u8
  [(lo :bits 1) (mid :bits 3) (hi :bits 4)])
(defstruct Wide :layout (layout/Bits) :backing u32
  [(a :bits 12) (b :bits 9) (c :bits 11)])

(defn section-bits [] (-> void)
  (let [x (: 0b1011_0000 u8)
        got [(cast i64 (p/popcount x)) (cast i64 (p/ctz x)) (cast i64 (p/clz x))
             (cast i64 (p/popcount -1)) (p/clz 1) (p/ctz -9223372036854775808)
             (cast i64 (p/bswap (: 0x1234 u16))) (cast i64 (p/bswap (: 0x11223344 u32)))
             (cast i64 (p/rotl (: 0x81 u8) (: 1 u8))) (cast i64 (p/rotr (: 1 u16) (: 1 u16)))
             (cast i64 (p/mulhi (: 0xFFFFFFFF u32) (: 0xFFFFFFFF u32)))
             (p/mulhi -1 2)
             (& -252645136 65535) (| 1 2 4) (& 7 6 4) (^ 0xFF 0x0F 0x01) (p/inot 0)
             (cast i64 (p/inot (: 0x0F u8)))]
        want [3 4 0 64 63 63 0x3412 0x44332211 3 32768 4294967294 -1 61680 7 4 0xF1 -1 0xF0]]
    (print "bits:")
    (for x got (print " {}" x))
    (println "")
    (check-all "bit operations" got want))
  (let [(mut flags) (zeroed Flags)
        (mut wide) (zeroed Wide)
        f (cast (ptr Flags) (mut flags))
        g (cast (ptr Wide) (mut wide))]
    (p/bit-set! f lo (: 1 u1))
    (p/bit-set! f mid (: 5 u3))
    (p/bit-set! f hi (: 12 u4))
    (let [raw (cast i64 (load (cast (ptr u8) f)))]
      (p/bit-set! f mid (: 2 u3))
      (p/bit-set! g a (: 4095 u12))
      (p/bit-set! g b (: 257 u9))
      (p/bit-set! g c (: 1024 u11))
      (let [before-b (cast i64 (p/bit-get g b))]
        (p/bit-set! g b (: 0 u9))
        (let [got [raw (cast i64 (p/bit-get f lo)) (cast i64 (p/bit-get f mid)) (cast i64 (p/bit-get f hi))
                   (cast i64 (p/bit-get g a)) before-b (cast i64 (p/bit-get g b)) (cast i64 (p/bit-get g c))
                   (cast i64 (load (cast (ptr u32) g)))]
              want [203 1 2 12 4095 257 0 1024 2147487743]]
          (print "bitfields:")
          (for x got (print " {}" x))
          (println "")
          (check-all "bit-field layout" got want))))))

;; ---------------------------------------------------------------------------
;; 5. Comparisons follow the type's signedness at every width

(defn section-comparisons [] (-> void)
  (let [results [(< (: -2 i8) (: 1 i8))
                 (<= (: -2 i16) (: -2 i16))
                 (> (: 2 i32) (: -1 i32))
                 (>= 2 2)
                 (< (: 1 u8) (: 255 u8))
                 (<= (: 65535 u16) (: 65535 u16))
                 (> (: 0xffffffff u32) (: 1 u32))
                 (>= (p/cast u64 -1) (: 0 u64))
                 (= (: -1 i8) (: -1 i8))
                 (!= (: 1 u32) (: 2 u32))
                 (< (p/cast u8 (: -1 i8)) (: 1 u8))
                 (p/icmp-gt (: 3 u24) (: 2 u24))]
        (mut trues) 0]
    (for r results (when r (set! trues (+ trues 1))))
    (println "comparisons: {} of {} hold" trues (len results))
    (check-eq "ordered comparisons at every width" trues 11)
    (check "unsigned reinterpretation compares unsigned" (not (get results 10)))))

;; ---------------------------------------------------------------------------
;; 6. Overflow detection

(defn section-overflow [] (-> void)
  (let [add (overflowing-add (: 200 u8) (: 100 u8))
        sub (overflowing-sub (: -128 i8) (: 1 i8))
        mul (overflowing-mul (: 3 i64) (: 4 i64))
        big (overflowing-mul 4611686018427387904 2)]
    (println "overflow: add {}/{} sub {}/{} mul {}/{} big {}/{} preds {} {} {} {}"
             (.value add) (.overflow add) (.value sub) (.overflow sub) (.value mul) (.overflow mul)
             (.value big) (.overflow big)
             (p/iadd-overflow? 9223372036854775807 1) (p/isub-overflow? (: 0 u32) (: 1 u32))
             (p/imul-overflow? (: 9223372036854775807 i64) 2) (p/iadd-overflow? 1 2))
    (check "unsigned add overflow" (and (= (.value add) (: 44 u8)) (.overflow add)))
    (check "signed sub overflow" (and (= (.value sub) (: 127 i8)) (.overflow sub)))
    (check "no overflow" (and (= (.value mul) 12) (not (.overflow mul))))
    (check "signed mul overflow" (and (= (.value big) -9223372036854775808) (.overflow big)))
    (check "overflow predicates"
           (and (p/iadd-overflow? 9223372036854775807 1) (p/isub-overflow? (: 0 u32) (: 1 u32))
                (p/imul-overflow? (: 9223372036854775807 i64) 2) (not (p/iadd-overflow? 1 2))))))

;; ---------------------------------------------------------------------------
;; 7. Casts: truncation, sign and zero extension, and float conversion

(defn section-casts [] (-> void)
  (let [got [(cast i64 (p/cast u8 0x1FF))
             (cast i64 (p/cast i8 0xFF))
             (cast i64 (: -1 i8))
             (cast i64 (p/cast u8 (: -1 i8)))
             (cast i64 (cast u32 (: 65535 u16)))
             (cast i64 (p/cast i16 (: 40000 u32)))
             (p/cast i64 (p/cast u64 (: -1 i32)))
             (cast i64 -3.99)
             (cast i64 3.99)
             (cast i64 (cast u32 3.99))
             (cast i64 (* 1000.0 (cast f64 (: 1.1 f32))))
             (cast i64 (/ (cast f64 (p/cast u64 -1)) 1000000000000000000.0))
             (cast i64 (cast f32 16777217))]
        want [255 -1 -1 255 65535 -25536 -1 -3 3 3 1100 18 16777216]]
    (print "casts:")
    (for x got (print " {}" x))
    (println "")
    (check-all "casts" got want)))

;; ---------------------------------------------------------------------------
;; 8. 128-bit integers

(defstruct Wide128 [(tag i8) (wide i128) (after i64)])
(defsum Amount (Small [(n i64)]) (Big [(n u128)]))
(def LIMIT (: 340282366920938463463374607431768211455 u128))
(def WIDE-STATIC (Wide128 :tag 1 :wide -170141183460469231731687303715884105728 :after 9))
(const PRODUCT (* (: 4000000000 i128) (: 5000000000 i128)))

(defn sum8 [(a i128) (b i128) (c i128) (d i128) (e i128) (f i128) (g i128) (h i128)] (-> i128)
  (+ a b c d e f g h))

(defn amount-value [(a Amount)] (-> u128)
  (match a (Small [n] (cast u128 n)) (Big [n] n)))

(defn section-int128 [] (-> void)
  (let [big (: 18446744073709551616 i128)
        neg (: -5 i128)
        u (: 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_fff0 u128)
        m (: 170141183460469231731687303715884105727 i128)
        (mut w) (zeroed Wide128)]
    (set! (.wide w) (* big (: -3 i128)))
    (set! (.after w) 7)
    (println "int128: {} {} {} {}" big neg u m)
    (println "int128: {} {} {} {}" (+ big neg) (- neg big) (* big neg) (* (: 123456789123456789 i128) (: 987654321987654321 i128)))
    (println "int128: {} {} {} {} {} {}" (/ m (: 7 i128)) (% m (: 7 i128)) (/ neg (: 2 i128)) (% neg (: 3 i128)) (/ u (: 10 u128)) (% u (: 10 u128)))
    (for n [0 1 63 64 65 127]
      (print " [{}: {} {} {}]" n (<< (: 3 u128) (cast u128 n)) (>> u (cast u128 n)) (>> (: -1000 i128) (cast i128 n))))
    (println "")
    (println "int128: rot {} {} bits {} {} {} mulhi {} casts {} {} {} float {} {}"
             (p/rotl u (: 4 u128)) (p/rotr (: 1 u128) (: 1 u128))
             (p/clz big) (p/ctz big) (p/popcount u)
             (p/mulhi LIMIT LIMIT)
             (p/cast i64 big) (cast i128 (: -7 i64)) (p/cast u8 u)
             (cast f64 big) (cast i128 (: -2.5e20 f64)))
    (println "int128: overflow {} {} {} calls {} struct {} {} static {} {} sum {} {}"
             (p/iadd-overflow? m (: 1 i128)) (p/isub-overflow? (: 0 u128) (: 1 u128)) (p/imul-overflow? big big)
             (sum8 big big big big neg neg neg neg) (.wide w) (.after w) (.wide WIDE-STATIC) PRODUCT
             (amount-value (Big :n LIMIT)) (amount-value (Small :n 4)))
    (check "i128 arithmetic" (= (+ big neg) (: 18446744073709551611 i128)))
    (check "i128 product" (= (* (: 123456789123456789 i128) (: 987654321987654321 i128))
                             (: 121932631356500531347203169112635269 i128)))
    (check "i128 division" (and (= (/ neg (: 2 i128)) (: -2 i128)) (= (% neg (: 3 i128)) (: -2 i128))))
    (check "u128 shifts at the word boundary" (= (<< (: 3 u128) (: 64 u128)) (: 55340232221128654848 u128)))
    (check "i128 arithmetic shift" (= (>> (: -1000 i128) (: 127 i128)) (: -1 i128)))
    (check "u128 bits" (and (= (p/clz big) (: 63 i128)) (= (p/popcount u) (: 124 u128))))
    (check "u128 mulhi" (= (p/mulhi LIMIT LIMIT) (: 340282366920938463463374607431768211454 u128)))
    (check "i128 overflow" (and (p/iadd-overflow? m (: 1 i128)) (p/imul-overflow? big big)))
    (check "i128 in calls, structs and statics"
           (and (= (sum8 big big big big neg neg neg neg) (: 73786976294838206444 i128))
                (= (.wide w) (: -55340232221128654848 i128)) (= (.after w) 7)
                (= (.after WIDE-STATIC) 9) (= PRODUCT (: 20000000000000000000 i128))))
    (check "u128 sum payload" (= (amount-value (Big :n LIMIT)) LIMIT))))


;; ---------------------------------------------------------------------------
;; 9. Operators: unary minus and variadic folding

(defn square [(x i64)] (-> i64) (* x x))

(defn section-operators [] (-> void)
  (let [x 5
        f 2.5
        zero 0.0
        got [(- x) (- (square 3)) (+ 1 2 3 4) (* 2 3 4) (- 20 5 3) (cast i64 (- (: 7 i8)))]
        want [-5 -9 10 24 12 -7]]
    (println "operators: {} {} {} {} {} {} {} {} {}"
             (get got 0) (get got 1) (- f) (/ 1.0 (- zero)) (get got 2) (get got 3) (get got 4) (+ 1.5 2.5 3.0) (get got 5))
    (check-all "operators" got want)
    (check "unary minus on floats" (and (= (- f) -2.5) (< (/ 1.0 (- zero)) 0.0)))))

;; ---------------------------------------------------------------------------
;; 10. Floats: arithmetic, conversion and IEEE edges

(defstruct Sample [(at f64) (gain f32)])
(derive Eq Sample)

(defn nan [] (-> f64) (/ 0.0 0.0))
(defn inf [] (-> f64) (/ 1.0 0.0))

(defn milli [(x f64)] (-> i64) (cast i64 (* x 1000.0)))

(defn section-floats [] (-> void)
  (let [got [(milli (+ 1.5 2.25)) (milli (- 1.0 3.5)) (milli (* -2.5 4.0)) (milli (/ 7.0 2.0))
             (milli (p/frem 7.5 2.0)) (milli (p/frem -7.5 2.0))
             (cast i64 (* (+ (: 0.1 f32) (: 0.2 f32)) (: 10000000.0 f32)))
             (milli (+ (cast f64 -7) 0.25))]
        want [3750 -2500 -10000 3500 1500 -1500 3000000 -6750]]
    (print "floats:")
    (for x got (print " {}" x))
    (println "")
    (check-all "float arithmetic" got want))
  (let [n (nan)
        edges [(= 1.5 1.5) (not (= n n)) (!= n n) (!= n 1.0) (= -0.0 0.0)
               (not (< n 1.0)) (not (>= n 1.0)) (< -0.5 0.5) (<= 2.0 2.0) (not (> 2.0 2.0))
               (= (: 2.5 f32) (: 2.5 f32)) (not (= (: 2.5 f32) (: 2.25 f32)))
               (> (inf) 1.0e308) (= (inf) (+ (inf) 1.0)) (< (- (inf)) -1.0e308)
               (= (Sample :at 1.0 :gain (: 0.5 f32)) (Sample :at 1.0 :gain (: 0.5 f32)))
               (not (= (Sample :at n :gain (: 0.5 f32)) (Sample :at n :gain (: 0.5 f32))))
               (= (case 2.0 1.0 10 2.0 20 30) 20)]
        (mut holds) 0]
    (for e edges (when e (set! holds (+ holds 1))))
    (println "float edges: {} of {} hold; {} {} {} {}" holds (len edges) n (inf) (- (inf)) -0.0)
    (check-eq "IEEE comparisons" holds (len edges))))

;; ---------------------------------------------------------------------------
;; 11. coil.math

(defn section-math [] (-> void)
  (let [angle (math/atan2 1.0 -1.0)
        side (: 2.0 f32)]
    (println "math: {:.6} {} {} {} {} {} {} {}"
             (math/sqrt side) (math/floor -2.5) (math/ceil -2.5) (math/trunc -2.5) (math/round -2.5)
             (math/round-even 2.5) (math/round-even 3.5) (/ angle math/pi))
    (println "math: {} {} {} {} {:.6} {:.6} {:.6} {:.6} {:.6}"
             (math/min 3.0 -1.0) (math/max (: 3.0 f32) (: 4.0 f32)) (math/mul-add 2.0 3.0 1.0) (math/copysign 3.0 -0.0)
             (math/exp 1.0) (math/log math/e) (math/log2 1024.0) (math/pow 2.0 0.5) (math/sin (/ math/pi 6.0)))
    (check "sqrt f32" (< (math/abs (- (math/sqrt side) (: 1.4142135 f32))) (: 0.000001 f32)))
    (check "floor/ceil/trunc" (and (= (math/floor -2.5) -3.0) (= (math/ceil -2.5) -2.0) (= (math/trunc -2.5) -2.0)))
    (check "round ties away, round-even ties to even"
           (and (= (math/round -2.5) -3.0) (= (math/round-even 2.5) 2.0) (= (math/round-even 3.5) 4.0)))
    (check "atan2 quadrant" (= (/ angle math/pi) 0.75))
    (check "min/max/mul-add/copysign"
           (and (= (math/min 3.0 -1.0) -1.0) (= (math/mul-add 2.0 3.0 1.0) 7.0) (= (math/copysign 3.0 -0.0) -3.0)))
    (check "exp/log" (and (< (math/abs (- (math/log math/e) 1.0)) 1.0e-12) (= (math/log2 1024.0) 10.0)))))

;; ---------------------------------------------------------------------------
;; 12. Formatting numbers

(defn section-formatting [] (-> void)
  (println "[{:.2}] [{:8.3}] [{:<8.1}] [{:^9.2}] [{:08.3}] [{:+.1}]" 3.14159 2.5 -1.25 0.5 -3.5 2.0)
  (println "[{:5}] [{:<5}] [{:^5}] [{:05}] [{:+}] [{:*>6}]" 42 42 42 -42 7 9)
  (println "[{:x}] [{:#x}] [{:08x}] [{:#010x}] [{:x}]" 255 255 255 255 (: 18446744073709551615 u64))
  (println "[{}] [{}] [{:.0}] [{:.0}] [{:.1}] [{}] [{}]" -0.0 1.5 2.5 3.5 0.25 1.5e-7 (: 0.1 f32))
  (println "[{:?}] [{:?}] [{:?}] [{:?}] [{:?}]" 0.1 1.5e-7 (+ 0.1 0.2) 1.0e300 (: 0.1 f32))
  (println "[{}] [{}] [{}] [{}]" (: -128 i8) (: 255 u8) (: 18446744073709551615 u64) (: -9223372036854775808 i64)))

;; ---------------------------------------------------------------------------
;; 13. SIMD lanes

(defn next-random [(state (mut u64))] (-> u64)
  ;; an LCG: the arithmetic wraps on purpose
  (set! state (p/iadd (p/imul state 6364136223846793005) 1442695040888963407))
  (>> state 33))

;; vcompress-store and vexpand-load against a scalar reference, at one density.
(defn compress-u8x64 [(seed u64) (density u64)] (-> i64)
  (let [(mut state) seed
        (mut values) (: (zeroed (array u8 64)) (array u8 64))
        (mut flags) (: (zeroed (array u8 64)) (array u8 64))
        (mut packed) (: (zeroed (array u8 66)) (array u8 66))
        (mut fill) (: (zeroed (array u8 64)) (array u8 64))
        (mut result) (: (zeroed (array u8 64)) (array u8 64))
        (mut active-count) 0
        (mut errors) 0]
    (for i (range 0 64)
      (set! (mut values) i (p/cast u8 (+ (* i 3) 1)))
      (set! (mut fill) i (: 77 u8))
      (let [on (< (% (next-random (mut state)) 100) density)]
        (set! (mut flags) i (if on (: 1 u8) (: 0 u8)))
        (when on (set! active-count (+ active-count 1)))))
    (for i (range 0 66) (set! (mut packed) i (: 77 u8)))
    (let [active (v/v= (v/vloadu [u8 64] (cast (ptr u8) (mut flags))) (v/vsplat [u8 64] (: 1 u8)))
          written (v/vcompress-store (cast (ptr u8) (mut packed)) active (v/vloadu [u8 64] (cast (ptr u8) (mut values))))
          (mut k) 0]
      (when (!= written active-count) (set! errors (+ errors 1)))
      (for i (range 0 64)
        (when (= (get flags i) (: 1 u8))
          (when (!= (get packed k) (get values i)) (set! errors (+ errors 1)))
          (set! k (+ k 1))))
      (for i (range written 66)
        (when (!= (get packed i) (: 77 u8)) (set! errors (+ errors 1))))
      (let [expanded (v/vexpand-load (cast (ptr u8) (mut packed)) active (v/vloadu [u8 64] (cast (ptr u8) (mut fill))))]
        (v/vstoreu (cast (ptr u8) (mut result)) expanded)
        (for i (range 0 64)
          (let [want (if (= (get flags i) (: 1 u8)) (get values i) (: 77 u8))]
            (when (!= (get result i) want) (set! errors (+ errors 1))))))
      (+ (* errors 1000) written))))

(defn section-simd [] (-> void)
  (let [a (v/viota [i32 8])
        b (v/vsplat [i32 8] (: 10 i32))
        sum (v/vadd a b)
        product (v/vmul a a)
        small (v/v< a (v/vsplat [i32 8] (: 3 i32)))
        chosen (v/vselect small product sum)
        floats (v/vec4f 1.0 2.0 3.0 4.0)
        dot (v/dot4f floats floats)
        bytes (v/vsplat [u8 16] (: 250 u8))
        saturated (v/vadd-saturating bytes (v/vsplat [u8 16] (: 10 u8)))
        wrapped (v/vadd bytes (v/vsplat [u8 16] (: 10 u8)))
        shuffled (v/vshuffle a a (v/viota [i32 4]))
        compress [(compress-u8x64 1 0) (compress-u8x64 2 3) (compress-u8x64 3 50) (compress-u8x64 4 100)]]
    (println "simd: sum {} product {} mask {} select {} {} dot {} sat {} wrap {} shuffle {} lanes {}"
             (v/vreduce-add sum) (v/vreduce-add product) (v/mask->bits small)
             (v/vextract chosen 1) (v/vextract chosen 5) dot
             (v/vextract saturated 0) (v/vextract wrapped 0) (v/vreduce-add shuffled) (v/vlanes a))
    (println "simd: compress {} {} {} {}" (get compress 0) (get compress 1) (get compress 2) (get compress 3))
    (check-eq "vreduce-add" (cast i64 (v/vreduce-add sum)) 108)
    (check-eq "vmul" (cast i64 (v/vreduce-add product)) 140)
    (check-eq "mask->bits" (cast i64 (v/mask->bits small)) 7)
    (check-eq "vselect" (+ (cast i64 (v/vextract chosen 1)) (cast i64 (v/vextract chosen 5))) 16)
    (check "dot4f" (= dot (: 30.0 f32)))
    (check "saturating vs wrapping" (and (= (v/vextract saturated 0) (: 255 u8)) (= (v/vextract wrapped 0) (: 4 u8))))
    (check-eq "vshuffle" (cast i64 (v/vreduce-add shuffled)) 6)
    (check-eq "empty compress" (get compress 0) 0)
    (check-eq "full compress" (get compress 3) 64)
    (check "compress and expand agree with the scalar reference"
           (and (< (get compress 1) 1000) (< (get compress 2) 1000)))))

;; ---------------------------------------------------------------------------

(defn main [] (-> i64)
  (section-wrapping)
  (section-division)
  (section-shifts)
  (section-bits)
  (section-comparisons)
  (section-overflow)
  (section-casts)
  (section-int128)
  (section-operators)
  (section-floats)
  (section-math)
  (section-formatting)
  (section-simd)
  (println "numerics: {} failures" (get failures))
  (get failures))
