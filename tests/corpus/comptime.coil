;;; The compile-time half of Coil, end to end: const and comptime evaluation and
;;; the values they read back, compile-time tables, macros (quasiquote, splicing,
;;; variadic templates, hygiene, staging), reflection, custom and built-in
;;; derives, `(meta …)` generators, the standard library at compile time, Code
;;; as a collection, and a checker over the whole program.
;;;
;;; Every section prints what it computed and checks it; main returns the number
;;; of failed checks. The corpus runs it on arm64, LLVM, the interpreter and
;;; with the interpreted metaprogram engine (COIL_META_INTERP=1), and all four
;;; must print the same bytes.
(module corpus.comptime)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [malloc-allocator arena-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.hashmap" :use [HashMap])
(import "coil.var" :use [Var var-static])
(import "coil.meta" :as meta :use [user-forms])
(import "coil.debug-allocator" :as dbg)

;; ---------------------------------------------------------------------------
;; Self-checking

(def failures (var-static i64 0))

(defn check [(what (slice u8)) (ok bool)] (-> void)
  (unless ok
    (set failures (+ (get failures) 1))
    (println "FAILED: {}" what)))

(defn check-eq [(what (slice u8)) (got i64) (want i64)] (-> void)
  (unless (= got want)
    (set failures (+ (get failures) 1))
    (println "FAILED: {}: got {}, want {}" what got want)))

;; ---------------------------------------------------------------------------
;; 1. const and comptime: evaluated once, during compilation

(defn fib [(n i64)] (-> i64)
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(defn six [] (-> i64) 6)

(defstruct Layout [(a i64) (b bool) (c i64)])

(const FIB-20 (fib 20))
(const OFF-C (comptime (primitive/offsetof Layout c)))
(const NESTED (comptime (comptime (+ 40 2))))
(const SIZE-SUM (+ (sizeof i64) (sizeof i32) (sizeof u8)))
(def seven-sixes (comptime (* 7 (six))))

; A generic function that borrows its argument, called from a constant: the
; metaprogram engine checks the initializer again against the checked program,
; whose functions' borrowed parameters are already lowered to pointers. An array
; literal lent to a `(ref C)` borrows as a slice.
(defn borrowed-len [(C Len)] [(xs (ref C))] (-> i64) (len xs))
(const BORROWED-LEN (borrowed-len "four"))
(const LITERAL-EMPTY (empty? [1 2 3]))

(defn section-const [] (-> void)
  (println "const: fib20={} off-c={} nested={} sizes={} def={} inline={}"
           FIB-20 OFF-C NESTED SIZE-SUM seven-sixes (comptime (* 6 7)))
  (check-eq "fib 20" FIB-20 6765)
  (check-eq "offsetof" OFF-C 16)
  (check-eq "nested comptime" NESTED 42)
  (check-eq "sizeof sum" SIZE-SUM 13)
  (check-eq "comptime in def" seven-sixes 42)
  (println "const: borrowed-len={} literal-empty={} runtime={}"
           BORROWED-LEN LITERAL-EMPTY (borrowed-len [4 5]))
  (check-eq "generic (ref C) in a const" BORROWED-LEN 4)
  (check "empty? of an array literal" (not LITERAL-EMPTY))
  (check-eq "array literal lent to (ref C)" (borrowed-len [4 5]) 2))

;; ---------------------------------------------------------------------------
;; 2. Reading back compile-time values of every shape

(defsum Reading (Yes [(v i64) (w i32)]) (No) (Frac [(f f64)]))
(defstruct Inner [(a i32) (b i64)])
(defstruct Outer [(tag i64) (inner Inner) (cells (array i32 3))])
(defstruct Reg :layout explicit :size 16 :align 8 [(id i32 :at 0) (data i64 :at 8)])
(defstruct Packed :layout packed [(a u8) (b i64)])

(defn mk-yes [] (-> Reading) (Yes (sizeof i64) 7))
(defn mk-no [] (-> Reading) (if (> (sizeof i64) 0) (No) (Yes 0 0)))
(defn mk-frac [] (-> Reading) (Frac (/ (cast f64 (sizeof i64)) 4.0)))
(defn mk-f32 [] (-> f32) (/ (cast f32 (sizeof i64)) 4.0))
(defn mk-outer [] (-> Outer)
  (Outer :tag (sizeof i64) :inner (Inner :a 11 :b 22) :cells [1 2 3]))
(defn mk-reg [] (-> Reg) (Reg :id (cast i32 (sizeof i64)) :data 99))
(defn mk-packed [] (-> Packed) (Packed :a (cast u8 (sizeof i64)) :b 1234))
(defn mk-str [] (-> (slice u8)) (if (> (sizeof i64) 0) "eight" "other"))
(defn mk-tuple [] (-> (array i64 4))
  (let [(mut xs) [0 0 0 0]]
    (for i (range 0 4) (set! (mut xs) i (* i i)))
    xs))

(defn reading-text [(r Reading)] (-> i64)
  (match r
    (Yes [v w] (+ (* v 100) (cast i64 w)))
    (No [] -1)
    (Frac [f] (cast i64 (* f 10.0)))))

(defn section-readback [] (-> void)
  (let [yes (comptime (mk-yes))
        no (comptime (mk-no))
        frac (comptime (mk-frac))
        half (comptime (mk-f32))
        outer (comptime (mk-outer))
        reg (comptime (mk-reg))
        packed (comptime (mk-packed))
        squares (comptime (mk-tuple))]
    (println "readback: yes={} no={} frac={} f32x10={}"
             (reading-text yes) (reading-text no) (reading-text frac) (cast i64 (* half 10.0)))
    (println "readback: outer tag={} a={} b={} cells={},{},{}"
             (.tag outer) (.a (.inner outer)) (.b (.inner outer))
             (get (.cells outer) 0) (get (.cells outer) 1) (get (.cells outer) 2))
    (println "readback: reg={}/{} packed={}/{} str={} squares={}"
             (.id reg) (.data reg) (.a packed) (.b packed) (comptime (mk-str)) (get squares 3))
    (check-eq "sum with fields" (reading-text yes) 807)
    (check-eq "nullary variant" (reading-text no) -1)
    (check-eq "float payload" (reading-text frac) 20)
    (check-eq "f32" (cast i64 (* half 10.0)) 20)
    (check-eq "nested struct" (+ (.tag outer) (cast i64 (.a (.inner outer))) (.b (.inner outer))) 41)
    (check-eq "array field" (cast i64 (get (.cells outer) 2)) 3)
    (check-eq "explicit layout" (+ (cast i64 (.id reg)) (.data reg)) 107)
    (check-eq "packed layout" (+ (cast i64 (.a packed)) (.b packed)) 1242)
    (check "string" (= (comptime (mk-str)) "eight"))
    (check-eq "array" (get squares 3) 9)))

;; ---------------------------------------------------------------------------
;; 3. Static tables built at compile time

(defsum Ev (Coin) (Push) (Wait [(ms i64)]))
(defstruct Span [(sec i64) (nsec i64)])
(defstruct Op [(n i64) (f (fnptr c [i64] i64)) (tbl (array i64 3))])
(defsum Greeting (Plain [(text (slice u8))]) (Tagged [(tag Keyword) (text (slice u8))]))

(defn twice [(x i64)] (-> i64) (* 2 x))
(defn square [(x i64)] (-> i64) (* x x))
(defn inc [(x i64)] (-> i64) (+ x 1))

(def WORKING-SET [1 2 1 3])
(def EVENTS [(Coin) (Push) (Wait :ms 7) (Coin)])
(def DOUBLED [(twice 1) (twice 2) (twice 3)])
(def SPANS [(Span :nsec 9 :sec 1) (Span :sec 2 :nsec 8)])
(def VIEW (: [10 20 30] (slice i64)))
(def OPS [(fnptr-of twice) (fnptr-of inc)])
(def OP (Op :tbl [7 8 9] :f (fnptr-of square) :n (+ 1 2)))
(def GREETING "hello")
(def C-GREETING c"hey")
(def MODE :fast)
(def TAGGED (Tagged :tag :loud :text "hi"))
(def counter (var-static i64 (* 5 2)))
(const PAIRS [(twice 1) (twice 2)])
(const ORIGIN (Span :sec 5 :nsec 0))

(defn events [] (-> (slice Ev)) EVENTS)

(defn ev-code [(e Ev)] (-> i64)
  (match e (Coin [] 1) (Push [] 2) (Wait [ms] ms)))

(defn total [(xs (slice i64))] (-> i64)
  (fold (fn [acc x] (+ acc x)) 0 xs))

(defn keyword-name [(k Keyword)] (-> (slice u8))
  (match k (KeywordValue [name] name)))

(defn section-tables [] (-> void)
  (let [(mut codes) 0]
    (for e (events) (set! codes (+ (* codes 10) (ev-code e))))
    (set counter (+ (get counter) 1))
    (println "tables: events={} set={} doubled={} spans={}/{} view={}"
             codes (total WORKING-SET) (total DOUBLED) (.sec (get SPANS 1)) (.nsec (get SPANS 0)) (total VIEW))
    (println "tables: ops={},{} op={}/{}/{} counter={} pairs={} origin={}"
             (call-ptr (get OPS 0) 5) (call-ptr (get OPS 1) 5) (.n OP) (call-ptr (.f OP) 4) (total (.tbl OP))
             (get counter) (get PAIRS 1) (.sec ORIGIN))
    (println "tables: {} {} {} {}" GREETING (len GREETING) (keyword-name MODE) (cast i64 (load C-GREETING)))
    (match TAGGED
      (Tagged [tag text] (println "tables: tagged {} {}" (keyword-name tag) text))
      (Plain [text] (println "tables: plain {}" text)))
    (check-eq "event table" codes 1271)
    (check-eq "int table" (total WORKING-SET) 7)
    (check-eq "computed table" (total DOUBLED) 12)
    (check-eq "struct table" (+ (.sec (get SPANS 1)) (.nsec (get SPANS 0))) 11)
    (check-eq "fnptr table" (+ (call-ptr (get OPS 0) 5) (call-ptr (get OPS 1) 5)) 16)
    (check-eq "struct with fnptr" (+ (.n OP) (call-ptr (.f OP) 4) (total (.tbl OP))) 43)
    (check-eq "mutable global" (get counter) 11)
    (check "keyword def" (= MODE :fast))
    (check-eq "c string def" (cast i64 (load C-GREETING)) 104)))

;; ---------------------------------------------------------------------------
;; 4. Macros

(defn swap! [(a Code) (b Code)] (-> Code)
  `(let [tmp ~a]
     (set! ~a ~b)
     (set! ~b tmp)))

(defn repeat [(n Code) & (body Code)] (-> Code)
  `(for _ (range 0 ~n) ~@body))

(defn triple-sum [(x Code)] (-> Code) `(+ ~x ~x ~x))
(defn spread [(x Code)] (-> Code) `(- ~x 1 2 3))
(defn negate [(x Code)] (-> Code) `(- ~x))
(defn twice-code [(x Code)] (-> Code) `(+ ~x ~x))
(defn pick-second [(a Code) (b Code)] (-> Code) b)

(defn sum-of [& (xs Code)] (-> Code)
  (let [(mut terms) (primitive/code-list-new)]
    (for x xs (push! (mut terms) x))
    `(+ ~@terms)))

(defn product [(x Code) (y Code)] (-> Code)
  (let [(mut call) (primitive/code-list-new)]
    (push! (mut call) `*)
    (push! (mut call) x)
    (push! (mut call) y)
    `(if true ~call 0)))

(defn name-of [(k Code)] (-> Code)
  `~(primitive/code-str k))

(defn rebuilt [(form Code)] (-> Code)
  (let [(mut kids) (primitive/code-list-new)]
    (for child form (push! (mut kids) child))
    (primitive/code-list-like form `(~@kids))))

(defn vector-shaped? [(form Code)] (-> Code)
  (if (primitive/code-vector? (rebuilt form)) `true `false))

(defn count-rebuilt [(form Code)] (-> Code)
  `~(len (rebuilt form)))

;; Inside a metaprogram, a call to a Code function whose argument is a macro use
;; (`let`, `block`, a macro whose own arguments do not parse) is a function call:
;; the use expands as an expression, giving the function its Code value. A macro
;; whose argument holds another macro use still receives that argument as written.
(defn head-is-list [(form Code)] (-> Code)
  (if (primitive/code-list? (primitive/code-nth form 0)) `1 `0))
(defn three-items [(form Code)] (-> Code)
  (if (= (primitive/code-count form) 3) `1 `0))
(defn quoted-thrice [(c Code)] (-> Code) `(quote (~c ~c ~c)))
(defn as-written [(c Code)] (-> Code) `(quote ~c))
(defn negated [(c Code)] (-> Code) `(if ~c false true))

(defn let-argument [(x Code)] (-> Code) (head-is-list (let [y `((a) b)] y)))
(defn block-argument [(x Code)] (-> Code) (head-is-list (block :b `((a) b))))
(defn unquoted-let-argument [(x Code)] (-> Code)
  `(+ 0 ~(head-is-list (let [y `((a) b)] y))))
(defn unparsed-argument [(x Code)] (-> Code) (three-items (quoted-thrice (let* q))))
(defn written-macro-use [(x Code)] (-> Code)
  `~(primitive/code-count (as-written (negated true))))
(defn written-unparsed-use [(x Code)] (-> Code)
  `~(primitive/code-count (as-written (quoted-thrice (let* q)))))

;; Macros in const initializers expand before the value folds.
(const DIRECT (twice-code 5))
(const NESTED-MACRO (twice-code (cond true 3 :else 4)))
(const PICKED (pick-second 1 2))
(static-assert (= DIRECT 10) "a macro-built const folds to a literal")

;; A macro's expansion-time closure: an inherent method from another module,
;; a Var holding a function pointer, and a helper reached only through a
;; constructor argument.
(defstruct Pair [(left i64) (right i64)])
(defn only-in-constructor [(x i64)] (-> i64) (+ x 100))

(defn staged [(form Code)] (-> Code)
  (let [n (primitive/code-int form)
        cell (Var::new (malloc-allocator) n)
        slot (Var::new (malloc-allocator) (fnptr-of square))
        pair (Pair :left (only-in-constructor n) :right 0)]
    (set cell (+ (get cell) 1))
    `~(+ (slot (get cell)) (.left pair))))

;; Code read from a buffer the macro then frees: the Code owns its text.
(defn read-then-free [] (-> Code)
  (let [(mut text) (ArrayList::new [u8] (malloc-allocator))]
    (for b "(+ (use-k) 0)" (push! (mut text) b))
    (let [forms (primitive/code-read (slice text) `(reader-config))]
      (free! (mut text))
      forms)))

;; A macro that reads a declaration a (meta …) generator makes.
(defn gen-k [] (-> Code) `(do (const ~(primitive/syntax->datum `K) 5)))
(meta (gen-k))
(defn use-k [] (-> i64) (+ K 37))
(defn stamp [(x Code)] (-> Code) (if (= (use-k) 42) `42 `0))

(defn section-macros [] (-> void)
  (let [(mut tmp) 1
        (mut other) 2
        (mut reps) 0]
    (swap! tmp other)
    (repeat 3 (set! reps (+ reps 1)))
    (println "macros: swap {} {} repeat {}" tmp other reps)
    (check "hygienic swap" (and (= tmp 2) (= other 1)))
    (check-eq "repeat body" reps 3))
  (println "macros: variadic {} {} {} spliced {} {} name {}"
           (triple-sum 2) (spread 10) (negate 5) (sum-of 40 2) (product 6 7) (name-of :initial))
  (check-eq "variadic template +" (triple-sum 2) 6)
  (check-eq "variadic template -" (spread 10) 4)
  (check-eq "unary template" (negate 5) -5)
  (check-eq "spliced builder" (sum-of 1 2 3 4) 10)
  (check-eq "builder unquote" (product 6 7) 42)
  (check "keyword text" (= (name-of :initial) "initial"))
  (println "macros: vector {} list {} count {}"
           (vector-shaped? [1 2 3]) (vector-shaped? (1 2 3)) (count-rebuilt [4 5 6]))
  (check "list-like keeps a vector" (vector-shaped? [1 2 3]))
  (check "list-like keeps a list" (not (vector-shaped? (1 2 3))))
  (println "macros: const {} {} {} staged {} meta-decl {} {}"
           DIRECT NESTED-MACRO PICKED (staged 4) (stamp y) (use-k))
  (check-eq "macro const" (+ DIRECT NESTED-MACRO PICKED) 18)
  (check-eq "staged closure" (staged 4) 129)
  (check-eq "meta-generated declaration" (stamp y) 42)
  (println "macros: Code arguments let {} block {} unquoted {} unparsed {} written {} {}"
           (let-argument _) (block-argument _) (unquoted-let-argument _) (unparsed-argument _)
           (written-macro-use _) (written-unparsed-use _))
  (check-eq "macro-use argument to a Code function"
            (+ (let-argument _) (block-argument _) (unquoted-let-argument _) (unparsed-argument _))
            4)
  (check-eq "a macro receives its arguments as written"
            (+ (written-macro-use _) (written-unparsed-use _))
            4)
  (println "macros: read from a freed buffer {}" (read-then-free))
  (check-eq "code-read owns what it read" (read-then-free) 42))

;; ---------------------------------------------------------------------------
;; 5. Declarations a macro produces are ordinary declarations

(defn mk-struct [(name Code)] (-> Code)
  `(defstruct ~name [(x i64)]))

(defn mk-sum [(name Code) (empty Code) (full Code)] (-> Code)
  `(defsum ~name (~empty) (~full [(x i64)])))

(defn defsum-debug [(name Code) & (variants Code)] (-> Code)
  `(do (defsum ~name ~@variants)
       (derive Debug Eq ~name)))

;; Named before the macro call that declares it.
(defstruct Holder [(a MadeStruct) (s (ptr MadeSum))])
(mk-struct MadeStruct)
(mk-sum MadeSum Vacant Occupied)
(defsum-debug Shape (Circle [(r i64)]) (Square [(side i64)]))
(defstruct Labelled [(label i64) (shape Shape)])
(derive Debug Eq Labelled)

(defn section-generated-decls [] (-> void)
  (let [(mut slot) (Occupied :x 5)
        h (Holder :a (MadeStruct :x 3) :s (cast (ptr MadeSum) (mut slot)))
        l (Labelled :label 1 :shape (Square 4))
        occupied (match (load (.s h)) (Occupied [x] x) (Vacant [] -1))]
    (println "generated: {} {} {:?} {}" (.x (.a h)) occupied l (= l (Labelled :label 1 :shape (Square 4))))
    (check-eq "macro struct field" (.x (.a h)) 3)
    (check-eq "macro sum field" occupied 5)
    (check "derive on a macro-declared field" (= l (Labelled :label 1 :shape (Square 4))))
    (check "derived Eq tells variants apart" (!= l (Labelled :label 1 :shape (Circle 4))))))

;; ---------------------------------------------------------------------------
;; 6. Code is a collection: iterate it, query it, compare it

(defn symbol? [(c Code)] (-> bool) (primitive/code-sym? c))

(defn count-symbols [& (forms Code)] (-> Code)
  (let [n (count (filter (fn [c] (primitive/code-sym? c)) forms))] `~n))

(defn all-symbols? [& (forms Code)] (-> Code)
  (if (all? (fn [c] (primitive/code-sym? c)) forms) `true `false))

(defn any-symbol? [& (forms Code)] (-> Code)
  (if (any? (fnptr-of symbol?) forms) `true `false))

(defn sum-ints [& (forms Code)] (-> Code)
  `~(fold (fn [acc c] (if (primitive/code-int? c) (+ acc (primitive/code-int c)) acc)) 0 forms))

(defn second-form [(e Code)] (-> Code) (get e 1))

(defn second-count [(e Code)] (-> i64) (len (second-form e)))

(defn describe-second [(e Code)] (-> Code)
  (if (primitive/code-list? (second-form e)) `~(second-count e) `-1))

(defn destructured [(form Code)] (-> Code)
  (let [[head second & rest] form]
    `~(+ (len rest) (if (= head `pick) 100 0) (if (primitive/code-int? second) (primitive/code-int second) 0))))

(defn code-equality [] (-> Code)
  (if (= `same `same)
      (if (= `same `different) `1 `42)
      `2))

(defn section-code-collections [] (-> void)
  (println "code: symbols {} all {} {} any {} {} ints {}"
           (count-symbols a 1 b 2 c) (all-symbols? a b) (all-symbols? a 1)
           (any-symbol? 1 2 x) (any-symbol? 1 2) (sum-ints 1 x 2 y 39))
  (println "code: second {} {} destructure {} eq {}"
           (describe-second (a (b c d))) (describe-second (a b)) (destructured (pick 7 x y z)) (code-equality))
  (check-eq "count over Code" (count-symbols a 1 b 2 c) 3)
  (check "all? over Code" (and (all-symbols? a b) (not (all-symbols? a 1))))
  (check "any? with a fnptr" (and (any-symbol? 1 2 x) (not (any-symbol? 1 2))))
  (check-eq "fold over Code" (sum-ints 1 x 2 y 39) 42)
  (check-eq "Code helper returning i64" (describe-second (a (b c d))) 3)
  (check-eq "destructuring Code" (destructured (pick 7 x y z)) 110)
  (check-eq "Code equality" (code-equality) 42))

;; ---------------------------------------------------------------------------
;; 7. Reflection and a custom derive with struct and sum arms

(deftrait Shape-Of [Self]
  (shape-of [(x Self)] (-> (slice u8)))
  (part-count [(x Self)] (-> i64)))

(defn shape-struct [(T Code)] (-> Code)
  (let [(mut names) (primitive/code-list-new)
        n (primitive/code-field-count T)]
    (for i (range 0 n)
      (push! (mut names) `~(primitive/code-str (primitive/code-field-name T i))))
    `(impl Shape-Of ~T
       (shape-of [(x ~T)] (-> (slice u8)) ~(primitive/code-str T))
       (part-count [(x ~T)] (-> i64) ~n))))

(defn shape-sum [(T Code)] (-> Code)
  (let [(mut arms) (primitive/code-list-new)
        n (primitive/code-variant-count T)]
    (for vi (range 0 n)
      (let [(mut holes) (primitive/code-list-new)]
        (for _ (range 0 (primitive/code-variant-fields T vi)) (push! (mut holes) `_))
        (push! (mut arms)
               `(~(primitive/code-variant-qname T vi) [~@holes]
                  ~(primitive/code-str (primitive/code-variant-name T vi))))))
    `(impl Shape-Of ~T
       (shape-of [(x ~T)] (-> (slice u8)) (match x ~@arms))
       (part-count [(x ~T)] (-> i64) ~n))))

(defderive Shape-Of
  (struct [T] (shape-struct T))
  (sum [T] (shape-sum T)))

(defstruct Point3 [(x i64) (y i64) (z i64)])
(derive Shape-Of Debug Eq Hash Clone Point3)

(defsum Token (Number [(value i64)]) (Word [(text (slice u8))]) (Range [(lo i64) (hi i64)]) (End))
(derive Shape-Of Debug Eq Hash Token)

(defsum Blob (Blob-Float [(w f64)]) (Blob-Empty))
(derive Debug Eq Blob)

(deftrait FieldNames [Self] (field-name [(x Self) (i i64)] (-> (slice u8))))

(defderive FieldNames
  (struct [T]
    (let [(mut arms) (primitive/code-list-new)]
      (for i (range 0 (primitive/code-field-count T))
        (push! (mut arms) `~i)
        (push! (mut arms) `~(primitive/code-str (primitive/code-field-name T i))))
      `(impl FieldNames ~T
         (field-name [(x ~T) (i i64)] (-> (slice u8))
           (case i ~@arms "?"))))))

(derive FieldNames Point3)

(defn section-reflection [] (-> void)
  (let [p (Point3 :x 1 :y 2 :z 3)
        q (clone p)
        tokens [(Number 4) (Word "hi") (Range 1 9) (End)]]
    (println "reflect: {} parts={} fields={},{},{},{}"
             (shape-of p) (part-count p) (field-name p 0) (field-name p 1) (field-name p 2) (field-name p 7))
    (for t tokens (print "{}/{} " (shape-of t) (part-count t)))
    (println "")
    (println "derive: {:?} {:?} {} {} {}"
             q (get tokens 2) (= p q) (= (hash p) (hash q)) (= (Word "hi") (Word "hi")))
    (println "derive: {} {} {} {}"
             (= (Number 4) (Number 5)) (= (End) (End)) (= (Blob-Float 1.5) (Blob-Float 1.5)) (= (Blob-Empty) (Blob-Float 0.0)))
    (check "struct derive arm" (= (shape-of p) "Point3"))
    (check-eq "field count" (part-count p) 3)
    (check "field names" (and (= (field-name p 2) "z") (= (field-name p 7) "?")))
    (check "sum derive arm" (= (shape-of (Range 1 9)) "Range"))
    (check-eq "variant count" (part-count (End)) 4)
    (check "derived Clone + Eq" (= p q))
    (check "derived Hash" (= (hash p) (hash q)))
    (check "derived sum Eq" (and (= (Word "hi") (Word "hi")) (!= (Number 4) (Number 5)) (!= (End) (Number 0))))
    (check "derived sum Hash" (and (= (hash (Range 1 9)) (hash (Range 1 9))) (!= (hash (Range 1 9)) (hash (Range 9 1)))))
    (check "float payload Eq" (and (= (Blob-Float 1.5) (Blob-Float 1.5)) (!= (Blob-Empty) (Blob-Float 0.0))))))

;; ---------------------------------------------------------------------------
;; 8. Keywords are values

(defsum Mode (Fixed [(kind Keyword) (n i64)]))
(derive Debug Mode)

(defn speed [(mode Keyword)] (-> i64) (case mode :fast 3 :slow 1 0))

(defn pick-by [(which Keyword) (n i64)] (-> i64) (if (= which :double) (* n 2) n))

(defn nudge [(x i64) (dx i64)] (-> i64) (+ x dx))

(defn section-keywords [] (-> void)
  (let [turbo (match (Fixed :turbo 9) (Fixed [kind n] (if (= kind :turbo) n 0)))]
    (println "keywords: {} {} {} speeds {} {} {} pick {} named {} turbo {}"
             (= :fast :fast) (!= :fast :slow) (= (hash :a) (hash :a))
             (speed :slow) (speed :fast) (speed :other) (pick-by :double 21) (nudge :dx 2 :x 1) turbo)
    (check "keyword equality" (and (= :fast :fast) (!= :fast :slow)))
    (check-eq "case on keywords" (+ (speed :slow) (speed :fast) (speed :other)) 4)
    (check-eq "keyword as positional argument" (pick-by :double 21) 42)
    (check-eq "named call" (nudge :dx 2 :x 1) 3)
    (check-eq "keyword payload" turbo 9)
    (println "  printed: {} {:?} {}" :fast (Fixed :turbo 9) :a/b)))

;; ---------------------------------------------------------------------------
;; 9. A local is never replaced by a global of the same spelling

(const width 100)
(def height 200)

(defsum Wrapped (Wrap [(v i64)]))

(defn param-shadows-const [(width i64)] (-> i64) width)
(defn param-shadows-def [(height i64)] (-> i64) height)

(defn section-shadowing [] (-> void)
  (let [from-let (let [width 9] width)
        from-param (+ (param-shadows-const 3) (param-shadows-def 4))
        from-arm (match (Wrap 7) (Wrap [width] width))
        (mut from-for) 0
        _ (for height (range 3 4) (set! from-for height))
        from-destructure (let [[width height] [1 2]] (+ width height))
        from-anon (let [g (: (fn [width] (+ width 1)) (fnptr c [i64] i64))] (g 41))
        self-init (let [width (+ width 1)] width)]
    (println "shadow: let {} params {} arm {} for {} destructure {} anon {} self-init {} globals {} {}"
             from-let from-param from-arm from-for from-destructure from-anon self-init width height)
    (check-eq "let shadows a const" from-let 9)
    (check-eq "parameters shadow globals" from-param 7)
    (check-eq "match arm shadows a const" from-arm 7)
    (check-eq "for shadows a def" from-for 3)
    (check-eq "destructuring shadows" from-destructure 3)
    (check-eq "anonymous fn parameter" from-anon 42)
    (check-eq "initializer reads the outer name" self-init 101)
    (check-eq "globals intact" (+ width height) 300)))

;; ---------------------------------------------------------------------------
;; 10. The standard library at compile time: allocation and collections

(defn histogram-score [] (-> i64)
  (let [a (malloc-allocator)
        (mut xs) (ArrayList::new [i64] a)
        (mut seen) (HashMap::new-scalar [i64 i64] a)]
    (for x [3 1 4 1 5 9 2 6 5 3 5] (push! (mut xs) x))
    (for x xs
      (set! (mut seen) x (+ 1 (match (get seen x) (Some [c] c) (None [] 0)))))
    (let [distinct (len seen)
          fives (match (get seen 5) (Some [c] c) (None [] 0))
          sum (fold (fn [acc x] (+ acc x)) 0 xs)]
      (free! (mut xs))
      (free! (mut seen))
      (+ (* distinct 1000) (* fives 100) sum))))

(defn arena-total [] (-> i64)
  (let [arena (arena-allocator 4096)
        cells (alloc/box! arena (array i64 8) [1 2 3 4 5 6 7 8])
        (mut total) 0]
    (for x (load cells) (set! total (+ total x)))
    total))

(const HISTOGRAM (histogram-score))
(const ARENA-TOTAL (arena-total))
(const DOUBLES [(twice 21) (square 7)])

;; The process-wide debug allocator registers an exit handler on first use. The
;; handler a const's evaluation registers runs when the compiler unloads the code
;; that evaluated it, while that code is still there to run.
(defn debug-boxed [] (-> i64)
  (let [d (dbg/DebugAllocator::global)
        p (alloc/box! d i64 41)
        v (+ (load p) 1)]
    (alloc/destroy d p)
    v))

;; Division on a type parameter that only integers can be: a zero divisor is
;; caught at compile time, as for a division on i64.
(deftrait Whole [Self] (whole-zero [(x Self)] (-> Self)))
(impl Whole i64 (whole-zero [(x i64)] (-> i64) 0))
(impl Whole i32 (whole-zero [(x i32)] (-> i32) (: 0 i32)))
(defn exact-quotient [(T Whole)] [(n T) (d T)] (-> T) (primitive/idiv n d))

(const DEBUG-BOXED (debug-boxed))
(const QUOTIENT (exact-quotient 84 2))

(defn section-stdlib-at-compile-time [] (-> void)
  (println "stdlib-at-compile-time: histogram {} arena {} doubles {} {} runtime {}"
           HISTOGRAM ARENA-TOTAL (get DOUBLES 0) (get DOUBLES 1) (histogram-score))
  (check-eq "collections in a const" HISTOGRAM 7344)
  (check-eq "same code at run time" (histogram-score) HISTOGRAM)
  (check-eq "an arena in a const" ARENA-TOTAL 36)
  (check-eq "calls in a const array" (+ (get DOUBLES 0) (get DOUBLES 1)) 91)
  (println "  exit handlers {} generic division {}" DEBUG-BOXED QUOTIENT)
  (check-eq "a const that registers an exit handler" DEBUG-BOXED 42)
  (check-eq "division on a bounded type parameter" QUOTIENT 42))

;; ---------------------------------------------------------------------------
;; 11. A checker: the compiler's own answers about this program, checked at
;; build time (a wrong answer fails the build, so the corpus fails)

(defn leaf [(x i64)] (-> i64) (+ x 1))
(defalias aliased leaf)
(const BASE 4)
(const DERIVED (+ BASE 1))
(defn middle [(x i64)] (-> i64) (+ (aliased x) DERIVED))
(defn top [(x i64)] (-> i64) (twice-code (middle x)))
(defn ping [(x i64)] (-> i64) (if (= x 0) 0 (pong (- x 1))))
(defn pong [(x i64)] (-> i64) (if (= x 0) 0 (ping (- x 1))))

(defn names-contain? [(names Code) (name Code)] (-> bool)
  (let [(mut found) false]
    (for item names (when (= item name) (set! found true)))
    found))

(defn expect-edge [(ok bool) (what (slice u8))] (-> i64)
  (unless ok (primitive/error what))
  0)

(defn verify-program [(modules Code)] (-> Code)
  (expect-edge (names-contain? (meta/dependencies `corpus.comptime.middle) `corpus.comptime.leaf)
               "dependencies: missing a direct call edge")
  (expect-edge (names-contain? (meta/dependencies `corpus.comptime.middle) `corpus.comptime.aliased)
               "dependencies: missing alias provenance")
  (expect-edge (names-contain? (meta/dependencies `corpus.comptime.middle) `corpus.comptime.DERIVED)
               "dependencies: missing a folded constant")
  (expect-edge (names-contain? (meta/dependencies `corpus.comptime.top) `corpus.comptime.twice-code)
               "dependencies: missing macro provenance")
  (expect-edge (names-contain? (meta/dependent-closure `corpus.comptime.leaf) `corpus.comptime.top)
               "dependencies: missing a transitive dependent")
  (expect-edge (not (names-contain? (meta/dependents `corpus.comptime.leaf) `corpus.comptime.top))
               "dependencies: a direct query included a transitive dependent")
  (let [cycle (meta/dependent-closure `corpus.comptime.ping)]
    (expect-edge (names-contain? cycle `corpus.comptime.pong) "dependencies: missing a cycle edge")
    (expect-edge (not (names-contain? cycle `corpus.comptime.ping)) "dependencies: a closure included its root"))
  (expect-edge (= (meta/dependencies `corpus.comptime.no-such-definition) `:unresolved)
               "dependencies: an unknown name is not :unresolved")
  (expect-edge (> (len (user-forms modules)) 100) "user-forms: the program's own forms are missing")
  `0)

(checker verify-program)

(defn section-checker [] (-> void)
  (println "checker: top {} cycle {}" (top 1) (ping 5))
  (check-eq "checked program runs" (top 1) 14)
  (check-eq "mutual recursion" (ping 5) 0))

;; ---------------------------------------------------------------------------
;; 12. An array length names a constant, computed ones included

(const DIGEST-WORDS 4)
(const DIGEST-BYTES (* DIGEST-WORDS 8))
;; computed by running `fib`
(const RING-SLOTS (fib 6))

(defstruct Digest [(words (array u64 DIGEST-WORDS)) (bytes (array u8 DIGEST-BYTES))])

(defstruct Ring [(slots (array i32 RING-SLOTS)) (head u8)])

(defn ring-bytes [] (-> i64) (sizeof Ring))

;; needs Ring's layout, so it is computed after RING-SLOTS
(const RING-COPIES (/ 128 (ring-bytes)))

(defstruct Rings [(all (array Ring RING-COPIES))])

(defstruct Stamped [(const N i64)] [(v i64)])

(defn stamp-of [(const N i64)] [(t (Stamped N))] (-> i64) N)

(defn array-length [T (const N i64)] [(xs (array T N))] (-> i64) N)

(defn first-word [(words (array u64 DIGEST-WORDS))] (-> u64) (get words 0))

(defn section-constant-lengths [] (-> void)
  (let [d (zeroed Digest)
        scratch (zeroed (array u8 RING-SLOTS))
        stamped (: (Stamped :v 1) (Stamped (const RING-SLOTS)))]
    (println "lengths: digest {} ring {} copies {} rings {} local {} field {} stamp {} word {}"
             (sizeof Digest) (sizeof Ring) RING-COPIES (sizeof Rings)
             (array-length scratch) (array-length (.bytes d)) (stamp-of stamped)
             (first-word (.words d)))
    (check-eq "digest size" (sizeof Digest) 64)
    (check-eq "ring size" (sizeof Ring) 36)
    (check-eq "copies" RING-COPIES 3)
    (check-eq "rings size" (sizeof Rings) 108)
    (check-eq "local length" (array-length scratch) 8)
    (check-eq "field length" (array-length (.bytes d)) 32)
    (check-eq "type argument" (stamp-of stamped) 8)))

;; ---------------------------------------------------------------------------

(defn main [] (-> i64)
  (section-const)
  (section-readback)
  (section-tables)
  (section-macros)
  (section-generated-decls)
  (section-code-collections)
  (section-reflection)
  (section-keywords)
  (section-shadowing)
  (section-stdlib-at-compile-time)
  (section-checker)
  (section-constant-lengths)
  (println "comptime: {} failures" (get failures))
  (get failures))
