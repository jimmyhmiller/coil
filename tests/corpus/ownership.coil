(module corpus.ownership)
;; Ownership end to end: Drop and Clone, moves, the order drops run in on every
;; exit (fall-through, break, continue, return-from, labelled loops), the drop
;; glue of structs, sums and arrays, generic owners, overwrites, the escape
;; hatches (forget, take!, manually-drop), borrowing an owner through (ref T),
;; and defer/scope cleanups interleaved with drops.
;;
;; Every section records drops as decimal digits in one global trace, prints what
;; it computed, and checks it. main returns the number of failed checks.
(import "coil.primitive" :as primitive)
(import "coil.derive" :use *)
(import "coil.try" :use [try try!])

;; ---------------------------------------------------------------- harness

(defn failures [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn trace [] (-> (ptr i64)) (primitive/alloc-static i64))
(defn events [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn check [(name (slice u8)) (got i64) (want i64)] (-> void)
  (if (= got want)
      (println "  {} = {}" name got)
      (do (store! (failures) (+ (load (failures)) 1))
          (println "  FAIL {} = {}, want {}" name got want))))

(defn check-true [(name (slice u8)) (ok bool)] (-> void)
  (check name (if ok 1 0) 1))

(defn reset! [] (-> void)
  (store! (trace) 0)
  (store! (events) 0))

(defn record [(digit i64)] (-> void)
  (store! (trace) (+ (* (load (trace)) 10) digit))
  (store! (events) (+ (load (events)) 1)))

(defn traced [] (-> i64) (load (trace)))

(defn section [(title (slice u8))] (-> void)
  (println "== {}" title))

;; ---------------------------------------------------------------- owners

(defstruct Owner [(value i64)])

(impl Drop Owner
  (drop [(self (mut Owner))] (-> void)
    (record (.value self))))

(defstruct Leaf [(value i64)])

(impl Drop Leaf
  (drop [(self (mut Leaf))] (-> void)
    (record (.value self))))

;; ---------------------------------------------------------------- scope exit

(defn make-two [] (-> i64)
  (let [first (Owner :value 1)
        second (Owner :value 2)]
    99))

(defn consume [(o Owner)] (-> i64) (* (.value o) 100))

(defn moved-into-callee [] (-> i64)
  (let [a (Owner :value 3)
        b (Owner :value 4)
        got (consume b)]
    (record 5)
    got))

(defn scope-exit-section [] (-> void)
  (section "scope exit and moves")
  (reset!)
  (let [r (make-two)]
    (check "reverse declaration order" (traced) 21)
    (check "body value survives" r 99))
  (reset!)
  (let [r (moved-into-callee)]
    ;; b is dropped by the callee, before the caller's own record and a's drop.
    (check "callee drops a moved owner" (traced) 453)
    (check "callee result" r 400)
    (check "drop count" (load (events)) 3)))

;; ---------------------------------------------------------------- control exits

(defn labeled-break-drops [] (-> i64)
  (reset!)
  (loop :outer
    (let [outer-owner (Owner :value 1)]
      (loop :inner
        (let [inner-owner (Owner :value 2)]
          (break :outer)))))
  (traced))

(defn continue-drops [] (-> i64)
  (reset!)
  (let [(mut i) 0]
    (loop (let [iteration-owner (Owner :value (+ i 1))]
            (set! i (+ i 1))
            (if (< i 3) (continue) (break)))))
  (traced))

(defn break-value-survives-cleanup [] (-> i64)
  (reset!)
  (let [value (loop (let [owner (Owner :value 3)] (break 4)))]
    (+ (* (traced) 10) value)))

(defn return-from-drops [(early bool)] (-> i64)
  (reset!)
  (let [r (block :b
            (let [a (Owner :value 1)]
              (let [b (Owner :value 2)]
                (when early (return-from :b 7))
                (record 9)
                0)))]
    (+ (* (traced) 10) r)))

(defn shadowed-let [] (-> i64)
  (loop
    (let [x (Owner :value 1)]
      (let [x (Owner :value 2)]
        (break (.value x))))))

(defn shadowed-in-one-let [] (-> i64)
  (loop
    (let [x (Owner :value 3)
          x (Owner :value 4)]
      (break (.value x)))))

(defn shadowed-arm [] (-> i64)
  (loop
    (let [x (Owner :value 5)]
      (match (Some 6)
        (Some [x] (break x))
        (None [] (break 0))))))

(defn control-exit-section [] (-> void)
  (section "drops on control exits")
  (check "labelled break crosses two lets" (labeled-break-drops) 21)
  (check "continue and break each drop the iteration owner" (continue-drops) 123)
  (check "break value computed before the drop" (break-value-survives-cleanup) 34)
  (check "return-from drops inner then outer" (return-from-drops true) 217)
  (check "fall-through drops after the body" (return-from-drops false) 9210)
  (reset!)
  (let [v (shadowed-let)]
    (check "shadowed owners each drop once" (traced) 21)
    (check "inner shadow value" v 2))
  (reset!)
  (let [v (shadowed-in-one-let)]
    (check "shadow in one let" (traced) 43)
    (check "shadow in one let value" v 4))
  (reset!)
  (let [v (shadowed-arm)]
    (check "match arm shadows an owner" (traced) 5)
    (check "match arm value" v 6)))

;; ---------------------------------------------------------------- drop glue

;; Container has no Drop impl: its cleanup comes from its fields.
(defstruct Container [(first Leaf) (second Leaf)])

(defstruct GenericContainer [(T Drop)] [(first T) (second T)])

(defsum Choice
  (Empty [])
  (Pair [(first Leaf) (second Leaf)]))

(defstruct Nested [(inner Container) (tail Leaf)])

(defn struct-glue [] (-> i64)
  (reset!)
  (let [container (Container :first (Leaf :value 1) :second (Leaf :value 2))]
    0)
  (traced))

(defn generic-struct-glue [] (-> i64)
  (reset!)
  (let [container (GenericContainer :first (Leaf :value 3) :second (Leaf :value 4))]
    0)
  (traced))

(defn sum-glue [] (-> i64)
  (reset!)
  (let [empty (: (Empty) Choice)] 0)
  (let [pair (Pair (Leaf :value 5) (Leaf :value 6))] 0)
  (traced))

(defn array-glue [] (-> i64)
  (reset!)
  (let [items [(Leaf :value 1) (Leaf :value 2) (Leaf :value 3)]] 0)
  (traced))

(defn nested-glue [] (-> i64)
  (reset!)
  (let [n (Nested :inner (Container :first (Leaf :value 1) :second (Leaf :value 2))
                  :tail (Leaf :value 3))]
    0)
  (traced))

(defn drop-glue-section [] (-> void)
  (section "drop glue")
  (check "struct fields in reverse order" (struct-glue) 21)
  (check "generic struct fields" (generic-struct-glue) 43)
  (check "only the active sum payload" (sum-glue) 65)
  (check "array elements from the last" (array-glue) 321)
  (check "nested aggregate" (nested-glue) 321))

;; ---------------------------------------------------------------- generics

(defn consume-generic [T] [(value T)] (-> void))

(defn wrap [T] [(value T)] (-> (Option T)) (Some value))

(defn discard-generic [T] [(value T)] (-> i64)
  (wrap value)
  0)

(deftrait Peek [Self]
  (peek [(x (ref Self))] (-> i64))
  (val [(x Self)] (-> i64)))

(defstruct Tok [(n i64)])

(impl Drop Tok
  (drop [(self (mut Tok))] (-> void) (record (.n self))))

(impl Peek Tok
  (peek [(x (ref Tok))] (-> i64) (.n x))
  (val [(x Tok)] (-> i64) (.n x)))

(defn borrow [(T Peek)] [(x (ref T))] (-> i64) (peek x))
(defn consume-peek [(T Peek)] [(x T)] (-> i64) (borrow x))
(defn lend-then-take [(T Peek)] [(x T)] (-> i64)
  (+ (borrow x) (+ (peek x) (val x))))
(defn rebind [(T Peek)] [(x T)] (-> i64) (let [y x] (borrow y)))

;; A generic body passing a value it constructs to another generic function's owned
;; parameter: the callee receives the value, not a pointer to it, and drops it once.
(defstruct Held [T] [(item T)])

(defn tok-value [T] [(x Tok) (tag T)] (-> i64) (.n x))
(defn held-value [(T Peek)] [(h (Held T))] (-> i64) (peek (.item h)))
(defn construct-into-generic [T] [(tag T)] (-> i64)
  (+ (* (tok-value (Tok :n 3) tag) 10) (held-value (Held :item (Tok :n 4)))))

(defn generic-section [] (-> void)
  (section "generic owners")
  (reset!)
  (consume-generic (Owner :value 9))
  (check "generic consumer drops its owner" (traced) 9)
  (reset!)
  (discard-generic (Leaf :value 8))
  (discard-generic 5)
  (check "discarded generic result drops; Copy instance owns nothing" (traced) 8)
  (reset!)
  (check "owned generic lent to (ref T)" (consume-peek (Tok :n 5)) 5)
  (check "lent twice then consumed" (lend-then-take (Tok :n 7)) 21)
  (check "rebound generic owner" (rebind (Tok :n 6)) 6)
  (check "each generic owner dropped once" (traced) 576)
  (reset!)
  (check "owners constructed in a generic body passed by value" (construct-into-generic true) 34)
  (check "each constructed owner dropped once" (traced) 34))

;; ------------------------------------- owners through Option, blocks, pointers

;; `(Option T)` instantiated at an owner consumes it, as a bare `T` does.
(defn unwrap-owner [T] [(o (Option T)) (default T)] (-> T)
  (let [(mut owned) o]
    (match (take! (mut owned)) (None [] default) (Some [v] (let [_ default] v)))))

(defn pick [T] [(x T)] (-> T) x)

(defn bump-owner [(o Owner)] (-> Owner) (Owner :value (+ (.value o) 1)))

;; an owner may leave a block when every way out of it moves the owner
(defn owner-out-of-block [] (-> (Option Owner))
  (let [o (Owner :value 4)]
    (block :out (Some o))))

(defn passing-section [] (-> void)
  (section "owners through Option, blocks and pointers")
  (reset!)
  (check "owner unwrapped from an Option" (.value (unwrap-owner (Some (Owner :value 1)) (Owner :value 2))) 1)
  (check "generic owner returned by value" (.value (pick (Owner :value 3))) 3)
  (check "owner left a block" (match (owner-out-of-block) (Some [o] (.value o)) (None [] 0)) 4)
  (let [f (fnptr-of bump-owner)]
    (check "owner through a function pointer" (.value (call-ptr f (Owner :value 5))) 6))
  (check "each owner dropped once" (traced) 213456))

;; ---------------------------------------------------------------- overwrite

(defstruct Holder [(leaf Leaf)])

(defn consume-leaf [(owner Leaf)] (-> void))

(defn replace-whole [] (-> i64)
  (reset!)
  (let [(mut owner) (Leaf :value 1)]
    (set! owner (Leaf :value 2)))
  (traced))

(defn replace-field [] (-> i64)
  (reset!)
  (let [(mut holder) (Holder :leaf (Leaf :value 3))]
    (set! (.leaf holder) (Leaf :value 4)))
  (traced))

(defn reinitialize-moved [] (-> i64)
  (reset!)
  (let [(mut owner) (Leaf :value 4)]
    (consume-leaf owner)
    (set! owner (Leaf :value 5)))
  (traced))

(defn replace-through-borrow [(slot (mut Leaf))] (-> void)
  (set! slot (Leaf :value 7)))

(defn overwrite-through-mut [] (-> i64)
  (reset!)
  (let [(mut owner) (Leaf :value 6)]
    (replace-through-borrow (mut owner))
    (record 0))
  (traced))

(defn overwrite-section [] (-> void)
  (section "overwrites")
  (check "assignment drops the old value first" (replace-whole) 12)
  (check "field assignment drops only the old field" (replace-field) 34)
  (check "a moved slot is reinitialized" (reinitialize-moved) 45)
  (check "assignment through a mut borrow" (overwrite-through-mut) 607))

;; ---------------------------------------------------------------- statement results

(defn make [(value i64)] (-> Leaf) (Leaf :value value))
(defn make-some [(value i64)] (-> (Option Leaf)) (Some (Leaf :value value)))
(defn peek-leaf [(holder (ref Holder))] (-> (ref Leaf)) (field holder leaf))

(defn fresh-results [] (-> i64)
  (reset!)
  (make 1)
  (make-some 2)
  (Some (Leaf :value 3))
  (if (= (traced) 123) (make 4) (make 5))
  (match (Some (traced))
    (Some [_] (make 6))
    (None [] (make 7)))
  (do (make 8) 0)
  (traced))

(defn places-and-borrows [] (-> i64)
  (reset!)
  (let [holder (Holder :leaf (Leaf :value 1))
        leaf (Leaf :value 2)]
    leaf
    (.leaf holder)
    (peek-leaf holder)
    (record 5))
  (traced))

(defn loop-results [] (-> i64)
  (reset!)
  (let [(mut i) 0]
    (loop (if (>= i 3)
              (break)
              (do (set! i (+ i 1))
                  (make i)))))
  (traced))

(defn statement-section [] (-> void)
  (section "discarded results")
  (check "each fresh result drops at its statement" (fresh-results) 123468)
  (check "naming a place neither moves nor drops" (places-and-borrows) 521)
  (check "a loop body's value is discarded each iteration" (loop-results) 123))

;; ---------------------------------------------------------------- escape hatches

(defn forget-owner [] (-> void)
  (forget (Owner :value 7)))

(defn take-and-reinitialize [] (-> i64)
  (let [(mut owner) (Owner :value 3)
        taken (take! (mut owner))]
    (set! owner (Owner :value 4))
    (.value taken)))

(defn take-scrutinee [] (-> i64)
  (let [(mut r) (Ok [Owner i64] (Owner :value 1))]
    (match (take! (mut r))
      (Ok [v] (.value v))
      (Err [_] 0))))

(defn rebind-parameter [(r (Result Owner i64))] (-> i64)
  (let [(mut owned) r]
    (match (take! (mut owned))
      (Ok [v] (.value v))
      (Err [_] 0))))

(defn manual [] (-> i64)
  (let [m (manually-drop (Owner :value 8))]
    (record 1))
  (traced))

(defn escape-section [] (-> void)
  (section "forget, take!, manually-drop")
  (reset!)
  (forget-owner)
  (check "forget suppresses the drop" (traced) 0)
  (reset!)
  (let [v (take-and-reinitialize)]
    (check "take! moves the value out" v 3)
    (check "taken and reinitialized each drop once" (traced) 34))
  (reset!)
  (let [a (take-scrutinee)
        b (rebind-parameter (Ok (Owner :value 2)))]
    (check "match on take! binds the payload by value" a 1)
    (check "a by-value owner parameter moves into a binding" b 2)
    (check "payload owners drop once each" (traced) 12))
  (reset!)
  (check "manually-drop runs no destructor" (manual) 1))

;; ---------------------------------------------------------------- clone and copy

(defstruct Resource [(value i64)])

(impl Clone Resource
  (clone [(self (ref Resource))] (-> Resource)
    (Resource :value (.value self))))

(impl Drop Resource
  (drop [(self (mut Resource))] (-> void) (record 1)))

(defstruct OwnedPair [(resource Resource) (tag i64)])
(derive Clone OwnedPair)

(defstruct PlainPair [(left i64) (right i64)])
(derive Copy PlainPair)

(defsum OwnedChoice
  (Absent)
  (Present [(resource Resource) (tag i64)]))
(derive Clone OwnedChoice)

(defsum PlainChoice
  (Nothing)
  (Number [(value i64)]))
(derive Copy PlainChoice)

(defstruct GenericOwned [T] [(value T)])
(derive Clone (GenericOwned T))

(defn clone-section [] (-> void)
  (section "clone and copy")
  (reset!)
  (let [original (OwnedPair :resource (Resource :value 40) :tag 2)
        duplicate (clone original)
        plain (PlainPair :left 20 :right 22)
        copied plain
        choice (Present (Resource :value 7) 35)
        choice-copy (clone choice)
        plain-choice (Number 42)
        plain-choice-copy plain-choice
        generic (GenericOwned [Resource] :value (Resource :value 42))
        generic-copy (clone generic)]
    (check "derived Clone copies an owned field" (.value (.resource duplicate)) 40)
    (check "the original is still alive" (.tag original) 2)
    (check "Copy struct" (+ (.left copied) (.right copied)) 42)
    (check "derived Clone of a sum"
           (match choice-copy
             (Absent [] 0)
             (Present [resource tag] (+ (.value resource) tag)))
           42)
    (check "Copy sum"
           (match plain-choice-copy (Nothing [] 0) (Number [value] value))
           42)
    (check "derived Clone of a generic struct" (.value (.value generic-copy)) 42)
    (check "no resource dropped yet" (load (events)) 0))
  ;; Six Resources: three originals and three clones.
  (check "every resource dropped once" (load (events)) 6)
  ;; A value read out of a place and lent to clone's (ref Self) borrows the
  ;; place. A copy of it would be an owner of its own, dropped when the borrow
  ;; ends, which drops the original's resources a second time.
  (reset!)
  (let [(mut held) (Resource :value 9)
        pair (OwnedPair :resource (Resource :value 11) :tag 3)
        p (primitive/cast (ptr Resource) (mut held))
        through-pointer (clone (load p))
        through-field (clone (.resource pair))]
    (check "clone through a pointer" (.value through-pointer) 9)
    (check "clone of a field" (.value through-field) 11)
    (check "cloning a place drops nothing" (load (events)) 0))
  (check "two originals and two clones dropped once each" (load (events)) 4))

;; ---------------------------------------------------------------- borrowing an owner

(defstruct Bag [(n i64)])
(defstruct BagIter [(at i64) (end i64)])

(impl Drop Bag
  (drop [(self (mut Bag))] (-> void) (record 9)))

(impl Len Bag
  (len [(b (ref Bag))] (-> i64) (.n b)))

(impl Iterator BagIter
  (next [(it (mut BagIter))] (-> (Option i64))
    (if (< (.at it) (.end it))
        (let [v (.at it)]
          (set! (.at it) (+ v 1))
          (Some v))
        (None))))

(impl Iterable Bag
  (iter [(b (ref Bag))] (-> BagIter) (BagIter :at 0 :end (.n b))))

(defn twice [(C Len)] [(c C)] (-> i64) (+ (len c) (len c)))

(defstruct Ticket [(n i64)])

(impl Drop Ticket
  (drop [(self (mut Ticket))] (-> void) (record (.n self))))

(impl Display Ticket
  (display-fmt [(t (ref Ticket)) (f (ptr Formatter))] (-> i64)
    (fmt (writer f) "ticket-{}" (.n t))
    0))

(impl Eq Ticket
  (= [(a (ref Ticket)) (b (ref Ticket))] (-> bool) (= (.n a) (.n b))))

(defn borrow-section [] (-> void)
  (section "borrowing owners")
  (reset!)
  (let [(mut b) (Bag :n 3)
        (mut sum) 0]
    (check "len borrows" (len b) 3)
    (check "len through mut" (len (mut b)) 3)
    (for x (iter b) (set! sum (+ sum x)))
    (for x (iter (mut b)) (set! sum (+ sum (* 10 x))))
    (check "iterating borrows" sum 33)
    (check "the bag is alive after borrows" (load (events)) 0)
    ;; A generic parameter (c C) takes its argument by value: the bag moves into
    ;; twice, whose own borrows of it are fine, and twice drops it.
    (check "a Len bound inside a generic" (twice b) 6)
    (check "the moved bag dropped in the callee" (load (events)) 1))
  (check "and not again at scope exit" (traced) 9)
  (reset!)
  (let [a (Ticket :n 1)
        b (Ticket :n 2)]
    (println "  formatted {} [{:>10}]" a b)
    (check-true "!= lends its operands" (!= a b))
    (check-true "= lends its operands" (= a a))
    (check "both tickets still alive" (+ (.n a) (.n b)) 3))
  (check "tickets drop in reverse order" (traced) 21))

;; ---------------------------------------------------------------- defer and scope

(defsum Fault (Bad))

(defn fail [] (-> (Result i64 Fault)) (Err (Bad)))

(defn try-leaves-scope [] (-> i64)
  (reset!)
  (let [r (: (try (scope :inner
                    (defer (record 1))
                    (try! (fail))
                    (Ok 1)))
             (Result i64 Fault))]
    (+ (* (traced) 10) (match r (Ok [v] v) (Err [_] 7)))))

(defn nested-defers [] (-> i64)
  (reset!)
  (scope :outer
    (defer (record 1))
    (defer (record 2))
    (scope :inner
      (defer (record 3))
      (defer (record 4))
      (return-from :outer 0)))
  (traced))

(defn defer-in-loop [] (-> i64)
  (reset!)
  (let [(mut n) 0]
    (for i (range 0 4)
      (defer (record (+ i 1)))
      (when (= i 1) (continue))
      (when (= i 3) (break))
      (set! n (+ n 10)))
    (+ (* (traced) 100) n)))

(defn value-before-cleanup [] (-> i64)
  (let [(mut n) 1]
    (let [r (block :s
              (defer (set! n 100))
              (return-from :s n))]
      (+ (* r 1000) n))))

(defn unreached [(early bool)] (-> i64)
  (reset!)
  (block :s
    (when early (return-from :s 1))
    (defer (record 5))
    2)
  (traced))

(defn order [(early bool)] (-> i64)
  (reset!)
  (let [r (block :s
            (let [a (Owner :value 1)]
              (defer (record (+ (.value a) 2)))
              (let [b (Owner :value 2)]
                (when early (return-from :s 7))
                (record 9)
                0)))]
    (+ (* (traced) 10) r)))

(defn scope-with-owner [] (-> i64)
  (reset!)
  (let [result (scope :request
                 (defer (record 9))
                 (let [owner (Owner :value 1)]
                   (return-from :request 4)))]
    (+ (* (traced) 10) result)))

(defn generic-defer [T] [(x T) (n i64)] (-> i64)
  (block :s
    (defer (record n))
    (when (> n 0) (return-from :s n))
    0))

(defn defer-section [] (-> void)
  (section "defer and scope")
  (check "try! leaving a scope runs its defer" (try-leaves-scope) 17)
  (check "LIFO, inner body first" (nested-defers) 4321)
  (check "continue and break run the iteration's defer" (defer-in-loop) 123420)
  (check "the leaving value is computed first" (value-before-cleanup) 1100)
  (check "an unreached defer registers nothing" (unreached true) 0)
  (check "a reached defer runs" (unreached false) 5)
  (check "early exit: b drops, cleanup, then a drops" (order true) 2317)
  (check "fall-through order" (order false) 92310)
  (check "owner drops before the scope's defer" (scope-with-owner) 194)
  (reset!)
  (let [a (generic-defer 1 5)
        b (generic-defer true 0)]
    (check "generic bodies place cleanups" (+ (* a 10) b) 50)
    (check "generic cleanups ran" (traced) 50)))

;; ------------------------------------------- leaving, joins and temporaries

;; A path that leaves -- a break, a return-from, a call that never returns --
;; never reaches the code after it, nor the join of the branches it is one of.

(defn consume-after-break [] (-> i64)
  (reset!)
  (let [o (Owner :value 1)]
    (loop (break 0) (consume o))
    (record 2))
  (traced))

(defn move-then-leave [(early bool)] (-> i64)
  (reset!)
  (let [o (Owner :value 3)]
    (block :out
      (when early (consume o) (return-from :out 0))
      (record 4)
      (consume o)
      0))
  (traced))

(defn moved-by-break [] (-> i64)
  (reset!)
  (let [o (Owner :value 5)]
    (loop (record 6) (consume o) (break))
    (record 7))
  (traced))

(defn halt [(code i64)] (-> never)
  (defer (record 9))
  (panic "halt {}" code))

;; Operands evaluated before one that leaves are values nothing receives.

(defn take-leaf [(l Leaf) (n i64)] (-> i64) (+ (.value l) n))
(defstruct LeafPair [(first Leaf) (second Leaf)])
(defsum LeafChoice (Both [(first Leaf) (second Leaf)]) (Neither))
(defstruct Couple [(first Leaf) (second Leaf)])
(impl Drop Couple (drop [(self (mut Couple))] (-> void) (record 7)))

(defn pending-call [] (-> i64)
  (reset!)
  (let [r (loop (take-leaf (Leaf :value 1) (break 8)))] (+ (* (traced) 10) r)))

(defn pending-moved-argument [] (-> i64)
  (reset!)
  (let [r (let [l (Leaf :value 2)] (loop (take-leaf l (break 8))))] (+ (* (traced) 10) r)))

(defn pending-struct [] (-> i64)
  (reset!)
  (let [r (loop (Couple :first (Leaf :value 3) :second (break 8)))] (+ (* (traced) 10) r)))

(defn pending-variant [] (-> i64)
  (reset!)
  (let [r (loop (Both (Leaf :value 4) (break 8)) 0)] (+ (* (traced) 10) r)))

(defn pending-array [] (-> i64)
  (reset!)
  (let [r (loop [(Leaf :value 5) (Leaf :value 6) (break 8)] 0)] (+ (* (traced) 10) r)))

;; A temporary lent to a call, or whose field is read, lives until the borrow ends.

(defn bump-leaf [(l (mut Leaf))] (-> i64) (set! (.value l) (+ (.value l) 1)) (.value l))
(defn read-while-live [(l (ref Leaf))] (-> i64) (+ (* (traced) 10) (.value l)))

(defn lent-temporary [] (-> i64)
  (reset!)
  (let [r (bump-leaf (mut (Leaf :value 6)))] (+ (* (traced) 10) r)))

(defn projected-temporary [] (-> i64)
  (reset!)
  (let [r (read-while-live (.first (LeafPair :first (Leaf :value 1) :second (Leaf :value 2))))]
    (+ (* (traced) 100) r)))

(defstruct Fading [(value i64)])
(impl Drop Fading
  (drop [(self (mut Fading))] (-> void)
    (record (.value self))
    (set! (.value self) 0)))

(defn read-temporary-field [] (-> i64)
  (reset!)
  (let [r (.value (Fading :value 4))]
    (+ (* (traced) 10) r)))

;; A constructor's arguments are used as they were checked: an owner a `let`
;; among them binds is dropped, and a payload a match arm owns moves out.
(defn constructor-argument-let [] (-> i64)
  (reset!)
  (let [p (LeafPair :first (let [scratch (Leaf :value 1)] (Leaf :value 2))
                    :second (Leaf :value 3))]
    (record 4))
  (traced))

(defn constructor-argument-let-out-of-order [] (-> i64)
  (reset!)
  (let [p (LeafPair :second (Leaf :value 3)
                    :first (let [scratch (Leaf :value 1)] (Leaf :value 2)))]
    (record 4))
  (traced))

(defn constructor-argument-payload [] (-> i64)
  (reset!)
  (let [p (LeafPair :first (match (make-some 2) (Some [l] l) (None [] (Leaf :value 0)))
                    :second (Leaf :value 3))]
    (record 4))
  (traced))

(defn named-call-borrows [(b (ref Leaf)) (n i64)] (-> i64) (+ (.value b) n))
(defn named-call-temporary [] (-> i64)
  (reset!)
  (let [r (named-call-borrows :n 10 :b (Leaf :value 5))]
    (+ (* (traced) 100) r)))

;; Assigning an element replaces it: the element it held drops once the new one
;; is in place, as a field's does. `init!` writes a slot that holds no value yet,
;; so it drops nothing.
(defn replace-element [] (-> i64)
  (reset!)
  (let [(mut leaves) [(Leaf :value 1) (Leaf :value 2)]]
    (set! (mut leaves) 0 (Leaf :value 9))
    (record 5))
  (traced))

(defn replace-through-slice [(view (slice Leaf))] (-> void)
  (set! view 1 (Leaf :value 8)))

(defn replace-slice-element [] (-> i64)
  (reset!)
  (let [(mut leaves) [(Leaf :value 1) (Leaf :value 2)]]
    (replace-through-slice (mut leaves))
    (record 5))
  (traced))

(defn initialize-element [] (-> i64)
  (reset!)
  (let [(mut leaves) [(Leaf :value 1) (Leaf :value 2)]]
    ; the first element moves out, and its slot is written afresh
    (forget (get leaves 0))
    (init! (mut leaves) 0 (Leaf :value 9))
    (record 5))
  (traced))

;; A catch-all arm owns the value it is left with.
(defn catch-all-owns [] (-> i64)
  (reset!)
  (match (make-some 3) (_ (record 1)))
  (record 2)
  (traced))

;; A constant's initializer drops its owners as a body does.
(defstruct Stamp [(at (ptr i64))])
(impl Drop Stamp (drop [(self (mut Stamp))] (-> void) (store! (.at self) 42)))
(const STAMPED (let [cell (primitive/alloc-stack i64)]
                 (store! cell 0)
                 (let [s (Stamp :at cell)] 0)
                 (load cell)))

;; An owner that runs no destructor still moves by address.
(defn pass-manual [(x (ManuallyDrop i64))] (-> (ManuallyDrop i64)) (let [y x] y))
(defn read-manual [(x (ManuallyDrop i64))] (-> i64) (.value x))

(defn leaving-section [] (-> void)
  (section "leaving, joins and temporaries")
  (check "a move after a break never happens" (consume-after-break) 21)
  (check "a branch that moves and leaves" (move-then-leave true) 3)
  (check "the branch that stays" (move-then-leave false) 43)
  (check "after a loop, owners are as its break left them" (moved-by-break) 657)
  (check "a defer before a call that never returns" (if (< (traced) 0) (halt 1) 1) 1)
  (check "a call's earlier argument drops" (pending-call) 18)
  (check "a moved argument stays with its owner" (pending-moved-argument) 28)
  (check "a struct's earlier field drops" (pending-struct) 38)
  (check "a variant's earlier field drops" (pending-variant) 48)
  (check "an array's earlier elements drop" (pending-array) 568)
  (check "a lent temporary drops after the call" (lent-temporary) 77)
  (check "a projected temporary lives through the call" (projected-temporary) 2101)
  (check "a temporary's field read precedes its drop" (read-temporary-field) 44)
  (check "a catch-all arm drops the value" (catch-all-owns) 132)
  (check "set! of an array element drops the old one" (replace-element) 1529)
  (check "set! through a slice drops the old element" (replace-slice-element) 2581)
  (check "init! writes a slot without dropping" (initialize-element) 529)
  (check "an owner a constructor argument binds drops" (constructor-argument-let) 1432)
  (check "and written out of order" (constructor-argument-let-out-of-order) 1432)
  (check "a constructor argument moves a match payload" (constructor-argument-payload) 432)
  (check "a named call's lent temporary drops after it" (named-call-temporary) 515)
  (check "a constant's owners drop" STAMPED 42)
  (check "ManuallyDrop moves through a call" (read-manual (pass-manual (ManuallyDrop :value 7))) 7))

;; ---------------------------------------------------------------- main

(defn main [] (-> i64)
  (store! (failures) 0)
  (scope-exit-section)
  (control-exit-section)
  (drop-glue-section)
  (generic-section)
  (passing-section)
  (overwrite-section)
  (statement-section)
  (escape-section)
  (clone-section)
  (borrow-section)
  (defer-section)
  (leaving-section)
  (println "ownership: {} failures" (load (failures)))
  (load (failures)))
