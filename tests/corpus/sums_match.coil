(module corpus.sums-match)
;; Sum types and matching end to end: defsum with many variants and aggregate,
;; array and recursive payloads, exhaustive matches compiled to decision trees,
;; nested variant and literal patterns, `as`, `(mut x)` bindings, if-let,
;; when-let and while-let, Option and Result with try!/try?/try-or!/ensure!, the
;; coil.result combinators, keywords as values, the never type, and an expression
;; evaluator that ties them together.
;;
;; Each section prints what it computed and checks it; main returns the number
;; of failed checks.
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use [malloc-allocator arena-allocator])
(import "coil.arraylist" :use [ArrayList])
(import "coil.result" :use [some? none? ok? err? unwrap-or opt-map res-map map-err and-then ok-or])
(import "coil.try" :use [try try! try? try-or! some-or! ensure!])
(import "coil.io" :as io :use [IoError])
(import "coil.cc" :as cc)
(import "coil.layout" :as layout)

;; ---------------------------------------------------------------- harness

(defn failures [] (-> (ptr i64)) (primitive/alloc-static i64))

(defn check [(name (slice u8)) (got i64) (want i64)] (-> void)
  (if (= got want)
      (println "  {} = {}" name got)
      (do (store! (failures) (+ (load (failures)) 1))
          (println "  FAIL {} = {}, want {}" name got want))))

(defn check-str [(name (slice u8)) (got (slice u8)) (want (slice u8))] (-> void)
  (if (= got want)
      (println "  {} = {}" name got)
      (do (store! (failures) (+ (load (failures)) 1))
          (println "  FAIL {} = {}, want {}" name got want))))

(defn check-true [(name (slice u8)) (ok bool)] (-> void)
  (check name (if ok 1 0) 1))

(defn section [(title (slice u8))] (-> void)
  (println "== {}" title))

;; ---------------------------------------------------------------- many variants

(defstruct Info [(a i64) (b i64)])

(defsum Eight
  (E0 [])
  (E1 [(x i64)])
  (E2 [(x i64) (y i64)])
  (E3 [(s Info)])
  (E4 [])
  (E5 [(f f64)])
  (E6 [(flag bool) (small u8)])
  (E7 [(x i64)]))

(defn eight-value [(e Eight)] (-> i64)
  (match e
    (E0 [] 0)
    (E1 [x] x)
    (E2 [x y] (+ x (* y 100)))
    (E3 [s] (- (.a s) (.b s)))
    (E4 [] 44)
    (E5 [f] (cast i64 (* f 10.0)))
    (E6 [flag small] (if flag (cast i64 small) 0))
    (E7 [x] (- x))))

(defn pick [(k i64)] (-> Eight)
  (case k
    0 (E0)
    1 (E1 11)
    2 (E2 5 7)
    3 (E3 (Info :a 50 :b 8))
    4 (E4)
    5 (E5 2.5)
    6 (E6 :flag true :small (: 6 u8))
    (E7 9)))

;; A variant carrying an array, and one carrying odd-width integers.
(defsum Packed (Cells [(cells (array i32 4))]) (NoCells))
(defsum OddPacked (OddCells [(cells (array u9 5))]) (NoOdd))

(defn packed-sum [(p Packed)] (-> i64)
  (match p
    (NoCells [] -1)
    (Cells [cs] (fold (fn [acc c] (+ acc (cast i64 c))) 0 cs))))

(defn odd-sum [(p OddPacked)] (-> i64)
  (match p
    (NoOdd [] -1)
    (OddCells [cs] (fold (fn [acc c] (+ acc (cast i64 c))) 0 cs))))

;; A payload holds what it carries: a u24 is four bytes, so a hundred of them are
;; 400, and a struct laid out at explicit offsets fills its :size.
(defsum Samples (Many [(xs (array u24 100))]) (NoSamples))
(defstruct Reg :layout (layout/Explicit) :size 64 :align 8 [(id i32 :at 0) (data i64 :at 48)])
(defsum MaybeReg (OneReg [(r Reg)]) (NoReg))

(defn many-samples [] (-> Samples)
  (let [(mut xs) (zeroed (array u24 100))]
    (for [i 0 100] (set! (mut xs) i (cast u24 (* i 3))))
    (Many xs)))

(defn one-reg [] (-> MaybeReg)
  (let [(mut r) (zeroed Reg)]
    (set! (.data r) 99)
    (OneReg r)))

(defn variants-section [] (-> void)
  (section "many variants and payload shapes")
  (let [(mut total) 0]
    (for k (range 0 8) (set! total (+ total (eight-value (pick k)))))
    (check "eight variants built in a loop" total 824))
  (check "an array payload" (packed-sum (Cells [7 14 21 28])) 70)
  (check "an empty variant beside it" (packed-sum (NoCells)) -1)
  (check "odd-width elements" (odd-sum (OddCells [(: 60 u9) (: 120 u9) (: 180 u9) (: 240 u9) (: 300 u9)])) 900)
  (check "a sum with an array has one size" (cast i64 (sizeof Packed)) (comptime (cast i64 (sizeof Packed))))
  (check "the last of a hundred u24s in a payload"
         (match (many-samples) (Many [xs] (cast i64 (get xs 99))) (NoSamples [] -1))
         297)
  (check "a field at offset 48 of an explicit payload"
         (match (one-reg) (OneReg [r] (.data r)) (NoReg [] -1))
         99)
  (check-true "a payload is as large as what it holds"
              (and (>= (cast i64 (sizeof Samples)) 404) (>= (cast i64 (sizeof MaybeReg)) 68)))
  (let [r (Some (Ok [Info i64] (Info :a 30 :b 12)))]
    (check "Option of Result of struct"
           (match r
             (None [] -1)
             (Some [inner] (match inner
                             (Err [e] (- e))
                             (Ok [s] (+ (.a s) (.b s))))))
           42)))

;; ---------------------------------------------------------------- recursion: an evaluator

(defsum Expr
  (Num [(value i64)])
  (Var [(name Keyword)])
  (Add [(left (ptr Expr)) (right (ptr Expr))])
  (Mul [(left (ptr Expr)) (right (ptr Expr))])
  (Neg [(inner (ptr Expr))])
  (Div [(left (ptr Expr)) (right (ptr Expr))]))

(defsum EvalError (DivByZero) (Unbound [(name Keyword)]))

(defn lookup [(name Keyword)] (-> (Option i64))
  (case name :x (Some 6) :y (Some 7) (None)))

(defn eval [(e (ptr Expr))] (-> (Result i64 EvalError))
  (try
    (match (load e)
      (Num [n] (Ok n))
      (Var [name] (match (lookup name)
                    (Some [v] (Ok v))
                    (None [] (Err (Unbound name)))))
      (Add [l r] (Ok (+ (try! (eval l)) (try! (eval r)))))
      (Mul [l r] (Ok (* (try! (eval l)) (try! (eval r)))))
      (Neg [x] (Ok (- (try! (eval x)))))
      (Div [l r] (let [d (try! (eval r))]
                   (if (= d 0) (Err (DivByZero)) (Ok (/ (try! (eval l)) d))))))))

(defn eval-code [(r (Result i64 EvalError))] (-> i64)
  (match r
    (Ok [v] v)
    (Err [(DivByZero)] -1000)
    (Err [(Unbound [name])] (if (= name :z) -2000 -3000))))

(defsum Tree
  (Leaf [(v i64)])
  (Node [(kids (ptr (ArrayList Tree)))]))

(defn tree-sum [(t Tree)] (-> i64)
  (match t
    (Leaf [v] v)
    (Node [kids] (fold (fn [acc kid] (+ acc (tree-sum kid))) 0 (load kids)))))

(defn tree-depth [(t Tree)] (-> i64)
  (match t
    (Leaf [_] 1)
    (Node [kids] (+ 1 (fold (fn [acc kid] (let [d (tree-depth kid)] (if (> d acc) d acc)))
                            0 (load kids))))))

(defn recursion-section [] (-> void)
  (section "recursive sums")
  (let [a (arena-allocator 4096)
        x (alloc/box! a Expr (Var :x))
        y (alloc/box! a Expr (Var :y))
        z (alloc/box! a Expr (Var :z))
        w (alloc/box! a Expr (Var :w))
        two (alloc/box! a Expr (Num 2))
        zero (alloc/box! a Expr (Num 0))
        prod (alloc/box! a Expr (Mul x y))
        sum (alloc/box! a Expr (Add prod (alloc/box! a Expr (Neg two))))]
    (check "x*y + -2" (eval-code (eval sum)) 40)
    (check "a division" (eval-code (eval (alloc/box! a Expr (Div sum two)))) 20)
    (check "division by zero propagates" (eval-code (eval (alloc/box! a Expr (Add x (alloc/box! a Expr (Div x zero)))))) -1000)
    (check "an unbound :z" (eval-code (eval (alloc/box! a Expr (Mul z two)))) -2000)
    (check "another unbound name" (eval-code (eval w)) -3000))
  (let [a (malloc-allocator)
        (mut l1) (ArrayList::new [Tree] a)
        (mut l2) (ArrayList::new [Tree] a)
        (mut l3) (ArrayList::new [Tree] a)
        (mut l4) (ArrayList::new [Tree] a)]
    (push! (mut l1) (Leaf 1))
    (push! (mut l1) (Leaf 2))
    (push! (mut l2) (Leaf 4))
    (push! (mut l2) (Leaf 5))
    (push! (mut l3) (Leaf 3))
    (push! (mut l3) (Node (cast (ptr (ArrayList Tree)) (mut l2))))
    (push! (mut l4) (Node (cast (ptr (ArrayList Tree)) (mut l1))))
    (push! (mut l4) (Node (cast (ptr (ArrayList Tree)) (mut l3))))
    (let [root (Node (cast (ptr (ArrayList Tree)) (mut l4)))]
      (check "a recursive tree sum" (tree-sum root) 15)
      (check "its depth" (tree-depth root) 4))
    (free! (mut l1))
    (free! (mut l2))
    (free! (mut l3))
    (free! (mut l4))))

;; ---------------------------------------------------------------- patterns

(defsum ParseError (Empty) (NotADigit [(at i64)]))
(defsum Shape (Circle [(r i64)]) (Square [(side i64)]))
(defsum Both (Pair [(left Shape) (right (Option i64))]))

(defn nested [(o (Option (Option (Result i64 ParseError))))] (-> i64)
  (match o
    (Some [(Some [(Ok [v])])] v)
    (Some [(Some [(Err [(NotADigit [at])])])] (- at))
    (Some [_] -100)
    (None [] -1)))

(defn both [(p Both)] (-> i64)
  (match p
    (Pair [(Circle [r]) (Some [n])] (+ (* 100 r) n))
    (Pair [(Square [s]) _] (* 1000 s))
    (_ 7)))

(defsum Fault (A) (B) (C [(code i64)]))
(defsum Duo (P [(left (Option i64)) (right (Option i64))]))

;; Every nested variant is covered between the arms, so no catch-all.
(defn code-of [(r (Result i64 Fault))] (-> i64)
  (match r
    (Err [(A [])] 1)
    (Err [(B)] 2)
    (Err [(C [code])] code)
    (Ok [v] v)))

;; The third arm is reached from two branches of the tree.
(defn duo [(p Duo)] (-> i64)
  (match p
    (P [_ (Some [7])] 700)
    (P [(Some [x]) _] x)
    (P [_ (Some [y])] (* 10 y))
    (P [(None) (None)] -1)))

(defn whole [(r (Result i64 Fault))] (-> i64)
  (match r
    (Err [(as e (C [n]))] (+ (* 100 n) (code-of (Err e))))
    (Err [_] -2)
    (Ok [v] v)))

(defn bump [(r (Result i64 i64))] (-> i64)
  (match r
    (Ok [(mut v)] (set! v (+ v 1)) v)
    (Err [e] e)))

(defn bump-nested [(o (Option (Option i64)))] (-> i64)
  (match o
    (Some [(Some [(mut n)])] (set! n (* n 2)) n)
    (_ 0)))

(defn errno [(e IoError)] (-> i64)
  (match e
    (Errno [c] c)
    (_ -1)))

(defn digit-name [(n i64)] (-> (slice u8))
  (match n (0 "zero") (1 "one") (-1 "minus one") (_ "many")))

(defn yes-no [(b bool)] (-> (slice u8))
  (match b (true "yes") (false "no")))

(defn vowel? [(c u8)] (-> bool)
  (match c (#\a true) (#\e true) (#\i true) (#\o true) (#\u true) (_ false)))

(defn command [(s (slice u8))] (-> i64)
  (match s ("go" 1) ("stop" 2) (_ 0)))

(defsum Cell (Open [(cost i64)]) (Wall))

(defn cell-cost [(c Cell)] (-> (slice u8))
  (match c
    (Open [1] "cheap")
    (Open [n] (if (> n 5) "dear" "fair"))
    (Wall [] "blocked")))

(defn flags [(o (Option bool))] (-> i64)
  (match o (Some [true] 1) (Some [false] 0) (None [] -1)))

(defsum Box (Wrap [(v i64)]) (Nothing))

;; An arm's binding shadows a macro of the same name; an unshadowed macro in an
;; arm body still expands.
(defn arm-scope [(b Box)] (-> i64)
  (match b
    (Wrap [v] (when (= v 5) 7))
    (Nothing [] 0)))

(defn count-evens [(xs (slice i64))] (-> i64)
  (let [(mut n) 0]
    (for x xs
      (match (% x 2)
        (0 (set! n (+ n 1)))
        (_)))
    n))

(defn patterns-section [] (-> void)
  (section "patterns")
  (check "nested Ok" (nested (Some (Some (Ok 5)))) 5)
  (check "nested Err variant" (nested (Some (Some (Err (NotADigit 9))))) -9)
  (check "nested fall-through" (nested (Some (Some (Err (Empty))))) -100)
  (check "nested Some None" (nested (Some (None))) -100)
  (check "nested None" (nested (None)) -1)
  (check "two nested payloads" (both (Pair (Circle 2) (Some 3))) 203)
  (check "fall through to _" (both (Pair (Circle 2) (None))) 7)
  (check "_ inside a payload" (both (Pair (Square 4) (None))) 4000)
  (check "nested arms cover A" (code-of (Err (A))) 1)
  (check "nullary pattern without []" (code-of (Err (B))) 2)
  (check "payload of a nested variant" (code-of (Err (C 7))) 7)
  (check "a literal in a nested payload" (duo (P (Some 1) (Some 7))) 700)
  (check "the left branch" (duo (P (Some 3) (Some 2))) 3)
  (check "the right branch" (duo (P (None) (Some 4))) 40)
  (check "both None" (duo (P (None) (None))) -1)
  (check "Some, None" (duo (P (Some 5) (None))) 5)
  (check "as names the whole value" (whole (Err (C 3))) 303)
  (check "as, other variant" (whole (Err (A))) -2)
  (let [n 5]
    (check "(mut v) in an arm is a copy" (bump (Ok n)) 6)
    (check "the source is unchanged" n 5)
    (check "nested (mut n)" (bump-nested (Some (Some n))) 10))
  (check "a variant of an imported sum needs no import" (errno (io/Errno 2)) 2)
  (check "and its catch-all" (errno (io/Eof)) -1)
  (check-str "integer literal" (digit-name 0) "zero")
  (check-str "negative literal" (digit-name -1) "minus one")
  (check-str "literal default" (digit-name 9) "many")
  (check-str "true and false cover bool" (yes-no false) "no")
  (check-true "character literals" (and (vowel? #\e) (not (vowel? #\z))))
  (check "string literals" (+ (* 10 (command "go")) (command "stop")) 12)
  (check "string literal default" (command "wander") 0)
  (check-str "a literal in a payload" (cell-cost (Open 1)) "cheap")
  (check-str "then a binding" (cell-cost (Open 9)) "dear")
  (check-str "a nullary variant" (cell-cost (Wall)) "blocked")
  (check "bool literals in a payload" (+ (* 10 (flags (Some true))) (flags (None))) 9)
  (check "a macro in an arm body" (arm-scope (Wrap 5)) 7)
  (check "an empty arm as a statement" (count-evens [1 2 3 4 6]) 3))

;; ---------------------------------------------------------------- if-let and friends

(defn port-or [(o (Option i64))] (-> i64)
  (if-let [(Some [p]) o] p 8080))

(defn code-or-zero [(r (Result i64 Fault))] (-> i64)
  (if-let [(Err [(C [c])]) r] c 0))

(defn seven? [(n i64)] (-> bool)
  (if-let [7 n] true false))

(defn while-let-total [] (-> i64)
  (let [(mut it) (range 0 6)
        (mut sum) 0]
    (while-let [(Some [x]) (next (mut it))]
      (when (= x 3) (continue))
      (set! sum (+ sum x)))
    sum))

(defn if-let-section [] (-> void)
  (section "if-let, when-let, while-let")
  (check "if-let matches" (port-or (Some 80)) 80)
  (check "if-let falls back" (port-or (None)) 8080)
  (check "a nested if-let pattern" (code-or-zero (Err (C 4))) 4)
  (check "a nested if-let miss" (code-or-zero (Err (A))) 0)
  (check-true "a literal if-let" (and (seven? 7) (not (seven? 8))))
  (let [(mut seen) 0]
    (when-let [(Some [x]) (Some 12)] (set! seen x))
    (when-let [(Some [x]) (: (None) (Option i64))] (set! seen (+ seen 1000)))
    (check "when-let runs only on a match" seen 12))
  (check "while-let with continue" (while-let-total) 12))

;; ---------------------------------------------------------------- try

(defn half [(n i64)] (-> (Result i64 i64))
  (if (= (% n 2) 0) (Ok (/ n 2)) (Err n)))

(defn parse [(s (slice u8))] (-> (Result i64 ParseError))
  (if (empty? s)
      (Err (Empty))
      (let [(mut n) 0
            (mut bad) -1]
        (for i (range 0 (len s))
          (let [c (get s i)]
            (if (and (>= c #\0) (<= c #\9))
                (set! n (+ (* n 10) (- (cast i64 c) #\0)))
                (when (< bad 0) (set! bad i)))))
        (if (< bad 0) (Ok n) (Err (NotADigit bad))))))

(defn add-strings [(a (slice u8)) (b (slice u8))] (-> (Result i64 ParseError))
  (try (Ok (+ (try! (parse a)) (try! (parse b))))))

(defn parse-code [(r (Result i64 ParseError))] (-> i64)
  (match r
    (Ok [v] v)
    (Err [(NotADigit [at])] (- -100 at))
    (Err [(Empty)] -1)))

(defn both-halves [(a i64) (b i64)] (-> (Result i64 i64))
  (let [x (: (try (Ok (try! (half a)))) (Result i64 i64))
        y (: (try (Ok (try! (half b)))) (Result i64 i64))]
    (match x
      (Ok [v] (match y (Ok [w] (Ok (+ v w))) (Err [e] (Err e))))
      (Err [e] (Err e)))))

(defn quarter-or-default [(a i64)] (-> (Result i64 i64))
  (try
    (let [inner (: (try (Ok (try! (half a)))) (Result i64 i64))]
      (match inner
        (Ok [v] (Ok (try! (half v))))
        (Err [_] (Ok -1))))))

(defn res-code [(r (Result i64 i64))] (-> i64)
  (match r (Ok [v] v) (Err [e] (- -1000 e))))

(defn first-two [(xs (slice i64))] (-> (Option i64))
  (try (Some (+ (try? (get-opt xs 0)) (try? (get-opt xs 1))))))

(defn get-opt [(xs (slice i64)) (i i64)] (-> (Option i64))
  (if (< i (len xs)) (Some (get xs i)) (None)))

(defn defaulted [(a i64)] (-> i64)
  (try (+ (try-or! (half a) 100) 1)))

(defn some-default [(xs (slice i64))] (-> i64)
  (try (some-or! (get-opt xs 2) 55)))

(defn ensured [(n i64)] (-> i64)
  (try (ensure! (> n 0) -9) (* n 2)))

(defn try-section [] (-> void)
  (section "Result, Option and try")
  (check "try! on two Ok values" (parse-code (add-strings "12" "30")) 42)
  (check "the first Err returns" (parse-code (add-strings "12" "3x")) -101)
  (check "an empty string" (parse-code (add-strings "" "1")) -1)
  (check "two try blocks in sequence" (res-code (both-halves 4 6)) 5)
  (check "the second fails" (res-code (both-halves 4 5)) -1005)
  (check "nested try blocks" (res-code (quarter-or-default 8)) 2)
  (check "the inner try catches" (res-code (quarter-or-default 3)) -1)
  (check "the outer try! returns" (res-code (quarter-or-default 6)) -1003)
  (check "try? on Some" (unwrap-or (first-two [3 4 5]) 0) 7)
  (check "try? on None" (unwrap-or (first-two [3]) -1) -1)
  (check "try-or! on Ok" (defaulted 8) 5)
  (check "try-or! on Err" (defaulted 7) 100)
  (check "some-or! on None" (some-default [1 2]) 55)
  (check "some-or! on Some" (some-default [1 2 3]) 3)
  (check "ensure! passes" (ensured 4) 8)
  (check "ensure! fails" (ensured 0) -9))

;; ---------------------------------------------------------------- combinators

(defn double [(x i64)] (-> i64) (* x 2))
(defn positive [(x i64)] (-> (Option i64)) (if (> x 0) (Some x) (None)))
(defn negate-error [(e i64)] (-> i64) (- e))

(defn combinators-section [] (-> void)
  (section "coil.result combinators")
  (let [s (: (Some 21) (Option i64))
        n (: (None) (Option i64))
        ok (: (Ok 4) (Result i64 i64))
        bad (: (Err 3) (Result i64 i64))]
    (check-true "some? and none?" (and (some? s) (none? n)))
    (check-true "ok? and err?" (and (ok? ok) (err? bad)))
    (check "unwrap-or on Some" (unwrap-or s 0) 21)
    (check "unwrap-or on None" (unwrap-or n 9) 9)
    (check "opt-map" (unwrap-or (opt-map s (fnptr-of double)) 0) 42)
    (check-true "opt-map on None stays None" (none? (opt-map n (fnptr-of double))))
    (check "and-then keeps" (unwrap-or (and-then s (fnptr-of positive)) 0) 21)
    (check "and-then drops" (unwrap-or (and-then (Some -3) (fnptr-of positive)) 0) 0)
    (check "res-map" (res-code (res-map ok (fnptr-of double))) 8)
    (check "res-map leaves Err" (res-code (res-map bad (fnptr-of double))) -1003)
    (check "map-err" (res-code (map-err bad (fnptr-of negate-error))) -997)
    (check "ok-or on Some" (res-code (ok-or s 5)) 21)
    (check "ok-or on None" (res-code (ok-or n 5)) -1005)
    (check-true "Option compares with =" (and (= s (Some 21)) (!= s n)))
    (check-true "Result compares with =" (= ok (Ok 4)))))

;; ---------------------------------------------------------------- keywords

(defsum Mode (Fixed [(kind Keyword) (n i64)]))

(defn speed [(mode Keyword)] (-> i64) (case mode :fast 3 :slow 1 0))
(defn pick-mode [(which Keyword) (n i64)] (-> i64) (if (= which :double) (* n 2) n))

(defn keywords-section [] (-> void)
  (section "keywords as values")
  (check-true "keywords compare" (and (= :fast :fast) (!= :fast :slow)))
  (check-true "keywords hash" (= (hash :a) (hash :a)))
  (check "case over keywords" (+ (* 100 (speed :slow)) (* 10 (speed :fast)) (speed :other)) 130)
  (check "a keyword passed positionally" (pick-mode :double 21) 42)
  (check "a keyword in a payload"
         (match (Fixed :turbo 9) (Fixed [kind n] (if (= kind :turbo) n 0)))
         9))

;; ---------------------------------------------------------------- never

(extern abort :cc (cc/C) [] (-> never))

(defn die [(why (slice u8))] (-> never)
  (println "dying: {}" why)
  (abort))

(defn checked-div [(a i64) (b i64)] (-> i64)
  (if (= b 0) (die "division by zero") (/ a b)))

(defsum Figure (Disc [(r i64)]) (Tile [(s i64)]) (Line))

(defn figure-area [(s Figure)] (-> i64)
  (match s
    (Disc [r] (* 3 r r))
    (Tile [s] (* s s))
    (Line [] (die "a line has no area"))))

(defn name-of [(n i64)] (-> (slice u8))
  (cond (= n 0) "zero" (= n 1) "one" :else (unreachable "too big: {}" n)))

(defn guarded [(fail (fnptr (cc/C) [(slice u8)] never)) (ok bool) (v i64)] (-> i64)
  (if ok v (fail "guard")))

(defn first-even [(xs (slice i64))] (-> i64)
  (block :found
    (for x xs (when (= (% x 2) 0) (return-from :found x)))
    (die "no even number")))

(defn same [T] [(x T)] (-> T) x)
(defn add3 [(a i64) (b i64) (c i64)] (-> i64) (+ a (+ b c)))
(defstruct Halves [(l i64) (r i64)])

;; A never value as an operand of another expression: the expression is never
;; computed, and nothing that would follow it is emitted on that path.
(defn never-operand [(which i64) (v i64)] (-> i64)
  (let [(mut cell) v
        xs [v 2 3]]
    (cond (= which 0) (add3 v (+ v 1) (die "a call argument"))
          (= which 1) (+ v (die "an arithmetic operand"))
          (= which 2) (do (set! cell (die "an assigned value")) cell)
          (= which 3) (primitive/index xs (die "an index"))
          (= which 4) (primitive/llvm-ir i64 [v (die "an llvm-ir operand")] "%r = add i64 $0, $1\n ret i64 %r")
          (= which 5) (let [ys (same [(array i64 2)] (die "a generic array argument"))] (primitive/index ys 0))
          (= which 6) (.r (Halves :l v :r (die "a field value")))
          (= which 7) (let [a (+ v 1) b (die "a binding") c (add3 a a a)] c)
          (= which 8) (if (< v (die "a condition")) 1 2)
          :else v)))

(defn never-section [] (-> void)
  (section "never")
  (check "never in an if branch" (checked-div 9 3) 3)
  (check "never in a match arm" (+ (figure-area (Disc :r 2)) (figure-area (Tile :s 3))) 21)
  (check-str "unreachable in a cond" (name-of 1) "one")
  (check "a fnptr to a never function" (guarded (fnptr-of die) true 7) 7)
  (check "never after a block" (first-even [3 5 8 9]) 8)
  (check "never as an operand, on a path not taken" (never-operand 9 5) 5))

;; ---------------------------------------------------------------- main

(defn main [] (-> i64)
  (store! (failures) 0)
  (variants-section)
  (recursion-section)
  (patterns-section)
  (if-let-section)
  (try-section)
  (combinators-section)
  (keywords-section)
  (never-section)
  (println "sums-match: {} failures" (load (failures)))
  (load (failures)))
