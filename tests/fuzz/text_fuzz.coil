(module text_fuzz)
(import "coil.prop" :use *)
(import "coil.primitive" :as primitive)
(import "coil.alloc" :as alloc :use *)
(import "coil.slice" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.dbgalloc" :use [debug-allocator-init debug-allocator-view debug-allocator-deinit!])
(import "coil.str" :as str)
(import "coil.unicode.grapheme" :as grapheme)
(import "coil.unicode.grapheme-data" :as data)


; Fuzz target for coil.unicode.grapheme and coil.str.
;
; Every property builds its input from CODE POINTS (or from structured byte
; alphabets), and compares the library against an independent reference written
; here. Generated byte buffers are copied into exactly-sized `prop-alloc`
; allocations so that, under `--sanitize=address` (tracked allocation), any read
; past the end of the input is reported.

; ───────────────────────────── generation helpers ─────────────────────────────

;;; An exactly-sized copy of an ArrayList's bytes, allocated per value.
(defn exact-bytes [(s (ptr Source)) (l (ArrayList u8))] (-> (slice u8))
  (let [n (al-len l)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! (primitive/index buf (load i)) (al-get l (load i)))
                (store! i (+ (load i) 1)))))
    (slice-new [u8] buf n)))

;;; Reference UTF-8 encoder (independent of str/string-push-rune!).
(defn enc-cp! [(out (mut (ArrayList u8))) (cp i64)] (-> i64)
  (cond (< cp 128) (al-push! (mut out) (primitive/cast u8 cp))
        (< cp 2048)
          (do
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 192 (primitive/ishr cp 6))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand cp 63)))))
        (< cp 65536)
          (do
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 224 (primitive/ishr cp 12))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr cp 6) 63))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand cp 63)))))
        :else
          (do
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 240 (primitive/ishr cp 18))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr cp 12) 63))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr cp 6) 63))))
            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand cp 63)))))))

(defn enc-len [(cp i64)] (-> i64)
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))

;;; Any Unicode scalar value (surrogates mapped out of the way).
(defn any-scalar [(s (ptr Source))] (-> i64)
  (let [v (draw-int! s 0 1112063)]
    (if (>= v 55296) (+ v 2048) v)))

;;; One code point from a range that matters to UAX #29 or to UTF-8 encoding.
(defn draw-cp [(s (ptr Source))] (-> i64)
  (let [k (draw-int! s 0 39)]
    (case k
      0 (draw-int! s 97 122)            ; ascii letters
      1 13                              ; CR
      2 10                              ; LF
      3 (draw-int! s 0 31)              ; C0 controls
      4 (draw-int! s 127 159)           ; DEL + C1
      5 (draw-int! s 768 879)           ; combining diacriticals (Extend)
      6 8205                            ; ZWJ
      7 8204                            ; ZWNJ
      8 (draw-int! s 127744 128767)     ; emoji 1F300-1F6FF (ExtPict)
      9 (draw-int! s 9728 10175)        ; misc symbols/dingbats 2600-27BF
      10 (draw-int! s 127995 127999)    ; skin tone modifiers (Extend)
      11 (draw-int! s 127462 127487)    ; regional indicators
      12 (draw-int! s 4352 4447)        ; Hangul L
      13 (draw-int! s 4448 4519)        ; Hangul V
      14 (draw-int! s 4520 4607)        ; Hangul T
      15 (draw-int! s 44032 55203)      ; Hangul syllables LV/LVT
      16 (draw-int! s 1536 1541)        ; Arabic prepend
      17 (draw-int! s 2304 2431)        ; Devanagari block (consonant/linker/marks)
      18 2381                           ; Devanagari virama (InCB linker)
      19 (draw-int! s 2325 2361)        ; Devanagari consonants
      20 (draw-int! s 2432 2559)        ; Bengali block
      21 (draw-int! s 3328 3455)        ; Malayalam block
      22 (draw-int! s 917536 917631)    ; tag characters (Extend)
      23 65039                          ; VS16
      24 (draw-int! s 65024 65039)      ; variation selectors
      25 (any-scalar s)                 ; anything
      26 (draw-int! s 126 130)          ; 1/2 byte boundary
      27 (draw-int! s 2046 2050)        ; 2/3 byte boundary
      28 (draw-int! s 55290 55295)      ; just below surrogates
      29 (draw-int! s 57344 57350)      ; just above surrogates
      30 (draw-int! s 65533 65537)      ; 3/4 byte boundary
      31 (draw-int! s 1114105 1114111)  ; top of range
      32 173                            ; soft hyphen (Control)
      33 (draw-int! s 8232 8233)        ; line/paragraph separator (Control)
      34 (draw-int! s 69821 69837)      ; Kaithi prepend-ish 110BD..
      35 (draw-int! s 3584 3711)        ; Thai
      36 (draw-int! s 129280 129535)    ; supplemental symbols 1F900
      37 (draw-int! s 3840 4095)        ; Tibetan
      38 (draw-int! s 6656 6911)        ; Tai Tham etc.
      (draw-int! s 43008 43263))))      ; misc Indic

;;; A list of code points; each is its own ELEM span.
(defn draw-cps [(s (ptr Source)) (maxn i64)] (-> (ArrayList i64))
  (let [sp (span-open! s "cps" SPAN-PLAIN)
        n (draw-len! s 0 maxn)
        (mut l) (al-new [i64] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "cp" SPAN-ELEM)]
                (al-push! (mut l) (draw-cp s))
                (span-close! s esp)
                (store! i (+ (load i) 1))
                0)))
    (span-close! s sp)
    (load l)))

;;; Encode code points into an exactly-sized buffer.
(defn encode-cps [(s (ptr Source)) (cps (ArrayList i64))] (-> (slice u8))
  (let [(mut out) (al-new [u8] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) (al-len cps))
              (break)
              (do
                (enc-cp! (mut out) (al-get cps (load i)))
                (store! i (+ (load i) 1)))))
    (exact-bytes s (load out))))

(defn bytes-eq [(a (slice u8)) (b (slice u8))] (-> bool)
  (if (!= (slice-len a) (slice-len b))
      false
      (let [(mut i) 0 (mut ok) true]
        (loop (if (>= (load i) (slice-len a))
                  (break)
                  (if (!= (slice-get a (load i)) (slice-get b (load i)))
                      (do (store! ok false) (break))
                      (store! i (+ (load i) 1)))))
        (load ok))))

; ─────────────────── argument types (so counterexamples print) ──────────────────
;
; Every generated input is a property ARGUMENT with its own Arbitrary and Debug
; impl, so a minimized counterexample shows the actual code points / bytes.

(defn show-hex-bytes [(f (ptr Formatter)) (b (slice u8))] (-> i64)
  (formatter-write f "[")
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len b))
              (break)
              (do (if (> (load i) 0) (do (formatter-write f " ") 0) 0)
                  (print-hex (formatter-writer f) (primitive/cast i64 (slice-get b (load i))))
                  (store! i (+ (load i) 1))))))
  (formatter-write f "]")
  0)

;;; A sequence of Unicode scalars from UAX #29-relevant ranges.
(defstruct Cps [(v (ArrayList i64))])
(impl Arbitrary Cps
  (arbitrary [(out (mut Cps)) (s (ptr Source))] (-> i64)
             (store! (field out v) (draw-cps s 32))
             0))
(impl Debug Cps
  (debug-fmt [(x Cps) (f (ptr Formatter))] (-> i64)
             (formatter-write f "[")
             (let [l (load (field x v)) (mut i) 0]
               (loop (if (>= (load i) (al-len l))
                         (break)
                         (do (if (> (load i) 0) (do (formatter-write f " ") 0) 0)
                             (formatter-write f "U+")
                             (print-hex (formatter-writer f) (al-get l (load i)))
                             (store! i (+ (load i) 1))))))
             (formatter-write f "]")
             0))

;;; Bytes: structured UTF-8-ish pieces (valid, truncated, overlong, surrogate…).
(defstruct Utf8ish [(b (slice u8))])
(impl Arbitrary Utf8ish
  (arbitrary [(out (mut Utf8ish)) (s (ptr Source))] (-> i64)
             (store! (field out b) (draw-utf8ish s 16))
             0))
(impl Debug Utf8ish
  (debug-fmt [(x Utf8ish) (f (ptr Formatter))] (-> i64) (show-hex-bytes f (load (field x b)))))

;;; Bytes from a small alphabet (0..20 long) and a tiny one (0..4 long).
(defstruct Small [(b (slice u8))])
(impl Arbitrary Small
  (arbitrary [(out (mut Small)) (s (ptr Source))] (-> i64)
             (store! (field out b) (draw-small s 20))
             0))
(impl Debug Small
  (debug-fmt [(x Small) (f (ptr Formatter))] (-> i64) (show-hex-bytes f (load (field x b)))))
(defstruct Tiny [(b (slice u8))])
(impl Arbitrary Tiny
  (arbitrary [(out (mut Tiny)) (s (ptr Source))] (-> i64)
             (store! (field out b) (draw-small s 4))
             0))
(impl Debug Tiny
  (debug-fmt [(x Tiny) (f (ptr Formatter))] (-> i64) (show-hex-bytes f (load (field x b)))))

;;; Decimal-ish text.
(defstruct NumText [(b (slice u8))])
(impl Arbitrary NumText
  (arbitrary [(out (mut NumText)) (s (ptr Source))] (-> i64)
             (store! (field out b) (draw-numish s 24))
             0))
(impl Debug NumText
  (debug-fmt [(x NumText) (f (ptr Formatter))] (-> i64) (show-hex-bytes f (load (field x b)))))

;;; An i64 biased toward decimal-width and overflow boundaries.
(defstruct Wide [(v i64)])
(impl Arbitrary Wide
  (arbitrary [(out (mut Wide)) (s (ptr Source))] (-> i64)
             (store! (field out v) (draw-i64 s))
             0))
(impl Debug Wide
  (debug-fmt [(x Wide) (f (ptr Formatter))] (-> i64)
             (print-i (formatter-writer f) (load (field x v)))
             0))

;;; Text with lots of ASCII whitespace and near-whitespace.
(defstruct WsText [(b (slice u8))])
(impl Arbitrary WsText
  (arbitrary [(out (mut WsText)) (s (ptr Source))] (-> i64)
             (store! (field out b) (draw-ws s 16))
             0))
(impl Debug WsText
  (debug-fmt [(x WsText) (f (ptr Formatter))] (-> i64) (show-hex-bytes f (load (field x b)))))

;;; One operation of a stateful model test; `a`/`b` are raw draws that the
;;; interpreter maps onto the current state, `bytes` is a payload.
(defstruct Op [(kind i64) (a i64) (b i64) (bytes (slice u8))])
(defstruct Ops [(v (ArrayList Op))])
(impl Debug Ops
  (debug-fmt [(x Ops) (f (ptr Formatter))] (-> i64)
             (let [l (load (field x v)) (mut i) 0]
               (loop (if (>= (load i) (al-len l))
                         (break)
                         (let [op (al-get l (load i))]
                           (formatter-write f "\n      (")
                           (print-i (formatter-writer f) (.kind op))
                           (formatter-write f " a=")
                           (print-i (formatter-writer f) (.a op))
                           (formatter-write f " b=")
                           (print-i (formatter-writer f) (.b op))
                           (formatter-write f " ")
                           (show-hex-bytes f (.bytes op))
                           (formatter-write f ")")
                           (store! i (+ (load i) 1))))))
             0))

;;; A list of ops; `gen-op` draws one op's fields (inside an ELEM span).
(defn draw-ops [(s (ptr Source)) (gen-op (fnptr c [(ptr Source)] Op))] (-> Ops)
  (let [sp (span-open! s "ops" SPAN-PLAIN)
        n (draw-len! s 0 24)
        (mut l) (al-new [Op] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "op" SPAN-ELEM)]
                (al-push! (mut l) (gen-op s))
                (span-close! s esp)
                (store! i (+ (load i) 1))
                0)))
    (span-close! s sp)
    (Ops :v (load l))))

;;; String ops: 0 push-view, 1 push-rune, 2 pop-rune, 3 truncate, 4 remove,
;;; 5 clear, 6 take, 7 clone, 8 reserve, 9 into-bytes (of a clone).
(defn gen-string-op [(s (ptr Source))] (-> Op)
  (let [k (draw-int! s 0 9)]
    (case k
      0 (Op :kind 0 :a 0 :b 0 :bytes (encode-cps s (draw-cps s 4)))
      1 (Op :kind 1 :a (draw-cp s) :b 0 :bytes "")
      3 (Op :kind 3 :a (draw-int! s 0 1000) :b 0 :bytes "")
      4 (let [x (draw-int! s 0 1000)] (Op :kind 4 :a x :b (draw-int! s 0 1000) :bytes ""))
      8 (Op :kind 8 :a (draw-int! s 0 40) :b 0 :bytes "")
      (Op :kind k :a 0 :b 0 :bytes ""))))

(defstruct StringOps [(ops Ops)])
(impl Arbitrary StringOps
  (arbitrary [(out (mut StringOps)) (s (ptr Source))] (-> i64)
             (store! (field out ops) (draw-ops s (primitive/fnptr-of gen-string-op)))
             0))
(impl Debug StringOps
  (debug-fmt [(x StringOps) (f (ptr Formatter))] (-> i64) (debug-fmt (load (field x ops)) f)))

;;; StrBuf ops: 0 push-str, 1 push-byte, 2 push-i64, 3 push! (trait).
(defn gen-strbuf-op [(s (ptr Source))] (-> Op)
  (let [k (draw-int! s 0 3)]
    (case k
      0 (Op :kind 0 :a 0 :b 0 :bytes (draw-small s 8))
      2 (Op :kind 2 :a (draw-i64 s) :b 0 :bytes "")
      (Op :kind k :a (draw-int! s 0 255) :b 0 :bytes ""))))

(defstruct StrBufOps [(ops Ops)])
(impl Arbitrary StrBufOps
  (arbitrary [(out (mut StrBufOps)) (s (ptr Source))] (-> i64)
             (store! (field out ops) (draw-ops s (primitive/fnptr-of gen-strbuf-op)))
             0))
(impl Debug StrBufOps
  (debug-fmt [(x StrBufOps) (f (ptr Formatter))] (-> i64) (debug-fmt (load (field x ops)) f)))

; ─────────────────────────── grapheme reference model ──────────────────────────

(defn gcb [(cp i64)] (-> i64) (data/grapheme-break-property (primitive/cast u32 cp)))
(defn incb [(cp i64)] (-> i64) (data/indic-conjunct-break-property (primitive/cast u32 cp)))
(defn ext-pict? [(cp i64)] (-> bool) (= (data/extended-pictographic? (primitive/cast u32 cp)) 1))

(defn ctl? [(p i64)] (-> bool) (or (= p 1) (or (= p 2) (= p 3))))

;;; GB9c by explicit look-behind over the whole sequence.
(defn gb9c? [(cps (ArrayList i64)) (i i64)] (-> bool)
  (if (!= (incb (al-get cps i)) 1)
      false
      (let [(mut j) (- i 1) (mut linker) false (mut res) false]
        (loop (if (< (load j) 0)
                  (break)
                  (let [v (incb (al-get cps (load j)))]
                    (cond (= v 3) (do (store! linker true) (store! j (- (load j) 1)))
                          (= v 2) (store! j (- (load j) 1))
                          (= v 1) (do (store! res (load linker)) (break))
                          :else (break)))))
        (load res))))

;;; GB11 by explicit look-behind: ExtPict Extend* ZWJ × ExtPict.
(defn gb11? [(cps (ArrayList i64)) (i i64)] (-> bool)
  (if (not (and (ext-pict? (al-get cps i)) (= (gcb (al-get cps (- i 1))) 5)))
      false
      (let [(mut j) (- i 2) (mut res) false]
        (loop (if (< (load j) 0)
                  (break)
                  (let [c (al-get cps (load j))]
                    (cond (ext-pict? c) (do (store! res true) (break))
                          (= (gcb c) 4) (store! j (- (load j) 1))
                          :else (break)))))
        (load res))))

;;; Number of consecutive RIs immediately before position i.
(defn ri-run [(cps (ArrayList i64)) (i i64)] (-> i64)
  (let [(mut j) (- i 1) (mut n) 0]
    (loop (if (and (>= (load j) 0) (= (gcb (al-get cps (load j))) 6))
              (do (store! n (+ (load n) 1)) (store! j (- (load j) 1)))
              (break)))
    (load n)))

;;; Is there a grapheme boundary between cps[i-1] and cps[i]?
(defn model-break? [(cps (ArrayList i64)) (i i64)] (-> bool)
  (let [p (gcb (al-get cps (- i 1)))
        c (gcb (al-get cps i))]
    (cond (and (= p 1) (= c 2)) false
          (or (ctl? p) (ctl? c)) true
          (and (= p 9) (or (= c 9) (or (= c 10) (or (= c 12) (= c 13))))) false
          (and (or (= p 12) (= p 10)) (or (= c 10) (= c 11))) false
          (and (or (= p 13) (= p 11)) (= c 11)) false
          (or (= c 4) (= c 5)) false
          (= c 8) false
          (= p 7) false
          (gb9c? cps i) false
          (gb11? cps i) false
          (and (= p 6) (and (= c 6) (= (primitive/irem (ri-run cps i) 2) 1))) false
          :else true)))

;;; Segment with the library, returning byte end-offsets of every cluster.
(defn lib-ends [(s (ptr Source)) (text str/StringView)] (-> (ArrayList i64))
  (let [(mut out) (al-new [i64] (src-alloc s))
        (mut it) (iter (grapheme/chars text))
        (mut off) 0]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [ch]
                  (do
                    (store! off (+ (load off) (str/string-view-byte-len (grapheme/char-view ch))))
                    (al-push! (mut out) (load off))
                    0))))
    (load out)))

;;; Model byte end-offsets.
(defn model-ends [(s (ptr Source)) (cps (ArrayList i64))] (-> (ArrayList i64))
  (let [(mut out) (al-new [i64] (src-alloc s))
        n (al-len cps)
        (mut off) 0
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (do
                (store! off (+ (load off) (enc-len (al-get cps (load i)))))
                (if (or (= (+ (load i) 1) n) (model-break? cps (+ (load i) 1)))
                    (al-push! (mut out) (load off))
                    0)
                (store! i (+ (load i) 1)))))
    (load out)))

(defn i64-lists-eq [(a (ArrayList i64)) (b (ArrayList i64))] (-> bool)
  (if (!= (al-len a) (al-len b))
      false
      (let [(mut i) 0 (mut ok) true]
        (loop (if (>= (load i) (al-len a))
                  (break)
                  (if (!= (al-get a (load i)) (al-get b (load i)))
                      (do (store! ok false) (break))
                      (store! i (+ (load i) 1)))))
        (load ok))))

; ───────────────────────────── grapheme properties ─────────────────────────────

;; The library's segmentation equals the look-behind model of UAX #29.
(defprop grapheme-matches-model [(input Cps)]
  (let [s (prop-src)
        cps (load (field input v))
        bytes (encode-cps s cps)
        text (str/string-view-unchecked bytes)]
    (i64-lists-eq (lib-ends s text) (model-ends s cps))))

;; Clusters are non-empty, contiguous views of the input, start on scalar
;; boundaries, and together cover the whole input; a cluster re-segmented on its
;; own is one cluster; the Char Eq/Hash agree with the view's.
(defprop grapheme-clusters-tile-input [(input Cps)]
  (let [s (prop-src)
        cps (load (field input v))
        bytes (encode-cps s cps)
        text (str/string-view-unchecked bytes)
        n (slice-len bytes)
        (mut it) (iter (grapheme/chars text))
        (mut off) 0
        (mut ok) true]
    (loop (match (next (mut it))
            (None [] (break))
            (Some [ch]
                  (let [v (grapheme/char-view ch)
                        vb (str/string-view-bytes v)
                        len (slice-len vb)]
                    (cond (= len 0) (do (store! ok false) (break))
                          ; contiguous: the view points at input[off..off+len]
                          (!= (primitive/cast i64 (slice-data vb))
                              (+ (primitive/cast i64 (slice-data bytes)) (load off)))
                            (do (store! ok false) (break))
                          (> (+ (load off) len) n) (do (store! ok false) (break))
                          (str/utf8-cont? (slice-get vb 0)) (do (store! ok false) (break))
                          :else
                            (let [(mut it2) (iter (grapheme/chars v))
                                  one (match (next (mut it2))
                                        (None [] false)
                                        (Some [c2] (= (grapheme/char-view c2) v)))
                                  done (match (next (mut it2)) (None [] true) (Some [_] false))]
                              (if (and one (and done (and (= ch ch) (= (hash ch) (hash v)))))
                                  (store! off (+ (load off) len))
                                  (do (store! ok false) (break)))))))))
    (and (load ok) (= (load off) n))))

;; grapheme-next-offset from any scalar boundary lands on a later scalar boundary
;; within the input (never past the end), on arbitrary valid UTF-8.
(defprop grapheme-next-offset-bounded [(input Cps)]
  (let [s (prop-src)
        cps (load (field input v))
        bytes (encode-cps s cps)
        text (str/string-view-unchecked bytes)
        n (slice-len bytes)
        (mut off) 0
        (mut ok) true]
    (loop (if (>= (load off) n)
              (break)
              (let [e (grapheme/grapheme-next-offset text (load off))]
                (if (or (<= e (load off))
                        (or (> e n)
                            (and (< e n) (str/utf8-cont? (slice-get bytes e)))))
                    (do (store! ok false) (break))
                    ; advance by one scalar, not one cluster: every start is legal
                    (store! off (+ (load off) (str/utf8-scalar-width (slice-get bytes (load off)))))))))
    (and (load ok) (= (grapheme/grapheme-next-offset text n) n))))

; ─────────────────────────────── UTF-8 validation ──────────────────────────────

;;; Interesting bytes for UTF-8 validators: every range boundary of the lead and
;;; continuation tables.
(defn edge-byte [(s (ptr Source))] (-> i64)
  (let [k (draw-int! s 0 23)]
    (case k
      0 0 1 127 2 128 3 143 4 144 5 159 6 160 7 191 8 192 9 193 10 194 11 223
      12 224 13 225 14 236 15 237 16 238 17 239 18 240 19 241 20 243 21 244 22 245
      255)))

;;; Bytes built from pieces: valid encodings, edge bytes, truncated encodings,
;;; overlong encodings, surrogates and >U+10FFFF — the things a validator gets wrong.
(defn draw-utf8ish [(s (ptr Source)) (maxn i64)] (-> (slice u8))
  (let [sp (span-open! s "pieces" SPAN-PLAIN)
        n (draw-len! s 0 maxn)
        (mut out) (al-new [u8] (src-alloc s))
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "piece" SPAN-ELEM)
                    k (draw-int! s 0 7)]
                (case k
                  0 (enc-cp! (mut out) (draw-cp s))
                  1 (enc-cp! (mut out) (draw-cp s))
                  2 (al-push! (mut out) (primitive/cast u8 (edge-byte s)))
                  3 (al-push! (mut out) (primitive/cast u8 (draw-int! s 0 255)))
                  ; truncated: a valid multi-byte encoding minus its tail
                  4 (let [(mut tmp) (al-new [u8] (src-alloc s))
                          cp (draw-int! s 128 1114111)]
                      (enc-cp! (mut tmp) (if (and (>= cp 55296) (<= cp 57343)) 65 cp))
                      (let [keep (draw-int! s 1 (- (al-len (load tmp)) 1))
                            (mut j) 0]
                        (loop (if (>= (load j) keep)
                                  (break)
                                  (do (al-push! (mut out) (al-get (load tmp) (load j)))
                                      (store! j (+ (load j) 1)))))
                        0))
                  ; overlong: encode a small value with too many bytes
                  5 (let [w (draw-int! s 2 4)
                          v (draw-int! s 0 (case w 2 127 3 2047 65535))]
                      (case w
                        2 (do (al-push! (mut out) (primitive/cast u8 (primitive/ior 192 (primitive/ishr v 6))))
                              (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand v 63)))))
                        3 (do (al-push! (mut out) (primitive/cast u8 (primitive/ior 224 (primitive/ishr v 12))))
                              (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr v 6) 63))))
                              (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand v 63)))))
                        (do (al-push! (mut out) (primitive/cast u8 (primitive/ior 240 (primitive/ishr v 18))))
                            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr v 12) 63))))
                            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand (primitive/ishr v 6) 63))))
                            (al-push! (mut out) (primitive/cast u8 (primitive/ior 128 (primitive/iand v 63)))))))
                  ; surrogate, encoded as if it were a scalar
                  6 (enc-cp! (mut out) (draw-int! s 55296 57343))
                  ; beyond U+10FFFF, 4-byte form (up to F7 BF BF BF)
                  (enc-cp! (mut out) (draw-int! s 1114112 2097151)))
                (span-close! s esp)
                (store! i (+ (load i) 1))
                0)))
    (span-close! s sp)
    (exact-bytes s (load out))))

(defn cont-byte? [(b i64)] (-> bool) (= (primitive/iand b 192) 128))

;;; Reference: decode-then-check. Returns the offset of the first ill-formed
;;; sequence, or -1. Scalars decoded are appended to `cps`.
(defn ref-validate [(bytes (slice u8)) (cps (mut (ArrayList i64)))] (-> i64)
  (let [n (slice-len bytes)
        (mut i) 0
        (mut bad) -1]
    (loop (if (>= (load i) n)
              (break)
              (let [b0 (primitive/cast i64 (slice-get bytes (load i)))
                    len (cond (< b0 128) 1
                              (= (primitive/iand b0 224) 192) 2
                              (= (primitive/iand b0 240) 224) 3
                              (= (primitive/iand b0 248) 240) 4
                              :else 0)
                    init (case len 1 b0 2 (primitive/iand b0 31) 3 (primitive/iand b0 15) (primitive/iand b0 7))
                    minv (case len 1 0 2 128 3 2048 65536)]
                (if (or (= len 0) (> (+ (load i) len) n))
                    (do (store! bad (load i)) (break))
                    (let [(mut cp) init (mut k) 1 (mut ok) true]
                      (loop (if (>= (load k) len)
                                (break)
                                (let [b (primitive/cast i64 (slice-get bytes (+ (load i) (load k))))]
                                  (if (cont-byte? b)
                                      (do (store! cp (primitive/ior (primitive/ishl (load cp) 6) (primitive/iand b 63)))
                                          (store! k (+ (load k) 1)))
                                      (do (store! ok false) (break))))))
                      (if (and (load ok)
                               (and (>= (load cp) minv)
                                    (and (<= (load cp) 1114111)
                                         (not (and (>= (load cp) 55296) (<= (load cp) 57343))))))
                          (do (al-push! (mut cps) (load cp)) (store! i (+ (load i) len)))
                          (do (store! bad (load i)) (break))))))))
    (load bad)))

;; string-view-from-utf8 agrees with a decode-then-check reference on
;; acceptance and on the reported offset; on acceptance, rune iteration,
;; string-index-at-byte and string-view-next-rune-index agree with the decode.
(defprop utf8-validate-matches-reference [(input Utf8ish)]
  (let [s (prop-src)
        bytes (load (field input b))
        (mut cps) (al-new [i64] (src-alloc s))
        want (ref-validate bytes (mut cps))]
    (match (str/string-view-from-utf8 bytes)
      (Err [e] (and (= (str/utf8-error-offset e) want) (= (str/utf8-error-len e) 1)))
      (Ok [v]
          (if (!= want -1)
              false
              (let [(mut it) (iter v)
                    (mut k) 0
                    (mut ok) true
                    n (slice-len bytes)]
                (loop (match (next (mut it))
                        (None [] (break))
                        (Some [r]
                              (if (or (>= (load k) (al-len (load cps)))
                                      (!= (primitive/cast i64 (str/rune-value r)) (al-get (load cps) (load k))))
                                  (do (store! ok false) (break))
                                  (store! k (+ (load k) 1))))))
                ; index-at-byte: Some exactly at scalar boundaries in [0, n]
                (let [(mut b) -2]
                  (loop (if (> (load b) (+ n 1))
                            (break)
                            (let [want-some (and (>= (load b) 0)
                                                 (or (= (load b) n)
                                                     (and (< (load b) n)
                                                          (not (cont-byte? (primitive/cast i64 (slice-get bytes (load b))))))))
                                  got (match (str/string-index-at-byte v (load b))
                                        (None [] false)
                                        (Some [ix] (= (str/string-index-byte-offset ix) (load b))))]
                              (if (!= want-some got) (store! ok false) 0)
                              ; next-rune-index from a boundary
                              (if (and want-some (< (load b) n))
                                  (match (str/string-view-next-rune-index v (str/StringIndex :byte_offset (load b)))
                                    (None [] (store! ok false))
                                    (Some [nx]
                                          (let [e (str/string-index-byte-offset nx)]
                                            (if (or (> e n) (<= e (load b))
                                                    (and (< e n) (cont-byte? (primitive/cast i64 (slice-get bytes e)))))
                                                (store! ok false)
                                                0))))
                                  0)
                              (store! b (+ (load b) 1))))))
                (and (load ok) (= (load k) (al-len (load cps))))))))))

;; rune-new accepts exactly the Unicode scalar values.
(defprop rune-new-accepts-scalars [(v u32)]
  (let [x (primitive/cast i64 v)
        want (and (<= x 1114111) (not (and (>= x 55296) (<= x 57343))))]
    (match (str/rune-new v)
      (None [] (not want))
      (Some [r] (and want (= (str/rune-value r) v))))))

;; Encoding scalars through String/TextWrite matches the reference encoder,
;; validates, iterates back to the same scalars, and pops them in reverse.
(defprop string-rune-round-trip [(input Cps)]
  (let [s (prop-src)
        cps (load (field input v))
        want (encode-cps s cps)
        a (src-alloc s)
        (mut text) (str/string-new a)
        (mut i) 0]
    (loop (if (>= (load i) (al-len cps))
              (break)
              (do
                (match (str/rune-new (primitive/cast u32 (al-get cps (load i))))
                  (None [] 0)
                  (Some [r] (do (write-rune! (mut text) r) 0)))
                (store! i (+ (load i) 1)))))
    (let [got (str/string-view-bytes (str/string-as-view (load text)))
          valid (match (str/string-view-from-utf8 got) (Ok [_] true) (Err [_] false))
          (mut ok) (and valid (bytes-eq got want))
          (mut j) (- (al-len cps) 1)]
      (loop (if (< (load j) 0)
                (break)
                (match (str/string-pop-rune! (mut text))
                  (None [] (do (store! ok false) (break)))
                  (Some [r] (do
                              (if (!= (primitive/cast i64 (str/rune-value r)) (al-get cps (load j)))
                                  (store! ok false)
                                  0)
                              (store! j (- (load j) 1)))))))
      (let [empty (match (str/string-pop-rune! (mut text)) (None [] true) (Some [_] false))]
        (str/string-free! (mut text))
        (and (load ok) empty)))))

; ──────────────────────────── integers ↔ decimal text ───────────────────────────

;;; Reference decimal formatting: signed remainders, so i64-min needs no negation.
(defn ref-fmt [(s (ptr Source)) (v i64)] (-> (slice u8))
  (let [(mut rev) (al-new [u8] (src-alloc s))
        (mut x) v]
    (if (= v 0) (al-push! (mut rev) (primitive/cast u8 48)) 0)
    (loop (if (= (load x) 0)
              (break)
              (let [r (primitive/irem (load x) 10)
                    d (if (< r 0) (primitive/isub 0 r) r)]
                (al-push! (mut rev) (primitive/cast u8 (+ d 48)))
                (store! x (primitive/idiv (load x) 10)))))
    (if (< v 0) (al-push! (mut rev) (primitive/cast u8 45)) 0)
    (let [(mut out) (al-new [u8] (src-alloc s))
          (mut i) (- (al-len (load rev)) 1)]
      (loop (if (< (load i) 0)
                (break)
                (do (al-push! (mut out) (al-get (load rev) (load i)))
                    (store! i (- (load i) 1)))))
      (exact-bytes s (load out)))))

;;; An i64 biased toward the decimal-width and overflow boundaries.
(defn draw-i64 [(s (ptr Source))] (-> i64)
  (let [k (draw-int! s 0 5)]
    (case k
      0 (draw-int-any! s)
      1 (draw-int! s -1000 1000)
      2 (primitive/iadd (draw-int! s -3 3) (if (draw-bool! s) 9223372036854775807 -9223372036854775808))
      ; ±10^k ± small
      3 (let [e (draw-int! s 0 18)
              (mut p) 1
              (mut j) 0]
          (loop (if (>= (load j) e) (break) (do (store! p (* (load p) 10)) (store! j (+ (load j) 1)))))
          (primitive/imul (if (draw-bool! s) 1 -1) (primitive/iadd (load p) (draw-int! s -2 2))))
      (draw-int-any! s))))

;; sb-push-i64! formats every i64 like the reference, and str-parse-int reads
;; it back to the same value (including i64-min and i64-max).
(defprop i64-format-parse-round-trip [(w Wide)]
  (let [s (prop-src)
        v (load (field w v))
        (mut sb) (str/sb-new (src-alloc s))]
    (str/sb-push-i64! (mut sb) v)
    (let [got (str/sb-str (load sb))
          want (ref-fmt s v)
          same (bytes-eq got want)
          back (match (str/str-parse-int got) (None [] false) (Some [x] (= x v)))]
      (str/sb-free! (mut sb))
      (and same back))))

;;; Decimal-ish text: digits, signs, whitespace, and the odd letter.
(defn draw-numish [(s (ptr Source)) (maxn i64)] (-> (slice u8))
  (let [sp (span-open! s "num" SPAN-PLAIN)
        n (draw-len! s 0 maxn)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "ch" SPAN-ELEM)
                    k (draw-int! s 0 9)
                    c (case k
                        0 45                  ; '-'
                        1 43                  ; '+'
                        2 32                  ; ' '
                        3 (draw-int! s 0 255)
                        4 (draw-int! s 47 58) ; '/', digits, ':'
                        (draw-int! s 48 57))]
                (store! (primitive/index buf (load i)) (primitive/cast u8 c))
                (span-close! s esp)
                (store! i (+ (load i) 1))
                0)))
    (span-close! s sp)
    (slice-new [u8] buf n)))

;;; Reference parse: optional '-', then one or more digits and nothing else; the
;;; value is the documented wrapping (mod 2^64) result, accumulated from the RIGHT.
(defn ref-parse-int [(t (slice u8))] (-> (Option i64))
  (let [n (slice-len t)
        neg (and (> n 0) (= (primitive/cast i64 (slice-get t 0)) 45))
        start (if neg 1 0)]
    (if (>= start n)
        (None)
        (let [(mut i) (- n 1)
              (mut acc) 0
              (mut place) 1
              (mut ok) true]
          (loop (if (< (load i) start)
                    (break)
                    (let [c (primitive/cast i64 (slice-get t (load i)))]
                      (if (and (>= c 48) (<= c 57))
                          (do (store! acc (primitive/iadd (load acc) (primitive/imul (- c 48) (load place))))
                              (store! place (primitive/imul (load place) 10))
                              (store! i (- (load i) 1)))
                          (do (store! ok false) (break))))))
          (if (load ok)
              (Some (if neg (primitive/isub 0 (load acc)) (load acc)))
              (None))))))

(defn opt-i64-eq [(a (Option i64)) (b (Option i64))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (= x y))))))

;; str-parse-int agrees with the reference on arbitrary decimal-ish text.
(defprop parse-int-matches-reference [(input NumText)]
  (let [t (load (field input b))]
    (opt-i64-eq (str/str-parse-int t) (ref-parse-int t))))

; ──────────────────────────── search / split / compare ─────────────────────────

;;; Bytes from a tiny alphabet so that matches are frequent, plus a multi-byte
;;; scalar and a NUL.
(defn draw-small [(s (ptr Source)) (maxn i64)] (-> (slice u8))
  (let [sp (span-open! s "small" SPAN-PLAIN)
        n (draw-len! s 0 maxn)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "ch" SPAN-ELEM)
                    k (draw-int! s 0 6)
                    c (case k 0 97 1 98 2 97 3 32 4 0 5 195 (draw-int! s 0 255))]
                (store! (primitive/index buf (load i)) (primitive/cast u8 c))
                (span-close! s esp)
                (store! i (+ (load i) 1))
                0)))
    (span-close! s sp)
    (slice-new [u8] buf n)))

(defn ref-match-at? [(h (slice u8)) (nd (slice u8)) (i i64)] (-> bool)
  (let [(mut k) 0 (mut ok) true]
    (loop (if (>= (load k) (slice-len nd))
              (break)
              (if (!= (slice-get h (+ i (load k))) (slice-get nd (load k)))
                  (do (store! ok false) (break))
                  (store! k (+ (load k) 1)))))
    (load ok)))

(defn ref-find [(h (slice u8)) (nd (slice u8)) (from i64)] (-> i64)
  (let [(mut i) from (mut r) -1]
    (loop (if (> (+ (load i) (slice-len nd)) (slice-len h))
              (break)
              (if (ref-match-at? h nd (load i))
                  (do (store! r (load i)) (break))
                  (store! i (+ (load i) 1)))))
    (load r)))

;; str-find, string-view-find/contains, starts-with and ends-with agree with a
;; naive scan.
(defprop find-matches-reference [(hay Small) (needle Tiny)]
  (let [h (load (field hay b))
        nd (load (field needle b))
        want (ref-find h nd 0)
        got (match (str/str-find h nd) (None [] -1) (Some [i] i))
        hv (str/string-view-unchecked h)
        nv (str/string-view-unchecked nd)
        vgot (match (str/string-view-find hv nv) (None [] -1) (Some [ix] (str/string-index-byte-offset ix)))
        sw (and (<= (slice-len nd) (slice-len h)) (ref-match-at? h nd 0))
        ew (and (<= (slice-len nd) (slice-len h)) (ref-match-at? h nd (- (slice-len h) (slice-len nd))))]
    (and (= got want)
         (= vgot want)
         (= (str/string-view-contains? hv nv) (>= want 0))
         (= (str/starts-with h nd) sw)
         (= (str/string-view-starts-with? hv nv) sw)
         (= (str/string-view-ends-with? hv nv) ew))))

;; str-split and the allocation-free string-view-split produce the same pieces
;; as a naive left-to-right non-overlapping split; the pieces alias the input,
;; and joining them with the separator rebuilds the input.
(defprop split-matches-reference [(hay Small) (separator Tiny)]
  (let [s (prop-src)
        h (load (field hay b))
        sep (load (field separator b))
        a (src-alloc s)
        (mut want) (al-new [(slice u8)] a)]
    (if (= (slice-len sep) 0)
        (al-push! (mut want) h)
        (let [(mut start) 0]
          (loop (let [f (ref-find h sep (load start))]
                  (if (< f 0)
                      (do (al-push! (mut want) (subslice h (load start) (slice-len h))) (break))
                      (do (al-push! (mut want) (subslice h (load start) f))
                          (store! start (+ f (slice-len sep)))))))
          0))
    (let [(mut got) (str/str-split a h sep)
          (mut it) (str/string-view-split (str/string-view-unchecked h) (str/string-view-unchecked sep))
          (mut ok) (= (al-len (load got)) (al-len (load want)))
          (mut k) 0
          (mut joined) (al-new [u8] a)]
      (loop (if (or (not (load ok)) (>= (load k) (al-len (load want))))
                (break)
                (let [w (al-get (load want) (load k))
                      g (al-get (load got) (load k))
                      v (match (next (mut it)) (None [] (do (store! ok false) g)) (Some [p] (str/string-view-bytes p)))]
                  (if (and (bytes-eq w g) (and (bytes-eq w v) (= (slice-data w) (slice-data g))))
                      0
                      (store! ok false))
                  (if (> (load k) 0)
                      (let [(mut q) 0]
                        (loop (if (>= (load q) (slice-len sep)) (break)
                                  (do (al-push! (mut joined) (slice-get sep (load q))) (store! q (+ (load q) 1)))))
                        0)
                      0)
                  (let [(mut q) 0]
                    (loop (if (>= (load q) (slice-len g)) (break)
                              (do (al-push! (mut joined) (slice-get g (load q))) (store! q (+ (load q) 1)))))
                    0)
                  (store! k (+ (load k) 1)))))
      (let [exhausted (match (next (mut it)) (None [] true) (Some [_] false))]
        (and (load ok) exhausted (bytes-eq (al-slice (load joined)) h))))))

(defn sign [(x i64)] (-> i64) (cond (< x 0) -1 (> x 0) 1 :else 0))

(defn ref-cmp [(a (slice u8)) (b (slice u8))] (-> i64)
  (let [(mut i) 0 (mut r) 0]
    (loop (cond (and (>= (load i) (slice-len a)) (>= (load i) (slice-len b))) (break)
                (>= (load i) (slice-len a)) (do (store! r -1) (break))
                (>= (load i) (slice-len b)) (do (store! r 1) (break))
                :else
                  (let [x (primitive/cast i64 (slice-get a (load i)))
                        y (primitive/cast i64 (slice-get b (load i)))]
                    (cond (< x y) (do (store! r -1) (break))
                          (> x y) (do (store! r 1) (break))
                          :else (store! i (+ (load i) 1))))))
    (load r)))

(defn ref-fnv [(t (slice u8))] (-> i64)
  (let [(mut h) -3750763034362895579 (mut i) 0]
    (loop (if (>= (load i) (slice-len t))
              (break)
              (do (store! h (primitive/imul (primitive/ixor (load h) (primitive/cast i64 (slice-get t (load i)))) 1099511628211))
                  (store! i (+ (load i) 1)))))
    (load h)))

;;; A copy of `t` placed at byte offset `shift` of a fresh exact allocation.
(defn shifted-copy [(s (ptr Source)) (t (slice u8)) (shift i64)] (-> (slice u8))
  (let [n (slice-len t)
        buf (prop-alloc s (+ n (+ shift 1)) 1)
        (mut i) 0]
    (loop (if (>= (load i) n) (break)
              (do (store! (primitive/index buf (+ shift (load i))) (slice-get t (load i)))
                  (store! i (+ (load i) 1)))))
    (slice-new [u8] (primitive/index buf shift) n)))

;; str-cmp/Ord/str-eq agree with a naive lexicographic comparison; str-hash is
;; FNV-1a; the map hash (8-byte words) is a function of content alone, whatever
;; the alignment of the bytes.
(defprop compare-and-hash-match-reference [(x Small) (y Small) (copy bool) (shift1 u8) (shift2 u8)]
  (let [s (prop-src)
        a (load (field x b))
        b (if copy (shifted-copy s a (primitive/iand (primitive/cast i64 shift1) 7)) (load (field y b)))
        want (ref-cmp a b)
        c (sign (str/str-cmp a b))
        ac (shifted-copy s a (+ 1 (primitive/irem (primitive/cast i64 shift2) 7)))
        av (str/string-view-unchecked a)
        bv (str/string-view-unchecked b)]
    (and (= c want)
         (= (sign (str/str-cmp b a)) (- 0 want))
         (= (str/str-eq a b) (= want 0))
         (= (< a b) (< want 0))
         (= (<= a b) (<= want 0))
         (= (> av bv) (> want 0))
         (= (>= av bv) (>= want 0))
         (= (= av bv) (= want 0))
         (= (str/str-hash a) (ref-fnv a))
         (= (hash a) (ref-fnv a))
         (= (str/str-key-hash-bytes a) (str/str-key-hash-bytes ac))
         (if (= want 0) (= (str/str-key-hash-bytes a) (str/str-key-hash-bytes b)) true))))

(defn ref-ws? [(c i64)] (-> bool)
  (or (= c 32) (and (>= c 9) (<= c 13))))

;; str-trim / string-view-trim-ascii drop exactly the ASCII whitespace at both ends.
(defn draw-ws [(s (ptr Source)) (maxn i64)] (-> (slice u8))
  (let [sp (span-open! s "ws" SPAN-PLAIN)
        n (draw-len! s 0 maxn)
        buf (prop-alloc s (if (> n 0) n 1) 1)
        (mut i) 0]
    (loop (if (>= (load i) n)
              (break)
              (let [esp (span-open! s "ch" SPAN-ELEM)
                    k (draw-int! s 0 4)
                    c (case k 0 32 1 (draw-int! s 8 14) 2 97 3 133 (draw-int! s 0 255))]
                (store! (primitive/index buf (load i)) (primitive/cast u8 c))
                (span-close! s esp)
                (store! i (+ (load i) 1)))))
    (span-close! s sp)
    (slice-new [u8] buf n)))

(defprop trim-matches-reference [(input WsText)]
  (let [t (load (field input b))
        n (slice-len t)
        buf (slice-data t)]
    (let [(mut lo) 0
          (mut hi) n]
      (loop (if (and (< (load lo) n) (ref-ws? (primitive/cast i64 (slice-get t (load lo)))))
                (store! lo (+ (load lo) 1)) (break)))
      (loop (if (and (> (load hi) (load lo)) (ref-ws? (primitive/cast i64 (slice-get t (- (load hi) 1)))))
                (store! hi (- (load hi) 1)) (break)))
      (let [got (str/str-trim t)
            gv (str/string-view-bytes (str/string-view-trim-ascii (str/string-view-unchecked t)))]
        (and (= (slice-len got) (- (load hi) (load lo)))
             (or (= (slice-len got) 0) (= (slice-data got) (primitive/index buf (load lo))))
             (bytes-eq gv got))))))

;; str-concat = a ++ b; str->cstr/cstr-len/cstr->str round-trip up to the first NUL.
(defprop concat-and-cstr-match-reference [(xs Small) (ys Small)]
  (let [s (prop-src)
        x (load (field xs b))
        y (load (field ys b))
        a (src-alloc s)]
    (match (str/str-concat a x y)
      (None [] false)
      (Some [xy]
            (let [ok1 (and (= (slice-len xy) (+ (slice-len x) (slice-len y)))
                           (bytes-eq (subslice xy 0 (slice-len x)) x)
                           (bytes-eq (subslice xy (slice-len x) (slice-len xy)) y))
                  c (str/str->cstr a x)
                  nul (let [(mut i) 0]
                        (loop (if (or (>= (load i) (slice-len x)) (= (primitive/cast i64 (slice-get x (load i))) 0))
                                  (break)
                                  (store! i (+ (load i) 1))))
                        (load i))
                  back (str/cstr->str c)]
              (and ok1
                   (= (str/cstr-len c) nul)
                   (bytes-eq back (subslice x 0 nul))))))))

; ─────────────────────────────── owned text models ─────────────────────────────

(defn push-all! [(out (mut (ArrayList u8))) (t (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len t)) (break)
              (do (al-push! (mut out) (slice-get t (load i))) (store! i (+ (load i) 1)))))
    0))

;;; The scalar boundary at or below `b` in the model bytes.
(defn floor-boundary [(m (slice u8)) (b i64)] (-> i64)
  (let [(mut x) b]
    (loop (if (and (> (load x) 0) (< (load x) (slice-len m))
                   (cont-byte? (primitive/cast i64 (slice-get m (load x)))))
              (store! x (- (load x) 1))
              (break)))
    (load x)))

(defn string-ok? [(text str/String) (model (ArrayList u8))] (-> bool)
  (let [got (str/string-view-bytes (str/string-as-view text))
        mv (str/string-view-unchecked (al-slice model))]
    (and (bytes-eq got (al-slice model))
         (= (str/string-byte-len text) (al-len model))
         (>= (str/string-capacity text) (str/string-byte-len text))
         (match (str/string-view-from-utf8 got) (Ok [_] true) (Err [_] false))
         (= (str/string-as-view text) mv)
         (= (hash text) (hash mv)))))

;; String behaves like a byte buffer under push-view / push-rune / pop-rune /
;; truncate / remove / clear / take / clone / reserve / into-bytes, and stays
;; valid UTF-8 with Eq/Hash agreeing with its view. Indices given to truncate
;; and remove are always scalar boundaries obtained from the model (plus
;; out-of-range truncations, which must be rejected with -1).
(defprop string-ops-match-model [(input StringOps)]
  (let [s (prop-src)
        a (src-alloc s)
        ops (load (field (field input ops) v))
        (mut text) (str/string-new a)
        (mut model) (al-new [u8] a)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load i) (al-len ops)))
              (break)
              (let [op (al-get ops (load i))
                    n (al-len (load model))]
                (case (.kind op)
                  0 (let [piece (.bytes op)]
                      (str/string-push-view! (mut text) (str/string-view-unchecked piece))
                      (push-all! (mut model) piece))
                  1 (let [cp (.a op)
                          (mut tmp) (al-new [u8] a)]
                      (match (str/rune-new (primitive/cast u32 cp))
                        (None [] 0)
                        (Some [r] (do (str/string-push-rune! (mut text) r) 0)))
                      (enc-cp! (mut tmp) cp)
                      (push-all! (mut model) (al-slice (load tmp))))
                  2 (match (str/string-pop-rune! (mut text))
                      (None [] (if (!= n 0) (store! ok false) 0))
                      (Some [r]
                            (if (= n 0)
                                (store! ok false)
                                (let [b (floor-boundary (al-slice (load model)) (- n 1))
                                      (mut cps) (al-new [i64] a)]
                                  (ref-validate (subslice (al-slice (load model)) b n) (mut cps))
                                  (if (or (!= (al-len (load cps)) 1)
                                          (!= (al-get (load cps) 0) (primitive/cast i64 (str/rune-value r))))
                                      (store! ok false)
                                      0)
                                  (store! (field model len) b)))))
                  3 (let [raw (primitive/irem (.a op) (+ n 3))]
                      (if (> raw n)
                          (if (!= (str/string-truncate! (mut text) (str/StringIndex :byte_offset raw)) -1)
                              (store! ok false) 0)
                          (let [b (floor-boundary (al-slice (load model)) raw)]
                            (if (!= (str/string-truncate! (mut text) (str/StringIndex :byte_offset b)) b)
                                (store! ok false) 0)
                            (store! (field model len) b))))
                  4 (let [x (floor-boundary (al-slice (load model)) (primitive/irem (.a op) (+ n 1)))
                          y (floor-boundary (al-slice (load model)) (primitive/irem (.b op) (+ n 1)))
                          lo (if (< x y) x y)
                          hi (if (< x y) y x)
                          r (str/string-remove! (mut text) (str/StringIndex :byte_offset lo) (str/StringIndex :byte_offset hi))
                          (mut m2) (al-new [u8] a)]
                      (push-all! (mut m2) (subslice (al-slice (load model)) 0 lo))
                      (push-all! (mut m2) (subslice (al-slice (load model)) hi n))
                      (store! model (load m2))
                      (if (!= r (al-len (load model))) (store! ok false) 0))
                  5 (do (str/string-clear! (mut text)) (store! (field model len) 0))
                  6 (let [(mut taken) (str/string-take! (mut text))]
                      (if (not (string-ok? (load taken) (load model))) (store! ok false) 0)
                      (if (!= (str/string-byte-len (load text)) 0) (store! ok false) 0)
                      ; put it back so the sequence continues on the same content
                      (str/string-push-view! (mut text) (str/string-as-view (load taken)))
                      (str/string-free! (mut taken)))
                  7 (let [(mut c) (str/string-clone a (load text))]
                      (if (or (not (string-ok? (load c) (load model))) (!= (load c) (load text)))
                          (store! ok false) 0)
                      (str/string-free! (mut c)))
                  8 (let [want (+ n (.a op))]
                      (str/string-reserve! (mut text) want)
                      (if (< (str/string-capacity (load text)) want) (store! ok false) 0))
                  (let [(mut c) (str/string-clone a (load text))
                        bytes (str/string-into-bytes! (mut c))]
                    (if (or (not (bytes-eq bytes (al-slice (load model))))
                            (!= (str/string-byte-len (load c)) 0))
                        (store! ok false) 0)
                    0))
                (if (not (string-ok? (load text) (load model))) (store! ok false) 0)
                (store! i (+ (load i) 1))
                0)))
    (str/string-free! (mut text))
    (load ok)))

;; StrBuf behaves like a byte list under push-str / push-byte / push-i64 / push!,
;; with Len/Get agreeing, and sb-finish! hands back exactly the contents.
(defprop strbuf-ops-match-model [(input StrBufOps)]
  (let [s (prop-src)
        a (src-alloc s)
        ops (load (field (field input ops) v))
        (mut sb) (str/sb-new a)
        (mut model) (al-new [u8] a)
        (mut i) 0
        (mut ok) true]
    (loop (if (>= (load i) (al-len ops))
              (break)
              (let [op (al-get ops (load i))]
                (case (.kind op)
                  0 (let [t (.bytes op)
                          r (str/sb-push-str! (mut sb) t)]
                      (push-all! (mut model) t)
                      (if (!= r (al-len (load model))) (store! ok false) 0))
                  1 (let [b (primitive/cast u8 (.a op))]
                      (str/sb-push-byte! (mut sb) b)
                      (al-push! (mut model) b))
                  2 (let [v (.a op)
                          r (str/sb-push-i64! (mut sb) v)]
                      (push-all! (mut model) (ref-fmt s v))
                      (if (!= r (al-len (load model))) (store! ok false) 0))
                  (let [b (primitive/cast u8 (.a op))]
                    (push! (mut sb) b)
                    (al-push! (mut model) b)))
                (store! i (+ (load i) 1))
                0)))
    (let [m (al-slice (load model))
          same (and (bytes-eq (str/sb-str (load sb)) m) (= (len (load sb)) (slice-len m)))
          (mut k) 0
          (mut gets) true]
      (loop (if (>= (load k) (slice-len m)) (break)
                (do (if (!= (get (load sb) (load k)) (slice-get m (load k))) (store! gets false) 0)
                    (store! k (+ (load k) 1)))))
      (let [fin (str/sb-finish! (mut sb))]
        (and (load ok) same (load gets) (bytes-eq fin m) (= (len (load sb)) 0))))))

; ───────────────────────────── string-keyed maps ───────────────────────────────

;;; Map ops: 0 put (bytes, a = value), 1 get, 2 remove, 3 clear.
(defn gen-map-op [(s (ptr Source))] (-> Op)
  (let [k (draw-int! s 0 3)]
    (case k
      3 (Op :kind 3 :a 0 :b 0 :bytes "")
      (Op :kind (if (= k 0) 0 k) :a (draw-int! s 0 1000) :b 0 :bytes (draw-small s 5)))))

(defstruct MapOps [(ops Ops)])
(impl Arbitrary MapOps
  (arbitrary [(out (mut MapOps)) (s (ptr Source))] (-> i64)
             (store! (field out ops) (draw-ops s (primitive/fnptr-of gen-map-op)))
             0))
(impl Debug MapOps
  (debug-fmt [(x MapOps) (f (ptr Formatter))] (-> i64) (debug-fmt (load (field x ops)) f)))

(defstruct KV [(k (slice u8)) (v i64) (live bool)])

(defn model-find [(m (ArrayList KV)) (k (slice u8))] (-> i64)
  (let [(mut i) 0 (mut r) -1]
    (loop (if (>= (load i) (al-len m)) (break)
              (let [e (al-get m (load i))]
                (if (and (.live e) (bytes-eq (.k e) k))
                    (do (store! r (load i)) (break))
                    (store! i (+ (load i) 1))))))
    (load r)))

;;; A fresh, exactly-sized copy of `t` — the key the caller hands to the map.
;;; The property scribbles over it after the call: an OWNING map must not care.
(defn scratch-key [(s (ptr Source)) (t (slice u8))] (-> (slice u8))
  (shifted-copy s t 0))

(defn scribble! [(t (slice u8))] (-> i64)
  (let [(mut i) 0]
    (loop (if (>= (load i) (slice-len t)) (break)
              (do (store! (primitive/index (slice-data t) (load i)) (primitive/cast u8 88))
                  (store! i (+ (load i) 1)))))
    0))

;; HashMaps keyed by (slice u8) through the OWNING str-keyops and by StringView
;; through string-view-keyops agree with an association-list model, even though
;; every key buffer passed in is overwritten right after the call.
(defprop string-keyed-maps-match-model [(input MapOps)]
  (let [s (prop-src)
        a (src-alloc s)
        ops (load (field (field input ops) v))
        (mut m1) (hm-new [(slice u8) i64] a (str/str-keyops))
        (mut m2) (hm-new [str/StringView i64] a (str/string-view-keyops))
        (mut m3) (hm-new [str/String i64] a (str/string-keyops-owned))
        (mut model) (al-new [KV] a)
        (mut i) 0
        (mut ok) true]
    (loop (if (or (not (load ok)) (>= (load i) (al-len ops)))
              (break)
              (let [op (al-get ops (load i))
                    k1 (scratch-key s (.bytes op))
                    k2 (scratch-key s (.bytes op))
                    ; an owned String key; the caller frees it after every call
                    (mut k3) (str/string-from-view a (str/string-view-unchecked (.bytes op)))
                    at (model-find (load model) (.bytes op))]
                (case (.kind op)
                  0 (let [r1 (hm-put! (mut m1) k1 (.a op))
                          r2 (hm-put! (mut m2) (str/string-view-unchecked k2) (.a op))
                          r3 (hm-put! (mut m3) (load k3) (.a op))]
                      (if (or (!= (= r1 0) (>= at 0)) (or (!= (= r2 0) (>= at 0)) (!= (= r3 0) (>= at 0)))) (store! ok false) 0)
                      (if (>= at 0)
                          (store! (field (al-elem [KV] model at) v) (.a op))
                          (do (al-push! (mut model) (KV :k (.bytes op) :v (.a op) :live true)) 0)))
                  1 (let [g1 (hm-get (load m1) k1)
                          g2 (hm-get (load m2) (str/string-view-unchecked k2))
                          g3 (hm-get (load m3) (load k3))
                          want (if (>= at 0) (Some (load (field (al-elem [KV] model at) v))) (None [i64]))]
                      (if (or (not (opt-i64-eq g1 want)) (or (not (opt-i64-eq g2 want)) (not (opt-i64-eq g3 want)))) (store! ok false) 0))
                  2 (let [r1 (hm-remove! (mut m1) k1)
                          r2 (hm-remove! (mut m2) (str/string-view-unchecked k2))
                          r3 (hm-remove! (mut m3) (load k3))
                          want (if (>= at 0) 1 0)]
                      (if (or (!= r1 want) (or (!= r2 want) (!= r3 want))) (store! ok false) 0)
                      (if (>= at 0) (store! (field (al-elem [KV] model at) live) false) 0))
                  (do (hm-clear! (mut m1)) (hm-clear! (mut m2)) (hm-clear! (mut m3))
                      (store! (field model len) 0)))
                (scribble! k1)
                (scribble! k2)
                (scribble! (str/string-view-bytes (str/string-as-view (load k3))))
                (str/string-free! (mut k3))
                ; every live model key is still found with its value
                (let [(mut j) 0 (mut live) 0]
                  (loop (if (>= (load j) (al-len (load model))) (break)
                            (let [e (al-get (load model) (load j))]
                              (if (.live e)
                                  (let [(mut q) (str/string-from-view a (str/string-view-unchecked (.k e)))]
                                    (store! live (+ (load live) 1))
                                    (if (or (not (opt-i64-eq (hm-get (load m1) (.k e)) (Some (.v e))))
                                            (or (not (opt-i64-eq (hm-get (load m2) (str/string-view-unchecked (.k e))) (Some (.v e))))
                                                (not (opt-i64-eq (hm-get (load m3) (load q)) (Some (.v e))))))
                                        (store! ok false) 0)
                                    (str/string-free! (mut q)))
                                  0)
                              (store! j (+ (load j) 1)))))
                  (if (or (!= (hm-len (load m1)) (load live)) (or (!= (hm-len (load m2)) (load live)) (!= (hm-len (load m3)) (load live))))
                      (store! ok false) 0))
                (store! i (+ (load i) 1))
                0)))
    (hm-free! (mut m1))
    (hm-free! (mut m2))
    (hm-free! (mut m3))
    (load ok)))

;; string-truncate! and string-remove! both range-check their StringIndex
;; arguments and report a rejected index with -1. Whatever index they are given
;; (negative, past the end, reversed), they must either reject it and leave the
;; String untouched, or leave a String whose length is within [0, old length].
(defprop string-index-range-checks [(input Cps) (lo i64) (hi i64) (use-remove bool)]
  (let [s (prop-src)
        a (src-alloc s)
        bytes (encode-cps s (load (field input v)))
        n (slice-len bytes)
        ; indices near the interesting edges: [-3, n+3]
        x (- (primitive/irem (primitive/iand lo 1023) (+ n 7)) 3)
        y (- (primitive/irem (primitive/iand hi 1023) (+ n 7)) 3)
        (mut t) (str/string-new a)]
    (str/string-push-view! (mut t) (str/string-view-unchecked bytes))
    (let [r (if use-remove
                (str/string-remove! (mut t) (str/StringIndex :byte_offset x) (str/StringIndex :byte_offset y))
                (str/string-truncate! (mut t) (str/StringIndex :byte_offset x)))
          len (str/string-byte-len (load t))
          ok (if (= r -1)
                 (bytes-eq (str/string-view-bytes (str/string-as-view (load t))) bytes)
                 (and (>= len 0) (<= len n) (= r len)))]
      (str/string-free! (mut t))
      ok)))

;; The ownership hand-offs `sb-finish!` and `string-into-bytes!` return a slice
;; the caller frees with `(free [u8] a s)`. Run over coil.dbgalloc (which checks
;; the size of every free and counts live blocks), building then handing off and
;; freeing must leave no live allocation and no size mismatch.
(defprop text-hand-off-frees-exactly [(input StrBufOps) (truncate-to u8) (use-string bool)]
  (let [d (debug-allocator-init (malloc-allocator))
        a (debug-allocator-view d)
        ops (load (field (field input ops) v))]
    (if use-string
        (let [(mut t) (str/string-new a)
              (mut i) 0]
          (loop (if (>= (load i) (al-len ops)) (break)
                    (let [op (al-get ops (load i))]
                      ; ASCII only, so every offset is a scalar boundary
                      (str/string-push-rune! (mut t) (str/Rune :value (primitive/cast u32 (primitive/iand (.a op) 127))))
                      (store! i (+ (load i) 1)))))
          (let [keep (primitive/irem (primitive/cast i64 truncate-to) (+ (str/string-byte-len (load t)) 1))]
            (str/string-truncate! (mut t) (str/StringIndex :byte_offset keep))
            (let [b (str/string-into-bytes! (mut t))]
              (free [u8] a b))))
        (let [(mut sb) (str/sb-new a)
              (mut i) 0]
          (loop (if (>= (load i) (al-len ops)) (break)
                    (let [op (al-get ops (load i))]
                      (str/sb-push-byte! (mut sb) (primitive/cast u8 (.a op)))
                      (store! i (+ (load i) 1)))))
          (let [b (str/sb-finish! (mut sb))]
            (free [u8] a b))))
    (= (debug-allocator-deinit! d) 0)))
