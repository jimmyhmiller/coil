(module nesting_depth_regress)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FAILS ON PURPOSE. A bracket parser whose fixed stack overflows at depth five.
; Every level takes the SAME `[` edge, so "edge seen or not" cannot tell depth 1
; from depth 4: finding this needs hit-count buckets (and element repetition).
; The gate expects `s = "[[[[["` exactly.
(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

(defn sink [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn nest-ok [(s (slice u8))] (-> bool)
  (let [(mut i) 0
        (mut depth) 0
        (mut ok) true]
    (loop (if (or (>= (load i) (slice-len [u8] s)) (not (load ok)))
              (break)
              (let [c (at s (load i))]
                (if (= c \[)
                    (do
                      (store! depth (primitive/iadd (load depth) 1))
                      (if (>= (load depth) 5) (store! ok false) 0))
                    (if (= c \])
                        (do
                          (store! (sink) (load depth))
                          (if (> (load depth) 0)
                              (store! depth (primitive/isub (load depth) 1))
                              0))
                        0))
                (store! i (primitive/iadd (load i) 1)))))
    (load ok)))

(defprop nesting-is-bounded [(s (slice u8))] (nest-ok s))
