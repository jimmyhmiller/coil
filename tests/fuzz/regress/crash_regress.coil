(module crash_regress)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FAILS ON PURPOSE. A crash that only a MUTATED input reaches. The campaign must
; report the input that crashed — not some input from the random generation
; phase, which is what a runner that bisects over generated cases reports — and
; minimize it in worker processes. The gate expects `s = "BOOM"` and "CRASHED".
(extern raise :cc c [i32] (-> i32))

(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

(defn progress [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn reached [(n i64)] (-> i64)
  (store! (progress) n)
  n)

(defn handle [(s (slice u8))] (-> bool)
  (if (< (slice-len [u8] s) 4)
      true
      (if (!= (at s 0) \B)
          true
          (do
            (reached 1)
            (if (!= (at s 1) \O)
                true
                (do
                  (reached 2)
                  (if (!= (at s 2) \O)
                      true
                      (do
                        (reached 3)
                        (if (!= (at s 3) \M)
                            true
                            (do (reached 4) (raise 11) true))))))))))

(defprop never-crashes [(s (slice u8))] (handle s))
