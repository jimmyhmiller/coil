(module magic_ladder_regress)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FAILS ON PURPOSE. A four-byte magic value behind nested comparisons: blind
; sampling needs ~95^4 cases; coverage plus comparison feedback climbs it one rung
; at a time. The gate expects `s = "FUZZ"` exactly.
(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

;; Doing something observable on each rung gives it a basic block of its own;
;; a chain of `if` that only yields booleans compiles to branchless selects.
(defn progress [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn reached [(n i64)] (-> i64)
  (store! (progress) n)
  n)

(defn handle [(s (slice u8))] (-> bool)
  (if (< (slice-len [u8] s) 4)
      true
      (if (!= (at s 0) \F)
          true
          (do
            (reached 1)
            (if (!= (at s 1) \U)
                true
                (do
                  (reached 2)
                  (if (!= (at s 2) \Z)
                      true
                      (do
                        (reached 3)
                        (if (!= (at s 3) \Z) true (do (reached 4) false))))))))))

(defprop magic-ladder [(s (slice u8))] (handle s))
