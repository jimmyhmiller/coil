(module corpus_regress)
(import "coil.prop" :use *)
(import "coil.json" :as json)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; PASSES. A target with enough structure to grow a corpus, used by the gate to
; check what a campaign leaves behind: a corpus that the next campaign resumes
; from, a coverage report, and `--minimize-corpus` keeping every edge.
(defn json-alphabet [] (-> (slice u8))
  "{}[]\",:0123456789.-+eE truefalsn\\/ux")

(defprop jsonish-parses-or-errors
         [(seed i64)]
         (let [src (prop-src)
               n (draw-len! src 0 40)
               alpha (json-alphabet)
               buf (prop-alloc src (if (> n 0) n 1) 1)
               (mut i) 0]
           (loop (if (>= (load i) n)
                     (break)
                     (let [sp (span-open! src "ch" SPAN-ELEM)]
                       (store! (primitive/index buf (load i))
                               (slice-get [u8]
                                          alpha
                                          (draw-int! src
                                                     0
                                                     (primitive/isub (slice-len [u8] alpha) 1))))
                       (span-close! src sp)
                       (store! i (primitive/iadd (load i) 1))
                       0)))
           (match (json/parse (src-alloc src) (slice-new [u8] buf n))
             (Err [e] true)
             (Ok [d] (>= (json/token-count d) 0)))))
