(module asan_regress)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FAILS ON PURPOSE, and only under `coil fuzz --sanitize=address`. An unescaper
; reads the two digits after `\x` without checking they exist, so an input that
; ENDS in an escape reads past its end. Without ASan the read lands on a
; neighbouring byte and the property passes; with it (and one allocation per
; generated value) it is a heap-buffer-overflow. The gate expects `s = "\\x"`.
(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

(defn hex [(c i64)] (-> i64)
  (cond (and (>= c \0) (<= c \9)) (primitive/isub c \0)
        (and (>= c \a) (<= c \f)) (primitive/iadd 10 (primitive/isub c \a))
        :else 0))

(defn unescaped-len [(s (slice u8))] (-> i64)
  (let [n (slice-len [u8] s)
        (mut i) 0
        (mut out) 0]
    (loop (if (>= (load i) n)
              (break)
              (if (and (= (at s (load i)) \\) (< (primitive/iadd (load i) 1) n))
                  (if (= (at s (primitive/iadd (load i) 1)) \x)
                      (do
                        (store! out
                                (primitive/iadd (load out)
                                                (primitive/iadd (hex (at s (primitive/iadd (load i) 2)))
                                                                (hex (at s (primitive/iadd (load i) 3))))))
                        (store! i (primitive/iadd (load i) 4)))
                      (do
                        (store! out (primitive/iadd (load out) 1))
                        (store! i (primitive/iadd (load i) 2))))
                  (do
                    (store! out (primitive/iadd (load out) 1))
                    (store! i (primitive/iadd (load i) 1))))))
    (load out)))

(defprop unescape-is-in-bounds [(s (slice u8))] (>= (unescaped-len s) 0))
