(module hang_regress)
(import "coil.prop" :use *)
(import "coil.slice" :use *)
(import "coil.primitive" :as primitive)

; FAILS ON PURPOSE. An input that never finishes. The supervisor sees the worker's
; execution count stop moving, kills it, and reports the input in flight as a
; hang. The gate expects `s = "LOP"` and "TIMED OUT".
(defn at [(s (slice u8)) (i i64)] (-> i64)
  (primitive/cast i64 (slice-get [u8] s i)))

;; The store keeps the loop observable: an infinite loop with no effect is legal
;; to delete.
(defn spin [] (-> (ptr i64))
  (primitive/alloc-static i64))

(defn handle [(s (slice u8))] (-> bool)
  (if (< (slice-len [u8] s) 3)
      true
      (if (!= (at s 0) \L)
          true
          (if (!= (at s 1) \O)
              true
              (if (!= (at s 2) \P)
                  true
                  (do
                    (loop (store! (spin) (primitive/iadd (load (spin)) 1)))
                    true))))))

(defprop terminates [(s (slice u8))] (handle s))
