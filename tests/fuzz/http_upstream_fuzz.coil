(module http_upstream_fuzz)
(import "coil.prop" :use *)
(import "coil.primitive" :as primitive)
(import "coil.slice" :use *)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.http.parser" :as ll)
(import "coil.http.parser.types" :as types)
(import "coil.http.server" :as server)
(import "http_fuzz" :use *)

; Differential fuzz target: coil.http.parser against upstream C llhttp 9.4.3,
; and coil.http.server against the repository's native reference
; (scripts/native/llhttp_shim.c over upstream llhttp). Generators, the trace
; recorder and the Coil driver are http_fuzz.coil's.
;
; Upstream is linked from the oracle archive scripts/native/build-llhttp.sh
; builds (it downloads the checksum-pinned llhttp 9.4.3 and needs npm); the
; archive also holds tests/fuzz/native/http_fuzz_trace.c, which drives upstream
; over the same chunks and writes the same trace as http_fuzz.coil's recorder.
;
;   scripts/tests/http-upstream-fuzz.sh --time 300 [--jobs 4] [--sanitize=address]
;   coil test tests/fuzz/http_upstream_fuzz.coil \
;     --link-flag build/bin/native/llhttp/<arch>-<os>/libllhttp.a

;;; tests/fuzz/native/http_fuzz_trace.c: run upstream llhttp over `data` cut at
;;; `cuts` (with the same pause schedule, headers-complete result and injected
;;; callback error as run-coil-ctl) and write its trace; the length, or -1 when
;;; the trace overflowed `out`.
(extern http_fuzz_trace
        :cc
        c
        [(ptr u8) i64 i64 i64 (ptr i64) i64 (ptr u8) i64 i64 i64 i64 i64]
        (-> i64))

(extern coil_llhttp_parse :cc c [(ptr u8) i64 i32] (-> (ptr i8)))

(extern coil_llhttp_result_free :cc c [(ptr i8)] (-> void))

(extern coil_llhttp_status :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_error_code :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_error_offset :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_consumed :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_http_major :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_http_minor :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_keep_alive :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_header_count :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_method :cc c [(ptr i8)] (-> (ptr u8)))

(extern coil_llhttp_method_len :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_target :cc c [(ptr i8)] (-> (ptr u8)))

(extern coil_llhttp_target_len :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_body :cc c [(ptr i8)] (-> (ptr u8)))

(extern coil_llhttp_body_len :cc c [(ptr i8)] (-> i64))

(extern coil_llhttp_header_name :cc c [(ptr i8) i64] (-> (ptr u8)))

(extern coil_llhttp_header_name_len :cc c [(ptr i8) i64] (-> i64))

(extern coil_llhttp_header_value :cc c [(ptr i8) i64] (-> (ptr u8)))

(extern coil_llhttp_header_value_len :cc c [(ptr i8) i64] (-> i64))

;;; Run upstream C llhttp over the same bytes and cuts.
(defn run-native [(src (ptr Source))
                  (data (slice u8))
                  (ptype i64)
                  (lenient i64)
                  (cuts (slice i64))] (-> (slice u8))
  (run-native-ctl src data ptype lenient cuts 0 0 -1 0))

(defn run-native-ctl [(src (ptr Source))
                      (data (slice u8))
                      (ptype i64)
                      (lenient i64)
                      (cuts (slice i64))
                      (pause-mask i64)
                      (hc-ret i64)
                      (fail-at i64)
                      (fail-code i64)] (-> (slice u8))
  (let [cap (+ 8192 (* 64 (slice-len data)))
        out (prop-alloc src cap 1)
        n
          (http_fuzz_trace (slice-data data)
                           (slice-len data)
                           ptype
                           lenient
                           (slice-data cuts)
                           (slice-len cuts)
                           out
                           cap
                           pause-mask
                           hc-ret
                           fail-at
                           fail-code)]
    (when (< n 0) (fatal "native trace overflowed its buffer") 0)
    (slice-new [u8] out n)))

(defn c-bytes [(p (ptr u8)) (n i64)] (-> (slice u8))
  (if (= (primitive/cast i64 p) 0) "" (slice-new [u8] p n)))

;;; parse-request against the repository's native reference, over the same bytes
;;; in an exactly-sized heap block.
(defn server-agrees? [(a (dyn alloc/Allocator)) (data (slice u8))] (-> bool)
  (let [_ (when (show-first?) (show-bytes "server input" data) 0)
        copy (chunk-copy data 0 (slice-len data))
        input (slice-new [u8] (slice-data copy) (slice-len data))
        native
          (coil_llhttp_parse (slice-data input)
                             (slice-len input)
                             (primitive/cast i32 ll/HTTP_REQUEST))
        status (coil_llhttp_status native)
        (mut ok) true
        (mut why) ""]
    (match (server/parse-request a input)
      (Ok [r]
          (do
            (cond (!= status 0)
                    (do
                      (store! ok false)
                      (store! why "coil accepted, native rejected")
                      0)
                  (not (str/str-eq (server/method r)
                                   (c-bytes (coil_llhttp_method native)
                                            (coil_llhttp_method_len native))))
                    (do (store! ok false) (store! why "method") 0)
                  (not (str/str-eq (server/target r)
                                   (c-bytes (coil_llhttp_target native)
                                            (coil_llhttp_target_len native))))
                    (do (store! ok false) (store! why "target") 0)
                  (not (str/str-eq (server/body r)
                                   (c-bytes (coil_llhttp_body native)
                                            (coil_llhttp_body_len native))))
                    (do (store! ok false) (store! why "body") 0)
                  (!= (server/consumed r) (coil_llhttp_consumed native))
                    (do (store! ok false) (store! why "consumed") 0)
                  (!= (b->i (server/keep-alive? r))
                      (coil_llhttp_keep_alive native))
                    (do (store! ok false) (store! why "keep-alive") 0)
                  (!= (server/header-count r) (coil_llhttp_header_count native))
                    (do (store! ok false) (store! why "header count") 0)
                  :else
                    (let [(mut i) 0]
                      (loop (if (>= (load i) (server/header-count r))
                                (break)
                                (let [h (server/header-at r (load i))]
                                  (if (and (str/str-eq (load (field h name))
                                                       (c-bytes (coil_llhttp_header_name native
                                                                                         (load i))
                                                                (coil_llhttp_header_name_len native
                                                                                             (load i))))
                                           (str/str-eq (load (field h value))
                                                       (c-bytes (coil_llhttp_header_value native
                                                                                          (load i))
                                                                (coil_llhttp_header_value_len native
                                                                                              (load i)))))
                                      (store! i (+ (load i) 1))
                                      (do
                                        (store! ok false)
                                        (store! why "header")
                                        (break))))))
                      0))
            ; the reported version must be the one on the wire
            (when (load ok)
              (let [(mut v) (str/sb-new a)]
                (str/sb-push-str! (mut v) "HTTP/")
                (str/sb-push-i64! (mut v) (coil_llhttp_http_major native))
                (str/sb-push-str! (mut v) ".")
                (str/sb-push-i64! (mut v) (coil_llhttp_http_minor native))
                (unless (str/str-eq (server/version r) (str/sb-str (load v)))
                  (store! ok false)
                  (store! why "version"))
                0))
            (server/request-free r)
            0))
      (Err [e]
           (do
             (cond (= status 0)
                     (do
                       (store! ok false)
                       (store! why "coil rejected, native accepted")
                       0)
                   (!= (server/error-code e) (coil_llhttp_error_code native))
                     (do (store! ok false) (store! why "error code") 0)
                   (!= (server/error-offset e)
                       (coil_llhttp_error_offset native))
                     (do (store! ok false) (store! why "error offset") 0)
                   :else 0)
             (when (and (not (load ok)) (verbose?))
               (println "coil error code {} offset {}"
                        (server/error-code e)
                        (server/error-offset e))
               0)
             0)))
    (when (and (not (load ok)) (verbose?))
      (println "=== server mismatch: {}" (load why))
      (show-bytes "input" data)
      (println "native status {} code {} offset {} consumed {}"
               status
               (coil_llhttp_error_code native)
               (coil_llhttp_error_offset native)
               (coil_llhttp_consumed native))
      0)
    (coil_llhttp_result_free native)
    (alloc/free [u8] (alloc/malloc-allocator) copy)
    (load ok)))

;;; Upstream llhttp 9.4.3 never returns on a NUL in a header value when
;;; LENIENT_HEADER_VALUE_RELAXED is set (scripts/llhttp/README.md); the Coil
;;; parser rejects it. The oracle cannot run such an input, so the differential
;;; properties skip it; tests/llhttp_coil_test.coil pins the Coil behaviour.
(defn upstream-hangs? [(data (slice u8)) (lenient i64)] (-> bool)
  (and (!= (primitive/iand lenient 1024) 0)  ; LENIENT_HEADER_VALUE_RELAXED
       (let [(mut i) 0
             (mut found) false]
         (loop (if (>= (load i) (slice-len data))
                   (break)
                   (if (= (primitive/cast i64 (slice-get data (load i))) 0)
                       (do (store! found true) (break))
                       (store! i (+ (load i) 1)))))
         (load found))))

;; 1. DIFFERENTIAL, ARBITRARY BYTES. Any bytes, any parser type, any lenient
;; flags, any chunking: the Coil port produces exactly the upstream C llhttp's
;; callback trace, errno, error offset, reason and finish result. Under
;; --sanitize=address this is also the "never overreads" property.
(defprop diff-raw-bytes
         [(seed i64)]
         (let [src (prop-src)
               a (src-alloc src)
               data (arb-bytes src 0 96)
               ptype (draw-parser-type src)
               lenient (draw-lenient src)
               cuts (draw-cuts src (slice-len data))
               _ (assume (not (upstream-hangs? data lenient)))
               theirs (run-native src data ptype lenient cuts)]
           (same-trace "coil vs upstream (raw)"
                       data
                       ptype
                       lenient
                       cuts
                       (run-coil a data ptype lenient cuts false)
                       theirs)))

;; 2. DIFFERENTIAL, STRUCTURED. The same law over generated HTTP/1.x streams —
;; pipelined requests/responses with special headers, chunked and
;; content-length bodies, chunk extensions, trailers, bad framing and noise.
(defprop diff-structured
         [(seed i64)]
         (let [src (prop-src)
               a (src-alloc src)
               ptype (draw-parser-type src)
               g (gen-stream src false ptype)
               data (gen-out g)
               lenient (draw-lenient src)
               cuts (draw-cuts src (slice-len data))
               _ (assume (not (upstream-hangs? data lenient)))
               theirs (run-native src data ptype lenient cuts)]
           (same-trace "coil vs upstream (structured)"
                       data
                       ptype
                       lenient
                       cuts
                       (run-coil a data ptype lenient cuts false)
                       theirs)))

;; 3. PAUSE/RESUME AND CALLBACK RESULTS, DIFFERENTIAL. Callbacks pause the
;; parser on a random schedule (the driver resumes at the reported error
;; position, as llhttp's API prescribes), and on_headers_complete returns 0, 1
;; (skip the body) or 2 (upgrade): the resumable-error paths and the
;; headers-complete dispatch, which a plain run never reaches.
(defprop diff-pause-control
         [(seed i64)]
         (let [src (prop-src)
               a (src-alloc src)
               ptype (draw-parser-type src)
               g (gen-stream src false ptype)
               data (gen-out g)
               lenient (draw-lenient src)
               cuts (draw-cuts src (slice-len data))
               _ (assume (not (upstream-hangs? data lenient)))
               pause-mask (if (draw-bool-p! src 1 4) -1 (draw-int-any! src))
               hc-ret (if (draw-bool-p! src 3 4) 0 (draw-int! src 1 2))
               ; a callback error: -1, HPE_USER, or an arbitrary errno-sized code
               fail-at (if (draw-bool-p! src 1 2) -1 (draw-int! src 0 40))
               fail-code
                 (case (draw-int! src 0 2) 0
                       -1 1
                       ll/HPE_USER (draw-int! src 1 40))
               theirs
                 (run-native-ctl src
                                 data
                                 ptype
                                 lenient
                                 cuts
                                 pause-mask
                                 hc-ret
                                 fail-at
                                 fail-code)]
           (same-trace "coil vs upstream (pause/control)"
                       data
                       ptype
                       lenient
                       cuts
                       (run-coil-ctl a
                                     data
                                     ptype
                                     lenient
                                     cuts
                                     false
                                     pause-mask
                                     hc-ret
                                     true
                                     fail-at
                                     fail-code)
                       theirs)))

;; 4. SERVER DIFFERENTIAL. coil.http.server's parse-request agrees with the
;; repository's own native reference (scripts/native/llhttp_shim.c, the same
;; callbacks over upstream llhttp): accept/reject, error code and offset,
;; method, target, every header, decoded body, consumed bytes, keep-alive, and
;; the version it reports.
(defprop server-differential
         [(seed i64)]
         (let [src (prop-src)
               g
                 (gen-stream src
                             false
                             (if (draw-bool-p! src 1 8)
                                 ll/HTTP_BOTH
                                 ll/HTTP_REQUEST))
               data (gen-out g)]
           (server-agrees? (src-alloc src) data)))

(defprop server-differential-raw
         [(seed i64)]
         (let [src (prop-src)
               data (arb-bytes src 0 64)]
           (server-agrees? (src-alloc src) data)))
