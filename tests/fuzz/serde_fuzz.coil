; Fuzz target: coil.serde.msgpack / coil.serde.sexp (and the shared coil.serde,
; coil.serde.value, coil.serde.derive layers they sit on).
;
;   coil fuzz tests/fuzz/serde_fuzz.coil --time 120 --sanitize=address [--filter NAME]
;
; Two families of law:
;   * ROUND-TRIP / DIFFERENTIAL — rich derived values (nested lists, Options,
;     sums, arbitrary-byte strings, i64/u64 extremes, f64 specials, string-keyed
;     maps) must survive encode -> decode unchanged, and an accepted document must
;     re-encode to something that decodes to the same value.
;   * ROBUSTNESS — decoders fed arbitrary bytes (and structure-aware garbage)
;     must return Ok or Err: never crash, overread, or hang.
(module serde_fuzz)
(import "coil.primitive" :as primitive)
(import "coil.prop" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.slice" :use *)
(import "coil.str" :use *)
(import "coil.hashmap" :use *)
(import "coil.io" :as io)
(import "coil.mem" :as mem)
(import "coil.serde" :use *)
(import "coil.serde.derive" :use *)
(import "coil.serde.msgpack" :use *)
(import "coil.serde.sexp" :use *)
(import "coil.serde.value" :use *)
(import "coil.region" :use *)
(import "coil.str" :as str)

; ============================================================ leaf wrappers
;;; A string whose bytes span the whole 0..255 range (the default `(slice u8)`
;;; generator is printable ASCII only). Lengths are biased toward the msgpack
;;; header boundaries 31/32 and 255/256.
(defstruct Str [(v (slice u8))])

(defn arb-len-class [(s (ptr Source))] (-> i64)
  (let [k (draw-int! s 0 5)]
    (cond (= k 0) (draw-int! s 0 4)
          (= k 1) (draw-int! s 0 40)
          (= k 2) (draw-int! s 28 36)
          (= k 3) (draw-int! s 250 260)
          (= k 4) (draw-int! s 0 12)
          :else (draw-int! s 0 70))))

(defn arb-fullbytes [(s (ptr Source))] (-> (slice u8))
  (let [n (arb-len-class s)]
    (arb-bytes s n n)))

(impl Arbitrary Str
  (arbitrary [(out (mut Str)) (s (ptr Source))]
             (-> i64)
             (store! (field out v) (arb-fullbytes s))
             0))

(impl Debug Str
  (debug-fmt [(x Str) (f (ptr Formatter))] (-> i64) (debug-fmt (.v x) f)))

(impl Serialize Str
  (ser [(x Str) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser-str s (.v x))))

(impl Deserialize Str
  (de [(out (ptr Str)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (match (de-str d)
        (Err [e] (Err e))
        (Ok [v] (do (store! (field out v) v) (Ok 0))))))

;;; Raw bytes — the only way to reach ser-bytes / de-bytes (bin8/16/32, #"hex").
(defstruct Blob [(v (slice u8))])

(impl Arbitrary Blob
  (arbitrary [(out (mut Blob)) (s (ptr Source))]
             (-> i64)
             (store! (field out v) (arb-fullbytes s))
             0))

(impl Debug Blob
  (debug-fmt [(x Blob) (f (ptr Formatter))] (-> i64) (debug-fmt (.v x) f)))

(impl Serialize Blob
  (ser [(x Blob) (s (dyn Serializer))]
       (-> (Result i64 SerError))
       (ser-bytes s (.v x))))

(impl Deserialize Blob
  (de [(out (ptr Blob)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (match (de-bytes d)
        (Err [e] (Err e))
        (Ok [v] (do (store! (field out v) v) (Ok 0))))))

;;; A string-keyed map with arbitrary-byte keys.
(defstruct SMap [(m (HashMap (slice u8) i64))])

(impl Arbitrary SMap
  (arbitrary [(out (mut SMap)) (s (ptr Source))]
             (-> i64)
             (let [sp (span-open! s "smap" SPAN-PLAIN)
                   n (draw-len! s 0 6)
                   (mut m)
                     (hm-new [(slice u8) i64] (src-alloc s) (str-keyops-borrowed))
                   (mut i) 0]
               (loop (if (>= (load i) n)
                         (break)
                         (let [esp (span-open! s "entry" SPAN-ELEM)
                               k (arb-bytes s 0 (draw-int! s 0 20))
                               v (draw-int-any! s)]
                           (hm-put! (mut m) k v)
                           (span-close! s esp)
                           (store! i (+ (load i) 1))
                           0)))
               (store! (field out m) (load m))
               (span-close! s sp)
               0)))

(impl Debug SMap
  (debug-fmt [(x SMap) (f (ptr Formatter))] (-> i64) (debug-fmt (.m x) f)))

(impl Serialize SMap
  (ser [(x SMap) (s (dyn Serializer))] (-> (Result i64 SerError)) (ser (.m x) s)))

(impl Deserialize SMap
  (de [(out (ptr SMap)) (d (dyn Deserializer))]
      (-> (Result i64 DeError))
      (de (field out m) d)))

; ============================================================ derived types
(defstruct Inner [(a i64) (s Str) (f (Option f64))])

(derive Arbitrary Debug Inner)

(derive Serialize Deserialize Inner)

(defsum Shape
  (Dot)
  (Circle [(r f64)])
  (Rect [(w i32) (h u16)])
  (Named [(name Str) (pts (ArrayList i64))])
  (Wrap [(inner Inner)])
  (Maybe [(o (Option Shape2))]))

;;; A second, smaller sum so Shape can nest a sum without recursion.
(defsum Shape2 (Unit2) (Pair2 [(x u64) (y i8)]))

(derive Arbitrary Debug Shape2)

(derive Serialize Deserialize Shape2)

(derive Arbitrary Debug Shape)

(derive Serialize Deserialize Shape)

(defstruct Rec
  [(id i64)
   (u u64)
   (small i8)
   (w u16)
   (x i32)
   (flag bool)
   (score f64)
   (name Str)
   (blob Blob)
   (nick (Option i64))
   (tags (ArrayList i64))
   (inners (ArrayList Inner))
   (shapes (ArrayList Shape))
   (maybe (Option Shape))
   (grid (ArrayList (ArrayList (Option u8))))
   (dict SMap)])

(derive Arbitrary Debug Rec)

(derive Serialize Deserialize Rec)


; ============================================================ derive options
; rename-all, rename, default, skip, skip-deserializing, boxed, deny-unknown.
(defstruct Opt
  [(port i64)
   (retries i64)
   (secret i64)
   (note (slice u8))
   (left (ptr Inner))
   (maybe-name (Option Str))
   (tags-list (ArrayList u8))])

(derive (Serialize (rename-all :camelCase)
                   (field retries (rename "maxRetries"))
                   (field secret (skip))
                   (field note (skip-deserializing))
                   (field left (boxed)))
        (Deserialize (rename-all :camelCase)
                     (field port (default 8080))
                     (field retries (rename "maxRetries") (default 3))
                     (field secret (skip))
                     (field note (skip-deserializing))
                     (field left (boxed)))
        Opt)

;;; The same wire shape with (deny-unknown).
(defstruct OptStrict
  [(port i64)
   (retries i64)
   (secret i64)
   (note (slice u8))
   (left (ptr Inner))
   (maybe-name (Option Str))
   (tags-list (ArrayList u8))])

(derive (Serialize (rename-all :camelCase)
                   (field retries (rename "maxRetries"))
                   (field secret (skip))
                   (field note (skip-deserializing))
                   (field left (boxed)))
        (Deserialize (rename-all :camelCase)
                     (deny-unknown)
                     (field port (default 8080))
                     (field retries (rename "maxRetries") (default 3))
                     (field secret (skip))
                     (field note (skip-deserializing))
                     (field left (boxed)))
        OptStrict)

;;; Only the fields Opt REQUIRES: decoding this as Opt exercises every default.
(defstruct OptMin [(left (ptr Inner)) (tags-list (ArrayList u8))])

(derive (Serialize (rename-all :camelCase) (field left (boxed)))
        (Deserialize (rename-all :camelCase) (field left (boxed)))
        OptMin)

;;; A sum whose payload has a (skip) field.
(defsum Ev (Idle) (Hit [(n i64) (junk i64)]))

(derive Arbitrary Debug Ev)

(derive (Serialize (field junk (skip))) (Deserialize (field junk (skip))) Ev)

(defn arb-opt [(s (ptr Source))] (-> Opt)
  (let [sp (span-open! s "Opt" SPAN-PLAIN)
        (mut o) (zeroed Opt)]
    (store! (field o port) (draw-int-any! s))
    (store! (field o retries) (draw-int-any! s))
    (store! (field o secret) (draw-int-any! s))
    (store! (field o note) (arb-fullbytes s))
    (store! (field o left) (box! (src-alloc s) Inner (arb [Inner] s)))
    (store! (field o maybe-name) (arb [(Option Str)] s))
    (store! (field o tags-list) (arb [(ArrayList u8)] s))
    (span-close! s sp)
    (load o)))

(impl Arbitrary Opt
  (arbitrary [(out (mut Opt)) (s (ptr Source))] (-> i64) (store! out (arb-opt s)) 0))

(impl Debug Opt
  (debug-fmt [(x Opt) (f (ptr Formatter))]
             (-> i64)
             (let [w (formatter-writer f)]
               (io/print-str w "(Opt :port ") (debug-fmt (.port x) f)
               (io/print-str w " :retries ") (debug-fmt (.retries x) f)
               (io/print-str w " :secret ") (debug-fmt (.secret x) f)
               (io/print-str w " :note ") (debug-fmt (.note x) f)
               (io/print-str w " :left ") (debug-fmt (load (.left x)) f)
               (io/print-str w " :maybe-name ") (debug-fmt (.maybe-name x) f)
               (io/print-str w " :tags-list ") (debug-fmt (.tags-list x) f)
               (io/print-str w ")")
               0)))

(defn osteq [(a (Option Str)) (b (Option Str))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (= (strv x) (strv y)))))))

(defn lu8-eq [(a (ArrayList u8)) (b (ArrayList u8))] (-> bool)
  (if (!= (al-len a) (al-len b))
      false
      (let [(mut ok) true]
        (for [i 0 (al-len a)]
          (when (!= (al-get a i) (al-get b i)) (store! ok false) 0))
        (load ok))))

;;; `back` is what decoding `orig`'s encoding produced: skip / skip-deserializing
;;; fields must hold their ZEROED value ("keeps its zeroed value", serde_derive).
(defn opt-decoded-eq [(exact bool) (orig Opt) (back Opt)] (-> bool)
  (and (= (.port back) (.port orig))
       (and (= (.retries back) (.retries orig))
            (and (= (.secret back) 0)
                 (and (= (slice-len (.note back)) 0)
                      (and (inner-eq exact (load (.left back)) (load (.left orig)))
                           (and (osteq (.maybe-name back) (.maybe-name orig))
                                (lu8-eq (.tags-list back) (.tags-list orig)))))))))

(defn opt->strict [(o Opt)] (-> OptStrict)
  (let [(mut s) (zeroed OptStrict)]
    (store! (field s port) (.port o))
    (store! (field s retries) (.retries o))
    (store! (field s secret) (.secret o))
    (store! (field s note) (.note o))
    (store! (field s left) (.left o))
    (store! (field s maybe-name) (.maybe-name o))
    (store! (field s tags-list) (.tags-list o))
    (load s)))

(defn strict->opt [(o OptStrict)] (-> Opt)
  (let [(mut s) (zeroed Opt)]
    (store! (field s port) (.port o))
    (store! (field s retries) (.retries o))
    (store! (field s secret) (.secret o))
    (store! (field s note) (.note o))
    (store! (field s left) (.left o))
    (store! (field s maybe-name) (.maybe-name o))
    (store! (field s tags-list) (.tags-list o))
    (load s)))

; ============================================================ equality
;;; Exact bit equality — msgpack carries f64 bits verbatim.
(defn feq-bits [(a f64) (b f64)] (-> bool)
  (= (mem/f64-bits a) (mem/f64-bits b)))

(defn strv [(x Str)] (-> (slice u8)) (.v x))

(defn nan? [(a f64)] (-> bool) (not (primitive/fcmp-eq a a)))

;;; sexp spells every NaN `nan`, so only NaN-ness survives; everything else
;;; (including the sign of zero) must be bit-exact.
(defn feq-text [(a f64) (b f64)] (-> bool)
  (if (nan? a) (nan? b) (feq-bits a b)))

(defn feq [(exact bool) (a f64) (b f64)] (-> bool)
  (if exact (feq-bits a b) (feq-text a b)))

(defn ofeq [(exact bool) (a (Option f64)) (b (Option f64))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (feq exact x y))))))

(defn oieq [(a (Option i64)) (b (Option i64))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (= x y))))))

(defn li64-eq [(a (ArrayList i64)) (b (ArrayList i64))] (-> bool)
  (if (!= (al-len [i64] a) (al-len [i64] b))
      false
      (let [(mut ok) true]
        (for [i 0 (al-len [i64] a)]
          (when (!= (al-get [i64] a i) (al-get [i64] b i)) (store! ok false) 0))
        (load ok))))

(defn inner-eq [(exact bool) (a Inner) (b Inner)] (-> bool)
  (and (= (.a a) (.a b))
       (and (= (strv (.s a)) (strv (.s b))) (ofeq exact (.f a) (.f b)))))

(defn shape2-eq [(a Shape2) (b Shape2)] (-> bool)
  (match a
    (Unit2 [] (match b (Unit2 [] true) (_ false)))
    (Pair2 [x y]
           (match b
             (Pair2 [x2 y2] (and (= x x2) (= y y2)))
             (_ false)))))

(defn shape-eq [(exact bool) (a Shape) (b Shape)] (-> bool)
  (match a
    (Dot [] (match b (Dot [] true) (_ false)))
    (Circle [r] (match b (Circle [r2] (feq exact r r2)) (_ false)))
    (Rect [w h] (match b (Rect [w2 h2] (and (= w w2) (= h h2))) (_ false)))
    (Named [n p]
           (match b
             (Named [n2 p2] (and (= (strv n) (strv n2)) (li64-eq p p2)))
             (_ false)))
    (Wrap [i] (match b (Wrap [i2] (inner-eq exact i i2)) (_ false)))
    (Maybe [o]
           (match b
             (Maybe [o2]
                    (match o
                      (None [] (match o2 (None [] true) (Some [_] false)))
                      (Some [x]
                            (match o2 (None [] false) (Some [y] (shape2-eq x y))))))
             (_ false)))))

(defn oshape-eq [(exact bool) (a (Option Shape)) (b (Option Shape))] (-> bool)
  (match a
    (None [] (match b (None [] true) (Some [_] false)))
    (Some [x] (match b (None [] false) (Some [y] (shape-eq exact x y))))))

(defn grid-eq [(a (ArrayList (ArrayList (Option u8))))
               (b (ArrayList (ArrayList (Option u8))))] (-> bool)
  (if (!= (al-len a) (al-len b))
      false
      (let [(mut ok) true]
        (for [i 0 (al-len a)]
          (let [ra (al-get a i)
                rb (al-get b i)]
            (if (!= (al-len ra) (al-len rb))
                (store! ok false)
                (for [j 0 (al-len ra)]
                  (let [x (al-get ra j)
                        y (al-get rb j)
                        same
                          (match x
                            (None [] (match y (None [] true) (Some [_] false)))
                            (Some [p]
                                  (match y (None [] false) (Some [q] (= p q)))))]
                    (when (not same) (store! ok false) 0))))))
        (load ok))))

(defn smap-eq [(a SMap) (b SMap)] (-> bool)
  (let [ma (.m a)
        mb (.m b)]
    (if (!= (hm-len ma) (hm-len mb))
        false
        (let [(mut ok) true
              cap (hm-cap ma)
              slots (load (field ma slots))]
          (for [i 0 cap]
            (let [e (primitive/index slots i)]
              (when (= (load (field e state)) (cast i64 1))
                (match (hm-get mb (load (field e key)))
                  (None [] (store! ok false))
                  (Some [v] (if (= v (load (field e val))) 0 (store! ok false))))
                0)))
          (load ok)))))

(defn rec-eq [(exact bool) (a Rec) (b Rec)] (-> bool)
  (let [(mut ok) true]
    (when (!= (.id a) (.id b)) (store! ok false) 0)
    (when (!= (.u a) (.u b)) (store! ok false) 0)
    (when (!= (.small a) (.small b)) (store! ok false) 0)
    (when (!= (.w a) (.w b)) (store! ok false) 0)
    (when (!= (.x a) (.x b)) (store! ok false) 0)
    (when (!= (.flag a) (.flag b)) (store! ok false) 0)
    (when (not (feq exact (.score a) (.score b))) (store! ok false) 0)
    (when (!= (.v (.name a)) (.v (.name b))) (store! ok false) 0)
    (when (!= (.v (.blob a)) (.v (.blob b))) (store! ok false) 0)
    (when (not (oieq (.nick a) (.nick b))) (store! ok false) 0)
    (when (not (li64-eq (.tags a) (.tags b))) (store! ok false) 0)
    (let [ia (.inners a)
          ib (.inners b)]
      (if (!= (al-len ia) (al-len ib))
          (store! ok false)
          (for [i 0 (al-len ia)]
            (when (not (inner-eq exact (al-get ia i) (al-get ib i)))
              (store! ok false)
              0))))
    (let [sa (.shapes a)
          sb (.shapes b)]
      (if (!= (al-len sa) (al-len sb))
          (store! ok false)
          (for [i 0 (al-len sa)]
            (when (not (shape-eq exact (al-get sa i) (al-get sb i)))
              (store! ok false)
              0))))
    (when (not (oshape-eq exact (.maybe a) (.maybe b))) (store! ok false) 0)
    (when (not (grid-eq (.grid a) (.grid b))) (store! ok false) 0)
    (when (not (smap-eq (.dict a) (.dict b))) (store! ok false) 0)
    (load ok)))


(defn jarr-eq [(exact bool) (a (ptr (ArrayList JVal))) (b (ptr (ArrayList JVal)))] (-> bool)
  (let [la (load a)
        lb (load b)]
    (if (!= (al-len la) (al-len lb))
        false
        (let [(mut ok) true]
          (for [i 0 (al-len la)]
            (when (not (jv-eq exact (al-get la i) (al-get lb i))) (store! ok false) 0))
          (load ok)))))

(defn jobj-eq [(exact bool)
               (a (ptr (HashMap (slice u8) JVal)))
               (b (ptr (HashMap (slice u8) JVal)))] (-> bool)
  (let [ma (load a)
        mb (load b)]
    (if (!= (hm-len ma) (hm-len mb))
        false
        (let [(mut ok) true
              cap (hm-cap ma)
              slots (load (field ma slots))]
          (for [i 0 cap]
            (let [e (primitive/index slots i)]
              (when (= (load (field e state)) (cast i64 1))
                (match (hm-get mb (load (field e key)))
                  (None [] (store! ok false))
                  (Some [v]
                        (if (jv-eq exact (load (field e val)) v) 0 (store! ok false))))
                0)))
          (load ok)))))

;;; Structural JVal equality. exact: floats bit-exact (msgpack); otherwise
;;; NaN-insensitive (sexp spells every NaN `nan`). A JInt never equals a JFloat.
(defn jv-eq [(exact bool) (a JVal) (b JVal)] (-> bool)
  (match a
    (JNull [] (match b (JNull [] true) (_ false)))
    (JBool [x] (match b (JBool [y] (= x y)) (_ false)))
    (JInt [x]
          (match b (JInt [y] (= x y)) (_ false)))
    (JFloat [x]
            (match b (JFloat [y] (feq exact x y)) (_ false)))
    (JStr [x] (match b (JStr [y] (= x y)) (_ false)))
    (JBytes [x] (match b (JBytes [y] (= x y)) (_ false)))
    (JArr [x] (match b (JArr [y] (jarr-eq exact x y)) (_ false)))
    (JObj [x] (match b (JObj [y] (jobj-eq exact x y)) (_ false)))))

; ============================================================ byte builders
(defn push-u8! [(l (mut (ArrayList u8))) (b i64)] (-> i64)
  (al-push! (mut l) (primitive/cast u8 (primitive/iand b 255)))
  0)

(defn push-be! [(l (mut (ArrayList u8))) (v i64) (n i64)] (-> i64)
  (let [(mut i) (- n 1)]
    (while (>= (load i) 0)
      (push-u8! (mut l) (primitive/ishr v (* (load i) 8)))
      (store! i (- (load i) 1))))
  0)

(defn push-slice! [(l (mut (ArrayList u8))) (s (slice u8))] (-> i64)
  (for [i 0 (slice-len s)] (al-push! (mut l) (slice-get s i)))
  0)

(defn bytes-of [(l (ArrayList u8))] (-> (slice u8))
  (slice-new [u8] (load (field l data)) (al-len l)))

;;; Every wire name the derived types use, plus format keywords — the dictionary
;;; that lets generated documents actually hit field lookups and variant arms.
(defn dict-word [(k i64)] (-> (slice u8))
  (case k
    0 "id" 1 "u" 2 "small" 3 "w" 4 "x" 5 "flag" 6 "score" 7 "name" 8 "blob"
    9 "nick" 10 "tags" 11 "inners" 12 "shapes" 13 "maybe" 14 "grid" 15 "dict"
    16 "a" 17 "s" 18 "f" 19 "Dot" 20 "Circle" 21 "r" 22 "Rect" 23 "h"
    24 "Named" 25 "pts" 26 "Wrap" 27 "inner" 28 "Maybe" 29 "o" 30 "Unit2"
    31 "Pair2" 32 "y" 33 "map" 34 "Rec" 35 "Inner" 36 "nil" 37 "true"
    38 "false" 39 "nan" 40 "inf" 41 "-inf" 42 "Shape" 43 "Shape2"
    ""))

(const DICT-N 45)

(defn draw-word [(s (ptr Source))] (-> (slice u8))
  (if (= (draw-int! s 0 3) 0)
      (arb-bytes s 0 (draw-int! s 0 8))
      (dict-word (draw-int! s 0 (- DICT-N 1)))))

; ============================================================ msgpack generator
;;; The length of a deep-nesting or wide-map run: usually short, often right at
;;; the decoders' 64-level depth limit, sometimes tens of thousands (deep enough to
;;; overflow an unbounded recursion, wide enough to expose quadratic lookups).
(defn draw-run-len [(s (ptr Source))] (-> i64)
  (let [k (draw-int! s 0 5)]
    (cond (<= k 2) (draw-int! s 0 16)
          (= k 3) (draw-int! s 60 68)
          (= k 4) (draw-int! s 0 2000)
          :else (draw-int! s 0 70000))))


;;; A msgpack string with a randomly chosen (possibly non-minimal) header width.
(defn mp-gen-str! [(s (ptr Source)) (out (mut (ArrayList u8))) (body (slice u8))] (-> i64)
  (let [n (slice-len body)
        w (draw-int! s 0 3)]
    (cond (and (= w 0) (< n 32)) (push-u8! (mut out) (+ 160 n))
          (and (<= w 1) (< n 256)) (do (push-u8! (mut out) 217) (push-be! (mut out) n 1))
          (and (<= w 2) (< n 65536)) (do (push-u8! (mut out) 218) (push-be! (mut out) n 2))
          :else (do (push-u8! (mut out) 219) (push-be! (mut out) n 4)))
    (push-slice! (mut out) body)))

;;; A container header for `n` items; kind 0 = array, 1 = map.
(defn mp-gen-hdr! [(s (ptr Source)) (out (mut (ArrayList u8))) (kind i64) (n i64)] (-> i64)
  (let [w (draw-int! s 0 2)
        fix (if (= kind 0) 144 128)
        t16 (if (= kind 0) 220 222)
        t32 (if (= kind 0) 221 223)]
    (cond (and (= w 0) (< n 16)) (push-u8! (mut out) (+ fix n))
          (and (<= w 1) (< n 65536)) (do (push-u8! (mut out) t16) (push-be! (mut out) n 2))
          :else (do (push-u8! (mut out) t32) (push-be! (mut out) n 4)))))

;;; An integer in any of msgpack's encodings (including non-minimal ones and
;;; out-of-range tags for the value — the decoder must range-check).
(defn mp-gen-int! [(s (ptr Source)) (out (mut (ArrayList u8)))] (-> i64)
  (let [v (draw-int-any! s)
        k (draw-int! s 0 9)]
    (case k
      0 (push-u8! (mut out) (primitive/iand v 127))
      1 (push-u8! (mut out) (+ 224 (primitive/iand v 31)))
      2 (do (push-u8! (mut out) 204) (push-be! (mut out) v 1))
      3 (do (push-u8! (mut out) 205) (push-be! (mut out) v 2))
      4 (do (push-u8! (mut out) 206) (push-be! (mut out) v 4))
      5 (do (push-u8! (mut out) 207) (push-be! (mut out) v 8))
      6 (do (push-u8! (mut out) 208) (push-be! (mut out) v 1))
      7 (do (push-u8! (mut out) 209) (push-be! (mut out) v 2))
      8 (do (push-u8! (mut out) 210) (push-be! (mut out) v 4))
      (do (push-u8! (mut out) 211) (push-be! (mut out) v 8)))))

;;; One msgpack value, structure-aware. Container counts are occasionally WRONG
;;; (one more or fewer than written) so the decoder's bounds checks get exercised,
;;; and `run` nodes repeat one child many times (deep nesting / wide maps) so the
;;; generator can reach recursion-depth and complexity limits in few choices.
(defn mp-gen! [(s (ptr Source)) (out (mut (ArrayList u8))) (depth i64)] (-> i64)
  (let [sp (span-open! s "mp" SPAN-NODE)
        top (if (>= depth 6) 7 13)
        k (draw-int! s 0 top)]
    (case k
      0 (mp-gen-int! s (mut out))
      1 (push-u8! (mut out) 192)
      2 (push-u8! (mut out) (if (draw-bool! s) 195 194))
      3 (do (push-u8! (mut out) 203) (push-be! (mut out) (draw-int-any! s) 8))
      4 (mp-gen-str! s (mut out) (draw-word s))
      5 (mp-gen-str! s (mut out) (arb-fullbytes s))
      6 (let [b (arb-fullbytes s)
              n (slice-len b)
              w (draw-int! s 0 2)]
          (cond (and (= w 0) (< n 256)) (do (push-u8! (mut out) 196) (push-be! (mut out) n 1))
                (and (<= w 1) (< n 65536)) (do (push-u8! (mut out) 197) (push-be! (mut out) n 2))
                :else (do (push-u8! (mut out) 198) (push-be! (mut out) n 4)))
          (push-slice! (mut out) b))
      7 (push-u8! (mut out) (draw-int! s 0 255))  ; any single byte
      8 (let [n (draw-len! s 0 6)
              skew (draw-int! s -1 1)
              wrong (= (draw-int! s 0 7) 0)]
          (mp-gen-hdr! s (mut out) 0 (if wrong (primitive/iand (+ n skew) 0xffff) n))
          (for [i 0 n]
            (let [esp (span-open! s "item" SPAN-ELEM)]
              (mp-gen! s (mut out) (+ depth 1))
              (span-close! s esp))))
      9 (let [n (draw-len! s 0 6)
              skew (draw-int! s -1 1)
              wrong (= (draw-int! s 0 7) 0)]
          (mp-gen-hdr! s (mut out) 1 (if wrong (primitive/iand (+ n skew) 0xffff) n))
          (for [i 0 n]
            (let [esp (span-open! s "pair" SPAN-ELEM)]
              (if (= (draw-int! s 0 9) 0)
                  (mp-gen! s (mut out) (+ depth 1))  ; a non-string key
                  (mp-gen-str! s (mut out) (draw-word s)))
              (mp-gen! s (mut out) (+ depth 1))
              (span-close! s esp))))
      ; a variant: {tag: payload-map} or a bare tag
      10 (let [tag (dict-word (draw-int! s 19 32))]
           (if (draw-bool! s)
               (mp-gen-str! s (mut out) tag)
               (do
                 (mp-gen-hdr! s (mut out) 1 1)
                 (mp-gen-str! s (mut out) tag)
                 (mp-gen! s (mut out) (+ depth 1)))))
      ; deep nesting: `n` single-element arrays (or maps) around one leaf
      11 (let [n (draw-run-len s)
               asmap (draw-bool! s)]
           (for [i 0 n]
             (if asmap
                 (do (push-u8! (mut out) 129) (push-u8! (mut out) 160) 0)
                 (push-u8! (mut out) 145)))
           (mp-gen! s (mut out) (+ depth 1)))
      ; a wide map: n copies of one entry (complexity of keyed lookup)
      12 (let [n (draw-run-len s)]
           (push-u8! (mut out) 223)
           (push-be! (mut out) n 4)
           (for [i 0 n] (do (push-u8! (mut out) 160) (push-u8! (mut out) 0) 0))
           0)
      ; a random ext / reserved tag with a small body
      (do
        (push-u8! (mut out) (dict-ext (draw-int! s 0 9)))
        (push-slice! (mut out) (arb-bytes s 0 (draw-int! s 0 17)))))
    (span-close! s sp)
    0))

(defn dict-ext [(k i64)] (-> i64)
  (case k 0 193 1 199 2 200 3 201 4 212 5 213 6 214 7 215 8 216 202))

(defn mp-gen-doc [(s (ptr Source))] (-> (slice u8))
  (let [(mut out) (al-new [u8] (src-alloc s))]
    (mp-gen! s (mut out) 0)
    (bytes-of (load out))))

; ============================================================ sexp generator
(defn sx-gen-num [(s (ptr Source))] (-> (slice u8))
  (let [a (src-alloc s)
        (mut sb) (sb-new a)
        k (draw-int! s 0 9)]
    (case k
      0 (sb-push-i64! (mut sb) (draw-int-any! s))
      1 (sb-push-str! (mut sb) (dict-num (draw-int! s 0 15)))
      2 (do
          (sb-push-i64! (mut sb) (draw-int! s -100000 100000))
          (sb-push-str! (mut sb) ".")
          (sb-push-i64! (mut sb) (draw-int! s 0 99999))
          0)
      3 (do
          (sb-push-i64! (mut sb) (draw-int! s -9 9))
          (sb-push-str! (mut sb) "e")
          (sb-push-i64! (mut sb) (draw-int! s -330 330))
          0)
      ; digits then junk: what a strict number parser must reject
      4 (do
          (sb-push-i64! (mut sb) (draw-int! s -999 999))
          (sb-push-str! (mut sb) (arb-bytes s 0 3))
          0)
      (sb-push-i64! (mut sb) (draw-int! s -1000 1000)))
    (sb-finish! (mut sb))))

(defn dict-num [(k i64)] (-> (slice u8))
  (case k
    0 "-" 1 "-0" 2 "9223372036854775807" 3 "9223372036854775808"
    4 "-9223372036854775808" 5 "-9223372036854775809" 6 "18446744073709551615"
    7 "18446744073709551616" 8 "1e" 9 "1.5.5" 10 "0x10" 11 "1e999" 12 "-."
    13 "00" 14 "255"
    "4294967296"))

;;; A string literal body: arbitrary bytes, with `"` and `\` escaped or not.
(defn sx-gen-strlit! [(s (ptr Source)) (out (mut (ArrayList u8)))] (-> i64)
  (push-u8! (mut out) 34)
  (let [body (arb-fullbytes s)
        raw (= (draw-int! s 0 7) 0)]
    (for [i 0 (slice-len body)]
      (let [c (primitive/cast i64 (slice-get body i))]
        (when (and (not raw) (or (= c 34) (= c 92))) (push-u8! (mut out) 92) 0)
        (push-u8! (mut out) c))))
  (push-u8! (mut out) 34))

(defn sx-ws! [(s (ptr Source)) (out (mut (ArrayList u8)))] (-> i64)
  (let [k (draw-int! s 0 5)]
    (case k
      0 (push-u8! (mut out) 32)
      1 (push-u8! (mut out) 10)
      2 (push-u8! (mut out) 9)
      3 (push-u8! (mut out) 13)
      4 0
      (push-slice! (mut out) "  "))))

;;; One sexp datum, structure-aware (lists with dictionary heads, strings with
;;; escapes, #"hex" bytes, number edge cases), with occasional unbalanced parens
;;; and `run` nodes that nest deeply.
(defn sx-gen! [(s (ptr Source)) (out (mut (ArrayList u8))) (depth i64)] (-> i64)
  (let [sp (span-open! s "sx" SPAN-NODE)
        top (if (>= depth 6) 5 9)
        k (draw-int! s 0 top)]
    (case k
      0 (push-slice! (mut out) (sx-gen-num s))
      1 (push-slice! (mut out) (draw-word s))  ; a bare symbol (may be empty/garbage)
      2 (sx-gen-strlit! s (mut out))
      3 (do  ; #"hex"
          (push-slice! (mut out) "#\"")
          (let [n (draw-int! s 0 9)]
            (for [i 0 n]
              (push-u8! (mut out) (hexish (draw-int! s 0 22)))))
          (push-u8! (mut out) 34))
      4 (push-slice! (mut out) (dict-word (draw-int! s 36 41)))
      5 (push-u8! (mut out) (draw-int! s 0 255))
      ; a list: (HEAD k v k v …) or (a b c)
      6 (let [n (draw-len! s 0 6)]
          (push-u8! (mut out) 40)
          (when (draw-bool! s)
            (push-slice! (mut out) (dict-word (draw-int! s 19 35)))
            0)
          (for [i 0 n]
            (let [esp (span-open! s "item" SPAN-ELEM)]
              (sx-ws! s (mut out))
              (when (draw-bool! s)
                (push-slice! (mut out) (draw-word s))
                (push-u8! (mut out) 32)
                0)
              (sx-gen! s (mut out) (+ depth 1))
              (span-close! s esp)))
          (sx-ws! s (mut out))
          (when (!= (draw-int! s 0 15) 0) (push-u8! (mut out) 41) 0)
          0)
      ; a variant: bare tag or (Tag field v …)
      7 (let [tag (dict-word (draw-int! s 19 32))]
          (if (draw-bool! s)
              (push-slice! (mut out) tag)
              (do
                (push-u8! (mut out) 40)
                (push-slice! (mut out) tag)
                (let [n (draw-len! s 0 3)]
                  (for [i 0 n]
                    (do
                      (push-u8! (mut out) 32)
                      (push-slice! (mut out) (dict-word (draw-int! s 16 32)))
                      (push-u8! (mut out) 32)
                      (sx-gen! s (mut out) (+ depth 1))
                      0)))
                (push-u8! (mut out) 41))))
      ; deep nesting run
      8 (let [n (draw-run-len s)]
          (for [i 0 n] (push-u8! (mut out) 40))
          (sx-gen! s (mut out) (+ depth 1))
          (for [i 0 n] (push-u8! (mut out) 41))
          0)
      ; wide struct / map run: (HEAD k v k v … ×n)
      (let [n (draw-run-len s)
            head (if (draw-bool! s) "map" "Inner")]
        (push-u8! (mut out) 40)
        (push-slice! (mut out) head)
        (for [i 0 n] (push-slice! (mut out) (if (= head "map") " \"\" 0" " z 0")))
        (push-u8! (mut out) 41)
        0))
    (span-close! s sp)
    0))

(defn hexish [(k i64)] (-> i64)
  (if (< k 10) (+ 48 k) (if (< k 16) (+ 55 k) (if (< k 22) (+ 81 k) 71))))

(defn sx-gen-doc [(s (ptr Source))] (-> (slice u8))
  (let [(mut out) (al-new [u8] (src-alloc s))]
    (sx-ws! s (mut out))
    (sx-gen! s (mut out) 0)
    (sx-ws! s (mut out))
    (bytes-of (load out))))

(defn mp-hot [(k i64)] (-> i64)
  (case k 0 0 1 127 2 128 3 129 4 143 5 144 6 145 7 159 8 160 9 161 10 191 11 192 12 194 13 195 14 196 15 197 16 198 17 202 18 203 19 204 20 207 21 208 22 211 23 217 24 218 25 219 26 220 27 221 28 222 29 223 30 224 255))

(const MP-HOT-N 32)

(defn sx-hot [(k i64)] (-> i64)
  (case k 0 40 1 41 2 34 3 92 4 35 5 32 6 45 7 46 8 101 9 48 10 49 11 50 12 51 13 52 14 53 15 54 16 55 17 56 18 57 19 110 20 105 21 108 22 97 23 68 24 111 25 116 26 67 27 105 28 114 29 99 30 108 101))

(const SX-HOT-N 32)

; ============================================================ byte mutators
;;; Apply 1..4 random edits to `src`: overwrite, insert, delete, truncate, or
;;; overwrite with a byte from `hot` (format-significant bytes).
(defn hot-byte [(sx bool) (s (ptr Source))] (-> u8)
  (primitive/cast u8 (if sx (sx-hot (draw-int! s 0 (- SX-HOT-N 1))) (mp-hot (draw-int! s 0 (- MP-HOT-N 1))))))

(defn splice-edit [(a (dyn Allocator)) (cur (slice u8)) (pos i64) (drop i64) (ins i64)] (-> (slice u8))
  ; bytes [0,pos) ++ (ins >= 0 ? [ins] : []) ++ bytes [pos+drop, n)
  (let [(mut l) (al-new [u8] a)
        n (slice-len cur)]
    (push-slice! (mut l) (subslice cur 0 pos))
    (when (>= ins 0) (push-u8! (mut l) ins) 0)
    (when (< (+ pos drop) n) (push-slice! (mut l) (subslice cur (+ pos drop) n)) 0)
    (bytes-of (load l))))

;;; Apply 1..4 random edits: overwrite, insert, delete, truncate — with random
;;; bytes or format-significant `hot` bytes.
(defn mutate [(s (ptr Source)) (src (slice u8)) (sx bool)] (-> (slice u8))
  (let [a (src-alloc s)
        (mut cur) src
        k (draw-int! s 1 4)]
    (for [j 0 k]
      (let [n (slice-len (load cur))
            op (draw-int! s 0 6)
            pos (draw-int! s 0 (if (> n 0) (- n 1) 0))
            b (if (draw-bool! s) (primitive/cast i64 (hot-byte sx s)) (draw-int! s 0 255))]
        (store! cur
                (cond (= n 0) (splice-edit a (load cur) 0 0 b)
                      (<= op 1) (splice-edit a (load cur) pos 1 b)
                      (<= op 3) (splice-edit a (load cur) pos 0 b)
                      (= op 4) (splice-edit a (load cur) pos 1 -1)
                      (= op 5) (subslice (load cur) 0 pos)
                      :else (splice-edit a (load cur) pos (draw-int! s 0 (- n pos)) -1)))))
    (load cur)))



; ============================================================ weird encoders
; Alternative, still-VALID encoders written against the Serializer trait, so any
; derived value can be emitted in a non-canonical but legal form: every integer /
; string / container header width that fits, unknown extra fields inside structs
; and variant payloads, both unit-variant spellings, whitespace and escape
; variation. The law: decode(weird-encode(x)) = x.

;;; A well-formed msgpack value (correct counts, supported tags) for junk fields.
(defn mp-gen-valid! [(s (ptr Source)) (out (mut (ArrayList u8))) (depth i64)] (-> i64)
  (let [k (draw-int! s 0 (if (>= depth 2) 5 7))]
    (case k
      0 (mp-gen-int! s (mut out))
      1 (push-u8! (mut out) 192)
      2 (push-u8! (mut out) (if (draw-bool! s) 195 194))
      3 (do (push-u8! (mut out) 203) (push-be! (mut out) (draw-int-any! s) 8))
      4 (mp-gen-str! s (mut out) (draw-word s))
      5 (let [b (arb-bytes s 0 (draw-int! s 0 5))]
          (push-u8! (mut out) 196)
          (push-be! (mut out) (slice-len b) 1)
          (push-slice! (mut out) b))
      6 (let [n (draw-int! s 0 3)]
          (mp-gen-hdr! s (mut out) 0 n)
          (for [i 0 n] (mp-gen-valid! s (mut out) (+ depth 1))))
      (let [n (draw-int! s 0 3)]
        (mp-gen-hdr! s (mut out) 1 n)
        (for [i 0 n]
          (do
            (mp-gen-str! s (mut out) (draw-word s))
            (mp-gen-valid! s (mut out) (+ depth 1))
            0))))
    0))

(defstruct WMp
  [(out (ptr (ArrayList u8)))
   (s (ptr Source))
   (stk (array i64 64))
   (sp i64)
   (junk bool)])  ; false = never write unknown fields

(defn wm-b [(p (ptr WMp)) (b i64)] (-> (Result i64 SerError))
  (push-u8! (mut (load (field p out))) b)
  (Ok 0))

(defn wm-be [(p (ptr WMp)) (v i64) (n i64)] (-> (Result i64 SerError))
  (push-be! (mut (load (field p out))) v n)
  (Ok 0))

(defn wm-str [(p (ptr WMp)) (v (slice u8))] (-> (Result i64 SerError))
  (mp-gen-str! (load (field p s)) (mut (load (field p out))) v)
  (Ok 0))

(defn wm-hdr [(p (ptr WMp)) (kind i64) (n i64)] (-> (Result i64 SerError))
  (mp-gen-hdr! (load (field p s)) (mut (load (field p out))) kind n)
  (Ok 0))

(defn fits-s? [(v i64) (bits i64)] (-> bool)
  (let [lo (primitive/isub 0 (primitive/ishl 1 (- bits 1)))
        hi (- (primitive/ishl 1 (- bits 1)) 1)]
    (and (>= v lo) (<= v hi))))

;;; An integer (signed view) in a randomly chosen encoding that represents it.
(defn wm-int [(p (ptr WMp)) (v i64) (unsigned bool)] (-> (Result i64 SerError))
  (let [s (load (field p s))
        (mut k) (draw-int! s 0 9)
        (mut done) false]
    (loop
      (if (load done)
          (break)
          (let [c (load k)
                ok
                  (case c
                    0 (and (>= v 0) (< v 128))
                    1 (and (not unsigned) (and (>= v -32) (< v 0)))
                    2 (and (>= v 0) (< v 256))
                    3 (and (>= v 0) (< v 65536))
                    4 (and (>= v 0) (< v 4294967296))
                    5 (or unsigned (>= v 0))
                    6 (and (not unsigned) (fits-s? v 8))
                    7 (and (not unsigned) (fits-s? v 16))
                    8 (and (not unsigned) (fits-s? v 32))
                    (and (not unsigned) true))]
            (if ok
                (do
                  (case c
                    0 (wm-b p v)
                    1 (wm-b p (+ v 256))
                    2 (do (wm-b p 204) (wm-be p v 1))
                    3 (do (wm-b p 205) (wm-be p v 2))
                    4 (do (wm-b p 206) (wm-be p v 4))
                    5 (do (wm-b p 207) (wm-be p v 8))
                    6 (do (wm-b p 208) (wm-be p v 1))
                    7 (do (wm-b p 209) (wm-be p v 2))
                    8 (do (wm-b p 210) (wm-be p v 4))
                    (do (wm-b p 211) (wm-be p v 8)))
                  (store! done true))
                (store! k (primitive/irem (+ c 1) 10))))))
    (Ok 0)))

;;; Emit one unknown (never a real wire name: they start with "~") key + value.
(defn wm-junk-pair [(p (ptr WMp))] (-> i64)
  (let [s (load (field p s))
        (mut kb) (al-new [u8] (src-alloc s))]
    (push-u8! (mut kb) 126)
    (push-slice! (mut kb) (arb-bytes s 0 (draw-int! s 0 4)))
    (mp-gen-str! s (mut (load (field p out))) (bytes-of (load kb)))
    (mp-gen-valid! s (mut (load (field p out))) 0)))

(defn wm-frame-open [(p (ptr WMp)) (nfields i64)] (-> (Result i64 SerError))
  (let [e (if (load (field p junk)) (draw-int! (load (field p s)) 0 2) 0)]
    (store! (primitive/index (field p stk) (load (field p sp))) e)
    (store! (field p sp) (+ (load (field p sp)) 1))
    (wm-hdr p 1 (+ nfields e))))

(defn wm-maybe-junk [(p (ptr WMp)) (flush bool)] (-> i64)
  (let [slot (primitive/index (field p stk) (- (load (field p sp)) 1))]
    (loop
      (if (and (> (load slot) 0) (or flush (draw-bool! (load (field p s)))))
          (do (wm-junk-pair p) (store! slot (- (load slot) 1)) 0)
          (break)))
    0))

(defn wm-frame-close [(p (ptr WMp))] (-> (Result i64 SerError))
  (wm-maybe-junk p true)
  (store! (field p sp) (- (load (field p sp)) 1))
  (Ok 0))

(impl Serializer WMp
  (ser-null [(s (ptr WMp))] (-> (Result i64 SerError)) (wm-b s 192))
  (ser-bool [(s (ptr WMp)) (v bool)] (-> (Result i64 SerError)) (wm-b s (if v 195 194)))
  (ser-i64 [(s (ptr WMp)) (v i64)] (-> (Result i64 SerError)) (wm-int s v false))
  (ser-u64 [(s (ptr WMp)) (v i64)] (-> (Result i64 SerError)) (wm-int s v true))
  (ser-f64 [(s (ptr WMp)) (v f64)]
           (-> (Result i64 SerError))
           (do (wm-b s 203) (wm-be s (mem/f64-bits v) 8)))
  (ser-str [(s (ptr WMp)) (v (slice u8))] (-> (Result i64 SerError)) (wm-str s v))
  (ser-bytes [(s (ptr WMp)) (v (slice u8))]
             (-> (Result i64 SerError))
             (let [n (slice-len v)
                   w (draw-int! (load (field s s)) 0 2)]
               (cond (and (= w 0) (< n 256)) (do (wm-b s 196) (wm-be s n 1))
                     (and (<= w 1) (< n 65536)) (do (wm-b s 197) (wm-be s n 2))
                     :else (do (wm-b s 198) (wm-be s n 4)))
               (push-slice! (mut (load (field s out))) v)
               (Ok 0)))
  (seq-begin [(s (ptr WMp)) (len i64)] (-> (Result i64 SerError)) (wm-hdr s 0 len))
  (seq-elem [(s (ptr WMp))] (-> (Result i64 SerError)) (Ok 0))
  (seq-end [(s (ptr WMp))] (-> (Result i64 SerError)) (Ok 0))
  (map-begin [(s (ptr WMp)) (len i64)] (-> (Result i64 SerError)) (wm-hdr s 1 len))
  (map-key [(s (ptr WMp)) (k (slice u8))] (-> (Result i64 SerError)) (wm-str s k))
  (map-end [(s (ptr WMp))] (-> (Result i64 SerError)) (Ok 0))
  (struct-begin [(s (ptr WMp)) (name (slice u8)) (nfields i64)]
                (-> (Result i64 SerError))
                (wm-frame-open s nfields))
  (field-key [(s (ptr WMp)) (name (slice u8))]
             (-> (Result i64 SerError))
             (do (wm-maybe-junk s false) (wm-str s name)))
  (struct-end [(s (ptr WMp))] (-> (Result i64 SerError)) (wm-frame-close s))
  (variant-unit [(s (ptr WMp)) (sum (slice u8)) (tag (slice u8))]
                (-> (Result i64 SerError))
                (if (or (not (load (field s junk))) (draw-bool! (load (field s s))))
                    (wm-str s tag)
                    (do  ; {tag: <anything>} — the payload of a unit variant is skipped
                      (wm-hdr s 1 1)
                      (wm-str s tag)
                      (mp-gen-valid! (load (field s s)) (mut (load (field s out))) 0)
                      (Ok 0))))
  (variant-begin [(s (ptr WMp)) (sum (slice u8)) (tag (slice u8)) (nfields i64)]
                 (-> (Result i64 SerError))
                 (do (wm-hdr s 1 1) (wm-str s tag) (wm-frame-open s nfields)))
  (variant-end [(s (ptr WMp))] (-> (Result i64 SerError)) (wm-frame-close s)))

(defn to-weird-msgpack [(T Serialize)] [(src (ptr Source)) (x T) (junk bool)] (-> (slice u8))
  (let [out (box! (src-alloc src) (ArrayList u8) (al-new [u8] (src-alloc src)))
        p (primitive/alloc-stack WMp)]
    (store! p (zeroed WMp))
    (store! (field p out) out)
    (store! (field p s) src)
    (store! (field p junk) junk)
    (ser x (primitive/make-dyn Serializer p))
    (bytes-of (load out))))

;;; unsigned decimal
(defn push-udec! [(l (mut (ArrayList u8))) (v i64)] (-> i64)
  (let [q (primitive/udiv v 10)]
    (when (!= q 0) (push-udec! (mut l) q) 0)
    (push-u8! (mut l) (+ 48 (primitive/urem v 10)))))

;;; ---- sexp ----
(defstruct WSx
  [(out (ptr (ArrayList u8)))
   (s (ptr Source))
   (stk (array i64 66))  ; per-level: 1 = next item needs a separator
   (jk (array i64 66))   ; per-level pending junk fields
   (depth i64)
   (junk bool)
   (unitlist bool)])     ; spell unit variants as (Tag) instead of a bare Tag

(defn wx-out [(p (ptr WSx))] (-> (ptr (ArrayList u8))) (load (field p out)))

(defn wx-ws [(p (ptr WSx))] (-> i64)
  (let [s (load (field p s))
        n (draw-int! s 1 3)]
    (for [i 0 n]
      (push-u8! (mut (wx-out p))
                (case (draw-int! s 0 5) 0 9 1 10 2 13 32)))
    0))

(defn wx-sep [(p (ptr WSx))] (-> i64)
  (let [slot (primitive/index (field p stk) (load (field p depth)))]
    (if (= (load slot) 1)
        (wx-ws p)
        (do
          (store! slot 1)
          (when (= (draw-int! (load (field p s)) 0 3) 0) (wx-ws p) 0)
          0))))

(defn wx-open [(p (ptr WSx)) (head (slice u8))] (-> (Result i64 SerError))
  (if (>= (load (field p depth)) 63)
      (Err (ser-err SER-E-DEPTH))
      (do
        (push-u8! (mut (wx-out p)) 40)
        (when (= (draw-int! (load (field p s)) 0 3) 0) (wx-ws p) 0)
        (store! (field p depth) (+ (load (field p depth)) 1))
        (store! (primitive/index (field p stk) (load (field p depth))) 0)
        (store! (primitive/index (field p jk) (load (field p depth))) 0)
        (when (> (slice-len head) 0)
          (push-slice! (mut (wx-out p)) head)
          (store! (primitive/index (field p stk) (load (field p depth))) 1)
          0)
        (Ok 0))))

(defn wx-close [(p (ptr WSx))] (-> (Result i64 SerError))
  (when (= (draw-int! (load (field p s)) 0 3) 0) (wx-ws p) 0)
  (push-u8! (mut (wx-out p)) 41)
  (store! (field p depth) (- (load (field p depth)) 1))
  (Ok 0))

;;; A string literal: `"` and `\` must be escaped; \n \t \r may be; any other
;;; byte except n/t/r may be written as `\` + itself (the decoder's rule).
(defn wx-strlit [(p (ptr WSx)) (v (slice u8))] (-> (Result i64 SerError))
  (let [s (load (field p s))
        o (wx-out p)]
    (push-u8! (mut o) 34)
    (for [i 0 (slice-len v)]
      (let [c (primitive/cast i64 (slice-get v i))
            e (= (draw-int! s 0 5) 0)]
        (cond (or (= c 34) (= c 92)) (do (push-u8! (mut o) 92) (push-u8! (mut o) c))
              (and (= c 10) e) (do (push-u8! (mut o) 92) (push-u8! (mut o) 110))
              (and (= c 9) e) (do (push-u8! (mut o) 92) (push-u8! (mut o) 116))
              (and (= c 13) e) (do (push-u8! (mut o) 92) (push-u8! (mut o) 114))
              (and e (and (!= c 110) (and (!= c 116) (!= c 114))))
                (do (push-u8! (mut o) 92) (push-u8! (mut o) c))
              :else (push-u8! (mut o) c))))
    (push-u8! (mut o) 34)
    (Ok 0)))

(defn wx-text [(p (ptr WSx)) (t (slice u8))] (-> (Result i64 SerError))
  (push-slice! (mut (wx-out p)) t)
  (Ok 0))

(defn wx-i64 [(p (ptr WSx)) (v i64) (unsigned bool)] (-> (Result i64 SerError))
  (let [s (load (field p s))
        (mut tl) (al-new [u8] (src-alloc s))]
    (if unsigned
        (push-udec! (mut tl) v)
        (if (< v 0)
            (do (push-u8! (mut tl) 45) (push-udec! (mut tl) (primitive/isub 0 v)))
            (push-udec! (mut tl) v)))
    (let [t (bytes-of (load tl))
          neg (and (> (slice-len t) 0) (= (primitive/cast i64 (slice-get t 0)) 45))
          z (if (= (draw-int! s 0 3) 0) (draw-int! s 1 3) 0)]
      (when neg (push-u8! (mut (wx-out p)) 45) 0)
      (for [i 0 z] (push-u8! (mut (wx-out p)) 48))  ; leading zeros
      (push-slice! (mut (wx-out p)) (subslice t (if neg 1 0) (slice-len t)))
      (Ok 0))))

(defn wx-f64 [(p (ptr WSx)) (v f64)] (-> (Result i64 SerError))
  (cond (not (primitive/fcmp-eq v v)) (wx-text p "nan")
        (primitive/fcmp-eq v (primitive/fdiv 1.0 0.0)) (wx-text p "inf")
        (primitive/fcmp-eq v (primitive/fdiv -1.0 0.0)) (wx-text p "-inf")
        :else
          (let [buf (primitive/alloc-stack (array i8 48))
                k (draw-int! (load (field p s)) 0 2)
                n (primitive/cast i64
                                  (snprintf (primitive/cast (ptr i8) buf)
                                            48
                                            (case k 0 c"%.17g" 1 c"%.17e" c"%.20g")
                                            v))]
            (wx-text p (slice-new [u8] (primitive/cast (ptr u8) buf) n)))))

(defn wx-junk-value [(p (ptr WSx)) (depth i64)] (-> i64)
  (let [s (load (field p s))
        k (draw-int! s 0 (if (>= depth 2) 4 5))]
    (case k
      0 (push-slice! (mut (wx-out p)) (dict-num (draw-int! s 1 7)))
      1 (do (wx-strlit p (arb-fullbytes s)) 0)
      2 (push-slice! (mut (wx-out p)) (dict-word (draw-int! s 16 32)))
      3 (push-slice! (mut (wx-out p)) "#\"00ff\"")
      4 (push-slice! (mut (wx-out p)) "nil")
      (let [n (draw-int! s 0 3)]
        (push-u8! (mut (wx-out p)) 40)
        (for [i 0 n]
          (do (push-u8! (mut (wx-out p)) 32) (wx-junk-value p (+ depth 1)) 0))
        (push-u8! (mut (wx-out p)) 41)))
    0))

(defn wx-maybe-junk [(p (ptr WSx)) (flush bool)] (-> i64)
  (let [slot (primitive/index (field p jk) (load (field p depth)))]
    (loop
      (if (and (> (load slot) 0) (or flush (draw-bool! (load (field p s)))))
          (do
            (wx-sep p)
            (push-slice! (mut (wx-out p)) "~k")
            (wx-ws p)
            (wx-junk-value p 0)
            (store! slot (- (load slot) 1))
            0)
          (break)))
    0))

(defn wx-frame [(p (ptr WSx)) (head (slice u8))] (-> (Result i64 SerError))
  (match (wx-open p head)
    (Err [e] (Err e))
    (Ok [_]
        (do
          (store! (primitive/index (field p jk) (load (field p depth)))
                  (if (load (field p junk)) (draw-int! (load (field p s)) 0 2) 0))
          (Ok 0)))))

(defn wx-frame-close [(p (ptr WSx))] (-> (Result i64 SerError))
  (wx-maybe-junk p true)
  (wx-close p))

(impl Serializer WSx
  (ser-null [(s (ptr WSx))] (-> (Result i64 SerError)) (wx-text s "nil"))
  (ser-bool [(s (ptr WSx)) (v bool)] (-> (Result i64 SerError)) (wx-text s (if v "true" "false")))
  (ser-i64 [(s (ptr WSx)) (v i64)] (-> (Result i64 SerError)) (wx-i64 s v false))
  (ser-u64 [(s (ptr WSx)) (v i64)] (-> (Result i64 SerError)) (wx-i64 s v true))
  (ser-f64 [(s (ptr WSx)) (v f64)] (-> (Result i64 SerError)) (wx-f64 s v))
  (ser-str [(s (ptr WSx)) (v (slice u8))] (-> (Result i64 SerError)) (wx-strlit s v))
  (ser-bytes [(s (ptr WSx)) (v (slice u8))]
             (-> (Result i64 SerError))
             (let [o (wx-out s)
                   src (load (field s s))]
               (push-slice! (mut o) "#\"")
               (for [i 0 (slice-len v)]
                 (let [b (primitive/cast i64 (slice-get v i))
                       lower (draw-bool! src)
                       hi (primitive/ishr b 4)
                       lo (primitive/iand b 15)]
                   (push-u8! (mut o) (if (and lower (>= hi 10)) (+ hi 87) (sx-hexdig hi)))
                   (push-u8! (mut o) (if (and lower (>= lo 10)) (+ lo 87) (sx-hexdig lo)))))
               (push-u8! (mut o) 34)
               (Ok 0)))
  (seq-begin [(s (ptr WSx)) (len i64)] (-> (Result i64 SerError)) (wx-open s ""))
  (seq-elem [(s (ptr WSx))] (-> (Result i64 SerError)) (do (wx-sep s) (Ok 0)))
  (seq-end [(s (ptr WSx))] (-> (Result i64 SerError)) (wx-close s))
  (map-begin [(s (ptr WSx)) (len i64)] (-> (Result i64 SerError)) (wx-open s "map"))
  (map-key [(s (ptr WSx)) (k (slice u8))]
           (-> (Result i64 SerError))
           (do (wx-sep s) (wx-strlit s k) (wx-ws s) (Ok 0)))
  (map-end [(s (ptr WSx))] (-> (Result i64 SerError)) (wx-close s))
  (struct-begin [(s (ptr WSx)) (name (slice u8)) (nfields i64)]
                (-> (Result i64 SerError))
                (wx-frame s name))
  (field-key [(s (ptr WSx)) (name (slice u8))]
             (-> (Result i64 SerError))
             (do (wx-maybe-junk s false) (wx-sep s) (wx-text s name) (wx-ws s) (Ok 0)))
  (struct-end [(s (ptr WSx))] (-> (Result i64 SerError)) (wx-frame-close s))
  (variant-unit [(s (ptr WSx)) (sum (slice u8)) (tag (slice u8))]
                (-> (Result i64 SerError))
                (if (not (load (field s unitlist)))
                    (wx-text s tag)
                    (match (wx-open s tag) (Err [e] (Err e)) (Ok [_] (wx-close s)))))
  (variant-begin [(s (ptr WSx)) (sum (slice u8)) (tag (slice u8)) (nfields i64)]
                 (-> (Result i64 SerError))
                 (wx-frame s tag))
  (variant-end [(s (ptr WSx))] (-> (Result i64 SerError)) (wx-frame-close s)))

(defn to-weird-sexp [(T Serialize)] [(src (ptr Source)) (x T) (junk bool) (unitlist bool)] (-> (slice u8))
  (let [out (box! (src-alloc src) (ArrayList u8) (al-new [u8] (src-alloc src)))
        p (primitive/alloc-stack WSx)]
    (store! p (zeroed WSx))
    (store! (field p out) out)
    (store! (field p s) src)
    (store! (field p junk) junk)
    (store! (field p unitlist) unitlist)
    (when (= (draw-int! src 0 3) 0) (wx-ws p) 0)
    (ser x (primitive/make-dyn Serializer p))
    (when (= (draw-int! src 0 3) 0) (wx-ws p) 0)
    (bytes-of (load out))))

; ============================================================ document wrappers
; Generated documents are ARGUMENTS (not drawn inside the body) so a failing case
; prints them.

(defn hexdig [(n i64)] (-> i64) (if (< n 10) (+ 48 n) (+ 87 n)))

(defn debug-hex [(b (slice u8)) (f (ptr Formatter))] (-> i64)
  (let [w (formatter-writer f)
        n (slice-len b)
        (mut buf) (al-new [u8] (malloc-allocator))]
    (for [i 0 (if (> n 400) 400 n)]
      (let [c (primitive/cast i64 (slice-get b i))]
        (push-u8! (mut buf) (hexdig (primitive/ishr c 4)))
        (push-u8! (mut buf) (hexdig (primitive/iand c 15)))))
    (io/print-str w "#x[")
    (io/print-str w (bytes-of (load buf)))
    (when (> n 400) (io/print-str w "…") 0)
    (io/print-str w "] len=")
    (debug-fmt n f)
    0))

(defstruct MpDoc [(b (slice u8))])

(impl Arbitrary MpDoc
  (arbitrary [(out (mut MpDoc)) (s (ptr Source))]
             (-> i64)
             (store! (field out b) (mp-gen-doc s))
             0))

(impl Debug MpDoc
  (debug-fmt [(x MpDoc) (f (ptr Formatter))] (-> i64) (debug-hex (.b x) f)))

(defstruct SxDoc [(t (slice u8))])

(impl Arbitrary SxDoc
  (arbitrary [(out (mut SxDoc)) (s (ptr Source))]
             (-> i64)
             (store! (field out t) (sx-gen-doc s))
             0))

(impl Debug SxDoc
  (debug-fmt [(x SxDoc) (f (ptr Formatter))]
             (-> i64)
             (if (> (slice-len (.t x)) 600) (debug-hex (.t x) f) (debug-fmt (.t x) f))))

;;; Arbitrary bytes over the full 0..255 range, up to 300 long.
(defstruct Raw [(b (slice u8))])

(impl Arbitrary Raw
  (arbitrary [(out (mut Raw)) (s (ptr Source))]
             (-> i64)
             (store! (field out b) (arb-bytes s 0 (draw-int! s 0 300)))
             0))

(impl Debug Raw
  (debug-fmt [(x Raw) (f (ptr Formatter))] (-> i64) (debug-hex (.b x) f)))

;;; A rich value's encoding with 1..4 byte edits applied (msgpack / sexp).
(defstruct MpMut [(b (slice u8))])

(impl Arbitrary MpMut
  (arbitrary [(out (mut MpMut)) (s (ptr Source))]
             (-> i64)
             (let [r (arb [Rec] s)]
               (match (to-msgpack-bytes [Rec] (src-alloc s) r)
                 (Err [_] (store! (field out b) ""))
                 (Ok [bytes] (store! (field out b) (mutate s bytes false))))
               0)))

(impl Debug MpMut
  (debug-fmt [(x MpMut) (f (ptr Formatter))] (-> i64) (debug-hex (.b x) f)))

(defstruct SxMut [(t (slice u8))])

(impl Arbitrary SxMut
  (arbitrary [(out (mut SxMut)) (s (ptr Source))]
             (-> i64)
             (let [r (arb [Rec] s)]
               (match (to-sexp-str [Rec] (src-alloc s) r)
                 (Err [_] (store! (field out t) ""))
                 (Ok [text] (store! (field out t) (mutate s text true))))
               0)))

(impl Debug SxMut
  (debug-fmt [(x SxMut) (f (ptr Formatter))] (-> i64) (debug-fmt (.t x) f)))


;;; "(OptMin …" -> "(Opt …": the sexp head is the struct name.
(defn retag [(a (dyn Allocator)) (t (slice u8))] (-> (slice u8))
  (let [(mut l) (al-new [u8] a)]
    (push-slice! (mut l) "(Opt")
    (push-slice! (mut l) (subslice t 7 (slice-len t)))
    (bytes-of (load l))))

; ============================================================ checks
;;; An accepted msgpack Rec must re-encode (msgpack AND sexp) to something that
;;; decodes back to the same value. Rejection is always fine.
(defn check-mp-rec [(a (dyn Allocator)) (bytes (slice u8))] (-> bool)
  (match (from-msgpack [Rec] a bytes)
    (Err [_] true)
    (Ok [v]
        (and (match (to-msgpack-bytes [Rec] a v)
               (Err [_] false)
               (Ok [b2]
                   (match (from-msgpack [Rec] a b2)
                     (Err [_] false)
                     (Ok [v2] (rec-eq true v v2)))))
             (match (to-sexp-str [Rec] a v)
               (Err [_] false)
               (Ok [t]
                   (match (from-sexp [Rec] a t)
                     (Err [_] false)
                     (Ok [v3] (rec-eq false v v3)))))))))

(defn check-mp-jval [(a (dyn Allocator)) (bytes (slice u8))] (-> bool)
  (match (from-msgpack [JVal] a bytes)
    (Err [_] true)
    (Ok [v]
        (match (to-msgpack-bytes [JVal] a v)
          (Err [_] false)
          (Ok [b2]
              (match (from-msgpack [JVal] a b2)
                (Err [_] false)
                (Ok [v2] (jv-eq true v v2))))))))

(defn shapes-eq [(exact bool) (x (ArrayList Shape)) (y (ArrayList Shape))] (-> bool)
  (if (!= (al-len x) (al-len y))
      false
      (let [(mut ok) true]
        (for [i 0 (al-len x)]
          (when (not (shape-eq exact (al-get x i) (al-get y i))) (store! ok false) 0))
        (load ok))))

(defn check-mp-shapes [(a (dyn Allocator)) (bytes (slice u8))] (-> bool)
  (match (from-msgpack [(ArrayList Shape)] a bytes)
    (Err [_] true)
    (Ok [v]
        (match (to-msgpack-bytes [(ArrayList Shape)] a v)
          (Err [_] false)
          (Ok [b2]
              (match (from-msgpack [(ArrayList Shape)] a b2)
                (Err [_] false)
                (Ok [v2] (shapes-eq true v v2))))))))

(defn check-sx-rec [(a (dyn Allocator)) (text (slice u8))] (-> bool)
  (match (from-sexp [Rec] a text)
    (Err [_] true)
    (Ok [v]
        (and (match (to-sexp-str [Rec] a v)
               (Err [_] false)
               (Ok [t2]
                   (match (from-sexp [Rec] a t2)
                     (Err [_] false)
                     (Ok [v2] (rec-eq false v v2)))))
             (match (to-msgpack-bytes [Rec] a v)
               (Err [_] false)
               (Ok [b]
                   (match (from-msgpack [Rec] a b)
                     (Err [_] false)
                     (Ok [v3] (rec-eq true v v3)))))))))

(defn check-sx-jval [(a (dyn Allocator)) (text (slice u8))] (-> bool)
  (match (from-sexp [JVal] a text)
    (Err [_] true)
    (Ok [v]
        (match (to-sexp-str [JVal] a v)
          ; everything the decoder accepts must be writable back
          (Err [_] false)
          (Ok [t2]
              (match (from-sexp [JVal] a t2)
                (Err [_] false)
                (Ok [v2] (jv-eq false v v2))))))))

(defn check-sx-shapes [(a (dyn Allocator)) (text (slice u8))] (-> bool)
  (match (from-sexp [(ArrayList Shape)] a text)
    (Err [_] true)
    (Ok [v]
        (match (to-sexp-str [(ArrayList Shape)] a v)
          (Err [_] false)
          (Ok [t2]
              (match (from-sexp [(ArrayList Shape)] a t2)
                (Err [_] false)
                (Ok [v2] (shapes-eq false v v2))))))))

(defn check-mp-all [(a (dyn Allocator)) (b (slice u8))] (-> bool)
  (and (check-mp-rec a b) (and (check-mp-jval a b) (check-mp-shapes a b))))

(defn check-sx-all [(a (dyn Allocator)) (t (slice u8))] (-> bool)
  (and (check-sx-rec a t) (and (check-sx-jval a t) (check-sx-shapes a t))))

;;; Decode and re-encode in a Region over malloc: the deep and wide runs outgrow
;;; the 8 MiB case arena, and a Region still makes every value its own
;;; allocation, so ASan keeps a redzone after each.
(defn check-in-region [(sx bool) (b (slice u8))] (-> bool)
  (let [(mut r) (zeroed Region)]
    (region-init (mut r) (malloc-allocator))
    (let [a (region-allocator (mut r))
          ok (if sx (check-sx-all a b) (check-mp-all a b))]
      (region-close! (mut r))
      ok)))


; ============================================================ round trips
;;; from-msgpack ∘ to-msgpack-bytes = id, bit-exact.
(defprop mp-roundtrip-rec
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-msgpack-bytes [Rec] a r)
             (Err [_] false)
             (Ok [bytes]
                 (match (from-msgpack [Rec] a bytes)
                   (Err [_] false)
                   (Ok [back] (rec-eq true back r)))))))

;;; from-sexp ∘ to-sexp-str = id (NaN payloads excepted).
(defprop sexp-roundtrip-rec
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [Rec] a r)
             (Err [_] false)
             (Ok [text]
                 (match (from-sexp [Rec] a text)
                   (Err [_] false)
                   (Ok [back] (rec-eq false back r)))))))

;;; The value layer as a bridge: msgpack(Rec) -> JVal -> msgpack -> Rec = id.
;;; (u64 above i64::MAX is documented to fail as JVal with DE-E-INT-RANGE.)
(defprop mp-jval-bridge-rec
         [(r Rec)]
         (let [a (src-alloc (prop-src))]
           (match (to-msgpack-bytes [Rec] a r)
             (Err [_] false)
             (Ok [bytes]
                 (match (from-msgpack [JVal] a bytes)
                   ; a u64 above i64::MAX anywhere is documented to fail as JVal
                   (Err [e] (let [ee e] (= (.code ee) DE-E-INT-RANGE)))
                   (Ok [jv]
                       (match (to-msgpack-bytes [JVal] a jv)
                         (Err [_] false)
                         (Ok [b2]
                             (match (from-msgpack [Rec] a b2)
                               (Err [_] false)
                               (Ok [back] (rec-eq true back r)))))))))))

;;; Every proper prefix of a valid document is rejected (never crashes, never
;;; decodes to something).
(defprop mp-truncation-rejected
         [(r Rec)]
         (let [src (prop-src)
               a (src-alloc src)]
           (match (to-msgpack-bytes [Rec] a r)
             (Err [_] false)
             (Ok [bytes]
                 (let [cut (draw-int! src 0 (- (slice-len bytes) 1))]
                   (match (from-msgpack [Rec] a (subslice bytes 0 cut))
                     (Err [_] true)
                     (Ok [_] false)))))))

(defprop sexp-truncation-rejected
         [(r Rec)]
         (let [src (prop-src)
               a (src-alloc src)]
           (match (to-sexp-str [Rec] a r)
             (Err [_] false)
             (Ok [text]
                 (let [cut (draw-int! src 0 (- (slice-len text) 1))]
                   (match (from-sexp [Rec] a (subslice text 0 cut))
                     (Err [_] true)
                     (Ok [_] false)))))))

;;;; Differential against an alternative VALID encoder: every legal header width,
;;; non-minimal integers, unknown fields in structs and variant payloads, the
;;; {tag: x} spelling of unit variants. Must decode to exactly the same value.
(defprop mp-weird-encoding-decodes-same
         [(r Rec)]
         (let [src (prop-src)
               a (src-alloc src)
               b (to-weird-msgpack [Rec] src r true)]
           (match (from-msgpack [Rec] a b)
             (Err [_] false)
             (Ok [back] (rec-eq true back r)))))

;;; The same for sexp: whitespace, escape spelling, leading zeros, %e floats,
;;; mixed-case hex, unknown struct fields.
(defprop sexp-weird-encoding-decodes-same
         [(r Rec)]
         (let [src (prop-src)
               a (src-alloc src)
               t (to-weird-sexp [Rec] src r true false)]
           (match (from-sexp [Rec] a t)
             (Err [_] false)
             (Ok [back] (rec-eq false back r)))))

;;; Weird encodings then byte edits: mutants that start deep inside a VALID Rec.
(defstruct WMpMut [(b (slice u8))])

(impl Arbitrary WMpMut
  (arbitrary [(out (mut WMpMut)) (s (ptr Source))]
             (-> i64)
             (let [r (arb [Rec] s)]
               (store! (field out b) (mutate s (to-weird-msgpack [Rec] s r true) false))
               0)))

(impl Debug WMpMut
  (debug-fmt [(x WMpMut) (f (ptr Formatter))] (-> i64) (debug-hex (.b x) f)))

(defstruct WSxMut [(t (slice u8))])

(impl Arbitrary WSxMut
  (arbitrary [(out (mut WSxMut)) (s (ptr Source))]
             (-> i64)
             (let [r (arb [Rec] s)]
               (store! (field out t) (mutate s (to-weird-sexp [Rec] s r true false) true))
               0)))

(impl Debug WSxMut
  (debug-fmt [(x WSxMut) (f (ptr Formatter))] (-> i64) (debug-fmt (.t x) f)))

(defprop mp-weird-mutated [(d WMpMut)] (check-mp-all (src-alloc (prop-src)) (.b d)))

(defprop sexp-weird-mutated [(d WSxMut)] (check-sx-all (src-alloc (prop-src)) (.t d)))


; ============================================================ derive options
;;; Round trip through each format, one value and a LIST of them (the list
;;; decoder reuses one element slot, which is where stale skip fields show).
(defprop mp-opt-roundtrip
         [(xs (ArrayList Opt))]
         (let [a (src-alloc (prop-src))]
           (match (to-msgpack-bytes [(ArrayList Opt)] a xs)
             (Err [_] false)
             (Ok [b]
                 (match (from-msgpack [(ArrayList Opt)] a b)
                   (Err [_] false)
                   (Ok [back]
                       (and (= (al-len back) (al-len xs))
                            (let [(mut ok) true]
                              (for [i 0 (al-len xs)]
                                (when (not (opt-decoded-eq true (al-get xs i) (al-get back i)))
                                  (store! ok false)
                                  0))
                              (load ok)))))))))

(defprop sexp-opt-roundtrip
         [(xs (ArrayList Opt))]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [(ArrayList Opt)] a xs)
             (Err [_] false)
             (Ok [t]
                 (match (from-sexp [(ArrayList Opt)] a t)
                   (Err [_] false)
                   (Ok [back]
                       (and (= (al-len back) (al-len xs))
                            (let [(mut ok) true]
                              (for [i 0 (al-len xs)]
                                (when (not (opt-decoded-eq false (al-get xs i) (al-get back i)))
                                  (store! ok false)
                                  0))
                              (load ok)))))))))

;;; Absent fields take their (default …) / None; skipped fields are zero.
(defn opt-defaulted? [(back Opt)] (-> bool)
  (and (= (.port back) 8080)
       (and (= (.retries back) 3)
            (and (= (.secret back) 0)
                 (and (= (slice-len (.note back)) 0)
                      (osteq (.maybe-name back) (None [Str])))))))

(defprop opt-defaults-apply
         [(o Opt)]
         (let [src (prop-src)
               a (src-alloc src)
               (mut m) (zeroed OptMin)]
           (store! (field m left) (.left o))
           (store! (field m tags-list) (.tags-list o))
           (let [mm (load m)]
             (and (match (to-msgpack-bytes [OptMin] a mm)
                    (Err [_] false)
                    (Ok [b] (match (from-msgpack [Opt] a b) (Err [_] false) (Ok [back] (opt-defaulted? back)))))
                  (match (to-sexp-str [OptMin] a mm)
                    (Err [_] false)
                    (Ok [t]
                        ; the sexp struct head names the TYPE, so rewrite it
                        (match (from-sexp [Opt] a (retag a t))
                          (Err [_] false)
                          (Ok [back] (opt-defaulted? back)))))))))

;;; (deny-unknown): the canonical encoding is accepted; a weird encoding with
;;; unknown keys is accepted only as the same value, else rejected as UNKNOWN-FIELD.
(defprop mp-deny-unknown
         [(o Opt)]
         (let [src (prop-src)
               a (src-alloc src)
               st (opt->strict o)
               b (to-weird-msgpack [OptStrict] src st (draw-bool! src))]
           (match (from-msgpack [OptStrict] a b)
             (Err [e] (let [ee e] (= (.code ee) DE-E-UNKNOWN-FIELD)))
             (Ok [back] (opt-decoded-eq true o (strict->opt back))))))

(defprop sexp-deny-unknown
         [(o Opt)]
         (let [src (prop-src)
               a (src-alloc src)
               st (opt->strict o)
               t (to-weird-sexp [OptStrict] src st (draw-bool! src) false)]
           (match (from-sexp [OptStrict] a t)
             (Err [e] (let [ee e] (= (.code ee) DE-E-UNKNOWN-FIELD)))
             (Ok [back] (opt-decoded-eq false o (strict->opt back))))))

; ============================================================ robustness
;;; Arbitrary bytes into every decoder shape. Crash / ASan / hang = bug; an
;;; accepted document must survive re-encoding.
(defprop mp-raw-bytes [(d Raw)] (check-in-region false (.b d)))

(defprop sexp-raw-bytes [(d Raw)] (check-in-region true (.b d)))

;;; Structure-aware documents (dictionary keys, every header width, wrong counts,
;;; deep and wide runs up to 70 000: recursion must be bounded, lookups linear).
(defprop mp-structured [(d MpDoc)] (check-in-region false (.b d)))

(defprop sexp-structured [(d SxDoc)] (check-in-region true (.t d)))

;;; Valid encodings of rich values, then a few byte edits.
(defprop mp-mutated [(d MpMut)] (check-mp-all (src-alloc (prop-src)) (.b d)))

(defprop sexp-mutated [(d SxMut)] (check-sx-all (src-alloc (prop-src)) (.t d)))

; ============================================================ format contracts
; Regression properties: each pins one part of the formats' documented contract
; that the first campaigns found broken (and that is now fixed).

;;; "Decode one complete MessagePack value": bytes after it must be rejected
;;; (DE-E-TRAILING), as the sexp and JSON front ends do.
(defprop mp-trailing-bytes-rejected
         [(n i64)]
         (let [src (prop-src)
               a (src-alloc src)]
           (match (to-msgpack-bytes [i64] a n)
             (Err [_] false)
             (Ok [bytes]
                 (let [(mut l) (al-new [u8] a)]
                   (push-slice! (mut l) bytes)
                   (push-u8! (mut l) (draw-int! src 0 255))
                   (match (from-msgpack [i64] a (bytes-of (load l)))
                     (Err [_] true)
                     (Ok [_] false)))))))

;;; A number-ish sexp token.
(defstruct NumTok [(t (slice u8))])

(impl Arbitrary NumTok
  (arbitrary [(out (mut NumTok)) (s (ptr Source))]
             (-> i64)
             (store! (field out t) (sx-gen-num s))
             0))

(impl Debug NumTok
  (debug-fmt [(x NumTok) (f (ptr Formatter))] (-> i64) (debug-fmt (.t x) f)))

;;; An f64 the sexp decoder accepts must have been spelled as a number: strtod
;;; alone would also take "12abc", "-", "0x1p3", "1e".
(defprop sexp-f64-accepts-only-numbers
         [(n NumTok)]
         (let [a (src-alloc (prop-src))]
           (match (from-sexp [f64] a (.t n))
             (Err [_] true)
             ; the document is one token plus optional whitespace around it
             (Ok [_] (strict-float-text? (trim-sexp-ws (.t n)))))))

(defn trim-sexp-ws [(t (slice u8))] (-> (slice u8))
  (let [(mut lo) 0
        (mut hi) (slice-len t)]
    (while (and (< (load lo) (load hi)) (sxp-ws? (primitive/cast i64 (slice-get t (load lo)))))
      (store! lo (+ (load lo) 1)))
    (while (and (> (load hi) (load lo))
                (sxp-ws? (primitive/cast i64 (slice-get t (- (load hi) 1)))))
      (store! hi (- (load hi) 1)))
    (subslice t (load lo) (load hi))))

;;; A unit variant spelled `(Dot)` decodes like the bare `Dot`, and is stepped
;;; over: the elements after it in a list stay in step.
(defprop sexp-unit-variant-list-form-decodes-same
         [(r Rec)]
         (let [src (prop-src)
               a (src-alloc src)
               t (to-weird-sexp [Rec] src r false true)]
           (match (from-sexp [Rec] a t)
             (Err [_] false)
             (Ok [back] (rec-eq false back r)))))

;;; (skip) / (skip-deserializing) fields "keep their zeroed value" — in a struct
;;; and in a sum payload, including list elements decoded through a reused slot.
(defprop skipped-fields-are-zeroed
         [(xs (ArrayList Opt)) (evs (ArrayList Ev))]
         (let [a (src-alloc (prop-src))]
           (and (match (to-msgpack-bytes [(ArrayList Opt)] a xs)
                  (Err [_] false)
                  (Ok [b]
                      (match (from-msgpack [(ArrayList Opt)] a b)
                        (Err [_] false)
                        (Ok [back]
                            (let [(mut ok) true]
                              (for [i 0 (al-len back)]
                                (when (not (opt-decoded-eq true (al-get xs i) (al-get back i)))
                                  (store! ok false)
                                  0))
                              (load ok))))))
                (match (to-msgpack-bytes [(ArrayList Ev)] a evs)
                  (Err [_] false)
                  (Ok [b]
                      (match (from-msgpack [(ArrayList Ev)] a b)
                        (Err [_] false)
                        (Ok [back]
                            (let [(mut ok) true]
                              (for [i 0 (al-len back)]
                                (match (al-get back i)
                                  (Idle [] 0)
                                  (Hit [n junk] (when (!= junk 0) (store! ok false) 0))))
                              (load ok)))))))))

;;; Renamed keys that are not bare symbols ("true", "1st", "has space"): the
;;; sexp encoder must either write something its decoder reads back, or refuse
;;; (SER-E-UNSUPPORTED); it must never emit a document that fails to decode.
(defstruct Ren [(a i64) (b i64) (c i64)])

(derive Arbitrary Debug Ren)

(derive (Serialize (field a (rename "true")) (field b (rename "1st")) (field c (rename "has space")))
        (Deserialize (field a (rename "true")) (field b (rename "1st")) (field c (rename "has space")))
        Ren)

(defn ren-eq [(x Ren) (y Ren)] (-> bool)
  (and (= (.a x) (.a y)) (and (= (.b x) (.b y)) (= (.c x) (.c y)))))

(defprop sexp-renamed-keys-refused-or-roundtrip
         [(r Ren)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [Ren] a r)
             (Err [e] (let [ee e] (= (.code ee) SER-E-UNSUPPORTED)))
             (Ok [t]
                 (match (from-sexp [Ren] a t)
                   (Err [_] false)
                   (Ok [back] (ren-eq back r)))))))

;;; A JFloat must come back as a JFloat through sexp (an integral value such as
;;; 100.0 must not be written as "100", which reads back as a JInt).
(defprop sexp-jfloat-stays-float
         [(x f64)]
         (let [a (src-alloc (prop-src))]
           (match (to-sexp-str [JVal] a (JFloat x))
             (Err [_] false)
             (Ok [t]
                 (match (from-sexp [JVal] a t)
                   (Err [_] false)
                   (Ok [v] (jv-eq false (JFloat x) v)))))))

(defn digit? [(c i64)] (-> bool) (and (>= c 48) (<= c 57)))

;;; [-]D+[.D+][(e|E)[+-]D+] | nan | inf | -inf
(defn strict-float-text? [(t (slice u8))] (-> bool)
  (if (or (= t "nan") (or (= t "inf") (= t "-inf")))
      true
      (let [n (slice-len t)
            (mut i) 0
            (mut ok) true]
        (when (and (< (load i) n) (= (primitive/cast i64 (slice-get t 0)) 45)) (store! i 1) 0)
        (let [d0 (load i)]
          (while (and (< (load i) n) (digit? (primitive/cast i64 (slice-get t (load i)))))
            (store! i (+ (load i) 1)))
          (when (= (load i) d0) (store! ok false) 0))
        (when (and (load ok) (< (load i) n) (= (primitive/cast i64 (slice-get t (load i))) 46))
          (store! i (+ (load i) 1))
          (let [d1 (load i)]
            (while (and (< (load i) n) (digit? (primitive/cast i64 (slice-get t (load i)))))
              (store! i (+ (load i) 1)))
            (when (= (load i) d1) (store! ok false) 0))
          0)
        (when (and (load ok)
                   (< (load i) n)
                   (let [c (primitive/cast i64 (slice-get t (load i)))] (or (= c 101) (= c 69))))
          (store! i (+ (load i) 1))
          (when (and (< (load i) n)
                     (let [c (primitive/cast i64 (slice-get t (load i)))] (or (= c 43) (= c 45))))
            (store! i (+ (load i) 1))
            0)
          (let [d2 (load i)]
            (while (and (< (load i) n) (digit? (primitive/cast i64 (slice-get t (load i)))))
              (store! i (+ (load i) 1)))
            (when (= (load i) d2) (store! ok false) 0))
          0)
        (and (load ok) (= (load i) n)))))

