(module stdlib-parsers-test)
(import "coil.primitive" :as primitive)
(import "coil.json" :as json)
(import "coil.http.server" :as http)
(import "coil.alloc" :as alloc)
(import "coil.str" :as str)
(import "coil.slice" :as slice)

(defn test-crlf [(b (mut str/StrBuf))] (-> i64)
  (str/sb-push-byte! (mut b) (primitive/cast u8 13))
  (str/sb-push-byte! (mut b) (primitive/cast u8 10)))

(defn test-http-input [(a (dyn alloc/Allocator)) (short? bool)] (-> (slice u8))
  (let [(mut b) (str/sb-new a)]
    (str/sb-push-str! (mut b)
                      (if short? "POST / HTTP/1.1" "POST /items?q=1 HTTP/1.1"))
    (test-crlf (mut b))
    (if short?
        0
        (do (str/sb-push-str! (mut b) "Host: example.test") (test-crlf (mut b))))
    (str/sb-push-str! (mut b)
                      (if short? "Content-Length: 4" "content-length: 5"))
    (test-crlf (mut b))
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) (if short? "abc" "helloNEXT"))
    (str/sb-str b)))

(deftest json-flat-tape-and-lookup
         (let [parsed
                 (json/parse (alloc/malloc-allocator)
                             "{\"name\":\"coil\",\"values\":[1,-2.5e3,true,null]}")]
           (match parsed
             (Err [e] (assert false))
             (Ok [doc]
                 (do
                   (assert (json/is-object? (json/root doc)))
                   (assert-eq (json/child-count (json/root doc)) 2)
                   (assert-eq (json/next-index doc 0) (json/token-count doc))
                   (let [name-index (json/object-get doc 0 "name")
                         values-index (json/object-get doc 0 "values")]
                     (assert (str/str-eq (json/string-text doc
                                                           (json/token doc
                                                                       name-index))
                                         "coil"))
                     (assert (json/is-array? (json/token doc values-index)))
                     (assert (str/str-eq (json/number-text doc
                                                           (json/token doc
                                                                       (json/array-nth doc
                                                                                       values-index
                                                                                       1)))
                                         "-2.5e3"))))))))

(deftest json-rejects-invalid-input
         (match (json/parse (alloc/malloc-allocator) "[1,]")
           (Err [e] (assert (> (json/error-code e) 0)))
           (Ok [doc] (assert false))))

(deftest http-request-views-and-body
         (let [input (test-http-input (alloc/malloc-allocator) false)]
           (match (http/parse-request (alloc/malloc-allocator) input)
             (Err [e] (assert false))
             (Ok [req]
                 (do
                   (assert (http/method-is req "POST"))
                   (assert (str/str-eq (http/target req) "/items?q=1"))
                   (assert (str/str-eq (http/header req "HOST") "example.test"))
                   (assert (str/str-eq (http/body req) "hello"))
                   (assert (http/keep-alive? req))
                   (assert-eq (http/consumed req)
                              (primitive/isub (slice/slice-len input) 4))
                   (http/request-free req))))))

(deftest http-rejects-short-body
         (match (http/parse-request (alloc/malloc-allocator)
                                    (test-http-input (alloc/malloc-allocator)
                                                     true))
           (Err [e] (assert-eq (http/error-code e) 14))
           (Ok [req] (assert false))))

(defn http-lines [(a (dyn alloc/Allocator))
                  (start (slice u8))
                  (h1 (slice u8))
                  (h2 (slice u8))
                  (h3 (slice u8))
                  (body (slice u8))] (-> (slice u8))
  (let [(mut b) (str/sb-new a)]
    (str/sb-push-str! (mut b) start)
    (test-crlf (mut b))
    (when (primitive/icmp-gt (slice/slice-len h1) 0)
      (str/sb-push-str! (mut b) h1)
      (test-crlf (mut b)))
    (when (primitive/icmp-gt (slice/slice-len h2) 0)
      (str/sb-push-str! (mut b) h2)
      (test-crlf (mut b)))
    (when (primitive/icmp-gt (slice/slice-len h3) 0)
      (str/sb-push-str! (mut b) h3)
      (test-crlf (mut b)))
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) body)
    (str/sb-str b)))

(defn http-chunked-input [(a (dyn alloc/Allocator))] (-> (slice u8))
  (let [(mut b) (str/sb-new a)]
    (str/sb-push-str! (mut b) "POST /chunks HTTP/1.1")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "Host: example.test")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "Transfer-Encoding: chunked")
    (test-crlf (mut b))
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "4")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "Wiki")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "5")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "pedia")
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "0")
    (test-crlf (mut b))
    (test-crlf (mut b))
    (str/sb-push-str! (mut b) "GET /next HTTP/1.1")
    (test-crlf (mut b))
    (test-crlf (mut b))
    (str/sb-str b)))

(deftest http-decodes-chunked-and-stops-at-next-request
         (let [a (alloc/malloc-allocator)
               input (http-chunked-input a)]
           (match (http/parse-request a input)
             (Err [e] (assert false))
             (Ok [req]
                 (do
                   (assert (str/str-eq (http/body req) "Wikipedia"))
                   (assert (primitive/icmp-lt (http/consumed req)
                                              (slice/slice-len input)))
                   (http/request-free req))))))

(deftest http-rejects-conflicting-framing
         (let [a (alloc/malloc-allocator)
               input
                 (http-lines a
                             "POST / HTTP/1.1"
                             "Host: example.test"
                             "Content-Length: 4"
                             "Transfer-Encoding: chunked"
                             "0\r\n\r\n")]
           (match (http/parse-request a input)
             (Err [e] (assert (primitive/icmp-gt (http/error-code e) 0)))
             (Ok [req] (do (http/request-free req) (assert false))))))

(deftest http-rejects-duplicate-content-length
         (let [a (alloc/malloc-allocator)
               input
                 (http-lines a
                             "POST / HTTP/1.1"
                             "Host: example.test"
                             "Content-Length: 1"
                             "Content-Length: 1"
                             "x")]
           (match (http/parse-request a input)
             (Err [e] (assert (primitive/icmp-gt (http/error-code e) 0)))
             (Ok [req] (do (http/request-free req) (assert false))))))

(deftest http-rejects-malformed-header
         (let [a (alloc/malloc-allocator)
               input
                 (http-lines a "GET / HTTP/1.1" "Bad Header: value" "" "" "")]
           (match (http/parse-request a input)
             (Err [e] (assert (primitive/icmp-gt (http/error-code e) 0)))
             (Ok [req] (do (http/request-free req) (assert false))))))

(defn decode-nth [(a (dyn alloc/Allocator)) (doc json/Doc) (i i64)] (-> (Result (slice u8) json/Error))
  (json/string-decode a doc (json/token doc (json/array-nth doc 0 i))))

(deftest json-string-decode
  (let [a (alloc/malloc-allocator)
        src "[\"plain\",\"a\\nb\\u00e9\\\"\",\"\\ud83d\\ude00\",\"\\ud800x\"]"]
    (match (json/parse a src)
      (Err [_] (assert false))
      (Ok [doc]
        (do
          (match (decode-nth a doc 0)
            (Ok [s] (assert (str/str-eq s "plain")))
            (Err [_] (assert false)))
          (match (decode-nth a doc 1)
            (Ok [s] (assert (str/str-eq s "a\nb\xe9;\"")))
            (Err [_] (assert false)))
          (match (decode-nth a doc 2)
            (Ok [s] (assert (str/str-eq s "\x1f600;")))
            (Err [_] (assert false)))
          (match (decode-nth a doc 3)
            (Ok [_] (assert false))
            (Err [e] (assert-eq (json/error-code e) 13))))))))

;; Every entry's value is a 200-element array. Looking up the last key must not
;; re-walk the earlier values (it used to be quadratic in the document size).
(deftest json-object-get-skips-subtrees
  (let [a (alloc/malloc-allocator)
        (mut b) (str/sb-new a)
        entries 3000]
    (str/sb-push-str! (mut b) "{")
    (for i (range 0 entries)
      (when (> i 0) (str/sb-push-str! (mut b) ","))
      (str/sb-push-str! (mut b) "\"k")
      (str/sb-push-i64! (mut b) i)
      (str/sb-push-str! (mut b) "\":[")
      (for j (range 0 200)
        (when (> j 0) (str/sb-push-str! (mut b) ","))
        (str/sb-push-str! (mut b) "1"))
      (str/sb-push-str! (mut b) "]"))
    (str/sb-push-str! (mut b) "}")
    (match (json/parse a (str/sb-str b))
      (Err [_] (assert false))
      (Ok [doc]
        (let [(mut found) 0]
          (for _ (range 0 200)
            (when (>= (json/object-get doc 0 "k2999") 0) (set! found (+ found 1))))
          (assert-eq found 200)
          (assert-eq (json/next-index doc 0) (json/token-count doc))
          (assert-eq (json/object-get doc 0 "missing") -1))))))
