#!/usr/bin/env bash
set -euo pipefail

if ! dpkg-query -W -f='${Status}\n' llvm-21 llvm-21-dev clang-21 libclang-rt-21-dev lld-21 2>/dev/null \
    | awk '$0 == "install ok installed" { installed++ } END { exit installed != 5 }'; then
  echo "Installing LLVM 21 toolchain..."
  wget -qO- https://apt.llvm.org/llvm-snapshot.gpg.key \
    | sudo tee /etc/apt/trusted.gpg.d/apt.llvm.org.asc >/dev/null
  echo "deb http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main" \
    | sudo tee /etc/apt/sources.list.d/llvm-21.list >/dev/null

  apt_opts=(
    -o Acquire::Retries=3
    -o Acquire::http::Timeout=25
    -o Acquire::https::Timeout=25
  )
  sudo apt-get update "${apt_opts[@]}"
  sudo apt-get install -y --no-install-recommends "${apt_opts[@]}" \
    llvm-21 llvm-21-dev clang-21 libclang-rt-21-dev lld-21
fi

# Coil locates its C driver through llvm-config --bindir, while cimport probes
# invoke `clang` directly. Keep both unversioned commands pinned to LLVM 21.
sudo update-alternatives --install /usr/bin/llvm-config llvm-config /usr/bin/llvm-config-21 210
sudo update-alternatives --set llvm-config /usr/bin/llvm-config-21
sudo update-alternatives --install /usr/bin/clang clang /usr/bin/clang-21 210
sudo update-alternatives --set clang /usr/bin/clang-21

echo "LLVM $(llvm-config --version) and $(clang --version | head -n 1) ready"
