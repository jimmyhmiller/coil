(module benchmarks.runtime-bulk.graph-copy)
(import "stogir.graph" :as g)
(import "coil.cc" :as cc)
(import "coil.primitive" :as p)

; An escaping aggregate copy cannot be replaced by independent field reads.
; Source-level value assignment must retain its snapshot semantics on aliasing.
(defn copy :cc (cc/C) :inline (Never)
  [(destination (ptr g/Graph)) (source (ptr g/Graph))] (-> void)
  (store! destination (load source)))

(export-c [copy :as "gap_graph_copy"])

(defn extent :cc (cc/C) :inline (Never) [] (-> i64) (p/sizeof g/Graph))
(export-c [extent :as "gap_graph_extent"])
